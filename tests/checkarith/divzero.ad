# Division by a run-time zero. x86 already faults here (#DE/SIGFPE); the point
# of the check is that the diagnostic NAMES the operation, operands and line
# instead of leaving a bare SIGFPE.
def main(argc: int32, argv: Ptr[uint64]) -> int32:
    n: uint64 = 100
    d: uint64 = cast[uint64](argc) - 1
    return cast[int32](n / d)
