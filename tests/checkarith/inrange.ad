# Same computation, WELL inside range (10 s of TSC). Must run unaffected.
def cyc_to_ns(cycles: uint64, mult: uint64, shift: uint64) -> uint64:
    return (cycles * mult) >> shift

def main(argc: int32, argv: Ptr[uint64]) -> int32:
    mult: uint64 = 4184308
    cycles: uint64 = 40000000000 + cast[uint64](argc)
    ns: uint64 = cyc_to_ns(cycles, mult, 24)
    if ns > 9000000000:
        return 10
    return 1
