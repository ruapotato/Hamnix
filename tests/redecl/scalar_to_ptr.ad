# The Ptr flavour (lib/web/dom/canvas.ad::_js_host_dispatch `cq`): a scalar
# name re-declared as Ptr[uint8]. Native kept the untyped scalar slot, so the
# pointee width was unknown and `cq[i]` loaded 8 bytes with an 8-byte stride
# instead of a 1-byte `movzbq` with a 1-byte stride.

rd_buf_scalar: Array[16, uint8]


def rd_disp_scalar(sel: int32) -> int32:
    if sel == 1:
        cq: int32 = 3
        return cq

    if sel == 2:
        cq: Ptr[uint8] = &rd_buf_scalar[0]
        cq[0] = 200
        cq[1] = 100
        return cast[int32](cq[0]) + cast[int32](cq[1])

    return 0


def main() -> int32:
    return rd_disp_scalar(2)
