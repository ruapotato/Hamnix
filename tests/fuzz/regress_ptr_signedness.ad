# tests/fuzz/regress_ptr_signedness.ad
#
# Regression for the SSA-lane SIGNEDNESS-OF-AN-ELEMENT class of miscompile
# (adder/compiler/ssa.ad :: ssa_expr_sgn).
#
# ssa_expr_sgn answers "is the VALUE this expression produces signed?" and its
# answer picks the machine instruction for `>>`, `/`, `%` and every relational
# compare (binop_use_signed / the compare selector). It resolves a handful of
# base kinds explicitly and SILENTLY DEFAULTS everything else to 0 = "unknown".
# The two consumers disagree about what "unknown" means:
#
#     shift / div / mod : unknown -> UNSIGNED  (lshr / udiv / urem)
#     relational compare: unknown -> SIGNED    (icmp slt / sgt / ...)
#
# so an unresolved base is wrong in BOTH directions at once, and neither
# direction announces itself. c9585fd2 fixed ONE unresolved base (a `Ptr[T]`
# local/parameter indexed `p[i]`); the very same arm still fell through for a
# cast base, a call base, a struct-member base, and ssa_expr_sgn had no
# ND_CAST arm at all.  MEASURED blast radius of that one missing base (LLVM IR
# emitted at c9585fd2^ vs c9585fd2 for every app scripts/build_user.sh builds):
# 271 instruction sites in 112 distinct functions, 684 sites counted across the
# 123 of 266 shipped binaries that changed, plus 95 sites in 20 functions on the
# kernel LLVM lane.  258 of the 265 changed COMPARES are provably benign (the
# value is zero-extended from < 64 bits, so signed and unsigned agree); the
# loud casualties were
# lib/ed25519.ad::_car25519/_modL (`c: int64 = o[i] >> 16` on a `Ptr[int64]`
# emitted `lshr`, so ed25519_verify rejected EVERY valid signature and /bin/hpm
# refused its own correctly-signed index) and lib/ec/p256.ad::p256_ge (four
# SIGNED compares on `Ptr[uint64]` 256-bit limbs -- wrong whenever a limb has
# bit 63 set, i.e. about half of all P-256 field elements, in ssh/sshd).
# Fixing the remaining sibling bases (this commit's siblings: cast value, cast
# base, call base, Ptr[Struct] member) moved another 71 sites in 58 functions
# across 112 apps -- almost all benign by range, which is the point: the
# default was silently wrong everywhere and loud in exactly two places.
#
# WHY NOTHING CAUGHT IT: the differential fuzzer never generated signed
# arithmetic through a pointer-typed parameter with a NEGATIVE value in range,
# and kobjdiff compares the native lane against itself so a shared-nothing
# second implementation (ssa.ad) is invisible to it.
#
# The native codegen.ad lane (`opt=False`) resolves every one of these bases
# correctly via index_elem_signed(), so running this fixture through
# codegen.ad with the optimizer ON and OFF is a true differential: both must
# print the same value.  Pre-fix, `opt=True` printed a different number for
# every arm below.
#
# EVERY value fed in is NEGATIVE (or has bit 63 set) on purpose -- that is the
# only regime in which the signed and unsigned instruction differ at all.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64

_ch:   Array[1, uint8]
_digs: Array[32, uint8]

# Backing storage the pointer parameters below actually point at.
sbuf: Array[8, int64]
ubuf: Array[8, uint64]

class Holder:
    v: Ptr[int64]
    n: int64
    a: Array[4, int64]


def _putc(c: uint8) -> int32:
    _ch[0] = c
    sys_write(cast[int32](1), &_ch[0], cast[uint64](1))
    return 0


def print_u64(val: uint64) -> int32:
    nd: int64 = 0
    v: uint64 = val
    if v == cast[uint64](0):
        _digs[0] = cast[uint8](48)
        nd = 1
    while v > cast[uint64](0):
        q: uint64 = v / cast[uint64](10)
        d: uint64 = v - q * cast[uint64](10)
        _digs[cast[int64](nd)] = cast[uint8](d + cast[uint64](48))
        nd = nd + 1
        v = q
    k: int64 = nd - 1
    while k >= 0:
        _putc(_digs[cast[int64](k)])
        k = k - 1
    _putc(cast[uint8](10))
    return 0


# ---------------------------------------------------------------------------
# 1) `p[i] >> k` on a Ptr[int64] PARAMETER — the c9585fd2 bug verbatim
#    (this is lib/ed25519.ad::_car25519's `c: int64 = o[i] >> 16`).
#    -1024 >> 4 == -64 (ashr).  With lshr it is 1152921504606846912.
# ---------------------------------------------------------------------------
def a_shr_ptr_param(o: Ptr[int64], i: uint64) -> int64:
    return o[i] >> 4


# 2) `p[i] / k` and `p[i] % k` on a Ptr[int64] parameter.
#    -1024 / 3 == -341 (sdiv);  udiv gives 6148914691236517204.
def a_div_ptr_param(o: Ptr[int64], i: uint64) -> int64:
    return o[i] / 3


def a_mod_ptr_param(o: Ptr[int64], i: uint64) -> int64:
    return o[i] % 3


# 3) RELATIONAL compare through a Ptr[int64] parameter. -1024 < 0 is true
#    signed, false unsigned.
def a_cmp_ptr_param(o: Ptr[int64], i: uint64) -> int64:
    if o[i] < 0:
        return 1
    return 0


# 4) RELATIONAL compare through a Ptr[uint64] parameter whose element has
#    bit 63 SET — this is lib/ec/p256.ad::p256_ge.  0x8000000000000000 > 1 is
#    true unsigned, FALSE signed.  The "unknown -> SIGNED" compare default is
#    what broke this one, so it guards the opposite direction from (1)-(3).
def a_cmp_ptr_param_u(o: Ptr[uint64], i: uint64) -> int64:
    if o[i] > cast[uint64](1):
        return 1
    return 0


# ---------------------------------------------------------------------------
# SIBLING BASES the same ND_INDEX arm still fell through for after c9585fd2.
# ---------------------------------------------------------------------------

# 5) ND_CAST as the value itself: `cast[int64](u) >> k`. ssa_expr_sgn had no
#    ND_CAST arm at all, so the declared signedness of the cast was discarded.
def b_shr_cast_value(u: uint64) -> int64:
    return cast[int64](u) >> 4


# 6) ND_CAST as the INDEX BASE: `cast[Ptr[int64]](addr)[i] >> k`.
def b_shr_cast_ptr_base(addr: uint64, i: uint64) -> int64:
    return cast[Ptr[int64]](addr)[i] >> 4


# 7) ND_CALL as the INDEX BASE: `fn()[i] >> k` where fn returns Ptr[int64].
def _sbuf_ptr() -> Ptr[int64]:
    return &sbuf[0]


def b_shr_call_ptr_base(i: uint64) -> int64:
    return _sbuf_ptr()[i] >> 4


# 8) ND_MEMBER as the INDEX BASE, struct reached through a Ptr[Struct] PARAM:
#    `h[0].v[i] >> k`. `ptr[0].field` is LANGUAGE.md's "production idiom", and
#    codegen's member_resolve needs its LOCAL type-node table to resolve it —
#    a table the SSA/LLVM lane never populates. So EVERY signed shift/div/mod
#    on a struct field or field-array reached through a Ptr[Struct] parameter
#    picked the unsigned instruction on that lane.
def b_shr_member_ptr_base(h: Ptr[Holder], i: uint64) -> int64:
    return h[0].v[i] >> 4


# 9) ND_MEMBER SCALAR through a Ptr[Struct] param: `h[0].n >> k`.
def b_shr_member_scalar(h: Ptr[Holder]) -> int64:
    return h[0].n >> 4


# 10) ARRAY FIELD through a Ptr[Struct] param: `h[0].a[i] >> k`.
def b_shr_member_arrfield(h: Ptr[Holder], i: uint64) -> int64:
    return h[0].a[i] >> 4

# (A 12th form -- `gholder[0].v[i]` through a module-scope Ptr[Struct] GLOBAL --
#  is NOT here because codegen.ad cannot compile it at all, so it has no
#  opt-ON/opt-OFF differential. It is covered at the IR level instead, by
#  scripts/test_ssa_signedness_lane.sh, which reads the LLVM lane's own output.)


def repro() -> int64:
    sbuf[0] = 0 - 1024                      # -1024
    ubuf[0] = cast[uint64](1) << 63         # 0x8000000000000000
    hold: Holder
    hold.v = &sbuf[0]
    hold.n = 0 - 1024
    hold.a[0] = 0 - 1024

    acc: int64 = 0
    # Each arm contributes a small, distinct number when CORRECT. Any arm that
    # picks the unsigned instruction contributes an astronomically different
    # one, so a single printed total localises nothing but fails loudly — the
    # per-arm expectations are in the comments above.
    acc = acc + a_shr_ptr_param(&sbuf[0], cast[uint64](0))        # -64
    acc = acc + a_div_ptr_param(&sbuf[0], cast[uint64](0))        # -341
    acc = acc + a_mod_ptr_param(&sbuf[0], cast[uint64](0))        # -1
    acc = acc + a_cmp_ptr_param(&sbuf[0], cast[uint64](0))        # 1
    acc = acc + a_cmp_ptr_param_u(&ubuf[0], cast[uint64](0))      # 1
    acc = acc + b_shr_cast_value(cast[uint64](0 - 1024))          # -64
    acc = acc + b_shr_cast_ptr_base(cast[uint64](&sbuf[0]), cast[uint64](0))   # -64
    acc = acc + b_shr_call_ptr_base(cast[uint64](0))              # -64
    acc = acc + b_shr_member_ptr_base(&hold, cast[uint64](0))     # -64
    acc = acc + b_shr_member_scalar(&hold)                        # -64
    acc = acc + b_shr_member_arrfield(&hold, cast[uint64](0))     # -64
    # -64 -341 -1 +1 +1 -64 -64 -64 -64 -64 -64  ==  -788
    return acc


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    r: int64 = repro()                   # must be -788
    print_u64(cast[uint64](r))           # -788 as u64: 18446744073709550828
    return cast[int32](r & 255)
