# True iff `s` equals "--ssa-break" (deliberate-break switch: corrupts one phi's
# operand count after construction so ssa_verify MUST catch it — proving the
# verifier guards soundness).
def is_ssabreak_flag(s: Ptr[uint8]) -> uint32:
    nm: Array[16, uint8]
    nm[0] = 45     # '-'
    nm[1] = 45     # '-'
    nm[2] = 115    # 's'
    nm[3] = 115    # 's'
    nm[4] = 97     # 'a'
    nm[5] = 45     # '-'
    nm[6] = 98     # 'b'
    nm[7] = 114    # 'r'
    nm[8] = 101    # 'e'
    nm[9] = 97     # 'a'
    nm[10] = 107   # 'k'
    nm[11] = 0
    i: uint32 = 0
    while i < 12:
        if s[i] != nm[i]:
            return 0
        if nm[i] == 0:
            return 1
        i = i + 1
    return 1


# Print the interned name for cfg name id `n` (bytes strbuf[nm_off..+nm_len]).
def emit_name(n: uint32):
    off: uint32 = nm_off[n]
    ln: uint32 = nm_len[n]
    sys_write(1, &strbuf[off], cast[uint64](ln))


# --dump-holes lane: build the CFG + idle-gap analysis PER FUNCTION and print,
# for every live-range SPLIT candidate, its name + each gap [lo,hi]@depth (the
# concrete demonstration that acc/reps in matmul are idle across the hot k-loop).
# Pure analysis; never emits code. Walks the ND_FUNCTION decl chain itself so the
# nm_* / lr_* tables reflect EACH function (cfg_run_program only leaves the last).
def dump_holes(prog: uint32):
    if prog == 0:
        return
    decls: uint32 = nd_b[prog]
    cur: uint32 = decls
    fn_idx: uint32 = 0
    while cur != 0:
        if nd_kind[cur] == ND_FUNCTION:
            ok: uint32 = cfg_build_function(cur)
            if ok != 0:
                rc: uint32 = cfg_validate()
                if rc == CFGV_OK:
                    lr_build()
                    cl_build(cur)
                    lr_build_holes()
                    n: uint32 = 0
                    while n < nm_count:
                        if lr_is_promotable(n) != 0:
                            if lr_is_split_candidate(n) != 0:
                                emit("HOLE_CAND fn=")
                                put_u32(fn_idx)
                                emit(" name=")
                                emit_name(n)
                                emit(" iv=[")
                                put_u32(lr_start[n])
                                emit(",")
                                put_u32(lr_end[n])
                                emit(")")
                                k: uint32 = lr_num_holes(n)
                                g: uint32 = 0
                                while g < k:
                                    emit(" gap=[")
                                    put_u32(lr_hole_start(n, g))
                                    emit(",")
                                    put_u32(lr_hole_end(n, g))
                                    emit("]@d")
                                    put_u32(lr_hole_hotness(n, g))
                                    emit("/br")
                                    put_u32(lr_hole_bracket_depth(n, g))
                                    g = g + 1
                                emit("\n")
                        n = n + 1
            fn_idx = fn_idx + 1
        cur = nd_next[cur]


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    emit("AC_DUMP_BEGIN\n")

    if argc < 2:
        emit("STATUS readfail\n")
        emit("AC_DUMP_END\n")
        sys_exit(2)

    # Scan argv for the opt-in --opt flag (the source path is the first
    # non-flag argument). Default OFF: with no --opt the optimizer stays
    # disabled and codegen output is byte-identical to the pre-opt path.
    # ADDER_OPT2 gate (Phase-1 SSA pipeline). Read the same way as
    # ADDER_OPT_DISABLE (envp follows argv on the Linux stack). Unset => the SSA
    # lane stays off and output is byte-identical to the pre-SSA path.
    ssa_parse_env(argc, argv)
    # Phase-3 allocator test levers: ADDER_RA_OFF (force all-memory, A/B baseline)
    # and ADDER_RA_BREAK (arm the overlap-invariant deliberate break).
    ssa_emit_parse_env(argc, argv)
    # Phase-2: ADDER_OPT_DISABLE=sccp,instcombine,gvn,licm2,dce2 turns off the
    # matching SSA pass (per-pass OPT2 bisection); default all-on.
    ssa_opt_parse_disable(argc, argv)

    in_path: Ptr[char] = cast[Ptr[char]](argv[1])
    want_opt: uint32 = 0
    want_cfg: uint32 = 0
    want_ra: uint32 = 0
    want_holes: uint32 = 0
    want_novec: uint32 = 0
    want_ssa: uint32 = 0
    ai: int32 = 1
    while ai < argc:
        a: Ptr[uint8] = cast[Ptr[uint8]](argv[ai])
        if is_opt_flag(a) != 0:
            want_opt = 1
        elif is_dumpssa_flag(a) != 0:
            want_ssa = 1
        elif is_ssabreak_flag(a) != 0:
            ssa_set_break(1)
        elif is_cfg_flag(a) != 0:
            want_cfg = 1
        elif is_ra_flag(a) != 0:
            want_ra = 1
        elif is_holes_flag(a) != 0:
            want_holes = 1
        elif is_holesbreak_flag(a) != 0:
            lr_set_holes_break(1)
        elif is_splitbreak_flag(a) != 0:
            cg_set_split_break(1)
        elif is_alelidebreak_flag(a) != 0:
            cg_set_alelide_break(1)
        elif is_rcxcleanbreak_flag(a) != 0:
            cg_set_rcxclean_break(1)
        elif is_castcallbreak_flag(a) != 0:
            ir_set_castcall_break(1)
        elif is_novec_flag(a) != 0:
            want_novec = 1
        elif is_checkbounds_flag(a) != 0:
            # Opt-in userspace array-bounds checking. The dump driver always
            # emits a userspace (Linux exit_group) image, so it is the userspace
            # gate the fused host driver applies for ELF_FMT_USER — never kernel.
            cg_set_check_bounds(1)
        else:
            in_path = cast[Ptr[char]](argv[ai])
        ai = ai + 1
    if want_opt != 0:
        # opt1 RETIRED: --opt routes through the SSA pipeline, identical to
        # ADDER_OPT2=1. ssa_is_enabled() below then sends every SSA-accepted
        # function through ssa_emit_program (SSA build + Phase-2 passes +
        # linear-scan allocator), with the per-function escape hatch falling back
        # to plain -O0 gen_function. The SSA per-pass disables and RA levers were
        # already parsed above (ssa_opt_parse_disable / ssa_emit_parse_env).
        ssa_enable()

    n: uint32 = read_source(in_path)
    if n == 0:
        emit("STATUS readfail\n")
        emit("AC_DUMP_END\n")
        sys_exit(3)

    lex_init(&cc_src[0], n)
    lex_tokenize()

    parser_init()
    prog: uint32 = parse_program()
    if p_err != 0:
        emit("STATUS parsefail line=")
        put_u32(p_err_line)
        emit("\n")
        emit("AC_DUMP_END\n")
        # parse-fail is NOT a hard process error (exit 0): the host treats
        # it as "codegen.ad rejected this program" (unsupported), not a
        # miscompile.
        return 0

    # Phase-1 SSA lane (--dump-ssa, or ADDER_OPT2 env): build + verify SSA for
    # every function, reporting accepted/fallback/verify counts. Pure analysis:
    # never emits code, never mutates the AST, so it cannot perturb codegen
    # output. The escape hatch bails non-subset functions (counted as fallback).
    if want_ssa != 0:
        ssa_run_program(prog)
        emit("SSA_FUNCS ")
        put_u32(ssa_stat_funcs)
        emit("\n")
        emit("SSA_ACCEPTED ")
        put_u32(ssa_stat_accepted)
        emit("\n")
        emit("SSA_FALLBACK ")
        put_u32(ssa_stat_fallback)
        emit("\n")
        emit("SSA_VERIFY_OK ")
        put_u32(ssa_stat_verify_ok)
        emit("\n")
        emit("SSA_VERIFY_FAIL ")
        put_u32(ssa_stat_verify_fail)
        emit("\n")
        emit("SSA_VALUES ")
        put_u32(ssa_stat_values)
        emit("\n")
        emit("SSA_BLOCKS ")
        put_u32(ssa_stat_blocks)
        emit("\n")
        emit("SSA_PHIS ")
        put_u32(ssa_stat_phis)
        emit("\n")
        # Per-reason and per-call-site bail histograms.  These are what make the
        # subset's gaps MEASURABLE: "SSA_BAILSITE <n> <count>" names exactly
        # which of the ~86 subset gates rejected how many functions.
        ri: uint32 = 0
        while ri < SBR_NREASONS:
            if ssa_bail_hist[ri] != 0:
                emit("SSA_BAILREASON ")
                put_u32(ri)
                emit(" ")
                put_u32(ssa_bail_hist[ri])
                emit("\n")
            ri = ri + 1
        si: uint32 = 0
        while si < SSA_BAIL_SITE_MAX:
            if ssa_bail_site_hist[si] != 0:
                emit("SSA_BAILSITE ")
                put_u32(si)
                emit(" ")
                put_u32(ssa_bail_site_hist[si])
                emit("\n")
            si = si + 1
        if ssa_stat_verify_fail != 0:
            emit("STATUS ssafail code=")
            put_u32(ssa_stat_fail_code)
            emit("\n")
        else:
            emit("STATUS ssaok\n")
        emit("AC_DUMP_END\n")
        return 0

    # Phase-4 register-allocation lane (--dump-regalloc): run linear scan over
    # every function and report the allocation stats WITHOUT emitting code (pure
    # analysis, like --dump-cfg). Always arms the allocator for the report.
    if want_holes != 0:
        dump_holes(prog)
        emit("STATUS holesok\n")
        emit("AC_DUMP_END\n")
        return 0

    if want_ra != 0:
        ra_enable()
        ra_run_program(prog)
        emit("RA_FUNCS ")
        put_u32(ra_prog_funcs)
        emit("\n")
        emit("RA_SKIPPED ")
        put_u32(ra_prog_skipped)
        emit("\n")
        emit("RA_PROMOTABLE ")
        put_u32(ra_prog_promotable)
        emit("\n")
        emit("RA_INREG ")
        put_u32(ra_prog_inreg)
        emit("\n")
        emit("RA_SPILLED ")
        put_u32(ra_prog_spilled)
        emit("\n")
        emit("RA_REGS_USED ")
        put_u32(ra_prog_regs_used)
        emit("\n")
        emit("RA_MAX_REGS ")
        put_u32(ra_prog_max_regs)
        emit("\n")
        emit("RA_CALLCROSS ")
        put_u32(ra_prog_callcross)
        emit("\n")
        emit("RA_HOLES ")
        put_u32(ra_prog_holes)
        emit("\n")
        emit("RA_SPLIT_CANDS ")
        put_u32(ra_prog_split_cands)
        emit("\n")
        emit("RA_SPLIT_INREG ")
        put_u32(ra_prog_split_inreg)
        emit("\n")
        emit("STATUS raok\n")
        emit("AC_DUMP_END\n")
        return 0

    # Phase-4 GROUNDWORK CFG lane (--dump-cfg): build the whole-function CFG +
    # liveness for every function and assert the structural invariants, emitting
    # a CFG report INSTEAD of the codegen dump. This path NEVER calls opt_run or
    # codegen, so it cannot perturb codegen output. It is a pure-analysis self-
    # check over the parsed AST (cfg.ad never mutates the AST).
    if want_cfg != 0:
        cfg_run_program(prog)
        emit("CFG_FUNCS ")
        put_u32(cfg_stat_funcs)
        emit("\n")
        emit("CFG_SKIPPED ")
        put_u32(cfg_stat_skipped)
        emit("\n")
        emit("CFG_BLOCKS ")
        put_u32(cfg_stat_blocks)
        emit("\n")
        emit("CFG_EDGES ")
        put_u32(cfg_stat_edges)
        emit("\n")
        emit("CFG_INSTS ")
        put_u32(cfg_stat_insts)
        emit("\n")
        # Phase-4 PREREQ stats: value-level live ranges + alias/may-clobber.
        emit("CFG_RANGES ")
        put_u32(cfg_stat_ranges)
        emit("\n")
        emit("CFG_RANGE_LEN ")
        put_u32(cfg_stat_range_len)
        emit("\n")
        emit("CFG_RANGE_MAX ")
        put_u32(cfg_stat_range_max)
        emit("\n")
        emit("CFG_LOCALS ")
        put_u32(cfg_stat_locals)
        emit("\n")
        emit("CFG_PROMOTABLE ")
        put_u32(cfg_stat_promotable)
        emit("\n")
        emit("CFG_CLOBBERABLE ")
        put_u32(cfg_stat_clobberable)
        emit("\n")
        emit("CFG_HOLES ")
        put_u32(cfg_stat_holes)
        emit("\n")
        emit("CFG_SPLIT_CANDS ")
        put_u32(cfg_stat_split_cands)
        emit("\n")
        emit("CFG_HOLE_MAXDEPTH ")
        put_u32(cfg_stat_hole_maxdepth)
        emit("\n")
        if cfg_stat_fail != 0:
            emit("STATUS cfgfail code=")
            put_u32(cfg_stat_fail)
            emit(" fn=")
            put_u32(cfg_stat_fail_fn)
            emit("\n")
        else:
            emit("STATUS cfgok\n")
        emit("AC_DUMP_END\n")
        return 0

    # opt1 (opt.ad AST optimizer) RETIRED: no AST-mutating pass runs here. The
    # AST reaches codegen exactly as parsed; the optimizer is now the SSA
    # pipeline entered at the ssa_is_enabled() seam below.
    cg_init()
    # Phase-1b ADDER_OPT2 emission lane: compile each SSA-accepted function
    # THROUGH the SSA pipeline (trivial all-memory allocator + the existing
    # emit_* encoders) and the rest via legacy gen_function.  Produces the same
    # CODEHEX dump so the differential fuzzer executes the SSA-emitted code.
    # Reached ONLY when ADDER_OPT2 is set; unset => plain gen_program_with_globals
    # so output is byte-identical.
    start: uint32 = 0
    if ssa_is_enabled() != 0:
        start = ssa_emit_program(prog)
    else:
        start = gen_program_with_globals(prog)
    if cg_err != 0:
        emit("STATUS cgfail reason=")
        put_u32(cg_err_reason)
        emit(" line=")
        put_u32(cg_err_line())
        emit(" kind=")
        put_u32(cg_err_kind())
        emit("\n")
        emit("AC_DUMP_END\n")
        return 0
    if fn_count == 0:
        emit("STATUS cgfail reason=99 line=0 kind=0\n")
        emit("AC_DUMP_END\n")
        return 0

    emit("STATUS ok\n")
    # Phase-2 SSA optimizer pass counters (0 unless ADDER_OPT2 armed).  Unknown
    # keys are ignored by the fuzzer's meta parser; a targeted OPT2 corpus asserts
    # each pass fires and that ssa_opt_verify_fail stays 0.
    emit("SSAOPT_INSTCOMBINE ")
    put_u32(ssa_opt_instcombine_count)
    emit("\n")
    emit("SSAOPT_GVN ")
    put_u32(ssa_opt_gvn_replaced)
    emit("\n")
    emit("SSAOPT_LICM ")
    put_u32(ssa_opt_licm_hoisted)
    emit("\n")
    emit("SSAOPT_SCCP ")
    put_u32(ssa_opt_sccp_folded)
    emit("\n")
    emit("SSAOPT_SCCP_EDGES ")
    put_u32(ssa_opt_sccp_edges_pruned)
    emit("\n")
    emit("SSAOPT_DCE ")
    put_u32(ssa_opt_dce_removed)
    emit("\n")
    emit("SSAOPT_VERIFY_FAIL ")
    put_u32(ssa_opt_verify_fail)
    emit("\n")
    emit("IREMIT ")
    put_u32(ir_emit_count)
    emit("\n")
    emit("IRFOLD ")
    put_u32(ir_emit_fold_count)
    emit("\n")
    emit("IRFALLBACK ")
    put_u32(ir_emit_fallback_count)
    emit("\n")
    emit("IRREASSOC ")
    put_u32(ir_emit_reassoc_count)
    emit("\n")
    # IREMITFLOAT = float-typed ND_BINARY roots lowered through the SSE float IR
    # path (subset of IREMIT). Lets the float-coverage corpus assert floats now go
    # THROUGH the IR instead of the AST fallback.
    emit("IREMITFLOAT ")
    put_u32(ir_emit_float_count)
    emit("\n")
    # DESTSEL = scalar `name = pure-arith-binop` assignments lowered through the
    # P1 destination-driven selector: the RHS tree computed DIRECTLY into the
    # register-promoted home (no %rax round-trip, no shadow store). Subset of
    # IREMIT. Byte-inert OFF (DESTSEL==0 with --opt off). Lets the corpus assert
    # the dest-passing path fires.
    emit("DESTSEL ")
    put_u32(ir_destsel_count)
    emit("\n")
    # ACCSEL = augmented accumulator assignments (`s OP= <pure expr>`, OP +,-,*)
    # routed into the promoted register home (P1 Phase 3) — `op <value>, %home`
    # with the accumulator resident (no slot reload / %rax round-trip). Byte-inert
    # OFF. IDXSTORE = indexed stores `arr[i] = <pure-arith binop>` whose RHS is
    # computed dest-driven into a held register before the store. Both let the
    # corpus assert the statement-glue store routing fires AND is byte-inert OFF.
    emit("ACCSEL ")
    put_u32(ir_accsel_count)
    emit("\n")
    emit("IDXSTORE ")
    put_u32(ir_idxstore_count)
    emit("\n")
    # IDXSEL = array-index expressions `arr[<pure-arith index>]` whose index sum is
    # computed DIRECTLY into %rcx through the destination-driven selector (scratch-
    # free, no value-at-a-time push/pop) — the P1 Phase-2 index-address plumbing
    # win (matmul `A[i*N+k]`). Byte-inert OFF (IDXSEL==0 with --opt off).
    emit("IDXSEL ")
    put_u32(ir_idxsel_count)
    emit("\n")
    # CALLARG = direct calls whose register arguments were each computed DIRECTLY
    # into their ABI argument register by the P1 dest-driven selector (no const-
    # into-scratch, no value push/pop) — the fib recursion-arg win. Byte-inert OFF.
    emit("CALLARG ")
    put_u32(ir_callarg_count)
    emit("\n")
    emit("SPINELEAF ")
    put_u32(ir_spineleaf_count)
    emit("\n")
    # IR scratch-register pool: IRSCRATCH = binop nodes whose right operand was
    # held in a callee-saved scratch register (each = one push/pop PAIR of stack
    # traffic eliminated vs the old IR-emit path); IRSCRATCHMISS = nodes that fell
    # back to push/pop because the scratch pool was exhausted by nesting pressure.
    emit("IRSCRATCH ")
    put_u32(ir_scratch_hits)
    emit("\n")
    emit("IRSCRATCHMISS ")
    put_u32(ir_scratch_misses)
    emit("\n")
    # IRBORROW = scratches satisfied by BORROWING a callee-saved register that
    # regalloc had promoted a local into, where that local was DEAD at the current
    # program point (so the register held no live value). This is the register-
    # heavy win: with >=5 promoted locals the plain availability pool is empty, so
    # these binops would otherwise all fall back to push/pop. Subset of IRSCRATCH.
    emit("IRBORROW ")
    put_u32(ir_scratch_borrows)
    emit("\n")
    # STRENGTHRED = div/mod-by-constant ops strength-reduced to reciprocal
    # multiply / shift (each = one idiv eliminated). Lets the fuzzer assert the
    # pass actually fires on the generated div/mod-by-constant corpus.
    emit("STRENGTHRED ")
    put_u32(opt_strengthred_count)
    emit("\n")
    # ISEL = array/pointer element-address computations lowered to a scaled-index
    # `lea` (each folds a scale-shift + add, and for a local array also the
    # base-lea, into one instruction). Lets the fuzzer/bench assert the pass fires.
    emit("ISEL ")
    put_u32(opt_isel_count)
    emit("\n")
    # VEC = counted invariant-word unit-stride store loops (vk_2d opaque fill /
    # clear) auto-vectorized to an SSE2 packed-store preamble (movdqu, 4 pixels/
    # iter) + scalar remainder. Byte-inert OFF (VEC==0 with --opt off). Lets the
    # bench/guard assert the vectorizer fired.
    emit("VEC ")
    put_u32(opt_vec_count)
    emit("\n")
    # ALULOAD = binop nodes whose 8-byte integer array-element RIGHT operand was
    # sourced in-place via `op (%rcx),%rax` (the alu-load memory-source fold),
    # eliding a separate sized load + reg-reg combine. Lets the fuzzer/bench/guard
    # assert the fold fires on the generated memory-operand-ALU corpus.
    emit("ALULOAD ")
    put_u32(opt_aluload_count)
    emit("\n")
    # BASEHOIST = loop-invariant GLOBAL-ARRAY bases materialised ONCE into a held
    # callee-saved register (P1 Phase 2), instead of `lea g(%rip)` per iteration.
    # Each per-access address then folds to a single scaled-index lea off that
    # register. Byte-inert OFF (BASEHOIST==0 with --opt off). Lets the corpus/
    # guard assert the base-residency lever fires.
    emit("BASEHOIST ")
    put_u32(opt_basehoist_count)
    emit("\n")
    # SPLITHOIST = LIVE-RANGE-SPLIT hole-borrow base hoists: a loop-invariant global
    # array base held in a register BORROWED from a split-candidate local whose idle
    # gap covers the loop (spill-before / reload-after). The matmul k-loop `&A` win
    # the >=2-use caller-saved hoist could not reach. Byte-inert OFF (==0 with --opt
    # off). Lets the corpus/guard assert the splitter fires.
    emit("SPLITHOIST ")
    put_u32(opt_splithoist_count)
    emit("\n")
    # STOREELIM = fully register-promoted plain scalars whose shadow stack store
    # was DROPPED (the register is the sole home; no slot-bypass read). Lets the
    # fuzzer/guard assert the store-through-elimination lever fired AND is byte-
    # inert OFF (STOREELIM==0 with --opt off).
    emit("STOREELIM ")
    put_u32(opt_storeelim_count)
    emit("\n")
    # PARAMHOME = register-promoted, store-eliminable, plain-scalar PARAMETERS whose
    # DEAD entry home spill (`mov %argreg,slot`) was dropped and whose init reload
    # was replaced by a direct `mov %argreg,%reg`. Lets the fuzzer/guard assert the
    # param-home spill-elision lever fired AND is byte-inert OFF (PARAMHOME==0 with
    # --opt off).
    emit("PARAMHOME ")
    put_u32(opt_paramhome_count)
    emit("\n")
    # ALELIDE = `xor eax,eax` variadic AL-zeroings DROPPED before a direct call to
    # an in-unit (never-variadic) Adder function. Byte-inert OFF (ALELIDE==0 with
    # --opt off). Lets the fuzzer/guard assert the elision fired.
    emit("ALELIDE ")
    put_u32(opt_alelide_count)
    emit("\n")
    # FPSEL = scalar `name = <float64 arith tree>` assignments lowered through the
    # float-SSE dest-driven selector: the RHS computed across live xmm registers
    # (xmm dest + xmm scratches) with no %rax/stack round-trip per op. Byte-inert
    # OFF (FPSEL==0 with --opt off). Lets the corpus/guard assert the lever fires.
    emit("FPSEL ")
    put_u32(opt_fpsel_count)
    emit("\n")
    # FPMOV = float64-local leaf reads / result stores routed DIRECTLY between an
    # xmm and the local's home (movsd slot<->xmm, or movq gpr<->xmm), skipping the
    # seed's %rax GPR transit. Byte-inert OFF (FPMOV==0 with --opt off).
    emit("FPMOV ")
    put_u32(opt_fpmov_count)
    emit("\n")
    # FPCMP = float64 GT/GTE compares feeding a conditional branch, lowered to
    # operands-into-xmm + ucomisd + a single NaN-correct jcc (no boolean
    # materialize, no operand %rax round-trip). Byte-inert OFF (FPCMP==0 off).
    emit("FPCMP ")
    put_u32(opt_fpcmp_count)
    emit("\n")
    # CONSTIF = ND_IF statements whose primary condition is a provably-true
    # constant literal (`if 1:` — the shape the const-branch pass leaves), emitted
    # as the then-body ALONE with NO condition materialize / test / conditional
    # branch. Byte-inert OFF (CONSTIF==0 with --opt off). Lets the corpus/guard
    # assert the fold fires.
    emit("CONSTIF ")
    put_u32(opt_constif_count)
    emit("\n")
    # IDXREG = `arr[i]` element-address leas whose index is a bare register-
    # promoted full-width-8 local routed STRAIGHT into the SIB index slot
    # (`lea (base,%ireg,s),%rax`), eliminating the `mov %ireg,%rax; mov %rax,%rcx`
    # copy pair the legacy index-into-%rcx path emits. Byte-inert OFF (IDXREG==0
    # with --opt off). Lets the corpus/guard assert the coalesce fires.
    emit("IDXREG ")
    put_u32(opt_idxreg_count)
    emit("\n")
    # RCXCLEAN = `arr[i] = expr` stores whose direct-SIB (%rcx-clean) address lets
    # the store value be held in %rcx via a reg-reg `mov %rax,%rcx` instead of a
    # stack push/pop round-trip (one fewer instruction, zero stack traffic per
    # iteration). Byte-inert OFF (RCXCLEAN==0 with --opt off). Lets the corpus/guard
    # assert the elision fires.
    emit("RCXCLEAN ")
    put_u32(opt_rcxclean_count)
    emit("\n")
    # STOREIMM = `arr[i] = <int const>` stores whose direct-SIB element address lets
    # the constant be baked into a single `movb/movl/movq $imm,(mem)` store-immediate
    # (const-materialize + value shuffle + separate lea all eliminated). Byte-inert
    # OFF (STOREIMM==0 with --opt off). Lets the corpus/guard assert the fold fires.
    emit("STOREIMM ")
    put_u32(opt_storeimm_count)
    emit("\n")
    # IMMFOLD = `name = <int literal>` stores into a register-promoted store-
    # eliminable scalar whose `mov $imm,%rax; mov %rax,%reg` pair was folded to a
    # single `mov $imm,%reg` (the imm-load retargeted in place). One fewer
    # instruction per constant-into-register store. Byte-inert OFF (IMMFOLD==0 with
    # --opt off). Lets the corpus/guard assert the peephole fires.
    emit("IMMFOLD ")
    put_u32(opt_immfold_count)
    emit("\n")
    # IMULIMM = `x * C` constant multiplies lowered to the single 3-operand
    # `imul %dst,%src,$C` (imm8/imm32) instead of materializing C into a scratch
    # register + a 2-operand imul. Byte-inert OFF (IMULIMM==0 with --opt off).
    # Lets the corpus/guard assert the lever fires.
    emit("IMULIMM ")
    put_u32(opt_imulimm_count)
    emit("\n")
    # IMMALU = `x OP C` (OP in ADD/SUB/AND/OR/XOR, C a non-negative imm32) lowered
    # in the gen_expr_ir scratch path to the single `op $C,%rax` instead of
    # materialising C into a callee-saved scratch register and doing a reg-reg
    # combine. Byte-inert OFF (IMMALU==0 with --opt off). Lets the corpus/guard
    # assert the lever fires.
    emit("IMMALU ")
    put_u32(opt_immalu_count)
    emit("\n")
    # CMPJCC = comparisons feeding a conditional branch (if/while/for/do-while
    # condition, short-circuit &&/|| edge) lowered to a direct cmp; jcc instead
    # of materializing a 0/1 boolean (cmp; setcc; movzx) and re-testing it
    # (test; jz). Each = ~6 instructions saved per branch. Lets the fuzzer/guard
    # assert the lever fires AND is byte-inert OFF (CMPJCC==0 with --opt off).
    emit("CMPJCC ")
    put_u32(cmpjcc_get_count())
    emit("\n")
    emit("CODE_CAP ")
    put_u32(CODE_CAP)
    emit("\n")
    emit("DATA_BASE ")
    put_u32(DATA_BASE)
    emit("\n")
    emit("ENTRY_OFF ")
    put_u32(cg_entry_off)
    emit("\n")
    emit("CODE_LEN ")
    put_u32(code_len)
    emit("\n")
    emit("GDATA_LEN ")
    put_u32(gdata_len)
    emit("\n")
    emit("BSS_LEN ")
    put_u32(bss_len)
    emit("\n")
    emit("FN_COUNT ")
    put_u32(fn_count)
    emit("\n")
    # Phase-1b emission counters (only under ADDER_OPT2; absent by default so the
    # default dump text is unchanged).
    if ssa_is_enabled() != 0:
        emit("SSAEMIT_FUNCS ")
        put_u32(ssa_emit_stat_funcs)
        emit("\n")
        emit("SSAEMIT_EMITTED ")
        put_u32(ssa_emit_stat_emitted)
        emit("\n")
        emit("SSAEMIT_FALLBACK ")
        put_u32(ssa_emit_stat_fallback)
        emit("\n")
        # Phase-3 allocator counters: register-resident values won, value
        # operand/result memory-slot accesses vs register moves (traffic split),
        # and overlap-invariant violations (0 unless the deliberate break armed).
        emit("SSAEMIT_REGVALS ")
        put_u32(sra_prog_regvals)
        emit("\n")
        emit("SSAEMIT_MEMOP ")
        put_u32(sra_prog_memop)
        emit("\n")
        emit("SSAEMIT_REGMOV ")
        put_u32(sra_prog_regmov)
        emit("\n")
        emit("SSAEMIT_OVERLAPVIOL ")
        put_u32(sra_stat_overlap_viol)
        emit("\n")

    emit("CODEHEX\n")
    dump_hex(&code[0], code_len)
    emit("ENDHEX\n")

    emit("GDATAHEX\n")
    dump_hex(&gdata[0], gdata_len)
    emit("ENDHEX\n")

    emit("AC_DUMP_END\n")
    return 0
