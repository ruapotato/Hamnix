# Linux open(2): a0=path a1=flags a2=mode. O_RDONLY = 0.
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_exit(code: uint64)
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32

CC_SRC_CAP: uint32 = 3145728
cc_src: Array[3145728, uint8]


def strlen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def emit(msg: Ptr[uint8]):
    sys_write(1, msg, strlen(msg))


def put_u32(v: uint32):
    if v == 0:
        sys_write(1, "0", 1)
        return
    digits: Array[16, uint8]
    i: uint64 = 0
    n: uint32 = v
    while n != 0:
        digits[i] = cast[uint8](n % 10) + 48
        n = n / 10
        i = i + 1
    out: Array[16, uint8]
    j: uint64 = 0
    while j < i:
        out[j] = digits[i - 1 - j]
        j = j + 1
    sys_write(1, &out[0], i)


def hex_digit(v: uint32) -> uint32:
    if v < 10:
        return v + 48          # '0'..'9'
    return v + 87              # 'a'..'f'


# Dump buf[0..n) as one continuous lowercase-hex stream, wrapped at 64 hex
# chars (32 bytes) per line.
def dump_hex(buf: Ptr[uint8], n: uint32):
    line: Array[80, uint8]
    col: uint32 = 0
    i: uint32 = 0
    while i < n:
        b: uint32 = cast[uint32](buf[i])
        line[col] = cast[uint8](hex_digit((b >> 4) & 15))
        col = col + 1
        line[col] = cast[uint8](hex_digit(b & 15))
        col = col + 1
        if col >= 64:
            line[col] = 10
            sys_write(1, &line[0], cast[uint64](col + 1))
            col = 0
        i = i + 1
    if col > 0:
        line[col] = 10
        sys_write(1, &line[0], cast[uint64](col + 1))


def read_source(path: Ptr[char]) -> uint32:
    fd: int32 = sys_open(path)
    if fd < 0:
        return 0
    total: uint32 = 0
    while total < CC_SRC_CAP:
        n: int64 = sys_read(fd,
                            cast[Ptr[uint8]](cast[uint64](&cc_src[0]) +
                                             cast[uint64](total)),
                            cast[uint64](CC_SRC_CAP - total))
        if n <= 0:
            break
        total = total + cast[uint32](n)
    sys_close(fd)
    if total < CC_SRC_CAP:
        cc_src[total] = 0
    return total


# True iff the NUL-terminated C string `s` equals the literal "--opt".
def is_opt_flag(s: Ptr[uint8]) -> uint32:
    if s[0] != 45:   # '-'
        return 0
    if s[1] != 45:   # '-'
        return 0
    if s[2] != 111:  # 'o'
        return 0
    if s[3] != 112:  # 'p'
        return 0
    if s[4] != 116:  # 't'
        return 0
    if s[5] != 0:
        return 0
    return 1


# True iff the NUL-terminated C string `s` equals the literal "--no-vec"
# (disable ONLY the SSE2 auto-vectorizer while leaving the rest of --opt armed —
# the A/B control the vk_2d fill microbench uses to isolate the vectorizer win).
def is_novec_flag(s: Ptr[uint8]) -> uint32:
    nm: Array[10, uint8]
    nm[0] = 45     # '-'
    nm[1] = 45     # '-'
    nm[2] = 110    # 'n'
    nm[3] = 111    # 'o'
    nm[4] = 45     # '-'
    nm[5] = 118    # 'v'
    nm[6] = 101    # 'e'
    nm[7] = 99     # 'c'
    nm[8] = 0
    i: int32 = 0
    while i < 9:
        if s[i] != nm[i]:
            return 0
        i = i + 1
    return 1


# True iff the NUL-terminated C string `s` equals the literal "--check-bounds"
# (opt-in runtime array-bounds checking; increment 2 verification lane exercises
# it together with --opt to prove the isel index paths now emit the check).
def is_checkbounds_flag(s: Ptr[uint8]) -> uint32:
    cbname: Array[16, uint8]
    cbname[0] = 45     # '-'
    cbname[1] = 45     # '-'
    cbname[2] = 99     # 'c'
    cbname[3] = 104    # 'h'
    cbname[4] = 101    # 'e'
    cbname[5] = 99     # 'c'
    cbname[6] = 107    # 'k'
    cbname[7] = 45     # '-'
    cbname[8] = 98     # 'b'
    cbname[9] = 111    # 'o'
    cbname[10] = 117   # 'u'
    cbname[11] = 110   # 'n'
    cbname[12] = 100   # 'd'
    cbname[13] = 115   # 's'
    cbname[14] = 0
    i: uint32 = 0
    while i < 15:
        if s[i] != cbname[i]:
            return 0
        if cbname[i] == 0:
            return 1
        i = i + 1
    return 1


