# Phase-4 linear-scan register allocator. ra_enable() is called ONLY under --opt
# (so codegen reads/writes promoted values through callee-saved registers). The
# --dump-regalloc lane runs the allocator over every function and reports
# allocation stats WITHOUT emitting code (pure analysis), like --dump-cfg.
# Phase-1 SSA optimizer (LLVM-shaped rewrite). Gated behind ADDER_OPT2 / the
# --dump-ssa lane. NATIVE-ONLY, ANALYSIS-ONLY in Ph1: builds + verifies SSA per
# function and reports accepted/fallback/verify counts WITHOUT emitting code and
# WITHOUT mutating the AST, so codegen output is byte-identical to the pre-SSA
# path (the machine-code lowering is deferred to Ph1b/Ph3). The escape hatch
# bails non-subset functions to the legacy pipeline.
from compiler.ssa import (
    ssa_run_program,
    ssa_parse_env,
    ssa_is_enabled,
    ssa_enable,
    ssa_set_break,
    ssa_stat_funcs,
    ssa_stat_accepted,
    ssa_stat_fallback,
    ssa_stat_verify_ok,
    ssa_stat_verify_fail,
    ssa_stat_values,
    ssa_stat_blocks,
    ssa_stat_phis,
    ssa_stat_fail_code,
)

# Phase-1b SSA machine-code emission lane.  Under ADDER_OPT2 (env), each
# top-level function the SSA pipeline accepts is compiled THROUGH SSA -> trivial
# all-memory allocator -> the existing emit_* encoders; the rest fall back to the
# legacy gen_function (per-function escape hatch).  Produces a normal CODEHEX
# dump so the differential fuzzer executes the SSA-emitted code.  ADDER_OPT2
# UNSET => this module is never entered and output is byte-identical.
from compiler.ssa_emit import (
    ssa_emit_program,
    ssa_emit_stat_funcs,
    ssa_emit_stat_emitted,
    ssa_emit_stat_fallback,
    ssa_emit_parse_env,
    sra_prog_memop,
    sra_prog_regmov,
    sra_prog_regvals,
    sra_stat_overlap_viol,
)

