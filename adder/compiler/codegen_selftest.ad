# adder/compiler/codegen_selftest.ad
#
# On-device self-test for the Adder-in-Adder x86_64 code generator.
#
# Drives the FULL lex -> parse -> codegen pipeline entirely in Adder:
#   1. Lex an embedded Adder snippet with the Adder lexer (lexer.ad).
#   2. Parse the token stream into an AST with the Adder parser (parser.ad).
#   3. Generate x86_64 machine-code bytes with the Adder codegen
#      (codegen.ad).
#   4. Assert on the concrete emitted opcode bytes AND on a software
#      emulation of the generated code's result.
#
# This is the THIRD self-hosting milestone — "Adder compiling Adder to
# machine code, on the device": the Adder backend emitting real x86_64
# bytes for its own syntax, verified on device, in Adder code.
#
# Build:
#   python3 -m compiler.adder compile --target=x86_64-adder-user \
#       adder/compiler/codegen_selftest.ad -o build/user/codegen_selftest.elf
#
# Test harness: scripts/test_selfhost_codegen.sh

from compiler.lexer import (
    lex_init,
    lex_tokenize,
    lex_err,
)

from compiler.parser import (
    parser_init,
    parse_program,
    p_err,
    nd_kind,
    nd_b,
    nd_next,
    ND_FUNCTION,
)

from compiler.codegen import (
    cg_init,
    cg_err,
    code,
    code_len,
    gen_program_first_function,
    gen_program_all_functions,
    gen_program_with_globals,
    gdata,
    gdata_len,
    DATA_BASE,
    fn_count,
    fn_offset,
)

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_exit(code: uint64)


def strlen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def emit(msg: Ptr[uint8]):
    sys_write(1, msg, strlen(msg))


def emit_nl():
    sys_write(1, "\n", 1)


def put_u32(v: uint32):
    if v == 0:
        sys_write(1, "0", 1)
        return
    digits: Array[16, uint8]
    i: uint64 = 0
    n: uint32 = v
    while n != 0:
        digits[i] = cast[uint8](n % 10) + 48
        n = n / 10
        i = i + 1
    out: Array[16, uint8]
    j: uint64 = 0
    while j < i:
        out[j] = digits[i - 1 - j]
        j = j + 1
    sys_write(1, &out[0], i)


# Print a byte as two hex digits.
def put_hex8(v: uint32):
    hexd: Ptr[uint8] = "0123456789ABCDEF"
    buf: Array[2, uint8]
    buf[0] = hexd[(v >> 4) & 15]
    buf[1] = hexd[v & 15]
    sys_write(1, &buf[0], 2)


# Test bookkeeping
checks_run: uint32 = 0
checks_failed: uint32 = 0


def check_eq(label: Ptr[uint8], got: uint32, want: uint32):
    checks_run = checks_run + 1
    if got != want:
        checks_failed = checks_failed + 1
        emit("[codegen_selftest] FAIL: ")
        emit(label)
        emit(": got ")
        put_u32(got)
        emit(" want ")
        put_u32(want)
        emit_nl()


# Assert code[idx] == want, labelling the failure with the byte index.
def check_byte(idx: uint32, want: uint32):
    checks_run = checks_run + 1
    got: uint32 = cast[uint32](code[idx])
    if got != want:
        checks_failed = checks_failed + 1
        emit("[codegen_selftest] FAIL: byte[")
        put_u32(idx)
        emit("] got 0x")
        put_hex8(got)
        emit(" want 0x")
        put_hex8(want)
        emit_nl()


# -----------------------------------------------------------------------
# Tiny x86_64 emulator covering EXACTLY the instruction subset codegen.ad
# emits, so the test verifies SEMANTICS (the generated function computes
# the right value) and not merely byte equality. Registers modelled:
# rax, rcx, rdi, rsi, rsp(+8KiB scratch stack), rbp. The stack lives in a
# global byte array; pushes/pops and rbp-relative loads/stores hit it.
# -----------------------------------------------------------------------

EMU_STACK: uint32 = 4096
emu_mem: Array[8192, uint8]

# Zero-init .bss scratch for the emulator. Addresses at or above
# DATA_BASE + gdata_len (the .bss base) index this array. Writable and
# zero-init, modelling the loader's memset-zeroed .bss tail.
emu_bss: Array[8192, uint8]


# The emulated address space is split THREE ways:
#   [0, DATA_BASE)                       -> stack window (emu_mem)
#   [DATA_BASE, DATA_BASE + gdata_len)    -> initialised data (.data, gdata)
#   [DATA_BASE + gdata_len, ...)          -> zero-init data (.bss, emu_bss)
# All real frame offsets stay below EMU_STACK (4096) < DATA_BASE, and every
# global address comes from a RIP-relative leaq that lands at either
# DATA_BASE + data_off (.data) or DATA_BASE + gdata_len + bss_off (.bss).
# gdata_len is FINAL by the time the emulator runs, so the two thresholds
# cleanly route each byte access. These primitives do that routing.
def emu_read_byte(addr: uint32) -> uint32:
    if addr >= DATA_BASE + gdata_len:
        return cast[uint32](emu_bss[addr - (DATA_BASE + gdata_len)])
    if addr >= DATA_BASE:
        return cast[uint32](gdata[addr - DATA_BASE])
    return cast[uint32](emu_mem[addr])


def emu_write_byte(addr: uint32, b: uint32):
    if addr >= DATA_BASE + gdata_len:
        emu_bss[addr - (DATA_BASE + gdata_len)] = cast[uint8](b & 255)
    elif addr >= DATA_BASE:
        gdata[addr - DATA_BASE] = cast[uint8](b & 255)
    else:
        emu_mem[addr] = cast[uint8](b & 255)


def emu_load64(addr: uint32) -> uint64:
    v: uint64 = 0
    i: uint32 = 0
    while i < 8:
        v = v | (cast[uint64](emu_read_byte(addr + i)) << (i * 8))
        i = i + 1
    return v


def emu_store64(addr: uint32, val: uint64):
    i: uint32 = 0
    v: uint64 = val
    while i < 8:
        emu_write_byte(addr + i, cast[uint32](v & 255))
        v = v >> 8
        i = i + 1


# Sized little-endian load of `size` bytes (1/2/4/8) at `addr`, zero-
# extended into a uint64. Models movzbq/movzwq/movl/movq (%rax) loads.
def emu_load_sized(addr: uint32, size: uint32) -> uint64:
    v: uint64 = 0
    i: uint32 = 0
    while i < size:
        v = v | (cast[uint64](emu_read_byte(addr + i)) << (i * 8))
        i = i + 1
    return v


# Sized little-endian store of the low `size` bytes of `val` at `addr`.
# Models movb/movw/movl/movq <src>,(%rax) stores.
def emu_store_sized(addr: uint32, size: uint32, val: uint64):
    i: uint32 = 0
    v: uint64 = val
    while i < size:
        emu_write_byte(addr + i, cast[uint32](v & 255))
        v = v >> 8
        i = i + 1


# Execute the function emitted at code[0..code_len). Returns %rax. Args
# arrive in rdi/rsi (the only two this subset's snippet uses). The
# emulator decodes the fixed instruction forms codegen.ad produces; an
# unrecognised opcode sets emu_err and stops.
emu_err: uint32 = 0


# Sentinel return address pushed before the top-level call: when `ret`
# pops this value, the emulator stops and yields %rax. Chosen out of the
# valid PC range (== CODE_CAP) so it can never alias a real instruction.
EMU_RET_SENTINEL: uint32 = 0xFFFFFFFF

# Flag/condition state used by cmpq + setcc + testq + jz.
#   emu_cmp_eq / emu_cmp_lt — result of the last `cmpq %rcx,%rax`,
#     evaluated as a SIGNED comparison of the LHS (%rax) vs RHS (%rcx).
#   emu_setres — the 0/1 the last setcc produced (consumed by movzbq).
#   emu_zf — zero flag from the last `testq %rax,%rax` (consumed by jz).
emu_cmp_eq: uint32 = 0
emu_cmp_lt: uint32 = 0
emu_cmp_below: uint32 = 0
emu_setres: uint32 = 0
emu_zf: uint32 = 0


# Record a comparison of LHS vs RHS (cmpq %rcx,%rax => rax - rcx). Tracks BOTH
# the signed (emu_cmp_lt) and unsigned (emu_cmp_below) less-than so the
# emulator can evaluate either setcc family.
def emu_cmp_set(lhs: uint64, rhs: uint64):
    if lhs == rhs:
        emu_cmp_eq = 1
    else:
        emu_cmp_eq = 0
    if cast[int64](lhs) < cast[int64](rhs):
        emu_cmp_lt = 1
    else:
        emu_cmp_lt = 0
    if lhs < rhs:                # unsigned comparison (uint64)
        emu_cmp_below = 1
    else:
        emu_cmp_below = 0


# Evaluate a setcc opcode byte against the recorded comparison.
#   signed:   94=sete 95=setne 9C=setl 9D=setge 9E=setle 9F=setg
#   unsigned: 92=setb 93=setae 96=setbe 97=seta
def emu_eval_setcc(opc: uint32) -> uint32:
    if opc == 0x94:
        return emu_cmp_eq
    if opc == 0x95:
        if emu_cmp_eq != 0:
            return 0
        return 1
    if opc == 0x9C:
        return emu_cmp_lt
    if opc == 0x9D:
        # >= : not <
        if emu_cmp_lt != 0:
            return 0
        return 1
    if opc == 0x9E:
        # <= : < or ==
        if emu_cmp_lt != 0 or emu_cmp_eq != 0:
            return 1
        return 0
    if opc == 0x9F:
        # > : not < and not ==
        if emu_cmp_lt == 0 and emu_cmp_eq == 0:
            return 1
        return 0
    if opc == 0x92:
        # setb : unsigned <
        return emu_cmp_below
    if opc == 0x93:
        # setae : unsigned >= (not below)
        if emu_cmp_below != 0:
            return 0
        return 1
    if opc == 0x96:
        # setbe : unsigned <= (below or equal)
        if emu_cmp_below != 0 or emu_cmp_eq != 0:
            return 1
        return 0
    if opc == 0x97:
        # seta : unsigned > (not below and not equal)
        if emu_cmp_below == 0 and emu_cmp_eq == 0:
            return 1
        return 0
    emu_err = 1
    return 0


# Read a little-endian, sign-extended rel32 at `at`, returned as a uint64
# whose low 32 bits are the displacement (added to a uint32 pc, the
# two's-complement wraparound yields the correct forward/back target).
def emu_rel32(at: uint32) -> uint64:
    v: uint32 = cast[uint32](code[at]) | (cast[uint32](code[at + 1]) << 8) | (cast[uint32](code[at + 2]) << 16) | (cast[uint32](code[at + 3]) << 24)
    return cast[uint64](v)


def emu_run_at(start_pc: uint32, arg0: uint64, arg1: uint64) -> uint64:
    emu_err = 0
    rax: uint64 = 0
    rcx: uint64 = 0
    rdx: uint64 = 0
    rdi: uint64 = arg0
    rsi: uint64 = arg1
    # rsp/rbp expressed as indices into emu_mem; start near the top.
    rsp: uint32 = EMU_STACK
    rbp: uint32 = 0
    # Push the stop-sentinel as the outermost return address.
    rsp = rsp - 8
    emu_store64(rsp, cast[uint64](EMU_RET_SENTINEL))
    pc: uint32 = start_pc
    steps: uint32 = 0
    while pc < code_len:
        steps = steps + 1
        if steps > 8192:
            emu_err = 1
            return 0
        b0: uint32 = cast[uint32](code[pc])

        # endbr64: F3 0F 1E FA
        if b0 == 0xF3:
            pc = pc + 4
            continue

        # push %rbp: 55
        if b0 == 0x55:
            rsp = rsp - 8
            emu_store64(rsp, cast[uint64](rbp))
            pc = pc + 1
            continue

        # push %rax: 50
        if b0 == 0x50:
            rsp = rsp - 8
            emu_store64(rsp, rax)
            pc = pc + 1
            continue

        # pop %rcx: 59
        if b0 == 0x59:
            rcx = emu_load64(rsp)
            rsp = rsp + 8
            pc = pc + 1
            continue

        # pop %rdi: 5F
        if b0 == 0x5F:
            rdi = emu_load64(rsp)
            rsp = rsp + 8
            pc = pc + 1
            continue

        # pop %rsi: 5E
        if b0 == 0x5E:
            rsi = emu_load64(rsp)
            rsp = rsp + 8
            pc = pc + 1
            continue

        # pop %rdx: 5A
        if b0 == 0x5A:
            rdx = emu_load64(rsp)
            rsp = rsp + 8
            pc = pc + 1
            continue

        # xorl %eax,%eax: 31 C0
        if b0 == 0x31 and cast[uint32](code[pc + 1]) == 0xC0:
            rax = 0
            pc = pc + 2
            continue

        # movl (%rax),%eax: 8B 00  (4-byte zero-extending load at *rax)
        if b0 == 0x8B and cast[uint32](code[pc + 1]) == 0x00:
            rax = emu_load_sized(cast[uint32](rax), 4)
            pc = pc + 2
            continue

        # movl %ecx,(%rax): 89 08  (4-byte store of rcx -> *rax)
        if b0 == 0x89 and cast[uint32](code[pc + 1]) == 0x08:
            emu_store_sized(cast[uint32](rax), 4, rcx)
            pc = pc + 2
            continue

        # movl %eax,%eax: 89 C0  (cast[uint32] narrowing — zero the high 32
        # bits of %rax; NO REX.W prefix). Mirrors emit_ext_rax size-4 unsigned.
        if b0 == 0x89 and cast[uint32](code[pc + 1]) == 0xC0:
            rax = rax & cast[uint64](0xFFFFFFFF)
            pc = pc + 2
            continue

        # movb %cl,(%rax): 88 08  (1-byte store)
        if b0 == 0x88 and cast[uint32](code[pc + 1]) == 0x08:
            emu_store_sized(cast[uint32](rax), 1, rcx)
            pc = pc + 2
            continue

        # movw %cx,(%rax): 66 89 08  (2-byte store, operand-size prefix)
        if b0 == 0x66 and cast[uint32](code[pc + 1]) == 0x89 and cast[uint32](code[pc + 2]) == 0x08:
            emu_store_sized(cast[uint32](rax), 2, rcx)
            pc = pc + 3
            continue

        # jz rel32: 0F 84 rel32   /  movzbq %al,%rax: 48 0F B6 C0 handled below
        if b0 == 0x0F and cast[uint32](code[pc + 1]) == 0x84:
            rel: uint64 = emu_rel32(pc + 2)
            nextpc: uint32 = pc + 6
            if rax == 0:
                pc = nextpc + cast[uint32](rel)
            else:
                pc = nextpc
            continue

        # jmp rel32: E9 rel32
        if b0 == 0xE9:
            rel: uint64 = emu_rel32(pc + 1)
            nextpc: uint32 = pc + 5
            pc = nextpc + cast[uint32](rel)
            continue

        # call rel32: E8 rel32  (push return addr, jump to target)
        if b0 == 0xE8:
            rel: uint64 = emu_rel32(pc + 1)
            nextpc: uint32 = pc + 5
            rsp = rsp - 8
            emu_store64(rsp, cast[uint64](nextpc))
            pc = nextpc + cast[uint32](rel)
            continue

        # leave: C9   (rsp = rbp; pop rbp)
        if b0 == 0xC9:
            rsp = rbp
            rbp = cast[uint32](emu_load64(rsp))
            rsp = rsp + 8
            pc = pc + 1
            continue

        # ret: C3  (pop return address; sentinel stops the emulator)
        if b0 == 0xC3:
            retaddr: uint32 = cast[uint32](emu_load64(rsp))
            rsp = rsp + 8
            if retaddr == EMU_RET_SENTINEL:
                return rax
            pc = retaddr
            continue

        # 0x48-prefixed forms.
        if b0 == 0x48:
            b1: uint32 = cast[uint32](code[pc + 1])
            # movq %rsp,%rbp: 48 89 E5
            if b1 == 0x89 and cast[uint32](code[pc + 2]) == 0xE5:
                rbp = rsp
                pc = pc + 3
                continue
            # subq $imm32,%rsp: 48 81 EC imm32
            if b1 == 0x81 and cast[uint32](code[pc + 2]) == 0xEC:
                imm: uint32 = cast[uint32](code[pc + 3]) | (cast[uint32](code[pc + 4]) << 8) | (cast[uint32](code[pc + 5]) << 16) | (cast[uint32](code[pc + 6]) << 24)
                rsp = rsp - imm
                pc = pc + 7
                continue
            # movq $imm32,%rax: 48 C7 C0 imm32 (sign-extended; our values fit)
            if b1 == 0xC7 and cast[uint32](code[pc + 2]) == 0xC0:
                imm: uint32 = cast[uint32](code[pc + 3]) | (cast[uint32](code[pc + 4]) << 8) | (cast[uint32](code[pc + 5]) << 16) | (cast[uint32](code[pc + 6]) << 24)
                rax = cast[uint64](imm)
                pc = pc + 7
                continue
            # addq %rcx,%rax: 48 01 C8
            if b1 == 0x01 and cast[uint32](code[pc + 2]) == 0xC8:
                rax = rax + rcx
                pc = pc + 3
                continue
            # subq %rcx,%rax: 48 29 C8
            if b1 == 0x29 and cast[uint32](code[pc + 2]) == 0xC8:
                rax = rax - rcx
                pc = pc + 3
                continue
            # imulq %rcx,%rax: 48 0F AF C1
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xAF and cast[uint32](code[pc + 3]) == 0xC1:
                rax = rax * rcx
                pc = pc + 4
                continue
            # andq %rcx,%rax: 48 21 C8
            if b1 == 0x21 and cast[uint32](code[pc + 2]) == 0xC8:
                rax = rax & rcx
                pc = pc + 3
                continue
            # orq %rcx,%rax: 48 09 C8
            if b1 == 0x09 and cast[uint32](code[pc + 2]) == 0xC8:
                rax = rax | rcx
                pc = pc + 3
                continue
            # xorq %rcx,%rax: 48 31 C8   /   xorq %rdx,%rdx: 48 31 D2
            if b1 == 0x31:
                m2: uint32 = cast[uint32](code[pc + 2])
                if m2 == 0xC8:
                    rax = rax ^ rcx
                    pc = pc + 3
                    continue
                if m2 == 0xD2:
                    rdx = 0
                    pc = pc + 3
                    continue
            # cqo: 48 99  — sign-extend %rax into %rdx:%rax (the SIGNED-div
            # setup, replacing xorq %rdx,%rdx ahead of idivq).
            if b1 == 0x99:
                if (rax & cast[uint64](0x8000000000000000)) != cast[uint64](0):
                    rdx = cast[uint64](0xFFFFFFFFFFFFFFFF)
                else:
                    rdx = 0
                pc = pc + 2
                continue
            # shlq %cl,%rax: 48 D3 E0   /   shrq %cl,%rax: 48 D3 E8
            if b1 == 0xD3:
                m2: uint32 = cast[uint32](code[pc + 2])
                if m2 == 0xE0:
                    rax = rax << (rcx & 63)
                    pc = pc + 3
                    continue
                if m2 == 0xE8:
                    rax = rax >> (rcx & 63)
                    pc = pc + 3
                    continue
                if m2 == 0xF8:
                    # sarq %cl,%rax — arithmetic (sign-propagating) right shift
                    # for a SIGNED `>>`. Replicate the sign bit into the shifted-
                    # in high bits.
                    shc: uint64 = rcx & 63
                    neg_s: uint32 = 0
                    if (rax & cast[uint64](0x8000000000000000)) != cast[uint64](0):
                        neg_s = 1
                    rax = rax >> shc
                    if neg_s != 0 and shc != cast[uint64](0):
                        # set the top `shc` bits
                        mask_s: uint64 = cast[uint64](0xFFFFFFFFFFFFFFFF) << (cast[uint64](64) - shc)
                        rax = rax | mask_s
                    pc = pc + 3
                    continue
            # shlq $1,%rcx: 48 D1 E1
            if b1 == 0xD1 and cast[uint32](code[pc + 2]) == 0xE1:
                rcx = rcx << 1
                pc = pc + 3
                continue
            # shlq $imm8,%rcx: 48 C1 E1 ib  (scale by 4 or 8)
            if b1 == 0xC1 and cast[uint32](code[pc + 2]) == 0xE1:
                sh: uint32 = cast[uint32](code[pc + 3])
                rcx = rcx << sh
                pc = pc + 4
                continue
            # divq %rcx: 48 F7 F1   /   negq %rax: 48 F7 D8  /  notq %rax: 48 F7 D0
            if b1 == 0xF7:
                m2: uint32 = cast[uint32](code[pc + 2])
                if m2 == 0xF1:
                    # unsigned 128/64 div with rdx:rax dividend (rdx pre-zeroed)
                    if rcx == 0:
                        emu_err = 1
                        return 0
                    q: uint64 = rax / rcx
                    r: uint64 = rax - q * rcx
                    rax = q
                    rdx = r
                    pc = pc + 3
                    continue
                if m2 == 0xF9:
                    # idivq %rcx — SIGNED 128/64 div with rdx:rax dividend
                    # (cqo pre-sign-extended rax into rdx). Operate on the
                    # signed magnitudes and reapply the sign, truncating toward
                    # zero (x86 idiv semantics).
                    if rcx == 0:
                        emu_err = 1
                        return 0
                    a_neg: uint32 = 0
                    av: uint64 = rax
                    if (rax & cast[uint64](0x8000000000000000)) != cast[uint64](0):
                        a_neg = 1
                        av = cast[uint64](0) - rax
                    b_neg: uint32 = 0
                    bv: uint64 = rcx
                    if (rcx & cast[uint64](0x8000000000000000)) != cast[uint64](0):
                        b_neg = 1
                        bv = cast[uint64](0) - rcx
                    qm: uint64 = av / bv
                    rm: uint64 = av - qm * bv
                    # quotient sign = a_neg XOR b_neg; remainder sign = a_neg.
                    if a_neg != b_neg:
                        rax = cast[uint64](0) - qm
                    else:
                        rax = qm
                    if a_neg != 0:
                        rdx = cast[uint64](0) - rm
                    else:
                        rdx = rm
                    pc = pc + 3
                    continue
                if m2 == 0xD8:
                    rax = cast[uint64](0) - rax
                    pc = pc + 3
                    continue
                if m2 == 0xD0:
                    rax = rax ^ cast[uint64](0xFFFFFFFFFFFFFFFF)
                    pc = pc + 3
                    continue
            # testq %rcx,%rcx: 48 85 C9  (feeds the following setne %cl)
            if b1 == 0x85 and cast[uint32](code[pc + 2]) == 0xC9:
                if rcx == 0:
                    emu_cmp_eq = 1
                else:
                    emu_cmp_eq = 0
                pc = pc + 3
                continue
            # movzbq %cl,%rcx: 48 0F B6 C9  (rcx = setcc result for and/or fold)
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xB6 and cast[uint32](code[pc + 3]) == 0xC9:
                rcx = cast[uint64](emu_setres)
                pc = pc + 4
                continue
            # leaq disp8(%rbp),%rax: 48 8D 45 disp8  (frame-slot address)
            if b1 == 0x8D and cast[uint32](code[pc + 2]) == 0x45:
                disp: uint32 = cast[uint32](code[pc + 3])
                rax = cast[uint64](rbp + sext8_to_idx(disp))
                pc = pc + 4
                continue
            # leaq rel32(%rip),%rax: 48 8D 05 rel32  (global/string address).
            # The RIP-relative displacement is taken from the END of the
            # 7-byte instruction; the resolved target is an absolute address
            # in the data window (>= DATA_BASE), so the load/store routing
            # picks gdata[]. rip_end + rel32 reproduces the codegen's
            # patch_rel32(target = DATA_BASE + data_off) arithmetic.
            if b1 == 0x8D and cast[uint32](code[pc + 2]) == 0x05:
                rel: uint64 = emu_rel32(pc + 3)
                ripend: uint32 = pc + 7
                rax = cast[uint64](ripend + cast[uint32](rel))
                pc = pc + 7
                continue
            # cmpq %rcx,%rax: 48 39 C8  (sets the compare flag for setcc)
            if b1 == 0x39 and cast[uint32](code[pc + 2]) == 0xC8:
                emu_cmp_set(rax, rcx)
                pc = pc + 3
                continue
            # testq %rax,%rax: 48 85 C0  (ZF reflected via emu_zf; also feeds
            # setz/setne through emu_cmp_eq so the and/or and NOT folds work:
            # ZF set == operand is zero == "equal to zero").
            if b1 == 0x85 and cast[uint32](code[pc + 2]) == 0xC0:
                if rax == 0:
                    emu_zf = 1
                    emu_cmp_eq = 1
                else:
                    emu_zf = 0
                    emu_cmp_eq = 0
                pc = pc + 3
                continue
            # Register-form width extends of %rax (cast[T] narrowing fix-up +
            # movzbq-of-setcc): truncate %rax to T's width and zero/sign-extend.
            #   movzbq %al,%rax  48 0F B6 C0  -> rax & 0xFF        (zero-ext 1)
            #   movzwq %ax,%rax  48 0F B7 C0  -> rax & 0xFFFF      (zero-ext 2)
            #   movsbq %al,%rax  48 0F BE C0  -> sign-extend low byte
            #   movswq %ax,%rax  48 0F BF C0  -> sign-extend low 2 bytes
            if b1 == 0x0F and cast[uint32](code[pc + 3]) == 0xC0:
                eo: uint32 = cast[uint32](code[pc + 2])
                if eo == 0xB6:
                    rax = rax & cast[uint64](0xFF)
                    pc = pc + 4
                    continue
                if eo == 0xB7:
                    rax = rax & cast[uint64](0xFFFF)
                    pc = pc + 4
                    continue
                if eo == 0xBE:
                    rax = rax & cast[uint64](0xFF)
                    if (rax & cast[uint64](0x80)) != cast[uint64](0):
                        rax = rax | cast[uint64](0xFFFFFFFFFFFFFF00)
                    pc = pc + 4
                    continue
                if eo == 0xBF:
                    rax = rax & cast[uint64](0xFFFF)
                    if (rax & cast[uint64](0x8000)) != cast[uint64](0):
                        rax = rax | cast[uint64](0xFFFFFFFFFFFF0000)
                    pc = pc + 4
                    continue
            # movslq %eax,%rax: 48 63 C0  (sign-extend low 4 bytes; cast[int32])
            if b1 == 0x63 and cast[uint32](code[pc + 2]) == 0xC0:
                rax = rax & cast[uint64](0xFFFFFFFF)
                if (rax & cast[uint64](0x80000000)) != cast[uint64](0):
                    rax = rax | cast[uint64](0xFFFFFFFF00000000)
                pc = pc + 3
                continue
            # movq %rdx,%rax: 48 89 D0  (MOD remainder into rax)
            if b1 == 0x89 and cast[uint32](code[pc + 2]) == 0xD0:
                rax = rdx
                pc = pc + 3
                continue
            # movq %rax,%rcx: 48 89 C1  (index value into rcx for scaling)
            if b1 == 0x89 and cast[uint32](code[pc + 2]) == 0xC1:
                rcx = rax
                pc = pc + 3
                continue
            # movq %rcx,(%rax): 48 89 08  (8-byte store of rcx -> *rax)
            if b1 == 0x89 and cast[uint32](code[pc + 2]) == 0x08:
                emu_store_sized(cast[uint32](rax), 8, rcx)
                pc = pc + 3
                continue
            # movq %r*,disp8(%rbp): 48 89 {7D|75|55|4D|45} disp8
            #   7D=rdi 75=rsi 55=rdx 4D=rcx (param spill); 45=rax (local store)
            if b1 == 0x89:
                modrm: uint32 = cast[uint32](code[pc + 2])
                disp: uint32 = cast[uint32](code[pc + 3])
                addr: uint32 = rbp + sext8_to_idx(disp)
                if modrm == 0x7D:
                    emu_store64(addr, rdi)
                    pc = pc + 4
                    continue
                if modrm == 0x75:
                    emu_store64(addr, rsi)
                    pc = pc + 4
                    continue
                if modrm == 0x55:
                    emu_store64(addr, rdx)
                    pc = pc + 4
                    continue
                if modrm == 0x4D:
                    emu_store64(addr, rcx)
                    pc = pc + 4
                    continue
                if modrm == 0x45:
                    emu_store64(addr, rax)
                    pc = pc + 4
                    continue
            # movq disp8(%rbp),%rax: 48 8B 45 disp8 (full 8-byte local load)
            if b1 == 0x8B and cast[uint32](code[pc + 2]) == 0x45:
                disp: uint32 = cast[uint32](code[pc + 3])
                addr: uint32 = rbp + sext8_to_idx(disp)
                rax = emu_load64(addr)
                pc = pc + 4
                continue
            # movslq disp8(%rbp),%rax: 48 63 45 disp8 (4-byte sign-extending
            # local load — emitted for a sub-8-byte SIGNED int32 scalar local
            # so its widening read carries the right two's-complement value).
            if b1 == 0x63 and cast[uint32](code[pc + 2]) == 0x45:
                dispm: uint32 = cast[uint32](code[pc + 3])
                addrm: uint32 = rbp + sext8_to_idx(dispm)
                v32: uint64 = emu_load_sized(addrm, 4)
                # sign-extend bit 31 into the high 32 bits
                if (v32 & cast[uint64](0x80000000)) != cast[uint64](0):
                    v32 = v32 | cast[uint64](0xFFFFFFFF00000000)
                rax = v32
                pc = pc + 4
                continue
            # movsbq/movswq disp8(%rbp),%rax: 48 0F BE/BF 45 disp8 (1/2-byte
            # sign-extending local load) and movzbq/movzwq: 48 0F B6/B7 45
            # disp8 (1/2-byte zero-extending). Emitted for sub-8-byte typed
            # scalar locals so their widening read truncates+extends correctly.
            if b1 == 0x0F and cast[uint32](code[pc + 3]) == 0x45:
                ext_op: uint32 = cast[uint32](code[pc + 2])
                dispx: uint32 = cast[uint32](code[pc + 4])
                addrx: uint32 = rbp + sext8_to_idx(dispx)
                if ext_op == 0xBE:
                    vv: uint64 = emu_load_sized(addrx, 1)
                    if (vv & cast[uint64](0x80)) != cast[uint64](0):
                        vv = vv | cast[uint64](0xFFFFFFFFFFFFFF00)
                    rax = vv
                    pc = pc + 5
                    continue
                if ext_op == 0xBF:
                    vw: uint64 = emu_load_sized(addrx, 2)
                    if (vw & cast[uint64](0x8000)) != cast[uint64](0):
                        vw = vw | cast[uint64](0xFFFFFFFFFFFF0000)
                    rax = vw
                    pc = pc + 5
                    continue
                if ext_op == 0xB6:
                    rax = emu_load_sized(addrx, 1)
                    pc = pc + 5
                    continue
                if ext_op == 0xB7:
                    rax = emu_load_sized(addrx, 2)
                    pc = pc + 5
                    continue
            # movq (%rax),%rax: 48 8B 00  (8-byte load at *rax)
            if b1 == 0x8B and cast[uint32](code[pc + 2]) == 0x00:
                rax = emu_load_sized(cast[uint32](rax), 8)
                pc = pc + 3
                continue
            # movzbq (%rax),%rax: 48 0F B6 00  (1-byte zero-extending load)
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xB6 and cast[uint32](code[pc + 3]) == 0x00:
                rax = emu_load_sized(cast[uint32](rax), 1)
                pc = pc + 4
                continue
            # movzwq (%rax),%rax: 48 0F B7 00  (2-byte zero-extending load)
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xB7 and cast[uint32](code[pc + 3]) == 0x00:
                rax = emu_load_sized(cast[uint32](rax), 2)
                pc = pc + 4
                continue
            # movsbq (%rax),%rax: 48 0F BE 00  (1-byte sign-extending load —
            # signed sub-8-byte scalar global, e.g. an int8 global).
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xBE and cast[uint32](code[pc + 3]) == 0x00:
                bload: uint64 = emu_load_sized(cast[uint32](rax), 1)
                if (bload & cast[uint64](0x80)) != cast[uint64](0):
                    bload = bload | cast[uint64](0xFFFFFFFFFFFFFF00)
                rax = bload
                pc = pc + 4
                continue
            # movswq (%rax),%rax: 48 0F BF 00  (2-byte sign-extending load).
            if b1 == 0x0F and cast[uint32](code[pc + 2]) == 0xBF and cast[uint32](code[pc + 3]) == 0x00:
                wload: uint64 = emu_load_sized(cast[uint32](rax), 2)
                if (wload & cast[uint64](0x8000)) != cast[uint64](0):
                    wload = wload | cast[uint64](0xFFFFFFFFFFFF0000)
                rax = wload
                pc = pc + 4
                continue
            # movslq (%rax),%rax: 48 63 00  (4-byte sign-extending load —
            # signed int32 scalar global, e.g. `counter: int32`).
            if b1 == 0x63 and cast[uint32](code[pc + 2]) == 0x00:
                dload: uint64 = emu_load_sized(cast[uint32](rax), 4)
                if (dload & cast[uint64](0x80000000)) != cast[uint64](0):
                    dload = dload | cast[uint64](0xFFFFFFFF00000000)
                rax = dload
                pc = pc + 3
                continue

        # set<cc> %al: 0F {92|93|94|95|96|97|9C|9D|9E|9F} C0 — materialise 0/1
        # from the last cmpq/testq. The %al form writes the low byte of %rax
        # (so a following movzbq/movsbq %al,%rax sees it generically); the %cl
        # form (C1) feeds emu_setres for the %rcx side of an and/or fold.
        if b0 == 0x0F:
            sb: uint32 = cast[uint32](code[pc + 1])
            modb: uint32 = cast[uint32](code[pc + 2])
            if modb == 0xC0:
                emu_setres = emu_eval_setcc(sb)
                rax = (rax & cast[uint64](0xFFFFFFFFFFFFFF00)) | cast[uint64](emu_setres)
                pc = pc + 3
                continue
            if modb == 0xC1:
                emu_setres = emu_eval_setcc(sb)
                rcx = (rcx & cast[uint64](0xFFFFFFFFFFFFFF00)) | cast[uint64](emu_setres)
                pc = pc + 3
                continue

        emu_err = 1
        return 0
    return rax


def emu_run(arg0: uint64, arg1: uint64) -> uint64:
    return emu_run_at(0, arg0, arg1)


# Convert a signed 8-bit displacement (0..255 encoding) into the
# equivalent index delta within the (small, positive) emu stack window.
# All real offsets are negative, so a disp >= 0x80 is `disp - 256`.
def sext8_to_idx(disp: uint32) -> uint32:
    if disp >= 128:
        # negative offset: rbp - (256 - disp)
        return cast[uint32](0) - (256 - disp)
    return disp


def main() -> int32:
    emit("[codegen_selftest] start: Adder codegen emitting x86_64 bytes for Adder source, on device\n")

    # A function returning an arithmetic expression over its parameters,
    # exercising: function prologue/epilogue, param spill, identifier
    # loads, integer literal, binary ADD and binary MUL, and return.
    #   def f(a: int32, b: int32) -> int32:
    #       return a + b * 2
    src: Ptr[uint8] = "def f(a: int32, b: int32) -> int32:\n    return a + b * 2\n"
    src_len: uint32 = cast[uint32](strlen(src))

    emit("[codegen_selftest] source:\n")
    emit(src)
    emit_nl()

    lex_init(src, src_len)
    lex_tokenize()
    check_eq("lex error flag", lex_err, 0)

    parser_init()
    prog: uint32 = parse_program()
    check_eq("parse error flag", p_err, 0)

    # Sanity: program has exactly one function declaration.
    decls: uint32 = nd_b[prog]
    check_eq("first decl is FUNCTION", nd_kind[decls], ND_FUNCTION)
    check_eq("single declaration", chain_len(decls), 1)

    cg_init()
    start: uint32 = gen_program_first_function(prog)
    check_eq("codegen error flag", cg_err, 0)
    check_eq("code starts at offset 0", start, 0)

    # --- Assert the exact emitted byte stream ---------------------------
    # Expected encoding (see codegen.ad header for per-instr bytes):
    #   endbr64            F3 0F 1E FA
    #   push %rbp          55
    #   mov %rsp,%rbp      48 89 E5
    #   sub $16,%rsp       48 81 EC 10 00 00 00
    #   mov %rdi,-8(%rbp)  48 89 7D F8
    #   mov %rsi,-16(%rbp) 48 89 75 F0
    #   --- return a + b * 2 ; eval right (b*2) first ---
    #   --- b*2: eval right (2) first ---
    #   mov $2,%rax        48 C7 C0 02 00 00 00
    #   push %rax          50
    #   movslq -16(%rbp),%rax 48 63 45 F0 ; b (int32 sign-extending load)
    #   pop %rcx           59
    #   imul %rcx,%rax     48 0F AF C1
    #   --- back in outer add: push (b*2), eval left (a) ---
    #   push %rax          50
    #   movslq -8(%rbp),%rax  48 63 45 F8 ; a (int32 sign-extending load)
    #   pop %rcx           59
    #   add %rcx,%rax      48 01 C8
    #   leave              C9
    #   ret                C3
    check_eq("total code length", code_len, 51)

    # Prologue
    check_byte(0, 0xF3)
    check_byte(1, 0x0F)
    check_byte(2, 0x1E)
    check_byte(3, 0xFA)
    check_byte(4, 0x55)
    check_byte(5, 0x48)
    check_byte(6, 0x89)
    check_byte(7, 0xE5)
    check_byte(8, 0x48)
    check_byte(9, 0x81)
    check_byte(10, 0xEC)
    check_byte(11, 0x10)
    check_byte(12, 0x00)
    check_byte(13, 0x00)
    check_byte(14, 0x00)
    # Param spills
    check_byte(15, 0x48)
    check_byte(16, 0x89)
    check_byte(17, 0x7D)
    check_byte(18, 0xF8)
    check_byte(19, 0x48)
    check_byte(20, 0x89)
    check_byte(21, 0x75)
    check_byte(22, 0xF0)
    # mov $2,%rax
    check_byte(23, 0x48)
    check_byte(24, 0xC7)
    check_byte(25, 0xC0)
    check_byte(26, 0x02)
    check_byte(27, 0x00)
    check_byte(28, 0x00)
    check_byte(29, 0x00)
    # push %rax
    check_byte(30, 0x50)
    # movslq -16(%rbp),%rax  (b: int32 -> sign-extending load, 48 63 45 F0)
    check_byte(31, 0x48)
    check_byte(32, 0x63)
    check_byte(33, 0x45)
    check_byte(34, 0xF0)
    # pop %rcx ; imul
    check_byte(35, 0x59)
    check_byte(36, 0x48)
    check_byte(37, 0x0F)
    check_byte(38, 0xAF)
    check_byte(39, 0xC1)
    # push %rax
    check_byte(40, 0x50)
    # movslq -8(%rbp),%rax  (a: int32 -> sign-extending load, 48 63 45 F8)
    check_byte(41, 0x48)
    check_byte(42, 0x63)
    check_byte(43, 0x45)
    check_byte(44, 0xF8)
    # pop %rcx ; add
    check_byte(45, 0x59)
    check_byte(46, 0x48)
    check_byte(47, 0x01)
    check_byte(48, 0xC8)
    # leave ; ret  (return-stmt epilogue)
    check_byte(49, 0xC9)
    check_byte(50, 0xC3)

    # --- Semantic check: emulate the generated code ---------------------
    # f(3, 4) = 3 + 4 * 2 = 11
    r1: uint64 = emu_run(3, 4)
    check_eq("emu f(3,4) err", emu_err, 0)
    check_eq("emu f(3,4) == 11", cast[uint32](r1), 11)

    # f(10, 5) = 10 + 5 * 2 = 20
    r2: uint64 = emu_run(10, 5)
    check_eq("emu f(10,5) err", emu_err, 0)
    check_eq("emu f(10,5) == 20", cast[uint32](r2), 20)

    # f(0, 0) = 0
    r3: uint64 = emu_run(0, 0)
    check_eq("emu f(0,0) == 0", cast[uint32](r3), 0)

    # ===================================================================
    # Extended constructs: comparisons, if/else, while, function call.
    # Each rebuilds the pipeline (lex -> parse -> codegen) on a fresh
    # snippet, then verifies SEMANTICS by emulating the emitted bytes.
    # ===================================================================

    # --- (A) comparison operator: a < b  -> 0/1 -------------------------
    #   def lt(a: int32, b: int32) -> int32:
    #       return a < b
    build_first("def lt(a: int32, b: int32) -> int32:\n    return a < b\n")
    check_eq("cmp codegen err", cg_err, 0)
    # Body `a < b` lowers to: eval b (right) push; eval a; pop %rcx;
    # cmpq %rcx,%rax ; setl %al ; movzbq %al,%rax. Verify via emulation.
    check_eq("cmp emu lt(3,4)==1", cast[uint32](emu_run(3, 4)), 1)
    check_eq("cmp emu lt(4,3)==0", cast[uint32](emu_run(4, 3)), 0)
    check_eq("cmp emu lt(5,5)==0", cast[uint32](emu_run(5, 5)), 0)

    #   def eqf(a,b): return a == b   ;   def ge: return a >= b
    build_first("def eqf(a: int32, b: int32) -> int32:\n    return a == b\n")
    check_eq("eq codegen err", cg_err, 0)
    check_eq("emu eq(7,7)==1", cast[uint32](emu_run(7, 7)), 1)
    check_eq("emu eq(7,8)==0", cast[uint32](emu_run(7, 8)), 0)

    build_first("def gef(a: int32, b: int32) -> int32:\n    return a >= b\n")
    check_eq("ge codegen err", cg_err, 0)
    check_eq("emu ge(8,7)==1", cast[uint32](emu_run(8, 7)), 1)
    check_eq("emu ge(7,7)==1", cast[uint32](emu_run(7, 7)), 1)
    check_eq("emu ge(6,7)==0", cast[uint32](emu_run(6, 7)), 0)

    # --- (B) if / else --------------------------------------------------
    #   def mx(a: int32, b: int32) -> int32:
    #       if a > b:
    #           return a
    #       else:
    #           return b
    build_first("def mx(a: int32, b: int32) -> int32:\n    if a > b:\n        return a\n    else:\n        return b\n")
    check_eq("if codegen err", cg_err, 0)
    check_eq("emu mx(9,4)==9", cast[uint32](emu_run(9, 4)), 9)
    check_eq("emu mx(4,9)==9", cast[uint32](emu_run(4, 9)), 9)
    check_eq("emu mx(5,5)==5", cast[uint32](emu_run(5, 5)), 5)

    # --- (C) while loop summing 1..n ------------------------------------
    #   def sumn(n: int32) -> int32:
    #       s: int32 = 0
    #       i: int32 = 1
    #       while i <= n:
    #           s = s + i
    #           i = i + 1
    #       return s
    build_first("def sumn(n: int32) -> int32:\n    s: int32 = 0\n    i: int32 = 1\n    while i <= n:\n        s = s + i\n        i = i + 1\n    return s\n")
    check_eq("while codegen err", cg_err, 0)
    check_eq("emu sumn(5)==15", cast[uint32](emu_run(5, 0)), 15)
    check_eq("emu sumn(10)==55", cast[uint32](emu_run(10, 0)), 55)
    check_eq("emu sumn(1)==1", cast[uint32](emu_run(1, 0)), 1)
    check_eq("emu sumn(0)==0", cast[uint32](emu_run(0, 0)), 0)

    # --- (D) augmented assignment in a while loop -----------------------
    #   def fact(n: int32) -> int32:
    #       r: int32 = 1
    #       i: int32 = 1
    #       while i <= n:
    #           r = r * i
    #           i += 1
    #       return r
    build_first("def fact(n: int32) -> int32:\n    r: int32 = 1\n    i: int32 = 1\n    while i <= n:\n        r = r * i\n        i += 1\n    return r\n")
    check_eq("augassign codegen err", cg_err, 0)
    check_eq("emu fact(5)==120", cast[uint32](emu_run(5, 0)), 120)
    check_eq("emu fact(4)==24", cast[uint32](emu_run(4, 0)), 24)
    check_eq("emu fact(0)==1", cast[uint32](emu_run(0, 0)), 1)

    # --- (E) function call (two functions, callee + caller) -------------
    #   def add1(x: int32) -> int32:
    #       return x + 1
    #   def caller(a: int32, b: int32) -> int32:
    #       return add1(a) + add1(b)
    # The caller is emitted FIRST so it begins at offset 0; gen_program_
    # all_functions resolves the forward `call add1` fixups.
    build_all("def caller(a: int32, b: int32) -> int32:\n    return add1(a) + add1(b)\ndef add1(x: int32) -> int32:\n    return x + 1\n")
    check_eq("call codegen err", cg_err, 0)
    check_eq("emu caller(3,4)==9", cast[uint32](emu_run(3, 4)), 9)
    check_eq("emu caller(10,20)==32", cast[uint32](emu_run(10, 20)), 32)
    check_eq("emu caller(0,0)==2", cast[uint32](emu_run(0, 0)), 2)

    # ===================================================================
    # Data-type / aggregate constructs added in this milestone: integer
    # division & modulo, bitwise & shift ops, logical and/or, unary
    # operators, and LOCAL ARRAY indexing (load + store, scaled by the
    # element width). Each is verified by emulating the emitted bytes.
    # ===================================================================

    # --- (F) integer division and modulo -------------------------------
    #   def dv(a: int32, b: int32) -> int32:
    #       return a / b
    build_first("def dv(a: int32, b: int32) -> int32:\n    return a / b\n")
    check_eq("div codegen err", cg_err, 0)
    check_eq("emu dv(20,4)==5", cast[uint32](emu_run(20, 4)), 5)
    check_eq("emu dv(7,2)==3", cast[uint32](emu_run(7, 2)), 3)

    build_first("def md(a: int32, b: int32) -> int32:\n    return a % b\n")
    check_eq("mod codegen err", cg_err, 0)
    check_eq("emu md(20,3)==2", cast[uint32](emu_run(20, 3)), 2)
    check_eq("emu md(17,5)==2", cast[uint32](emu_run(17, 5)), 2)

    # --- (G) bitwise AND / OR / XOR and shifts -------------------------
    build_first("def ba(a: int32, b: int32) -> int32:\n    return a & b\n")
    check_eq("bitand codegen err", cg_err, 0)
    check_eq("emu ba(6,3)==2", cast[uint32](emu_run(6, 3)), 2)
    check_eq("emu ba(12,10)==8", cast[uint32](emu_run(12, 10)), 8)

    build_first("def bo(a: int32, b: int32) -> int32:\n    return a | b\n")
    check_eq("bitor codegen err", cg_err, 0)
    check_eq("emu bo(6,3)==7", cast[uint32](emu_run(6, 3)), 7)
    check_eq("emu bo(8,1)==9", cast[uint32](emu_run(8, 1)), 9)

    build_first("def bx(a: int32, b: int32) -> int32:\n    return a ^ b\n")
    check_eq("bitxor codegen err", cg_err, 0)
    check_eq("emu bx(6,3)==5", cast[uint32](emu_run(6, 3)), 5)
    check_eq("emu bx(15,9)==6", cast[uint32](emu_run(15, 9)), 6)

    build_first("def sl(a: int32, b: int32) -> int32:\n    return a << b\n")
    check_eq("shl codegen err", cg_err, 0)
    check_eq("emu sl(1,4)==16", cast[uint32](emu_run(1, 4)), 16)
    check_eq("emu sl(3,2)==12", cast[uint32](emu_run(3, 2)), 12)

    build_first("def sr(a: int32, b: int32) -> int32:\n    return a >> b\n")
    check_eq("shr codegen err", cg_err, 0)
    check_eq("emu sr(16,2)==4", cast[uint32](emu_run(16, 2)), 4)
    check_eq("emu sr(255,4)==15", cast[uint32](emu_run(255, 4)), 15)

    # --- (H) logical and / or ------------------------------------------
    #   def la(a,b): return a and b      (-> 1 iff both nonzero)
    build_first("def la(a: int32, b: int32) -> int32:\n    return a and b\n")
    check_eq("and codegen err", cg_err, 0)
    check_eq("emu la(3,4)==1", cast[uint32](emu_run(3, 4)), 1)
    check_eq("emu la(0,4)==0", cast[uint32](emu_run(0, 4)), 0)
    check_eq("emu la(3,0)==0", cast[uint32](emu_run(3, 0)), 0)
    check_eq("emu la(0,0)==0", cast[uint32](emu_run(0, 0)), 0)

    build_first("def lo(a: int32, b: int32) -> int32:\n    return a or b\n")
    check_eq("or codegen err", cg_err, 0)
    check_eq("emu lo(3,4)==1", cast[uint32](emu_run(3, 4)), 1)
    check_eq("emu lo(0,4)==1", cast[uint32](emu_run(0, 4)), 1)
    check_eq("emu lo(3,0)==1", cast[uint32](emu_run(3, 0)), 1)
    check_eq("emu lo(0,0)==0", cast[uint32](emu_run(0, 0)), 0)

    # Combined: range test `lo <= x and x <= hi` style via nested compares.
    #   def inr(x: int32, lo: int32) -> int32:
    #       return x >= lo and x <= 10
    build_first("def inr(x: int32, lo: int32) -> int32:\n    return x >= lo and x <= 10\n")
    check_eq("range codegen err", cg_err, 0)
    check_eq("emu inr(5,1)==1", cast[uint32](emu_run(5, 1)), 1)
    check_eq("emu inr(0,1)==0", cast[uint32](emu_run(0, 1)), 0)
    check_eq("emu inr(11,1)==0", cast[uint32](emu_run(11, 1)), 0)

    # --- (I) unary operators: negation, bit-not, logical not -----------
    build_first("def ng(a: int32, b: int32) -> int32:\n    return 0 - a\n")
    check_eq("neg-via-sub codegen err", cg_err, 0)
    # Unary NEG node form: `return -a` parses to ND_UNARY(UNOP_NEG).
    build_first("def ng2(a: int32, b: int32) -> int32:\n    return -a + 100\n")
    check_eq("unary neg codegen err", cg_err, 0)
    check_eq("emu ng2(30)==70", cast[uint32](emu_run(30, 0)), 70)
    check_eq("emu ng2(1)==99", cast[uint32](emu_run(1, 0)), 99)

    #   def nt(a: int32, b: int32) -> int32: return not a
    build_first("def nt(a: int32, b: int32) -> int32:\n    return not a\n")
    check_eq("not codegen err", cg_err, 0)
    check_eq("emu nt(0)==1", cast[uint32](emu_run(0, 0)), 1)
    check_eq("emu nt(5)==0", cast[uint32](emu_run(5, 0)), 0)

    #   def bn(a: int32, b: int32) -> int32: return ~a & 255  (bit-not, masked)
    build_first("def bn(a: int32, b: int32) -> int32:\n    return ~a & 255\n")
    check_eq("bitnot codegen err", cg_err, 0)
    check_eq("emu bn(0)==255", cast[uint32](emu_run(0, 0)), 255)
    check_eq("emu bn(255)==0", cast[uint32](emu_run(255, 0)), 0)
    check_eq("emu bn(0x0F)==0xF0", cast[uint32](emu_run(15, 0)), 240)

    # --- (J) LOCAL ARRAY indexing: store then load, uint32 elements -----
    #   def arr3(a: int32, b: int32) -> int32:
    #       xs: Array[4, uint32]
    #       xs[0] = a
    #       xs[1] = b
    #       xs[2] = a + b
    #       return xs[0] + xs[1] + xs[2]
    build_first("def arr3(a: int32, b: int32) -> int32:\n    xs: Array[4, uint32]\n    xs[0] = a\n    xs[1] = b\n    xs[2] = a + b\n    return xs[0] + xs[1] + xs[2]\n")
    check_eq("array u32 codegen err", cg_err, 0)
    check_eq("emu arr3(3,4)==14", cast[uint32](emu_run(3, 4)), 14)
    check_eq("emu arr3(10,1)==22", cast[uint32](emu_run(10, 1)), 22)

    # --- (K) byte array (uint8 elements) — scale 1, sized byte I/O ------
    #   def bytes2(a: int32, b: int32) -> int32:
    #       buf: Array[8, uint8]
    #       buf[0] = a
    #       buf[1] = b
    #       return buf[0] + buf[1]
    build_first("def bytes2(a: int32, b: int32) -> int32:\n    buf: Array[8, uint8]\n    buf[0] = a\n    buf[1] = b\n    return buf[0] + buf[1]\n")
    check_eq("array u8 codegen err", cg_err, 0)
    check_eq("emu bytes2(40,2)==42", cast[uint32](emu_run(40, 2)), 42)
    check_eq("emu bytes2(200,55)==255", cast[uint32](emu_run(200, 55)), 255)

    # --- (L) array index by a VARIABLE + augmented store in a loop ------
    #   def fill(n: int32, k: int32) -> int32:
    #       xs: Array[8, uint32]
    #       i: int32 = 0
    #       while i < n:
    #           xs[i] = i
    #           i = i + 1
    #       s: int32 = 0
    #       j: int32 = 0
    #       while j < n:
    #           s += xs[j]
    #           j = j + 1
    #       return s
    build_first("def fill(n: int32, k: int32) -> int32:\n    xs: Array[8, uint32]\n    i: int32 = 0\n    while i < n:\n        xs[i] = i\n        i = i + 1\n    s: int32 = 0\n    j: int32 = 0\n    while j < n:\n        s = s + xs[j]\n        j = j + 1\n    return s\n")
    check_eq("array var-index codegen err", cg_err, 0)
    # sum 0..n-1
    check_eq("emu fill(5)==10", cast[uint32](emu_run(5, 0)), 10)
    check_eq("emu fill(8)==28", cast[uint32](emu_run(8, 0)), 28)
    check_eq("emu fill(1)==0", cast[uint32](emu_run(1, 0)), 0)

    #   def acc(n: int32, k: int32) -> int32:
    #       xs: Array[4, uint32]
    #       xs[0] = 0
    #       xs[0] += n
    #       xs[0] += k
    #       return xs[0]
    build_first("def acc(n: int32, k: int32) -> int32:\n    xs: Array[4, uint32]\n    xs[0] = 0\n    xs[0] += n\n    xs[0] += k\n    return xs[0]\n")
    check_eq("array augassign codegen err", cg_err, 0)
    check_eq("emu acc(7,5)==12", cast[uint32](emu_run(7, 5)), 12)
    check_eq("emu acc(100,1)==101", cast[uint32](emu_run(100, 1)), 101)

    # ===================================================================
    # Module-level GLOBALS + a relocatable DATA SECTION (this milestone).
    # Globals/strings are laid out into gdata[]; references are RIP-relative
    # leaq's resolved by a data fixup. The emulator routes addresses
    # >= DATA_BASE into gdata[], so these verify BOTH the emitted opcodes
    # (RIP-lea + sized load/store) AND real data-section semantics.
    # ===================================================================

    # --- (M) global counter mutated across two function calls -----------
    # `go` is written FIRST so it begins at code offset 0 (the emu entry).
    #   counter: int32 = 0
    #   def go(a: int32, b: int32) -> int32:
    #       bump(a, 0)
    #       bump(b, 0)
    #       return counter
    #   def bump(x: int32, y: int32) -> int32:
    #       counter = counter + x
    #       return counter
    # go(3,4): counter 0 ->3 ->7, returns 7. The state PERSISTS in gdata[]
    # across both calls — proving the global lives in the data section, not
    # a frame slot.
    build_globals("counter: int32 = 0\ndef go(a: int32, b: int32) -> int32:\n    bump(a, 0)\n    bump(b, 0)\n    return counter\ndef bump(x: int32, y: int32) -> int32:\n    counter = counter + x\n    return counter\n")
    check_eq("global counter codegen err", cg_err, 0)
    # The leaq is RIP-relative (48 8D 05 ...) somewhere in the stream; spot
    # check that the opcode form was emitted at least once.
    check_eq("global rip-lea emitted", has_rip_lea(), 1)
    check_eq("emu go(3,4) counter==7", cast[uint32](emu_run(3, 4)), 7)

    # An int initialiser lands in the data section. Verify the initialiser
    # byte is present in gdata[] BEFORE running (emulation mutates it).
    build_globals("counter: int32 = 5\ndef go(a: int32, b: int32) -> int32:\n    inc(a, 0)\n    return counter\ndef inc(x: int32, y: int32) -> int32:\n    counter = counter + x\n    return counter\n")
    check_eq("global init codegen err", cg_err, 0)
    # Verify the initialiser byte sits in the data section (LE, slot 0).
    check_eq("gdata[0]==5 (initialiser)", cast[uint32](gdata[0]), 5)
    # initialiser 5 + a(10) = 15
    check_eq("emu init counter 5+10==15", cast[uint32](emu_run(10, 0)), 15)

    # --- (N) global array written in a loop then summed -----------------
    #   tbl: Array[8, uint32]
    #   def fillsum(n: int32, k: int32) -> int32:
    #       i: int32 = 0
    #       while i < n:
    #           tbl[i] = i + 1
    #           i = i + 1
    #       s: int32 = 0
    #       j: int32 = 0
    #       while j < n:
    #           s = s + tbl[j]
    #           j = j + 1
    #       return s
    # fillsum(n): tbl = 1..n; sum = n*(n+1)/2.
    build_globals("tbl: Array[8, uint32]\ndef fillsum(n: int32, k: int32) -> int32:\n    i: int32 = 0\n    while i < n:\n        tbl[i] = i + 1\n        i = i + 1\n    s: int32 = 0\n    j: int32 = 0\n    while j < n:\n        s = s + tbl[j]\n        j = j + 1\n    return s\n")
    check_eq("global array codegen err", cg_err, 0)
    check_eq("emu fillsum(5)==15", cast[uint32](emu_run(5, 0)), 15)
    check_eq("emu fillsum(8)==36", cast[uint32](emu_run(8, 0)), 36)
    # tbl is a zero-init array global -> it lives in .bss (no file bytes).
    # After fillsum(8) the written values persist in the emulator's .bss
    # scratch: tbl[0]==1 and tbl[7]==8 (uint32, 4-byte stride). gdata_len
    # is 0 here, so the .bss base is DATA_BASE and tbl[i] maps to emu_bss.
    check_eq("bss tbl[0]==1", cast[uint32](emu_bss[0]), 1)
    check_eq("bss tbl[7]==8", cast[uint32](emu_bss[28]), 8)
    # And NO file/data bytes were spent on the zero-init array.
    check_eq("tbl in .bss -> gdata_len==0", gdata_len, 0)

    # --- (O) string literal: bytes interned NUL-terminated in the data
    # section, indexed back via a string GLOBAL ------------------------
    #   msg: Array[3, uint8] = "Hi"
    #   def rd(a: int32, b: int32) -> int32:
    #       return msg[1]
    # The literal "Hi" is interned at msg's data slot; msg[1] reads 'i'
    # (105). We assert BOTH the index opcode form (a RIP-lea appears) and
    # the raw bytes that landed in gdata[].
    build_globals("msg: Array[3, uint8] = \"Hi\"\ndef rd(a: int32, b: int32) -> int32:\n    return msg[1]\n")
    check_eq("string global codegen err", cg_err, 0)
    check_eq("string global rip-lea emitted", has_rip_lea(), 1)
    check_eq("emu rd msg[1]=='i'(105)", cast[uint32](emu_run(0, 0)), 105)
    check_eq("gdata[0]=='H'(72)", cast[uint32](gdata[0]), 72)
    check_eq("gdata[1]=='i'(105)", cast[uint32](gdata[1]), 105)
    check_eq("gdata[2]==NUL", cast[uint32](gdata[2]), 0)
    check_eq("gdata has \"Hi\\0\"", find_hi(), 1)

    # A bare string literal used as an expression yields its address, and
    # the bytes are interned exactly once (dedup). Build a function that
    # returns the first byte of a uint8 array initialised from the same
    # literal twice — both share one data slot.
    build_globals("a1: Array[3, uint8] = \"Hi\"\na2: Array[3, uint8] = \"Hi\"\ndef rd2(a: int32, b: int32) -> int32:\n    return a1[0] + a2[0]\n")
    check_eq("dup-string codegen err", cg_err, 0)
    # Both globals point at the same interned slot => 'H' + 'H' == 144.
    check_eq("emu rd2 'H'+'H'==144", cast[uint32](emu_run(0, 0)), 144)
    # Dedup: only one "Hi\0" (3 bytes) in the data section.
    check_eq("gdata_len==3 (deduped)", gdata_len, 3)

    # ===================================================================
    # POINTER INDEXING (this milestone). Unlike an Array local (whose slot
    # IS the storage), a Ptr[T] HOLDS an address; p[i] dereferences
    # *(p + i*sizeof(T)). The compiler's own source uses exactly these
    # forms (`word[i]` over a Ptr[uint8] param, `out_off[0] = ...` over a
    # Ptr[int32] param, `lex_src[p]` over a Ptr[uint8] global,
    # `&strbuf[val_start]` address-of). Each test takes a real address with
    # `&`, stuffs it into a pointer, and reads/writes through it, verified
    # by emulating the bytes — the address routes through emu_mem/gdata.
    # ===================================================================

    # --- (P) Ptr[T] local READ: take &xs[0], index back via p[i] --------
    #   def ptrd(a: int32, b: int32) -> int32:
    #       xs: Array[4, uint32]
    #       xs[0] = a
    #       xs[1] = b
    #       p: Ptr[uint32] = &xs[0]
    #       return p[0] + p[1]
    # p holds the frame address of xs[0]; p[0]/p[1] load uint32 (scale 4)
    # through the pointer value, NOT a frame slot.
    build_first("def ptrd(a: int32, b: int32) -> int32:\n    xs: Array[4, uint32]\n    xs[0] = a\n    xs[1] = b\n    p: Ptr[uint32] = &xs[0]\n    return p[0] + p[1]\n")
    check_eq("ptr-local-read codegen err", cg_err, 0)
    check_eq("emu ptrd(3,4)==7", cast[uint32](emu_run(3, 4)), 7)
    check_eq("emu ptrd(10,20)==30", cast[uint32](emu_run(10, 20)), 30)

    # --- (Q) Ptr[T] local WRITE: store through p[i], read back via array -
    #   def stp(a: int32, b: int32) -> int32:
    #       xs: Array[2, int32]
    #       p: Ptr[int32] = &xs[0]
    #       p[0] = a
    #       p[1] = b
    #       return xs[0] + xs[1]
    # The stores go THROUGH the pointer (movl %ecx,(%rax)); the readback via
    # the array proves the data actually landed at xs's frame slots.
    build_first("def stp(a: int32, b: int32) -> int32:\n    xs: Array[2, int32]\n    p: Ptr[int32] = &xs[0]\n    p[0] = a\n    p[1] = b\n    return xs[0] + xs[1]\n")
    check_eq("ptr-local-write codegen err", cg_err, 0)
    check_eq("emu stp(5,9)==14", cast[uint32](emu_run(5, 9)), 14)
    check_eq("emu stp(100,1)==101", cast[uint32](emu_run(100, 1)), 101)

    # --- (R) Ptr[uint8] local, scale 1, byte pointee, p[i] over a buffer -
    #   def pbyte(a: int32, b: int32) -> int32:
    #       buf: Array[8, uint8]
    #       buf[2] = a
    #       buf[3] = b
    #       p: Ptr[uint8] = &buf[0]
    #       return p[2] + p[3]
    build_first("def pbyte(a: int32, b: int32) -> int32:\n    buf: Array[8, uint8]\n    buf[2] = a\n    buf[3] = b\n    p: Ptr[uint8] = &buf[0]\n    return p[2] + p[3]\n")
    check_eq("ptr-byte codegen err", cg_err, 0)
    check_eq("emu pbyte(40,2)==42", cast[uint32](emu_run(40, 2)), 42)
    check_eq("emu pbyte(200,55)==255", cast[uint32](emu_run(200, 55)), 255)

    # --- (S) `*p` DEREF (UNOP_DEREF) of a byte pointer ------------------
    #   def drf(a: int32, b: int32) -> int32:
    #       xs: Array[2, uint8]
    #       xs[0] = a
    #       p: Ptr[uint8] = &xs[0]
    #       return *p
    build_first("def drf(a: int32, b: int32) -> int32:\n    xs: Array[2, uint8]\n    xs[0] = a\n    p: Ptr[uint8] = &xs[0]\n    return *p\n")
    check_eq("deref codegen err", cg_err, 0)
    check_eq("emu drf(77)==77", cast[uint32](emu_run(77, 0)), 77)
    check_eq("emu drf(255)==255", cast[uint32](emu_run(255, 0)), 255)

    # --- (T) Ptr[T] PARAMETER indexed (the `word[i]` / `out_off[0]` shape)
    # A two-function program: the caller stuffs a frame buffer's address
    # into a Ptr[int32] and hands it to a callee that indexes the PARAMETER.
    #   def via(a: int32, b: int32) -> int32:
    #       xs: Array[2, int32]
    #       xs[0] = a
    #       xs[1] = b
    #       return rdp(&xs[0], 0)
    #   def rdp(q: Ptr[int32], z: int32) -> int32:
    #       return q[0] + q[1]
    # `via` is emitted first (offset 0); the call fixup is resolved. `q` is
    # a Ptr[int32] PARAMETER — its arg-reg value is the address, and q[i]
    # dereferences it (load param slot, add scaled index, sized load).
    build_all("def via(a: int32, b: int32) -> int32:\n    xs: Array[2, int32]\n    xs[0] = a\n    xs[1] = b\n    return rdp(&xs[0], 0)\ndef rdp(q: Ptr[int32], z: int32) -> int32:\n    return q[0] + q[1]\n")
    check_eq("ptr-param codegen err", cg_err, 0)
    check_eq("emu via(6,7)==13", cast[uint32](emu_run(6, 7)), 13)
    check_eq("emu via(11,22)==33", cast[uint32](emu_run(11, 22)), 33)

    # --- (U) Ptr[uint8] PARAMETER store: `out_off[0] = v` shape ---------
    #   def wvia(a: int32, b: int32) -> int32:
    #       buf: Array[2, uint8]
    #       wrp(&buf[0], a)
    #       return buf[0]
    #   def wrp(d: Ptr[uint8], v: int32) -> int32:
    #       d[0] = v
    #       return 0
    # wrp stores v THROUGH the pointer parameter d (movb %cl,(%rax)); wvia
    # reads the byte back from buf to prove the write reached the frame.
    build_all("def wvia(a: int32, b: int32) -> int32:\n    buf: Array[2, uint8]\n    wrp(&buf[0], a)\n    return buf[0]\ndef wrp(d: Ptr[uint8], v: int32) -> int32:\n    d[0] = v\n    return 0\n")
    check_eq("ptr-param-store codegen err", cg_err, 0)
    check_eq("emu wvia(123)==123", cast[uint32](emu_run(123, 0)), 123)
    check_eq("emu wvia(250)==250", cast[uint32](emu_run(250, 0)), 250)

    # --- (V) GLOBAL Ptr[uint8] indexed (the `lex_src[p]` shape) ---------
    #   buf: Array[4, uint8]
    #   pp: Ptr[uint8] = 0
    #   def gpi(a: int32, b: int32) -> int32:
    #       buf[0] = a
    #       buf[1] = b
    #       pp = &buf[0]
    #       return pp[0] + pp[1]
    # pp is a GLOBAL Ptr[uint8] (8-byte data slot holding an address). It is
    # assigned the gdata address of buf at runtime, then indexed: the codegen
    # leaqs pp, LOADS its 8-byte value (the held address), adds the scaled
    # index, and does a byte load. Proves global-pointer load+index.
    build_globals("buf: Array[4, uint8]\npp: Ptr[uint8] = 0\ndef gpi(a: int32, b: int32) -> int32:\n    buf[0] = a\n    buf[1] = b\n    pp = &buf[0]\n    return pp[0] + pp[1]\n")
    check_eq("global-ptr codegen err", cg_err, 0)
    check_eq("global-ptr rip-lea emitted", has_rip_lea(), 1)
    check_eq("emu gpi(30,12)==42", cast[uint32](emu_run(30, 12)), 42)
    check_eq("emu gpi(200,55)==255", cast[uint32](emu_run(200, 55)), 255)

    # --- (BSS) .bss array + .data string + .data scalar TOGETHER ---------
    # This is the BSS-model proof: a zero-init array global (`tag`) lives
    # in .bss (NO file bytes), an initialised string global (`name`) and a
    # non-zero scalar global (`base`) live in .data (stored). The program
    # writes into the .bss array, reads it back, and ALSO reads an
    # initialised .data byte + the .data scalar, combining all three.
    #   tag:  Array[8, uint32]          (.bss)
    #   name: Array[4, uint8] = "Hi"     (.data: 'H','i',0)
    #   base: int32 = 10                 (.data)
    #   def bd(a, b) -> int32:
    #       tag[0] = a
    #       tag[1] = b
    #       return tag[0] + tag[1] + name[1] + base
    # bd(3,4) = 3 + 4 + 'i'(105) + 10 = 122.
    build_globals("tag: Array[8, uint32]\nname: Array[4, uint8] = \"Hi\"\nbase: int32 = 10\ndef bd(a: int32, b: int32) -> int32:\n    tag[0] = a\n    tag[1] = b\n    return tag[0] + tag[1] + name[1] + base\n")
    check_eq("bss+data codegen err", cg_err, 0)
    check_eq("bss+data rip-lea emitted", has_rip_lea(), 1)
    # .data holds ONLY "Hi\0" (3 bytes) + the int32 base (4 bytes) = 7;
    # the 32-byte zero-init array is .bss, NOT in the file.
    check_eq("bss+data gdata_len==7", gdata_len, 7)
    check_eq("bss+data name[0]=='H'(72)", cast[uint32](gdata[0]), 72)
    check_eq("bss+data name[1]=='i'(105)", cast[uint32](gdata[1]), 105)
    check_eq("bss+data base scalar==10", cast[uint32](gdata[3]), 10)
    check_eq("emu bd(3,4)==122", cast[uint32](emu_run(3, 4)), 122)
    # The .bss writes from the LAST run landed in emu_bss (tag[0],tag[1] at
    # bss byte offsets 0,4 — uint32 stride). Check persistence here, right
    # after the (3,4) run and BEFORE any further run overwrites them.
    check_eq("bss+data tag[0] persisted", cast[uint32](emu_bss[0]), 3)
    check_eq("bss+data tag[1] persisted", cast[uint32](emu_bss[4]), 4)
    check_eq("emu bd(0,0)==115", cast[uint32](emu_run(0, 0)), 115)
    check_eq("bss+data emu err", emu_err, 0)

    # ===================================================================
    # FINAL self-host constructs: cast[T](x) and break / continue. These
    # are the last two AST nodes codegen.ad's OWN source (lexer/parser/
    # codegen) uses that were previously unhandled. Each is verified by
    # emulating the emitted bytes against hand-computed expected values.
    # ===================================================================

    # --- (W) cast[T](x): pure 64-bit reinterpretation -------------------
    # In this ABI a cast is a no-op (matches codegen_x86.py's
    # `case CastExpr(expr=inner): self.gen_expr(inner)`): widening /
    # narrowing leaves the value in %rax untouched; callers that care about
    # upper bits apply an explicit mask. So cast[uint8](a) + cast[int32](b)
    # passes both operands through unchanged before the add.
    #   def cst(a: int32, b: int32) -> int32:
    #       return cast[uint8](a) + cast[int32](b)
    build_first("def cst(a: int32, b: int32) -> int32:\n    return cast[uint8](a) + cast[int32](b)\n")
    check_eq("cast codegen err", cg_err, 0)
    check_eq("emu cst(3,4)==7", cast[uint32](emu_run(3, 4)), 7)
    check_eq("emu cst(200,55)==255", cast[uint32](emu_run(200, 55)), 255)
    # The narrowing-cast fix TRUNCATES: cast[uint8](300) = 300 & 255 = 44.
    # (Pre-fix this kept all bits; the landed cast-widening fix-up now zero-
    # /sign-fills above the destination width, matching codegen_x86.)
    check_eq("emu cst(300,0)==44", cast[uint32](emu_run(300, 0)), 44)

    # cast through a pointer type then masked: prove cast[Ptr[uint8]](x) is
    # also a no-op reinterpretation of the integer value.
    #   def cstp(a: int32, b: int32) -> int32:
    #       return cast[int64](cast[Ptr[uint8]](a)) & 255
    build_first("def cstp(a: int32, b: int32) -> int32:\n    return cast[int64](cast[Ptr[uint8]](a)) & 255\n")
    check_eq("cast-ptr codegen err", cg_err, 0)
    check_eq("emu cstp(0x1F4)==244", cast[uint32](emu_run(500, 0)), 244)
    check_eq("emu cstp(42)==42", cast[uint32](emu_run(42, 0)), 42)

    # --- (X) break: early loop exit ------------------------------------
    # Sum i = 1,2,3,... but break out when the running sum exceeds n. With
    # n=10 the loop adds 1+2+3+4 = 10 (i=4 makes s=10, not > 10) then i=5
    # makes s=15 > 10 -> break, so s=15. Hand-checked below.
    #   def brk(n: int32, k: int32) -> int32:
    #       s: int32 = 0
    #       i: int32 = 0
    #       while i < 100:
    #           i = i + 1
    #           s = s + i
    #           if s > n:
    #               break
    #       return s
    build_first("def brk(n: int32, k: int32) -> int32:\n    s: int32 = 0\n    i: int32 = 0\n    while i < 100:\n        i = i + 1\n        s = s + i\n        if s > n:\n            break\n    return s\n")
    check_eq("break codegen err", cg_err, 0)
    # n=10: i:1 s:1, i:2 s:3, i:3 s:6, i:4 s:10, i:5 s:15>10 -> break => 15
    check_eq("emu brk(10)==15", cast[uint32](emu_run(10, 0)), 15)
    # n=0: i:1 s:1>0 -> break on first iter => 1
    check_eq("emu brk(0)==1", cast[uint32](emu_run(0, 0)), 1)
    # n=100: s accumulates triangular sums 1,3,6,...,91,105; at i=14 s=105
    # is the first value > 100 -> break => 105.
    check_eq("emu brk(100)==105", cast[uint32](emu_run(100, 0)), 105)

    # --- (Y) continue: skip selected iterations ------------------------
    # Sum only ODD i in 1..n by `continue`-ing on even i.
    #   def cnt(n: int32, k: int32) -> int32:
    #       s: int32 = 0
    #       i: int32 = 0
    #       while i < n:
    #           i = i + 1
    #           if i % 2 == 0:
    #               continue
    #           s = s + i
    #       return s
    build_first("def cnt(n: int32, k: int32) -> int32:\n    s: int32 = 0\n    i: int32 = 0\n    while i < n:\n        i = i + 1\n        if i % 2 == 0:\n            continue\n        s = s + i\n    return s\n")
    check_eq("continue codegen err", cg_err, 0)
    # n=5: odd i in 1..5 = 1+3+5 = 9
    check_eq("emu cnt(5)==9", cast[uint32](emu_run(5, 0)), 9)
    # n=6: odd i in 1..6 = 1+3+5 = 9
    check_eq("emu cnt(6)==9", cast[uint32](emu_run(6, 0)), 9)
    # n=1: i=1 odd -> 1
    check_eq("emu cnt(1)==1", cast[uint32](emu_run(1, 0)), 1)
    # n=0: loop never runs -> 0
    check_eq("emu cnt(0)==0", cast[uint32](emu_run(0, 0)), 0)

    # --- (Z) NESTED loops: inner break exits ONLY the inner loop --------
    # Outer i in 1..n; inner j counts up and `break`s when j == i, adding j
    # to the accumulator each inner iteration. Inner break must NOT exit the
    # outer loop (proves the loop-label stack targets the innermost frame).
    #   def nst(n: int32, k: int32) -> int32:
    #       acc: int32 = 0
    #       i: int32 = 0
    #       while i < n:
    #           i = i + 1
    #           j: int32 = 0
    #           while j < 100:
    #               j = j + 1
    #               acc = acc + j
    #               if j == i:
    #                   break
    #           acc = acc + 1000
    #       return acc
    # Inner loop for outer i runs j=1..i, contributing sum(1..i) plus a
    # +1000 marker per OUTER iteration. For n=3:
    #   i=1: inner adds 1            ; +1000
    #   i=2: inner adds 1+2 = 3      ; +1000
    #   i=3: inner adds 1+2+3 = 6    ; +1000
    #   total = (1+3+6) + 3*1000 = 10 + 3000 = 3010
    build_first("def nst(n: int32, k: int32) -> int32:\n    acc: int32 = 0\n    i: int32 = 0\n    while i < n:\n        i = i + 1\n        j: int32 = 0\n        while j < 100:\n            j = j + 1\n            acc = acc + j\n            if j == i:\n                break\n        acc = acc + 1000\n    return acc\n")
    check_eq("nested-break codegen err", cg_err, 0)
    check_eq("emu nst(3)==3010", cast[uint32](emu_run(3, 0)), 3010)
    # n=1: inner adds 1 ; +1000 => 1001
    check_eq("emu nst(1)==1001", cast[uint32](emu_run(1, 0)), 1001)
    # n=0: outer never runs => 0
    check_eq("emu nst(0)==0", cast[uint32](emu_run(0, 0)), 0)
    # n=4: inner sums 1,3,6,10 = 20 ; +4*1000 => 4020
    check_eq("emu nst(4)==4020", cast[uint32](emu_run(4, 0)), 4020)

    # --- (Z2) NESTED loops: inner CONTINUE skips only inner iterations --
    # Outer i in 1..n; inner j in 1..3 adds j to acc but `continue`s (skips
    # the add) when j == 2. So each outer iter adds 1 + 3 = 4 (j=2 skipped).
    #   def nstc(n: int32, k: int32) -> int32:
    #       acc: int32 = 0
    #       i: int32 = 0
    #       while i < n:
    #           i = i + 1
    #           j: int32 = 0
    #           while j < 3:
    #               j = j + 1
    #               if j == 2:
    #                   continue
    #               acc = acc + j
    #       return acc
    build_first("def nstc(n: int32, k: int32) -> int32:\n    acc: int32 = 0\n    i: int32 = 0\n    while i < n:\n        i = i + 1\n        j: int32 = 0\n        while j < 3:\n            j = j + 1\n            if j == 2:\n                continue\n            acc = acc + j\n    return acc\n")
    check_eq("nested-continue codegen err", cg_err, 0)
    # each outer iter adds 1+3 = 4 (j=2 continue-skipped); n=3 => 12
    check_eq("emu nstc(3)==12", cast[uint32](emu_run(3, 0)), 12)
    check_eq("emu nstc(1)==4", cast[uint32](emu_run(1, 0)), 4)
    check_eq("emu nstc(0)==0", cast[uint32](emu_run(0, 0)), 0)

    # --- (Z3) pass: no-op placeholder statement ------------------------
    # `pass` (used in lexer.ad's char-class branches) emits nothing; the
    # surrounding control flow must still produce the right result.
    #   def psf(a: int32, b: int32) -> int32:
    #       s: int32 = 0
    #       if a > 0:
    #           pass
    #       else:
    #           s = 1
    #       return s + b
    build_first("def psf(a: int32, b: int32) -> int32:\n    s: int32 = 0\n    if a > 0:\n        pass\n    else:\n        s = 1\n    return s + b\n")
    check_eq("pass codegen err", cg_err, 0)
    check_eq("emu psf(5,10)==10", cast[uint32](emu_run(5, 10)), 10)
    check_eq("emu psf(0,10)==11", cast[uint32](emu_run(0, 10)), 11)

    # --- (Z4) char & bool literals: immediates (used across lexer.ad) ---
    # A char literal lowers to `movq $ord,%rax` and a bool to `movq $0/1`,
    # exactly like an int literal (matches codegen_x86's CharLiteral /
    # BoolLiteral cases). lexer.ad uses both heavily ('a'..'z', True/False).
    #   def chr(a: int32, b: int32) -> int32:
    #       return 'A' + a      ('A' == 65)
    build_first("def chr(a: int32, b: int32) -> int32:\n    return 'A' + a\n")
    check_eq("char codegen err", cg_err, 0)
    check_eq("emu chr(0)==65", cast[uint32](emu_run(0, 0)), 65)
    check_eq("emu chr(1)==66", cast[uint32](emu_run(1, 0)), 66)

    #   def bl(a: int32, b: int32) -> int32:
    #       if a > 0:
    #           return True
    #       return False
    build_first("def bl(a: int32, b: int32) -> int32:\n    if a > 0:\n        return True\n    return False\n")
    check_eq("bool codegen err", cg_err, 0)
    check_eq("emu bl(5)==1", cast[uint32](emu_run(5, 0)), 1)
    check_eq("emu bl(0)==0", cast[uint32](emu_run(0, 0)), 0)

    realmod_test()

    emit("[codegen_selftest] emitted ")
    put_u32(code_len)
    emit(" code bytes; ran ")
    put_u32(checks_run)
    emit(" checks, ")
    put_u32(checks_failed)
    emit(" failed\n")

    if checks_failed != 0:
        emit("[codegen_selftest] FAIL\n")
        sys_exit(1)

    emit("[codegen_selftest] PASS\n")
    sys_exit(0)
    return 0


# Run the full lex -> parse -> codegen pipeline over `src`, emitting the
# FIRST function found. Leaves the bytes in code[0..code_len) ready for
# emu_run; sets p_err / cg_err on failure.
def build_first(src: Ptr[uint8]):
    n: uint32 = cast[uint32](strlen(src))
    lex_init(src, n)
    lex_tokenize()
    check_eq("build_first lex err", lex_err, 0)
    parser_init()
    prog: uint32 = parse_program()
    check_eq("build_first parse err", p_err, 0)
    cg_init()
    gen_program_first_function(prog)


# Like build_first but emits EVERY function and resolves inter-function
# calls. The first function emitted starts at offset 0 (emu entry point).
def build_all(src: Ptr[uint8]):
    n: uint32 = cast[uint32](strlen(src))
    lex_init(src, n)
    lex_tokenize()
    check_eq("build_all lex err", lex_err, 0)
    parser_init()
    prog: uint32 = parse_program()
    check_eq("build_all parse err", p_err, 0)
    cg_init()
    gen_program_all_functions(prog)


# Like build_all but ALSO lays out module-level globals + string literals
# into the data section and resolves RIP-relative data fixups. The first
# function emitted starts at offset 0 (emu entry point); globals live at
# DATA_BASE+ in gdata[].
def build_globals(src: Ptr[uint8]):
    n: uint32 = cast[uint32](strlen(src))
    lex_init(src, n)
    lex_tokenize()
    check_eq("build_globals lex err", lex_err, 0)
    parser_init()
    prog: uint32 = parse_program()
    check_eq("build_globals parse err", p_err, 0)
    cg_init()
    gen_program_with_globals(prog)
    # .bss starts zero-init in the loaded image; reset the emulator's .bss
    # scratch so each program sees a clean zero-filled .bss (the loader's
    # memset on device).
    bi: uint32 = 0
    while bi < 8192:
        emu_bss[bi] = 0
        bi = bi + 1


# =======================================================================
# REAL-MODULE milestone: feed an ACTUAL, non-trivial chunk of the live
# compiler source (the character-class predicates from compiler/lexer.ad)
# through the on-device lex -> parse -> codegen.ad pipeline, prove codegen
# succeeds with zero errors, prove every top-level function was emitted,
# and prove the emitted machine code RUNS correctly under the emulator.
#
# The six functions below are lifted VERBATIM from adder/compiler/lexer.ad
# (is_alnum / is_alpha / is_digit / is_hex_digit / to_lower / hex_digit_val)
# — the lexer's real character classifiers. They are reordered so is_alnum
# (which exercises the inter-function call path: is_alnum -> is_alpha and
# is_alnum -> is_digit) is emitted FIRST and therefore begins at code
# offset 0, the emulator's entry point. They use a realistic construct mix:
# `uint8` params, >= / <= / == / != comparisons, logical `and`, multi-arm
# if chains, returns of char arithmetic (`c + 32`, `c - 48`), and forward
# inter-function calls resolved by codegen.ad's call-fixup table.
# -----------------------------------------------------------------------

def realmod_test():
    emit("[codegen_selftest] realmod: compiling real lexer.ad char-class module (is_alnum/is_alpha/is_digit/is_hex_digit/to_lower/hex_digit_val)\n")

    realmod_checks_before: uint32 = checks_failed

    # The real source, as one embedded module (lifted verbatim from the
    # function bodies in adder/compiler/lexer.ad, reordered is_alnum-first).
    src: Ptr[uint8] = "def is_alnum(c: uint8) -> int32:\n    if is_alpha(c) != 0:\n        return 1\n    if is_digit(c) != 0:\n        return 1\n    if c == 95:\n        return 1\n    return 0\ndef is_alpha(c: uint8) -> int32:\n    if c >= 65 and c <= 90:\n        return 1\n    if c >= 97 and c <= 122:\n        return 1\n    return 0\ndef is_digit(c: uint8) -> int32:\n    if c >= 48 and c <= 57:\n        return 1\n    return 0\ndef is_hex_digit(c: uint8) -> int32:\n    if c >= 48 and c <= 57:\n        return 1\n    if c >= 65 and c <= 70:\n        return 1\n    if c >= 97 and c <= 102:\n        return 1\n    return 0\ndef to_lower(c: uint8) -> uint8:\n    if c >= 65 and c <= 90:\n        return c + 32\n    return c\ndef hex_digit_val(c: uint8) -> uint8:\n    if c >= 48 and c <= 57:\n        return c - 48\n    if c >= 65 and c <= 70:\n        return c - 55\n    if c >= 97 and c <= 102:\n        return c - 87\n    return 0\n"
    n: uint32 = cast[uint32](strlen(src))

    lex_init(src, n)
    lex_tokenize()
    check_eq("realmod lex err", lex_err, 0)

    parser_init()
    prog: uint32 = parse_program()
    check_eq("realmod parse err", p_err, 0)

    # The module must parse to exactly six top-level FUNCTION declarations.
    decls: uint32 = nd_b[prog]
    check_eq("realmod first decl is FUNCTION", nd_kind[decls], ND_FUNCTION)
    check_eq("realmod six declarations", chain_len(decls), 6)

    cg_init()
    # Full-program entry WITH globals layout — the real self-hosting path.
    start: uint32 = gen_program_with_globals(prog)
    check_eq("realmod codegen err", cg_err, 0)
    check_eq("realmod first fn at offset 0", start, 0)

    # codegen emitted each function: the call/fixup function table holds all
    # six symbols (is_alnum's forward calls to is_alpha + is_digit resolved).
    check_eq("realmod fn_count == 6", fn_count, 6)

    # Non-trivial amount of real machine code was produced.
    if code_len > 200:
        check_eq("realmod code_len > 200", 1, 1)
    else:
        check_eq("realmod code_len > 200", code_len, 201)

    # One concise machine-readable sentinel for the harness.
    emit("[codegen_selftest] realmod: compiled ")
    put_u32(fn_count)
    emit(" functions, ")
    put_u32(code_len)
    emit(" bytes, ")
    put_u32(cast[uint32](p_err) + cg_err)
    emit(" errors\n")

    # --- Prove the emitted code RUNS: drive is_alnum through the emulator.
    # is_alnum is at offset 0 and calls is_alpha + is_digit (both emitted
    # later, forward-call-fixed). Hand-computed expected values:
    #   is_alnum('A'=65)  -> is_alpha -> 1
    #   is_alnum('z'=122) -> is_alpha -> 1
    #   is_alnum('5'=53)  -> is_alpha 0, is_digit -> 1
    #   is_alnum('0'=48)  -> is_digit -> 1
    #   is_alnum('_'=95)  -> c == 95  -> 1
    #   is_alnum(' '=32)  -> all 0     -> 0
    #   is_alnum('@'=64)  -> all 0     -> 0  (just below 'A')
    #   is_alnum('{'=123) -> all 0     -> 0  (just above 'z')
    check_eq("realmod emu is_alnum('A')==1", cast[uint32](emu_run(65, 0)), 1)
    check_eq("realmod emu is_alnum('z')==1", cast[uint32](emu_run(122, 0)), 1)
    check_eq("realmod emu is_alnum('5')==1", cast[uint32](emu_run(53, 0)), 1)
    check_eq("realmod emu is_alnum('0')==1", cast[uint32](emu_run(48, 0)), 1)
    check_eq("realmod emu is_alnum('_')==1", cast[uint32](emu_run(95, 0)), 1)
    check_eq("realmod emu is_alnum(' ')==0", cast[uint32](emu_run(32, 0)), 0)
    check_eq("realmod emu is_alnum('@')==0", cast[uint32](emu_run(64, 0)), 0)
    check_eq("realmod emu is_alnum('{')==0", cast[uint32](emu_run(123, 0)), 0)
    check_eq("realmod emu is_alnum err", emu_err, 0)

    # Also drive three more of the compiled functions at THEIR code offsets
    # (functions are fn_define'd in emission order, so fn_offset[i] is the
    # entry of the i-th function). This proves every emitted function — not
    # just the offset-0 one — is real, runnable machine code.
    #   index 3 = is_hex_digit ; 4 = to_lower ; 5 = hex_digit_val
    hex_off: uint32 = fn_offset[3]
    check_eq("realmod emu is_hex_digit('F')==1", cast[uint32](emu_run_at(hex_off, 70, 0)), 1)
    check_eq("realmod emu is_hex_digit('9')==1", cast[uint32](emu_run_at(hex_off, 57, 0)), 1)
    check_eq("realmod emu is_hex_digit('g')==0", cast[uint32](emu_run_at(hex_off, 103, 0)), 0)

    low_off: uint32 = fn_offset[4]
    check_eq("realmod emu to_lower('A')==97", cast[uint32](emu_run_at(low_off, 65, 0)), 97)
    check_eq("realmod emu to_lower('Z')==122", cast[uint32](emu_run_at(low_off, 90, 0)), 122)
    check_eq("realmod emu to_lower('a')==97", cast[uint32](emu_run_at(low_off, 97, 0)), 97)

    hv_off: uint32 = fn_offset[5]
    check_eq("realmod emu hex_digit_val('A')==10", cast[uint32](emu_run_at(hv_off, 65, 0)), 10)
    check_eq("realmod emu hex_digit_val('f')==15", cast[uint32](emu_run_at(hv_off, 102, 0)), 15)
    check_eq("realmod emu hex_digit_val('7')==7", cast[uint32](emu_run_at(hv_off, 55, 0)), 7)
    check_eq("realmod emu multi-fn err", emu_err, 0)

    realmod_failed: uint32 = checks_failed
    if realmod_failed == realmod_checks_before:
        emit("[codegen_selftest] realmod PASS\n")
    else:
        emit("[codegen_selftest] realmod FAIL\n")


# Count the length of a sibling chain starting at `head` (0 = empty).
def chain_len(head: uint32) -> uint32:
    n: uint32 = 0
    cur: uint32 = head
    while cur != 0:
        n = n + 1
        cur = nd_next[cur]
    return n


# Returns 1 if a RIP-relative leaq (48 8D 05) appears anywhere in the
# emitted code stream — the byte-level proof that global references go
# through the data section, not a frame slot.
def has_rip_lea() -> uint32:
    i: uint32 = 0
    while i + 2 < code_len:
        if cast[uint32](code[i]) == 0x48 and cast[uint32](code[i + 1]) == 0x8D and cast[uint32](code[i + 2]) == 0x05:
            return 1
        i = i + 1
    return 0


# Returns 1 if the bytes 'H','i',0 ("Hi\0") appear contiguously in the
# data section — the proof that the string literal was interned into
# gdata[] NUL-terminated.
def find_hi() -> uint32:
    i: uint32 = 0
    while i + 2 < gdata_len:
        if cast[uint32](gdata[i]) == 72 and cast[uint32](gdata[i + 1]) == 105 and cast[uint32](gdata[i + 2]) == 0:
            return 1
        i = i + 1
    return 0
