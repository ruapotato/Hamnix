# mm/cow.ad
#
# Copy-on-write (COW) support for fork().
#
# Hamnix runs ET_DYN binaries identity-mapped and clones a per-task
# PML4 on fork. The eager-copy fork path (fs/elf.ad::vm_fork_install_all
# + mm/vma.ad::vma_fork_copy) gave every child a verbatim physical copy
# of every writable region — roughly 33 MiB copied per fork. COW
# replaces that bulk copy with a lazy scheme:
#
#   * On fork, every writable user page is marked READ-ONLY + COW in
#     BOTH the parent's and the child's PML4. Both PML4 entries point at
#     the SAME physical page. The page's refcount is bumped.
#   * On a write fault to a present, read-only, COW-marked page the #PF
#     handler (arch/x86/kernel/trap_diag.ad::do_cow_page_fault) either
#       - clears COW + makes the page writable in place when the page is
#         no longer shared (refcount 1), or
#       - allocates a fresh page, copies the bytes, repoints the faulting
#         task's PTE at the copy (writable, COW cleared), decrements the
#         old page's refcount.
#
# Per-physical-page refcounts
#
#   The buddy allocator (mm/page_alloc.ad) has no struct-page array, so
#   COW carries its own refcount table — one uint16 per 4 KiB physical
#   page frame, indexed by PFN (phys >> 12). The table is sized to the
#   top of the memblock RAM region and allocated from memblock at
#   mem_init() time (cow_init), before the buddy allocator starts
#   handing pages out.
#
#   Refcount semantics:
#     refcount[pfn] == 0  -> page is NOT COW-tracked. It is owned
#                            normally by whoever allocated it; a write
#                            fault on it is a genuine fault.
#     refcount[pfn] == N  -> N page-table entries share this page COW.
#
#   cow_share_page(phys): first share bumps 0 -> 2 (parent + child);
#     a subsequent share (grandchild fork of an already-COW page)
#     bumps N -> N+1.
#   cow_page_is_shared(phys): refcount > 1.
#   cow_drop_page(phys): decrements; returns 1 when the caller should
#     now free the page (refcount fell to 0), 0 otherwise. A page at
#     refcount 0 (untracked) returns 1 immediately — the caller frees
#     it normally.
#
# COW PTE marker
#
#   x86_64 PTE bits 9..11 are available for OS use. We use bit 9
#   (0x200) as the COW marker. A PTE that is Present, has RW clear, and
#   has bit 9 set is a COW page. The page-fault handler distinguishes a
#   COW fault (recoverable) from a genuine protection fault (keep the
#   diagnostic halt).

from mm.memblock import memblock_alloc, memblock_region_top
from kernel.printk.printk import (
    printk0, printk1, printk2, printk3, printk_set_level,
)
from drivers.tty.serial.early_8250 import PRINTK_LEVEL_EMERG

extern def memset(dst: Ptr[uint8], val: int32, n: uint64) -> Ptr[uint8]
# SMP atomicity for the per-PFN refcount table (see _cow_lock below). The
# refcount RMWs (cow_share_page / cow_ref_inc / cow_drop_page) are
# read-modify-writes on a shared uint16 slot; under `-smp 2` two CPUs run
# concurrent fork (share, CPU A) and exec-teardown / reap (drop, CPU B) on
# the SAME region-backed ELF image .text frame, with NO lock between them.
# The plain RMW loses updates, so a live image frame's count can fall to 0
# one drop early — cow_drop_page then returns 1 and the caller free_page()s
# a frame the LIVE parent still executes as .text. The buddy allocator
# reissues it and the parent faults on its own code with `[pf] user fault
# on unmapped ... -> SIGSEGV` (code=139), classified by trap_diag as an
# image-VMA "NO covering VMA / livepte=0" hole (task #112). See the
# mm/vma.ad::_cow_release_forked_range comment ("a race in the share/drop
# accounting"). Serialising every refcount RMW under one short spinlock,
# IRQs masked (so a same-CPU fault/IRQ can never re-enter and self-deadlock),
# makes the accounting exact and closes the double-free window.
extern def spinlock_lock(ptr: Ptr[uint32])
extern def spinlock_unlock(ptr: Ptr[uint32])
extern def local_irq_save() -> uint64
extern def local_irq_restore(flags: uint64)
# get_bsp_cr3() is misnamed — it reads the LIVE %cr3, not a saved
# "BSP CR3". cow_init() runs in mem_init(), before ANY task is
# created, so at that moment the live CR3 genuinely IS the pristine
# boot page-table root. We snapshot it then; fs/elf.ad's COW
# table-cracker reads it back via cow_boot_cr3() so its "is this
# entry still the shared boot mapping?" test compares against tables
# that are never mutated — not against whatever task happens to be
# running (which broke per-task page-table isolation on fork).
extern def get_bsp_cr3() -> uint64

# COW marker — PTE bit 9 (software-available). A PTE with P=1, RW=0 and
# this bit set is a copy-on-write page.
COW_PTE_BIT: uint64 = 0x200

PAGE_SHIFT_4K: uint64 = 12
PAGE_SIZE_4K_C: uint64 = 0x1000

# Refcount table: one uint16 per physical page frame. Base address +
# number of entries (PFN ceiling). Both 0 until cow_init() runs.
cow_refcount_base: uint64 = 0
cow_nr_frames:     uint64 = 0

# Global spinlock protecting every refcount-table RMW. One word guards the
# whole table: the critical sections are a handful of instructions, so a
# single lock has negligible contention and cannot deadlock (leaf ops, no
# reentrancy). Held with IRQs masked so a same-CPU page-fault / timer that
# also touches a refcount can never re-enter and self-deadlock on the word.
_cow_lock: uint32 = 0

# REFERENCE BALANCE (leak pass 12). Every COW reference this table hands out
# must eventually be handed back; a frame that ends up mapped by NOBODY while
# its count is still 1 — which is uniformly what the orphan census finds — is
# by definition one un-returned reference. These two cumulative totals say
# which SIDE of the ledger is wrong, which the per-frame refcount alone
# cannot: if `added` outruns `dropped` by the orphan count, a holder never
# dropped; if they balance, the count is right and the census is reading
# reachability wrong.
#
# THIS IS THE ONE UNCONDITIONAL ADDITION THE PASS-12 INSTRUMENTATION MAKES,
# declared here rather than left for a reader to discover. Every OTHER probe
# added in that pass — the orphan-detail collector, the span classifier, the
# stale-leaf audit at reap and execve — is reachable only from `track census`
# or returns immediately on page_alloc_track_mode() == 0, exactly the
# runtime-armable precedent the census and kmtrack set. These four increments
# are not gated.
#
# The cost, measured rather than asserted. A 13-cycle soak recorded
# added=46289 dropped=43730 — ~6.9 k increments per soak cycle. Each is one
# non-atomic add to a global (~5 cycles), so ~35 k cycles per soak cycle
# against a ~40 s cycle (~1.2e11 cycles at 3 GHz): about 3e-7 of the budget.
# Relative to the call it sits INSIDE it is smaller still — every one of
# these sites already pays local_irq_save/restore (the popf is serialising,
# ~20+ cycles) plus a lock-prefixed spinlock acquire, so the add cannot be
# more than a few percent of work already being done. Gating it would cost a
# global load plus a branch, the same order as the add itself, so a gate
# would buy conformance rather than speed.
#
# /proc/meminfo is byte-identical: _build_meminfo is untouched and nothing
# here is reachable from it (the rule two lost soaks paid for).
#
# Unconditional is the POINT. A counter that only starts existing once you
# already suspect the answer is a counter you do not have when you need it,
# and the reference ledger is what the next pass needs sloped from its FIRST
# soak rather than its second.
_cow_refs_added:   uint64 = 0
_cow_refs_dropped: uint64 = 0


def cow_refs_added() -> uint64:
    return _cow_refs_added


def cow_refs_dropped() -> uint64:
    return _cow_refs_dropped


# --- PER-CALL-SITE ledger (leak pass 13) ------------------------------------
#
# The two totals above say the ledger is unbalanced. They cannot say WHERE,
# and "somewhere in fork" is not a statement a fix can be written against.
# Pass 12 ended on exactly that: the reference is not lost at reap and not
# lost at execve, yet it is outstanding with no mapper — so an add somewhere
# has no matching drop. Splitting the SAME two counters by call site turns one
# soak into a name.
#
# The arm is a pending global set just before the call, exactly the
# pa_set_site pattern the page tracker already uses, and for the same reason:
# threading an extra parameter through cow_share_page / cow_ref_inc /
# cow_drop_page would change three public signatures and every caller in three
# modules for a debug knob. It is NOT per-CPU and NOT reentrant — an IRQ
# landing between cow_set_arm and the call mis-attributes ONE increment. That
# is the same trade _pa_trk_cur_site makes; against ~6.9 k increments per soak
# cycle it cannot move an arm's slope.
#
# GATED, unlike the two totals above. `cow_ledger_enable` is driven from the
# same `track on` / `track full` / `track off` ctl verbs as the page tracker,
# so a disarmed kernel pays one global load and one not-taken branch in
# cow_set_arm and nothing at all in the three RMWs. That keeps pass 12's rule
# — everything new is armable, and the ONLY unconditional additions in this
# whole effort remain the four declared above. /proc/meminfo is untouched.
COW_ARM_MAX: uint64 = 26

# Add side.
COW_ARM_SHARE_WX_RO:      uint64 = 1   # elf: _cow_share_one_page, W^X RO verbatim
COW_ARM_SHARE_COW:        uint64 = 2   # elf: _cow_share_one_page, general COW
COW_ARM_SHARE_WRITABLE:   uint64 = 3   # elf: _share_one_page (vm_share_range)
COW_ARM_REFINC_OWNER:     uint64 = 4   # elf: vm_cow_ref_range over an owner VMA
COW_ARM_REFINC_RESOLVE:   uint64 = 5   # elf: cow_resolve_pte, the fresh copy
COW_ARM_REFINC_PGC_HIT:   uint64 = 6   # vma: shared-mmap page-cache hit
COW_ARM_REFINC_PGC_RACE:  uint64 = 7   # vma: lost the publish race, use theirs
COW_ARM_REFINC_PGC_PUB:   uint64 = 8   # vma: first publisher of a shared frame

# Drop side.
COW_ARM_DROP_VMA_RANGE:   uint64 = 9   # vma: _vma_free_cow_range
COW_ARM_DROP_FORKED:      uint64 = 10  # vma: _cow_release_forked_range
COW_ARM_DROP_STRAYS:      uint64 = 11  # vma: vma_free_cow_strays
COW_ARM_DROP_FILEMAP:     uint64 = 12  # vma: file-backed range teardown
COW_ARM_DROP_RESOLVE:     uint64 = 13  # elf: cow_resolve_pte, the displaced page
COW_ARM_DROP_REGION:      uint64 = 14  # page_alloc: region_free_cow_safe
COW_ARM_DROP_UNMAP:       uint64 = 15  # vma: vma unmap range
COW_ARM_DROP_PGC_FAIL:    uint64 = 16  # vma: shared-mmap install failed, undo
# The same two teardown walks, split by WHICH share created the reference.
# Arms 9/10 alone cannot separate the W^X verbatim share (arm 1) from the
# general COW share (arm 2): both drain into the same walk, so an imbalance
# across 1+2 vs 9+10 names a pair, not a site. The PTE being dropped carries
# the answer -- a W^X share leaves RW=0 with the COW bit CLEAR, a COW share
# leaves RW=0 with the COW bit SET -- so classify at the drop and the two
# ledgers close independently.
COW_ARM_DROP_VMA_RANGE_WX: uint64 = 17
COW_ARM_DROP_FORKED_WX:    uint64 = 18

# The general COW share (arm 2), split by WHICH RANGE vm_cow_share_all was
# walking. Pass 14's origin tag proved arm 2 owns the entire leaked-frame
# population (arm 1 closes at born==died exactly), and the burst is a
# hamtermscene launch — the one app in the soak's pool that spawns a child, so
# the one that runs this share at all. vm_cow_share_all shares THREE fixed
# spans and the teardown that must drain them is assembled from separate,
# individually-gated steps (task_reap step 0b for brk, step 0c for
# image/interp/ustack), so "arm 2 leaks" still names a walk rather than a span.
# Arm 2 stays the DEFAULT, which makes the split total and lossless: whatever
# remains at arm 2 is the mmap-VMA fork path (vma_fork_copy), and a residual
# arm-2 population is a real answer rather than a gap.
COW_ARM_SHARE_COW_IMG:  uint64 = 19
COW_ARM_SHARE_COW_BRK:  uint64 = 20
COW_ARM_SHARE_COW_USTK: uint64 = 21

# The drop side of arm 21: ustack_free_cow_safe, the owner's COW-draining
# reclaim of its user-stack run. Arms 19 and 21 are shared by the SAME call
# (vm_cow_share_all) and differ only in which owner-side reclaim drains them —
# region_free_cow_safe for the image, and until pass 14 NOTHING for the stack.
COW_ARM_DROP_USTACK:    uint64 = 22

# The LAST share path without a per-span origin (leak pass 15). After pass 14
# split vm_cow_share_all's three spans off arm 2, the arm-2 residue was by
# construction the mmap-VMA fork path — mm/vma.ad::vma_fork_copy, which calls
# vm_cow_share_range itself. It does so from TWO structurally different arms
# that are NOT the same span and do NOT drain through the same teardown:
#
#   23 OWNER mmap VMA (owns_pages, !MAP_SHARED) — a node with backing/chunks
#      or an already-COW/pinned node. Both parent and child nodes end up
#      is_cow, and each drains through _vma_node_free -> _vma_free_cow_range
#      over [start, end).
#   24 DEMAND VMA, resident prefix — owns_pages == 0, so the node records NO
#      backing run; the frames were installed by vma_demand_fault and are
#      tracked through rmap, not through the node. The share covers only the
#      pages the parent had already faulted, and the not-present remainder is
#      skipped.
#
# Keeping arm 2 as the default still makes the split total: whatever remains
# at arm 2 after these two is a caller nobody has named, which is an answer
# rather than a gap.
COW_ARM_SHARE_VMA_COW:  uint64 = 23
COW_ARM_SHARE_VMA_DEM:  uint64 = 24

_cow_ledger_on: uint64 = 0
_cow_arm:       uint64 = 0
_cow_arm_add:   Array[26, uint64]
_cow_arm_drop:  Array[26, uint64]

# --- PER-FRAME ORIGIN TAG (leak pass 14) ------------------------------------
#
# TAG THE FRAME, NOT THE CALL. Pass 13's per-arm ledger keys both sides on the
# arm that happened to be executing, which is exact on the ADD side and a proxy
# on the DROP side. Pass 13 tried to close arm 1 (the W^X verbatim share)
# against arm 2 (the general COW share) by reading the COW bit out of the PTE
# being dropped, and the attempt failed for a structural reason it recorded as
# the next obstacle: `region_free_cow_safe` drops ~68.76 refs/cycle working
# from a PHYSICAL base with NO PTE in hand, so the classifier cannot bucket
# them at all. Assigning those 68.76 to arm 1 (region frames are the ELF image,
# which is what the W^X share shares) moves the entire leak onto arm 2 — and
# pass 13 correctly published that as a LEAD, not a result, because the
# instrument did not measure it.
#
# One byte per PFN removes the inference entirely. The byte records the arm
# that took a frame's FIRST reference (the 0 -> N transition). Every later add
# and every drop on that frame is then tallied against that arm no matter which
# call site executes it and no matter whether a PTE is available. Per origin:
#
#   _cow_org_add / _cow_org_drop   references, keyed by the frame's origin
#   _cow_org_born / _cow_org_died  FRAMES entering / leaving refcount > 0
#
# `born - died` per arm is the count of frames still holding a reference that
# the arm created — i.e. the leaked-frame population, attributed, as a COUNT
# rather than a slope. That is the quantity a fix must move, and it cannot be
# confounded by the burst timing that makes a soak MEAN the wrong statistic.
#
# BUCKET 0 is "untagged": a frame whose first reference predates the ledger
# being armed. cow_ledger_enable(1) zeroes the whole origin table, so after
# arming every live frame reads 0 and its eventual drop lands in bucket 0. That
# makes `died > born` NORMAL for bucket 0 and meaningless there; for arms >= 1
# both sides are complete and `born - died` is exact. Reporting the raw pair
# instead of a difference keeps that visible rather than papering over it.
#
# COST. The tallies are gated with the rest of the ledger. The TABLE itself is
# one byte per frame allocated once from memblock in cow_init. MEASURED, not
# asserted — the soak's own boot log prints it:
#
#     [cow] origin table: 261632 bytes (1/frame)      (qemu -m 1G)
#
# 1 byte per 4 KiB frame is 0.0244% of RAM, half what the refcount table beside
# it already costs. It is allocated unconditionally because memblock
# is closed by the time any ctl write could arm the ledger; nothing WRITES it
# while disarmed, so the runtime cost stays exactly zero. _build_meminfo is
# untouched.
_cow_origin_base: uint64 = 0
_cow_org_add:  Array[26, uint64]
_cow_org_drop: Array[26, uint64]
_cow_org_born: Array[26, uint64]
_cow_org_died: Array[26, uint64]


def cow_ledger_enable(on: uint64):
    _cow_ledger_on = on
    if on == 0:
        return
    i: uint64 = 0
    while i < COW_ARM_MAX:
        _cow_arm_add[i] = 0
        _cow_arm_drop[i] = 0
        _cow_org_add[i] = 0
        _cow_org_drop[i] = 0
        _cow_org_born[i] = 0
        _cow_org_died[i] = 0
        i = i + 1
    # Re-baseline the tags too: a frame tagged by a PREVIOUS arming would
    # otherwise contribute a drop with no matching born, silently making one
    # arm look like it over-drops.
    if _cow_origin_base != 0:
        memset(cast[Ptr[uint8]](_cow_origin_base), 0, cow_nr_frames)


def cow_ledger_on() -> uint64:
    return _cow_ledger_on


def cow_drop_arm_for_pte(pte: uint64, arm_cow: uint64,
                         arm_wx: uint64) -> uint64:
    # Which SHARE produced the reference this PTE holds. A W^X verbatim share
    # (fs/elf.ad::_cow_share_one_page's read-only arm) copies the parent's
    # flags through untouched, so RW stays 0 and the COW bit stays CLEAR; the
    # general COW share force-SETS the COW bit. Anything writable never came
    # from either share arm on this path, so it falls to the COW bucket, which
    # keeps the classifier total-and-lossless -- a third bucket would just
    # hide the residue.
    if (pte & COW_PTE_BIT) == 0:
        return arm_wx
    return arm_cow


def cow_set_arm(a: uint64):
    # Attribute the NEXT cow_share_page / cow_ref_inc / cow_drop_page on this
    # CPU to call site `a`. Disarmed cost: one load, one branch, one return.
    if _cow_ledger_on == 0:
        return
    _cow_arm = a


def cow_ledger_add(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_arm_add[a]


def cow_ledger_drop(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_arm_drop[a]


def _cow_org_at(pfn: uint64) -> uint64:
    if _cow_origin_base == 0:
        return 0
    if pfn >= cow_nr_frames:
        return 0
    p: Ptr[uint8] = cast[Ptr[uint8]](_cow_origin_base + pfn)
    return cast[uint64](p[0])


def _cow_org_set(pfn: uint64, a: uint64):
    if _cow_origin_base == 0:
        return
    if pfn >= cow_nr_frames:
        return
    p: Ptr[uint8] = cast[Ptr[uint8]](_cow_origin_base + pfn)
    p[0] = cast[uint8](a)


def cow_origin_of(phys: uint64) -> uint64:
    # The arm that took this frame's FIRST reference, or 0 if untagged (the
    # ledger was disarmed then, or the frame is not COW-tracked). Read-only —
    # the orphan census uses it to say where each orphan came from WITHOUT
    # inferring anything from the state it finds.
    return _cow_org_at(_cow_pfn(phys))


def _cow_ledger_birth(pfn: uint64, n: uint64):
    # The 0 -> N transition: this arm is the frame's ORIGIN. Called with
    # _cow_lock HELD, so the tallies move atomically with the refcount they
    # describe — a ledger that could disagree with the table it audits would
    # be worse than no ledger.
    if _cow_ledger_on == 0:
        return
    if _cow_arm >= COW_ARM_MAX:
        return
    _cow_arm_add[_cow_arm] = _cow_arm_add[_cow_arm] + n
    _cow_org_add[_cow_arm] = _cow_org_add[_cow_arm] + n
    _cow_org_born[_cow_arm] = _cow_org_born[_cow_arm] + 1
    _cow_org_set(pfn, _cow_arm)


def _cow_ledger_note_add(pfn: uint64, n: uint64):
    # A later reference on an ALREADY-tagged frame. The call-keyed tally still
    # records the executing arm (pass 13's numbers stay comparable); the
    # origin-keyed tally credits the arm that created the frame.
    if _cow_ledger_on == 0:
        return
    if _cow_arm < COW_ARM_MAX:
        _cow_arm_add[_cow_arm] = _cow_arm_add[_cow_arm] + n
    org: uint64 = _cow_org_at(pfn)
    _cow_org_add[org] = _cow_org_add[org] + n


def _cow_ledger_note_drop(pfn: uint64, died: uint64):
    if _cow_ledger_on == 0:
        return
    if _cow_arm < COW_ARM_MAX:
        _cow_arm_drop[_cow_arm] = _cow_arm_drop[_cow_arm] + 1
    org: uint64 = _cow_org_at(pfn)
    _cow_org_drop[org] = _cow_org_drop[org] + 1
    if died != 0:
        _cow_org_died[org] = _cow_org_died[org] + 1
        # The frame is leaving refcount > 0. Untag it so a later re-share
        # re-attributes it to whichever arm shares it next, rather than
        # crediting its second life to its first owner.
        _cow_org_set(pfn, 0)


def cow_org_add(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_org_add[a]


def cow_org_drop(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_org_drop[a]


def cow_org_born(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_org_born[a]


def cow_org_died(a: uint64) -> uint64:
    if a >= COW_ARM_MAX:
        return 0
    return _cow_org_died[a]


def cow_tagged_live_frames() -> uint64:
    # Frames still holding a reference that a TAGGED arm (>= 1) created. This
    # is the leaked-frame population as a count, summed over origins; bucket 0
    # is excluded because its `died` legitimately exceeds its `born` (frames
    # that predate the arming).
    t: uint64 = 0
    i: uint64 = 1
    while i < COW_ARM_MAX:
        if _cow_org_born[i] > _cow_org_died[i]:
            t = t + (_cow_org_born[i] - _cow_org_died[i])
        i = i + 1
    return t


def cow_ledger_dump():
    # EMERG, one set_level per line — console_set_interactive suppresses INFO
    # once the prompt is up and printk_set_level arms exactly ONE message.
    # Both constraints already cost this effort a "silent" working probe.
    printk_set_level(PRINTK_LEVEL_EMERG)
    if _cow_ledger_on == 0:
        printk0("[ledger] DISARMED — no per-arm attribution. Write `track full` before `track census`.\n")
        return
    printk2("[ledger] totals: added=%d dropped=%d\n",
            _cow_refs_added, _cow_refs_dropped)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk1("[ledger] totals: outstanding=%d\n",
            _cow_refs_added - _cow_refs_dropped)
    i: uint64 = 1
    while i < COW_ARM_MAX:
        if _cow_arm_add[i] != 0 or _cow_arm_drop[i] != 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[ledger] arm=%d add=%d drop=%d\n",
                    i, _cow_arm_add[i], _cow_arm_drop[i])
        i = i + 1
    # Arm 0 is "nobody called cow_set_arm". A large arm-0 count means the
    # instrumentation is INCOMPLETE, not that a mystery site exists, and
    # saying so keeps a reader from slope-fitting an unattributed residue.
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[ledger] UNATTRIBUTED arm=0 add=%d drop=%d (non-zero means a call site is missing cow_set_arm)\n",
            _cow_arm_add[0], _cow_arm_drop[0])


def cow_origin_dump():
    # THE ORIGIN-KEYED LEDGER. Same references, bucketed by the arm that took
    # each FRAME's first reference instead of by the arm executing the call.
    # No PTE is consulted and nothing is inferred, so `region_free_cow_safe` —
    # which has only a physical base and blocked pass 13 — reports here like
    # every other drop.
    printk_set_level(PRINTK_LEVEL_EMERG)
    if _cow_ledger_on == 0:
        printk0("[origin] DISARMED — write `track full` first.\n")
        return
    if _cow_origin_base == 0:
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[origin] NO TABLE — allocation failed at boot; every frame reads bucket 0 and this dump is VOID.\n")
        return
    i: uint64 = 0
    while i < COW_ARM_MAX:
        if _cow_org_add[i] != 0 or _cow_org_drop[i] != 0 \
                or _cow_org_born[i] != 0 or _cow_org_died[i] != 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[origin] org=%d add=%d drop=%d\n",
                    i, _cow_org_add[i], _cow_org_drop[i])
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[origin] org=%d born=%d died=%d\n",
                    i, _cow_org_born[i], _cow_org_died[i])
        i = i + 1
    # Bucket 0 = frames whose first reference predates the arming. Its `died`
    # legitimately exceeds its `born`; saying so here stops a reader treating
    # that as an over-drop.
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk1("[origin] tagged live frames (sum over org>=1 of born-died) = %d\n",
            cow_tagged_live_frames())


def cow_origin_next_live(org: uint64, from_pfn: uint64) -> uint64:
    # ENUMERATE the live population of one origin (leak pass 15). Returns the
    # next PFN >= from_pfn whose origin byte is `org` AND whose refcount is
    # non-zero, or 0 when there is none.
    #
    # This is EXACTLY the `born - died` population, not an approximation of
    # it: _cow_ledger_note_drop clears the origin byte back to 0 on the frame's
    # death, so "origin == org and refcount > 0" is the same set the born/died
    # pair counts. That equality is the point — an enumeration that could
    # disagree with the tally would be worse than none, which is the rule
    # page_alloc_orphan_collect already follows against the census sweep.
    #
    # O(frames) per call and therefore O(frames * population) to walk a whole
    # origin, which is why this is reachable only from a ctl verb. It exists to
    # answer a question a COUNT cannot: arm 5 has sat at a constant +10 across
    # three independent runs, and a constant is either a fixed resident set or
    # a leak that happens to have stopped. Naming the ten frames' owners
    # settles it once instead of re-litigating it every pass.
    if _cow_ledger_on == 0:
        return 0
    if _cow_origin_base == 0:
        return 0
    p: uint64 = from_pfn
    while p < cow_nr_frames:
        if _cow_org_at(p) == org:
            if cow_refcount(p << 12) != 0:
                return p
        p = p + 1
    return 0


def cow_net_dump():
    # ONE line, O(arms), no page-table walk and no frame scan — cheap enough to
    # take after EVERY app launch. Sampling per launch rather than per cycle is
    # what turns "the leak is bursty" into a named event: pass 13's per-cycle
    # net was 7, 133, 2, 128, 7, 28, 0, 128, ... and five cycles out of twenty
    # carried the whole thing. A per-launch series says WHICH launch.
    printk_set_level(PRINTK_LEVEL_EMERG)
    if _cow_ledger_on == 0:
        printk0("[net] DISARMED\n")
        return
    printk3("[net] added=%d dropped=%d live=%d\n",
            _cow_refs_added, _cow_refs_dropped, cow_tagged_live_frames())

# Pristine boot page-table root (CR3), snapshotted in cow_init() before
# any task exists. The COW page-table cracker compares against THIS to
# decide whether a PML4 entry still aliases the shared boot identity
# map and therefore needs a private clone. Using the live CR3 instead
# (the original bug) made a fork child inherit the parent's private
# page tables and trample them.
cow_boot_cr3_saved: uint64 = 0

# Saturation ceiling for a uint16 refcount. With NTASKS=64 a page can
# be shared by at most ~64 tasks, far under 0xFFFF; the clamp only
# guards against a runaway and makes the saturated page leak (never
# freed) rather than wrap to 0 and double-free.
COW_REFCOUNT_MAX: uint64 = 0xFFFF


def cow_init():
    # Allocate the per-PFN refcount table from memblock. Called from
    # mem_init() AFTER e820_init() has widened the memblock region to
    # the firmware-reported RAM extent, but BEFORE page_alloc_init() —
    # so the table itself comes out of the bump allocator and is never
    # handed to the buddy allocator.
    #
    # The table covers PFN 0 .. (RAM top >> 12). memblock_region_top()
    # is the high-water address of usable RAM; any physical page the
    # buddy allocator can ever return has a PFN below that ceiling.
    top: uint64 = memblock_region_top()
    nframes: uint64 = (top + PAGE_SIZE_4K_C - 1) >> PAGE_SHIFT_4K
    # 2 bytes per frame.
    table_bytes: uint64 = nframes * 2
    base: uint64 = memblock_alloc(table_bytes, 8)
    if base == 0:
        printk0("[cow] FATAL: refcount table alloc failed\n")
        # Leave cow_nr_frames at 0 — cow_share_page / cow_drop_page
        # treat an out-of-range PFN as "untracked", so fork silently
        # falls back to never marking COW. Boot still proceeds.
        return
    memset(cast[Ptr[uint8]](base), 0, table_bytes)
    cow_refcount_base = base
    cow_nr_frames     = nframes
    # PER-FRAME ORIGIN TAG (leak pass 14) — one byte per frame, half the
    # refcount table's footprint, allocated here because memblock is closed
    # long before any ctl write could arm the ledger. Nothing writes it while
    # disarmed. A failed alloc degrades to "every frame untagged" (bucket 0),
    # which costs attribution but never correctness: cow_share_page /
    # cow_drop_page do not consult it.
    obase: uint64 = memblock_alloc(nframes, 8)
    if obase == 0:
        printk0("[cow] origin table alloc failed — drops will be untagged\n")
    else:
        memset(cast[Ptr[uint8]](obase), 0, nframes)
        _cow_origin_base = obase
        printk1("[cow] origin table: %d bytes (1/frame)\n", nframes)
    # Snapshot the pristine boot CR3 NOW — mem_init() runs before the
    # scheduler creates any task, so the live CR3 is still the boot
    # page-table root that every per-task PML4 will be cloned from.
    cow_boot_cr3_saved = get_bsp_cr3()
    printk2("[cow] refcount table: %d frames, %d bytes\n",
            nframes, table_bytes)
    printk1("[cow] pristine boot CR3 = %p\n", cow_boot_cr3_saved)


def cow_boot_cr3() -> uint64:
    # The pristine boot page-table root captured by cow_init(). The COW
    # table-cracker (fs/elf.ad) compares PML4 entries against the boot
    # PML4's entries to decide "still shared boot mapping -> clone".
    return cow_boot_cr3_saved


def _cow_pfn(phys: uint64) -> uint64:
    return phys >> PAGE_SHIFT_4K


def _cow_slot(pfn: uint64) -> Ptr[uint16]:
    # Address of the uint16 refcount for `pfn`, or 0 if out of range /
    # table not initialised.
    if cow_refcount_base == 0:
        return cast[Ptr[uint16]](0)
    if pfn >= cow_nr_frames:
        return cast[Ptr[uint16]](0)
    return cast[Ptr[uint16]](cow_refcount_base + pfn * 2)


def cow_refcount(phys: uint64) -> uint64:
    # Read the refcount of the page frame containing `phys`. 0 means
    # "untracked" (also returned for an out-of-range / pre-init PFN).
    slot: Ptr[uint16] = _cow_slot(_cow_pfn(phys))
    if cast[uint64](slot) == 0:
        return 0
    return cast[uint64](slot[0])


def cow_share_page(phys: uint64):
    # Mark a physical page as shared by one MORE COW mapper. On the
    # FIRST share the refcount goes 0 -> 2 (the parent that already
    # mapped it + the new child). On a subsequent share it goes N ->
    # N+1. An untracked / out-of-range page is silently ignored — the
    # caller's fork falls back to a non-COW behaviour for that page
    # (it stays writable in both, which is wrong only for RAM the
    # refcount table can't index; in practice the table covers all of
    # usable RAM).
    pfn: uint64 = _cow_pfn(phys)
    slot: Ptr[uint16] = _cow_slot(pfn)
    if cast[uint64](slot) == 0:
        return
    _flags: uint64 = local_irq_save()
    spinlock_lock(&_cow_lock)
    cur: uint64 = cast[uint64](slot[0])
    if cur == 0:
        slot[0] = 2
        _cow_refs_added = _cow_refs_added + 2
        _cow_ledger_birth(pfn, 2)
    elif cur < COW_REFCOUNT_MAX:
        slot[0] = cast[uint16](cur + 1)
        _cow_refs_added = _cow_refs_added + 1
        _cow_ledger_note_add(pfn, 1)
    spinlock_unlock(&_cow_lock)
    local_irq_restore(_flags)


def cow_ref_inc(phys: uint64):
    # Plain +1 on a page's refcount. Unlike cow_share_page (which jumps
    # 0 -> 2 to model "parent + child both now hold a previously
    # untracked page"), this increments by exactly one: 0 -> 1, N ->
    # N+1. §1 / mm/vma.ad uses it to bring a not-yet-shared owner VMA
    # under refcount management before splitting it — the VMA has
    # exactly ONE holder at that moment, so its frames must go to
    # refcount 1 (not 2). An out-of-range / pre-init PFN is ignored.
    pfn: uint64 = _cow_pfn(phys)
    slot: Ptr[uint16] = _cow_slot(pfn)
    if cast[uint64](slot) == 0:
        return
    _flags: uint64 = local_irq_save()
    spinlock_lock(&_cow_lock)
    cur: uint64 = cast[uint64](slot[0])
    if cur < COW_REFCOUNT_MAX:
        slot[0] = cast[uint16](cur + 1)
        _cow_refs_added = _cow_refs_added + 1
        # 0 -> 1 is a BIRTH here (cow_ref_inc brings a not-yet-shared owner
        # VMA under management with exactly one holder), N -> N+1 is not.
        if cur == 0:
            _cow_ledger_birth(pfn, 1)
        else:
            _cow_ledger_note_add(pfn, 1)
    spinlock_unlock(&_cow_lock)
    local_irq_restore(_flags)


def cow_page_is_shared(phys: uint64) -> int32:
    # 1 if more than one COW mapper holds this page, else 0.
    if cow_refcount(phys) > 1:
        return 1
    return 0


def cow_drop_page(phys: uint64) -> int32:
    # Drop one COW reference to `phys`. Returns 1 if the CALLER should
    # now physically free the page (the refcount fell to 0), 0 if other
    # mappers still hold it.
    #
    #   refcount 0  (untracked)        -> return 1 (free normally)
    #   refcount 1  -> becomes 0       -> return 1 (last holder)
    #   refcount N>1 -> becomes N-1    -> return 0 (still shared)
    pfn: uint64 = _cow_pfn(phys)
    slot: Ptr[uint16] = _cow_slot(pfn)
    if cast[uint64](slot) == 0:
        return 1
    _flags: uint64 = local_irq_save()
    spinlock_lock(&_cow_lock)
    cur: uint64 = cast[uint64](slot[0])
    ret: int32 = 0
    if cur == 0:
        # Untracked — caller frees normally.
        ret = 1
    elif cur >= COW_REFCOUNT_MAX:
        # Saturated — never decrement, never free. Leaks, but safe.
        ret = 0
    else:
        slot[0] = cast[uint16](cur - 1)
        _cow_refs_dropped = _cow_refs_dropped + 1
        died: uint64 = 0
        if cur == 1:
            died = 1
        _cow_ledger_note_drop(pfn, died)
        if cur == 1:
            ret = 1
    spinlock_unlock(&_cow_lock)
    local_irq_restore(_flags)
    return ret


def cow_pte_bit() -> uint64:
    # Accessor so callers in other modules don't re-declare the bit.
    return COW_PTE_BIT
