# mm/page_alloc.ad
#
# Mirrors mm/page_alloc.c in Linux at the key API surface: order-based
# allocation of contiguous page runs (2^order × 4 KiB) via alloc_pages
# / free_pages, fed by the early memblock allocator underneath. Each
# free run lives on its order's free list with the next-free pointer
# stored in the run's first 8 bytes (Linux's `struct page` would hold
# this on the side; we keep it intrusive for now to dodge the need for
# a memmap[] backing array).
#
# Design choices (M16.15):
#
#   - MAX_ORDER = 10  → up to 1024 contiguous pages = 4 MiB per request.
#   - alloc_pages(order) tries this order's free list, then splits a
#     higher-order block (recursive), then falls back to a fresh
#     memblock_alloc for a properly-aligned chunk.
#   - free_pages(addr, order) returns a run AND coalesces: if the freed
#     run's XOR-buddy at the same order is also free, the pair is merged
#     into one order-(N+1) block and the merge repeats up to MAX_ORDER
#     (the canonical __free_one_page algorithm from mm/page_alloc.c). The
#     buddy is located by scanning that order's free list (_try_remove_buddy)
#     rather than a per-page memmap[] — being present on the list IS the
#     "this buddy is free, same-order, and managed" predicate, so no
#     separate in-range/zone guard is needed: only allocator-managed runs
#     ever reach a free list, and each run is wholly within one memblock
#     region, so a merged pair is always physically-contiguous RAM (two
#     XOR-buddies in different regions force those regions to abut exactly
#     at the buddy boundary). This keeps large high-order allocations
#     serviceable over a long uptime instead of fragmenting.
#
# This sits between the early bump allocator (mm/memblock.ad) and the
# slab allocator (mm/slab.ad): slab uses order-0 single pages, the
# large-kmalloc path in slab.ad uses order >0 for blocks > 2 KiB.

from mm.memblock import memblock_alloc, memblock_region_top, memblock_can_alloc
from mm.cow import (
    cow_boot_cr3, cow_refcount, cow_drop_page,
    cow_set_arm, COW_ARM_DROP_REGION, COW_ARM_DROP_USTACK,
)
from kernel.printk.printk import printk1, printk2, printk3, printk_set_level
from drivers.tty.serial.early_8250 import PRINTK_LEVEL_EMERG
# #mm-parity: reset a frame's struct-page descriptor (LRU membership,
# rmap, flags, mapcount) when it is freed, so a later re-allocation of the
# same PFN never inherits stale reclaim bookkeeping (a freed page still
# linked on the inactive LRU would corrupt the list).
from mm.page import page_reset, page_pfn, page_phys, page_test_flag, PG_LRU
from mm.lru import lru_remove

# CR3 primitives for the boot-CR3 guard below (assembly intrinsics,
# same externs kernel/sched/core.ad and mm/vma.ad declare).
extern def local_irq_save() -> uint64
extern def local_irq_restore(flags: uint64)
extern def read_cr3() -> uint64
extern def load_cr3(value: uint64)

# Lower bound of allocator-managed RAM (the page allocator's floor set by
# e820_init: kernel_image_end() rounded to the memblock start). Any masked
# free-list link BELOW this is provably not an allocator-owned page. Used
# by the free-list integrity guard below to reject a scribbled pointer
# BEFORE it is dereferenced.
extern def kernel_image_end() -> uint64

# SMP buddy-allocator lock (root-cause fix for the intermittent whole-
# system hard freeze after a spawn/reap-heavy operation — e.g. a 3-stage
# `echo | cat | grep` pipeline whose stages exit and are reaped on two
# CPUs at once). Every free list in this file (free_pages_order[]) is
# SHARED global state with an INTRUSIVE next-link in the freed chunk's
# first 8 bytes; alloc_pages / free_pages / _try_remove_buddy all read-
# modify-write it. The boot-CR3 guard masks IRQs LOCALLY but gives ZERO
# cross-CPU mutual exclusion, so two CPUs in the allocator at once race
# the non-atomic list splices: a lost/duplicated link cross-links or
# self-cycles a free list, and the next _try_remove_buddy walk loops
# forever with IRQs masked (the boot-CR3/local_irq_save window) — timer
# dead, console half-emitted, box wedged. This was the dominant cause of
# the pipeline hang on SMP (UP, where the allocator is naturally
# serialised, never reproduced it). A single global spinlock around the
# free-list critical section is sufficient: alloc/free are short and the
# contention window is tiny. Held INSIDE the existing IRQ-off + boot-CR3
# window so lock-hold time is bounded and an IRQ can never observe the
# borrowed CR3 mid-splice.
extern def spinlock_lock(ptr: Ptr[uint32])
extern def spinlock_unlock(ptr: Ptr[uint32])
_pa_buddy_lock: uint32 = 0

# SMP region-pool lock (root-cause fix for the concurrent-execve phys-region
# reuse race). The large-region allocator below (region_alloc / region_free,
# used by fs/elf.ad for every loaded ELF image + interp) keeps per-size
# free-list buckets whose heads AND the intrusive next-link in each pooled
# chunk are SHARED global state read-modify-written on every alloc/free. The
# boot-CR3 guard masks IRQs LOCALLY but gives ZERO cross-CPU exclusion, so
# two CPUs doing execve at once both popped the same bucket head (or both
# cold-missed into memblock_alloc), handing the identical physical image
# region to two address spaces (observed: both got phys 0x0a849000). A
# single global spinlock around the bucket RMW — held INSIDE the existing
# IRQ-off + boot-CR3 window, exactly like _pa_buddy_lock — closes it. Lock
# ordering: region_lock is never held while taking buddy_lock and vice
# versa; the memblock_alloc cold-miss taken under region_lock is a leaf
# (memblock has its own inner lock), so there is no deadlock.
_pa_region_lock: uint32 = 0

PAGE_SIZE:  uint64 = 4096
PAGE_SHIFT: int32  = 12
MAX_ORDER:  int32  = 10            # 2^10 pages = 1024 = 4 MiB


# --- BOOT-CR3 GUARD --------------------------------------------------
#
# Every free list in this file is INTRUSIVE: the `next` link lives in
# the first 8 bytes of the free chunk itself and is read/written
# through a raw PHYSICAL-address pointer (cast[Ptr[uint64]](phys)).
# That is only correct when phys X is identity-mapped at VA X in the
# CURRENT CR3. Hamnix has no kernel-half direct map of RAM
# (phys_to_virt covers the high-half image only), so these accesses
# rely on the identity mapping — which a USER CR3 does not guarantee:
# a native task's image/stack/brk window is identity-mapped at its
# pool phys range, and after an rfork/fork COW crack those user VAs
# point at DIFFERENT frames. A link store at "phys" X issued while
# such a CR3 is live lands in the task's own COW page instead; a link
# load reads user data. The free lists cross-link or self-cycle, and
# the next _try_remove_buddy walk spins forever with IRQs masked —
# the observed whole-system lockup after `enter linux` exits were
# reaped (QEMU regdump: CPU0 at _try_remove_buddy, IF=0, user CR3).
#
# Fix at the allocator layer: every public entry point that touches a
# free-list link runs its body under the PRISTINE BOOT CR3, which
# identity-maps ALL of RAM by construction (the same guard
# _free_task_user_pagetables uses for its raw-physical walk). IRQs
# are masked across the borrowed-CR3 window so no interrupt handler
# can observe it. The switch is skipped when the live CR3 already IS
# the boot root (early boot, kthreads, callers like task_reap that
# batch under the guard themselves) — then the wrap costs two reads.
_PA_CR3_MASK: uint64 = 0x000FFFFFFFFFF000

# One free list per order. Each slot is the head address of that order's
# free chain (0 if empty); each free run carries its next-free pointer
# in the first 8 bytes of its own memory.
free_pages_order: Array[11, uint64]

# Diagnostics: pages ever pulled from memblock at any order.
nr_pages_total:   uint64 = 0
# Pages currently sitting on order-0's free list (subset of total).
# Higher-order free lists are not counted yet; the metric is mostly
# useful for the existing order-0 smoke test.
nr_pages_free:    uint64 = 0
# Cumulative pages returned to the allocator via free_pages. The
# current in-use count is (nr_pages_total - nr_pages_freed_total)
# once the buddy allocator is fully up. Monotonically increasing.
nr_pages_freed_total: uint64 = 0
# LIVE in-use page count: pages currently handed to callers and not yet
# returned. Unlike (nr_pages_total - nr_pages_freed_total) — which drifts
# once a physical page is reused (freed_total counts EVERY free of the
# same PFN, so it eventually exceeds total and clamps to 0) — this is a
# true up/down counter maintained at the PUBLIC alloc_pages / free_pages
# boundary: +2^order on every successful alloc, -2^order on every free.
# It returns to baseline after a spawn/reap cycle iff no pages leaked, and
# it is the counter MemFree/PagesInUse must be derived from. The buddy
# free pool (pages carved from memblock but not live) is exactly
# (nr_pages_total - nr_pages_live).
nr_pages_live: uint64 = 0


# --- free-list integrity guard (QA-N37) ----------------------------
#
# ROOT-CAUSE CATCHER for the intermittent `#GP vec=0x0d` in
# _alloc_pages_raw on `mov rax,[rax]` under heavy memory pressure. That
# fault is a wild dereference of a CORRUPTED free-list pointer: a page
# sitting on a buddy free list had its intrusive `next` link (its first 8
# bytes) SCRIBBLED — by a use-after-free (a task still writes a page after
# it was freed to the buddy allocator), a double-free (the same run pushed
# onto a list twice, then handed out and overwritten while still linked),
# or a stray wild kernel write landing on a free page. The corruption is
# committed silently at free/UAF time and only detonates much later when
# an unrelated allocation pops the poisoned head.
#
# The guard makes the corrupting event self-announcing and non-fatal:
#
#   * Every freed run carries, in ADDITION to its next-link at [0], a
#     position-derived CANARY at [8] == addr ^ _PA_CANARY. The canary is a
#     pure function of the run's own address, so legitimate unlink writes
#     (which only rewrite [0]) never disturb it — but ANY foreign write
#     into a still-free page (a UAF/double-free scribble that clobbers the
#     first cache line) corrupts it. Checked on every pop/walk.
#   * Every link is bounds-validated (_pa_link_ok) before being
#     dereferenced: a valid link is NULL or a page-aligned physical address
#     inside [floor, top). A scribbled non-canonical / sub-floor / user-VA
#     pointer is caught HERE, before the faulting `mov rax,[rax]`.
#   * On detection the guard LOGS the offending page + bad value + order
#     and SELF-HEALS by truncating the list at the corruption point (or
#     ignoring a detected double-free push), so the box survives with a
#     diagnostic instead of hard-halting on the wild deref. Truncation can
#     strand the tail of one list — a bounded leak, never a fault.
#
# This is a permanent guard: it stays on the hot path (two extra word
# accesses + a cached-bounds check per link op) and converts a mysterious
# one-shot halt into a precise, attributable report the moment a bad free
# happens.
_PA_CANARY: uint64 = 0x9A1EDEADF2EE1000

# Cached allocator RAM bounds (populated lazily on first use; both are
# fixed once early boot has enumerated memblock, so a one-shot cache
# avoids re-scanning the region list on every hot-path link op).
_pa_ram_floor_cache: uint64 = 0
_pa_ram_top_cache:   uint64 = 0


def _pa_ram_floor() -> uint64:
    if _pa_ram_floor_cache == 0:
        _pa_ram_floor_cache = kernel_image_end()
    return _pa_ram_floor_cache


def _pa_ram_top() -> uint64:
    if _pa_ram_top_cache == 0:
        _pa_ram_top_cache = memblock_region_top()
    return _pa_ram_top_cache


# --- buddy-ownership bitmap ------------------------------------------
#
# WHICH ALLOCATOR OWNS THIS FRAME? memblock hands RAM to TWO disjoint
# consumers: the buddy allocator (_pa_grow_from_memblock / _pa_donate_raw)
# and the large-region pool (region_alloc, which backs every ELF image and
# PT_INTERP). Both live inside [kernel_image_end(), memblock_region_top()),
# so _pa_link_ok — a pure bounds test — CANNOT tell them apart. Any code
# that decides "may I hand this frame to free_page?" from bounds alone is
# guessing, and guessing wrong pushes a frame the loader still owns onto a
# buddy free list, where it is handed out a second time.
#
# So record the truth at the only place it is known: every page that ever
# enters the buddy pool sets its PFN bit here. page_alloc_owns() is then an
# EXACT predicate, and mm/vma.ad's fork+exec COW teardown uses it to free a
# child-private COW copy while provably never touching a region frame.
#
# One bit per 4 KiB frame of RAM (32 KiB of memblock for a 1 GiB machine),
# carved on first use. Before that the predicate answers 0, which is the
# safe direction: a caller declines to free rather than freeing wrongly.
_pa_own_bm:     uint64 = 0
_pa_own_frames: uint64 = 0


def _pa_own_init():
    if _pa_own_bm != 0:
        return
    top: uint64 = memblock_region_top()
    if top == 0:
        return
    frames: uint64 = top >> 12
    nbytes: uint64 = (frames + 7) >> 3
    b: uint64 = memblock_alloc(nbytes, 8)
    if b == 0:
        return
    i: uint64 = 0
    while i < nbytes:
        cast[Ptr[uint8]](b + i)[0] = 0
        i = i + 1
    _pa_own_frames = frames
    _pa_own_bm = b


def _pa_own_mark(base: uint64, npages: uint64):
    # Record `npages` frames from `base` as buddy-managed. Called from the
    # two (and only two) places RAM enters the buddy pool.
    _pa_own_init()
    if _pa_own_bm == 0:
        return
    pfn: uint64 = base >> 12
    i: uint64 = 0
    while i < npages:
        p: uint64 = pfn + i
        if p < _pa_own_frames:
            byte_at: uint64 = _pa_own_bm + (p >> 3)
            cur: uint64 = cast[uint64](cast[Ptr[uint8]](byte_at)[0])
            cast[Ptr[uint8]](byte_at)[0] = \
                cast[uint8](cur | (cast[uint64](1) << (p & 7)))
        i = i + 1


def page_alloc_owns(phys: uint64) -> int32:
    # 1 iff `phys` lies in a frame the BUDDY allocator manages (as opposed
    # to a region-pool frame or RAM memblock never donated). Conservative:
    # 0 until the bitmap exists.
    if _pa_own_bm == 0:
        return 0
    p: uint64 = phys >> 12
    if p >= _pa_own_frames:
        return 0
    b: uint64 = cast[uint64](cast[Ptr[uint8]](_pa_own_bm + (p >> 3))[0])
    if (b & (cast[uint64](1) << (p & 7))) != 0:
        return 1
    return 0


# --- ALLOCATION TRACKING (--track-allocs) -----------------------------
#
# WHY THIS IS A FIRST-CLASS FEATURE AND NOT A THROWAWAY PATCH
# ===========================================================
# Eleven leak-hunting passes ran against the DE stress soak. FOUR of them
# independently hand-rolled the same instrumentation — a byte per frame
# tagging its allocating call site, a live per-site histogram, free-path
# counters, per-frame order/VA — and each one was reverted before commit.
# That instrumentation is what actually solved things: it localised the
# residual soak leak to cow_resolve_pte (+9.0 pages/cycle) with every other
# site at exactly 0.00, exonerated page tables / slab / region / wsys, and
# disproved three hypotheses at 0.00. Rebuilding it from scratch each pass
# cost hours and risked silent divergence between passes (a site numbered
# 11 in one pass and 12 in the next makes two logs incomparable).
#
# So it lives here, permanently, DEFAULT-OFF, with STABLE site ids.
#
# IT REPRODUCES THE KNOWN RESULT (2026-07-28, 57-cycle DE soak, 228 apps
# launched and closed, `HAMNIX_TRACK_ALLOCS=1 scripts/test_de_stress_soak.sh`,
# sloped by scripts/leakprobe_slopes.py). Total drift PagesInUse +8.38
# pg/cycle. Per site, `live` slope, steady estimator:
#
#     cow_resolve_pte   +7.19   (7.19 / 7.19 / 7.18 — all three agree)
#     vma_anon          +1.97
#     pgtable            0.00     slab       0.00    wsys      0.00
#     execve             0.00     kstack     0.00    pml4      0.00
#     tmpfs              0.00     ustack     0.00    fork_copy 0.00
#     ... and every remaining site at exactly 0.00
#
# 86% of the leak on ONE site, with page tables / slab / region / wsys
# exonerated at 0.00 apiece — the same verdict the hand-rolled passes
# reached, now reachable in one soak with one environment variable. Note
# how loud the exoneration is: slab churns 1896 frames/cycle and wsys
# 4096 frames/cycle, and BOTH hold flat. Rate is not leak.
#
# WHY A RUNTIME CTL AND NOT A BUILD FLAG
# ======================================
# A build flag would mean: rebuild the kernel, rebuild the initramfs,
# rebuild the installer image, reboot the guest — before a soak can even
# start. That rebuild/reflash cycle, not the instrumentation itself, was
# the dominant cost of the eleven passes, and it also means CI and the
# soak run DIFFERENT binaries (so a leak that only reproduces on the CI
# build is invisible to the instrumented one). Tracking is therefore armed
# at RUNTIME by a ctl-file write — Plan 9 shape, per the project's
# "control = ctl-file writes, not syscalls" invariant:
#
#     echo track on    > /proc/meminfo   # site + order/owner metadata
#     echo track full  > /proc/meminfo   # ... plus a per-frame tag word
#     echo track reset > /proc/meminfo   # re-baseline the counters
#     echo track dump  > /proc/meminfo   # one-shot EMERG report to console
#     echo track off   > /proc/meminfo
#
# ONE binary serves CI, the soak, and the debug session; a soak can arm
# tracking after boot has settled so boot-time allocations do not pollute
# the baseline; and the per-frame arrays (which cost ~3.25 MiB on a 1 GiB
# machine in `full` mode) are carved LAZILY from memblock on first enable,
# so a kernel that never arms tracking never pays a byte for it.
#
# THE DEFAULT-OFF COST is exactly: one global load + one compare + one
# not-taken branch in alloc_pages / free_pages, and the same in each
# pa_set_site() call at the tagged sites. No per-frame writes, no memory,
# no change to /proc/meminfo's bytes.
#
# WHAT IS DELIBERATELY NOT HERE: a scan. /proc/meminfo is re-rendered ONCE
# PER 128-BYTE READ CHUNK (see devmeminfo_read_at), so an O(frames) walk in
# _build_meminfo runs ~20x per `cat` and wedges the guest — two soak runs
# were lost to exactly that. Every counter below is an O(1) tally updated
# at alloc/free time. The ONE O(frames) routine, page_alloc_site_sample(),
# is reachable ONLY from the explicit `track dump` ctl.

PA_SITE_MAX: uint64 = 32

# STABLE call-site ids. Append only — NEVER renumber, or a log from an
# older pass stops being comparable with a newer one. Ids 1..19 are
# frozen at the values the pass-6..pass-11 leak hunts used, so the
# archived soak logs in those passes' notes still read correctly.
PA_SITE_UNKNOWN:      uint64 = 0   # untagged site, or pre-arming allocation
PA_SITE_VMA_LARGE:    uint64 = 1   # _vma_alloc_large chunk
PA_SITE_VMA_FIXED:    uint64 = 2   # _vma_alloc_fixed_at chunk
PA_SITE_VMA_PREFAULT: uint64 = 3   # _vma_alloc_locked eager zero-fill
PA_SITE_VMA_FILE:     uint64 = 4   # shared file-backed mmap demand fault
PA_SITE_VMA_HUGE:     uint64 = 5   # 2 MiB huge demand fault
PA_SITE_VMA_ANON:     uint64 = 6   # anonymous demand fault
PA_SITE_VMA_SWAPIN:   uint64 = 7   # swap-in restore page
PA_SITE_VMA_GROW:     uint64 = 8   # _vma_grow_in_place chunk
PA_SITE_PGTABLE:      uint64 = 9   # intermediate PDPT/PD/PT page-table page
PA_SITE_FORK_COPY:    uint64 = 10  # vm_fork_copy_range chunk
PA_SITE_COW_RESOLVE:  uint64 = 11  # cow_resolve_pte private copy
PA_SITE_KSTACK:       uint64 = 12  # create_user_thread kernel stack
PA_SITE_USTACK:       uint64 = 13  # create_user_thread user stack page
PA_SITE_PML4:         uint64 = 14  # a fresh address space's PML4
PA_SITE_SELFTEST:     uint64 = 15  # boot selftest probe pages
PA_SITE_SLAB:         uint64 = 16  # slab refill / large kmalloc
PA_SITE_UACCESS:      uint64 = 17  # uaccess smoke-test pages
PA_SITE_TMPFS:        uint64 = 18  # tmpfs file chunk
PA_SITE_WSYS:         uint64 = 19  # window-system layer/back/shadow buffers
PA_SITE_EXECVE:       uint64 = 20  # execve eager user-stack prefix
PA_SITE_REGION:       uint64 = 21  # region_alloc contiguous carve (ELF image,
                                   # PT_INTERP, wsys large shadow)

# Mode the boot path arms with (leak pass 22). 0 would restore the old
# default-OFF behaviour; 2 is the mode the leak census actually uses, and
# arming at 1 then letting the census upgrade to 2 would leave every frame
# allocated during bringup without a tag word — i.e. it would move the blind
# spot rather than close it.
PA_TRK_BOOT_MODE: uint64 = 2

# Mode: 0 = off, 1 = site + order/owner metadata, 2 = also per-frame tags.
_pa_trk_mode:   uint64 = 0
_pa_trk_armed_at_boot: uint64 = 0  # 1 = armed by mem_init, not by userland
_pa_trk_bytes:  uint64 = 0         # memblock bytes the arrays hold
_pa_trk_frames: uint64 = 0
_pa_trk_site:   uint64 = 0         # byte per frame: site id
_pa_trk_meta:   uint64 = 0         # uint32 per frame: order | owner << 4
_pa_trk_tag:    uint64 = 0         # uint64 per frame: caller tag (fault VA)

# Pending attribution for the NEXT alloc_pages/alloc_page on this CPU.
# Not per-CPU: a mis-attribution under an SMP race costs one frame's tag,
# which is noise against a leak measured in pages per cycle, and a per-CPU
# array here would cost a get_cpu_id() on the default-off path.
_pa_trk_cur_site:  uint64 = 0
_pa_trk_cur_owner: uint64 = 0
_pa_trk_cur_tag:   uint64 = 0

# O(1) tallies. live[] is the histogram ("pages held right now, by site");
# allocs[]/frees[] are cumulative frame counts, so a per-site slope can be
# computed from two samples without a scan.
_pa_trk_live:   Array[32, uint64]
_pa_trk_allocs: Array[32, uint64]
_pa_trk_frees:  Array[32, uint64]


def pa_set_site(s: uint64):
    # Attribute the NEXT buddy allocation on this CPU to call site `s`.
    # Default-off cost: one global load, one compare, one return.
    if _pa_trk_mode == 0:
        return
    _pa_trk_cur_site = s


def pa_set_owner(o: uint64):
    # Attribute the next allocation to a task slot (+1; 0 means unknown).
    # Only the sites that already have a slot in hand call this — there is
    # deliberately NO hook in the scheduler's switch path, because a
    # per-context-switch store would be a real cost paid by everyone.
    if _pa_trk_mode == 0:
        return
    _pa_trk_cur_owner = o + 1


def pa_set_tag(t: uint64):
    # Attach an arbitrary uint64 to the next allocation (the leak hunts
    # used the faulting VA). Only recorded in `full` mode.
    if _pa_trk_mode == 0:
        return
    _pa_trk_cur_tag = t


def _pa_trk_stamp(base: uint64, npages: uint64, order: int32):
    # Called from alloc_pages with the buddy lock HELD, so the per-frame
    # writes and the tallies move atomically with nr_pages_live.
    if _pa_trk_site == 0:
        return
    s: uint64 = _pa_trk_cur_site
    if s >= PA_SITE_MAX:
        s = PA_SITE_UNKNOWN
    meta: uint64 = (cast[uint64](order) & 15) | (_pa_trk_cur_owner << 4)
    pfn: uint64 = base >> 12
    i: uint64 = 0
    while i < npages:
        p: uint64 = pfn + i
        if p < _pa_trk_frames:
            cast[Ptr[uint8]](_pa_trk_site + p)[0] = cast[uint8](s)
            if _pa_trk_meta != 0:
                cast[Ptr[uint32]](_pa_trk_meta + (p << 2))[0] = \
                    cast[uint32](meta)
            if _pa_trk_tag != 0:
                cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0] = _pa_trk_cur_tag
        i = i + 1
    _pa_trk_live[s] = _pa_trk_live[s] + npages
    _pa_trk_allocs[s] = _pa_trk_allocs[s] + npages
    # One-shot: the attribution applies to this allocation only, so an
    # untagged site downstream is honestly reported as PA_SITE_UNKNOWN
    # rather than inheriting whatever ran before it.
    _pa_trk_cur_site = PA_SITE_UNKNOWN
    _pa_trk_cur_owner = 0
    _pa_trk_cur_tag = 0


def _pa_trk_unstamp(base: uint64, npages: uint64):
    # Called from free_pages with the buddy lock HELD, BEFORE the raw free,
    # while the run's frames still belong to the caller. Per-FRAME (not
    # per-run) because the buddy may hand a run out at one order and take
    # it back split across several.
    if _pa_trk_site == 0:
        return
    pfn: uint64 = base >> 12
    i: uint64 = 0
    while i < npages:
        p: uint64 = pfn + i
        if p < _pa_trk_frames:
            s: uint64 = cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0])
            if s >= PA_SITE_MAX:
                s = PA_SITE_UNKNOWN
            if _pa_trk_live[s] > 0:
                _pa_trk_live[s] = _pa_trk_live[s] - 1
            _pa_trk_frees[s] = _pa_trk_frees[s] + 1
            cast[Ptr[uint8]](_pa_trk_site + p)[0] = cast[uint8](0)
        i = i + 1


def _pa_trk_stamp_region(base: uint64, npages: uint64):
    # THE LAST BLIND SPOT (leak pass 16 §8.1). region_alloc does not go
    # through the buddy allocator — it carves from memblock or re-uses a
    # pooled chunk — so until now not one of its frames carried a site or an
    # owner. That is why the ELF image and PT_INTERP reported under site 0,
    # why the census had to scope itself to `USER-MAPPED sites only`, and
    # why COW arms 1 (W^X verbatim share) and 19 (ELF image span) were
    # UNADJUDICATED: `owner-dead = 0` over a population whose owner was
    # never recorded means "nobody wrote an owner down", not "no owner is
    # dead". Every other allocator in the tree was already attributable.
    #
    # Attribution is the SAME one-shot pending-slot protocol alloc_pages
    # uses, so a caller names itself with the same two calls it already
    # knows (pa_set_site / pa_set_owner) — except that an unnamed caller
    # falls back to PA_SITE_REGION rather than PA_SITE_UNKNOWN. Landing in
    # UNKNOWN would be the one bucket whose growth cannot be acted on, and
    # for a region there is always at least one true thing to say.
    #
    # Runs with the region lock held and (on the region_alloc path) under
    # boot CR3, which is what makes the raw-physical tracking-array writes
    # legal there — the same guard region_alloc already takes for its own
    # intrusive free-list header.
    if _pa_trk_site == 0:
        return
    s: uint64 = _pa_trk_cur_site
    if s >= PA_SITE_MAX or s == PA_SITE_UNKNOWN:
        s = PA_SITE_REGION
    # order is meaningless for a region (it is a byte count, not a buddy
    # run), so the low nibble is parked at 15 = "not a buddy order". A
    # consumer that reads meta for an order must not mistake a region for
    # an order-15 buddy run, which the buddy allocator cannot produce.
    meta: uint64 = 15 | (_pa_trk_cur_owner << 4)
    pfn: uint64 = base >> 12
    i: uint64 = 0
    while i < npages:
        p: uint64 = pfn + i
        if p < _pa_trk_frames:
            cast[Ptr[uint8]](_pa_trk_site + p)[0] = cast[uint8](s)
            if _pa_trk_meta != 0:
                cast[Ptr[uint32]](_pa_trk_meta + (p << 2))[0] = \
                    cast[uint32](meta)
            if _pa_trk_tag != 0:
                cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0] = _pa_trk_cur_tag
        i = i + 1
    _pa_trk_live[s] = _pa_trk_live[s] + npages
    _pa_trk_allocs[s] = _pa_trk_allocs[s] + npages
    _pa_trk_cur_site = PA_SITE_UNKNOWN
    _pa_trk_cur_owner = 0
    _pa_trk_cur_tag = 0


def _pa_trk_carve(nbytes: uint64) -> uint64:
    # memblock-carve and zero a tracking array. memblock_alloc still works
    # long after boot (region_alloc cold-misses into it every execve), so
    # arming tracking from a live shell is fine.
    b: uint64 = memblock_alloc(nbytes, 8)
    if b == 0:
        return 0
    i: uint64 = 0
    while i < nbytes:
        cast[Ptr[uint8]](b + i)[0] = 0
        i = i + 1
    return b


def page_alloc_track_reset():
    # Re-baseline. Every frame that is live RIGHT NOW was allocated before
    # this instant, so its attribution is not knowable: park the whole live
    # population under PA_SITE_UNKNOWN and let subsequent frees drain it.
    # Without this the UNKNOWN bucket would underflow-clamp at 0 and its
    # slope would be a lie.
    i: uint64 = 0
    while i < PA_SITE_MAX:
        _pa_trk_live[i] = 0
        _pa_trk_allocs[i] = 0
        _pa_trk_frees[i] = 0
        i = i + 1
    _pa_trk_live[PA_SITE_UNKNOWN] = nr_pages_live
    if _pa_trk_site != 0:
        j: uint64 = 0
        while j < _pa_trk_frames:
            cast[Ptr[uint8]](_pa_trk_site + j)[0] = 0
            j = j + 1


def page_alloc_track_enable(mode: uint64) -> int32:
    # Arm tracking. mode 1 = site + order/owner; mode 2 = also per-frame
    # tag words. Returns 1 on success, 0 if memblock could not supply the
    # arrays (in which case tracking stays OFF rather than half-armed).
    if mode == 0:
        _pa_trk_mode = 0
        return 1
    _pa_own_init()
    fresh: uint64 = 0
    if _pa_trk_site == 0:
        top: uint64 = memblock_region_top()
        if top == 0:
            return 0
        frames: uint64 = top >> 12
        sb: uint64 = _pa_trk_carve(frames)
        if sb == 0:
            return 0
        mb: uint64 = _pa_trk_carve(frames << 2)
        if mb == 0:
            return 0
        _pa_trk_frames = frames
        _pa_trk_meta = mb
        _pa_trk_site = sb
        _pa_trk_bytes = frames + (frames << 2)
        fresh = 1
    if mode >= 2 and _pa_trk_tag == 0:
        tb: uint64 = _pa_trk_carve(_pa_trk_frames << 3)
        if tb == 0:
            # Downgrade rather than fail: site+meta is the load-bearing
            # half, per-frame tags are the luxury.
            mode = 1
        else:
            _pa_trk_tag = tb
            _pa_trk_bytes = _pa_trk_bytes + (_pa_trk_frames << 3)
    # RE-BASELINE ONLY ON A FRESH ARM. page_alloc_track_reset() parks the
    # whole live population under PA_SITE_UNKNOWN, which is the honest thing
    # to do exactly once — when the arrays did not exist and the tracker
    # therefore never saw those frames allocated. It is the WRONG thing to
    # do on any later call, and doing it unconditionally is what made
    # arming at boot pointless: the census arms with `track full` after its
    # settle window, and that second arm used to throw away every
    # attribution bringup had recorded and re-park it all in site 0. The
    # per-frame site bytes survive `track off` (the stamp path guards on
    # the ARRAY, not the mode), so the live histogram stays true across an
    # off/on cycle and needs no re-baseline either. `track reset` is still
    # there for anyone who explicitly wants a new baseline.
    if fresh != 0:
        page_alloc_track_reset()
    _pa_trk_mode = mode
    return 1


def page_alloc_track_boot_arm():
    # ARM AT BOOT (leak pass 22). Called from the arch mem_init() flow the
    # instant the buddy allocator is up and BEFORE anything has allocated
    # from it, so site 0 (PA_SITE_UNKNOWN, "allocated before the tracker
    # was watching") starts EMPTY and stays a real signal instead of a
    # 6000-page pre-arming population that every later reading has to
    # argue around.
    #
    # This is a kernel-internal call on the boot path. It is NOT a poll, it
    # is not driven from userland, and nothing about reclamation depends on
    # it: free_pages unstamps under the same buddy lock that frees, on
    # death, exactly as before. Userland's /proc/meminfo verbs remain the
    # way to READ tracker state and to re-baseline it; they are no longer
    # the way it gets turned on.
    #
    # Cost is PA_TRK_BOOT_MODE-dependent and proportional to RAM:
    #   mode 1 =  5 bytes/frame (site + meta)  = 0.12% of RAM
    #   mode 2 = 13 bytes/frame (+ tag words)  = 0.32% of RAM
    # carved from memblock before the buddy pool is populated, so it is
    # never handed out as usable RAM — the same discipline cow_init() and
    # page_desc_init() already follow.
    if PA_TRK_BOOT_MODE == 0:
        return
    if page_alloc_track_enable(PA_TRK_BOOT_MODE) == 0:
        # memblock could not supply the arrays. Tracking stays OFF rather
        # than half-armed, and the failure is LOUD: a silently-disarmed
        # tracker would make every later leak reading a false negative.
        printk0("[trk] boot-arm FAILED — memblock could not supply the arrays\n")
        return
    _pa_trk_armed_at_boot = 1
    printk2("[trk] boot-arm mode=%d frames=%d\n", _pa_trk_mode, _pa_trk_frames)
    printk2("[trk] boot-arm bytes=%d site0=%d\n",
            _pa_trk_bytes, _pa_trk_live[PA_SITE_UNKNOWN])


def page_alloc_track_armed_at_boot() -> uint64:
    # 1 iff the tracker was armed by the boot path rather than by a write
    # to /proc/meminfo. A reader needs this to know whether its numbers
    # cover the whole system lifetime or only a window.
    return _pa_trk_armed_at_boot


def page_alloc_track_bytes() -> uint64:
    # Bytes of memblock the tracking arrays hold. Reported as a file field
    # so the memory cost of arming is measurable ON DEVICE rather than
    # computed from a formula in a doc.
    return _pa_trk_bytes


def page_alloc_track_mode() -> uint64:
    return _pa_trk_mode


def page_alloc_track_frames() -> uint64:
    return _pa_trk_frames


def page_alloc_site_live(i: uint64) -> uint64:
    if i >= PA_SITE_MAX:
        return 0
    return _pa_trk_live[i]


def page_alloc_site_allocs(i: uint64) -> uint64:
    if i >= PA_SITE_MAX:
        return 0
    return _pa_trk_allocs[i]


def page_alloc_site_frees(i: uint64) -> uint64:
    if i >= PA_SITE_MAX:
        return 0
    return _pa_trk_frees[i]


def page_alloc_site_sample(site: uint64, k: uint64) -> uint64:
    # The k'th live frame tagged `site`, sampled evenly across the PFN
    # space, returned as its recorded tag word (the faulting VA in `full`
    # mode) — the "which addresses are leaking?" question.
    #
    # THIS IS O(frames). It must NEVER be called from _build_meminfo (see
    # the header): the meminfo blob is re-rendered per 128-byte read chunk
    # and a scan there wedges the guest. `track dump` is the only caller.
    if _pa_trk_site == 0 or _pa_trk_tag == 0:
        return 0
    if site >= PA_SITE_MAX:
        return 0
    want: uint64 = _pa_trk_live[site]
    if want == 0:
        return 0
    step: uint64 = want / 8
    if step == 0:
        step = 1
    seen: uint64 = 0
    hit: uint64 = 0
    p: uint64 = 0
    while p < _pa_trk_frames:
        if cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0]) == site:
            if (seen % step) == 0:
                if hit == k:
                    return cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0]
                hit = hit + 1
            seen = seen + 1
        p = p + 1
    return 0


def page_alloc_site_owner(site: uint64) -> uint64:
    # Owner slot (+1) recorded on the FIRST live frame tagged `site`, or 0.
    # O(frames) — `track dump` only, same rule as page_alloc_site_sample.
    if _pa_trk_site == 0 or _pa_trk_meta == 0:
        return 0
    if site >= PA_SITE_MAX:
        return 0
    p: uint64 = 0
    while p < _pa_trk_frames:
        if cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0]) == site:
            m: uint64 = cast[uint64](cast[Ptr[uint32]](_pa_trk_meta + (p << 2))[0])
            return m >> 4
        p = p + 1
    return 0


# --- ORPHAN CENSUS (reachability) -------------------------------------
#
# WHY THIS IS THE MISSING INSTRUMENT
# ==================================
# --track-allocs answers "which site is HOLDING pages?". It cannot answer
# the question that actually distinguishes a leak from ordinary growth:
#
#     is this frame still mapped by ANYBODY?
#
# Ten leak-hunting passes chased the cow_resolve_pte residual and every one
# of them had its briefed hypothesis overturned, because every one was
# reasoning about which free path *ought* to have covered a frame instead of
# measuring whether the frame was still reachable. Those are different
# questions with different answers:
#
#   * site holds N pages, all UNREACHABLE  -> a real leak. Some free path
#     is missing, and the tagged VAs say exactly which span to look at.
#   * site holds N pages, all REACHABLE    -> NOT a leak at all. The
#     process genuinely maps more memory than it did a cycle ago, and the
#     honest fix is upstream of the allocator (or it is working set, and
#     "PagesInUse grew" is the wrong metric).
#   * a mix -> the orphan count IS the leak rate, separated from the noise
#     of real growth, which is what makes a small residual measurable at
#     all.
#
# Nothing in the tree could tell these apart, so a "+7.4 pages/cycle on
# cow_resolve_pte" verdict was compatible with both a free-path bug and a
# DE that simply keeps more heap live. That ambiguity is why the residual
# survived ten passes, and it is also why two attempted fixes were FATAL:
# both freed frames at a site the census would have shown to be reachable.
#
# HOW: mark-and-sweep, exactly like a GC tracer.
#   1. Zero a per-PFN reachable bit.
#   2. Walk EVERY live task's page tables and set the bit for every present
#      leaf frame (kernel/sched/core.ad::mm_orphan_census drives this — it
#      owns task_table and already has the hardened walk).
#   3. Sweep the tracker's per-frame site bytes: a frame with a live site
#      tag and NO reachable bit is an ORPHAN. Tally per site, and report a
#      few of their recorded tags (the faulting VA) so the leaking SPAN is
#      named, not just the site.
#
# COST AND WHERE IT MAY RUN: O(page tables + frames). That makes it
# strictly a `track census` ctl operation — the SAME rule as
# page_alloc_site_sample. It must NEVER be called from _build_meminfo,
# which is re-rendered once per 128-byte read chunk (~20x per `cat`) and
# would wedge the guest; two soak runs were already lost to exactly that.
# Default-off cost is zero: the bitmap is carved on first census.

_pa_reach_bm:     uint64 = 0
_pa_reach_frames: uint64 = 0
_pa_orphans:      Array[32, uint64]


def page_alloc_census_begin() -> int32:
    # Carve (once) and clear the reachable bitmap. Returns 1 when the
    # census can proceed, 0 if there is no per-frame site table to sweep
    # (tracking was never armed, so there is nothing to attribute) or
    # memblock could not supply the bitmap. Returning 0 rather than
    # reporting an empty census matters: "0 orphans" and "could not look"
    # must never print the same way.
    if _pa_trk_site == 0:
        return 0
    if _pa_reach_bm == 0:
        top: uint64 = memblock_region_top()
        if top == 0:
            return 0
        frames: uint64 = top >> 12
        nbytes: uint64 = (frames + 7) >> 3
        b: uint64 = memblock_alloc(nbytes, 8)
        if b == 0:
            return 0
        _pa_reach_frames = frames
        _pa_reach_bm = b
    nb: uint64 = (_pa_reach_frames + 7) >> 3
    i: uint64 = 0
    while i < nb:
        cast[Ptr[uint8]](_pa_reach_bm + i)[0] = 0
        i = i + 1
    j: uint64 = 0
    while j < PA_SITE_MAX:
        _pa_orphans[j] = 0
        j = j + 1
    return 1


def page_alloc_census_mark(phys: uint64, npages: uint64):
    # Mark a run of frames REACHABLE. Called once per present leaf found by
    # the page-table walk; npages > 1 for a 2 MiB / 1 GiB huge leaf.
    if _pa_reach_bm == 0:
        return
    p: uint64 = phys >> 12
    i: uint64 = 0
    while i < npages:
        q: uint64 = p + i
        if q < _pa_reach_frames:
            byte_at: uint64 = _pa_reach_bm + (q >> 3)
            cast[Ptr[uint8]](byte_at)[0] = cast[uint8](
                cast[uint64](cast[Ptr[uint8]](byte_at)[0])
                | (cast[uint64](1) << (q & 7)))
        i = i + 1


def page_alloc_site_is_user_mapped(s: uint64) -> int32:
    # 1 iff frames tagged `s` are supposed to be reachable through a USER
    # page-table entry, so that "absent from every page table" is evidence
    # of a leak.
    #
    # WHY THIS ALLOWLIST IS LOAD-BEARING, AND NOT A CONVENIENCE. A page-table
    # walk is the wrong oracle for a KERNEL frame: a kernel stack, a slab
    # page, a PML4, a wsys framebuffer and a tmpfs chunk are owned by kernel
    # data structures and have NO user PTE anywhere, by design. Sweeping them
    # against page-table reachability would report the ENTIRE live kernel
    # population as orphaned — a census that flags thousands of false leaks
    # is worse than no census, because the one real leak is then invisible in
    # the noise, and acting on a false orphan is exactly how two earlier fix
    # attempts freed a live frame and wedged the desktop.
    #
    # So kernel sites are reported as NOT APPLICABLE rather than as clean or
    # as leaking, and the census makes a claim only where it has a real
    # oracle. Auditing kernel-side reachability needs a different instrument
    # (kmtrack for the heap; a per-owner sweep for kstack/pml4/wsys), which
    # is named honestly in the report as still missing.
    if s == PA_SITE_VMA_LARGE or s == PA_SITE_VMA_FIXED:
        return 1
    if s == PA_SITE_VMA_PREFAULT or s == PA_SITE_VMA_FILE:
        return 1
    # PA_SITE_VMA_HUGE is deliberately ABSENT: the walk no longer marks huge
    # leaves (they are the identity/kernel map), so judging 2 MiB frames here
    # would orphan every one of them falsely.
    if s == PA_SITE_VMA_ANON:
        return 1
    if s == PA_SITE_VMA_SWAPIN or s == PA_SITE_VMA_GROW:
        return 1
    if s == PA_SITE_FORK_COPY or s == PA_SITE_COW_RESOLVE:
        return 1
    if s == PA_SITE_USTACK or s == PA_SITE_EXECVE:
        return 1
    return 0


def page_alloc_census_sweep() -> uint64:
    # Sweep the per-frame site table against the reachable bitmap and
    # tally orphans per site. Returns the total orphan count.
    #
    # Two exclusions, both there to stop the census manufacturing leaks:
    #
    #   * sites that are not user-mapped (see above) — a page-table walk
    #     cannot judge a kernel frame;
    #   * frames the buddy allocator does not own — a region-backed image
    #     frame is reclaimed wholesale by its owner and is not expected to
    #     appear in any page table once the owner is gone, so counting it
    #     would name a leak no free path is missing.
    if _pa_trk_site == 0 or _pa_reach_bm == 0:
        return 0
    total: uint64 = 0
    p: uint64 = 0
    while p < _pa_trk_frames:
        s: uint64 = cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0])
        if s != 0 and s < PA_SITE_MAX \
                and page_alloc_site_is_user_mapped(s) != 0:
            reach: uint64 = 0
            if p < _pa_reach_frames:
                reach = cast[uint64](
                    cast[Ptr[uint8]](_pa_reach_bm + (p >> 3))[0]) \
                    & (cast[uint64](1) << (p & 7))
            if reach == 0 and page_alloc_owns(p << 12) != 0:
                _pa_orphans[s] = _pa_orphans[s] + 1
                total = total + 1
        p = p + 1
    return total


def page_alloc_census_orphans(site: uint64) -> uint64:
    if site >= PA_SITE_MAX:
        return 0
    return _pa_orphans[site]


# --- ORPHAN DETAIL (the pass-12 question: WHICH SPAN, and WHOSE?) -----
#
# page_alloc_orphan_sample() names a leaking VA, which is one step short of
# an actionable statement: a bare VA cannot say whether the frame belonged
# to a task that has since died (so a TEARDOWN missed it) or to one that is
# still running (so the leak is in an IN-LIFE unmap and no teardown fix can
# ever close it). Those need different fixes, and pass 11 could not tell
# them apart.
#
# So collect the whole tuple in ONE sweep — VA, phys, and the OWNING TASK
# SLOT recorded at allocation time (cow_resolve_pte now pa_set_owner()s the
# faulting task). kernel/sched/core.ad::_mm_census_classify turns that into
# "pid 6, still live, inside [image_lo,image_hi)" or "slot 9, DEAD".
#
# One sweep, not three: page_alloc_orphan_sample is O(frames) PER SAMPLE,
# and asking it for 16 samples x 3 fields would be 48 full scans of a
# 512 K-frame table on a `track census` that already walks every page table.
PA_ORPH_CAP: uint64 = 64
_pa_orph_n:     uint64 = 0
_pa_orph_va:    Array[64, uint64]
_pa_orph_phys:  Array[64, uint64]
_pa_orph_owner: Array[64, uint64]


def page_alloc_orphan_collect(site: uint64) -> uint64:
    # Fill the orphan-detail arrays for `site` (up to PA_ORPH_CAP entries)
    # and return how many were collected. Uses the SAME orphan predicate as
    # page_alloc_census_sweep, so a frame counted there is a frame described
    # here — a detail list that disagreed with the tally would be worse than
    # none at all.
    _pa_orph_n = 0
    if _pa_trk_site == 0 or _pa_reach_bm == 0:
        return 0
    if site >= PA_SITE_MAX:
        return 0
    p: uint64 = 0
    while p < _pa_trk_frames:
        if _pa_orph_n >= PA_ORPH_CAP:
            return _pa_orph_n
        if cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0]) == site:
            reach: uint64 = 0
            if p < _pa_reach_frames:
                reach = cast[uint64](
                    cast[Ptr[uint8]](_pa_reach_bm + (p >> 3))[0]) \
                    & (cast[uint64](1) << (p & 7))
            if reach == 0 and page_alloc_owns(p << 12) != 0:
                k: uint64 = _pa_orph_n
                _pa_orph_phys[k] = p << 12
                _pa_orph_va[k] = 0
                if _pa_trk_tag != 0:
                    _pa_orph_va[k] = \
                        cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0]
                _pa_orph_owner[k] = 0
                if _pa_trk_meta != 0:
                    _pa_orph_owner[k] = cast[uint64](
                        cast[Ptr[uint32]](_pa_trk_meta + (p << 2))[0]) >> 4
                _pa_orph_n = k + 1
        p = p + 1
    return _pa_orph_n


def page_alloc_orphan_va(k: uint64) -> uint64:
    if k >= _pa_orph_n:
        return 0
    return _pa_orph_va[k]


def page_alloc_orphan_phys(k: uint64) -> uint64:
    if k >= _pa_orph_n:
        return 0
    return _pa_orph_phys[k]


def page_alloc_orphan_owner(k: uint64) -> uint64:
    # Task slot + 1 as recorded by pa_set_owner at allocation time; 0 when
    # the site does not record an owner (or `track full` was not armed).
    if k >= _pa_orph_n:
        return 0
    return _pa_orph_owner[k]


def page_alloc_orphan_sample(site: uint64, k: uint64) -> uint64:
    # The k'th ORPHANED frame's recorded tag (the faulting VA in `full`
    # mode) for `site`. This is the payoff: it names the VA SPAN that is
    # leaking, which is what turns "cow_resolve_pte leaks" into "the leak
    # is in [brk_base, brk_max)" — a statement a free path can be checked
    # against. O(frames); `track census` only.
    if _pa_trk_site == 0 or _pa_trk_tag == 0 or _pa_reach_bm == 0:
        return 0
    if site >= PA_SITE_MAX:
        return 0
    hit: uint64 = 0
    p: uint64 = 0
    while p < _pa_trk_frames:
        if cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0]) == site:
            reach: uint64 = 0
            if p < _pa_reach_frames:
                reach = cast[uint64](
                    cast[Ptr[uint8]](_pa_reach_bm + (p >> 3))[0]) \
                    & (cast[uint64](1) << (p & 7))
            if reach == 0 and page_alloc_owns(p << 12) != 0:
                if hit == k:
                    return cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0]
                hit = hit + 1
        p = p + 1
    return 0


# Positive-control frame: a deliberately UNMAPPED, tagged allocation.
_pa_planted: uint64 = 0
PA_PLANT_TAG: uint64 = 0xC0FFEE00


def page_alloc_census_plant() -> uint64:
    # THE CENSUS'S POSITIVE CONTROL, and it is not optional.
    #
    # "0 orphans" has TWO possible causes: nothing is orphaned, or the census
    # cannot see. Those are indistinguishable from the output alone, and the
    # second is a FALSE EXONERATION — the most expensive failure mode in this
    # whole effort, because an over-broad reachability mark reports every site
    # clean forever and ends the hunt with a wrong answer that looks like a
    # right one. My own first draft of this census had exactly that bug: it
    # followed the shared boot tables, which identity-map ALL of RAM, so the
    # first task walked marked every frame in the machine reachable.
    #
    # So: allocate ONE order-0 frame at a user-mapped site, map it NOWHERE,
    # and give it a recognisable tag. A census run while this frame is
    # outstanding MUST report at least one orphan at PA_SITE_VMA_ANON and
    # MUST show PA_PLANT_TAG among that site's sample tags. If it reports
    # zero, the census is broken and every "clean" verdict it gave is void.
    #
    # It runs under the REAL workload (the soak's 19 live address spaces,
    # private tables everywhere), not only at boot, so it exercises the
    # actual walk rather than a degenerate empty-address-space case.
    if _pa_planted != 0:
        return _pa_planted
    pa_set_site(PA_SITE_VMA_ANON)
    pa_set_tag(PA_PLANT_TAG)
    p: uint64 = alloc_page()
    if p == 0:
        return 0
    _pa_planted = p
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[census] planted control orphan phys=%p tag=%p\n",
            p, PA_PLANT_TAG)
    return p


def page_alloc_census_unplant():
    # Return the control frame. Deliberately a separate verb from plant, so
    # the census runs while the frame is genuinely outstanding.
    if _pa_planted == 0:
        return
    free_page(_pa_planted)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk1("[census] control orphan phys=%p returned\n", _pa_planted)
    _pa_planted = 0


def page_alloc_census_planted() -> uint64:
    return _pa_planted


# --- NEGATIVE control frame: deliberately MAPPED, and must NOT be reported ---
#
# The positive control above proves the census can SEE an unmapped frame. It
# says nothing about the other error direction, and that direction is the one
# every conclusion drawn from "44 orphans" rests on: if the walk misses a
# private table, mis-indexes the reachable bitmap, or declines a leaf it should
# have marked, the census manufactures orphans out of perfectly live frames.
# Every span attribution, every owner-liveness claim and every disproof pass 12
# recorded would then be describing an artefact of the instrument.
#
# The circumstantial evidence was good — `site 6: 1 orphan of 41 live`, that
# one orphan being the plant — but "good circumstantial evidence" is exactly
# what passes 1..11 kept acting on. So: allocate a frame at a user-mapped site,
# MAP it into a long-lived task's address space at a scratch VA, and require
# the census to mark it reachable and NOT count it. Two properties make it a
# real test of the walk rather than a formality:
#
#   * the scratch VA is far above every span the loader installs, so the
#     mapping is reached only through tables the walk CRACKED — the private
#     path, which is the only path the census follows;
#   * phys != VA by construction (the scratch VA is above RAM top), so the
#     leaf survives the walk's identity filter, which is the filter that made
#     the positive control fail once before.
#
# kernel/sched/core.ad::mm_census_plant_mapped installs the mapping (it owns
# task_table); this module owns the frame, the tag and the verdict.
_pa_mplanted:   uint64 = 0
_pa_mplant_va:  uint64 = 0
_pa_mplant_slot: uint64 = 0
PA_MPLANT_TAG:  uint64 = 0xBEEF0FAB  # distinct from PA_PLANT_TAG (0xC0FFEE00)


def page_alloc_census_mplant_alloc() -> uint64:
    # Allocate the negative-control frame, tagged like a real user page so the
    # sweep judges it under exactly the same predicate as a COW copy. Mapping
    # is the caller's job; the frame is NOT armed as a control until
    # page_alloc_census_mplant_arm is told where it landed.
    if _pa_mplanted != 0:
        return _pa_mplanted
    pa_set_site(PA_SITE_VMA_ANON)
    pa_set_tag(PA_MPLANT_TAG)
    p: uint64 = alloc_page()
    return p


def page_alloc_census_mplant_arm(phys: uint64, va: uint64, slot: uint64):
    _pa_mplanted = phys
    _pa_mplant_va = va
    _pa_mplant_slot = slot
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[census] planted MAPPED control phys=%p va=%p\n", phys, va)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk1("[census] mapped control installed in task slot %d\n", slot)


def page_alloc_census_mplant_clear():
    _pa_mplanted = 0
    _pa_mplant_va = 0
    _pa_mplant_slot = 0


def page_alloc_census_mplanted() -> uint64:
    return _pa_mplanted


def page_alloc_census_mplant_va() -> uint64:
    return _pa_mplant_va


def page_alloc_census_mplant_slot() -> uint64:
    return _pa_mplant_slot


def page_alloc_frame_reachable(phys: uint64) -> uint64:
    # 1 iff the last census marked the frame containing `phys` reachable.
    # Reads the SAME bit page_alloc_census_sweep tests, so a disagreement
    # between this and the orphan tally is impossible by construction.
    if _pa_reach_bm == 0:
        return 0
    p: uint64 = phys >> 12
    if p >= _pa_reach_frames:
        return 0
    b: uint64 = cast[uint64](cast[Ptr[uint8]](_pa_reach_bm + (p >> 3))[0])
    if (b & (cast[uint64](1) << (p & 7))) != 0:
        return 1
    return 0


def page_alloc_frame_site(phys: uint64) -> uint64:
    # The recorded site byte for a frame, or 0 when tracking is not armed.
    if _pa_trk_site == 0:
        return 0
    p: uint64 = phys >> 12
    if p >= _pa_trk_frames:
        return 0
    return cast[uint64](cast[Ptr[uint8]](_pa_trk_site + p)[0])


def page_alloc_frame_owner(phys: uint64) -> uint64:
    # Task slot + 1 as recorded by pa_set_owner at allocation time; 0 when the
    # site records no owner, or `track full` was not armed. Same field
    # page_alloc_orphan_owner reports, addressed by frame instead of by orphan
    # index — the origin-live dump (leak pass 15) walks the ORIGIN table, not
    # the reachability bitmap, so it cannot go through the orphan arrays.
    if _pa_trk_meta == 0:
        return 0
    p: uint64 = phys >> 12
    if p >= _pa_trk_frames:
        return 0
    return cast[uint64](cast[Ptr[uint32]](_pa_trk_meta + (p << 2))[0]) >> 4


def page_alloc_frame_tag(phys: uint64) -> uint64:
    # The recorded caller tag (the faulting VA at every site that sets one),
    # or 0 outside `track full`.
    if _pa_trk_tag == 0:
        return 0
    p: uint64 = phys >> 12
    if p >= _pa_trk_frames:
        return 0
    return cast[Ptr[uint64]](_pa_trk_tag + (p << 3))[0]


def page_alloc_census_report(total: uint64):
    # EMERG report — INFO is suppressed once the shell prompt is up
    # (console_set_interactive), and printk_set_level arms exactly ONE
    # message, so the level is re-armed per line. Same two constraints
    # page_alloc_track_dump documents; a pass already lost a run to a
    # "silent" probe that was working perfectly and being swallowed.
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[census] orphaned frames: %d (of %d live)\n",
            total, nr_pages_live)
    # State the SCOPE in the output, every time. A reader who does not know
    # the census only judges user-mapped sites could read "0 orphans" as
    # "nothing leaks anywhere", which is exactly the false exoneration this
    # whole exercise exists to avoid.
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk0("[census] scope: USER-MAPPED sites only. kernel sites (pgtable/slab/kstack/pml4/wsys/tmpfs) have no user PTE by design and are NOT judged here — use kmtrack for the heap.\n")
    # SELF-VALIDATION. If a control orphan is outstanding, the census MUST
    # have found it. Saying so in the census's own output is the difference
    # between a measurement and a hope: a reader must never have to take
    # "0 orphans" on faith, because an over-broad reachability mark produces
    # exactly that output while seeing nothing at all.
    if _pa_planted != 0:
        if total == 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk0("[census] CONTROL FAILED: a planted UNMAPPED frame was NOT detected. This census is BLIND and every clean verdict from it is VOID.\n")
        else:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk1("[census] control OK: planted orphan detected (%d orphan(s) total, control included)\n", total)
    else:
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[census] NO CONTROL PLANTED: a 0-orphan result here is UNVALIDATED — write `track plant` before `track census`.\n")
    # NEGATIVE CONTROL. A mapped frame MUST be marked reachable and MUST NOT
    # be tallied. If it is not, the census over-reports and every non-zero
    # orphan count it has ever produced is suspect — which is a strictly more
    # valuable result than any fix, so it is stated in the strongest terms the
    # log can carry rather than left for a reader to infer from a tally.
    if _pa_mplanted != 0:
        r: uint64 = page_alloc_frame_reachable(_pa_mplanted)
        s: uint64 = page_alloc_frame_site(_pa_mplanted)
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk3("[census] negctl phys=%p site=%d reachable=%d\n",
                _pa_mplanted, s, r)
        if r == 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk0("[census] NEGATIVE CONTROL FAILED: a frame that IS mapped was NOT marked reachable, so it was counted as an ORPHAN. This census OVER-REPORTS and every orphan count from it is VOID.\n")
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk2("[census]   negctl va=%p in task slot %d — the walk missed this live mapping.\n",
                    _pa_mplant_va, _pa_mplant_slot)
        else:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk2("[census] negative control OK: mapped frame at va=%p (slot %d) marked reachable, not counted.\n",
                    _pa_mplant_va, _pa_mplant_slot)
    else:
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[census] NO NEGATIVE CONTROL: a non-zero orphan count here is UNVALIDATED against over-reporting — write `track mplant` before `track census`.\n")
    i: uint64 = 0
    while i < PA_SITE_MAX:
        # Report every user-mapped site with live frames, INCLUDING the ones
        # at zero orphans: "site holds 412 frames, 0 unreachable" is a real
        # exoneration and is more informative than silence, which is
        # indistinguishable from "not measured".
        if page_alloc_site_is_user_mapped(i) != 0 and _pa_trk_live[i] != 0 \
                and _pa_orphans[i] == 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk2("[census] site %d: 0 orphans, live %d (all reachable)\n",
                    i, _pa_trk_live[i])
        if _pa_orphans[i] != 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[census] site %d: %d orphans, live %d\n",
                    i, _pa_orphans[i], _pa_trk_live[i])
            # Name the leaking SPAN, not just the site: four sample VAs is
            # enough to tell "scattered across the heap" from "one span".
            k: uint64 = 0
            while k < 4:
                t: uint64 = page_alloc_orphan_sample(i, k)
                if t != 0:
                    printk_set_level(PRINTK_LEVEL_EMERG)
                    printk3("[census] site %d orphan[%d] tag_va=%p\n",
                            i, k, t)
                k = k + 1
        i = i + 1


def page_alloc_track_dump():
    # One-shot console report. TWO hard-won constraints are encoded here:
    #
    #   1. console_set_interactive() suppresses INFO-level printks once the
    #      shell prompt is up, so an in-guest trace MUST be EMERG or it is
    #      simply not printed. A pass lost a run to a "silent" probe that
    #      was working perfectly and being swallowed.
    #   2. printk_set_level() arms EXACTLY ONE message. A multi-line report
    #      that sets the level once loses everything after the first line.
    #      So every printk below is preceded by its own set_level call.
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[trk] mode=%d frames=%d\n", _pa_trk_mode, _pa_trk_frames)
    i: uint64 = 0
    while i < PA_SITE_MAX:
        if _pa_trk_allocs[i] != 0 or _pa_trk_live[i] != 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[trk] site=%d live=%d allocs=%d\n",
                    i, _pa_trk_live[i], _pa_trk_allocs[i])
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk2("[trk]   site=%d frees=%d\n", i, _pa_trk_frees[i])
        i = i + 1
    if _pa_trk_tag == 0:
        return
    # VA samples for the two sites the COW leak lives on.
    _pa_trk_dump_tags(PA_SITE_COW_RESOLVE)
    _pa_trk_dump_tags(PA_SITE_VMA_ANON)


def _pa_trk_dump_tags(site: uint64):
    k: uint64 = 0
    while k < 8:
        v: uint64 = page_alloc_site_sample(site, k)
        if v != 0:
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk2("[trk] site=%d va=%p\n", site, v)
        k = k + 1


def _pa_link_ok(addr: uint64) -> int32:
    # A valid intrusive free-list link is either NULL (end of list) or a
    # page-aligned physical address inside allocator-managed RAM. Anything
    # else is a scribbled pointer we must NOT dereference.
    if addr == 0:
        return 1
    if (addr & 0xFFF) != 0:
        return 0
    floor: uint64 = _pa_ram_floor()
    if floor != 0 and addr < floor:
        return 0
    top: uint64 = _pa_ram_top()
    if top != 0 and addr >= top:
        return 0
    return 1


def _pa_set_next(node: uint64, next_val: uint64):
    # Push-side link store: the intrusive next-link at [0] plus the
    # position-derived canary at [8]. Callers guarantee `node` is a real
    # page-aligned run of at least one page (>= 16 bytes), so [8] is in
    # bounds and is dead memory until the run is re-allocated.
    cast[Ptr[uint64]](node)[0] = next_val
    cast[Ptr[uint64]](node + 8)[0] = node ^ _PA_CANARY


def _pa_get_next(node: uint64, order: int32) -> uint64:
    # Pop/walk-side link load. Verifies the canary (catches a page written
    # while free — UAF / double-free) and the link value (catches a
    # scribbled pointer) BEFORE returning. On any failure, logs the
    # corrupting event with full context and SELF-HEALS by returning 0
    # (truncate the list here) so the kernel never faults on a wild deref.
    canary: uint64 = cast[Ptr[uint64]](node + 8)[0]
    if canary != (node ^ _PA_CANARY):
        printk2("[pa-corrupt] page %p scribbled while free (UAF/double-free) order=%d\n",
                node, cast[uint64](order))
        printk2("[pa-corrupt]   canary=%p expected=%p — truncating free list\n",
                canary, node ^ _PA_CANARY)
        return 0
    nxt: uint64 = cast[Ptr[uint64]](node)[0]
    if _pa_link_ok(nxt) == 0:
        printk2("[pa-corrupt] page %p has wild next-link %p — truncating free list\n",
                node, nxt)
        return 0
    return nxt


# --- order-N alloc / free ------------------------------------------

def alloc_pages(order: int32) -> uint64:
    # Returns a page-aligned base address of 2^order contiguous 4 KiB
    # pages, or 0 on OOM. Caller "owns" the entire run until they
    # call free_pages(addr, order). Boot-CR3 guard: see header above —
    # the free-list link loads/stores in _alloc_pages_raw must resolve
    # through a CR3 that identity-maps all of RAM.
    _ap_live: uint64 = read_cr3()
    _ap_irq: uint64 = local_irq_save()
    _ap_boot: uint64 = cow_boot_cr3()
    _ap_sw: int32 = 0
    if _ap_boot != 0 and (_ap_boot & _PA_CR3_MASK) != (_ap_live & _PA_CR3_MASK):
        load_cr3(_ap_boot)
        _ap_sw = 1
    # SMP mutual exclusion over the shared free lists (see _pa_buddy_lock).
    # Inside the IRQ-off + boot-CR3 window: this CPU cannot be preempted
    # while holding the lock, so a remote CPU only ever spins on it for the
    # short list-splice and never deadlocks against an IRQ handler.
    spinlock_lock(&_pa_buddy_lock)
    ret: uint64 = _alloc_pages_raw(order)
    # Live in-use accounting at the public boundary. A non-zero return
    # means 2^order pages were handed to the caller; count them live so
    # the buddy free pool (nr_pages_total - nr_pages_live) — and hence
    # MemFree — reflects the reclaimable pool accurately. Done inside the
    # buddy lock so the RMW is SMP-atomic with the raw body's own counters.
    if ret != 0 and order >= 0 and order <= MAX_ORDER:
        nr_pages_live = nr_pages_live + (cast[uint64](1) << cast[uint64](order))
        # Allocation tracking (default-off: one load + one not-taken
        # branch). Inside the buddy lock so the per-site tallies stay
        # consistent with nr_pages_live under SMP.
        if _pa_trk_mode != 0:
            _pa_trk_stamp(ret, cast[uint64](1) << cast[uint64](order), order)
    spinlock_unlock(&_pa_buddy_lock)
    if _ap_sw != 0:
        load_cr3(_ap_live)
    local_irq_restore(_ap_irq)
    return ret


def pages_can_alloc(order: int32) -> int32:
    # NON-MUTATING pre-check: returns 1 if alloc_pages(order) would succeed
    # right now, else 0. Mirrors _alloc_pages_raw's supply sources: a ready
    # run at THIS order, a splittable run at any HIGHER order (the buddy
    # split path always succeeds down to `order` once a higher run exists),
    # or a fresh memblock cold-carve of the full run width.
    #
    # execve stack atomicity (fix/execve-ustack-oom): do_execve calls this
    # BEFORE the point-of-no-return (vma_clear) to confirm the eager user-
    # stack prefix's contiguous alloc_pages() run is available, so a genuine
    # fragmentation OOM fails execve with the CALLER INTACT (-ENOMEM, Linux
    # semantics) instead of past-PONR where alloc_pages returning 0 would
    # stamp the fixed stack window's US=1 leaves onto physical [0, ...) and
    # corrupt the boot page tables. Racy under SMP (a rival CPU can drain the
    # run between here and the real alloc), so the alloc site keeps a hard
    # null-check backstop.
    if order < 0 or order > MAX_ORDER:
        return 0
    _ac_live: uint64 = read_cr3()
    _ac_irq: uint64 = local_irq_save()
    _ac_boot: uint64 = cow_boot_cr3()
    _ac_sw: int32 = 0
    if _ac_boot != 0 and (_ac_boot & _PA_CR3_MASK) != (_ac_live & _PA_CR3_MASK):
        load_cr3(_ac_boot)
        _ac_sw = 1
    spinlock_lock(&_pa_buddy_lock)
    ok: int32 = 0
    o: int32 = order
    while o <= MAX_ORDER:
        if free_pages_order[cast[uint64](o)] != 0:
            ok = 1
            o = MAX_ORDER + 1
        else:
            o = o + 1
    spinlock_unlock(&_pa_buddy_lock)
    if _ac_sw != 0:
        load_cr3(_ac_live)
    local_irq_restore(_ac_irq)
    if ok == 0:
        # No pooled run at this-or-higher order; would a cold memblock carve
        # succeed? Mirror _pa_grow_from_memblock EXACTLY: the naturally-
        # aligned carve first, then the page-aligned over-carve fallback.
        # Missing the fallback here would make the pre-check reject an
        # execve the real allocator could have serviced.
        size: uint64 = PAGE_SIZE << cast[uint64](order)
        if memblock_can_alloc(size, size) != 0:
            ok = 1
        elif order > 0 and memblock_can_alloc(size + size - PAGE_SIZE,
                                              PAGE_SIZE) != 0:
            ok = 1
    return ok


def _alloc_pages_raw(order: int32) -> uint64:
    # Body of alloc_pages; must run under an identity-mapping CR3
    # (the public wrapper guarantees it). nr_pages_free is bumped
    # along every code path that adds/removes from order-0's free
    # list so the counter stays consistent across split / merge /
    # direct free.
    if order < 0:
        return 0
    if order > MAX_ORDER:
        return 0

    # Path 1: this order's free list has a ready run.
    o: uint64 = cast[uint64](order)
    head: uint64 = free_pages_order[o]
    if head != 0:
        # Integrity guard: a corrupted list head is the exact source of the
        # QA-N37 `mov rax,[rax]` #GP. Validate it BEFORE dereferencing;
        # if it is wild, log and drop the poisoned list rather than fault,
        # then fall through to the split / memblock paths.
        if _pa_link_ok(head) == 0:
            printk2("[pa-corrupt] order-%d free-list head is wild: %p — dropping list\n",
                    o, head)
            free_pages_order[o] = 0
        else:
            free_pages_order[o] = _pa_get_next(head, order)
            if order == 0:
                nr_pages_free = nr_pages_free - 1
            return head

    # Path 2: split a higher-order run into two halves of this order;
    # return one half, put the other half on this order's free list.
    # (Recurse on the RAW body — the wrapper already holds the guard.)
    if order < MAX_ORDER:
        higher: uint64 = _alloc_pages_raw(order + 1)
        if higher != 0:
            half: uint64 = PAGE_SIZE << o
            buddy: uint64 = higher + half
            _pa_set_next(buddy, free_pages_order[o])
            free_pages_order[o] = buddy
            if order == 0:
                nr_pages_free = nr_pages_free + 1
            return higher

    # Path 3: grow the pool with a fresh carve from memblock.
    return _pa_grow_from_memblock(order)


def _pa_donate_raw(base: uint64, len_bytes: uint64):
    # Hand a page-aligned, page-multiple RANGE of previously-unmanaged RAM
    # to the buddy free lists WITHOUT requiring the range itself to be
    # power-of-two sized or naturally aligned.
    #
    # WHY THIS IS BUDDY-SAFE. The buddy invariant is per-BLOCK, not per-
    # range: a run on free_pages_order[k] must be (PAGE_SIZE << k)-aligned,
    # because _free_pages_raw locates a block's sibling with the absolute-
    # address XOR `addr ^ (PAGE_SIZE << k)`. So we decompose the range into
    # MAXIMAL naturally-aligned power-of-two blocks — for each step, the
    # largest order k with (PAGE_SIZE << k) <= remaining AND base aligned to
    # (PAGE_SIZE << k). Every block we push therefore satisfies the
    # alignment invariant exactly, and the XOR/merge arithmetic stays valid.
    # This is the same decomposition Linux's __free_pages_memory() uses to
    # hand memblock's leftovers to the buddy allocator.
    #
    # Blocks are PUSHED directly rather than routed through _free_pages_raw:
    # these pages are NEW to the allocator (they were never handed out), so
    # they must count towards nr_pages_total but must NOT inflate
    # nr_pages_freed_total. Merging with an existing free neighbour is
    # skipped for the same reason it is safe to skip — a later free of an
    # adjacent block will still coalesce normally.
    #
    # Caller must hold _pa_buddy_lock and run under the boot-CR3 window
    # (the _pa_set_next writes are raw-physical).
    if base == 0 or len_bytes == 0:
        return
    cur: uint64 = base
    left: uint64 = len_bytes
    while left >= PAGE_SIZE:
        # Largest order whose block both FITS in what is left and is
        # naturally aligned at `cur`. Order 0 always qualifies.
        k: int32 = MAX_ORDER
        while k > 0:
            blk: uint64 = PAGE_SIZE << cast[uint64](k)
            if blk <= left and (cur & (blk - 1)) == 0:
                break
            k = k - 1
        run: uint64 = PAGE_SIZE << cast[uint64](k)
        ko: uint64 = cast[uint64](k)
        _pa_own_mark(cur, cast[uint64](1) << ko)
        _pa_set_next(cur, free_pages_order[ko])
        free_pages_order[ko] = cur
        if k == 0:
            nr_pages_free = nr_pages_free + 1
        nr_pages_total = nr_pages_total + (cast[uint64](1) << ko)
        cur = cur + run
        left = left - run


def _pa_grow_from_memblock(order: int32) -> uint64:
    # Grow the buddy pool by carving fresh RAM out of memblock and return a
    # correctly-aligned run of `order` pages, or 0 if memblock is genuinely
    # exhausted.
    #
    # THE BUG THIS FIXES. The old code was a single
    # `memblock_alloc(size, size)` — alignment EQUAL TO the run width. That
    # is the strictest possible request, and it has two costs against a
    # ONE-WAY bump allocator whose cursor is de-aligned by every interleaved
    # region_alloc (the ELF-image carves, which align to 4 KiB):
    #   1. WASTE: each order-10 carve silently STRANDED up to 4 MiB - 4 KiB
    #      of alignment padding. memblock has no free path, so that padding
    #      was gone forever — memory that MemFree kept counting (it reads
    #      memblock_avail) but the page allocator could never obtain.
    #   2. PREMATURE FAILURE: a region whose remaining tail is big enough in
    #      BYTES but has no size-aligned run left returns 0, so the pool
    #      stopped growing while memblock still reported hundreds of MiB
    #      free — and every subsequent exec died of "OOM" against a machine
    #      that was not out of memory.
    #
    # THE FIX. Try the naturally-aligned carve first (it is free of slack
    # when the cursor is already aligned, which is the steady-state case).
    # If that fails, OVER-CARVE at mere PAGE alignment: ask for
    # `2*size - PAGE_SIZE` bytes, which provably contains a size-aligned
    # sub-run, take that sub-run as the caller's block, and DONATE the
    # leading and trailing slack to the buddy pool via _pa_donate_raw's
    # naturally-aligned decomposition. Nothing is stranded and the buddy
    # invariant is preserved per block (see _pa_donate_raw). The pool now
    # keeps growing until memblock is genuinely, byte-for-byte empty.
    #
    # Caller (via _alloc_pages_raw) holds _pa_buddy_lock under the boot-CR3
    # window; memblock_alloc self-locks and is a leaf.
    if order < 0 or order > MAX_ORDER:
        return 0
    o: uint64 = cast[uint64](order)
    size: uint64 = PAGE_SIZE << o
    page: uint64 = memblock_alloc(size, size)
    if page != 0:
        nr_pages_total = nr_pages_total + (cast[uint64](1) << o)
        _pa_own_mark(page, cast[uint64](1) << o)
        return page
    if order == 0:
        # An order-0 request is already page-aligned == page-sized; there is
        # no looser request to fall back to. memblock really is empty.
        return 0
    want: uint64 = size + size - PAGE_SIZE
    raw: uint64 = memblock_alloc(want, PAGE_SIZE)
    if raw == 0:
        return 0
    aligned: uint64 = (raw + size - 1) & ~(size - 1)
    head: uint64 = aligned - raw
    tail: uint64 = (raw + want) - (aligned + size)
    # The caller's run: count it as newly managed here; alloc_pages()'s
    # public wrapper adds it to nr_pages_live on the way out.
    nr_pages_total = nr_pages_total + (cast[uint64](1) << o)
    _pa_own_mark(aligned, cast[uint64](1) << o)
    # The slack becomes free pool (donate bumps nr_pages_total itself).
    _pa_donate_raw(raw, head)
    _pa_donate_raw(aligned + size, tail)
    return aligned


def _try_remove_buddy(target: uint64, order: int32) -> int32:
    # Scan the order-N free list for `target` (which is meant to be
    # this freeing block's buddy). If found, unlink and return 1.
    # O(list length) — fine while lists stay short; replace with a
    # struct-page-style buddy bit when fragmentation pressure grows.
    o: uint64 = cast[uint64](order)
    head: uint64 = free_pages_order[o]
    if head == 0:
        return 0
    # Integrity guard: never walk from a wild head (QA-N37).
    if _pa_link_ok(head) == 0:
        printk2("[pa-corrupt] order-%d buddy-scan head wild: %p — dropping list\n",
                o, head)
        free_pages_order[o] = 0
        return 0
    if head == target:
        free_pages_order[o] = _pa_get_next(head, order)
        return 1
    prev: uint64 = head
    cur:  uint64 = _pa_get_next(head, order)
    while cur != 0:
        if cur == target:
            # Unlink: prev.next = cur.next (validated read + canaried write).
            _pa_set_next(prev, _pa_get_next(cur, order))
            return 1
        prev = cur
        cur  = _pa_get_next(cur, order)
    return 0


def free_pages(addr: uint64, order: int32):
    # Return a run to the allocator. Boot-CR3 guard: see header above —
    # the buddy-merge walk and the free-list push in _free_pages_raw
    # must resolve through a CR3 that identity-maps all of RAM.
    _fp_live: uint64 = read_cr3()
    _fp_irq: uint64 = local_irq_save()
    _fp_boot: uint64 = cow_boot_cr3()
    _fp_sw: int32 = 0
    if _fp_boot != 0 and (_fp_boot & _PA_CR3_MASK) != (_fp_live & _PA_CR3_MASK):
        load_cr3(_fp_boot)
        _fp_sw = 1
    # SMP mutual exclusion over the shared free lists (see _pa_buddy_lock).
    spinlock_lock(&_pa_buddy_lock)
    # Allocation tracking: un-tag BEFORE the raw free, while the run's
    # frames are still ours to read (the merge below can fold them into a
    # higher-order block whose base is not `addr`).
    if _pa_trk_mode != 0:
        if addr != 0 and order >= 0 and order <= MAX_ORDER:
            _pa_trk_unstamp(addr, cast[uint64](1) << cast[uint64](order))
    _free_pages_raw(addr, order)
    # Mirror of the alloc-side live accounting: a valid free returns
    # 2^order pages to the buddy pool, growing (nr_pages_total -
    # nr_pages_live) and therefore MemFree. Guard against underflow and
    # against the raw body's early bail on a null/out-of-range run (which
    # frees nothing). Corruption bail-outs (wild/double-free) are rare
    # error paths; a slight miscount there is acceptable.
    if addr != 0 and order >= 0 and order <= MAX_ORDER:
        _fp_run: uint64 = cast[uint64](1) << cast[uint64](order)
        if nr_pages_live >= _fp_run:
            nr_pages_live = nr_pages_live - _fp_run
        else:
            nr_pages_live = 0
    spinlock_unlock(&_pa_buddy_lock)
    if _fp_sw != 0:
        load_cr3(_fp_live)
    local_irq_restore(_fp_irq)


def _free_pages_raw(addr: uint64, order: int32):
    # Body of free_pages; must run under an identity-mapping CR3 (the
    # public wrapper guarantees it). If the freed run's buddy at the
    # same order is already free, MERGE them into a single order-(N+1)
    # block and recurse; this is the canonical buddy algorithm (mirrors
    # __free_one_page in mm/page_alloc.c). Stops at MAX_ORDER.
    if addr == 0:
        return
    if order < 0 or order > MAX_ORDER:
        return

    # Accounting: track cumulative pages freed. The difference
    # (nr_pages_total - nr_pages_freed_total) gives the pages currently
    # in active use — a useful leak probe after spawn/reap cycles.
    freed_pages: uint64 = cast[uint64](1) << cast[uint64](order)
    nr_pages_freed_total = nr_pages_freed_total + freed_pages

    # #mm-parity: clear each freed frame's struct-page descriptor so no
    # stale LRU link, rmap entry, or dirty/anon flag survives into the next
    # allocation of the same PFN.  A frame that was an LRU member but is
    # freed by a path OTHER than the reclaimer (task exit, COW break, munmap)
    # would otherwise leave a dangling node on the inactive list.
    rp_base_pfn: uint64 = page_pfn(addr)
    rp_i: uint64 = 0
    while rp_i < freed_pages:
        rp_pfn: uint64 = rp_base_pfn + rp_i
        # If the frame is still on an LRU list, UNLINK it properly (fixing
        # the neighbours' links + the head/tail anchors) before zeroing the
        # descriptor — a bare reset would leave dangling neighbour links.
        if page_test_flag(rp_pfn, PG_LRU) != 0:
            lru_remove(page_phys(rp_pfn))
        page_reset(rp_pfn)
        rp_i = rp_i + 1

    cur_addr:  uint64 = addr
    cur_order: int32  = order
    while cur_order < MAX_ORDER:
        run_size: uint64 = PAGE_SIZE << cast[uint64](cur_order)
        buddy:    uint64 = cur_addr ^ run_size
        if _try_remove_buddy(buddy, cur_order) == 0:
            break
        # Merged. Canonical "parent" block is the lower of the two,
        # which is `addr & ~(run_size << 1)` aligned. cur_addr ^ run_size
        # gives buddy; AND with ~run_size canonicalises.
        if buddy < cur_addr:
            cur_addr = buddy
        # If order == 0 we just consumed a free order-0 entry too,
        # adjust the free-count accordingly.
        if cur_order == 0:
            nr_pages_free = nr_pages_free - 1
        cur_order = cur_order + 1

    # Push the (possibly merged) block onto its order's free list.
    o: uint64 = cast[uint64](cur_order)
    # Integrity guards (QA-N37) at the free SOURCE:
    #   * a wild base address means a caller freed a bogus pointer — never
    #     splice it onto a list (it would become the next wild head).
    #   * cur_addr already at the head is an unambiguous double-free — the
    #     canary would catch it later, but rejecting it here keeps the list
    #     acyclic and names the event at the moment it happens.
    if _pa_link_ok(cur_addr) == 0:
        printk2("[pa-corrupt] free of wild addr %p order=%d — ignoring\n",
                cur_addr, cast[uint64](cur_order))
        return
    if cur_addr == free_pages_order[o]:
        printk2("[pa-corrupt] double-free of %p at order=%d — ignoring\n",
                cur_addr, cast[uint64](cur_order))
        return
    _pa_set_next(cur_addr, free_pages_order[o])
    free_pages_order[o] = cur_addr
    if cur_order == 0:
        nr_pages_free = nr_pages_free + 1


def count_free_at_order(order: int32) -> uint64:
    # Walk one order's free list and count entries. Used by the
    # M16.23 smoke test to demonstrate buddy merging. Not on a hot
    # path so the O(N) walk is fine. Boot-CR3 guard: the link walk
    # reads through raw physical pointers.
    if order < 0 or order > MAX_ORDER:
        return 0
    _cf_live: uint64 = read_cr3()
    _cf_irq: uint64 = local_irq_save()
    _cf_boot: uint64 = cow_boot_cr3()
    _cf_sw: int32 = 0
    if _cf_boot != 0 and (_cf_boot & _PA_CR3_MASK) != (_cf_live & _PA_CR3_MASK):
        load_cr3(_cf_boot)
        _cf_sw = 1
    n: uint64 = 0
    p: uint64 = free_pages_order[cast[uint64](order)]
    while p != 0:
        if _pa_link_ok(p) == 0:
            break
        n = n + 1
        p = _pa_get_next(p, order)
    if _cf_sw != 0:
        load_cr3(_cf_live)
    local_irq_restore(_cf_irq)
    return n


# --- order-0 convenience aliases (backwards-compat with M16.8) -----

def alloc_page() -> uint64:
    return alloc_pages(0)


def free_page(page: uint64):
    free_pages(page, 0)


# --- large freeable region allocator (ELF images) ------------------
#
# The ELF loader (fs/elf.ad) needs one contiguous physical region per
# loaded binary, sized to the binary's whole PT_LOAD span (memsz —
# code + data + BSS). For a big native binary like hpm that span is
# ~14.7 MiB, well above the buddy allocator's MAX_ORDER (4 MiB), so it
# historically came straight from memblock_alloc() — which is a ONE-WAY
# bump allocator with no free path. Every spawn therefore permanently
# leaked its whole image region; after ~6 `hpm` spawns the ~238 MiB
# memblock pool was exhausted and the next sys_spawn's region alloc
# returned 0 -> ENOEXEC -> hamsh reported "command not found".
#
# This allocator gives those regions a reclaim path WITHOUT a full
# buddy/slab rewrite. Backing memory still comes from memblock on a
# cold miss, but a region_free() returns the chunk to a general free
# list that the next region_alloc() reuses.
#
# WHY A GENERAL (ANY-SIZE) FREE LIST, NOT EXACT-SIZE BUCKETS (#106 leak):
# the original pool kept one free-list bucket PER EXACT byte size. That
# only recycles when the SAME binary is respawned at the IDENTICAL span.
# But the desktop launches ~28 DISTINCT native apps whose image spans
# differ by a few KiB each (16.78 MiB, 16.79 MiB, 16.92 MiB, 16.97 MiB,
# 17.90 MiB, 19.03 MiB ...). A freed 16.79 MiB chunk sat in its own
# exact-size bucket and could NOT satisfy the next 16.97 MiB request, so
# region_alloc cold-missed into memblock every time — the ONE-WAY bump
# cursor climbed monotonically (measured: 568 MiB drained across the DE
# storm, 21 of 27 allocs cold-missing) until memblock_alloc returned 0 →
# `elf: OOM` → boot wedge. The exact-size pool also STRANDED every pooled
# chunk in a bucket no differently-sized request could ever touch.
#
# The fix: a single ADDRESS-SORTED free list. region_alloc does first-fit
# (the first chunk large enough) and SPLITS the remainder back onto the
# list; region_free COALESCES with address-adjacent free neighbours so
# split fragments re-merge into whole regions. Now ANY freed region backs
# ANY later request ≤ its size, so a spawn→exit→reap cycle is NET-NEUTRAL
# on memblock headroom (the reaped image chunk is handed straight to the
# next spawn regardless of the exact span) and the pool stays flat.
#
# Each free chunk is self-describing: its first 16 bytes (dead memory
# until reused) hold [0]=next-chunk phys (0 = end), [8]=chunk byte size.
# All chunks are page-aligned and page-multiple-sized (memblock aligns
# 4096; rsize is page-rounded; splits preserve both), so the header
# always fits and neighbour tests are exact.

_region_free_head: uint64 = 0     # lowest-addr free chunk (0 = empty)

# --- region-pool accounting (leak attribution) -----------------------
#
# The region allocator is the THIRD memory supply in the kernel (after
# memblock's bump cursor and the buddy allocator), and it was the only one
# with no counters at all — so a region that was carved from memblock and
# then never returned to the pool was invisible to /proc/meminfo. MemFree
# reads (memblock_avail + buddy_free); a pooled region chunk is free RAM
# that appears in NEITHER term, so every cold-miss carve looked like a
# permanent loss even when the chunk was recycled forever after, and a
# genuinely leaked region looked exactly the same. These three counters
# separate the two cases:
#
#   _region_pool_bytes    bytes sitting on the region free list RIGHT NOW
#                         (reusable => must be added to MemFree)
#   _region_carved_bytes  cumulative bytes taken from memblock on a cold
#                         miss (monotonic; the memblock headroom the
#                         region layer owns)
#   _region_leaked_bytes  cumulative bytes region_free_cow_safe REFUSED to
#                         pool because a frame was still COW-tracked. This
#                         is the true unbounded leak: carved but never
#                         poolable, so it belongs to nobody.
#
# Invariant when nothing leaks: _region_carved_bytes stops growing once
# the pool is warm, and _region_leaked_bytes stays at 0.
_region_pool_bytes:   uint64 = 0
_region_carved_bytes: uint64 = 0
_region_leaked_bytes: uint64 = 0

# --- region QUARANTINE (the desktop's last RAM leak) -----------------
#
# THE BUG. region_free_cow_safe used to permanently ABANDON any image /
# interp region that had EVER been COW-shared into a fork child ("a
# bounded address leak, never a use-after-free"). It is not bounded. Every
# app that fork()s even once — hamtermscene spawning its child shell, any
# app that shells out — loses its ENTIRE ~17 MiB image span for the rest
# of the boot, because the owner is the only task that can pool the region
# and by the time it exits a relative has already touched the refcounts.
# Over a 30-minute desktop soak (244 launches) that drained ~350 MiB of
# memblock headroom: the LEAK verdict on MemFree, at −4.8 MB/cycle.
#
# WHY THE OWNER CANNOT SIMPLY POOL IT. The frames may still be COW-mapped
# by a live forked relative. Pooling them hands live .text to the next
# region_alloc — the code=139 / cleared-PTE aliasing crash (dfd59371) that
# motivated the abandon-everything rule in the first place. And the
# relative CANNOT pool it either: fork children carry image_phys == 0 by
# design (owner-only reclaim), so nobody is left holding the bag.
#
# THE FIX: don't decide at owner-exit — DEFER. A region whose frames are
# still COW-tracked goes onto a small fixed-size quarantine list (external
# storage: we must NOT write an intrusive free-list header into frames a
# live relative still maps). Every later region_alloc / region_free_cow_safe
# sweeps the list and pools any entry whose frames have ALL dropped to
# refcount 0 — i.e. the last relative has exited and released them. The
# region is therefore reclaimed by the LAST holder instead of being lost by
# the first, and it is never pooled while a holder is alive (a strictly
# LATER, safer instant than the still_live>0 check that crashed).
#
# The list is fixed-size and needs no allocator of its own. If it ever
# fills, the overflow region is abandoned exactly as before and counted in
# _region_leaked_bytes — the old behaviour survives as the bounded
# worst case, and the counter makes it visible instead of silent.
_RGN_Q_MAX: uint64 = 64
_rgn_q_addr: Array[64, uint64]
_rgn_q_size: Array[64, uint64]
_pa_quar_lock: uint32 = 0
# Bytes sitting in quarantine right now (NOT free, NOT leaked — pending a
# relative's exit). A soak in which this oscillates and RegionRecovered
# climbs is healthy; one in which it climbs monotonically means some COW
# reference is never dropped.
_region_quar_bytes:      uint64 = 0
# Cumulative bytes released from quarantine back into the pool.
_region_recovered_bytes: uint64 = 0


def _region_link_get(chunk: uint64) -> uint64:
    return cast[Ptr[uint64]](chunk)[0]


def _region_link_set(chunk: uint64, nxt: uint64):
    cast[Ptr[uint64]](chunk)[0] = nxt


def _region_size_get(chunk: uint64) -> uint64:
    return cast[Ptr[uint64]](chunk + 8)[0]


def _region_size_set(chunk: uint64, sz: uint64):
    cast[Ptr[uint64]](chunk + 8)[0] = sz


def _region_frames_all_free(addr: uint64, rsize: uint64) -> int32:
    # 1 iff EVERY 4 KiB frame in [addr, addr+rsize) has COW refcount 0 —
    # i.e. no task anywhere still holds a COW reference to this span. Bails
    # on the first tracked frame, so the common answer costs one read.
    # cow_refcount is a plain table load (no lock), so this is cheap enough
    # to run on the region_alloc path.
    off: uint64 = 0
    while off < rsize:
        if cow_refcount(addr + off) > 0:
            return 0
        off = off + 4096
    return 1


def _region_quarantine_push(addr: uint64, rsize: uint64) -> int32:
    # Park a still-COW-referenced region until its last holder exits.
    # Returns 1 if parked, 0 if the list is full (caller abandons it, the
    # pre-fix behaviour, and counts it as a true leak).
    _q_irq: uint64 = local_irq_save()
    spinlock_lock(&_pa_quar_lock)
    slot: uint64 = _RGN_Q_MAX
    i: uint64 = 0
    while i < _RGN_Q_MAX and slot == _RGN_Q_MAX:
        if _rgn_q_addr[i] == 0:
            slot = i
        i = i + 1
    if slot != _RGN_Q_MAX:
        _rgn_q_addr[slot] = addr
        _rgn_q_size[slot] = rsize
        _region_quar_bytes = _region_quar_bytes + rsize
    spinlock_unlock(&_pa_quar_lock)
    local_irq_restore(_q_irq)
    if slot == _RGN_Q_MAX:
        return 0
    return 1


def region_quarantine_sweep():
    # Release every quarantined region whose frames have ALL dropped to
    # refcount 0 (the last forked relative has exited and released them)
    # back into the reuse pool. Safe to call from anywhere that does NOT
    # already hold _pa_region_lock — region_free re-takes it.
    #
    # The slot is CLAIMED under _pa_quar_lock (re-checking that the entry
    # is still the one we tested) before region_free is called outside the
    # lock, so two CPUs sweeping concurrently can never double-free.
    i: uint64 = 0
    while i < _RGN_Q_MAX:
        _s_irq: uint64 = local_irq_save()
        spinlock_lock(&_pa_quar_lock)
        a: uint64 = _rgn_q_addr[i]
        s: uint64 = _rgn_q_size[i]
        spinlock_unlock(&_pa_quar_lock)
        local_irq_restore(_s_irq)
        if a != 0 and _region_frames_all_free(a, s) != 0:
            _c_irq: uint64 = local_irq_save()
            spinlock_lock(&_pa_quar_lock)
            claimed: int32 = 0
            if _rgn_q_addr[i] == a and _rgn_q_size[i] == s:
                _rgn_q_addr[i] = 0
                _rgn_q_size[i] = 0
                claimed = 1
                if _region_quar_bytes >= s:
                    _region_quar_bytes = _region_quar_bytes - s
                else:
                    _region_quar_bytes = 0
            spinlock_unlock(&_pa_quar_lock)
            local_irq_restore(_c_irq)
            if claimed != 0:
                _region_recovered_bytes = _region_recovered_bytes + s
                region_free(a, s)
        i = i + 1


def region_alloc(size: uint64) -> uint64:
    # Allocate a page-aligned contiguous region of `size` bytes that can
    # later be returned via region_free(addr, size). Reuses a pooled
    # chunk (first-fit, splitting the remainder back onto the free list)
    # if one is big enough; otherwise carves a fresh chunk from memblock.
    # Returns 0 on OOM.
    if size == 0:
        return 0
    # Reclaim first, carve second: a region quarantined at some earlier
    # task's exit may have become poolable since (its last COW holder has
    # died). Sweeping BEFORE the first-fit walk is what turns the pool
    # net-neutral across a spawn/exit cycle instead of cold-missing into
    # memblock for every fork-shared image. Must run OUTSIDE the region
    # lock — region_free re-takes it.
    region_quarantine_sweep()
    rsize: uint64 = (size + 4095) & ~cast[uint64](4095)
    # The free list + intrusive header are shared RMW state. Run the WHOLE
    # critical section (list walk, split, cold-miss carve) under IRQ-off +
    # boot-CR3 (for the raw-physical header deref) + the SMP region lock so
    # no two CPUs ever hand out the same chunk or race the splice.
    _ra_live: uint64 = read_cr3()
    _ra_irq: uint64 = local_irq_save()
    _ra_boot: uint64 = cow_boot_cr3()
    _ra_sw: int32 = 0
    if _ra_boot != 0 and (_ra_boot & _PA_CR3_MASK) != (_ra_live & _PA_CR3_MASK):
        load_cr3(_ra_boot)
        _ra_sw = 1
    spinlock_lock(&_pa_region_lock)
    ret: uint64 = 0
    got: int32 = 0
    # First-fit: the first free chunk whose size >= rsize.
    prev: uint64 = 0
    cur:  uint64 = _region_free_head
    while cur != 0 and got == 0:
        csz: uint64 = _region_size_get(cur)
        if csz >= rsize:
            nxt: uint64 = _region_link_get(cur)
            rem: uint64 = csz - rsize
            if rem != 0:
                # Split: hand back the low rsize bytes, re-insert the
                # remainder [cur+rsize, rem) in cur's sorted slot.
                remc: uint64 = cur + rsize
                _region_size_set(remc, rem)
                _region_link_set(remc, nxt)
                if prev == 0:
                    _region_free_head = remc
                else:
                    _region_link_set(prev, remc)
            else:
                # Exact fit: unlink cur entirely.
                if prev == 0:
                    _region_free_head = nxt
                else:
                    _region_link_set(prev, nxt)
            ret = cur
            got = 1
            if _region_pool_bytes >= rsize:
                _region_pool_bytes = _region_pool_bytes - rsize
            else:
                _region_pool_bytes = 0
        else:
            prev = cur
            cur = _region_link_get(cur)
    if got == 0:
        # Cold miss: carve fresh from memblock (one-way bump; self-locks).
        ret = memblock_alloc(rsize, 4096)
        if ret != 0:
            _region_carved_bytes = _region_carved_bytes + rsize
    if ret != 0:
        _pa_trk_stamp_region(ret, rsize >> 12)
    spinlock_unlock(&_pa_region_lock)
    if _ra_sw != 0:
        load_cr3(_ra_live)
    local_irq_restore(_ra_irq)
    return ret


def region_can_alloc(size: uint64) -> int32:
    # NON-MUTATING pre-check: returns 1 if region_alloc(size) would succeed
    # right now, else 0. Mirrors region_alloc's two supply sources EXACTLY:
    # a pooled free-list chunk whose size >= rsize, OR a cold-miss carve from
    # memblock (one contiguous 4 KiB-aligned run >= rsize). Because memblock
    # is a per-region bump allocator, a request only fits if ONE region holds
    # it — memblock_can_alloc encodes that (NOT the summed headroom).
    #
    # #112 execve atomicity: do_execve calls this BEFORE it tears the outgoing
    # COW image down, so an image whose contiguous region_alloc would OOM past
    # the point-of-no-return is rejected with -ENOMEM while the caller's
    # address space is still fully intact (Linux execve-failure semantics),
    # instead of the fork-child resuming into now-unmapped inherited code.
    if size == 0:
        return 0
    rsize: uint64 = (size + 4095) & ~cast[uint64](4095)
    _rc_live: uint64 = read_cr3()
    _rc_irq: uint64 = local_irq_save()
    _rc_boot: uint64 = cow_boot_cr3()
    _rc_sw: int32 = 0
    if _rc_boot != 0 and (_rc_boot & _PA_CR3_MASK) != (_rc_live & _PA_CR3_MASK):
        load_cr3(_rc_boot)
        _rc_sw = 1
    spinlock_lock(&_pa_region_lock)
    ok: int32 = 0
    cur: uint64 = _region_free_head
    while cur != 0 and ok == 0:
        if _region_size_get(cur) >= rsize:
            ok = 1
        cur = _region_link_get(cur)
    spinlock_unlock(&_pa_region_lock)
    if _rc_sw != 0:
        load_cr3(_rc_live)
    local_irq_restore(_rc_irq)
    if ok == 0:
        # No pooled chunk fits; would region_alloc cold-miss into memblock?
        if memblock_can_alloc(rsize, 4096) != 0:
            ok = 1
    return ok


def region_free(addr: uint64, size: uint64):
    # Return a region to the general free list for reuse by ANY later
    # region_alloc <= its size. Inserts address-sorted and coalesces with
    # the immediate physical neighbours so split fragments re-merge.
    if addr == 0 or size == 0:
        return
    rsize: uint64 = (size + 4095) & ~cast[uint64](4095)
    _region_pool_bytes = _region_pool_bytes + rsize
    # Raw physical header writes: boot-CR3 guard; the sorted-insert +
    # coalesce runs under the SMP region lock so a concurrent region_alloc
    # can't observe a torn list.
    _rf_live: uint64 = read_cr3()
    _rf_irq: uint64 = local_irq_save()
    _rf_boot: uint64 = cow_boot_cr3()
    _rf_sw: int32 = 0
    if _rf_boot != 0 and (_rf_boot & _PA_CR3_MASK) != (_rf_live & _PA_CR3_MASK):
        load_cr3(_rf_boot)
        _rf_sw = 1
    spinlock_lock(&_pa_region_lock)
    # Untally BEFORE the coalesce, and under the same lock + boot CR3 the
    # stamp side runs under. The coalesce below MUTATES `addr` and `rsize`
    # to describe the MERGED chunk, whose neighbours were already untallied
    # when they were freed; untallying after it would credit this free with
    # frames it does not own and clamp the site's live count to zero — the
    # kind of instrument bug that prints a green over a leak.
    _pa_trk_unstamp(addr, rsize >> 12)
    # Locate the sorted insertion point: prev = highest chunk below addr.
    prev: uint64 = 0
    cur:  uint64 = _region_free_head
    while cur != 0 and cur < addr:
        prev = cur
        cur = _region_link_get(cur)
    # Coalesce backward: prev immediately precedes addr -> extend prev.
    merged_back: int32 = 0
    if prev != 0 and prev + _region_size_get(prev) == addr:
        _region_size_set(prev, _region_size_get(prev) + rsize)
        addr = prev
        rsize = _region_size_get(prev)
        merged_back = 1
    # Coalesce forward: cur immediately follows addr -> absorb cur.
    if cur != 0 and addr + rsize == cur:
        cur_next: uint64 = _region_link_get(cur)
        rsize = rsize + _region_size_get(cur)
        _region_size_set(addr, rsize)
        if merged_back != 0:
            # addr == prev, already linked; just skip past cur.
            _region_link_set(prev, cur_next)
        else:
            # addr takes cur's slot in the sorted list.
            _region_link_set(addr, cur_next)
            if prev == 0:
                _region_free_head = addr
            else:
                _region_link_set(prev, addr)
    elif merged_back == 0:
        # No coalesce: insert addr between prev and cur.
        _region_size_set(addr, rsize)
        _region_link_set(addr, cur)
        if prev == 0:
            _region_free_head = addr
        else:
            _region_link_set(prev, addr)
    spinlock_unlock(&_pa_region_lock)
    if _rf_sw != 0:
        load_cr3(_rf_live)
    local_irq_restore(_rf_irq)


def region_free_cow_safe(addr: uint64, size: uint64):
    # COW-SAFE region reclaim (fork+exec refcount-poison fix). The ELF
    # image and PT_INTERP (ld.so) images are REGIONS, not VMAs, and were
    # historically returned to the region pool via a raw region_free() at
    # task_reap — a free path that NEVER consulted the per-PFN COW refcount
    # table. But do_clone COW-shares the whole image + interp span into
    # every fork child (vm_cow_share_all / vm_cow_share_range bump each
    # present frame 0->2), and a child's execve teardown only drops its OWN
    # reference (2->1), so the OWNER's image/interp frames sit at refcount
    # >= 1 for the rest of its life. The old raw region_free then pooled
    # those frames with a STALE non-zero refcount: the next region_alloc
    # handed the poisoned chunk to a fresh image/interp load, and the first
    # time one of its frames was COW-shared, cow_share_page saw cur != 0 and
    # bumped N->N+1 instead of 0->2 — so a later cow_drop's arithmetic was
    # off-by-the-stale-count and a frame was freed while still COW-mapped
    # elsewhere (or a live relative's frame was reused). That is the
    # fork+exec corruption that scribbles a forked shell's stack canary /
    # exit-handler list (dash SIGABRT / "stack smashing detected" on
    # `dash -c /bin/true`). This is the exact class the brk (vma_free_
    # reserved_range) and user-stack (43684804) reclaims already close;
    # the image/interp region_free was the last raw-free hole.
    #
    # Drop THIS owner's COW reference on every frame BEFORE pooling:
    #   * untracked frame (refcount 0, never forked) -> cow_drop is a no-op
    #     (stays 0); the region pools exactly as before — the common case.
    #   * owner-only frame (refcount 1, child already exec'd/reaped) ->
    #     cow_drop 1->0 clears the stale count so the pooled frame is clean.
    #   * frame a LIVE relative still COW-maps (refcount >= 2) -> cow_drop
    #     2->1 keeps it for that relative; the region is NOT safe to pool
    #     (its frames are in use), so we drop the pooling and let the last
    #     relative free the frames through its own COW teardown. A rare,
    #     bounded region-address leak — never a use-after-free.
    # SAFE-FALLBACK (dfd59371 live-task use-after-free): NEVER return a
    # region to the reuse pool if ANY of its frames was EVER COW-shared
    # (refcount > 0). Correctness over a bounded address leak.
    #
    # WHY the earlier still_live>0-only guard was not enough: an identity-
    # mapped NATIVE image lives in LOW RAM the buddy allocator also
    # manages, and under app-spawn load a live relative's image frame is
    # momentarily untracked (refcount 0) or owner-only (refcount 1) at the
    # instant a sibling tears down — so pooling a region whose frames were
    # ever shared could hand a frame a LIVE relative still maps back to
    # region_alloc, aliasing two tasks onto the same physical .text and
    # dropping the live task's mapping (code=139, US=0 / cleared PTE). By
    # refusing to pool ANY once-shared region we make that reuse impossible.
    #
    # Drop THIS owner's per-PFN COW reference on every tracked frame first
    # (so a fork relative's reclaim is not stranded at a stale count / the
    # parent's frame is never left over-counted), then:
    #   * region had NO tracked frame (never forked) -> pool it as before
    #     (the overwhelmingly common case: a task that never fork+exec'd a
    #     child leaks nothing).
    #   * region had ANY tracked frame -> LEAK the region address (do not
    #     pool). The frames are still reclaimed as raw RAM at reboot; the
    #     only cost is that this exact region span is not reused. Never a
    #     use-after-free.
    if addr == 0 or size == 0:
        return
    rsize: uint64 = (size + 4095) & ~cast[uint64](4095)
    any_cow: int32 = 0
    off: uint64 = 0
    while off < rsize:
        frame: uint64 = addr + off
        if cow_refcount(frame) > 0:
            any_cow = 1
            cow_set_arm(COW_ARM_DROP_REGION)
            cow_drop_page(frame)
        off = off + 4096
    if any_cow == 0:
        # No frame was ever COW-shared: the region is genuinely private and
        # free — pool it for reuse.
        region_free(addr, rsize)
    elif _region_frames_all_free(addr, rsize) != 0:
        # It WAS shared, but this owner's drop above took the last
        # reference: every frame is now at refcount 0, so no live relative
        # maps the span and it is safe to pool immediately.
        region_free(addr, rsize)
    elif _region_quarantine_push(addr, rsize) == 0:
        # Quarantine full — abandon it (the pre-fix behaviour) and SAY SO.
        _region_leaked_bytes = _region_leaked_bytes + rsize
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk1("[region] quarantine full — abandoning %d bytes\n", rsize)
    # Otherwise the span is quarantined: some relative still COW-maps it.
    # A later region_alloc / region_free_cow_safe sweep pools it once the
    # last holder exits. Drain what we can now, cheaply.
    region_quarantine_sweep()


# Frames whose COW reference this reclaim dropped, and runs it declined to
# free because a live relative still mapped one. Both are pure counters; a
# `track`-gated printk below is the only output, so /proc/meminfo is untouched.
_ustack_cow_drained: uint64 = 0
_ustack_runs_held:   uint64 = 0


def ustack_free_cow_safe(base: uint64, size: uint64, order: uint64):
    # COW-SAFE user-stack reclaim (leak pass 14). THE MEASURED BUG.
    #
    # vm_cow_share_all COW-shares three owner spans into every fork child:
    # the ELF image, the brk heap and the user stack. Two of the three have a
    # COW-draining owner-side reclaim — region_free_cow_safe for the image and
    # PT_INTERP, vma_free_reserved_range for brk — and each drops the owner's
    # per-PFN reference before returning the storage. The USER STACK had none:
    # task_reap and task_free_owner_regions both returned the run with a RAW
    # free_pages(ustack_phys), a path that never consults the refcount table.
    # region_free_cow_safe's own comment already asserts it "matches the
    # brk/stack COW-safe reclaim"; for the stack that was not true.
    #
    # HOW IT WAS MEASURED, not argued. The per-PFN origin tag (mm/cow.ad)
    # records the arm that took each frame's FIRST reference, so every drop
    # reports its true origin with no inference. Splitting vm_cow_share_all by
    # span, over a 12-minute desktop soak:
    #
    #   org=19  image span   born=342  died=342   <- region_free_cow_safe
    #   org=21  ustack span  born=964  died=109   <- raw free_pages
    #
    # The image span closes EXACTLY. The stack span drops 11% of what it
    # creates. Same call, same fork, same soak; the only difference is which
    # owner-side reclaim drains it. 855 of the 936 tagged live frames in that
    # run are org=21.
    #
    # WHY A STALE COUNT COSTS PAGES, not just tidiness. free_pages returns the
    # run to the buddy allocator with its refcount-table entries still
    # non-zero. The next allocation of that PFN inherits the poison, so the
    # next cow_share_page sees cur != 0 and bumps N -> N+1 instead of 0 -> 2;
    # the matching cow_drop_page then stops one short of 0 and the frame is
    # never freed by its last holder. That is exactly the population the
    # orphan census reports — refcount 1, zero mappers, owner alive — and 58
    # of 64 sampled orphans carry origin arm 2 (the general COW share) while
    # arm 1 contributes none. This is the same poison class region_free_cow_safe
    # was written for; the stack was the remaining raw-free hole.
    #
    # THE RULE, mirroring region_free_cow_safe exactly:
    #   refcount 0  -> untracked, never forked: no-op, run frees as before
    #                  (the overwhelmingly common case).
    #   refcount 1  -> owner-only, the child already exec'd or reaped:
    #                  drop 1 -> 0 clears the stale count and the run frees.
    #   refcount >1 -> a LIVE relative still COW-maps this frame: drop 2 -> 1
    #                  so that relative's own teardown is not stranded, and do
    #                  NOT free the run. Returning it would hand the buddy
    #                  allocator a frame a live task still maps — the dfd59371
    #                  use-after-free, which the raw free_pages could already
    #                  commit today. Holding the run is a bounded page leak and
    #                  never a UAF; correctness over reuse, same trade the
    #                  region path makes.
    if base == 0 or size == 0:
        return
    rsize: uint64 = (size + 4095) & ~cast[uint64](4095)
    off: uint64 = 0
    while off < rsize:
        frame: uint64 = base + off
        if cow_refcount(frame) > 0:
            cow_set_arm(COW_ARM_DROP_USTACK)
            # ignore-result
            cow_drop_page(frame)
            _ustack_cow_drained = _ustack_cow_drained + 1
        off = off + 4096
    # Second pass: anything still held means a live relative maps it.
    off = 0
    while off < rsize:
        if cow_refcount(base + off) > 0:
            _ustack_runs_held = _ustack_runs_held + 1
            if page_alloc_track_mode() != 0:
                printk_set_level(PRINTK_LEVEL_EMERG)
                printk2("[ustack] held run %p: frame %p still COW-mapped\n",
                        base, base + off)
            return
        off = off + 4096
    free_pages(base, cast[int32](order))


def ustack_cow_drained_total() -> uint64:
    return _ustack_cow_drained


def ustack_runs_held_total() -> uint64:
    return _ustack_runs_held


# --- bring-up + stats ----------------------------------------------

def page_alloc_init():
    # Globals start zeroed by BSS init; nothing functional to do.
    # Keeping the function so the call-site in arch/x86/mm/init.ad
    # reads like Linux's mem_init() flow.
    nr_pages_total        = 0
    nr_pages_free         = 0
    nr_pages_freed_total  = 0
    nr_pages_live         = 0


def page_alloc_total() -> uint64:
    return nr_pages_total


def page_alloc_free_count() -> uint64:
    return nr_pages_free


def page_alloc_freed_total() -> uint64:
    # Cumulative pages ever returned via free_pages. Used by the
    # memory-leak accounting layer: in-use = total - freed_total.
    return nr_pages_freed_total


def page_alloc_in_use() -> uint64:
    # Pages currently allocated (not yet freed) — the LIVE counter kept at
    # the alloc/free boundary. Returns to baseline after a spawn/reap cycle
    # iff nothing leaked. Replaces the old (nr_pages_total -
    # nr_pages_freed_total) form, which drifted to 0 once physical pages
    # were reused (freed_total counts every free of a reused PFN).
    return nr_pages_live


def region_pool_free_bytes() -> uint64:
    # Bytes currently pooled on the region free list — carved from memblock
    # but not handed to any task. This is REUSABLE free RAM (the next
    # region_alloc of a fitting size takes it), so MemFree must include it;
    # omitting it made every ELF-image carve look like a permanent loss.
    return _region_pool_bytes


def region_carved_bytes() -> uint64:
    # Cumulative bytes the region allocator took from memblock on a cold
    # miss. Monotonic. Flattens once the pool is warm iff nothing leaks.
    return _region_carved_bytes


def region_leaked_bytes() -> uint64:
    # Cumulative bytes ABANDONED because the quarantine list overflowed.
    # Must stay 0; non-zero means _RGN_Q_MAX is too small.
    return _region_leaked_bytes


def region_quarantine_bytes() -> uint64:
    # Bytes parked in quarantine right now — still COW-referenced by a live
    # forked relative, poolable the moment the last one exits. Oscillates
    # in a healthy system; monotonic growth means a COW ref is never
    # dropped.
    return _region_quar_bytes


def region_recovered_bytes() -> uint64:
    # Cumulative bytes returned to the pool from quarantine. This is the
    # RAM the pre-fix kernel lost forever on every fork+exec app.
    return _region_recovered_bytes


def page_alloc_buddy_free_pages() -> uint64:
    # Pages carved from memblock into the buddy allocator that are NOT
    # currently live — i.e. the reclaimable free pool sitting on the buddy
    # free lists. This is the quantity MemFree must ADD to memblock's own
    # untouched headroom (memblock_avail): freed pages return HERE, never
    # to memblock, so a MemFree that reads only memblock_avail() can never
    # move when apps close. Guard the subtraction (never underflows in
    # practice: live <= total by construction).
    if nr_pages_total >= nr_pages_live:
        return nr_pages_total - nr_pages_live
    return 0
