# drivers/audio/audio_cdev.ad
#
# Plan-9-style /dev/audio + /dev/audioctl character devices over the
# native Intel HDA driver (drivers/audio/hda.ad).
#
#   WRITE /dev/audio     <- raw PCM bytes (s16le by default). Bytes are
#                           staged into the HDA stream DMA buffer at the
#                           file offset (so a chunked writer composes);
#                           playback starts when the writer closes (a
#                           write of 0 bytes or the explicit `start` ctl
#                           verb) — but to keep the model dead simple, a
#                           non-empty write that fills the buffer also
#                           auto-starts. Control is otherwise via the
#                           companion ctl file.
#
#   READ  /dev/audio     -> a one-line status snapshot:
#                           "rate <r> channels <c> bits <b> loaded <n>\n"
#                           (snapshot-once so `cat` terminates).
#
#   WRITE /dev/audioctl  <- text control verbs, one token-led line each:
#                           "rate 44100", "channels 2", "format s16le",
#                           "bits 16", "start", "stop", "reset".
#                           This is the Plan-9 control surface — a file
#                           you echo strings to, NOT a Linux ioctl ABI.
#
# THIS IS AN ADDITIVE CONSUMER of hda.ad's public API. It introduces no
# syscalls and no sockets.

from kernel.printk.printk import printk0, printk1
from drivers.audio.hda import (
    hda_is_initialized, hda_set_rate, hda_set_channels, hda_set_bits,
    hda_write_pcm, hda_dev_write, hda_start, hda_stop, hda_reset_buffer,
    hda_pcm_capacity, hda_pcm_loaded,
    hda_stream_open, hda_stream_is_open, hda_stream_write, hda_stream_drain,
    hda_stream_space, hda_stream_position, hda_stream_set_nonblock,
    hda_capture_is_ready, hda_capture_start, hda_capture_stop,
    hda_capture_read, hda_capture_avail, hda_capture_reset,
)
from drivers.audio.mixer import (
    hda_mix_set_master_pct, hda_mix_set_stream_pct,
    hda_mix_master_pct, hda_mix_stream_pct, hda_mix_max_streams,
    hda_mix_play, hda_mix_set_mute, hda_mix_muted,
)


# --- F10-5 #460: server-boundary perm policy for the audio cdev family.
#
# Lives WITH the audio server (this file), mirroring F10-2's per-server
# perm-body relocation (devblk_perm_check in devblk.ad,
# devauth_perm_check in devauth.ad, devnet_perm_check in devnet.ad, ...).
# Before F10-5 the `#c/audio*` paths inherited devcons_perm_check (world
# r/w, no admin gate). That was correct policy but the wrong shape: the
# audit's F10-5 finding (docs/audit_arch_shortcuts_2026-06-13.md:584-587)
# is that audio rides through the generic devs body and the audio
# server-boundary surface lies. Pulling the body here makes the
# server-letter routing in fs/vfs.ad name `#c/audio*` explicitly and
# routes it to a body owned by audio's own .ad file.
#
# Policy: world-read, world-write. Audio playback and capture are
# user-level affordances — no system-global reconfiguration happens
# through `#c/audio` or `#c/audioctl` or `#c/audioin`. The ctl verbs
# (rate/channels/format/start/stop/reset) reconfigure THIS PROCESS's
# stream, not the system; the mixer per-stream volumes are per-stream.
# A future "master mute = system-wide" hostowner gate would add a
# _devaudio_is_admin_path() arm here on the `master mute` line of
# /dev/audioctl (parallel to devcons's wsys/ctl admin gate), not a
# dispatcher edit.
#
# Numeric contract matches the rest of the perm-check family
# (PERM_R=4 | PERM_W=2 | PERM_X=1, 0=grant, -1=deny). No fs.vfs imports:
# this is the server side of the boundary and fs.vfs imports US for the
# dispatcher (any back-import would cycle).
def devaudio_perm_check(name: Ptr[char], want: int32) -> int32:
    _unused: Ptr[char] = name
    _unused2: int32 = want
    return 0                                              # world r/w


# --- small text helpers (no libc) -----------------------------------

def _au_u64_to_dec(value: uint64, out: Ptr[uint8]) -> uint64:
    if value == 0:
        out[0] = 48
        return 1
    digits: Array[24, uint8]
    n: uint64 = 0
    v: uint64 = value
    while v != 0:
        digits[n] = cast[uint8](v % 10) + 48
        v = v / 10
        n = n + 1
    written: uint64 = n
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digits[n]
        i = i + 1
    return written


def _au_tok_eq(buf: Ptr[uint8], count: uint64, word: Ptr[char]) -> int32:
    # 1 iff the first whitespace/NUL/newline-delimited token of `buf`
    # equals NUL-terminated `word`.
    i: uint64 = 0
    while True:
        wc: char = word[i]
        if wc == 0:
            if i >= count:
                return 1
            bc: uint8 = buf[i]
            if bc == 0 or bc == 10 or bc == 32 or bc == 9:
                return 1
            return 0
        if i >= count:
            return 0
        if buf[i] != cast[uint8](wc):
            return 0
        i = i + 1


def _au_parse_uint_after(buf: Ptr[uint8], count: uint64,
                         start: uint64) -> uint64:
    # Skip non-digits from `start`, then parse a decimal. Returns the
    # value (0 if no digits found).
    i: uint64 = start
    # skip the verb token + whitespace until first digit
    while i < count:
        c: uint8 = buf[i]
        if c >= 48 and c <= 57:
            break
        i = i + 1
    n: uint64 = 0
    while i < count:
        c2: uint8 = buf[i]
        if c2 < 48 or c2 > 57:
            break
        n = n * 10 + cast[uint64](c2 - 48)
        i = i + 1
    return n


def _au_parse_nth_uint(buf: Ptr[uint8], count: uint64,
                       which: uint64) -> uint64:
    # Parse the `which`-th (0-based) decimal number embedded in `buf`,
    # skipping the leading verb token and any non-digit separators. For
    # "stream 1 50" -> nth 0 = 1, nth 1 = 50.
    i: uint64 = 0
    found: uint64 = 0
    val: uint64 = 0
    while i < count:
        c: uint8 = buf[i]
        if c >= 48 and c <= 57:
            # parse this whole number
            n: uint64 = 0
            while i < count:
                c2: uint8 = buf[i]
                if c2 < 48 or c2 > 57:
                    break
                n = n * 10 + cast[uint64](c2 - 48)
                i = i + 1
            if found == which:
                val = n
                return val
            found = found + 1
        else:
            i = i + 1
    return val


# --- /dev/audio -----------------------------------------------------

def devaudio_read(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # Snapshot-once status line. namec gates off>0 -> EOF.
    if count == 0:
        return 0
    if hda_is_initialized() == 0:
        return -2                                # -ENOENT: no audio dev
    # 192 bytes: the line now also carries the streaming-ring " space "/" pos "
    # fields, which can add ~30 chars on top of the loaded/cap/master/streams/
    # mute text — the old 96-byte scratch would have overflowed.
    scratch: Array[192, uint8]
    p: uint64 = 0
    tag1: Ptr[uint8] = "loaded "
    j: uint64 = 0
    while tag1[j] != 0:
        scratch[p] = tag1[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(hda_pcm_loaded(), &scratch[p])
    tag2: Ptr[uint8] = " cap "
    j = 0
    while tag2[j] != 0:
        scratch[p] = tag2[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(hda_pcm_capacity(), &scratch[p])
    # mixer levels: " master <pct> streams <m0> <m1> ..."
    tag3: Ptr[uint8] = " master "
    j = 0
    while tag3[j] != 0:
        scratch[p] = tag3[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(hda_mix_master_pct(), &scratch[p])
    tag4: Ptr[uint8] = " streams"
    j = 0
    while tag4[j] != 0:
        scratch[p] = tag4[j]
        p = p + 1
        j = j + 1
    ns: uint64 = hda_mix_max_streams()
    si: uint64 = 0
    while si < ns:
        scratch[p] = 32                          # space
        p = p + 1
        p = p + _au_u64_to_dec(hda_mix_stream_pct(cast[int32](si)),
                               &scratch[p])
        si = si + 1
    # master-mute latch: " mute <0|1>" (appended so existing parsers that
    # stop at the streams list keep working).
    tag5: Ptr[uint8] = " mute "
    j = 0
    while tag5[j] != 0:
        scratch[p] = tag5[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(cast[uint64](hda_mix_muted()), &scratch[p])
    # Streaming-ring telemetry: " space <bytes-writable> pos <bytes-played>".
    # `space` lets a non-blocking UI producer write exactly what fits without
    # stalling its event loop; `pos` is the HARDWARE play cursor (LPIB,
    # unwrapped) so a progress bar reflects what was actually heard rather
    # than a wall clock that keeps running when DMA has stopped.
    tag6: Ptr[uint8] = " space "
    j = 0
    while tag6[j] != 0:
        scratch[p] = tag6[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(hda_stream_space(), &scratch[p])
    tag7: Ptr[uint8] = " pos "
    j = 0
    while tag7[j] != 0:
        scratch[p] = tag7[j]
        p = p + 1
        j = j + 1
    p = p + _au_u64_to_dec(hda_stream_position(), &scratch[p])
    scratch[p] = 10
    p = p + 1
    if off >= p:
        return 0
    remaining: uint64 = p - off
    take: uint64 = count
    if take > remaining:
        take = remaining
    i: uint64 = 0
    while i < take:
        buf[i] = scratch[off + i]
        i = i + 1
    return cast[int64](take)


def devaudio_write(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # Stage raw PCM into the HDA DMA buffer at file offset `off`. A
    # zero-length write is the "flush/start" signal.
    if hda_is_initialized() == 0:
        return -2
    # CONTINUOUS STREAMING MODE (armed by the `stream` ctl verb): the write
    # APPENDS to the cyclic ring ahead of the hardware play cursor rather
    # than staging at a file offset, so a file of ANY length plays through a
    # fixed-size DMA buffer. A zero-length write is the end-of-stream marker
    # and drains + stops (which is what makes a clip finish instead of
    # looping its first ring-full forever).
    if hda_stream_is_open() != 0:
        if count == 0:
            hda_stream_drain()
            return 0
        return hda_stream_write(buf, count)
    if count == 0:
        # EOF flush -> start playback of whatever's staged.
        hda_start()
        return 0
    # Stage the raw PCM as-is. The DE master volume/mute is applied by the
    # codec's OUTPUT AMPLIFIER (hda_set_output_amp), not a software PCM
    # scale, so this direct path needs no per-sample scaling — the amp gain
    # governs the analog level for playtone/aplay just as for the mixer.
    #
    # hda_dev_write, NOT hda_write_pcm: the staged buffer belongs to the
    # PROCESS that filled it. A write at offset 0 starts a NEW clip (so a
    # short effect cannot inherit a previous clip's length and play its tail),
    # a second LIVE writer is summed into the clip rather than overwriting it,
    # and a writer arriving after the owner has exited takes the device over
    # instead of appending to a dead stream.
    return hda_dev_write(buf, count, off)


# --- /dev/audioctl --------------------------------------------------

def devaudioctl_write(buf: Ptr[uint8], count: uint64) -> int64:
    # Decode one text control verb. Accept-and-ignore unknown verbs so a
    # stray writer doesn't wedge.
    if hda_is_initialized() == 0:
        return -2
    if _au_tok_eq(buf, count, "rate") != 0:
        hda_set_rate(cast[uint32](_au_parse_uint_after(buf, count, 0)))
        return cast[int64](count)
    if _au_tok_eq(buf, count, "channels") != 0:
        hda_set_channels(cast[uint32](_au_parse_uint_after(buf, count, 0)))
        return cast[int64](count)
    if _au_tok_eq(buf, count, "bits") != 0:
        hda_set_bits(cast[uint32](_au_parse_uint_after(buf, count, 0)))
        return cast[int64](count)
    if _au_tok_eq(buf, count, "format") != 0:
        # "format s16le" -> 16 bits. We only honour the bit-width hint;
        # everything is little-endian PCM.
        if _au_tok_eq(&buf[7], count - 7, "s16le") != 0:
            hda_set_bits(16)
        elif _au_tok_eq(&buf[7], count - 7, "u8") != 0:
            hda_set_bits(8)
        elif _au_tok_eq(&buf[7], count - 7, "s24le") != 0:
            hda_set_bits(24)
        elif _au_tok_eq(&buf[7], count - 7, "s32le") != 0:
            hda_set_bits(32)
        return cast[int64](count)
    # --- continuous streaming ring verbs ---------------------------
    # "streamopen"  : arm the ring for the current rate/channels/bits. All
    #                 subsequent /dev/audio writes APPEND to it. (NOT named
    #                 `stream` — that token is already the mixer's per-stream
    #                 volume verb "stream <id> <pct>" handled below.)
    # "nonblock <n>": 1 = short writes instead of blocking (UI producers).
    # "drain"       : play out everything written, then stop (end of clip).
    if _au_tok_eq(buf, count, "streamopen") != 0:
        hda_stream_open()
        return cast[int64](count)
    if _au_tok_eq(buf, count, "nonblock") != 0:
        hda_stream_set_nonblock(cast[int32](_au_parse_uint_after(buf,
                                                                count, 0)))
        return cast[int64](count)
    if _au_tok_eq(buf, count, "drain") != 0:
        hda_stream_drain()
        return cast[int64](count)
    if _au_tok_eq(buf, count, "start") != 0:
        hda_start()
        return cast[int64](count)
    if _au_tok_eq(buf, count, "stop") != 0:
        hda_stop()
        return cast[int64](count)
    if _au_tok_eq(buf, count, "reset") != 0:
        hda_reset_buffer()
        return cast[int64](count)
    # --- software mixer control surface (Plan-9 ctl verbs) ----------
    # "master <pct>"     : set master volume (0..100 %).
    # "stream <id> <pct>": set per-stream volume (0..100 %).
    # "mixplay"          : render the active mixer streams + start DMA.
    if _au_tok_eq(buf, count, "master") != 0:
        hda_mix_set_master_pct(_au_parse_uint_after(buf, count, 0))
        return cast[int64](count)
    # "mute" / "unmute": latch master mute without touching the level
    # ("unmute" must be tested FIRST or "mute" would prefix-mismatch it —
    # _au_tok_eq is whole-token so the order is just belt-and-braces).
    if _au_tok_eq(buf, count, "unmute") != 0:
        hda_mix_set_mute(0)
        return cast[int64](count)
    if _au_tok_eq(buf, count, "mute") != 0:
        hda_mix_set_mute(1)
        return cast[int64](count)
    if _au_tok_eq(buf, count, "stream") != 0:
        sid: uint64 = _au_parse_nth_uint(buf, count, 0)
        pct: uint64 = _au_parse_nth_uint(buf, count, 1)
        hda_mix_set_stream_pct(cast[int32](sid), pct)
        return cast[int64](count)
    if _au_tok_eq(buf, count, "mixplay") != 0:
        hda_mix_play()
        return cast[int64](count)
    return cast[int64](count)


def devaudioctl_read(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # ctl is write-only; reads return EOF.
    return 0


# --- /dev/audioin (capture / record) --------------------------------
#
# READ  /dev/audioin -> raw recorded PCM bytes pulled from the HDA capture
#                       ring (the input-stream DMA engine fills it). This
#                       is a STREAM device, not a snapshot file: the read
#                       advances an internal ring read pointer rather than
#                       being addressed by the file offset, so successive
#                       reads return successive captured PCM. An empty ring
#                       returns 0 (non-blocking, EOF-style) so a polled
#                       reader spins without wedging.
#
# WRITE /dev/audioin -> not a sink; writes are rejected.
#
# Format/rate are shared with playback and set through /dev/audioctl
# (rate/channels/bits/format) — the capture stream uses the same format
# encoder, so configuring one configures both.

def devaudioin_read(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # Stream read: ignore `off`, serve from the capture ring's read
    # pointer. The backend advances rpos and handles wrap/overrun.
    if hda_capture_is_ready() == 0:
        return -2                                # -ENOENT: no capture dev
    if count == 0:
        return 0
    return hda_capture_read(buf, count)


def devaudioin_write(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # Capture device is read-only.
    return -1
