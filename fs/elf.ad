# fs/elf.ad
#
# Mirrors fs/binfmt_elf.c at the smallest meaningful scale: parse an
# elf32-i386 ELF blob (matches the wrapper format Hamnix's compiler
# already emits), walk its program headers, copy every PT_LOAD segment
# into a fresh memblock-allocated region, return the loaded entry
# point. Real Linux validates a lot more (interp, page protections,
# stack canaries, BSS zero-fill alignment); we keep just enough to
# get a hand-built `/init` loaded and running at CPL=3.
#
# U20 pivot: the kernel no longer processes .rela.dyn / .rela.plt /
# IRELATIVE for ELF64 binaries. Real Linux doesn't do this either — the
# kernel maps the binary, populates auxv (AT_PHDR, AT_BASE, AT_ENTRY,
# AT_RANDOM, AT_PAGESZ at minimum), and jumps to e_entry. glibc's /
# musl's _dl_relocate_static_pie inside _start runs the relocation
# pass itself (RELATIVE, GLOB_DAT, JUMP_SLOT, IRELATIVE). That puts
# the kernel out of the relocation business and lets static-PIE glibc
# binaries' IFUNC resolvers run on their own.
#
# ELF32 header (52 bytes) layout we use:
#   offset  0   e_ident[16]   first 4 = 0x7f 'E' 'L' 'F'
#   offset 24   e_entry       (uint32) entry virtual address
#   offset 28   e_phoff       (uint32) program header table offset
#   offset 42   e_phentsize   (uint16) size of each phdr (32)
#   offset 44   e_phnum       (uint16) number of phdrs
#
# Program header (elf32, 32 bytes):
#   offset  0   p_type        (uint32)
#   offset  4   p_offset      (uint32) file offset of segment
#   offset  8   p_vaddr       (uint32) virtual address to load at
#   offset 16   p_filesz      (uint32) bytes in file
#   offset 20   p_memsz       (uint32) bytes in memory
#
# PT_LOAD = 1.
#
# Loading model: all of our user binaries are position-independent
# (RIP-relative addressing throughout) and link at base 0. We
# allocate a single contiguous region of size = max p_memsz across
# all PT_LOAD segments, copy each segment to (region + p_vaddr -
# lowest_vaddr), and return entry = region + (e_entry - lowest_vaddr).
# Multiple disjoint segments work because we rebase by the lowest
# vaddr; gaps are part of the same allocation.

from mm.memblock import memblock_alloc, memblock_region_top
from mm.page_alloc import (
    alloc_page, alloc_pages, region_alloc, region_free,
    pa_set_site, pa_set_tag, pa_set_owner,
    PA_SITE_PGTABLE, PA_SITE_FORK_COPY, PA_SITE_COW_RESOLVE,
)
from mm.cow import (
    cow_share_page, cow_page_is_shared, cow_drop_page,
    cow_ref_inc, cow_boot_cr3,
    cow_set_arm,
    COW_ARM_SHARE_WX_RO, COW_ARM_SHARE_COW, COW_ARM_SHARE_WRITABLE,
    COW_ARM_SHARE_COW_IMG, COW_ARM_SHARE_COW_BRK, COW_ARM_SHARE_COW_USTK,
    COW_ARM_REFINC_OWNER, COW_ARM_REFINC_RESOLVE, COW_ARM_DROP_RESOLVE,
)
from kernel.printk.printk import (
    printk0, printk1, printk2, printk_set_level,
)
from drivers.tty.serial.early_8250 import PRINTK_LEVEL_WARN, PRINTK_LEVEL_ERR
from kernel.panic import panic
# §4: PT_INTERP loading looks up the interpreter binary (typically
# /lib64/ld-linux-x86-64.so.2) through the calling process's namespace.
# fs.vfs depends on nothing in fs.elf, so this import doesn't form a
# cycle. ns_blob_ptr / ns_blob_size run the PT_INTERP path through
# resolve_path() first, so a binary execve'd inside a distro-shaped
# namespace (distrorun's `bind("/lib", backing/lib)`) finds its ld.so
# in the distro tree, while a native process resolves the canonical
# path verbatim (resolve_path is a no-op rewrite with no matching
# mount entry).
from fs.vfs import ns_blob_ptr, ns_blob_size
# SMAP v3c: cow_resolve_pte memcpy's an old US=1 page into a fresh one.
# The read leg lands on a US=1 page at CPL=0, so STAC is required.
from mm.uaccess import _ua_stac, _ua_clac
# Note: elf_load_blob no longer flips is_linux_userspace itself —
# the caller (SYS_SPAWN / SYS_EXECVE in arch/x86/kernel/syscall.ad)
# reads elf_last_was_linux and applies it to the correct task slot.

extern def memcpy(dst: Ptr[uint8], src: Ptr[uint8], n: uint64) -> Ptr[uint8]
# Pointer-service seam for long IRQ-off waits. `extern` rather than imported:
# fs/elf.ad must not take an import edge on the Plan 9 device layer.
extern def pointer_service_poll()
extern def memset(dst: Ptr[uint8], val: int32, n: uint64) -> Ptr[uint8]
extern def load_cr3(value: uint64)
extern def get_bsp_cr3() -> uint64
extern def read_cr3() -> uint64
# Boot-CR3 guard windows around fork-time page-table surgery run with
# IRQs masked: a timer preemption while the live CR3 is the pristine
# boot PML4 (not this task's own) would let schedule() resume us with
# a CR3 mismatch and corrupt the in-flight walk. Mask for the window.
extern def local_irq_disable()
extern def local_irq_enable()
# Nesting-safe variants: save snapshots RFLAGS (carrying IF) and CLIs;
# restore writes the saved RFLAGS back, re-enabling IRQs only if they
# were on at save time. Using these instead of bare disable/enable keeps
# nested boot-CR3 windows from spuriously re-enabling (or leaving off)
# IRQs and wedging the timer.
extern def local_irq_save() -> uint64
extern def local_irq_restore(flags: uint64)
# COW: flush one page's TLB entry after rewriting its PTE.
extern def invlpg_one(va: uint64)
# kernel_image_end() — the first PHYSICAL byte past the kernel image
# in low RAM. The kernel is now a HIGHER-HALF kernel: it is LINKED and
# runs at 0xffffffff80000000+offset, but its image is LOADED into low
# physical RAM starting at KERNEL_IMAGE_PHYS_BASE. kernel_image_end()
# returns the physical end so mm/memblock can keep the page allocator
# off the kernel's physical footprint.
extern def kernel_image_end() -> uint64

# Physical base the bare-metal kernel image is loaded at (the LMA of
# the first multiboot PT_LOAD; arch/x86/boot/header.S _start runs
# here in 32-bit mode). The kernel's VIRTUAL base is the higher half,
# 0xffffffff80000000 — not this. This constant is retained only to
# document the physical load address; user mappings live entirely in
# the lower canonical half and never approach the kernel.
KERNEL_IMAGE_PHYS_BASE: uint64 = 0x100000


PT_LOAD:    uint32 = 1
PT_INTERP:  uint32 = 3
PT_DYNAMIC: uint32 = 2

# e_ident byte offsets we care about for Linux-ABI detection.
EI_OSABI:      uint64 = 7
EI_ABIVERSION: uint64 = 8
# OSABI values: 0 = SystemV (also what Linux toolchains emit by
# default), 3 = explicit Linux. Either one means "could be Linux".
ELFOSABI_SYSV:  uint8 = 0
ELFOSABI_LINUX: uint8 = 3


# Returned by elf_load_blob: (entry_addr, load_addr, phoff, phnum).
# Hamnix doesn't have tuple return yet, so we return a single
# uint64 (entry) and stash the auxiliary bits in file-scope globals
# for the SYS_SPAWN / SYS_EXECVE caller to fish out when building
# the Linux process init-stack (auxv needs AT_PHDR / AT_PHNUM /
# AT_ENTRY).
#
# Semantics of elf_last_load_base: it's the USER-side base address of
# the loaded image — the value AT_PHDR / AT_ENTRY are anchored to.
#   * ET_DYN (PIE): set to `region` because the binary runs at the
#     identity-mapped kernel virt addr that equals the physical region
#     pointer. AT_PHDR = region + e_phoff is a real user-readable vaddr.
#   * ET_EXEC (U30+): set to `lowest_v`, the binary's link-time base
#     (e.g. 0x400000 for busybox). The user mapping installed by
#     elf_install_user_mapping translates [lowest_v, highest_v) to the
#     physical region we just kmalloc'd, so AT_PHDR = lowest_v + e_phoff
#     points at the loaded program headers inside the user's address
#     space.
elf_last_load_base: uint64 = 0
elf_last_phoff:     uint64 = 0
elf_last_phnum:     uint32 = 0


# U30: per-task user-virtual-address mapping. ET_EXEC binaries (like the
# Debian busybox-static) bake absolute addresses into .got / .text and
# expect to be loaded at their link-time vaddr (typically 0x400000+).
# When _load_elf64 detects ET_EXEC (e_type == 2) it stashes the user
# vaddr range and the backing physical region here; the SYS_SPAWN /
# SYS_EXECVE caller then invokes elf_install_user_mapping(pml4) on the
# target task's per-task PML4 to overlay a fine-grained 4 KiB mapping
# of [lowest_v, highest_v) onto the cloned identity map. ET_DYN binaries
# leave elf_last_needs_user_map at 0 and continue to run at the
# identity-mapped `region` address.
elf_last_needs_user_map: int32  = 0
elf_last_user_vlow:      uint64 = 0
elf_last_user_vhigh:     uint64 = 0
elf_last_user_phys_base: uint64 = 0
ELF_ET_EXEC: uint16 = 2

# Per-process address space (fork) support.
#
# Hamnix runs ET_DYN binaries identity-mapped: the user virtual address
# of every loaded segment EQUALS the physical address of the memblock
# region the loader copied them into. There is therefore no per-process
# isolation by default — every task's PML4 is a verbatim clone of the
# BSP's and the lower-level page tables are shared.
#
# fork() needs a CHILD that has a PRIVATE copy of every writable region
# (ELF .data/.bss, the brk heap, the user stack, anonymous mmaps) but
# mapped at the SAME virtual address as the parent — otherwise every
# absolute pointer the child inherits (saved %rbp chain, return
# addresses, glibc's _IO_2_1_stdout_ FILE struct, the TCB) would point
# at the PARENT's physical memory and the two processes would trample
# each other.
#
# elf_last_img_lo / elf_last_img_hi record the page-aligned virtual
# span of the WHOLE loaded ELF image (code + rodata + data + bss) so
# do_clone can copy it wholesale into the child's private pages. For
# ET_DYN this is [region, region + span); for ET_EXEC it is the
# link-time [vlow, vhigh). Whole-image (not just the writable segment)
# keeps the copy logic simple and guarantees zero aliasing — the few
# hundred KiB of read-only .text duplicated per process is a cheap
# price for a correct address space, and a COW pass can de-dup it later.
elf_last_img_lo: uint64 = 0
elf_last_img_hi: uint64 = 0

# Set by elf_load_blob to 1 when the just-loaded image is a Linux-ABI
# binary (OSABI=Linux or PT_INTERP present). Consumed by SYS_SPAWN /
# SYS_EXECVE in arch/x86/kernel/syscall.ad to flip is_linux_userspace
# on the correct task slot (the *child* for SYS_SPAWN, *current* for
# SYS_EXECVE). Doing the flag flip inside the loader was wrong because
# SYS_SPAWN runs in the parent's context — the loader would mis-flag
# the parent (hamsh) instead of the new child.
elf_last_was_linux: int32 = 0

# #106 graceful OOM: set to 1 by a load path whose region_alloc() failed
# (physical OOM), 0 on every successful/other-failure load. elf_load_blob
# returns 0 for BOTH a malformed image (-ENOEXEC) and an OOM (-ENOMEM); the
# execve caller reads this flag to pick the right errno and to log a
# COMPLETE, non-faulting diagnostic instead of wedging. Cleared at the top
# of elf_load_blob so a prior load's OOM never leaks into a clean one.
elf_last_load_oom: int32 = 0


# ===========================================================================
# U52: ET_DYN load-bias ASLR.
#
# An ET_DYN (PIE) image is position-independent: it runs correctly at ANY
# page-aligned virtual base. Historically Hamnix placed it at vaddr == its
# physical `region` (identity), because every user-memory access in the
# kernel assumed vaddr == phys. mm/uaccess.ad now provides real translation
# (copy_to/from_user walk the task's PML4), so the image's VIRTUAL base can
# be randomized INDEPENDENTLY of its physical backing: we map
# [vbase, vbase+span) -> [region, region+span) via the non-identity
# primitive elf_install_user_range already supports (target_phys =
# phys_base + (vaddr - vlow)). No raw kernel deref of the biased vaddr ever
# happens on the load path — the loader copies PT_LOAD bytes to the
# identity-mapped `region` (phys), not to the biased vaddr.
#
# elf_aslr_app_vbase / elf_aslr_interp_vbase carry the absolute randomized
# user base for the application image and its PT_INTERP (ld.so) image. 0 in
# either means "no bias — run identity at `region`", preserving the exact
# pre-ASLR layout for a deterministic (aslr_disabled) boot. The caller
# (arch/x86/kernel/syscall.ad::do_execve) draws the bases from
# aslr_load_bias() and installs them via elf_set_aslr_vbases() BEFORE
# elf_load_blob(). _load_elf64 consults the matching slot (interp slot when
# _in_interp_load == 1) when it rebases an ET_DYN image.
elf_aslr_app_vbase:    uint64 = 0
elf_aslr_interp_vbase: uint64 = 0


def elf_set_aslr_vbases(app_vbase: uint64, interp_vbase: uint64):
    # Arm the ET_DYN load-bias for the NEXT elf_load_blob. Pass (0, 0) to
    # load identity (deterministic / aslr_disabled boot). The values are
    # consumed once by _load_elf64; the caller re-arms before each load.
    elf_aslr_app_vbase    = app_vbase
    elf_aslr_interp_vbase = interp_vbase


# U42: dynamic-ELF interpreter ("ld-linux-x86-64.so.2") support.
#
# When _load_elf64 sees a PT_INTERP segment, it now recursively loads
# the interpreter as its own ELF image (allocated in a fresh memblock
# region distinct from the application's). The user-mode RIP becomes
# the INTERPRETER's e_entry — not the application's; ld.so walks the
# application's PT_DYNAMIC from inside userspace and eventually
# jumps to the application's e_entry itself.
#
# Auxv (built in arch/x86/kernel/syscall.ad::_build_user_argv_linux)
# consumes these three globals:
#
#   AT_BASE  = elf_last_interp_base        # set on dynamic load, 0 else
#   AT_ENTRY = elf_last_app_entry_user     # application's e_entry,
#                                          #   rebased to its load base.
#   AT_PHDR  = elf_last_load_base + elf_last_phoff
#                                          # still the APPLICATION's
#                                          #   phdrs — elf_last_load_base
#                                          #   keeps pointing at the app
#                                          #   (NOT the interpreter)
#                                          #   precisely so glibc's
#                                          #   dl_main / _dl_aux_init
#                                          #   can find them here.
#
# On a static binary (no PT_INTERP) elf_last_interp_base stays 0 and
# elf_last_app_entry_user is set to the same value the function
# returns — so _build_user_argv_linux's static-PIE path is unchanged.
elf_last_interp_base:    uint64 = 0
elf_last_app_entry_user: uint64 = 0

# M16.36: per-task PT-entry installation for ELF images.
#
# Historically a freshly-execve'd ET_DYN binary (and a native ELF32
# image) ran on the BSP's 1 GiB identity stamp — its vaddr happened
# to equal the phys address memblock_alloc returned, so the inherited
# PML4[0]->PDPT[0..N] PS=1 1 GiB pages mapped the right bytes.
#
# This is fragile in two ways:
#
#   1. The mapping is shared with every other task and the kernel —
#      no per-task isolation. A future change that scrubs PDPT[0..N]
#      out of the user PML4 (proper Plan-9-shape lower-half) would
#      silently break user execution.
#   2. On real hardware (Asus i5-4210U) the memblock region can land
#      anywhere the EFI memory map advertised — phys 0x100000000 + on
#      a 5 GiB machine. The boot stub's 4 GiB identity map doesn't
#      cover that; mm/pgtable.ad's _pgtable_force_stamp_1gb stamps
#      all 512 PDPT entries on the EFI path so the identity still
#      reaches there, but only as PS=1 1 GiB pages. The PML4-walk
#      diagnostic on a real-hw Asus boot (M16.34) showed the user
#      RIP resolving via PDPT[4] PS=1 — a 1 GiB page — instead of a
#      4 KiB PTE specific to this task.
#
# Fix: track the full [region, region+span) for BOTH the application
# and the interpreter so do_execve / SYS_SPAWN can explicitly install
# 4 KiB PTEs (cracking the inherited 1 GiB PS=1 stamp) into the user
# task's PML4. After this, the [execve-pml4] walk lands on a real
# per-task PTE, no longer the kernel's identity stamp.
#
# These globals are zero for an image that wasn't loaded (or for an
# image whose span is 0 — defensively skipped by the installer).
elf_last_app_img_phys:    uint64 = 0
elf_last_app_img_vlow:    uint64 = 0
elf_last_app_img_vhigh:   uint64 = 0
elf_last_interp_img_phys: uint64 = 0
elf_last_interp_img_vlow: uint64 = 0
elf_last_interp_img_vhigh:uint64 = 0

# DEMAND-BSS (2026-06-23): the application image's BSS tail is no longer
# eagerly allocated + mapped. The loader now eagerly backs only the
# FILE-extent of the image (code+rodata+data file bytes, page-rounded up
# = elf_last_app_img_vhigh) and registers the top BSS tail
# [elf_last_app_bss_lo, elf_last_app_bss_hi) as a DEMAND-ZERO anon VMA so
# the caller (do_execve) can lazily zero-on-fault it. This kills the
# per-app ~8 MiB CONTIGUOUS physical region_alloc that OOM'd the DE after
# a few hamui apps (each client links ~8.2 MiB of static BSS in
# lib/hamui.ad). bss_lo/hi are in the USER vaddr space (dyn_vbase-relative
# for ET_DYN), mirroring app_img_vlow/vhigh. Both 0 when the image has no
# BSS tail above its highest file-backed page (mem_hi <= file_hi).
elf_last_app_bss_lo:      uint64 = 0
elf_last_app_bss_hi:      uint64 = 0

# W^X Stage 1b: per-PT_LOAD-segment read-only enforcement on CODE pages.
#
# The whole image span [vlow, vhigh) is installed RW+executable first
# (so userspace ld.so / glibc can write its GOT/.data during relocation
# — those live in PF_W segments). Immediately afterward, before the
# first user instruction runs, every NON-WRITABLE PT_LOAD segment
# (PF_W clear: .text + .rodata) is flipped to READ-ONLY (PT_FLAG_RW
# cleared) while staying executable. A userland WRITE into .text then
# faults with a genuine (non-COW) protection #PF, which the page-fault
# handler converts to SIGSEGV. This closes the self-modifying-code /
# code-injection W^X hole left open by Stage 1a.
#
# A PT_LOAD-rich binary rarely has more than 2-3 segments; we record
# up to ELF_MAX_RO_SPANS non-writable spans for the app and the same
# for the interpreter. Each span is a page-aligned USER-vaddr range
# (matching the coordinate space the image is installed in). Spans
# beyond the cap are simply left RW (a missed hardening, never a
# correctness bug); ELF_MAX_RO_SPANS=8 covers every real binary.
ELF_MAX_RO_SPANS: uint64 = 8

# LOW-BSS / DIRECT-MAP COLLISION CAP — see the long note at the split decision
# in _load_elf64. A LOW-linked ET_EXEC image's demand-BSS window aliases the
# kernel direct map; beyond this size the window swallows enough of MEMBLOCK's
# [0x200000, 0x0F000000) pool that the demand resolver's own allocations land
# inside it and fault recursively. 64 MiB is ~2.7x the largest window that
# works on device today (0x1749000 = 23.3 MiB), so every shipping image keeps
# the demand split; only a pathologically large BSS (LLVM-lane hambrowse at
# 173.8 MiB) falls back to the eager full-span load the ELF32 path always uses.
ELF_MAX_LOW_BSS_DEMAND: uint64 = 0x4000000
# An image whose lowest PT_LOAD vaddr is below this is "low-linked": its user
# vaddrs alias the kernel's identity direct map. ET_DYN images at a high ASLR
# vbase sit far above RAM and can never collide, so they are exempt.
ELF_LOW_IMAGE_VADDR_TOP: uint64 = 0x40000000

# ===========================================================================
# NATIVE ET_DYN RELOCATION (2026-07-30) — the lift for the low-BSS class.
#
# The native ELF64 LLVM lane used to link ET_EXEC at a fixed low 0x400000
# (user/init64.lds), which makes every app's user vaddrs numerically alias low
# physical RAM — the kernel's own direct map. For hambrowse (~174 MiB static
# BSS, image span [0x400000, 0xB35E000)) that aliased most of MEMBLOCK's pool
# and either wedged the box (demand-BSS) or let the kernel scribble through a
# direct-map VA onto the app's pages (eager). See the long note at the split
# decision in _load_elf64 and the header of user/init64_pie.lds.
#
# The fix is to link the lane PIE (user/init64_pie.lds -> ET_DYN at base 0) so
# _load_elf64's ET_DYN arm rebases the image onto a base of the KERNEL's
# choosing — the high ASLR vbase, or identity at the image's own memblock
# `region` on a deterministic boot. Either way the image only ever covers its
# OWN pages, which is precisely the property the native ELF32 lane always had
# and the reason the native lane never hit this class.
#
# A PIE needs its R_X86_64_RELATIVE relocations applied at the chosen base.
# Historically the kernel applied NONE (see the U20 note in _load_elf64:
# glibc/musl static-PIE binaries self-relocate from userspace via
# _dl_relocate_static_pie using auxv). A NATIVE Hamnix PIE has no such runtime,
# so the loader must do it. It is a small job: the lane is -static -nostdlib
# with every symbol defined in-image, so no PLT and no symbolic relocation can
# survive the link — hambrowse needs exactly 64 R_X86_64_RELATIVE entries, all
# in .data.rel.ro, all inside the eager file-backed extent (never the
# demand-BSS tail, which has no file bytes to patch).
#
# Any OTHER relocation type is a hard load failure rather than a silent skip:
# an unrelocated pointer is a wild store, and this is exactly the class of bug
# that cost a full device bisect to attribute the first time.
_ELF_DT_NULL:     uint64 = 0
_ELF_DT_NEEDED:   uint64 = 1
_ELF_DT_PLTRELSZ: uint64 = 2
_ELF_DT_PLTGOT:   uint64 = 3
_ELF_DT_RELA:     uint64 = 7
_ELF_DT_RELASZ:   uint64 = 8
_ELF_DT_RELAENT:  uint64 = 9
_ELF_DT_SONAME:   uint64 = 14
_ELF_DT_JMPREL:   uint64 = 23
_ELF_R_X86_64_NONE:     uint64 = 0
_ELF_R_X86_64_RELATIVE: uint64 = 8

elf_last_app_ro_n:     uint64 = 0
elf_last_app_ro_lo:    Array[8, uint64]
elf_last_app_ro_hi:    Array[8, uint64]
elf_last_interp_ro_n:  uint64 = 0
elf_last_interp_ro_lo: Array[8, uint64]
elf_last_interp_ro_hi: Array[8, uint64]

# PF_* — PT_LOAD p_flags bits (ELF program-header flags, offset 4 of a
# 64-bit phdr). PF_X=exec, PF_W=write, PF_R=read.
PF_X_FLAG: uint32 = 0x1
PF_W_FLAG: uint32 = 0x2
PF_R_FLAG: uint32 = 0x4

# Recursion guard. Set to 1 while we're loading an interpreter, so the
# nested _load_elf64 call doesn't itself try to recurse on a (hostile
# or weird) PT_INTERP entry inside the interpreter binary. ld.so is a
# regular ET_DYN without PT_INTERP in practice, but the guard keeps
# the worst case bounded at "ignore PT_INTERP one level deep".
_in_interp_load: int32 = 0

# Where to plant the interpreter relative to its own allocation. We
# memblock_alloc the interpreter image just like an ET_DYN application
# — it ends up at a kernel-chosen identity-mapped base. The 0x40000000
# style "high-half" address the Linux ABI normally uses for ld.so is
# unnecessary for us: Hamnix doesn't paged-protect user vs. kernel
# (yet) and every memblock region is reachable from CPL=3 via the
# identity map.


def _read_u16(p: Ptr[uint8]) -> uint32:
    return cast[uint32](p[0]) | (cast[uint32](p[1]) << 8)


def _read_u32(p: Ptr[uint8]) -> uint32:
    return (cast[uint32](p[0])
            | (cast[uint32](p[1]) << 8)
            | (cast[uint32](p[2]) << 16)
            | (cast[uint32](p[3]) << 24))


def _read_u64(p: Ptr[uint8]) -> uint64:
    lo: uint64 = cast[uint64](_read_u32(p))
    hi: uint64 = cast[uint64](_read_u32(cast[Ptr[uint8]](
        cast[uint64](p) + 4)))
    return lo | (hi << 32)


def _validate_magic(blob: Ptr[uint8]) -> int32:
    # 0x7f 'E' 'L' 'F' = 0x7f 0x45 0x4c 0x46
    if blob[0] != 0x7f:
        return 0
    if blob[1] != 0x45:
        return 0
    if blob[2] != 0x4c:
        return 0
    if blob[3] != 0x46:
        return 0
    return 1


def _collect_app_ro_spans(blob: Ptr[uint8], e_phoff: uint64,
                          e_phentsize: uint32, e_phnum: uint32,
                          lowest_v: uint64, load_base: uint64):
    # W^X Stage 1b: walk the PT_LOAD program headers and record every
    # NON-WRITABLE segment's page-aligned USER-vaddr span into the
    # elf_last_app_ro_* globals. `load_base` is the image's user-vaddr
    # base (lowest_v for ET_EXEC; the rebased `region` for ET_DYN), so
    # the recorded span is in the SAME coordinate space the installer
    # maps the image at. Caller copies these into the interp slots when
    # this load is the interpreter's (see PT_INTERP arm).
    n: uint64 = 0
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type:  uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        p_flags: uint32 = _read_u32(cast[Ptr[uint8]](ph + 4))
        if p_type == PT_LOAD and (p_flags & PF_W_FLAG) == 0:
            # Non-writable PT_LOAD: .text / .rodata. Map its user span.
            p_vaddr: uint64 = _read_u64(cast[Ptr[uint8]](ph + 16))
            p_memsz: uint64 = _read_u64(cast[Ptr[uint8]](ph + 40))
            if p_memsz != 0 and n < ELF_MAX_RO_SPANS:
                seg_lo: uint64 = load_base + (p_vaddr - lowest_v)
                seg_hi: uint64 = seg_lo + p_memsz
                # Page-align: round lo down, hi up so the whole RO
                # segment is covered.
                seg_lo = seg_lo & ~cast[uint64](PAGE_SIZE_4K - 1)
                seg_hi = (seg_hi + PAGE_SIZE_4K - 1) \
                         & ~cast[uint64](PAGE_SIZE_4K - 1)
                # SHARED-PAGE GUARD (apt-get false-SIGSEGV fix): the old
                # code assumed a non-writable segment NEVER shares a page
                # with a writable one ("the linker page-aligns LOADs").
                # That is false for real Debian PIEs (e.g. apt-get): a RO
                # PT_LOAD whose p_vaddr+p_memsz is not page-aligned shares
                # its final page with the FOLLOWING writable PT_LOAD
                # (.data / GOT / RELRO). Rounding seg_hi UP then dragged
                # that shared writable page into the RO flip — a later
                # legit userspace write to it faulted err=0x07 and, since
                # the eager image extent has no covering VMA,
                # vma_resolve_write_perm_fault could not rescue it →
                # FALSE SIGSEGV (apt-get exited 139 mid-startup).
                #
                # Fix: clip this RO span against EVERY writable PT_LOAD's
                # page-rounded range, so any page that also belongs to a
                # writable segment is left RW. A page wholly owned by the
                # RO segment is still hardened; only the boundary page it
                # SHARES with a writable segment is conceded (matching how
                # Linux mprotect()s only pages fully inside the RO/RELRO
                # region). Two-clip model: if a writable segment's pages
                # overlap the TAIL of this RO span, lower seg_hi to the
                # writable range's page-rounded base; if they overlap the
                # HEAD, raise seg_lo to the writable range's page-rounded
                # end. (Real binaries only ever share the tail boundary,
                # but clipping both ends is robust to any layout.)
                w: uint32 = 0
                while w < e_phnum:
                    wph: uint64 = cast[uint64](blob) + e_phoff \
                                + cast[uint64](w) * cast[uint64](e_phentsize)
                    w_type:  uint32 = _read_u32(cast[Ptr[uint8]](wph + 0))
                    w_flags: uint32 = _read_u32(cast[Ptr[uint8]](wph + 4))
                    if w_type == PT_LOAD and (w_flags & PF_W_FLAG) != 0:
                        w_vaddr: uint64 = _read_u64(cast[Ptr[uint8]](wph + 16))
                        w_memsz: uint64 = _read_u64(cast[Ptr[uint8]](wph + 40))
                        if w_memsz != 0:
                            w_lo: uint64 = load_base + (w_vaddr - lowest_v)
                            w_hi: uint64 = w_lo + w_memsz
                            # Page-round the writable range OUTWARD: any
                            # page it touches at all must stay writable.
                            w_lo = w_lo & ~cast[uint64](PAGE_SIZE_4K - 1)
                            w_hi = (w_hi + PAGE_SIZE_4K - 1) \
                                   & ~cast[uint64](PAGE_SIZE_4K - 1)
                            # Overlap with the RO span's tail → drop seg_hi
                            # to the writable base.
                            if w_lo > seg_lo and w_lo < seg_hi:
                                seg_hi = w_lo
                            # Overlap with the RO span's head → raise seg_lo
                            # to the writable end.
                            if w_hi > seg_lo and w_hi < seg_hi:
                                seg_lo = w_hi
                    w = w + 1
                # Only record a non-empty span after clipping.
                if seg_hi > seg_lo:
                    elf_last_app_ro_lo[n] = seg_lo
                    elf_last_app_ro_hi[n] = seg_hi
                    n = n + 1
        i = i + 1
    elf_last_app_ro_n = n


def _elf64_vaddr_to_blob_off(blob: Ptr[uint8], e_phoff: uint64,
                             e_phentsize: uint32, e_phnum: uint32,
                             v: uint64) -> uint64:
    # Map a link-time vaddr to its byte offset inside `blob` by finding the
    # PT_LOAD that contains it in its FILE-backed part. Returns 0 when no
    # PT_LOAD covers it (0 is never a valid answer here: the ELF header itself
    # occupies offset 0).
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        if _read_u32(cast[Ptr[uint8]](ph + 0)) == PT_LOAD:
            p_offset: uint64 = _read_u64(cast[Ptr[uint8]](ph + 8))
            p_vaddr:  uint64 = _read_u64(cast[Ptr[uint8]](ph + 16))
            p_filesz: uint64 = _read_u64(cast[Ptr[uint8]](ph + 32))
            if v >= p_vaddr and v < p_vaddr + p_filesz:
                return p_offset + (v - p_vaddr)
        i = i + 1
    return 0


def _elf64_apply_relative_relocs(blob: Ptr[uint8], blob_size: uint64,
                                 e_phoff: uint64, e_phentsize: uint32,
                                 e_phnum: uint32, lowest_v: uint64,
                                 region: uint64, file_hi_rel: uint64,
                                 load_bias: uint64) -> int32:
    # Apply an ET_DYN image's R_X86_64_RELATIVE relocations for a load at
    # `load_bias` (the image's chosen user-virtual base). Returns 0 on success,
    # -1 on anything it cannot honour.
    #
    # Writes go through the image's IDENTITY `region` mapping — the same
    # channel the PT_LOAD copy above uses, and for the same reason: the biased
    # user vaddr is not mapped in the kernel's view yet, and `region` is. That
    # also means the writes need the SMAP bracket (region_alloc's backing can
    # alias a recycled US=1 page), exactly like _elf_memcpy_serviced.
    #
    # No-op when there is no PT_DYNAMIC (a plain non-PIE ET_DYN blob, or the
    # ELF32 path's callers) or no DT_RELA.
    dyn_off: uint64 = 0
    dyn_sz:  uint64 = 0
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        if _read_u32(cast[Ptr[uint8]](ph + 0)) == PT_DYNAMIC:
            dyn_off = _read_u64(cast[Ptr[uint8]](ph + 8))
            dyn_sz  = _read_u64(cast[Ptr[uint8]](ph + 32))
        i = i + 1
    if dyn_off == 0 or dyn_sz == 0:
        return 0
    if dyn_off + dyn_sz > blob_size:
        printk0("elf64: PT_DYNAMIC runs past the image\n")
        return -1

    # Walk the 16-byte (d_tag, d_val) entries for the RELA table coordinates.
    rela_v:   uint64 = 0
    rela_sz:  uint64 = 0
    rela_ent: uint64 = 24
    has_linkage: int32 = 0
    off: uint64 = 0
    while off + 16 <= dyn_sz:
        d_tag: uint64 = _read_u64(cast[Ptr[uint8]](
            cast[uint64](blob) + dyn_off + off))
        d_val: uint64 = _read_u64(cast[Ptr[uint8]](
            cast[uint64](blob) + dyn_off + off + 8))
        if d_tag == _ELF_DT_NULL:
            off = dyn_sz
        else:
            if d_tag == _ELF_DT_RELA:
                rela_v = d_val
            if d_tag == _ELF_DT_RELASZ:
                rela_sz = d_val
            if d_tag == _ELF_DT_RELAENT:
                rela_ent = d_val
            # Any real dynamic-linking machinery disqualifies the image from
            # kernel-side relocation — see the NOT-OURS note below.
            if d_tag == _ELF_DT_NEEDED or d_tag == _ELF_DT_SONAME \
                    or d_tag == _ELF_DT_PLTGOT or d_tag == _ELF_DT_JMPREL \
                    or d_tag == _ELF_DT_PLTRELSZ:
                has_linkage = 1
            off = off + 16
    if rela_sz == 0:
        return 0

    # NOT-OURS GUARD. A native Hamnix PIE from scripts/adder_cc_llvm_native64.sh
    # is -static -nostdlib with no dynamic-linking machinery at all: no
    # DT_NEEDED, no DT_SONAME, no PLT. A DYNAMIC image that HAS any of those is
    # a Linux shared-object-consuming binary; its relocations are symbolic and
    # belong to ld.so, not to us. Refuse rather than guess.
    #
    # KNOWN RESIDUAL, stated plainly: a glibc/musl STATIC-PIE has the same
    # DT shape as ours (no PT_INTERP, OSABI=0, RELATIVE-only) and is therefore
    # indistinguishable here — and it self-relocates from userspace via
    # _dl_relocate_static_pie, so applying its relocations here would
    # DOUBLE-BIAS every pointer. That is not a regression: elf_is_linux_binary's
    # own comment records that static-PIE Linux binaries are not supported by
    # this loader today, and nothing in the tree ships one. Before that changes,
    # this needs a positive marker for our own images (a PT_NOTE, or a reserved
    # DT_LOOS tag) rather than a shape heuristic.
    if has_linkage != 0:
        printk0("elf64: ET_DYN has dynamic linkage (DT_NEEDED/PLT) - not a native PIE, skipping relocs\n")
        return 0
    if rela_ent != 24:
        printk1("elf64: unsupported DT_RELAENT %d (want 24)\n", rela_ent)
        return -1

    rela_off: uint64 = _elf64_vaddr_to_blob_off(blob, e_phoff, e_phentsize,
                                                e_phnum, rela_v)
    if rela_off == 0 or rela_off + rela_sz > blob_size:
        printk0("elf64: DT_RELA table is not inside a file-backed PT_LOAD\n")
        return -1

    n_rel: uint64 = 0
    r: uint64 = 0
    while r + rela_ent <= rela_sz:
        e: uint64 = cast[uint64](blob) + rela_off + r
        r_offset: uint64 = _read_u64(cast[Ptr[uint8]](e + 0))
        r_info:   uint64 = _read_u64(cast[Ptr[uint8]](e + 8))
        r_addend: uint64 = _read_u64(cast[Ptr[uint8]](e + 16))
        r_type:   uint64 = r_info & 0xffffffff
        if r_type == _ELF_R_X86_64_NONE:
            r = r + rela_ent
        else:
            if r_type != _ELF_R_X86_64_RELATIVE:
                # A symbolic / GOT / PLT relocation. The native lane links
                # -static -nostdlib with every symbol defined in-image, so this
                # is unreachable today; if a toolchain change ever makes it
                # reachable, FAIL the load. Skipping it would leave a wild
                # pointer in .data and reintroduce exactly the silent-corruption
                # class this whole change exists to remove.
                printk1("elf64: unsupported dynamic reloc type %d in a native PIE\n",
                        r_type)
                return -1
            # Target must sit inside the EAGER file-backed extent: that is the
            # only part `region` actually backs. .data.rel.ro / .got always do;
            # a reloc pointing into the demand-BSS tail would have no file bytes
            # to patch and means the image is malformed.
            if r_offset < lowest_v:
                printk1("elf64: reloc target 0x%x below the image base\n", r_offset)
                return -1
            rel: uint64 = r_offset - lowest_v
            if rel + 8 > file_hi_rel:
                printk1("elf64: reloc target 0x%x outside the file-backed extent\n",
                        r_offset)
                return -1
            _ua_stac()
            slot: Ptr[uint64] = cast[Ptr[uint64]](region + rel)
            slot[0] = load_bias + r_addend
            _ua_clac()
            n_rel = n_rel + 1
            r = r + rela_ent
    printk2("elf64: applied %d R_X86_64_RELATIVE relocs at bias 0x%x\n",
            n_rel, load_bias)
    return 0


def _load_elf64(blob: Ptr[uint8], blob_size: uint64) -> uint64:
    # U5 ELF64 path: Linux x86_64 binaries (ELFCLASS64). Same rebase
    # model as the ELF32 path — copy PT_LOAD segments into one
    # memblock allocation at (region + p_vaddr - lowest_v). Works for
    # any code that is RIP-relative or whose absolute references all
    # land inside the loaded image. Real Linux binaries with hard-coded
    # absolute addresses outside their own range need full per-task
    # PML4 mappings (deferred to U6+).
    #
    # U20 pivot: NO kernel-side relocation processing. The auxv that
    # SYS_EXECVE / SYS_SPAWN builds points at the binary's own PT_PHDR
    # and AT_ENTRY, so glibc / musl's startup runs its own relocator
    # (handles RELATIVE, GLOB_DAT, JUMP_SLOT, IRELATIVE — including
    # invoking IFUNC resolvers).
    #
    # ELF64 header offsets (size 64 bytes):
    #   24  e_entry      uint64
    #   32  e_phoff      uint64
    #   54  e_phentsize  uint16  (typically 56)
    #   56  e_phnum      uint16
    #
    # ELF64 program header (56 bytes):
    #   0   p_type       uint32
    #   8   p_offset     uint64
    #   16  p_vaddr      uint64
    #   32  p_filesz     uint64
    #   40  p_memsz      uint64
    if blob_size < 64:
        printk0("elf64: blob too small for ELF64 header\n")
        return 0
    # e_type at offset 16 (uint16). 2 = ET_EXEC (absolute addresses
    # baked in; needs the per-task user mapping installed below).
    # 3 = ET_DYN (PIE / shared object); runs at the rebased `region`.
    e_type: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](blob) + 16))
    e_entry: uint64 = _read_u64(cast[Ptr[uint8]](
        cast[uint64](blob) + 24))
    e_phoff: uint64 = _read_u64(cast[Ptr[uint8]](
        cast[uint64](blob) + 32))
    e_phentsize: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](blob) + 54))
    e_phnum: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](blob) + 56))

    printk2("elf64: entry=0x%x phnum=%d\n", e_entry,
            cast[uint64](e_phnum))

    # First pass: span the PT_LOAD vaddrs. lowest_v is pre-seeded to
    # UINT64_MAX so the first PT_LOAD always updates it. Adder's `<`
    # honours operand signedness (both sides are uint64 here), so the
    # sentinel compare is a true unsigned compare.
    lowest_v:    uint64 = 0xFFFFFFFFFFFFFFFF
    highest_v:   uint64 = 0
    # DEMAND-BSS: highest_file_v spans the highest FILE-BACKED byte
    # (p_vaddr + p_filesz) across all PT_LOADs. Everything above its
    # page-rounded value (file_hi) is the BSS tail — eagerly zero-filled
    # data the image declares but the file does not carry. We back only
    # [lowest_v, lowest_v+file_hi) eagerly and demand-page the rest.
    highest_file_v: uint64 = 0
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        if p_type == PT_LOAD:
            p_vaddr: uint64 = _read_u64(cast[Ptr[uint8]](ph + 16))
            p_memsz: uint64 = _read_u64(cast[Ptr[uint8]](ph + 40))
            p_filesz0: uint64 = _read_u64(cast[Ptr[uint8]](ph + 32))
            if p_vaddr < lowest_v:
                lowest_v = p_vaddr
            if p_vaddr + p_memsz > highest_v:
                highest_v = p_vaddr + p_memsz
            if p_vaddr + p_filesz0 > highest_file_v:
                highest_file_v = p_vaddr + p_filesz0
        i = i + 1

    if highest_v == 0:
        printk0("elf64: no PT_LOAD segments\n")
        return 0

    span: uint64 = highest_v - lowest_v
    span = (span + 4095) & ~cast[uint64](4095)
    # mem_hi_rel = full image span (incl. BSS), file_hi_rel = highest
    # file-backed byte (page-rounded UP), both relative to lowest_v.
    # The eager region + user mapping cover only [0, file_hi_rel); the
    # tail [file_hi_rel, mem_hi_rel) is demand-zero BSS.
    mem_hi_rel:  uint64 = span
    file_hi_rel: uint64 = highest_file_v - lowest_v
    file_hi_rel = (file_hi_rel + 4095) & ~cast[uint64](4095)
    if file_hi_rel > mem_hi_rel:
        file_hi_rel = mem_hi_rel
    # The interpreter (ld.so) load keeps EAGER behaviour — it is small
    # and has no huge BSS. Only the top-level APPLICATION image splits
    # its BSS tail to demand. When loading as an interpreter the demand
    # tail is suppressed (file_hi_rel forced to the full span).
    if _in_interp_load != 0:
        file_hi_rel = mem_hi_rel
    # LOW-BSS / DIRECT-MAP COLLISION CAP (2026-07-30, LLVM-lane hambrowse).
    #
    # An ET_EXEC image links at a LOW vaddr (0x400000), so its user vaddrs are
    # NUMERICALLY IDENTICAL to low physical RAM — the kernel's own identity
    # direct map. vma_register_bss_demand -> elf_prepare_demand_range PUNCHES
    # every leaf in [bss_lo, bss_hi) not-present in THIS task's PML4. Once
    # punched, any kernel low-identity access to a physical page inside that
    # window, made under this task's CR3, takes a supervisor #PF. The demand
    # resolver itself is such an access (alloc_page hands back a low frame and
    # the zero-fill/map touches it through its identity vaddr), so the FIRST
    # BSS touch can fault recursively and wedge the box with interrupts off.
    #
    # vma_register_bss_demand already shields REGISTRATION under boot CR3; the
    # RUNTIME collision is inherent to sharing PML4[0] between user low vaddrs
    # and the kernel direct map, and its general resolution is the KPTI
    # page_offset consumer flip (or loading such images at a high ET_DYN base).
    # Until then, bound the exposure: a window is only survivable while it stays
    # below the low RAM the allocator has already consumed by the time apps
    # launch. Every image that works on device today tops out at 0x1749000
    # (23.3 MiB); the LLVM-lane hambrowse asks for [0x589000, 0xB35E000) —
    # 173.8 MiB, i.e. most of MEMBLOCK's [0x200000, 0x0F000000) pool — and
    # wedges the box on its first BSS store (verified: markers stop between
    # sys_bind and he_set_click_links, whose `he_click_links` global sits at
    # +135 MiB inside the window).
    #
    # Above the cap, suppress the split and eagerly back the FULL span — which
    # is exactly the policy the native ELF32 path already applies for exactly
    # this aliasing reason (see the DEMAND-BSS NOTE in elf_load_blob), and which
    # the native-lane build of the same program is proven to run on. The cap is
    # deliberately set well ABOVE every currently-working image so this is a
    # no-op for them: the DE-OOM fix the demand split exists for is untouched.
    #
    # THE RULE IS ABOUT THE EFFECTIVE LOAD BASE, NOT e_type (2026-07-30).
    # Moving the lane to PIE removes the aliasing for the ASLR case, but NOT
    # automatically for a deterministic boot. With aslr_disabled the ET_DYN arm
    # loads the image IDENTITY at its own `region` (dyn_vbase == 0 -> region),
    # and identity is only safe while vaddr == phys holds for the WHOLE image.
    # A demand-BSS tail breaks exactly that: the eager extent is backed at
    # [region, region+file_hi_rel) but the punched tail
    # [region+file_hi_rel, region+mem_hi_rel) is a range of low VAs with no
    # backing at all — which is the direct-map alias again, just displaced by
    # the region base. The native ELF32 lane is safe precisely because it is
    # always EAGER full-span, so vaddr == phys everywhere and a kernel
    # direct-map access inside the image's span reaches the intended page.
    #
    # So: suppress the split whenever the image will land in the low,
    # direct-map-aliasing band, whether that is a low ET_EXEC link or an ET_DYN
    # identity load. A high ASLR vbase (the default) sits above all RAM and
    # keeps the demand split — which is the case the DE-OOM fix needs.
    img_base_is_low: int32 = 1
    if e_type == cast[uint32](ELF_ET_EXEC):
        if lowest_v >= ELF_LOW_IMAGE_VADDR_TOP:
            img_base_is_low = 0
    else:
        planned_vbase: uint64 = elf_aslr_app_vbase
        if _in_interp_load != 0:
            planned_vbase = elf_aslr_interp_vbase
        # planned_vbase == 0 means "identity at region" -> low by definition.
        if planned_vbase >= ELF_LOW_IMAGE_VADDR_TOP:
            img_base_is_low = 0
    if mem_hi_rel > ELF_MAX_LOW_BSS_DEMAND and img_base_is_low != 0:
        printk1("elf64: low-BSS demand window %d MiB > cap -> EAGER full span (direct-map alias guard)\n",
                mem_hi_rel >> 20)
        file_hi_rel = mem_hi_rel
    # region_alloc (not raw memblock_alloc): a freeable large-region
    # allocator. task_reap returns this chunk to the pool on exit, so
    # repeated spawns of the same binary recycle the SAME ~14.7 MiB
    # region instead of leaking it (the old bump-allocated region was
    # never reclaimed — ~6 hpm spawns exhausted RAM -> "command not
    # found"). Same physical-RAM source as before on a cold miss.
    # DEMAND-BSS: eagerly allocate only the FILE-backed extent
    # [0, file_hi_rel). The BSS tail above file_hi_rel is registered as
    # a demand-zero VMA by the caller (do_execve) and never costs a
    # contiguous physical region here. file_hi_rel == mem_hi_rel for the
    # interpreter or any image with no BSS tail (eager == legacy).
    # WHOSE IMAGE IS THIS (leak pass 18). Pass 17 taught region_alloc to
    # stamp a per-frame SITE (PA_SITE_REGION) but nothing ever named an
    # OWNER, so COW arms 1 (W^X verbatim share) and 19 (ELF image span) still
    # reported owner-unrecorded = 101 of 101 and 20 of 20 — and `owner-dead =
    # 0` over a population whose owner was never recorded means "nobody wrote
    # an owner down", not "no owner is dead". Their inter-cycle nets are zero,
    # which is the assertion that actually clears them, but half the
    # discriminator was blind. The pending-slot protocol is already wired
    # through _pa_trk_stamp_region; it just needed a caller to name itself.
    pa_set_owner(current_idx_get())
    region: uint64 = region_alloc(file_hi_rel)
    if region == 0:
        # ERR level: this is the message that must survive
        # console_set_interactive()'s INFO gate, or an out-of-memory exec
        # is indistinguishable from "command not found" (exit 127).
        printk_set_level(PRINTK_LEVEL_ERR)
        printk1("elf64: OOM - OUT OF MEMORY: no contiguous region of %d bytes for the image\n",
                file_hi_rel)
        elf_last_load_oom = 1
        return 0
    # SMAP (#120): the loader zero-fills + copies segment bytes into
    # `region` by its IDENTITY vaddr. region_alloc's backing intermittently
    # aliases a page whose leaf PTE carries US=1 (the ET_DYN↔direct-map
    # aliasing hazard — a freed user image's RAM recycled for this load).
    # A CPL=0 write to a US=1 page #PF's under CR4.SMAP unless RFLAGS.AC is
    # set, so an unbracketed memset/memcpy here faulted `[pf] kernel write
    # to RO user page` (pte …027 = P|RW|US, err=0x3) on ~55% of cold boots
    # — SIGSEGV'ing the loaded process (getty/motd) and cascading into a
    # bare DE. Bracket the loader's own writes with STAC/CLAC exactly like
    # the COW-copy path (elf.ad:3436) and the coredump snapshot; the writes
    # are the loader populating memory it owns, so this is correct, not a
    # policy hole. No-op with SMAP off.
    _elf_memset_serviced(region, file_hi_rel)

    i = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        if p_type == PT_LOAD:
            p_offset: uint64 = _read_u64(cast[Ptr[uint8]](ph + 8))
            p_vaddr:  uint64 = _read_u64(cast[Ptr[uint8]](ph + 16))
            p_filesz: uint64 = _read_u64(cast[Ptr[uint8]](ph + 32))
            p_memsz:  uint64 = _read_u64(cast[Ptr[uint8]](ph + 40))
            dst: uint64 = region + (p_vaddr - lowest_v)
            src: uint64 = cast[uint64](blob) + p_offset
            _elf_memcpy_serviced(dst, src, p_filesz)
            printk2("elf64:   PT_LOAD vaddr=0x%x size=%d\n",
                    p_vaddr, p_memsz)
        i = i + 1

    # U20: no PT_DYNAMIC walk, no .rela.* application. glibc / musl
    # _start handles its own relocations via _dl_relocate_static_pie
    # using AT_PHDR / AT_PHNUM / AT_BASE from auxv (populated by the
    # SYS_EXECVE / SYS_SPAWN caller).
    elf_last_phoff     = e_phoff
    elf_last_phnum     = e_phnum

    # U30: ET_EXEC binaries (e_type == 2) ship with absolute addresses
    # baked into .text / .got. They expect to run at their link-time
    # vaddr (lowest_v). Stash the user vaddr range + physical backing
    # so the caller (SYS_SPAWN / SYS_EXECVE) can install a per-task
    # mapping AFTER it knows the target task's PML4. For ET_DYN (PIE)
    # we keep the legacy rebase-to-region behaviour — the binary is
    # position-independent and runs fine at the identity-mapped region
    # address.
    #
    # U42: PT_INTERP handling runs at the very end of the load — AFTER
    # the application's segments are in place but BEFORE we commit the
    # globals + return. Two phases interleave:
    #
    #   (a) load the interpreter into a SEPARATE memblock region (the
    #       recursive _load_elf64 call below); save its load base +
    #       entry into elf_last_interp_base / a local interp_entry.
    #   (b) restore the application's elf_last_* globals (the recursion
    #       trampled them, since they're file-scope) and return the
    #       INTERPRETER's entry as the user-mode RIP. ld.so's _start
    #       walks the app's PT_DYNAMIC from userspace and jumps to
    #       the app's e_entry once relocations + DT_NEEDED resolution
    #       are done.
    #
    # For static binaries (no PT_INTERP) the load is unchanged — same
    # code path the U18..U22 / U27 / U40 / U41 fixtures already use.
    app_entry_user: uint64 = 0
    app_load_base:  uint64 = 0
    app_needs_map:  int32  = 0
    app_user_vlow:  uint64 = 0
    app_user_vhigh: uint64 = 0
    app_user_phys:  uint64 = 0
    # Whole-image virtual span, page-aligned, for fork's address-space
    # copy. `span` is already 4 KiB-rounded above.
    app_img_lo: uint64 = 0
    app_img_hi: uint64 = 0
    # DEMAND-BSS: the app's demand-zero BSS tail in USER vaddr space.
    # [app_bss_lo, app_bss_hi) = [load_base+file_hi_rel, load_base+mem_hi_rel).
    # Zero (lo == hi) when there is no tail above the file extent.
    app_bss_lo: uint64 = 0
    app_bss_hi: uint64 = 0
    # M16.36: per-task PT-entry installation regardless of e_type.
    # The PT_LOAD region must be wired into the user's PML4 explicitly
    # so the user task no longer depends on the BSP's inherited 1 GiB
    # identity stamp (which on real hardware can still resolve to the
    # right bytes — vaddr=phys — but only because the boot-stub /
    # _pgtable_force_stamp_1gb identity-stamped every PDPT entry; a
    # future Plan-9 lower-half scrub will tear that out and we want
    # the user binary to keep working).
    if e_type == cast[uint32](ELF_ET_EXEC):
        app_needs_map  = 1
        # DEMAND-BSS: the eager user mapping + COW image span cover only
        # the file-backed extent [lowest_v, lowest_v+file_hi_rel). The
        # BSS tail [lowest_v+file_hi_rel, lowest_v+mem_hi_rel) is a
        # demand-zero VMA the caller registers.
        app_user_vlow  = lowest_v
        app_user_vhigh = lowest_v + file_hi_rel
        app_user_phys  = region
        app_load_base  = lowest_v
        app_entry_user = e_entry
        app_img_lo     = lowest_v
        app_img_hi     = lowest_v + file_hi_rel
        if mem_hi_rel > file_hi_rel:
            app_bss_lo = lowest_v + file_hi_rel
            app_bss_hi = lowest_v + mem_hi_rel
        printk2("elf64: ET_EXEC user-map: [0x%x, 0x%x)\n",
                lowest_v, lowest_v + file_hi_rel)
        printk2("elf64: ET_EXEC bss-demand: [0x%x, 0x%x)\n",
                app_bss_lo, app_bss_hi)
    else:
        # U52 load-bias ASLR: an ET_DYN image runs at a randomized VIRTUAL
        # base (dyn_vbase) chosen per-exec by the caller, INDEPENDENT of its
        # physical backing `region`. The user vaddr range becomes
        # [dyn_vbase, dyn_vbase + span) while the physical pages stay at
        # [region, region + span) — a genuine vaddr != phys mapping that
        # elf_install_user_range lays down (it computes target_phys =
        # phys_base + (vaddr - vlow), so passing phys_base = region with
        # vlow = dyn_vbase translates correctly). dyn_vbase == 0 means
        # "no bias" -> identity at `region` (the pre-U52 / deterministic
        # layout). The interpreter recursion uses its own slot.
        dyn_vbase: uint64 = elf_aslr_app_vbase
        if _in_interp_load != 0:
            dyn_vbase = elf_aslr_interp_vbase
        if dyn_vbase == 0:
            dyn_vbase = region
        app_load_base  = dyn_vbase
        app_entry_user = dyn_vbase + (e_entry - lowest_v)
        # DEMAND-BSS: ET_DYN occupies [dyn_vbase, dyn_vbase + file_hi_rel)
        # eagerly (file-backed), with the BSS tail
        # [dyn_vbase+file_hi_rel, dyn_vbase+mem_hi_rel) demand-zero. Both
        # ranges are in the user's vaddr space (dyn_vbase-relative); the
        # eager extent is backed by physical [region, region+file_hi_rel).
        app_needs_map  = 1
        app_user_vlow  = dyn_vbase
        app_user_vhigh = dyn_vbase + file_hi_rel
        app_user_phys  = region
        app_img_lo     = dyn_vbase
        app_img_hi     = dyn_vbase + file_hi_rel
        if mem_hi_rel > file_hi_rel:
            app_bss_lo = dyn_vbase + file_hi_rel
            app_bss_hi = dyn_vbase + mem_hi_rel
        printk2("elf64: ET_DYN user-map: [0x%x, 0x%x)\n",
                dyn_vbase, dyn_vbase + file_hi_rel)
        printk2("elf64: ET_DYN phys backing: [0x%x, 0x%x)\n",
                region, region + file_hi_rel)
        printk2("elf64: ET_DYN bss-demand: [0x%x, 0x%x)\n",
                app_bss_lo, app_bss_hi)
        # NATIVE PIE: apply R_X86_64_RELATIVE now that the load base is
        # decided. Must run AFTER the PT_LOAD copy into `region` (there would
        # be nothing to patch before it) and BEFORE the W^X read-only flip the
        # installer does. The targets live in .data.rel.ro / .got, which are in
        # the RW segment, so the RO flip never covers them — but the ordering
        # is load-bearing regardless and is why this sits here and not in the
        # caller.
        #
        # A Linux static-PIE reaching this path self-relocates from userspace
        # (_dl_relocate_static_pie via auxv) and its relocations are of kinds
        # this applier rejects. Only apply for NATIVE images; elf_last_was_linux
        # is not set yet here, so gate on the same signal elf_is_linux_binary
        # uses (OSABI + PT_INTERP), which is already decided by the header.
        if elf_is_linux_binary(blob) == 0:
            # The bias is dyn_vbase - lowest_v, matching app_entry_user's own
            # rebase above. It equals dyn_vbase for the base-0 PIE the native
            # lane emits, but spelling it out keeps a nonzero-based PIE correct.
            if _elf64_apply_relative_relocs(blob, blob_size, e_phoff,
                                            e_phentsize, e_phnum, lowest_v,
                                            region, file_hi_rel,
                                            dyn_vbase - lowest_v) != 0:
                printk0("elf64: ET_DYN relocation failed - refusing the load\n")
                region_free(region, file_hi_rel)
                return 0
    # W^X Stage 1b: record this image's non-writable (.text/.rodata)
    # PT_LOAD spans in elf_last_app_ro_* so the installer can flip them
    # READ-ONLY after the whole image is mapped RW. app_load_base is the
    # user-vaddr base (lowest_v for ET_EXEC; region for ET_DYN).
    _collect_app_ro_spans(blob, e_phoff, e_phentsize, e_phnum,
                          lowest_v, app_load_base)

    # M16.36: stash the app's PT_LOAD coords so do_execve / SYS_SPAWN
    # can install per-task PT entries explicitly. These survive the
    # PT_INTERP recursion (it touches the elf_last_user_* slots).
    app_phys_capture: uint64 = region
    app_vlow_capture: uint64 = app_user_vlow
    app_vhigh_capture: uint64 = app_user_vhigh
    # DEMAND-BSS: capture the app's demand BSS tail so it survives the
    # PT_INTERP recursion (which trashes the elf_last_* globals). The
    # interpreter load never sets a BSS tail (file_hi_rel forced to span
    # for _in_interp_load), so the recursion leaves these locals as the
    # app's own values to publish at the same place app_img_* are.
    app_bss_lo_capture: uint64 = app_bss_lo
    app_bss_hi_capture: uint64 = app_bss_hi
    if e_type == cast[uint32](ELF_ET_EXEC):
        # ET_EXEC's PT_LOADs land at lowest_v..lowest_v+span; the
        # underlying physical pages are at `region` (the memblock chunk
        # the loader copied into).
        app_phys_capture = region
        app_vlow_capture = lowest_v
        app_vhigh_capture = lowest_v + span
    else:
        # U52: ET_DYN runs at the (possibly randomized) dyn_vbase recorded
        # in app_user_vlow/vhigh; physical backing stays at `region`.
        app_phys_capture = region
        app_vlow_capture = app_user_vlow
        app_vhigh_capture = app_user_vhigh

    # PT_INTERP: dynamic ELF. Recursively load the interpreter and
    # return its entry as the user-mode RIP. Only honoured at the
    # top level (_in_interp_load == 0) — if we somehow find a nested
    # PT_INTERP inside ld.so itself we ignore it and treat ld.so as
    # a plain ET_DYN.
    interp_phdr: uint64 = _find_pt_interp(blob)
    if interp_phdr != 0 and _in_interp_load == 0:
        # LIFETIME: `blob` is a BORROWED pointer from ns_blob_ptr's
        # single-entry cache. _load_interp_elf's own ns_blob_ptr(ld.so)
        # call REPLACES that cache entry and kfrees the app blob (when
        # it was an owned ext4/tmpfs load). So nothing below the
        # recursive call may dereference `blob`. Snapshot the app's
        # W^X RO spans (collected from the live blob above) NOW so the
        # post-recursion code can restore them without re-walking the
        # freed file image.
        app_ro_n_save:  uint64 = elf_last_app_ro_n
        app_ro_lo_save: Array[8, uint64]
        app_ro_hi_save: Array[8, uint64]
        rs: uint64 = 0
        while rs < ELF_MAX_RO_SPANS:
            app_ro_lo_save[rs] = elf_last_app_ro_lo[rs]
            app_ro_hi_save[rs] = elf_last_app_ro_hi[rs]
            rs = rs + 1
        interp_entry: uint64 = _load_interp_elf(blob, interp_phdr)
        if interp_entry == 0:
            # Couldn't open / load the interpreter. Don't try to run
            # the binary unrelocated — that would page-fault on the
            # first PLT lookup. Return 0 to make execve fail cleanly
            # with -ENOEXEC.
            printk0("elf64: PT_INTERP load failed\n")
            return 0
        # The recursion overwrote elf_last_* with the interpreter's
        # values. Capture the interpreter's per-task-install coords
        # (region/span) BEFORE re-publishing the application's, so the
        # caller can install per-task PTEs for BOTH images. The
        # interpreter was loaded as ET_DYN, so its [vlow, vhigh) was
        # set to [region, region+span) by the static-path tail of the
        # recursive call — elf_last_user_vlow / vhigh / phys_base hold
        # those values right now.
        interp_phys_capture:  uint64 = elf_last_user_phys_base
        interp_vlow_capture:  uint64 = elf_last_user_vlow
        interp_vhigh_capture: uint64 = elf_last_user_vhigh
        # W^X Stage 1b: the recursive load left the INTERPRETER's
        # non-writable spans in elf_last_app_ro_*. Move them into the
        # interp slots, then restore the APP's own spans from the
        # pre-recursion snapshot. (Pre-fix this re-ran
        # _collect_app_ro_spans(blob, ...) here — a use-after-free:
        # the interp's ns_blob_ptr load already kfreed `blob` when it
        # was a cache-owned ext4/tmpfs image, so the re-walk parsed
        # whatever kmalloc reuse left behind and could record bogus
        # RO spans.)
        elf_last_interp_ro_n = elf_last_app_ro_n
        ri: uint64 = 0
        while ri < ELF_MAX_RO_SPANS:
            elf_last_interp_ro_lo[ri] = elf_last_app_ro_lo[ri]
            elf_last_interp_ro_hi[ri] = elf_last_app_ro_hi[ri]
            ri = ri + 1
        elf_last_app_ro_n = app_ro_n_save
        ri = 0
        while ri < ELF_MAX_RO_SPANS:
            elf_last_app_ro_lo[ri] = app_ro_lo_save[ri]
            elf_last_app_ro_hi[ri] = app_ro_hi_save[ri]
            ri = ri + 1
        # Re-publish the APPLICATION's values so AT_PHDR / AT_PHNUM /
        # AT_PHENT in the auxv reflect the app (which is what glibc's
        # dl_main wants — it reads the app's headers to walk the app's
        # PT_DYNAMIC). elf_last_interp_base remains set by
        # _load_interp_elf — the auxv builder reads it for AT_BASE.
        elf_last_phoff           = e_phoff
        elf_last_phnum           = e_phnum
        elf_last_load_base       = app_load_base
        elf_last_needs_user_map  = app_needs_map
        elf_last_user_vlow       = app_user_vlow
        elf_last_user_vhigh      = app_user_vhigh
        elf_last_user_phys_base  = app_user_phys
        elf_last_app_entry_user  = app_entry_user
        elf_last_img_lo          = app_img_lo
        elf_last_img_hi          = app_img_hi
        # M16.36: publish per-task PT-install coords for BOTH images.
        elf_last_app_img_phys    = app_phys_capture
        elf_last_app_img_vlow    = app_vlow_capture
        elf_last_app_img_vhigh   = app_vhigh_capture
        # DEMAND-BSS: publish the app's demand BSS tail (the interp
        # recursion never set one — it forces file_hi_rel == span).
        elf_last_app_bss_lo      = app_bss_lo_capture
        elf_last_app_bss_hi      = app_bss_hi_capture
        elf_last_interp_img_phys = interp_phys_capture
        elf_last_interp_img_vlow = interp_vlow_capture
        elf_last_interp_img_vhigh = interp_vhigh_capture
        # WARN level so the line survives the post-interactive console
        # loglevel gate (early_8250 tightens to INFO once userland is
        # interactive). This is a load-bearing loader marker — the
        # dynamic-forkexec/apt tests grep for it to prove the PT_INTERP
        # arm fired; gating it post-interactive would silently blind them.
        printk_set_level(PRINTK_LEVEL_WARN)
        printk2("elf64: dynamic load: interp_base=0x%x interp_entry=0x%x\n",
                elf_last_interp_base, interp_entry)
        return interp_entry

    # Static path (no PT_INTERP, or we're *being* loaded as an
    # interpreter ourselves). Same end-state the pre-U42 loader
    # reached — elf_last_interp_base stays 0 to signal "no dyn
    # linker", elf_last_app_entry_user mirrors the return value so
    # auxv AT_ENTRY reads the same thing as the user RIP.
    elf_last_interp_base    = 0
    elf_last_app_entry_user = app_entry_user
    elf_last_load_base      = app_load_base
    elf_last_needs_user_map = app_needs_map
    elf_last_user_vlow      = app_user_vlow
    elf_last_user_vhigh     = app_user_vhigh
    elf_last_user_phys_base = app_user_phys
    elf_last_img_lo         = app_img_lo
    elf_last_img_hi         = app_img_hi
    # M16.36: per-task PT-install coords for the app's PT_LOAD span.
    # No interpreter on this path — leave the interp_img_* globals as
    # the caller (or zero) left them. NOTE: when this _load_elf64 was
    # called recursively from _load_interp_elf, _in_interp_load == 1
    # — we still set elf_last_app_img_* here, but the OUTER call's
    # PT_INTERP arm above will capture them as `interp_*` and then
    # overwrite app_img_* with the real application's values. So a
    # nested call's writes here are intentionally observable to the
    # outer call and are not stale.
    elf_last_app_img_phys   = app_phys_capture
    elf_last_app_img_vlow   = app_vlow_capture
    elf_last_app_img_vhigh  = app_vhigh_capture
    # DEMAND-BSS: on the static path the app IS this load — publish its
    # demand BSS tail. When _in_interp_load (we are the interpreter), the
    # tail is always 0 (file_hi_rel forced to span); the OUTER call's
    # PT_INTERP arm overwrites these with the real app's captured values.
    elf_last_app_bss_lo     = app_bss_lo_capture
    elf_last_app_bss_hi     = app_bss_hi_capture
    if _in_interp_load == 0:
        # Top-level static load: no interpreter to install.
        elf_last_interp_img_phys  = 0
        elf_last_interp_img_vlow  = 0
        elf_last_interp_img_vhigh = 0
        # W^X Stage 1b: no interpreter -> no interp RO spans to flip.
        elf_last_interp_ro_n = 0
    return app_entry_user


# ---------------------------------------------------------------------
# U42: interpreter load helper
# ---------------------------------------------------------------------
# Reads PT_INTERP's payload string out of the application ELF, opens
# the named interpreter binary via initramfs_data_ptr, and recursively
# invokes _load_elf64 on it. Returns the interpreter's user-mode entry
# address (= its rebased e_entry) or 0 on failure.
#
# As a side effect, elf_last_interp_base is populated with the
# interpreter's load region (the kernel-chosen memblock base) so the
# caller's auxv-builder can plant it in AT_BASE.

def _load_interp_elf(app_blob: Ptr[uint8],
                     interp_phdr: uint64) -> uint64:
    # Read the interpreter path string. PT_INTERP's p_offset/p_filesz
    # describe a NUL-terminated path in the file. Real Linux dynamic
    # binaries put e.g. "/lib64/ld-linux-x86-64.so.2\0" here.
    p_offset: uint64 = _read_u64(cast[Ptr[uint8]](interp_phdr + 8))
    p_filesz: uint64 = _read_u64(cast[Ptr[uint8]](interp_phdr + 32))
    if p_filesz == 0 or p_filesz > 255:
        printk0("elf64: PT_INTERP path bogus (length OOB)\n")
        return 0

    # Stage the path in a stack buffer so initramfs_data_ptr can
    # consume a NUL-terminated string. The PT_INTERP segment is
    # already NUL-terminated in well-formed binaries, but we copy
    # rather than alias because the file blob lives in initramfs
    # .rodata and pointer-aliasing into it for a cstring is fragile.
    interp_path: Array[256, uint8]
    src: uint64 = cast[uint64](app_blob) + p_offset
    n: uint64 = p_filesz
    if n > 255:
        n = 255
    i: uint64 = 0
    while i < n:
        interp_path[i] = cast[Ptr[uint8]](src + i)[0]
        i = i + 1
    # Guarantee NUL even if p_filesz lied.
    interp_path[n] = 0

    printk_set_level(PRINTK_LEVEL_WARN)
    printk1("elf64: PT_INTERP='%s'\n",
            cast[uint64](&interp_path[0]))

    # §4: look the interpreter up THROUGH THE CALLING PROCESS'S
    # NAMESPACE. The path is taken verbatim from PT_INTERP — typically
    # "/lib64/ld-linux-x86-64.so.2" on Debian/Ubuntu, "/lib/ld-musl-
    # x86_64.so.1" on Alpine. ns_blob_ptr runs it through resolve_path,
    # so ns_walk's longest-prefix mount-table rewrite
    # applies: a binary execve'd inside a distrorun distro-shape
    # namespace (which did `bind("/lib", backing/lib)` /
    # `bind("/usr", backing/usr)`) finds its ld.so in the distro tree;
    # a native process resolves the canonical path verbatim because
    # resolve_path is a no-op rewrite with no matching mount entry.
    # Plan 9-correct: there is no global filesystem route — the
    # interpreter resolves per-namespace, not per a hardcoded path.
    interp_blob: uint64 = ns_blob_ptr(
        cast[Ptr[char]](&interp_path[0]))
    if interp_blob == 0:
        printk1("elf64: interpreter '%s' not in namespace\n",
                cast[uint64](&interp_path[0]))
        return 0
    interp_size: uint64 = ns_blob_size(
        cast[Ptr[char]](&interp_path[0]))

    # Recursive load. _in_interp_load gates PT_INTERP processing
    # inside the nested call so ld.so itself isn't asked to recurse
    # on its own (typically non-existent) PT_INTERP.
    _in_interp_load = 1
    interp_entry: uint64 = _load_elf64(
        cast[Ptr[uint8]](interp_blob), interp_size)
    _in_interp_load = 0
    if interp_entry == 0:
        printk0("elf64: failed to load interpreter image\n")
        return 0

    # _load_elf64's static-path tail set elf_last_load_base to the
    # interpreter's region (its memblock base). Capture that as the
    # AT_BASE value the auxv builder will plant. We then overwrite
    # elf_last_load_base back to the application's base in the
    # caller (_load_elf64's PT_INTERP arm above) so AT_PHDR remains
    # anchored at the application's program headers.
    elf_last_interp_base = elf_last_load_base
    return interp_entry


def elf_eager_region_bytes(blob: Ptr[uint8], blob_size: uint64) -> uint64:
    # #112 execve OOM PRE-CHECK helper. Returns the byte size of the EAGER
    # contiguous region_alloc that elf_load_blob would request for the
    # TOP-LEVEL application image — WITHOUT allocating anything. do_execve
    # feeds this to region_can_alloc() BEFORE it tears the outgoing COW image
    # down, so an image whose contiguous load would OOM past the point-of-no-
    # return is rejected while the caller is still fully mapped.
    #
    # Mirrors the FIRST PASS of _load_elf64 / the ELF32 path exactly:
    #   ELF64: file_hi_rel = round_up(max(p_vaddr+p_filesz)) - lowest_v  (the
    #          demand-BSS split: only the file-backed extent is eager).
    #   ELF32: span = round_up(max(p_vaddr+p_memsz) - lowest_v)  (no split).
    # Returns 0 when the size can't be determined (bad header / no PT_LOAD /
    # Linux-detected but malformed) — the caller then SKIPS the pre-check and
    # falls through to the normal load, so this never converts a loadable
    # binary into a false OOM. The interpreter (ld.so) region is intentionally
    # NOT summed here: it is small and loads AFTER the app region succeeds; the
    # dominant OOM driver is the large application image (#112 diagnosis).
    if blob_size < 52:
        return 0
    if _validate_magic(blob) == 0:
        return 0
    ei_class: uint8 = blob[4]
    if ei_class == 2:
        if blob_size < 64:
            return 0
        e_phoff: uint64 = _read_u64(cast[Ptr[uint8]](cast[uint64](blob) + 32))
        e_phentsize: uint32 = _read_u16(cast[Ptr[uint8]](cast[uint64](blob) + 54))
        e_phnum: uint32 = _read_u16(cast[Ptr[uint8]](cast[uint64](blob) + 56))
        lowest_v: uint64 = 0xFFFFFFFFFFFFFFFF
        highest_file_v: uint64 = 0
        i: uint32 = 0
        while i < e_phnum:
            ph: uint64 = cast[uint64](blob) + e_phoff \
                        + cast[uint64](i) * cast[uint64](e_phentsize)
            p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
            if p_type == PT_LOAD:
                p_vaddr: uint64 = _read_u64(cast[Ptr[uint8]](ph + 16))
                p_filesz0: uint64 = _read_u64(cast[Ptr[uint8]](ph + 32))
                if p_vaddr < lowest_v:
                    lowest_v = p_vaddr
                if p_vaddr + p_filesz0 > highest_file_v:
                    highest_file_v = p_vaddr + p_filesz0
            i = i + 1
        if highest_file_v == 0 or lowest_v == 0xFFFFFFFFFFFFFFFF:
            return 0
        file_hi_rel: uint64 = highest_file_v - lowest_v
        file_hi_rel = (file_hi_rel + 4095) & ~cast[uint64](4095)
        return file_hi_rel
    e_phoff32: uint32 = _read_u32(cast[Ptr[uint8]](cast[uint64](blob) + 28))
    e_phentsize32: uint32 = _read_u16(cast[Ptr[uint8]](cast[uint64](blob) + 42))
    e_phnum32: uint32 = _read_u16(cast[Ptr[uint8]](cast[uint64](blob) + 44))
    lowest_v32: uint32 = 0xFFFFFFFF
    highest_v32: uint32 = 0
    j: uint32 = 0
    while j < e_phnum32:
        ph2: uint64 = cast[uint64](blob) + cast[uint64](e_phoff32) \
                    + cast[uint64](j) * cast[uint64](e_phentsize32)
        p_type2: uint32 = _read_u32(cast[Ptr[uint8]](ph2 + 0))
        if p_type2 == PT_LOAD:
            p_vaddr2: uint32 = _read_u32(cast[Ptr[uint8]](ph2 + 8))
            p_memsz2: uint32 = _read_u32(cast[Ptr[uint8]](ph2 + 20))
            if p_vaddr2 < lowest_v32:
                lowest_v32 = p_vaddr2
            if p_vaddr2 + p_memsz2 > highest_v32:
                highest_v32 = p_vaddr2 + p_memsz2
        j = j + 1
    if highest_v32 == 0:
        return 0
    span32: uint64 = cast[uint64](highest_v32) - cast[uint64](lowest_v32)
    span32 = (span32 + 4095) & ~cast[uint64](4095)
    return span32


# --- POINTER-LATENCY SERVICE FOR THE LOADER'S BULK COPIES ------------------
#
# execve loads an image by zero-filling its whole span and then memcpy'ing each
# PT_LOAD segment. Those are single multi-megabyte calls, and the whole syscall
# runs with EFLAGS.IF clear (IA32_FMASK = 0x0200, and nothing in
# arch/x86/kernel/syscall_64.S re-enables it) — so the timer IRQ, the ONLY
# thing that services the mouse and moves the cursor, cannot fire until the
# image is fully loaded. Measured on the shipped image (ptrlat instrument,
# TCG boot): SYS_EXECVE = 241,000-305,000 us of completely dead pointer, once
# per app or command launch. That is the "mouse freezes when something is busy"
# the user reported.
#
# MEASUREMENT CAVEAT (re-measured 2026-07-29, do not drop this). The
# 241,000-305,000 us figures above were taken under TCG, which inflates syscall
# duration by roughly one to two orders of magnitude. Re-measured on the
# shipped .img under UEFI/OVMF + KVM with four 100%-CPU hogs plus an
# execve/ELF-load storm, the worst pointer-service gap is ~10-14 ms WITH THIS
# SERVICE DISABLED -- i.e. one 100 Hz tick period, and indistinguishable from
# having it enabled. On that path no single IRQ-off region lasts long enough to
# drop a tick, so this seam is reached (measured ~118 times per storm) but is
# not what keeps the pointer smooth. It is retained because the MECHANISM is
# real and does bite elsewhere -- a ~2.3 s SYS_WRITE stall reproduces on every
# boot, before the rl5 flip -- and because real disks wait far longer in
# virtq_kick_and_wait than this RAM-backed virtio image does. Its benefit on
# metal is PLAUSIBLE BUT UNPROVEN. See scripts/test_pointer_latency_under_load.sh.
#
# Fix: do the same bytes in bounded chunks and service the pointer between
# them (sys/src/9/port/devmouse.ad::pointer_service_poll — itself rate-limited
# to <=125 Hz, so a small image pays one predicted branch per chunk and nothing
# else). STAC/CLAC is re-taken per chunk so the SMAP bracket still covers
# exactly the loader's own writes and the service call runs outside it.
ELF_LOAD_SERVICE_CHUNK: uint64 = 262144          # 256 KiB


def _elf_memset_serviced(dst: uint64, n: uint64):
    off: uint64 = 0
    while off < n:
        c: uint64 = n - off
        if c > ELF_LOAD_SERVICE_CHUNK:
            c = ELF_LOAD_SERVICE_CHUNK
        _ua_stac()
        memset(cast[Ptr[uint8]](dst + off), 0, c)
        _ua_clac()
        off = off + c
        pointer_service_poll()


def _elf_memcpy_serviced(dst: uint64, src: uint64, n: uint64):
    off: uint64 = 0
    while off < n:
        c: uint64 = n - off
        if c > ELF_LOAD_SERVICE_CHUNK:
            c = ELF_LOAD_SERVICE_CHUNK
        _ua_stac()
        memcpy(cast[Ptr[uint8]](dst + off), cast[Ptr[uint8]](src + off), c)
        _ua_clac()
        off = off + c
        pointer_service_poll()


def elf_load_blob(blob: Ptr[uint8], blob_size: uint64) -> uint64:
    # Returns the entry virtual address (= allocated base + entry
    # offset), or 0 on parse error / OOM.
    if blob_size < 52:
        printk0("elf: blob too small for ELF32 header\n")
        return 0
    if _validate_magic(blob) == 0:
        printk0("elf: bad magic\n")
        return 0

    # Dispatch on EI_CLASS (e_ident[4]): 1 = ELFCLASS32 (Hamnix's own
    # compiler wrapper), 2 = ELFCLASS64 (real Linux x86_64). Both paths
    # share the U3 Linux-ABI detection tail below.
    elf_last_was_linux = 0
    # #106: clear the OOM flag so a prior load's OOM never leaks into this
    # one; a region_alloc() failure below re-raises it for the caller.
    elf_last_load_oom = 0
    ei_class: uint8 = blob[4]
    if ei_class == 2:
        # LIFETIME: sniff the Linux-ABI marker BEFORE _load_elf64 —
        # the PT_INTERP recursion inside it replaces ns_blob_ptr's
        # single-entry cache (kfree'ing `blob` when it was an owned
        # ext4/tmpfs image), so `blob` must not be read after the call.
        was_linux: int32 = elf_is_linux_binary(blob)
        entry64: uint64 = _load_elf64(blob, blob_size)
        if entry64 != 0:
            if was_linux != 0:
                elf_last_was_linux = 1
                printk_set_level(PRINTK_LEVEL_WARN)
                printk0("elf: Linux-ABI binary detected; child task will route syscalls via u_syscalls\n")
            else:
                # NATIVE ELF64: an ELFCLASS64 image with OSABI=SYSV(0) and no
                # PT_INTERP (elf_is_linux_binary == 0). This is the LLVM
                # backend's native-binary format (scripts/adder_cc_llvm_
                # native64.sh) — a real ELF64 EXEC that carries the Hamnix
                # native syscall ABI (rax=num), NOT glibc. elf_last_was_linux
                # stays 0, so do_execve keeps this task on the NATIVE syscall
                # dispatcher and the native argc/argv register handoff
                # (_build_user_argv), exactly like a native ELF32 image. The
                # only difference from the ELF32 wrapper is the class/machine
                # in the header; every downstream path (ET_EXEC user-map,
                # demand-BSS, W^X RO spans) is class-agnostic.
                printk0("elf: native ELF64 (OSABI=SYSV, no PT_INTERP) -> native syscall ABI\n")
        return entry64

    e_entry: uint32 = _read_u32(cast[Ptr[uint8]](
        cast[uint64](blob) + 24))
    e_phoff: uint32 = _read_u32(cast[Ptr[uint8]](
        cast[uint64](blob) + 28))
    e_phentsize: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](blob) + 42))
    e_phnum: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](blob) + 44))

    printk2("elf: entry=0x%x phnum=%d\n",
            cast[uint64](e_entry), cast[uint64](e_phnum))

    # First pass: find the lowest and highest vaddr across PT_LOAD
    # segments so we can size the single allocation. lowest_v is
    # pre-seeded to UINT32_MAX; Adder's `<` honours operand signedness
    # (both sides are uint32 here), so the first PT_LOAD always wins
    # the unsigned compare.
    lowest_v:  uint32 = 0xFFFFFFFF
    highest_v: uint32 = 0
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) \
                    + cast[uint64](e_phoff) \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        if p_type == PT_LOAD:
            p_vaddr: uint32 = _read_u32(cast[Ptr[uint8]](ph + 8))
            p_memsz: uint32 = _read_u32(cast[Ptr[uint8]](ph + 20))
            if p_vaddr < lowest_v:
                lowest_v = p_vaddr
            if p_vaddr + p_memsz > highest_v:
                highest_v = p_vaddr + p_memsz
        i = i + 1

    if highest_v == 0:
        printk0("elf: no PT_LOAD segments\n")
        return 0

    span: uint64 = cast[uint64](highest_v) - cast[uint64](lowest_v)
    # Round up to a page so the load region is page-aligned.
    span = (span + 4095) & ~cast[uint64](4095)
    # NOTE (DEMAND-BSS 2026-06-23): the ELF32 native path is NOT split into
    # an eager-file + demand-BSS tail like the ELF64 path. ELF32 native
    # binaries run IDENTITY-MAPPED (vaddr == phys == region) at low RAM, so
    # a demand-BSS range [region+file_hi, region+mem_hi) would ALIAS the
    # kernel direct map: region_alloc later hands that same physical RAM to
    # the next image, and the loader's identity-vaddr memset of it would
    # fault NOT-PRESENT (the demand prep cracked those identity PTEs). This
    # is the ET_DYN↔direct-map aliasing hazard. The ELF32 image keeps the
    # eager full-span region; the DE-OOM fix lives in the ELF64 loader,
    # which is enough (verified: panels + apps render under -m 1G).
    # Freeable region (see the ELF64 path): task_reap reclaims it so
    # native ELF32 spawns recycle their backing instead of leaking it.
    # Same as the ELF64 path above: name the execve'ing task so arms 1/19
    # have a real owner to adjudicate against.
    pa_set_owner(current_idx_get())
    region: uint64 = region_alloc(span)
    if region == 0:
        printk_set_level(PRINTK_LEVEL_ERR)
        printk1("elf: OOM - OUT OF MEMORY: no contiguous region of %d bytes for the image\n",
                span)
        elf_last_load_oom = 1
        return 0
    # Zero the whole region so any p_memsz > p_filesz gap is .bss-zero'd.
    # SMAP (#120): same US=1-aliasing hazard as the ELF64 path above — this
    # is the loader site the crash-sweep pinned (memset+0x8 called from
    # elf_load_blob, pte …027 = P|RW|US). Bracket the write with STAC/CLAC
    # so a region that aliases a US=1 page does not #PF under CR4.SMAP.
    _elf_memset_serviced(region, span)

    # Second pass: copy each PT_LOAD segment.
    i = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](blob) \
                    + cast[uint64](e_phoff) \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        if p_type == PT_LOAD:
            p_offset: uint32 = _read_u32(cast[Ptr[uint8]](ph + 4))
            p_vaddr:  uint32 = _read_u32(cast[Ptr[uint8]](ph + 8))
            p_filesz: uint32 = _read_u32(cast[Ptr[uint8]](ph + 16))
            p_memsz:  uint32 = _read_u32(cast[Ptr[uint8]](ph + 20))
            dst: uint64 = region + cast[uint64](p_vaddr - lowest_v)
            src: uint64 = cast[uint64](blob) + cast[uint64](p_offset)
            _elf_memcpy_serviced(dst, src, cast[uint64](p_filesz))
            printk2("elf:   PT_LOAD vaddr=0x%x size=%d (copied + zero-pad)\n",
                    cast[uint64](p_vaddr), cast[uint64](p_memsz))
        i = i + 1

    elf_last_load_base = region
    # Native ELF32 binaries don't ever consume auxv (the SysV %rdi/%rsi
    # path is used for argc/argv), but keep the globals consistent so
    # an accidental Linux-flag dispatch on an ELF32 binary doesn't see
    # stale ELF64 values from a previous load.
    elf_last_phoff     = cast[uint64](e_phoff)
    elf_last_phnum     = e_phnum
    entry_real: uint64 = region + cast[uint64](e_entry - lowest_v)
    # U42: ELF32 path never has a dynamic linker. Pin interp_base = 0
    # so a previous dynamic ELF64 load doesn't leak into a subsequent
    # native ELF32 boot's auxv (auxv is Linux-only and ELF32 native
    # binaries don't consume it, but the auxv builder reads these
    # globals unconditionally — keep them tidy).
    elf_last_interp_base    = 0
    elf_last_app_entry_user = entry_real

    # Per-process address space (fork): record the page-aligned virtual
    # span of the loaded ELF32 image so do_execve stashes it on the
    # task and fork (do_clone / do_rfork) can COW-share the image's
    # writable .data / .bss between parent and child. A native ELF32
    # binary runs identity-mapped at `region` (same as an ET_DYN
    # ELF64), so the image occupies [region, region + span). `span` is
    # already 4 KiB-rounded. Before this, ELF32 left these globals at 0
    # and fork skipped the image entirely — a native binary that wrote
    # a global after fork() corrupted its parent. COW now covers it.
    elf_last_img_lo = region
    elf_last_img_hi = region + span

    # M16.36: per-task PT-entry install for the native ELF32 image.
    # ELF32 native binaries link at vaddr 0 (user/init.lds) and the
    # loader rebases them to `region`. vaddr == phys after the rebase
    # — the same identity-stamp shape ET_DYN ELF64 binaries use. As
    # of M16.36 we install per-task PTEs for this span explicitly
    # (cracking the BSP's inherited 1 GiB PS=1 stamp) so the user
    # task no longer depends on the shared identity entry. See the
    # elf_last_app_img_* globals' comment for the motivation.
    elf_last_needs_user_map = 1
    elf_last_user_vlow      = region
    elf_last_user_vhigh     = region + span
    elf_last_user_phys_base = region
    elf_last_app_img_phys   = region
    elf_last_app_img_vlow   = region
    elf_last_app_img_vhigh  = region + span
    # DEMAND-BSS: the ELF32 path keeps its eager full-span region (see the
    # NOTE above re: identity/direct-map aliasing). No demand BSS tail —
    # clear the globals so a prior ELF64 load's tail can't leak into this
    # image's do_execve bss-demand registration.
    elf_last_app_bss_lo = 0
    elf_last_app_bss_hi = 0
    # No PT_INTERP on ELF32 — clear the interpreter coords so a stale
    # ELF64 dynamic-load's interp span doesn't get reinstalled.
    elf_last_interp_img_phys  = 0
    elf_last_interp_img_vlow  = 0
    elf_last_interp_img_vhigh = 0

    # W^X span hygiene (latent-fault fix). A native ELF32 binary links
    # one RWE PT_LOAD segment (user/init.lds) — it has NO read-only
    # (.text/.rodata) span, so its image must be installed fully
    # writable. But elf_last_app_ro_* / elf_last_interp_ro_* are GLOBALS
    # populated only by the ELF64 loader (_collect_app_ro_spans); this
    # ELF32 path never touched them. If ANY Linux-ABI ELF64 binary loaded
    # earlier in the boot, its RO spans persist here, and the W^X Stage-1b
    # pass in elf_apply_last_user_mapping() would then flip THOSE stale
    # user-vaddr spans READ-ONLY inside this ELF32 image's PML4. When the
    # stale span happens to overlap this image's region_alloc()'d base,
    # a .data/.bss page is left present+RO+non-COW. The image's first
    # rfork() COW-shares that page verbatim-RO (it looks like a genuine
    # W^X code page to _cow_share_one_page), and the child's first write
    # to it faults #PF P=1/W=1/U=1 with NO COW bit -> fatal, never
    # resolvable. Reset the spans to 0 so a native ELF32 image is always
    # installed fully writable, regardless of what loaded before it.
    elf_last_app_ro_n    = 0
    elf_last_interp_ro_n = 0

    # U3: Linux-ABI detection. We record whether this image is a Linux-
    # ABI binary in elf_last_was_linux; the caller (SYS_SPAWN or
    # SYS_EXECVE) is responsible for flipping is_linux_userspace on the
    # correct slot — the child for SPAWN, current for EXECVE. ELF32
    # path: native Hamnix images, never Linux. Always reset to 0.
    elf_last_was_linux = 0

    return entry_real


# -- Linux ABI detection (U2 scaffold) -----------------------------------
#
# These helpers inspect an in-memory ELF image to decide whether it
# wants the Linux syscall ABI. They do NOT modify the loader yet; U3
# will wire elf_is_linux_binary() into the exec path so the new task
# struct's is_linux_userspace flag can be set before jumping to CPL=3.
#
# Layout used here is ELF64 (the format Linux x86_64 binaries use):
#   e_ident[16]                    bytes 0..15
#     [7] = EI_OSABI
#     [8] = EI_ABIVERSION
#   e_phoff       (uint64)         offset 32
#   e_phentsize   (uint16)         offset 54
#   e_phnum       (uint16)         offset 56
#
# ELF64 program header (56 bytes):
#   offset  0   p_type      (uint32)
#   offset  4   p_flags     (uint32)
#   offset  8   p_offset    (uint64)
#   offset 16   p_vaddr     (uint64)
#   offset 24   p_paddr     (uint64)
#   offset 32   p_filesz    (uint64)
#   offset 40   p_memsz     (uint64)
#   offset 48   p_align     (uint64)


def _find_pt_interp(image: Ptr[uint8]) -> uint64:
    # Returns the byte offset (inside the ELF64 program header table)
    # of the PT_INTERP phdr, or 0 if none. Caller adds image base.
    e_phoff: uint64 = _read_u64(cast[Ptr[uint8]](
        cast[uint64](image) + 32))
    e_phentsize: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](image) + 54))
    e_phnum: uint32 = _read_u16(cast[Ptr[uint8]](
        cast[uint64](image) + 56))
    i: uint32 = 0
    while i < e_phnum:
        ph: uint64 = cast[uint64](image) \
                    + e_phoff \
                    + cast[uint64](i) * cast[uint64](e_phentsize)
        p_type: uint32 = _read_u32(cast[Ptr[uint8]](ph + 0))
        if p_type == PT_INTERP:
            return ph
        i = i + 1
    return 0


def elf_is_linux_binary(image: Ptr[uint8]) -> int32:
    # Returns 1 if the loaded ELF is a Linux-ABI binary (dynamic linker
    # expected OR Linux OSABI marker). 0 for native Hamnix.
    #
    # ELF64 header: e_ident[16] starts at offset 0.
    # e_ident[7] = EI_OSABI, e_ident[8] = EI_ABIVERSION.
    if _validate_magic(image) == 0:
        return 0
    osabi: uint8 = image[EI_OSABI]
    # Explicit Linux OSABI marker -> definitely Linux.
    if osabi == ELFOSABI_LINUX:
        return 1
    # Walk program headers; presence of PT_INTERP means a dynamic
    # linker is expected (e.g. /lib64/ld-linux-x86-64.so.2). That's
    # always a Linux userspace binary on x86_64.
    if _find_pt_interp(image) != 0:
        return 1
    # NOTE: static-PIE Linux binaries (ET_DYN, no PT_INTERP, has
    # .dynamic) are not yet distinguished here. They look identical
    # to a native Hamnix PIE blob at the program-header level; U3+
    # will need to check e_type == ET_DYN and scan for PT_DYNAMIC.
    return 0


def elf_get_interp_path(image: Ptr[uint8], buf: Ptr[uint8],
                        bufsize: uint64) -> int32:
    # Returns 0 on no PT_INTERP; 1 if found and path copied to buf.
    # The PT_INTERP segment's p_offset/p_filesz point at a string in
    # the file.
    if _validate_magic(image) == 0:
        return 0
    ph: uint64 = _find_pt_interp(image)
    if ph == 0:
        return 0
    p_offset: uint64 = _read_u64(cast[Ptr[uint8]](ph + 8))
    p_filesz: uint64 = _read_u64(cast[Ptr[uint8]](ph + 32))
    if bufsize == 0:
        return 0
    # Cap copy to bufsize - 1 so we always have room for NUL.
    n: uint64 = p_filesz
    if n > bufsize - 1:
        n = bufsize - 1
    src: uint64 = cast[uint64](image) + p_offset
    memcpy(buf, cast[Ptr[uint8]](src), n)
    # NUL-terminate. PT_INTERP strings already include a trailing
    # NUL in p_filesz, but truncation could chop it off.
    buf[n] = 0
    return 1


# -- U30: per-task user-vaddr mapping installer ---------------------------
#
# ET_EXEC binaries link at a fixed virtual address (Debian's busybox-static
# at 0x400000) and bake absolute addresses into .text / .got. To run them
# we have to physically place them somewhere (the memblock_alloc'd `region`
# in _load_elf64) AND make the user-mode virtual address space see those
# pages at the binary's link-time vaddrs.
#
# The BSP page tables built in arch/x86/boot/header.S identity-map the
# low 4 GiB via 1 GiB pages at the PDPT level (PS=1, US=1). Each task
# clones the BSP's PML4 page at create_user_task_argv time (see
# kernel/sched/core.ad), so every task starts with the same identity map
# AND the same shared PDPT page underneath it. To overlay a finer-
# grained mapping for just the user range we have to clone the relevant
# upper-level tables before mutating them — otherwise a write here would
# corrupt every other task's view of low memory.
#
# Strategy (mirrors Linux's vmap_pte_range / __pte_alloc walk, scaled
# down to "no error returns, no locking"):
#
#   1. Clone PML4[0] (covers [0, 512 GiB)) into a fresh PDPT page. Copy
#      every entry over so unmodified-portions stay identity.
#   2. For each 1 GiB chunk that overlaps [vlow, vhigh): clone its PDPT
#      entry into a fresh PD page initialised with 512 PS=1 entries that
#      reproduce the original 1 GiB identity map at 2 MiB granularity.
#      Then drop PS=1 on the entry and point it at the new PD.
#   3. For each 2 MiB chunk that overlaps [vlow, vhigh): clone its PD
#      entry into a fresh PT page initialised with 512 4 KiB entries
#      reproducing the original 2 MiB identity map. Then drop PS=1 on
#      the PD entry and point it at the new PT.
#   4. For each 4 KiB page inside [vlow, vhigh): overwrite the PT entry
#      to map the user vaddr to phys_base + (vaddr - vlow).
#
# Limits:
#   - Only one 1 GiB chunk is supported (vhigh must fit inside the same
#     GiB as vlow). Real-world ET_EXEC binaries we care about (busybox,
#     coreutils-static) span ~2 MiB at 0x400000 — well inside the first
#     GiB. Wider ranges return -1.
#   - We DO leak the cloned PDPT/PD/PT pages on a subsequent install
#     (e.g. repeated execve into ET_EXEC binaries on the same task).
#     Each install allocates fresh tables; the previous tree is dropped
#     on the floor. mm has no reclaim path for page-table pages yet;
#     fix lands when mm_struct teardown does.

PT_FLAG_P:  uint64 = 0x1          # Present
PT_FLAG_RW: uint64 = 0x2          # Read/Write
PT_FLAG_US: uint64 = 0x4          # User/Supervisor (1 = CPL=3 may access)
PT_FLAG_PS: uint64 = 0x80         # Page-Size (1 = terminal at this level)
# W^X Stage 1a: No-Execute. Bit 63 of a leaf PTE — when EFER.NXE is on,
# an instruction fetch from a page with this bit set raises #PF with the
# I/D (instruction-fetch) error bit. Stamped on user DATA pages (stack /
# brk heap / anonymous mmap) so they can never be executed. NOT stamped
# on image/.text in this stage (that is a later W^X slice).
PT_FLAG_NX: uint64 = 0x8000000000000000
PT_ADDR_MASK: uint64 = 0x000FFFFFFFFFF000   # bits [51:12]: phys base

PAGE_SIZE_4K: uint64 = 0x1000
PAGE_SIZE_2M: uint64 = 0x200000
PAGE_SIZE_1G: uint64 = 0x40000000


def _zero_page(addr: uint64):
    memset(cast[Ptr[uint8]](addr), 0, 4096)


def _build_identity_pd(pd_phys: uint64, gib_base: uint64):
    # Populate `pd_phys` with 512 PS=1 entries that identity-map the
    # 1 GiB chunk starting at gib_base via 2 MiB pages. Equivalent to
    # the boot-time 1 GiB PDPT entry with PS=1, just expressed at one
    # finer granularity so individual 2 MiB chunks can be overridden.
    #
    # SMAP-v3 (LANDED): leaves are US=0 — kernel-only identity backfill.
    # The user-stack-via-implicit-US=1 dependency that previously blocked
    # this split has been removed: kernel/sched/core.ad's
    # create_user_thread now installs the fresh user stack via an
    # EXPLICIT US=1 PTE through elf_install_user_stack, and every other
    # user page already carries an explicit US=1 leaf (image via
    # _elf_install_user_mapping_locked, brk via elf_install_user_heap,
    # mmap via vma_alloc -> elf_install_user_mapping). With these leaves
    # US=0, a stray supervisor data access into an unmapped kernel
    # identity region cannot piggy-back on the backfill's permissions,
    # and CR4.SMAP (cpu_mitigations.SMAP_RUNTIME_ENABLE) is enabled.
    pd: Ptr[uint64] = cast[Ptr[uint64]](pd_phys)
    i: uint64 = 0
    while i < 512:
        addr: uint64 = gib_base + i * PAGE_SIZE_2M
        pd[i] = addr | PT_FLAG_PS | PT_FLAG_RW | PT_FLAG_P
        i = i + 1


def _is_boot_identity_stamp(huge_base: uint64, va_base: uint64) -> int32:
    # DIRECT-MAP ALIASING (fork/exec keystone): the boot stub identity-maps
    # the LOW 512 GiB with 512x 1 GiB PS=1 huge pages (header.S pdpt_low).
    # Every one of those entries is PRESENT, US=0, and maps phys == vaddr —
    # INCLUDING the [4 GiB, 512 GiB) range that holds NO real RAM but is
    # where the ET_DYN load-bias / interp / mmap ASLR windows now live.
    #
    # When _cow_resolve_pte_slot cracks one of those huge pages to install a
    # per-task user leaf, the OLD code (P==1 branch) reproduced the huge page
    # as 512 identity sub-leaves — handing every UNTOUCHED sibling page in the
    # chunk a wild, present, US=0 identity frame. Because the frame is
    # phys==vaddr identity, the SAME physical RAM is aliased into EVERY task
    # that cracks the same ASLR window: a fork parent and a child that execs a
    # new ld.so at a nearby ASLR vaddr end up pointing at the SAME physical
    # frames. The child's exec scribbles the parent's still-live interp/libc
    # image -> the parent later faults err=0x05 reading a now-US=0 / corrupted
    # page (observed: dpkg/apt fork->exec(dpkg-split) parent SIGSEGV).
    #
    # A genuine boot identity stamp is recognizable: it maps phys == vaddr
    # (identity) AND the chunk sits AT/ABOVE the top of real RAM (so the
    # identity frame is NOT backing any legitimate kernel direct-map page).
    # Such a chunk must be treated like an ABSENT entry when cracked: seed
    # EMPTY leaves so untouched siblings FAULT (demand/COW miss) instead of
    # wild-aliasing shared physical RAM. Real low-RAM identity pages (phys ==
    # vaddr below RAM top) and real user mappings (phys != vaddr) are NOT
    # stamps and are reproduced faithfully.
    if huge_base != va_base:
        return 0                       # phys != vaddr -> a real user mapping
    ram_top: uint64 = memblock_region_top()
    if va_base >= ram_top:
        return 1                       # identity above RAM -> boot 512G stamp
    return 0                           # identity within RAM -> real direct-map


def _build_pd_from_pdpt_entry(pd_phys: uint64, pdpt_entry: uint64,
                              gib_base: uint64):
    # 1 GiB analogue of _build_pt_from_pd_entry. Seed `pd_phys` (a fresh
    # PD) by reproducing whatever the PDPT entry `pdpt_entry` mapped for the
    # 1 GiB chunk at `gib_base`:
    #
    #   (a) Present PS=1 1 GiB page -> 512 PS=1 2 MiB entries reproducing
    #       the SAME contiguous phys (identity for a low-RAM boot 1 GiB
    #       page; real phys otherwise), preserving the flag bits.
    #   (b) Absent (P=0) -> 512 NOT-PRESENT entries. This is the ASLR-above-
    #       4 GiB case: the boot stub never mapped this 1 GiB window, so
    #       there is NO kernel direct-map RAM to preserve. Seeding identity
    #       here (the old _build_identity_pd-on-absent behaviour) gave every
    #       2 MiB sibling of the user range a wild present 1:1 frame, so a
    #       fork child reading/faulting an un-installed sibling resolved
    #       garbage instead of faulting. Empty leaves make those siblings
    #       fault correctly; the per-page caller installs the real leaves.
    if (pdpt_entry & PT_FLAG_P) == 0:
        memset(cast[Ptr[uint8]](pd_phys), 0, 4096)
        return
    huge_base: uint64 = pdpt_entry & PT_ADDR_MASK
    # DIRECT-MAP ALIASING fix: a PRESENT boot 512-GiB identity stamp above RAM
    # top is NOT a real mapping — reproducing it identity-aliases shared RAM
    # across tasks (fork/exec corruption). Treat it as absent: empty leaves so
    # untouched siblings fault, the per-page caller installs the real leaf.
    if _is_boot_identity_stamp(huge_base, gib_base) != 0:
        memset(cast[Ptr[uint8]](pd_phys), 0, 4096)
        return
    pd: Ptr[uint64] = cast[Ptr[uint64]](pd_phys)
    # Keep PS (these are 2 MiB terminal pages) + the original flag bits.
    leaf_flags: uint64 = (pdpt_entry & ~PT_ADDR_MASK) | PT_FLAG_PS
    i: uint64 = 0
    while i < 512:
        pd[i] = (huge_base + i * PAGE_SIZE_2M) | leaf_flags
        i = i + 1


def _build_identity_pt(pt_phys: uint64, mib2_base: uint64):
    # Populate `pt_phys` with 512 4 KiB entries that identity-map the
    # 2 MiB chunk starting at mib2_base. Used when we need to crack a
    # PS=1 PD entry into 4 KiB-granular entries so we can override a
    # subset for user mappings.
    #
    # SMAP-v3 (LANDED): leaves are US=0 — kernel-only identity backfill.
    # See _build_identity_pd above for the full rationale; in short, the
    # explicit US=1 PTE installed by create_user_thread for the user
    # stack (plus the existing explicit installs for image / brk / mmap)
    # removed the implicit-US=1 dependency, so the 4 KiB backfill leaves
    # can match the 2 MiB leaves and CR4.SMAP can be enabled.
    pt: Ptr[uint64] = cast[Ptr[uint64]](pt_phys)
    i: uint64 = 0
    while i < 512:
        addr: uint64 = mib2_base + i * PAGE_SIZE_4K
        pt[i] = addr | PT_FLAG_RW | PT_FLAG_P
        i = i + 1


def _build_pt_from_pd_entry(pt_phys: uint64, pd_entry: uint64,
                            mib2_base: uint64):
    # Seed `pt_phys` (a fresh 4 KiB-granular PT) by FAITHFULLY reproducing
    # whatever the PD entry `pd_entry` currently maps for the 2 MiB chunk
    # at `mib2_base`. This is the COW/fork-correct replacement for
    # _build_identity_pt: it does NOT assume vaddr==phys.
    #
    # Three cases for the PD entry being cracked:
    #
    #   (a) Present PS=1 huge page (P=1, PS=1): the 2 MiB chunk maps a
    #       CONTIGUOUS physical range starting at (pd_entry & PT_ADDR_MASK).
    #       Reproduce it leaf-by-leaf: leaf i -> huge_base_phys + i*4K,
    #       preserving the huge page's flag bits (US/RW/NX/PCD/...), minus
    #       the PS bit (leaves are terminal at the PT level, no PS).
    #       For a low-RAM boot-identity huge page, huge_base_phys==mib2_base
    #       so this reproduces the exact identity map the kernel direct-map
    #       relies on — NO regression vs _build_identity_pt. For an ASLR'd
    #       high-VA user huge page, it reproduces the REAL phys, not a bogus
    #       vaddr==phys identity frame.
    #
    #   (b) Absent entry (P=0): nothing was mapped here. Seed every leaf
    #       NOT-PRESENT (0). A later access faults correctly (demand
    #       paging / COW miss) instead of silently resolving to a wild
    #       identity frame. This is the case for an ASLR'd PIE biased above
    #       the boot stub's 4 GiB identity window: the boot PD entry is
    #       absent, and seeding identity there (the old bug) handed the
    #       child wild present frames for every sibling page in the chunk.
    #
    # (A present non-PS entry never reaches here — the caller only cracks
    #  PS=1 or absent entries; a present non-PS entry is already a PT.)
    if (pd_entry & PT_FLAG_P) == 0:
        # Absent: seed not-present so accesses fault, never wild-resolve.
        memset(cast[Ptr[uint8]](pt_phys), 0, 4096)
        return
    huge_base: uint64 = pd_entry & PT_ADDR_MASK
    # DIRECT-MAP ALIASING fix (see _build_pd_from_pdpt_entry): a present 2 MiB
    # identity huge page above RAM top is a boot 512-GiB stamp sibling, not a
    # real user mapping. Reproducing it as identity leaves aliases shared RAM
    # across tasks. Empty it so untouched pages fault and the caller installs
    # the real per-task leaf.
    if _is_boot_identity_stamp(huge_base, mib2_base) != 0:
        memset(cast[Ptr[uint8]](pt_phys), 0, 4096)
        return
    pt: Ptr[uint64] = cast[Ptr[uint64]](pt_phys)
    leaf_flags: uint64 = (pd_entry & ~PT_ADDR_MASK) & ~PT_FLAG_PS
    i: uint64 = 0
    while i < 512:
        pt[i] = (huge_base + i * PAGE_SIZE_4K) | leaf_flags
        i = i + 1


def elf_install_user_mapping(pml4_phys: uint64, vlow: uint64,
                             vhigh: uint64, phys_base: uint64,
                             extra_flags: uint64) -> int32:
    # Boot-CR3 guard. This function dereferences page-table pages
    # (pml4 / bsp_pml4 / pdpt / pd / pt) as raw physical addresses,
    # relying on a full low-RAM identity map. Under UEFI -m 512M the
    # boot page tables themselves land high (~485 MiB), and the task
    # whose CR3 is LIVE when we are called is typically a parent that
    # has already CRACKED its own PML4 and dropped the identity entry
    # for that high 2 MiB chunk — so these kernel derefs #PF
    # (observed CR2=0x1e62e000, pd[243] P=0). The pristine boot CR3
    # (cow_boot_cr3) keeps full low-RAM identity for the whole walk,
    # so switch to it for the duration of the table surgery and
    # restore the caller's CR3 before returning. Mirrors the same
    # guard added to create_user_task_argv's PML4 clone in
    # kernel/sched/core.ad.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_install_user_mapping_locked(
        pml4_phys, vlow, vhigh, phys_base, extra_flags)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_install_user_mapping_locked(pml4_phys: uint64, vlow: uint64,
                             vhigh: uint64, phys_base: uint64,
                             extra_flags: uint64) -> int32:
    # Overlay [vlow, vhigh) -> [phys_base, phys_base + (vhigh - vlow))
    # in the supplied PML4. Both pml4_phys and phys_base are physical
    # addresses (identity-mapped through the BSP page tables, so we
    # can dereference them directly from kernel code).
    #
    # W^X Stage 1a: `extra_flags` is OR'd into every leaf PTE this call
    # writes. Callers that want non-executable DATA pages pass
    # PT_FLAG_NX (bit 63); all other callers pass 0 (executable, the
    # legacy behaviour). Only LEAF PTEs receive it — the intermediate
    # PDPT/PD entries stay RWX so the table walk itself never faults.
    #
    # W^X prot-write: `extra_flags` is now ALSO the channel for the
    # leaf-PTE Read/Write bit. The leaf is no longer unconditionally
    # writable — a caller that wants a WRITABLE page must OR PT_FLAG_RW
    # into `extra_flags`, exactly as it ORs PT_FLAG_NX for a data page.
    # A caller that omits PT_FLAG_RW gets a READ-ONLY page, so a
    # PROT_READ-only mmap is genuinely non-writable at the PTE level and
    # a store to it faults (SIGSEGV). All in-tree callers were updated to
    # pass PT_FLAG_RW where they previously relied on the implicit RW.
    # The intermediate PDPT/PD entries stay RW so the table walk itself
    # never faults; only the LEAF carries the prot-derived writability.
    #
    # Returns 0 on success, -1 on:
    #   - range spans more than one 1 GiB PDPT entry
    #   - OOM from alloc_page() (no rollback — caller treats this as
    #     a fatal "task can't run")
    #
    # Caller is responsible for the TLB consistency story:
    #   - SYS_SPAWN target child hasn't been scheduled yet, so its CR3
    #     never sat in the CPU's TLB — no flush needed.
    #   - SYS_EXECVE target IS the current task whose CR3 is live;
    #     caller should reload CR3 with the same value (full TLB
    #     flush of non-global entries) after this returns.
    if vlow >= vhigh:
        return 0
    if (vlow & (PAGE_SIZE_4K - 1)) != 0:
        printk0("elf_install_user_mapping: vlow not 4 KiB-aligned\n")
        return -1
    if (vhigh & (PAGE_SIZE_4K - 1)) != 0:
        printk0("elf_install_user_mapping: vhigh not 4 KiB-aligned\n")
        return -1

    # --- Kernel-image collision: no longer possible ------------------
    # Hamnix now runs as a HIGHER-HALF kernel: its .text/.rodata/.data/
    # .bss are linked and run at 0xffffffff80000000+offset (PML4 entry
    # 511, the top 2 GiB). The ENTIRE lower canonical half — every
    # address a user task could ever map — is free for userspace.
    #
    # The kernel image's PHYSICAL pages still sit in low RAM (the boot
    # stub maps them at both the low identity address AND the high
    # half), but a user mapping only ever rewrites PML4 entries 0..255
    # of the task's address space. PML4[511]'s kernel high-half subtree
    # is shared verbatim from the BSP PML4 and never touched by an
    # overlay install. So a fixed-address ET_EXEC linked at 0x400000
    # can be installed safely — its [vlow, vhigh) lives in PML4[0]'s
    # subtree, nowhere near the kernel.
    #
    # The old "fixed-address ET_EXEC needs a higher-half kernel" refusal
    # that lived here is exactly the constraint this higher-half move
    # removed; the guard is therefore deleted. kernel_image_end() is
    # still used by mm/memblock to keep the page allocator off the
    # kernel's PHYSICAL footprint — that is a separate, still-valid
    # concern and is untouched.

    # Confine to one PML4 entry + one PDPT entry. The 1 GiB chunk
    # containing vlow must also contain vhigh - 1.
    pml4_idx_lo: uint64 = (vlow >> 39) & 0x1FF
    pml4_idx_hi: uint64 = ((vhigh - 1) >> 39) & 0x1FF
    pdpt_idx_lo: uint64 = (vlow >> 30) & 0x1FF
    pdpt_idx_hi: uint64 = ((vhigh - 1) >> 30) & 0x1FF
    if pml4_idx_lo != pml4_idx_hi:
        printk0("elf_install_user_mapping: range crosses PML4 entry\n")
        return -1
    if pdpt_idx_lo != pdpt_idx_hi:
        printk0("elf_install_user_mapping: range crosses 1 GiB boundary\n")
        return -1

    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    # M16.36: compare against the PRISTINE BOOT page tables, NOT the
    # live %cr3. The "is this entry still the shared boot mapping?"
    # test needs the pre-task-creation snapshot — same reason
    # _cow_resolve_pte_slot uses cow_boot_cr3() — because the live
    # %cr3 belongs to WHATEVER task currently runs, which may have
    # cracked its own PML4[0] long ago. Using its already-cracked
    # PML4 as the comparison anchor mistakes a sibling task's
    # PRIVATE PDPT for "shared" and ends up walking / mutating that
    # sibling's per-task PDPT — corrupting an unrelated address
    # space. Pre-M16.36 the only caller of this function that ran in
    # a different task's CR3 context was vm_fork_copy_range (called
    # from inside the parent on the CHILD's PML4), and the
    # parent's identity-mapped PML4 wasn't yet cracked because no
    # ELF mapping ever fired for native ELF32 / ET_DYN images —
    # so the comparison happened to be right by accident. M16.36
    # made the parent ALWAYS crack first (per-task PT entries for
    # every loaded image and stack), exposing this bug.
    bsp_pml4: Ptr[uint64] = cast[Ptr[uint64]](
        cow_boot_cr3() & PT_ADDR_MASK)

    # --- Step 1: ensure PML4[pml4_idx_lo] points at a per-task PDPT.
    # The cloned PML4 entry currently shares its target PDPT with the
    # BSP (memcpy at task-creation time copied the 8-byte entry, but
    # the PDPT page itself is still the boot-time one). Detect that
    # by comparing the PML4 entry against BSP's; if they match, clone
    # the PDPT into a fresh page and update the PML4 entry.
    # U52: the load-bias / mmap-base ASLR window can land in a PML4 slot
    # that the boot stub never populated (the BSP identity map covers only
    # the first 4 GiB; an ET_DYN image biased to [4 GiB, 5 GiB) hits an
    # ABSENT PML4[≥4] entry). Two sub-cases:
    #   (a) entry == bsp's AND present -> the legacy "still shared boot
    #       PDPT" case: clone the boot PDPT so our edits stay task-private.
    #   (b) entry not present (P=0) -> nothing is mapped here at all; build
    #       a FRESH zeroed PDPT and install it present+US+RW. The leaf PTE
    #       installed below carries the real per-page US/RW/NX; the
    #       intermediate just has to be traversable. Mirrors the
    #       _cow_resolve_pte_slot absent-entry handling.
    pml4_entry: uint64 = pml4[pml4_idx_lo]
    if (pml4_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt: uint64 = alloc_page()
        if new_pdpt == 0:
            return -1
        memset(cast[Ptr[uint8]](new_pdpt), 0, 4096)
        pml4[pml4_idx_lo] = new_pdpt \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pml4_entry = pml4[pml4_idx_lo]
    elif pml4_entry == bsp_pml4[pml4_idx_lo]:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt: uint64 = alloc_page()
        if new_pdpt == 0:
            return -1
        # Copy the existing 4 KiB PDPT verbatim — preserves all
        # mappings outside the user range.
        old_pdpt_phys: uint64 = pml4_entry & PT_ADDR_MASK
        memcpy(cast[Ptr[uint8]](new_pdpt),
               cast[Ptr[uint8]](old_pdpt_phys), 4096)
        # Preserve the original flag bits and swap in the new physical
        # base — BUT force US=1 on this PML4 directory entry. The boot
        # PML4[0] was US=0-stamped by cpu_mitigations._restamp_pml4_subtree_us0
        # to keep CR4.SMAP=1 from triple-faulting on every kernel access
        # to low identity RAM. Directory-level US gates the EFFECTIVE
        # US for the entire subtree (US is ANDed across the 4 walk
        # levels per Intel SDM Vol 3A §4.6) — so a US=0 PML4[0]
        # forbids CPL=3 access to every leaf inside it, no matter what
        # the leaf US is. Setting US=1 here makes the per-task PML4[0]
        # subtree permissive at the directory level; the per-task
        # PT leaves below carry the real US distinction (US=1 for user
        # mappings; pre-existing US=0 verbatim-copied non-leaf PDPT
        # entries above non-cracked ranges keep kernel accesses
        # SMAP-clean).
        pml4[pml4_idx_lo] = new_pdpt \
            | (pml4_entry & ~PT_ADDR_MASK) \
            | PT_FLAG_US
        pml4_entry = pml4[pml4_idx_lo]

    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4_entry & PT_ADDR_MASK)

    # --- Step 2: ensure PDPT[pdpt_idx_lo] is a non-PS pointer to a PD.
    # Boot-time PDPT entries are PS=1 1 GiB identity pages. Crack the
    # one covering our user range into a 512-entry PD initialised with
    # PS=1 2 MiB identity entries (same coverage, finer granularity).
    # U52: an ABSENT PDPT entry (P=0, PS=0 — a high ASLR window the boot
    # stub never stamped) is treated the SAME as a PS=1 1 GiB page: build
    # an identity PD for the covering 1 GiB so kernel reads inside the
    # chunk keep resolving, then drop the leaf PTEs onto it below.
    pdpt_entry: uint64 = pdpt[pdpt_idx_lo]
    if (pdpt_entry & PT_FLAG_PS) != 0 or (pdpt_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pd: uint64 = alloc_page()
        if new_pd == 0:
            return -1
        gib_base: uint64 = pdpt_idx_lo * PAGE_SIZE_1G
        # Reproduce the old PDPT entry's mapping: present 1 GiB page ->
        # real phys (identity for low-RAM boot pages); absent -> empty PD
        # (a high ASLR window — no kernel direct-map to preserve). Avoids
        # wild identity siblings for an ASLR'd PIE above 4 GiB.
        _build_pd_from_pdpt_entry(new_pd, pdpt_entry, gib_base)
        pdpt[pdpt_idx_lo] = new_pd \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pdpt_entry = pdpt[pdpt_idx_lo]

    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpt_entry & PT_ADDR_MASK)

    # --- Step 3 + 4: walk every 4 KiB page in [vlow, vhigh). For each
    # one, ensure the covering PD entry is a non-PS pointer to a PT
    # (cracking the 2 MiB PS=1 entry on first touch), then plant the
    # user mapping into the PT slot.
    vaddr: uint64 = vlow
    do:
        pd_idx: uint64 = (vaddr >> 21) & 0x1FF
        pd_entry: uint64 = pd[pd_idx]
        if (pd_entry & PT_FLAG_PS) != 0 or (pd_entry & PT_FLAG_P) == 0:
            # Crack the 2 MiB chunk into 4 KiB entries by FAITHFULLY
            # reproducing whatever the old PD entry mapped: a present PS=1
            # huge page -> its real contiguous phys (identity for low-RAM
            # boot pages, real phys for a high-VA huge mapping); an ABSENT
            # entry -> not-present leaves (a high ASLR window the boot stub
            # never stamped). The previous identity seed handed wild present
            # frames to every sibling page of an absent high-VA chunk.
            pa_set_site(PA_SITE_PGTABLE)
            new_pt: uint64 = alloc_page()
            if new_pt == 0:
                return -1
            mib2_base: uint64 = (vaddr >> 21) << 21
            _build_pt_from_pd_entry(new_pt, pd_entry, mib2_base)
            pd[pd_idx] = new_pt \
                | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
            pd_entry = pd[pd_idx]
        pt: Ptr[uint64] = cast[Ptr[uint64]](pd_entry & PT_ADDR_MASK)
        pt_idx: uint64 = (vaddr >> 12) & 0x1FF
        target_phys: uint64 = phys_base + (vaddr - vlow)
        # The leaf RW bit comes from `extra_flags` (PT_FLAG_RW) — NOT
        # hardcoded — so a read-only mapping clears it. US/P are always
        # present (a user page that is mapped at all is at least readable).
        pt[pt_idx] = target_phys \
            | PT_FLAG_US | PT_FLAG_P | extra_flags
        vaddr = vaddr + PAGE_SIZE_4K
    while vaddr < vhigh
    return 0


# -----------------------------------------------------------------------
# elf_prepare_demand_range — crack page tables for demand paging
# -----------------------------------------------------------------------
#
# Like elf_install_user_mapping but DOES NOT install any physical page
# mapping. It cracks the PDPT/PD/PT levels for [vlow, vhigh) (the same
# table surgery elf_install_user_mapping does) but leaves every leaf PTE
# as 0 (not-present). A subsequent access to any VA in the range fires a
# NOT-PRESENT #PF (error_code bit P=0) which do_page_fault can resolve
# by allocating a physical page and calling elf_map_one_page.
#
# Must be called within one 1 GiB PDPT entry (same as
# elf_install_user_mapping). Returns 0 on success, -1 on OOM.

def elf_prepare_demand_range(pml4_phys: uint64, vlow: uint64,
                              vhigh: uint64) -> int32:
    # Boot-CR3 guard (fork/exec image-load keystone, #79). Like
    # elf_install_user_mapping and elf_set_range_ro, this cracks page
    # tables via RAW PHYSICAL dereferences of freshly alloc_page()'d
    # intermediate PT pages. Run under the LIVE task CR3 (which for a
    # fork-child post-execve has cracked its own PML4 and carries
    # demand-zero / ASLR-gap holes) a PT-page frame that numerically
    # coincides with a not-present VA #PF's — the confirmed crash trap
    # (rip in elf_prepare_demand_range, cr2 = a PT-page frame, pte=0,
    # present under BOOT cr3). Switch to the pristine boot CR3 (full flat
    # identity, every frame present) for the walk; the demand PTEs still
    # land in `pml4_phys`'s own tables. This is called at execve/mmap
    # setup (cold path), so the CR3 reload cost is negligible.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_prepare_demand_range_locked(pml4_phys, vlow, vhigh)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_prepare_demand_range_locked(pml4_phys: uint64, vlow: uint64,
                              vhigh: uint64) -> int32:
    if vlow >= vhigh:
        return 0
    if (vlow & (PAGE_SIZE_4K - 1)) != 0:
        return -1
    if (vhigh & (PAGE_SIZE_4K - 1)) != 0:
        return -1
    pml4_idx_lo: uint64 = (vlow >> 39) & 0x1FF
    pml4_idx_hi: uint64 = ((vhigh - 1) >> 39) & 0x1FF
    pdpt_idx_lo: uint64 = (vlow >> 30) & 0x1FF
    pdpt_idx_hi: uint64 = ((vhigh - 1) >> 30) & 0x1FF
    if pml4_idx_lo != pml4_idx_hi:
        return -1
    if pdpt_idx_lo != pdpt_idx_hi:
        return -1

    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    bsp_pml4: Ptr[uint64] = cast[Ptr[uint64]](
        cow_boot_cr3() & PT_ADDR_MASK)

    # Step 1: ensure per-task PDPT.
    #
    # POISONED-PTE FIX (all-ones leaf on high-ASLR mmap layouts): an ABSENT
    # PML4 entry (P=0) must yield a FRESH ZEROED PDPT, never a memcpy of
    # (pml4_entry & PT_ADDR_MASK). For a high-VA mmap window that neither the
    # task NOR the pristine boot tables ever mapped, pml4_entry == 0 ==
    # bsp_pml4[idx], so the old `== bsp` clone branch memcpy'd from physical
    # page 0 (the BIOS IVT/BDA) into the new PDPT — seeding present-looking
    # PDPT entries carrying garbage/reserved bits. The per-page crack helpers
    # (_build_pd/_pt_from_*_entry) then faithfully reproduced those garbage
    # bits into 512 leaves, so the demand page's leaf PTE came out with
    # reserved bits set (up to all-ones) → a write #PF with err bit3=RSVD.
    # Mirror elf_prepare_huge_demand_range: allocate + memset a zero PDPT for
    # an absent slot; only clone the boot PDPT when the slot is genuinely the
    # SHARED present boot entry.
    pml4_entry: uint64 = pml4[pml4_idx_lo]
    if (pml4_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt0: uint64 = alloc_page()
        if new_pdpt0 == 0:
            return -1
        memset(cast[Ptr[uint8]](new_pdpt0), 0, 4096)
        pml4[pml4_idx_lo] = new_pdpt0 \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pml4_entry = pml4[pml4_idx_lo]
    elif pml4_entry == bsp_pml4[pml4_idx_lo]:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt: uint64 = alloc_page()
        if new_pdpt == 0:
            return -1
        old_pdpt_phys: uint64 = pml4_entry & PT_ADDR_MASK
        memcpy(cast[Ptr[uint8]](new_pdpt),
               cast[Ptr[uint8]](old_pdpt_phys), 4096)
        pml4[pml4_idx_lo] = new_pdpt \
            | (pml4_entry & ~PT_ADDR_MASK)
        pml4_entry = pml4[pml4_idx_lo]

    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4_entry & PT_ADDR_MASK)

    # Step 2: crack 1 GiB PDPT entry → PD (reproducing its real mapping).
    # An ABSENT PDPT entry (P=0, PS=0 — a high mmap-window 1 GiB the boot stub
    # never stamped and no prior mapping cracked) MUST be handled too, exactly
    # like elf_install_user_mapping's Step 2: without this, a lazily-cracked
    # demand reservation whose covering PDPT entry is 0 fell through with pd==0
    # and Step 3 dereferenced physical page 0 (corrupting low RAM). Mirror the
    # install path: `or (pdpt_entry & PT_FLAG_P) == 0`. _build_pd_from_pdpt_entry
    # seeds an EMPTY PD for an absent entry (no wild identity siblings above
    # RAM), so the per-page leaves below fault correctly.
    pdpt_entry: uint64 = pdpt[pdpt_idx_lo]
    if (pdpt_entry & PT_FLAG_PS) != 0 or (pdpt_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pd: uint64 = alloc_page()
        if new_pd == 0:
            return -1
        gib_base: uint64 = pdpt_idx_lo * PAGE_SIZE_1G
        _build_pd_from_pdpt_entry(new_pd, pdpt_entry, gib_base)
        pdpt[pdpt_idx_lo] = new_pd \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pdpt_entry = pdpt[pdpt_idx_lo]

    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpt_entry & PT_ADDR_MASK)

    # Step 3+4: for each 4 KiB page in [vlow, vhigh), crack 2 MiB PD
    # entry → PT, then ZERO out the PTE for the demand page so a touch
    # fires a NOT-PRESENT #PF.
    #
    # CRACK SEEDS IDENTITY, NOT ZERO. A 2 MiB PD entry that covers low
    # RAM is part of the kernel's direct identity map: the OTHER 511
    # pages in the 2 MiB chunk (outside [vlow, vhigh)) are live kernel
    # direct-map pages that `alloc_page()` may hand back at any time. If
    # we zero-filled the whole PT (the old behaviour) those identity
    # mappings vanished from THIS task's PML4, so the moment the kernel —
    # running under this task's CR3 — wrote to such a page (e.g.
    # slab_refill stamping a freshly alloc'd slab header) it took a
    # supervisor NOT-PRESENT #PF and the box halted. This is exactly the
    # crash `enter linux { /bin/ls }` hit: the clean child's fresh PML4
    # demand-cracks a 2 MiB chunk of low identity RAM for the busybox ELF
    # image, then a later slab allocation lands in that same chunk.
    #
    # Mirror elf_install_user_mapping: seed the new PT with identity
    # (_build_identity_pt) so coverage is preserved, then punch ONLY the
    # PTEs inside [vlow, vhigh) to not-present for demand paging. Pages
    # outside the demand window keep their identity mapping.
    vaddr: uint64 = vlow
    do:
        pd_idx: uint64 = (vaddr >> 21) & 0x1FF
        pd_entry: uint64 = pd[pd_idx]
        if (pd_entry & PT_FLAG_PS) != 0 or (pd_entry & PT_FLAG_P) == 0:
            # Crack 2 MiB → PT reproducing the OLD pd entry's real mapping
            # (_build_pt_from_pd_entry): a present low-RAM identity huge page
            # keeps the rest of the chunk direct-mapped for the kernel; an
            # ABSENT high-VA entry seeds not-present leaves rather than wild
            # identity frames. The target demand pages are punched not-present
            # below regardless.
            pa_set_site(PA_SITE_PGTABLE)
            new_pt: uint64 = alloc_page()
            if new_pt == 0:
                return -1
            mib2_base: uint64 = (vaddr >> 21) << 21
            _build_pt_from_pd_entry(new_pt, pd_entry, mib2_base)
            pd[pd_idx] = new_pt \
                | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
            pd_entry = pd[pd_idx]
        # Punch this demand page to not-present so the first touch fires
        # a NOT-PRESENT #PF that do_page_fault resolves via elf_map_one_page.
        pt: Ptr[uint64] = cast[Ptr[uint64]](pd_entry & PT_ADDR_MASK)
        pt_idx: uint64 = (vaddr >> 12) & 0x1FF
        pt[pt_idx] = 0
        vaddr = vaddr + PAGE_SIZE_4K
    while vaddr < vhigh
    return 0


# elf_demand_leaf_absent — is the 4 KiB PT container covering `va` uncracked?
#
# Returns 1 iff the page-table walk to the LEAF PT for `va` hits an absent or
# huge level (PML4/PDPT/PD entry P=0, or a PS=1 huge leaf at PDPT/PD) — i.e.
# the range is a LAZY demand reservation whose page tables have NOT yet been
# materialised, so elf_map_one_page (which requires the PT to exist) would
# fail. Returns 0 when the PT already exists (the common re-fault / eagerly-
# prepared case). Boot-CR3 guarded like every other raw-physical PT walk here:
# the intermediate frames are dereferenced by bare physical address, which can
# alias a not-present live-CR3 VA on a >4 GiB guest.
#
# The lazy-reservation fault path calls this to decide whether it must crack
# the covering page tables (via elf_prepare_demand_range) before mapping the
# faulting page — so a multi-GiB PROT_NONE reservation costs ZERO page-table
# RAM until a page in it is actually touched, one 2 MiB PT at a time.
def elf_demand_leaf_absent(pml4_phys: uint64, va: uint64) -> int32:
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _r: int32 = _elf_demand_leaf_absent_locked(pml4_phys, va)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _r


def _elf_demand_leaf_absent_locked(pml4_phys: uint64, va: uint64) -> int32:
    va_al: uint64 = va & ~(PAGE_SIZE_4K - 1)
    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    pml4e: uint64 = pml4[(va_al >> 39) & 0x1FF]
    if (pml4e & PT_FLAG_P) == 0:
        return 1
    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4e & PT_ADDR_MASK)
    pdpte: uint64 = pdpt[(va_al >> 30) & 0x1FF]
    if (pdpte & PT_FLAG_P) == 0:
        return 1
    if (pdpte & PT_FLAG_PS) != 0:
        return 1
    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpte & PT_ADDR_MASK)
    pde: uint64 = pd[(va_al >> 21) & 0x1FF]
    if (pde & PT_FLAG_P) == 0:
        return 1
    if (pde & PT_FLAG_PS) != 0:
        return 1
    return 0


# elf_map_one_page — map a single physical page at a virtual address.
#
# The page tables for `va` must already exist (call
# elf_prepare_demand_range first). Sets the 4 KiB PTE to
# (phys | PT_FLAG_US | PT_FLAG_P | extra_flags) and invalidates the TLB
# entry. PT_FLAG_RW is added when want_write != 0. `extra_flags`
# (W^X Stage 1a) lets the caller OR in PT_FLAG_NX for a data page; pass
# 0 for an executable page.
#
# Returns 0 on success, -1 if any page-table level is missing.

def elf_map_one_page(pml4_phys: uint64, va: uint64,
                     phys: uint64, want_write: int32,
                     extra_flags: uint64) -> int32:
    # Boot-CR3 guard (#79 / Firefox large-RAM aliasing) — same rationale as
    # elf_prepare_demand_range / elf_set_range_ro: this function dereferences
    # the task's page-table pages by BARE PHYSICAL address (pml4_phys and the
    # intermediate PDPT/PD/PT frames). On a machine with >4 GiB RAM those PT
    # frames can live in high physical RAM whose low-half identity mapping in
    # the LIVE task CR3 has been overwritten by a colliding user mapping
    # (user VA ~= physical addr, both in the low half) — so a raw read/write
    # of `pt[pt_idx]` #PFs (cr2==pt-frame, present under BOOT cr3's pristine
    # 1 GiB-huge identity, absent under live cr3). Run the raw walk under the
    # boot CR3 whose full flat identity is never aliased by a user mapping.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_map_one_page_locked(pml4_phys, va, phys,
                                          want_write, extra_flags)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_map_one_page_locked(pml4_phys: uint64, va: uint64,
                     phys: uint64, want_write: int32,
                     extra_flags: uint64) -> int32:
    va_al: uint64 = va & ~(PAGE_SIZE_4K - 1)
    pml4_idx: uint64 = (va_al >> 39) & 0x1FF
    pdpt_idx: uint64 = (va_al >> 30) & 0x1FF
    pd_idx:   uint64 = (va_al >> 21) & 0x1FF
    pt_idx:   uint64 = (va_al >> 12) & 0x1FF

    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    pml4e: uint64 = pml4[pml4_idx]
    if (pml4e & PT_FLAG_P) == 0:
        return -1
    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4e & PT_ADDR_MASK)
    pdpte: uint64 = pdpt[pdpt_idx]
    if (pdpte & PT_FLAG_P) == 0:
        return -1
    if (pdpte & PT_FLAG_PS) != 0:
        return -1
    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpte & PT_ADDR_MASK)
    pde: uint64 = pd[pd_idx]
    if (pde & PT_FLAG_P) == 0:
        return -1
    if (pde & PT_FLAG_PS) != 0:
        return -1
    pt: Ptr[uint64] = cast[Ptr[uint64]](pde & PT_ADDR_MASK)
    flags: uint64 = PT_FLAG_US | PT_FLAG_P | extra_flags
    if want_write != 0:
        flags = flags | PT_FLAG_RW
    pt[pt_idx] = phys | flags
    invlpg_one(va_al)
    return 0


# -----------------------------------------------------------------------
# Huge-page (2 MiB PMD) demand-paging helpers.
# -----------------------------------------------------------------------
#
# These mirror elf_prepare_demand_range / elf_map_one_page but operate at
# PMD (page-directory) granularity so a MAP_HUGETLB anonymous mmap is
# backed by REAL 2 MiB pages (one PS=1 PDE covering 2 MiB, a single TLB
# entry) instead of 512 ordinary 4 KiB PTEs.
#
# elf_prepare_huge_demand_range: ensure the per-task PDPT + PD exist for
# [vlow, vhigh) (2 MiB-aligned) but leave EVERY covering PDE not-present
# (PDE == 0), so a touch fires a NOT-PRESENT #PF that the huge-page fault
# handler resolves with a single 2 MiB PDE. Distinct from the 4 KiB
# prepare in that it stops at the PD level — it never cracks a PDE into a
# 512-entry PT.
#
# Must lie within one 1 GiB PDPT entry (same as the 4 KiB path). vlow and
# vhigh must be 2 MiB-aligned. Returns 0 on success, -1 on OOM / misuse.

def elf_prepare_huge_demand_range(pml4_phys: uint64, vlow: uint64,
                                  vhigh: uint64) -> int32:
    # Boot-CR3 guard (#79) — same rationale as elf_prepare_demand_range:
    # raw-physical page-table cracking must run under the pristine boot
    # CR3's full flat identity so a freshly-allocated intermediate PT-page
    # frame that collides with a not-present live-CR3 VA never #PFs.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_prepare_huge_demand_range_locked(pml4_phys, vlow, vhigh)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_prepare_huge_demand_range_locked(pml4_phys: uint64, vlow: uint64,
                                  vhigh: uint64) -> int32:
    if vlow >= vhigh:
        return 0
    if (vlow & (PAGE_SIZE_2M - 1)) != 0:
        return -1
    if (vhigh & (PAGE_SIZE_2M - 1)) != 0:
        return -1
    pml4_idx_lo: uint64 = (vlow >> 39) & 0x1FF
    pml4_idx_hi: uint64 = ((vhigh - 1) >> 39) & 0x1FF
    pdpt_idx_lo: uint64 = (vlow >> 30) & 0x1FF
    pdpt_idx_hi: uint64 = ((vhigh - 1) >> 30) & 0x1FF
    if pml4_idx_lo != pml4_idx_hi:
        return -1
    if pdpt_idx_lo != pdpt_idx_hi:
        return -1

    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    bsp_pml4: Ptr[uint64] = cast[Ptr[uint64]](
        cow_boot_cr3() & PT_ADDR_MASK)

    # Step 1: ensure a per-task PDPT (clone the shared boot PDPT, or
    # build a fresh one for an absent PML4 slot).
    pml4_entry: uint64 = pml4[pml4_idx_lo]
    if (pml4_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt0: uint64 = alloc_page()
        if new_pdpt0 == 0:
            return -1
        memset(cast[Ptr[uint8]](new_pdpt0), 0, 4096)
        pml4[pml4_idx_lo] = new_pdpt0 \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pml4_entry = pml4[pml4_idx_lo]
    elif pml4_entry == bsp_pml4[pml4_idx_lo]:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt: uint64 = alloc_page()
        if new_pdpt == 0:
            return -1
        old_pdpt_phys: uint64 = pml4_entry & PT_ADDR_MASK
        memcpy(cast[Ptr[uint8]](new_pdpt),
               cast[Ptr[uint8]](old_pdpt_phys), 4096)
        pml4[pml4_idx_lo] = new_pdpt \
            | (pml4_entry & ~PT_ADDR_MASK)
        pml4_entry = pml4[pml4_idx_lo]

    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4_entry & PT_ADDR_MASK)

    # Step 2: crack a PS=1 1 GiB PDPT entry (or build one for an absent
    # entry) into a PD. A present low-RAM 1 GiB page is reproduced as
    # identity 2 MiB pages so kernel reads inside the 1 GiB stay resolvable;
    # an ABSENT high-VA entry yields an empty PD (no wild identity siblings).
    pdpt_entry: uint64 = pdpt[pdpt_idx_lo]
    if (pdpt_entry & PT_FLAG_PS) != 0 or (pdpt_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pd: uint64 = alloc_page()
        if new_pd == 0:
            return -1
        gib_base: uint64 = pdpt_idx_lo * PAGE_SIZE_1G
        _build_pd_from_pdpt_entry(new_pd, pdpt_entry, gib_base)
        pdpt[pdpt_idx_lo] = new_pd \
            | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pdpt_entry = pdpt[pdpt_idx_lo]

    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpt_entry & PT_ADDR_MASK)

    # Step 3: for each 2 MiB slot in [vlow, vhigh), ZERO the PDE so the
    # first access faults NOT-PRESENT. The PD itself was either the
    # boot identity PD (now cloned) or freshly built identity above; we
    # OVERWRITE the covering PDE to 0 so the user huge mapping is demand
    # paged, not the identity 2 MiB page.
    vaddr: uint64 = vlow
    do:
        pd_idx: uint64 = (vaddr >> 21) & 0x1FF
        pd[pd_idx] = 0
        invlpg_one(vaddr)
        vaddr = vaddr + PAGE_SIZE_2M
    while vaddr < vhigh
    return 0


# elf_map_one_huge_pde — install a single 2 MiB PS=1 leaf at the PD level.
#
# The PDPT/PD for `va` must already exist (call
# elf_prepare_huge_demand_range first). Sets the covering PDE to
# (phys | PT_FLAG_PS | PT_FLAG_US | PT_FLAG_P | extra_flags) with
# PT_FLAG_RW added when want_write != 0, and invalidates the TLB entry.
# `phys` must be a 2 MiB-aligned physically-contiguous frame; `va` is
# floored to its 2 MiB boundary. `extra_flags` carries PT_FLAG_NX for a
# data (non-exec) huge mapping, exactly like elf_map_one_page.
#
# Returns 0 on success, -1 if any level is missing or already a PS leaf
# (would mean the prepare step never ran / collided).

def elf_map_one_huge_pde(pml4_phys: uint64, va: uint64,
                         phys: uint64, want_write: int32,
                         extra_flags: uint64) -> int32:
    # Boot-CR3 guard — identical rationale to elf_map_one_page: the raw
    # walk dereferences the task's PDPT/PD frames by bare physical address,
    # which can alias a colliding user mapping under the live task CR3 on a
    # >4 GiB-RAM box. Crack/install the PS=1 PDE under the boot CR3's
    # un-aliased 1 GiB-huge identity.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_map_one_huge_pde_locked(pml4_phys, va, phys,
                                              want_write, extra_flags)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_map_one_huge_pde_locked(pml4_phys: uint64, va: uint64,
                         phys: uint64, want_write: int32,
                         extra_flags: uint64) -> int32:
    va_al: uint64 = va & ~(PAGE_SIZE_2M - 1)
    if (phys & (PAGE_SIZE_2M - 1)) != 0:
        return -1
    pml4_idx: uint64 = (va_al >> 39) & 0x1FF
    pdpt_idx: uint64 = (va_al >> 30) & 0x1FF
    pd_idx:   uint64 = (va_al >> 21) & 0x1FF

    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    pml4e: uint64 = pml4[pml4_idx]
    if (pml4e & PT_FLAG_P) == 0:
        return -1
    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4e & PT_ADDR_MASK)
    pdpte: uint64 = pdpt[pdpt_idx]
    if (pdpte & PT_FLAG_P) == 0:
        return -1
    if (pdpte & PT_FLAG_PS) != 0:
        return -1
    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpte & PT_ADDR_MASK)
    flags: uint64 = PT_FLAG_PS | PT_FLAG_US | PT_FLAG_P | extra_flags
    if want_write != 0:
        flags = flags | PT_FLAG_RW
    pd[pd_idx] = phys | flags
    invlpg_one(va_al)
    return 0


def elf_install_user_range(pml4_phys: uint64, vlow: uint64,
                           vhigh: uint64, phys_base: uint64,
                           label: Ptr[uint8], extra_flags: uint64) -> int32:
    # M16.36: multi-1-GiB-aware wrapper around elf_install_user_mapping.
    #
    # W^X Stage 1a: `extra_flags` is forwarded verbatim to every
    # per-1-GiB elf_install_user_mapping chunk, so each leaf PTE gets
    # OR'd with it. Data callers (stack/brk/anon-mmap) pass PT_FLAG_NX;
    # image/interp callers pass 0 (code stays executable this stage).
    # The underlying installer refuses any range that crosses a 1 GiB
    # PDPT boundary — a hard fail for binaries / heaps / stacks larger
    # than the residual span inside a single PDPT entry. Split the
    # range into per-1-GiB chunks and install each chunk separately so
    # the leaf PTEs land in a (possibly different) per-task PD/PT tree
    # under each PDPT entry.
    #
    # `label` is a NUL-terminated string used in the [elf-map]
    # diagnostic so the boot log says "image" / "interp" / "stack" /
    # "brk" rather than just an address pair.
    if vlow >= vhigh:
        return 0
    # Page-align outward defensively.
    vlo_a:  uint64 = vlow & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi_a:  uint64 = (vhigh + PAGE_SIZE_4K - 1) \
                     & ~cast[uint64](PAGE_SIZE_4K - 1)
    phys_a: uint64 = phys_base - (vlow - vlo_a)
    cur:    uint64 = vlo_a
    while cur < vhi_a:
        # Snap to the end of the current 1 GiB PDPT entry, so each
        # call to elf_install_user_mapping stays inside one PDPT slot.
        gib_end: uint64 = (cur + PAGE_SIZE_1G) \
                          & ~cast[uint64](PAGE_SIZE_1G - 1)
        chunk_end: uint64 = gib_end
        if chunk_end > vhi_a:
            chunk_end = vhi_a
        chunk_phys: uint64 = phys_a + (cur - vlo_a)
        # M16.36 diagnostic: one line per installed sub-range, tagged
        # with `label`, so the boot log proves the per-task PT entries
        # got laid down. The format is split into two printk lines
        # because printk2 takes at most two numeric args and we want
        # the label, vaddr range, AND phys base all visible.
        printk1("[elf-map] %s\n", cast[uint64](label))
        printk2("[elf-map]   vaddr=%p..%p\n", cur, chunk_end)
        printk1("[elf-map]   phys=%p\n", chunk_phys)
        rc: int32 = elf_install_user_mapping(pml4_phys, cur, chunk_end,
                                             chunk_phys, extra_flags)
        if rc < 0:
            printk2("[elf-map] install FAILED @ vaddr=%p phys=%p\n",
                    cur, chunk_phys)
            return -1
        cur = chunk_end
    return 0


def elf_set_range_ro(pml4_phys: uint64, vlow: uint64,
                     vhigh: uint64) -> int32:
    # Boot-CR3 guard (fork/exec image-load keystone, #79). This walk
    # dereferences page-table pages (pml4 / pdpt / pd / pt) as RAW
    # PHYSICAL addresses, relying on a full flat identity map — exactly
    # like elf_install_user_mapping, which switches to the pristine boot
    # CR3 for the same reason. elf_set_range_ro historically did NOT, so
    # it walked under the LIVE task CR3. For a fork-child that has just
    # execve'd a fresh image, the live CR3 (the newly built per-task
    # PML4) no longer flat-identity-maps all of RAM: it has CRACKED its
    # own PML4 subtree for the image / stack / ASLR windows and carries
    # demand-zero (leaf PTE == 0) BSS pages and unmapped ASLR gaps. When
    # a freshly alloc_page()'d intermediate page-table-page frame lands
    # at a PHYSICAL address that numerically coincides with such a
    # not-present VIRTUAL address in the live CR3, the raw deref of that
    # PT page #PF's in kernel mode — err=0 (not-present, read), cr2 =
    # the colliding image-VA-range address, pte = 0 — and the trap-diag
    # HALTS the box. This is the confirmed Firefox child-spawn blocker
    # (child subprocess execve's under the parent's cracked address
    # space). The pristine boot CR3 keeps the ENTIRE physical RAM
    # flat-identity-mapped (every intermediate frame is present), so the
    # walk always resolves. The RO flips still land in `pml4_phys`'s own
    # tables (an explicit arg, unaffected by the CR3 we execute under);
    # per-page invlpg during the walk targets the boot CR3, and the
    # execve caller (do_execve) reloads the live CR3 with load_cr3()
    # right after elf_apply_last_user_mapping returns, flushing every
    # non-global TLB entry — the same TLB-coherence contract
    # elf_install_user_mapping relies on. When boot CR3 == the live CR3
    # (the vDSO / boot-time callers), the switch is a no-op reload and
    # the invlpg hits the right TLB.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _elf_set_range_ro_locked(pml4_phys, vlow, vhigh)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _elf_set_range_ro_locked(pml4_phys: uint64, vlow: uint64,
                     vhigh: uint64) -> int32:
    # W^X Stage 1b: flip every already-installed leaf PTE in
    # [vlow, vhigh) READ-ONLY (clear PT_FLAG_RW) while leaving the page
    # PRESENT, USER, and EXECUTABLE (NX bit untouched -> code stays
    # runnable). Used to harden a loaded image's non-writable
    # (.text/.rodata) PT_LOAD segments AFTER the whole image was mapped
    # RW. A subsequent userland WRITE faults with a genuine (non-COW)
    # protection #PF -> SIGSEGV.
    #
    # The page tables for [vlow, vhigh) must already exist and be mapped
    # (elf_install_user_range ran first). A missing level / not-present
    # PTE for a page in the range is skipped (best-effort hardening,
    # never a hard fail). Each touched page gets an invlpg so the change
    # takes effect on the live CR3 (execve case) immediately. Runs under
    # the pristine boot CR3 — see the elf_set_range_ro wrapper for why.
    if vlow >= vhigh:
        return 0
    vlo_a: uint64 = vlow & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi_a: uint64 = (vhigh + PAGE_SIZE_4K - 1) \
                    & ~cast[uint64](PAGE_SIZE_4K - 1)
    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    va: uint64 = vlo_a
    while va < vhi_a:
        pml4_idx: uint64 = (va >> 39) & 0x1FF
        pdpt_idx: uint64 = (va >> 30) & 0x1FF
        pd_idx:   uint64 = (va >> 21) & 0x1FF
        pt_idx:   uint64 = (va >> 12) & 0x1FF
        pml4e: uint64 = pml4[pml4_idx]
        if (pml4e & PT_FLAG_P) != 0:
            pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4e & PT_ADDR_MASK)
            pdpte: uint64 = pdpt[pdpt_idx]
            if (pdpte & PT_FLAG_P) != 0 and (pdpte & PT_FLAG_PS) == 0:
                pd: Ptr[uint64] = cast[Ptr[uint64]](pdpte & PT_ADDR_MASK)
                pde: uint64 = pd[pd_idx]
                if (pde & PT_FLAG_P) != 0 and (pde & PT_FLAG_PS) == 0:
                    pt: Ptr[uint64] = cast[Ptr[uint64]](
                        pde & PT_ADDR_MASK)
                    pte: uint64 = pt[pt_idx]
                    if (pte & PT_FLAG_P) != 0 and (pte & PT_FLAG_RW) != 0:
                        pt[pt_idx] = pte & ~PT_FLAG_RW
                        invlpg_one(va)
        va = va + PAGE_SIZE_4K
    return 0


def elf_apply_last_user_mapping(pml4_phys: uint64) -> int32:
    # Convenience wrapper used by SYS_SPAWN / SYS_EXECVE: install the
    # per-task PT entries for the most recently loaded ELF image.
    #
    # M16.36: this now ALWAYS installs PTEs for every loaded PT_LOAD
    # span (app + optional PT_INTERP), regardless of ET_EXEC vs ET_DYN.
    # The previous behaviour (only ET_EXEC installed; ET_DYN relied on
    # the inherited BSP 1 GiB identity stamp) silently broke on real
    # hardware whose memblock region landed in a PDPT slot the boot
    # stub couldn't reach with a single 4 GiB PS=1 stamp — the
    # _pgtable_force_stamp_1gb fallback covers the full 512 PDPT
    # entries on the EFI path so reads still resolved, but the user
    # task had no PT entry of its OWN for its code/data pages.
    # Installing here means the [execve-pml4] walk lands on a real
    # 4 KiB PTE rather than a 1 GiB PS=1 page belonging to the kernel
    # identity map.
    #
    # elf_last_needs_user_map is set to 1 by every successful
    # _load_elf64 / elf_load_blob call post-M16.36; the guard below is
    # the legacy compatibility path for any future loader that DOESN'T
    # want a per-task mapping (none in tree today).
    if elf_last_needs_user_map == 0:
        return 0
    # App PT_LOAD span — the application binary's loaded segments.
    # Always non-zero after a successful load.
    if elf_last_app_img_vhigh > elf_last_app_img_vlow:
        if elf_install_user_range(pml4_phys,
                                  elf_last_app_img_vlow,
                                  elf_last_app_img_vhigh,
                                  elf_last_app_img_phys,
                                  "image", PT_FLAG_RW) < 0:
            return -1
    # Interpreter PT_LOAD span — non-zero only when the application
    # was a dynamic ELF (PT_INTERP present). For static binaries the
    # capture left these globals at 0 and we skip silently.
    if elf_last_interp_img_vhigh > elf_last_interp_img_vlow:
        if elf_install_user_range(pml4_phys,
                                  elf_last_interp_img_vlow,
                                  elf_last_interp_img_vhigh,
                                  elf_last_interp_img_phys,
                                  "interp", PT_FLAG_RW) < 0:
            return -1

    # W^X Stage 1b: now that the FULL image span(s) are mapped RW+X,
    # flip the non-writable (.text/.rodata) PT_LOAD segments READ-ONLY.
    # The whole image was installed RW so userspace ld.so / glibc can
    # patch its GOT/.data (those live in PF_W segments, which we leave
    # writable). A userland write to .text now faults -> SIGSEGV.
    ai: uint64 = 0
    while ai < elf_last_app_ro_n:
        printk2("[wx] image .text RO: [%p, %p)\n",
                elf_last_app_ro_lo[ai], elf_last_app_ro_hi[ai])
        elf_set_range_ro(pml4_phys, elf_last_app_ro_lo[ai],
                         elf_last_app_ro_hi[ai])
        ai = ai + 1
    ii: uint64 = 0
    while ii < elf_last_interp_ro_n:
        printk2("[wx] interp .text RO: [%p, %p)\n",
                elf_last_interp_ro_lo[ii], elf_last_interp_ro_hi[ii])
        elf_set_range_ro(pml4_phys, elf_last_interp_ro_lo[ii],
                         elf_last_interp_ro_hi[ii])
        ii = ii + 1
    return 0


def elf_install_user_stack(pml4_phys: uint64, ustack_base: uint64,
                           ustack_size: uint64) -> int32:
    # M16.36: install per-task PT entries for [ustack_base,
    # ustack_base + ustack_size). The user stack is allocated via
    # alloc_pages and was previously reached through the BSP identity
    # stamp (vaddr == phys via the 1 GiB PS=1 page). After this call
    # the stack pages are mapped by a private 4 KiB PTE in the task's
    # own PML4 — so a future Plan-9 lower-half scrub that removes the
    # identity stamp still leaves the stack reachable from CPL=3.
    if ustack_size == 0 or ustack_base == 0:
        return 0
    # W^X Stage 1a: the user stack is pure DATA — never executed. Stamp
    # NX so a jmp/call into the stack faults (SIGSEGV). It is READ/WRITE
    # data, so OR PT_FLAG_RW (the installer no longer implies it).
    return elf_install_user_range(pml4_phys, ustack_base,
                                  ustack_base + ustack_size,
                                  ustack_base, "stack",
                                  PT_FLAG_NX | PT_FLAG_RW)


def elf_install_user_heap(pml4_phys: uint64, brk_base: uint64,
                          brk_size: uint64, phys_base: uint64) -> int32:
    # M16.36: install per-task PT entries for the brk heap. Called
    # from u_syscalls._u_brk on the lazy initial reservation.
    #
    # DIRECT-MAP ALIASING FIX (2026-06-19): the brk arena's USER virtual
    # base (brk_base) is now DECOUPLED from its physical backing
    # (phys_base, the low alloc_pages reservation). Previously brk ran
    # identity (vaddr == phys) at LOW RAM, so the 32 MiB heap window
    # aliased the very physical frames the buddy/page allocator hands
    # back to the kernel — the ET_DYN-vs-direct-map #PF family: a punched
    # / cracked low-identity PTE in this task's per-task PD/PT, plus a
    # frame the allocator later re-issues to the kernel, collide and the
    # supervisor write faults (cr2 LOW, pte[0]=0). Placing brk at a HIGH
    # virtual base (above the 4 GiB direct-map, alongside the ET_DYN /
    # interp ASLR windows) means the cracked-PT identity seed in this
    # range now points at HIGH (nonexistent) phys that nothing accesses,
    # and the user PTEs map high-VA -> low-phys. The kernel still reaches
    # those low frames through the SHARED boot identity map (US=0) at
    # their low address — a DIFFERENT PTE from the user mapping — so no
    # frame is simultaneously a live writable user mapping AND a free /
    # kernel-direct-map-writable frame at the SAME translation.
    #
    # elf_install_user_range already supports phys_base != vlow (it
    # computes chunk_phys = phys_base + (vaddr - vlow) per page), so the
    # high-VA mapping needs no new machinery here.
    if brk_size == 0 or brk_base == 0:
        return 0
    # W^X Stage 1a: the brk heap is DATA — stamp NX (no exec-from-heap).
    # It is READ/WRITE data, so OR PT_FLAG_RW too.
    return elf_install_user_range(pml4_phys, brk_base,
                                  brk_base + brk_size,
                                  phys_base, "brk",
                                  PT_FLAG_NX | PT_FLAG_RW)


def elf_last_needs_user_map_get() -> int32:
    # Accessor for the caller — saves a direct module-global read at
    # the call site without exporting elf_last_needs_user_map itself.
    return elf_last_needs_user_map


def elf_last_img_lo_get() -> uint64:
    # Accessor: page-aligned low vaddr of the most-recently-loaded ELF
    # image. do_execve stashes this on the task so fork can copy it.
    return elf_last_img_lo


def elf_last_img_hi_get() -> uint64:
    # Accessor: page-aligned high vaddr of the most-recently-loaded ELF
    # image.
    return elf_last_img_hi


def elf_last_interp_img_vlow_get() -> uint64:
    # Accessor: page-aligned low USER vaddr of the most-recently-loaded
    # PT_INTERP (ld.so) image span. do_execve stashes [vlow, vhigh) on the
    # task (set_task_interp_range) so do_clone can COW-share the interp
    # window into a fork child — without it the child's cloned PML4 keeps
    # the boot identity PS=1 (US=0) huge page covering the interp ASLR
    # window and any CPL=3 ld.so access faults (err=0x05). 0 on a static
    # binary (no PT_INTERP).
    return elf_last_interp_img_vlow


def elf_last_interp_img_vhigh_get() -> uint64:
    # Accessor: page-aligned high USER vaddr (exclusive) of the
    # most-recently-loaded PT_INTERP image span. 0 on a static binary.
    return elf_last_interp_img_vhigh


def elf_last_app_bss_lo_get() -> uint64:
    # DEMAND-BSS accessor: low USER vaddr of the most-recently-loaded
    # application image's demand-zero BSS tail. do_execve passes this to
    # vma_register_bss_demand after installing the eager file-backed
    # image. 0 (== bss_hi) when the image has no BSS tail.
    return elf_last_app_bss_lo


def elf_last_app_bss_hi_get() -> uint64:
    # DEMAND-BSS accessor: high USER vaddr (exclusive) of the demand-zero
    # BSS tail. The range [lo, hi) is registered as an anon RW NX demand
    # VMA so do_page_fault zero-fills it lazily, page by page.
    return elf_last_app_bss_hi


def elf32_wx_span_reset_selftest(blob: Ptr[uint8],
                                 blob_size: uint64) -> int32:
    # Regression for the PID-1 rfork-COW fatal #PF (scripts/test_rfork_pid1_cow.sh).
    #
    # ROOT CAUSE the fix guards: the ELF32 branch of elf_load_blob() used
    # to leave the W^X read-only-span globals (elf_last_app_ro_n /
    # elf_last_interp_ro_n) untouched. Those globals are populated ONLY by
    # the ELF64 loader (_collect_app_ro_spans). So if any Linux-ABI ELF64
    # binary loaded before a native ELF32 binary, the ELF32 image inherited
    # the ELF64's stale RO spans; elf_apply_last_user_mapping()'s W^X
    # Stage-1b pass then flipped those stale user vaddrs READ-ONLY inside
    # the ELF32 image's PML4. When a stale span overlapped the ELF32
    # image's region_alloc()'d base, a .data/.bss page was left
    # present+RO+non-COW — and the image's first rfork() COW-shared it
    # verbatim-RO, so the child's first write to it took a fatal,
    # unresolvable #PF (P=1,W=1,U=1, no COW bit).
    #
    # This self-test reproduces the contamination deterministically and
    # asserts the fix's invariant: load an ELF32 blob AFTER planting a
    # bogus non-zero RO-span count, and require that the loader has reset
    # it to 0. Returns 1 on PASS, 0 on FAIL.
    #
    # BEFORE the fix this returns 0 (the planted spans survive the load);
    # AFTER the fix it returns 1 (the ELF32 path zeroes them).
    if blob == cast[Ptr[uint8]](0) or blob_size < 52:
        printk0("[rfork-cow] FAIL: bad ELF32 blob for self-test\n")
        return 0
    # Plant a bogus stale RO span as if an ELF64 binary loaded first.
    elf_last_app_ro_n     = 1
    elf_last_app_ro_lo[0] = 0x1000
    elf_last_app_ro_hi[0] = 0x2000
    elf_last_interp_ro_n  = 1
    elf_last_interp_ro_lo[0] = 0x1000
    elf_last_interp_ro_hi[0] = 0x2000
    printk2("[rfork-cow] planted stale RO spans: app_ro_n=%d interp_ro_n=%d\n",
            elf_last_app_ro_n, elf_last_interp_ro_n)
    # Load the native ELF32 image; the fix must clear the spans.
    entry: uint64 = elf_load_blob(blob, blob_size)
    if entry == 0:
        printk0("[rfork-cow] FAIL: ELF32 load returned 0\n")
        return 0
    printk2("[rfork-cow] post-load RO spans: app_ro_n=%d interp_ro_n=%d\n",
            elf_last_app_ro_n, elf_last_interp_ro_n)
    if elf_last_app_ro_n != 0 or elf_last_interp_ro_n != 0:
        printk0("[rfork-cow] FAIL: stale W^X RO spans survived ELF32 load (child rfork would fault verbatim-RO)\n")
        return 0
    printk0("[rfork-cow] PASS: ELF32 load reset W^X RO spans to 0\n")
    return 1


def elf_last_img_phys_get() -> uint64:
    # Accessor: PHYSICAL base of the region_alloc'd backing chunk for the
    # most-recently-loaded ELF image. For ET_EXEC the image runs at its
    # link-time vaddr (elf_last_img_lo) but its bytes physically live
    # here; for ET_DYN / native ELF32 vaddr == phys == this. SYS_SPAWN /
    # do_execve records it on the task (set_task_image_phys) so task_reap
    # can return the region to the pool. The byte size is
    # elf_last_img_hi_get() - elf_last_img_lo_get() (a page-aligned span
    # that is identical in the virtual and physical dimensions).
    return elf_last_user_phys_base


def elf_last_interp_img_phys_get() -> uint64:
    # Accessor: PHYSICAL base of the region_alloc'd backing chunk for the
    # interpreter (ld-linux) image of the most-recently-loaded DYNAMIC
    # ELF. 0 on the static path (no PT_INTERP), which the loader scrubs
    # via elf_last_interp_img_phys = 0 on every static load. SYS_SPAWN /
    # do_execve records it on the OWNING task (set_task_interp_phys) so
    # task_reap returns the interp region to the pool exactly like the
    # main image — closing the per-dynamic-spawn interp leak. The byte
    # size is elf_last_interp_img_sz_get().
    return elf_last_interp_img_phys


def elf_last_interp_img_sz_get() -> uint64:
    # Accessor: byte span of the interpreter image region. The interp is
    # loaded as ET_DYN, so its [vlow, vhigh) == [region, region+span);
    # the difference is the exact page-aligned span region_alloc carved
    # (and the one task_reap must hand back via region_free). 0 when no
    # interp was loaded (static binary), matching elf_last_interp_img_phys.
    if elf_last_interp_img_vhigh > elf_last_interp_img_vlow:
        return elf_last_interp_img_vhigh - elf_last_interp_img_vlow
    return 0


# ---------------------------------------------------------------------
# Per-process address space — fork()'s private-copy machinery.
# ---------------------------------------------------------------------
#
# vm_fork_copy_range() is the keystone of a real per-process address
# space. Given a CHILD PML4 and a virtual range [vlo, vhi) that the
# PARENT currently owns, it:
#
#   1. allocates fresh physical pages (in <=4 MiB alloc_pages chunks,
#      since the buddy allocator's MAX_ORDER caps a single request at
#      4 MiB),
#   2. copies the parent's bytes from [vlo, vhi) into those pages
#      (the kernel reads the parent range at its identity vaddr —
#      every region we copy is identity-mapped, so a plain memcpy from
#      the vaddr reads the parent's physical bytes),
#   3. installs a mapping into the CHILD's PML4 that re-points the
#      SAME virtual range [vlo, vhi) at the freshly-copied physical
#      pages.
#
# After this the child, running on its own PML4, sees the identical
# virtual addresses the parent does — so every absolute pointer the
# child inherited (saved %rbp, return addresses, glibc FILE structs,
# the TCB) stays valid — but every WRITE lands in the child's private
# physical memory. Parent and child no longer trample each other.
#
# This reuses elf_install_user_mapping's page-table walker, which
# already knows how to crack the BSP's shared 1 GiB / 2 MiB identity
# entries into per-task 4 KiB PTEs inside one task's PML4 without
# disturbing the kernel half or any other task.
#
# Returns 0 on success, -1 on OOM / a range elf_install_user_mapping
# refuses (kernel-image collision, or a range that spans a 1 GiB
# boundary — neither happens for the regions fork copies, all of which
# are single allocator chunks well clear of the kernel image).

# 4 MiB — one MAX_ORDER alloc_pages chunk. Copy bigger ranges piecewise.
VM_FORK_CHUNK: uint64 = 0x400000


def vm_fork_copy_range(child_pml4: uint64, vlo_in: uint64,
                       vhi_in: uint64) -> int32:
    # Page-align the range outward so partial pages at either end are
    # still fully backed (callers pass already-aligned ranges, but a
    # defensive round keeps the PT walker's alignment asserts happy).
    if vhi_in <= vlo_in:
        return 0
    vlo: uint64 = vlo_in & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi: uint64 = (vhi_in + PAGE_SIZE_4K - 1) \
                  & ~cast[uint64](PAGE_SIZE_4K - 1)
    cur: uint64 = vlo
    do:
        chunk: uint64 = vhi - cur
        if chunk > VM_FORK_CHUNK:
            chunk = VM_FORK_CHUNK
        # alloc_pages takes a buddy order; size up to the next power of
        # two number of pages that covers `chunk`.
        pages_needed: uint64 = chunk / PAGE_SIZE_4K
        order: int32 = 0
        cap: uint64 = 1
        while cap < pages_needed:
            cap = cap * 2
            order = order + 1
        pa_set_site(PA_SITE_FORK_COPY)
        phys: uint64 = alloc_pages(order)
        if phys == 0:
            printk1("vm_fork: OOM copying range chunk size=%d\n", chunk)
            return -1
        # Copy the parent's bytes. Parent's [cur, cur+chunk) is
        # identity-mapped, so reading from the vaddr reads parent
        # physical memory directly. SMAP v3c: `cur` is a user vaddr
        # (US=1), so CPL=0 reads need STAC. Live fork uses the COW
        # path (vm_cow_share_all) — this branch is the legacy eager
        # copy, kept correct under SMAP for completeness.
        _ua_stac()
        memcpy(cast[Ptr[uint8]](phys),
               cast[Ptr[uint8]](cur), chunk)
        _ua_clac()
        # Remap [cur, cur+chunk) -> phys in the CHILD's PML4 only.
        # extra_flags=PT_FLAG_RW: this eager-copy fork path is legacy (no
        # live caller — fork goes through vm_cow_share_all, which
        # preserves NX). The regions it copies (image/brk/stack) are
        # writable, and the installer no longer implies RW, so OR it in.
        # Kept executable (no NX) to match its historical behaviour.
        rc: int32 = elf_install_user_mapping(child_pml4, cur,
                                             cur + chunk, phys,
                                             PT_FLAG_RW)
        if rc < 0:
            printk2("vm_fork: install failed for [0x%x, 0x%x)\n",
                    cur, cur + chunk)
            return -1
        cur = cur + chunk
    while cur < vhi
    return 0


def vm_fork_install_all(child_pml4: uint64,
                        img_lo: uint64, img_hi: uint64,
                        brk_lo: uint64, brk_max: uint64,
                        ust_lo: uint64, ust_sz: uint64,
                        sp_fallback: uint64) -> int32:
    # One-shot: give a forked child a PRIVATE physical copy of the
    # three fixed writable regions — the loaded ELF image, the brk
    # heap, and the user stack — each remapped at the SAME virtual
    # address in the child's PML4. (mmap VMAs are copied separately by
    # mm/vma.ad::vma_fork_copy, which the caller invokes too.)
    #
    # Any region whose range is unset (lo == 0 or empty) is skipped:
    #   * a native Hamnix ELF32 binary has no recorded image span,
    #   * a process that never called brk() has brk_lo == 0,
    #   * a task with no recorded stack region falls back to copying
    #     the single page around sp_fallback (the user RSP) so the
    #     child at least doesn't alias the parent's live frame.
    #
    # Returns 0 on success, -1 on OOM / a refused mapping. Shared by
    # do_clone (Linux fork) and do_rfork (Plan 9 rfork).
    if img_lo != 0 and img_hi > img_lo:
        if vm_fork_copy_range(child_pml4, img_lo, img_hi) < 0:
            return -1
    if brk_lo != 0 and brk_max > brk_lo:
        if vm_fork_copy_range(child_pml4, brk_lo, brk_max) < 0:
            return -1
    if ust_lo != 0 and ust_sz != 0:
        if vm_fork_copy_range(child_pml4, ust_lo, ust_lo + ust_sz) < 0:
            return -1
    elif sp_fallback != 0:
        sp_pg: uint64 = sp_fallback & ~cast[uint64](PAGE_SIZE_4K - 1)
        if vm_fork_copy_range(child_pml4, sp_pg,
                              sp_pg + PAGE_SIZE_4K) < 0:
            return -1
    return 0


def vm_fork_copy_install(child_pml4: uint64, vlo: uint64,
                         vhi: uint64, phys_base: uint64) -> int32:
    # Thin wrapper: the caller already allocated `phys_base` and copied
    # the parent's bytes into it; this just installs the same-vaddr
    # remapping into the child's PML4. Used by mm/vma.ad's per-VMA
    # fork copy, where the VmaNode's own page-allocation already
    # produced the physical backing.
    if vhi <= vlo:
        return 0
    vlo_a: uint64 = vlo & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi_a: uint64 = (vhi + PAGE_SIZE_4K - 1) \
                    & ~cast[uint64](PAGE_SIZE_4K - 1)
    # The per-VMA fork copy reproduces a writable private copy; the
    # installer no longer implies RW, so OR PT_FLAG_RW. (NX is not
    # tracked on this legacy path; the live COW fork path preserves it.)
    return elf_install_user_mapping(child_pml4, vlo_a, vhi_a,
                                    phys_base, PT_FLAG_RW)


# ---------------------------------------------------------------------
# Copy-on-write fork — vm_cow_share_range + the #PF resolver helpers.
# ---------------------------------------------------------------------
#
# Instead of eager-copying every writable user page on fork, COW shares
# the parent's physical pages with the child and defers the copy to the
# first write fault. vm_cow_share_range() walks a virtual range and, for
# every present user page:
#
#   1. ensures BOTH the parent's and the child's PML4 have a private,
#      4 KiB-granular PTE for that page (cracking the BSP-shared 1 GiB /
#      2 MiB identity entries — exactly what elf_install_user_mapping
#      already does, factored here into _cow_resolve_pte_slot),
#   2. points the child's PTE at the SAME physical page the parent maps,
#   3. clears RW and sets the COW bit (PTE bit 9) in BOTH PTEs,
#   4. bumps the page's COW refcount (mm/cow.ad),
#   5. invalidates the parent's stale (writable) TLB entry.
#
# After this the parent and child share read-only physical pages; the
# first write by either side faults into do_cow_page_fault (see
# arch/x86/kernel/trap_diag.ad) which performs the actual copy.
#
# A page that is ALREADY COW-marked in the parent (a grandchild fork of
# a page the parent itself COW-shares with a sibling) is handled
# correctly: the parent PTE is left as-is (already RO+COW), the child
# gets the same RO+COW PTE, and the refcount is bumped — three+ way
# sharing.

# Software COW marker bit in a PTE — mirror mm/cow.ad's COW_PTE_BIT.
PT_FLAG_COW: uint64 = 0x200


def _cow_resolve_pte_slot(pml4_phys: uint64, vaddr: uint64) -> uint64:
    # Boot-CR3 guard (>4 GiB-RAM aliasing) — SELF-PROTECTING. This crack walk
    # dereferences (and clones, via alloc_page + memcpy) the task's PDPT/PD/PT
    # pages by BARE physical address through the low-mem identity window. On a
    # >4 GiB box an intermediate PT page can live in high RAM whose identity is
    # aliased by a live user mapping under whatever task CR3 is active — so a
    # raw pml4[]/pdpt[]/pd[] read #PFs (the Firefox 6 GiB crash: this crack
    # faulting at ~4.6 GiB during exec). Most callers already bracket, but
    # some reach here under the live task CR3 (and the fork-share helpers
    # switch to parent_pml4 mid-walk); rather than audit every path, run the
    # WALK+CRACK under the boot CR3's un-aliased 1 GiB-huge identity here. The
    # wrapper saves+restores the caller's CR3, so a caller that already holds
    # the boot CR3 nests harmlessly and one under the task CR3 gets its CR3
    # back on return. alloc_page (table cracking) is non-sleeping, so IRQs-off
    # is safe (same rationale as vm_protect_range / cow_handle_write_fault).
    # NOTE: the RETURNED leaf slot is still reached through the identity
    # window; a caller that dereferences it must bracket that deref itself
    # (all present deref callers do — via their own boot-CR3 wrappers).
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irqf: uint64 = 0
    if _boot_cr3 != 0:
        _irqf = local_irq_save()
        load_cr3(_boot_cr3)
    _r: uint64 = _cow_resolve_pte_slot_locked(pml4_phys, vaddr)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irqf)
    return _r


def _cow_resolve_pte_slot_locked(pml4_phys: uint64, vaddr: uint64) -> uint64:
    # Return the ADDRESS of the 4 KiB PTE slot mapping `vaddr` inside
    # `pml4_phys`, cracking any BSP-shared 1 GiB / 2 MiB identity
    # entries along the way so the write lands ONLY in this task's
    # address space. Returns 0 on OOM. Callers go through the boot-CR3
    # -bracketed _cow_resolve_pte_slot wrapper above.
    #
    # This is the per-page distillation of elf_install_user_mapping's
    # Step 1..3 table-cracking walk. We deliberately do NOT touch the
    # PTE's contents — the caller decides what to write.
    #
    # CRITICAL: the "is this entry still the shared boot mapping?" test
    # compares against the PRISTINE BOOT page tables (cow_boot_cr3(),
    # snapshotted before any task existed) — NOT get_bsp_cr3(), which
    # is misnamed and actually returns the LIVE %cr3. With the live
    # CR3, comparing a child PML4 against "the current task's" (the
    # parent's, already-cracked) PML4 gave wrong answers: the child
    # skipped the clone and inherited the PARENT's private PDPT/PD/PT,
    # so resolving a COW fault in the child trampled the parent's PTEs.
    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    bsp_pml4: Ptr[uint64] = cast[Ptr[uint64]](
        cow_boot_cr3() & PT_ADDR_MASK)

    pml4_idx: uint64 = (vaddr >> 39) & 0x1FF
    pdpt_idx: uint64 = (vaddr >> 30) & 0x1FF
    pd_idx:   uint64 = (vaddr >> 21) & 0x1FF
    pt_idx:   uint64 = (vaddr >> 12) & 0x1FF

    # --- Step 1: private PDPT ---------------------------------------
    # POISONED-PTE FIX (all-ones leaf on high-ASLR layouts): an ABSENT PML4
    # entry (P=0) — the common case when mapping a user vaddr in a high PML4
    # slot the boot tables never populated (ET_DYN load-bias / mmap-base
    # ASLR) — must yield a FRESH ZEROED PDPT. The old code took the `==
    # bsp_pml4[idx]` branch (0 == 0 for a slot absent in BOTH the task and
    # the pristine boot tables) and memcpy'd from (pml4_entry & PT_ADDR_MASK)
    # == physical page 0 (BIOS IVT/BDA) into the new PDPT, seeding present-
    # looking PDPT entries with garbage/reserved bits that the crack helpers
    # then reproduced into every leaf → a reserved-bit (all-ones) leaf PTE
    # and an RSVD #PF. Zero the fresh PDPT for an absent slot; only memcpy-
    # clone when the slot genuinely still shares the PRESENT boot PDPT.
    pml4_entry: uint64 = pml4[pml4_idx]
    if (pml4_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt0: uint64 = alloc_page()
        if new_pdpt0 == 0:
            return 0
        memset(cast[Ptr[uint8]](new_pdpt0), 0, 4096)
        pml4[pml4_idx] = new_pdpt0 \
                         | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pml4_entry = pml4[pml4_idx]
    elif pml4_entry == bsp_pml4[pml4_idx]:
        pa_set_site(PA_SITE_PGTABLE)
        new_pdpt: uint64 = alloc_page()
        if new_pdpt == 0:
            return 0
        old_pdpt_phys: uint64 = pml4_entry & PT_ADDR_MASK
        memcpy(cast[Ptr[uint8]](new_pdpt),
               cast[Ptr[uint8]](old_pdpt_phys), 4096)
        # Preserve the original entry's flags, but FORCE present + user +
        # writable on the new PML4 entry (a present boot entry already has
        # them). The leaf PTE carries the real per-page permission
        # (US/RW/NX); the intermediate must merely be traversable.
        pml4[pml4_idx] = new_pdpt | (pml4_entry & ~PT_ADDR_MASK) \
                         | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pml4_entry = pml4[pml4_idx]

    pdpt: Ptr[uint64] = cast[Ptr[uint64]](pml4_entry & PT_ADDR_MASK)

    # --- Step 2: PDPT[idx] -> a PD (crack a 1 GiB PS=1 entry) -------
    # Reproduce the old entry (identity for a low-RAM boot 1 GiB page;
    # EMPTY for an absent high-VA window) instead of always identity. An
    # ASLR'd PIE above 4 GiB hits an absent PDPT entry; the old identity
    # backfill gave every 2 MiB sibling a wild 1:1 frame, so a fork child
    # reading/faulting an un-shared sibling resolved garbage. Empty leaves
    # make those siblings fault; the per-page COW share installs the real
    # leaf for the target page.
    pdpt_entry: uint64 = pdpt[pdpt_idx]
    if (pdpt_entry & PT_FLAG_PS) != 0 or (pdpt_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pd: uint64 = alloc_page()
        if new_pd == 0:
            return 0
        gib_base: uint64 = pdpt_idx * PAGE_SIZE_1G
        _build_pd_from_pdpt_entry(new_pd, pdpt_entry, gib_base)
        pdpt[pdpt_idx] = new_pd | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pdpt_entry = pdpt[pdpt_idx]

    pd: Ptr[uint64] = cast[Ptr[uint64]](pdpt_entry & PT_ADDR_MASK)

    # --- Step 3: PD[idx] -> a PT (crack a 2 MiB PS=1 entry) ---------
    # COW-correctness: seed the new PT by reproducing whatever the OLD pd
    # entry actually mapped (_build_pt_from_pd_entry), NOT a vaddr==phys
    # identity fill. For a low-RAM boot-identity huge page this is identical
    # to the old identity seed; for an ASLR'd high-VA PIE whose covering
    # boot PD entry is ABSENT, identity-seeding handed every SIBLING page in
    # the 2 MiB chunk a wild present frame — so a fork child reading any of
    # those siblings (or faulting a not-yet-shared sibling) resolved garbage
    # instead of faulting. Reproducing the old entry yields real phys for a
    # present huge page and NOT-PRESENT leaves for an absent entry, so the
    # caller's per-page write lands correctly and untouched siblings fault.
    pd_entry: uint64 = pd[pd_idx]
    if (pd_entry & PT_FLAG_PS) != 0 or (pd_entry & PT_FLAG_P) == 0:
        pa_set_site(PA_SITE_PGTABLE)
        new_pt: uint64 = alloc_page()
        if new_pt == 0:
            return 0
        mib2_base: uint64 = (vaddr >> 21) << 21
        _build_pt_from_pd_entry(new_pt, pd_entry, mib2_base)
        pd[pd_idx] = new_pt | PT_FLAG_US | PT_FLAG_RW | PT_FLAG_P
        pd_entry = pd[pd_idx]

    pt: Ptr[uint64] = cast[Ptr[uint64]](pd_entry & PT_ADDR_MASK)
    return cast[uint64](pt) + pt_idx * 8


def vm_map_user_page(pml4_phys: uint64, vaddr: uint64, phys: uint64,
                     writable: int32) -> int32:
    # Install a single 4 KiB user PTE mapping `vaddr` -> `phys` in
    # `pml4_phys`, cracking any covering huge pages along the way. The
    # mapping is present + user-accessible; RW is set iff `writable`.
    # This is the GENERAL primitive that makes user vaddr != phys
    # possible — the uaccess layer's proof test uses it to install a
    # deliberately non-identity mapping, and the ELF/mmap ASLR paths use
    # it to place an image or anonymous region at a randomized virtual
    # base over its physical backing.
    #
    # Returns 0 on success, -1 on OOM cracking the page tables.
    slot: uint64 = _cow_resolve_pte_slot(pml4_phys, vaddr)
    if slot == 0:
        return -1
    flags: uint64 = PT_FLAG_US | PT_FLAG_P
    if writable != 0:
        flags = flags | PT_FLAG_RW
    cast[Ptr[uint64]](slot)[0] = (phys & PT_ADDR_MASK) | flags
    invlpg_one(vaddr)
    return 0


def vm_unmap_user_page(pml4_phys: uint64, vaddr: uint64) -> int32:
    # ZAP a single 4 KiB user PTE: clear the leaf entry mapping `vaddr` in
    # `pml4_phys` and flush it. The inverse of vm_map_user_page, and the
    # ZAP-BEFORE-FREE half of any caller that installed a mapping by hand —
    # freeing a frame whose PTE is still present is how earlier passes handed
    # a live mapping back to the buddy allocator.
    #
    # Deliberately does NOT free the frame or the intermediate tables: the
    # caller owns the frame (it supplied the phys) and the tables stay for
    # the task's own teardown. Returns 0 if a slot existed and was cleared,
    # -1 if the VA has no 4 KiB leaf slot (nothing to zap).
    slot: uint64 = _cow_resolve_pte_slot(pml4_phys, vaddr)
    if slot == 0:
        return -1
    cast[Ptr[uint64]](slot)[0] = 0
    invlpg_one(vaddr)
    return 0


def _cow_probe_leaf(pml4_phys: uint64, vaddr: uint64) -> uint64:
    # READ-ONLY (never allocates, never cracks) page-table walk: return the
    # effective leaf entry mapping `vaddr` in `pml4_phys`, or 0 when the VA
    # is not mapped at any level. A huge (PS=1) entry is returned as-is —
    # callers only test PT_FLAG_P / PT_FLAG_US on it. Used by the fork
    # COW-share path to decide whether the CHILD has an inherited mapping
    # worth clearing WITHOUT paying a table crack for every sparse page.
    #
    # Caller must already hold the boot CR3 (every caller here does: the
    # fork-share helpers are bracketed by vm_cow_share_range /
    # vm_cow_share_all).
    pml4: Ptr[uint64] = cast[Ptr[uint64]](pml4_phys)
    e: uint64 = pml4[(vaddr >> 39) & 0x1FF]
    if (e & PT_FLAG_P) == 0:
        return 0
    pdpt: Ptr[uint64] = cast[Ptr[uint64]](e & PT_ADDR_MASK)
    e = pdpt[(vaddr >> 30) & 0x1FF]
    if (e & PT_FLAG_P) == 0:
        return 0
    if (e & PT_FLAG_PS) != 0:
        return e
    pd: Ptr[uint64] = cast[Ptr[uint64]](e & PT_ADDR_MASK)
    e = pd[(vaddr >> 21) & 0x1FF]
    if (e & PT_FLAG_P) == 0:
        return 0
    if (e & PT_FLAG_PS) != 0:
        return e
    pt: Ptr[uint64] = cast[Ptr[uint64]](e & PT_ADDR_MASK)
    return pt[(vaddr >> 12) & 0x1FF]


def _cow_share_one_page(parent_pml4: uint64, child_pml4: uint64,
                        vaddr: uint64) -> int32:
    # COW-share the single page at `vaddr`. Returns 0 on success,
    # -1 on OOM (the caller aborts the fork).
    pslot: uint64 = _cow_resolve_pte_slot(parent_pml4, vaddr)
    if pslot == 0:
        return -1
    parent_pte: uint64 = cast[Ptr[uint64]](pslot)[0]
    # Not present -> nothing mapped here in the PARENT.
    #
    # DEMAND-VMA FORK FIX (idle-CPU hang: the VT login shells pegged a core
    # each, forever). "Nothing mapped in the parent" is NOT the same as
    # "nothing mapped in the child". The child's PML4 is cloned from the
    # PRISTINE BOOT tables, so over any LOW user VA it still carries the
    # boot IDENTITY mapping (phys == vaddr, P=1 RW=1 **US=0**), and
    # _cow_resolve_pte_slot's crack of a covering 2 MiB/1 GiB identity huge
    # page REPRODUCES those identity leaves into the child's fresh PT
    # (_build_pt_from_pd_entry). A page the parent had NOT yet faulted in —
    # every untouched page of a demand-zero BSS VMA, which for a big static
    # binary is megabytes — was therefore left PRESENT-but-supervisor in the
    # child. Consequences, both observed on the shipped desktop image:
    #
    #   * a CPL=3 WRITE takes #PF err=0x07 (P=1 W=1 U=1). It is not a COW
    #     leaf (cow_handle_write_fault returns 0) and it is not stale-RO
    #     (RW is already 1), so nothing resolves it and the faulting
    #     instruction re-runs forever — an unkillable 100 %-CPU fault loop
    #     (hamsh spinning at v_render_str_only's render_sub store).
    #   * a KERNEL-side access (uaccess / a read(2) into that buffer) is
    #     CPL=0 and does NOT fault: it silently reads/writes IDENTITY RAM
    #     at phys == vaddr — arbitrary physical memory — which is where the
    #     shell's "garbage console input" (bytes lifted out of an unrelated
    #     in-RAM copy of its own binary) came from.
    #
    # So an unmapped-in-the-parent page must be made UNMAPPED IN THE CHILD
    # too; only then does the child's first touch take the ordinary
    # not-present demand fault its VMA is registered for. Probe first
    # (_cow_probe_leaf never allocates) so a sparse high-VA range still
    # costs nothing; crack + clear only where an inherited mapping is
    # genuinely present.
    if (parent_pte & PT_FLAG_P) == 0:
        cprobe: uint64 = _cow_probe_leaf(child_pml4, vaddr)
        if (cprobe & PT_FLAG_P) == 0:
            return 0
        cslot0: uint64 = _cow_resolve_pte_slot(child_pml4, vaddr)
        if cslot0 == 0:
            return -1
        if (cast[Ptr[uint64]](cslot0)[0] & PT_FLAG_P) != 0:
            cast[Ptr[uint64]](cslot0)[0] = 0
            invlpg_one(vaddr)
        return 0
    phys: uint64 = parent_pte & PT_ADDR_MASK
    cslot: uint64 = _cow_resolve_pte_slot(child_pml4, vaddr)
    if cslot == 0:
        return -1

    # W^X Stage 1b: a parent page that is ALREADY read-only (RW=0) but
    # NOT COW-marked is a W^X CODE page (.text/.rodata flipped RO at
    # execve time). It must NOT be turned into a COW page: a write to it
    # is a genuine W^X violation that has to deliver SIGSEGV, never be
    # silently COW-copied. Share it into the child verbatim (same phys,
    # RO, no COW) and leave the parent untouched.
    #
    # FORK+EXEC ISOLATION FIX: we MUST still take a per-PFN refcount on
    # the verbatim-shared RO page. _cow_share_one_page serves TWO callers
    # with OPPOSITE teardown contracts:
    #
    #   (a) vm_cow_share_all over the region-owned ELF IMAGE / interp /
    #       user stack. A fork child carries image_phys/interp_phys == 0
    #       and NEVER frees those regions; the owning parent reclaims them
    #       with region_free at task_reap, which does NOT consult the COW
    #       refcount. So an extra refcount here is inert for this path.
    #
    #   (b) vm_cow_share_range over MMAP VMAs (ld.so's libc.so.6 et al.).
    #       vma_fork_copy flags the child's mirror node is_cow, and
    #       _vma_node_free -> _vma_free_cow_range routes EVERY present
    #       frame of that node through cow_drop_page at exec/reap teardown.
    #       A verbatim-RO mmap frame left un-refcounted is "untracked"
    #       (refcount 0): the child's cow_drop_page returns 1 and
    #       free_page()s a frame the PARENT STILL MAPS — the parent then
    #       reads a torn pointer out of the freed-then-reused libc/.text
    #       page after the child reaps (the fork+exec COW corruption this
    #       fixes; reproduced by scripts/test_dynamic_forkexec.sh).
    #
    # Taking the refcount makes the child's teardown drop 2 -> 1 (the
    # parent keeps the frame), exactly like a writable COW page. The page
    # stays RO + non-COW, so a write is still a genuine W^X SIGSEGV, never
    # a silent COW copy — the W^X contract is preserved.
    if (parent_pte & PT_FLAG_RW) == 0 \
            and (parent_pte & PT_FLAG_COW) == 0:
        ro_flags: uint64 = parent_pte & ~PT_ADDR_MASK
        cast[Ptr[uint64]](cslot)[0] = phys | ro_flags
        cow_set_arm(COW_ARM_SHARE_WX_RO)
        cow_share_page(phys)
        return 0

    # The flag word the COW-shared PTE carries: present + user, COW
    # bit set, RW CLEARED. Preserve any other low flag bits the parent
    # PTE had (PCD/PWT/etc.) but force-clear RW and force-set COW.
    parent_flags: uint64 = parent_pte & ~PT_ADDR_MASK
    cow_flags: uint64 = (parent_flags & ~PT_FLAG_RW) \
                        | PT_FLAG_COW | PT_FLAG_P | PT_FLAG_US

    # Child PTE -> same physical page, read-only, COW-marked.
    cast[Ptr[uint64]](cslot)[0] = phys | cow_flags
    # Parent PTE -> drop RW, set COW (idempotent if already COW).
    cast[Ptr[uint64]](pslot)[0] = phys | cow_flags

    # Account the new sharer. If the parent page was already COW
    # (refcount >= 2) this bumps it by one; otherwise it goes 0 -> 2
    # (parent + child).
    # Attribute this share to the SPAN vm_cow_share_all is currently walking
    # (leak pass 14). Defaults to the unsplit arm 2 for every other caller —
    # notably vma_fork_copy's mmap-VMA share — so the split is total and a
    # residual arm-2 population is an answer, not a gap.
    cow_set_arm(_elf_cow_share_arm)
    cow_share_page(phys)

    # The parent's old TLB entry was writable; flush it so the parent's
    # next write to this page faults into the COW handler. The child
    # has never run, so its TLB holds nothing for this CR3.
    invlpg_one(vaddr)
    return 0


# Which span of vm_cow_share_all the general COW share is currently serving.
# A pending global, exactly the cow_set_arm / pa_set_site pattern, and for the
# same reason: threading it through vm_cow_share_range would change a public
# signature in two modules for a debug knob. Costs one global load on a path
# that already pays a CR3 reload per fork.
# Literal 2 rather than COW_ARM_SHARE_COW: the x86 backend requires an integer
# initializer for a global, and an imported constant is an Identifier. Kept in
# sync by the reset assignments below, which DO use the named constant.
_elf_cow_share_arm: uint64 = 2


def vm_cow_share_set_arm(a: uint64):
    # Attribute the NEXT vm_cow_share_range walk to span `a` (leak pass 15).
    # Exported so mm/vma.ad can name its OWN two share sites — vma_fork_copy's
    # owner-mmap arm and its demand-resident arm — the same way
    # _vm_cow_share_all_locked names the image / brk / ustack spans. The
    # caller is responsible for restoring COW_ARM_SHARE_COW, exactly as
    # _vm_cow_share_all_locked does, so nothing downstream inherits a stale
    # span. Costs one store on a debug path; the tally it feeds is gated.
    _elf_cow_share_arm = a


def vm_cow_share_range(parent_pml4: uint64, child_pml4: uint64,
                       vlo_in: uint64, vhi_in: uint64) -> int32:
    # COW-share every present user page in [vlo_in, vhi_in) between
    # parent and child. Returns 0 on success, -1 on OOM.
    if vhi_in <= vlo_in:
        return 0
    vlo: uint64 = vlo_in & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi: uint64 = (vhi_in + PAGE_SIZE_4K - 1) \
                  & ~cast[uint64](PAGE_SIZE_4K - 1)
    vaddr: uint64 = vlo
    while vaddr < vhi:
        if _cow_share_one_page(parent_pml4, child_pml4, vaddr) < 0:
            return -1
        vaddr = vaddr + PAGE_SIZE_4K
    return 0


# §1 / MAP_SHARED — genuine cross-process shared memory.
#
# vm_share_range is the SHARED counterpart of vm_cow_share_range: it
# maps the parent's physical frames into the child's PML4 at the SAME
# virtual address, KEEPING THEM WRITABLE in both — no COW marker, no
# copy-on-write split. A write by either process lands in the same
# physical frame and is immediately visible to the other (the
# /dev/shm-style coherence MAP_SHARED promises).
#
# Each frame's per-PFN refcount (mm/cow.ad) is bumped so the frame is
# returned to the buddy allocator only when the LAST mapper unmaps it.
# The COW refcount table is reused as-is: cow_share_page goes 0->2 on
# the first share (owner + child) and N->N+1 afterwards; the SHARED
# VMA's free path routes every frame through cow_drop_page, which frees
# only at refcount 0. is_cow and is_shared are mutually exclusive — a
# shared frame is never COW-marked, so the #PF COW resolver never sees
# it (a write to a shared page does not fault: it stays RW).

def _share_one_page(parent_pml4: uint64, child_pml4: uint64,
                    vaddr: uint64) -> int32:
    # Map the single page at `vaddr` SHARED (writable) into the child.
    # Returns 0 on success (or "nothing mapped here" — skipped), -1 on
    # OOM cracking a page table.
    pslot: uint64 = _cow_resolve_pte_slot(parent_pml4, vaddr)
    if pslot == 0:
        return -1
    parent_pte: uint64 = cast[Ptr[uint64]](pslot)[0]
    if (parent_pte & PT_FLAG_P) == 0:
        return 0
    phys: uint64 = parent_pte & PT_ADDR_MASK
    cslot: uint64 = _cow_resolve_pte_slot(child_pml4, vaddr)
    if cslot == 0:
        return -1
    # Child PTE -> SAME physical frame, present + user + WRITABLE. We
    # deliberately do NOT clear RW and do NOT set the COW bit: a shared
    # page must stay directly writable so neither side faults on a
    # store. Preserve the parent PTE's low flag bits (PCD/PWT) and
    # force present|user|RW.
    parent_flags: uint64 = parent_pte & ~PT_ADDR_MASK
    shared_flags: uint64 = parent_flags | PT_FLAG_RW \
                           | PT_FLAG_P | PT_FLAG_US
    cast[Ptr[uint64]](cslot)[0] = phys | shared_flags
    # The parent keeps its existing writable PTE untouched — we only
    # add a sharer. Account the new reference in the per-PFN table.
    cow_set_arm(COW_ARM_SHARE_WRITABLE)
    cow_share_page(phys)
    return 0


def vm_share_range(parent_pml4: uint64, child_pml4: uint64,
                   vlo_in: uint64, vhi_in: uint64) -> int32:
    # Boot-CR3 guard (>4GB aliasing) — walks BOTH parent+child tables by
    # bare physical address; run under the un-aliased boot-CR3 identity.
    # Idempotent if a caller (fork) already holds boot CR3.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _vm_share_range_locked(parent_pml4, child_pml4,
                                        vlo_in, vhi_in)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _vm_share_range_locked(parent_pml4: uint64, child_pml4: uint64,
                   vlo_in: uint64, vhi_in: uint64) -> int32:
    # SHARE every present page in [vlo_in, vhi_in) — map the parent's
    # frames writable in the child at the same vaddr. Returns 0 on
    # success, -1 on OOM.
    if vhi_in <= vlo_in:
        return 0
    vlo: uint64 = vlo_in & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi: uint64 = (vhi_in + PAGE_SIZE_4K - 1) \
                  & ~cast[uint64](PAGE_SIZE_4K - 1)
    vaddr: uint64 = vlo
    while vaddr < vhi:
        if _share_one_page(parent_pml4, child_pml4, vaddr) < 0:
            return -1
        vaddr = vaddr + PAGE_SIZE_4K
    return 0


# §1 / mprotect — per-page PTE permission update.
#
# vm_protect_range re-walks the page table over [vlo, vhi) and updates
# each present 4 KiB PTE's RW *and* NX bits to match the requested
# protection:
#   PROT_WRITE in `prot` -> RW set; otherwise RW cleared.
#   PROT_EXEC  in `prot` -> NX cleared (executable); otherwise NX set.
# The writable bit makes a store to a PROT_READ page fault in
# do_page_fault (a genuine, non-COW protection violation); the NX bit
# makes a jump/call into a non-PROT_EXEC page fault the same way. Both
# are exactly the protection the caller asked the kernel to enforce.
#
# A page reached through a COW-shared PTE keeps its COW marker: we mask
# the new RW bit through the COW state so a still-shared COW page that
# is mprotect'd PROT_WRITE does not become silently writable (that
# would skip the copy). Concretely — if the PTE has the COW bit set we
# leave RW CLEARED regardless of `prot`; the first write still faults
# into the COW resolver, which sets RW as part of resolution. A
# mprotect to PROT_READ on a COW page just clears RW (already clear).
# The NX bit is independent of COW (COW is a write-trap, not an
# exec-trap) so it is rewritten unconditionally to match `want_exec`.
#
# `pml4_phys` is the target task's PML4. The range is cracked down to
# 4 KiB granularity by _cow_resolve_pte_slot so every page gets a
# private PTE before its RW/NX bits are touched. Returns 0 on success,
# -1 on OOM.

def vm_protect_range(pml4_phys: uint64, vlo_in: uint64, vhi_in: uint64,
                     want_write: int32, want_exec: int32) -> int32:
    # Boot-CR3 guard (>4GB aliasing). This mprotect walk cracks tables via
    # _cow_resolve_pte_slot and dereferences each returned PTE slot by bare
    # physical address; on a >4 GiB-RAM box a PT page (or the slot) in high
    # RAM aliases a live user mapping and #PFs under the live task CR3.
    # Crack + rewrite the PTEs under the pristine boot CR3's un-aliased
    # 1 GiB-huge identity (same pattern as vm_cow_share_all). alloc_page
    # (table cracking) is non-sleeping, so running with IRQs off is safe.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _vm_protect_range_locked(pml4_phys, vlo_in, vhi_in,
                                          want_write, want_exec)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _vm_protect_range_locked(pml4_phys: uint64, vlo_in: uint64, vhi_in: uint64,
                     want_write: int32, want_exec: int32) -> int32:
    if vhi_in <= vlo_in:
        return 0
    vlo: uint64 = vlo_in & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi: uint64 = (vhi_in + PAGE_SIZE_4K - 1) \
                  & ~cast[uint64](PAGE_SIZE_4K - 1)
    vaddr: uint64 = vlo
    while vaddr < vhi:
        pslot: uint64 = _cow_resolve_pte_slot(pml4_phys, vaddr)
        if pslot == 0:
            return -1
        pte: uint64 = cast[Ptr[uint64]](pslot)[0]
        if (pte & PT_FLAG_P) != 0:
            phys: uint64 = pte & PT_ADDR_MASK
            flags: uint64 = pte & ~PT_ADDR_MASK
            if (flags & PT_FLAG_COW) != 0:
                # COW page: never force-writable here — the copy must
                # happen via the #PF resolver. Just ensure RW stays
                # clear so a write still faults.
                flags = flags & ~PT_FLAG_RW
            elif want_write != 0:
                flags = flags | PT_FLAG_RW
            else:
                flags = flags & ~PT_FLAG_RW
            # NX is orthogonal to COW: an exec request clears it, a
            # non-exec request sets it. PROT_EXEC pages become runnable;
            # PROT_READ / PROT_WRITE-only pages become NX so a jump into
            # them faults.
            if want_exec != 0:
                flags = flags & ~PT_FLAG_NX
            else:
                flags = flags | PT_FLAG_NX
            cast[Ptr[uint64]](pslot)[0] = phys | flags
            invlpg_one(vaddr)
        vaddr = vaddr + PAGE_SIZE_4K
    return 0


# §1 / mm/vma.ad VMA splitting — bring a contiguous run under per-PFN
# refcount management.
#
# A single-chunk VMA's virtual range IS its physical buddy run (Hamnix
# runs identity-mapped). That run can only be freed as one whole
# (base, order) — the buddy allocator cannot free a sub-range. So once
# mprotect / MAP_FIXED needs to SPLIT such a VMA, no piece can own the
# run outright: every piece must instead hold a per-frame refcount and
# free through cow_drop_page, so the run is returned to the allocator
# only when the last surviving piece releases its last frame.
#
# vm_pin_range cracks [vlo, vhi) to 4 KiB PTEs (so every frame is
# reached through a private leaf) and takes ONE refcount on each
# present frame. The caller (mm/vma.ad::_vma_make_refcounted) calls
# this exactly once per owner VMA before its first split; afterwards
# each split piece is flagged refcount-managed and frees via the same
# _vma_free_cow_range path COW / shared nodes use. Returns 0 on
# success, -1 on OOM cracking a table.

def vm_pin_range(pml4_phys: uint64, vlo_in: uint64,
                 vhi_in: uint64) -> int32:
    # Boot-CR3 guard (>4GB aliasing) — cracks tables + derefs each PTE slot
    # by bare physical address; run under the un-aliased boot-CR3 identity.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _vm_pin_range_locked(pml4_phys, vlo_in, vhi_in)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _vm_pin_range_locked(pml4_phys: uint64, vlo_in: uint64,
                 vhi_in: uint64) -> int32:
    if vhi_in <= vlo_in:
        return 0
    vlo: uint64 = vlo_in & ~cast[uint64](PAGE_SIZE_4K - 1)
    vhi: uint64 = (vhi_in + PAGE_SIZE_4K - 1) \
                  & ~cast[uint64](PAGE_SIZE_4K - 1)
    vaddr: uint64 = vlo
    while vaddr < vhi:
        pslot: uint64 = _cow_resolve_pte_slot(pml4_phys, vaddr)
        if pslot == 0:
            return -1
        pte: uint64 = cast[Ptr[uint64]](pslot)[0]
        if (pte & PT_FLAG_P) != 0:
            cow_set_arm(COW_ARM_REFINC_OWNER)
            cow_ref_inc(pte & PT_ADDR_MASK)
        vaddr = vaddr + PAGE_SIZE_4K
    return 0


def vm_cow_share_all(parent_pml4: uint64, child_pml4: uint64,
                     img_lo: uint64, img_hi: uint64,
                     brk_lo: uint64, brk_max: uint64,
                     ust_lo: uint64, ust_sz: uint64,
                     sp_fallback: uint64) -> int32:
    # Boot-CR3 guard (same rationale as elf_install_user_mapping). This
    # walks/cracks the page tables of BOTH the parent and the freshly
    # cloned CHILD PML4, dereferencing every level (pml4/bsp_pml4/pdpt/
    # pd/pt) and the NEWLY alloc_page()'d intermediate tables as raw
    # physical addresses. Under UEFI with a few hundred MiB of RAM those
    # pages land high (~485 MiB); the LIVE CR3 here is the parent's
    # CRACKED PML4, which may have dropped the identity entry for that
    # chunk, so the raw derefs #PF (the observed rfork-closure iretq
    # #GP downstream is a freshly-cloned child PML4 left half-built by
    # exactly this faulting walk). Run the whole share under the
    # pristine boot CR3, which maps ALL of low RAM identity. The locked
    # body restores the caller's (parent's) CR3 via its trailing
    # load_cr3(parent_pml4); we re-assert the saved CR3 here too for
    # the OOM early-return paths that bypass that trailing reload.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _vm_cow_share_all_locked(
        parent_pml4, child_pml4, img_lo, img_hi,
        brk_lo, brk_max, ust_lo, ust_sz, sp_fallback)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _vm_cow_share_all_locked(parent_pml4: uint64, child_pml4: uint64,
                     img_lo: uint64, img_hi: uint64,
                     brk_lo: uint64, brk_max: uint64,
                     ust_lo: uint64, ust_sz: uint64,
                     sp_fallback: uint64) -> int32:
    # COW counterpart of vm_fork_install_all: share the three fixed
    # regions (ELF image, brk heap, user stack) read-only + COW between
    # parent and child instead of eager-copying them. mmap VMAs are
    # handled separately by mm/vma.ad::vma_fork_copy.
    #
    # Any region whose range is unset is skipped (same rules as
    # vm_fork_install_all). Returns 0 on success, -1 on OOM.
    # Per-SPAN attribution for the origin tag (leak pass 14). Each of these
    # three spans drains through a DIFFERENT, separately-gated teardown step
    # (task_reap 0b for brk via vma_free_reserved_range; 0c for image / interp
    # / ustack via vma_release_forked_range), so lumping them under one arm
    # names a walk instead of a span. Restored to the default before returning
    # so nothing downstream inherits a stale arm.
    if img_lo != 0 and img_hi > img_lo:
        _elf_cow_share_arm = COW_ARM_SHARE_COW_IMG
        if vm_cow_share_range(parent_pml4, child_pml4,
                              img_lo, img_hi) < 0:
            _elf_cow_share_arm = COW_ARM_SHARE_COW
            return -1
    if brk_lo != 0 and brk_max > brk_lo:
        _elf_cow_share_arm = COW_ARM_SHARE_COW_BRK
        if vm_cow_share_range(parent_pml4, child_pml4,
                              brk_lo, brk_max) < 0:
            _elf_cow_share_arm = COW_ARM_SHARE_COW
            return -1
    if ust_lo != 0 and ust_sz != 0:
        _elf_cow_share_arm = COW_ARM_SHARE_COW_USTK
        if vm_cow_share_range(parent_pml4, child_pml4,
                              ust_lo, ust_lo + ust_sz) < 0:
            _elf_cow_share_arm = COW_ARM_SHARE_COW
            return -1
    elif sp_fallback != 0:
        _elf_cow_share_arm = COW_ARM_SHARE_COW_USTK
        sp_pg: uint64 = sp_fallback & ~cast[uint64](PAGE_SIZE_4K - 1)
        if vm_cow_share_range(parent_pml4, child_pml4,
                              sp_pg, sp_pg + PAGE_SIZE_4K) < 0:
            _elf_cow_share_arm = COW_ARM_SHARE_COW
            return -1
    _elf_cow_share_arm = COW_ARM_SHARE_COW
    # The COW share dropped RW on every page it touched in the PARENT's
    # (== caller's, == current) PML4. Each _cow_share_one_page already
    # invlpg'd its page, but a per-page invlpg can leave a stale
    # WRITABLE entry behind if the page was previously reached through
    # a huge-page (2 MiB / 1 GiB) TLB entry that a later table-crack
    # only partially superseded. A stale writable entry would let the
    # parent write a still-shared page WITHOUT faulting — and race the
    # child onto the same physical page. Reload CR3 with its own value
    # to drop EVERY non-global TLB entry: bulletproof, and fork is not
    # a hot enough path to care about the cost. The child runs on a
    # different CR3 that schedule() load_cr3's fresh on first dispatch,
    # so the child needs no flush here.
    load_cr3(parent_pml4)
    return 0


# ---------------------------------------------------------------------
# COW page-fault resolver — called by the #PF handler.
# ---------------------------------------------------------------------
#
# cow_handle_write_fault() is the productive core of the #PF handler.
# Given the faulting task's PML4 and the faulting linear address it
# decides whether the fault is a recoverable COW fault and, if so,
# resolves it. Return codes:
#
#   1  - fault was a COW fault and is now RESOLVED; the handler should
#        iretq and let the faulting instruction re-run.
#   0  - NOT a COW fault (page absent, not COW-marked, or already
#        writable). The handler keeps its diagnostic / halt behaviour
#        so genuine segfaults are not masked.
#  -1  - it WAS a COW fault but resolution failed (OOM). The handler
#        should treat this as fatal (halt) — we can't safely resume.

def cow_handle_write_fault(faulting_pml4: uint64,
                           fault_va: uint64) -> int32:
    # Boot-CR3 guard (>4GB aliasing). Runs from the #PF handler under the
    # LIVE task CR3; it derefs the task's PTE slot AND memcpy's the old/new
    # COW frames by bare physical address (cow_resolve_pte, called within).
    # A PT page or COW frame in >4 GiB RAM aliases a live user mapping and
    # #PFs under live CR3, so resolve the whole COW fault under the boot
    # CR3's un-aliased identity. alloc_page (the copy target) is
    # non-sleeping, so IRQs-off is safe.
    _saved_cr3: uint64 = read_cr3()
    _boot_cr3: uint64 = cow_boot_cr3()
    _irq_flags: uint64 = 0
    if _boot_cr3 != 0:
        _irq_flags = local_irq_save()
        load_cr3(_boot_cr3)
    _rc: int32 = _cow_handle_write_fault_locked(faulting_pml4, fault_va)
    if _boot_cr3 != 0:
        load_cr3(_saved_cr3)
        local_irq_restore(_irq_flags)
    return _rc


def _cow_handle_write_fault_locked(faulting_pml4: uint64,
                           fault_va: uint64) -> int32:
    # Resolve the 4 KiB PTE slot WITHOUT cracking — the page must
    # already be mapped (COW pages were installed at 4 KiB granularity
    # by vm_cow_share_range). We still go through _cow_resolve_pte_slot
    # which is harmless if the tables are already private; on a COW
    # page they always are.
    pte_slot: uint64 = _cow_resolve_pte_slot(faulting_pml4, fault_va)
    if pte_slot == 0:
        return -1
    pte: uint64 = cast[Ptr[uint64]](pte_slot)[0]
    # Must be present, COW-marked, and currently read-only. Anything
    # else is a genuine fault — let the diagnostic handler take it.
    if (pte & PT_FLAG_P) == 0:
        return 0
    if (pte & PT_FLAG_COW) == 0:
        return 0
    if (pte & PT_FLAG_RW) != 0:
        # COW bit set but already writable — shouldn't fault on a
        # write. Treat as not-a-COW-fault so the diagnostic surfaces it.
        return 0
    return cow_resolve_pte(pte_slot, fault_va)


def cow_resolve_pte(pte_slot: uint64, fault_va: uint64) -> int32:
    # Perform the actual COW resolution on a confirmed COW PTE.
    # Returns 1 on success, -1 on OOM.
    pte: uint64 = cast[Ptr[uint64]](pte_slot)[0]
    old_phys: uint64 = pte & PT_ADDR_MASK
    flags: uint64 = pte & ~PT_ADDR_MASK
    page_va: uint64 = fault_va & ~cast[uint64](PAGE_SIZE_4K - 1)

    if cow_page_is_shared(old_phys) == 0:
        # Refcount 1 (or untracked): this task is the sole remaining
        # holder. No copy — just clear COW and set RW in place.
        #
        # THE REFCOUNT IS DELIBERATELY LEFT ALONE (leak fix). This arm used
        # to cow_drop_page() the frame "back to untracked (0)", which threw
        # away the ONE bit of information every teardown needs:
        #
        #   refcount 1 -> a TRACKED frame with exactly one holder, i.e. a
        #                 private COW copy this task owns and whose last
        #                 mapper must free it;
        #   refcount 0 -> UNTRACKED, which by the rule stated in
        #                 mm/vma.ad::_cow_release_forked_range means "an
        #                 owner-region frame somebody else reclaims
        #                 wholesale — drop the reference, NEVER free".
        #
        # Zeroing the count therefore relabelled a task's own private copy
        # as an owner frame, and the fork+exec teardown then refused to
        # return it. That is EXACTLY ONE order-0 page lost per process
        # lifecycle on the shell's fork+exec path: the parent COW-copies
        # its stack page away (leaving the child sole holder at refcount
        # 1), the child's first write takes THIS arm and zeroes the count,
        # and the child's execve release walk sees "untracked" and leaks
        # the frame. Measured at 0.99 pages per task reaped.
        #
        # Leaving the count at 1 states the truth (one tracked holder) and
        # keeps every consumer correct: cow_page_is_shared() is still 0 (a
        # later write to this now-RW page does not even fault),
        # cow_share_page() on a re-fork still goes 1 -> 2,
        # _vma_free_cow_range's cow_drop_page 1 -> 0 still reports "last
        # holder" and frees, and both COW-copy reclaimers
        # (_cow_release_forked_range, vma_free_cow_strays) now recognise
        # the frame. An UNTRACKED frame reaching this arm (refcount 0 — an
        # owner/region page taken over in place) is unchanged: nothing to
        # drop, and it stays untracked so no reclaimer touches it.
        new_flags: uint64 = (flags & ~PT_FLAG_COW) | PT_FLAG_RW \
                            | PT_FLAG_P
        cast[Ptr[uint64]](pte_slot)[0] = old_phys | new_flags
        invlpg_one(page_va)
        return 1

    # Still shared: allocate a fresh page, copy the old contents into
    # it, repoint this task's PTE at the copy (writable, COW cleared),
    # and decrement the old page's refcount.
    pa_set_site(PA_SITE_COW_RESOLVE)
    # RECORD THE FAULTING TASK, not just the faulting VA. A VA alone cannot
    # separate "a dead task's teardown missed this frame" from "a live task
    # unmapped it and lost it" — the two need opposite fixes, and eleven
    # passes could not tell them apart. The orphan census reads this back
    # (mm/page_alloc.ad::page_alloc_orphan_owner) and reports whether the
    # slot is still live. Cross-module call; Adder merges all modules into
    # one symbol table, and core.ad already imports fs.elf so an import
    # here would close a cycle.
    pa_set_owner(current_idx_get())
    pa_set_tag(fault_va)
    new_phys: uint64 = alloc_page()
    if new_phys == 0:
        printk1("cow: OOM resolving write fault @ 0x%x\n", fault_va)
        return -1
    # The old page is identity-mapped, so memcpy from its physical
    # address reads its bytes directly. SMAP v3c: the OLD page's PTE
    # carries US=1 (user page), so the CPL=0 read leg needs STAC. The
    # NEW page is freshly alloc_page'd (US=0 in the low identity map)
    # so the WRITE leg is SMAP-clean, but it costs nothing to keep AC
    # set across the whole memcpy.
    _ua_stac()
    memcpy(cast[Ptr[uint8]](new_phys),
           cast[Ptr[uint8]](old_phys), PAGE_SIZE_4K)
    _ua_clac()
    new_flags2: uint64 = (flags & ~PT_FLAG_COW) | PT_FLAG_RW \
                         | PT_FLAG_P
    cast[Ptr[uint64]](pte_slot)[0] = new_phys | new_flags2
    # BORN AT REFCOUNT 1, NOT UNTRACKED. The copy has exactly one mapper —
    # this task — and cow_ref_inc says so (0 -> 1). This is the ONLY way a
    # teardown can later tell a CHILD-PRIVATE COW copy apart from an
    # untracked OWNER frame: mm/vma.ad::_cow_release_forked_range must free
    # the former (else every page a fork child dirties between fork and
    # exec leaks until reboot) and must never free the latter (a
    # region-backed image .text frame the live parent still executes — the
    # dfd59371 use-after-free). Leaving the copy at 0 made both cases
    # indistinguishable, so the teardown had to refuse to free anything.
    #
    # Refcount 1 is also what every OTHER consumer already expects of a
    # singly-mapped tracked frame: cow_page_is_shared() stays 0 (a later
    # write still takes the no-copy sole-owner branch above), and
    # _vma_free_cow_range's cow_drop_page 1 -> 0 still returns "last
    # holder", so ordinary VMA/brk teardown is byte-for-byte unchanged.
    cow_set_arm(COW_ARM_REFINC_RESOLVE)
    cow_ref_inc(new_phys)
    # Drop our reference to the shared page.
    cow_set_arm(COW_ARM_DROP_RESOLVE)
    cow_drop_page(old_phys)
    invlpg_one(page_va)
    return 1
