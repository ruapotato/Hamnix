# arch/x86/mm/init.ad
#
# Mirrors arch/x86/mm/init.c. Drives early MM bring-up by calling into
# mm/memblock.ad and (later) the page allocator. For M16.3 the only
# job is `mem_init()`, which initializes the bump allocator with the
# fixed RAM region defined in mm/memblock.ad.
#
# Future M16.x work expands this with:
#   - parsing the multiboot info struct (saved at mb_info by header.S)
#     to discover real e820-equivalent memory ranges
#   - reserving the kernel image range so memblock_alloc never returns
#     a chunk that overlaps .text/.rodata/.data/.bss/.pgtables
#   - bringing up the page allocator on top of memblock
#
# For M16.3 we trust the static MEMBLOCK_BASE > end-of-kernel-image,
# which holds for our image (~ 0x108000 < 0x200000).

from mm.memblock import memblock_init, memblock_region_top, memblock_region_base
from mm.page_alloc import page_alloc_init, page_alloc_track_boot_arm
from mm.slab import slab_init
from mm.cow import cow_init
from mm.swap import swap_init
from mm.page import page_desc_init
from mm.kswapd import kswapd_init
from arch.x86.kernel.e820 import e820_init
from arch.x86.mm.pgtable import pgtable_extend_from_e820
from arch.x86.mm.pgtable import pgtable_build_page_offset_map
from arch.x86.mm.pgtable import pgtable_page_offset_selftest
from arch.x86.mm.pgtable import pgtable_dma_roundtrip_selftest
from arch.x86.mm.pgtable import pgtable_build_cpu_entry_area
from arch.x86.mm.pgtable import pgtable_cpu_entry_area_selftest
from kernel.printk.printk import printk0, printk1, printk2


HIMEM_4G:        uint64 = 0x100000000
HIMEM_PAGE:      uint64 = 4096
HIMEM_SENTINEL:  uint64 = 0xA5C3F00DDEADBEEF


def _himem_selftest():
    # Boot-time proof that physical RAM ABOVE 4 GiB is reachable. The
    # boot stub now identity-maps the low 512 GiB (header.S: pdpt_low
    # 512× 1 GiB pages), so any frame the firmware reported above the
    # 4 GiB hole is addressable through the low identity map.
    #
    # We take the memblock region top (the high water mark e820_init
    # installed — on a > 4 GiB machine this is the big above-4-GiB
    # region) and, if it extends past 4 GiB, grab the LAST page-aligned
    # frame below the top. That frame's physical address is provably
    # >= 4 GiB; under the identity map its virtual address equals its
    # physical address, so we write a sentinel through it, read it back,
    # and report PASS / FAIL. The top frame is the very last one the
    # bump allocator would ever hand out, so touching it here is
    # harmless.
    top: uint64 = memblock_region_top()
    if top <= HIMEM_4G:
        printk1("[himem] SKIP region top=%p <= 4 GiB (no high RAM to test)\n",
                top)
        return
    frame: uint64 = (top - HIMEM_PAGE) & ~(HIMEM_PAGE - 1)
    if frame < HIMEM_4G:
        printk1("[himem] SKIP frame=%p below 4 GiB after alignment\n", frame)
        return
    p: Ptr[uint64] = cast[Ptr[uint64]](frame)
    p[0] = HIMEM_SENTINEL
    readback: uint64 = p[0]
    if readback == HIMEM_SENTINEL:
        printk2("[himem] PASS phys=%p sentinel=%p\n", frame, readback)
    else:
        printk2("[himem] FAIL phys=%p got=%p\n", frame, readback)


def himem_late_report():
    # Re-emit the high-RAM identity-map proof LATE in boot, right before
    # the ring-3 hand-off, so it lands in the same on-screen frame as a
    # start_first_task #UD/#PF crash (the early [himem] line from mem_init
    # has long since scrolled off the top). The build tag IDMAP512 is the
    # decisive tell: if a real-hardware crash photo shows this line, the
    # running image DEFINITELY contains the >4 GiB identity-map fix
    # (header.S 512× 1 GiB pdpt_low + pgtable_extend_from_e820); if the
    # line is ABSENT the box is booting a stale pre-fix image. The
    # PASS/FAIL/SKIP verdict says whether high RAM is actually reachable
    # on THIS hardware — a FAIL here would localise the defect to the
    # identity map itself rather than the per-task / user-PML4 path.
    base: uint64 = memblock_region_base()
    top:  uint64 = memblock_region_top()
    printk2("[himem-late] IDMAP512 memblock base=%p top=%p\n", base, top)
    _himem_selftest()


def mem_init():
    # Mirrors the layered bring-up of arch/x86/mm/init.c's setup_arch
    # → mem_init() path: lower allocators come up before higher ones.
    # memblock owns "all RAM" (initially with a known-safe fallback
    # range; e820_init() then widens it from the multiboot memory
    # map); page_alloc takes pages from memblock on demand; slab
    # takes pages from page_alloc.
    memblock_init()
    e820_init()
    # Identity map extension MUST run before any allocator that may
    # hand out pages above 4 GiB. The boot stub installs a fixed
    # 4 GiB identity map (4× 1 GiB PDPT entries); on a host with
    # > 4 GiB RAM (Asus laptop with ~5 GiB, ThinkPad with 16 GiB,
    # server with 64 GiB...) e820 reports memory extending well
    # beyond that. Without this call page_alloc_init's first write
    # into a freshly-carved high page traps #PF (vector 0x0e
    # err=0x02 — kernel write to not-present), which is exactly
    # what real-hardware UEFI boot was hitting at rip≈0x1c6019.
    pgtable_extend_from_e820()
    # Prove a frame above 4 GiB is reachable now that the identity map
    # covers the high region. One-shot diagnostic; emits [himem] PASS
    # on a > 4 GiB machine, [himem] SKIP otherwise.
    _himem_selftest()
    # COW refcount table: one uint16 per physical page frame, carved
    # from memblock BEFORE the buddy allocator starts (so the table is
    # never itself handed out as a COW-able page). Must run after
    # e820_init() so memblock_region_top() reflects real RAM extent.
    cow_init()
    # #167: swap backing store. Reserve the swap region + slot bitmap
    # from memblock BEFORE page_alloc_init(), exactly like cow_init's
    # refcount table, so the swap store is never handed out as a usable
    # page by the buddy allocator. Anonymous (demand-paged) pages can
    # then be evicted to swap under memory pressure and faulted back in.
    swap_init()
    # #mm-parity: the per-physical-page descriptor array (struct page) —
    # flags + mapcount + LRU links + rmap word, one PageDesc per PFN. Carved
    # from memblock here, AFTER cow_init() (which sized the RAM ceiling) and
    # BEFORE page_alloc_init(), exactly like the COW refcount table, so a
    # descriptor frame is never handed out as usable RAM. Underpins rmap,
    # the active/inactive LRU lists, and dirty-page writeback accounting.
    page_desc_init()
    page_alloc_init()
    # Leak pass 22: arm the page tracker HERE — after page_alloc_init() has
    # zeroed the counters and before one single frame has left the buddy
    # allocator. Every later allocation on this boot is therefore attributed
    # at the moment it happens, and site 0 ("the tracker was not watching")
    # starts empty. Arming from a shell after boot, which is what the leak
    # campaign did for twenty-one passes, can only ever describe the window
    # after the arm; bringup — the densest allocation window the system has
    # — was structurally invisible, and its ~6000 frames landed in site 0
    # where they funded a "re-attribution credit" that made three separate
    # findings INCONCLUSIVE (docs/leak_pass21_n_sample_census.md §6.3).
    page_alloc_track_boot_arm()
    # KPTI #94, step 1: install the kernel-private high-half direct map
    # (page_offset, PML4[273]) aliasing all physical RAM. ADDITIVE — the
    # low identity map is kept, so no vaddr==phys consumer breaks; this
    # only adds a second, kernel-only window. Runs after page_alloc_init
    # (needs alloc_page for the PDPT) and before any task clone, so the
    # full-page PML4 memcpy in kernel/sched/core.ad propagates PML4[273]
    # to every per-task address space. Prove the alias resolves to the
    # same RAM as the identity map (boot-marker PASS/FAIL).
    pgtable_build_page_offset_map()
    pgtable_page_offset_selftest()
    # KPTI #94, Brick B[3/4]: prove virt_to_phys()/phys_to_virt() resolve an
    # alias VA to the SAME physical address a low-identity VA does — the
    # central DMA-safety prerequisite for relocating slab/PT-page backing
    # onto the page_offset alias. Every DMA site feeds virt_to_phys(buf) to
    # hardware, so this round-trip must hold before any consumer flip.
    pgtable_dma_roundtrip_selftest()
    # KPTI #94, Brick A: collect the CPL3->CPL0 entry-critical pages (entry
    # .text stubs, IDT, per-CPU GDT/TSS, #DF IST stacks, MDS VERW word) into
    # a kernel-private cpu_entry_area window (PML4[274]) aliased at their CEA
    # VAs. ADDITIVE — the originals stay mapped, so the running kernel is
    # untouched; this only ADDS a second window a future user CR3 can carry
    # to reach the entry stubs while the rest of the kernel image stays
    # stripped. Same clone-propagation window as page_offset above (before
    # the first task clone). Prove every structure resolves through it.
    pgtable_build_cpu_entry_area()
    pgtable_cpu_entry_area_selftest()
    slab_init()
    # #mm-parity: capture the total-RAM estimate so kswapd's low/min/high
    # watermarks have a basis. Must run after the allocators are up.
    kswapd_init()
