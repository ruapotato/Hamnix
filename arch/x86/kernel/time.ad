# arch/x86/kernel/time.ad
#
# Mirrors arch/x86/kernel/time.c + the PIT bits of
# arch/x86/kernel/i8253.c in Linux. Programs the 8253/8254
# Programmable Interval Timer (chip behind IRQ 0) to fire at ~100 Hz
# and exposes a Hamnix-side timer interrupt handler that bumps a
# `jiffies` counter and acknowledges the PIC.
#
# Why PIT and not HPET / TSC-deadline / LAPIC timer? PIT is the
# universally-present option that needs zero ACPI parsing — perfect
# for first boot. Linux walks the same path: setup_default_timer_irq()
# falls back to PIT when nothing more capable is available.
#
# PIT divisor math:
#   PIT base = 1193182 Hz (≈ 1.193 MHz). At target HZ:
#     divisor = base / HZ = 1193182 / 100 = 11931 ≈ 0x2E9B
#   We pick 100 Hz as Linux's classic HZ; cheap, precise enough for
#   wall-clock and scheduler ticks.

from arch.x86.kernel.i8259 import i8259_send_eoi, i8259_unmask_irq
from arch.x86.kernel.apic import lapic_send_eoi, lapic_timer_set_oneshot_ns
from kernel.printk.printk import printk1, printk2, printk3, printk_set_level
from drivers.tty.serial.early_8250 import PRINTK_LEVEL_EMERG
from kernel.sched.core import (
    schedule, signal_post_to_foreground, SIGINT, SIGTSTP, preempt_tick,
    current_task_account_tick, console_input_wake,
    itimer_real_tick_all, wklat_note_tick,
)
# §13: real system-load accounting. loadavg_tick() folds the per-tick
# idle / EWMA-sampling work into a self-contained module so this file
# only gains one call. See kernel/sched/loadavg.ad.
from kernel.sched.loadavg import loadavg_tick, cpu_is_idle
# QA-N32b: the global hrtimer queue + clockevent are a SINGLE shared
# structure with no cross-CPU lock. Only the BSP (cpu 0) is allowed to
# drive the hrtimer expiry pass / reprogram the clockevent from the timer
# IRQ — an AP that took a (local backstop) timer IRQ must NOT mutate the
# shared queue concurrently with the BSP, or the self-rearming scheduler-
# tick hrtimer can be dropped mid-walk and the BSP tick freezes forever
# (jiffies stop, every tick-dependent waiter hangs). See the BSP-only
# guard on hrtimer_tick_hook below.
from arch.x86.kernel.setup_percpu import get_cpu_id

# read_tsc() lives in arch/x86/kernel/syscall_64.S — it issues an
# LFENCE-ordered RDTSC and returns the 64-bit Time Stamp Counter.
extern def read_tsc() -> uint64
from drivers.tty.serial.early_8250 import uart_drain_hw_to_fifo
from drivers.input.atkbd import atkbd_poll, atkbd_diag_tick
# V1 USB HID: drain the xHCI Event Ring + dispatch interrupt-IN
# transfer completions to the HID layer. No-op when no USB keyboard
# was successfully attached at boot (xhci.kbd_enabled stays 0).
from drivers.usb.xhci import xhci_poll
# V1 USB 2.0 HID: drain the EHCI periodic interrupt-IN qTD. No-op
# when no USB 2.0 keyboard was attached at boot (ehci.kbd_enabled 0).
from drivers.usb.ehci import ehci_poll
# LIVE-MOUSE FIX: drain the HW mouse ring + route to the scene compositor.
from sys.src.port9.port.devmouse import mouse_pump_to_compositor
# BUG 1 FIX (keyboard exclusivity): drain the HW keyboard FIFO + UART RX
# ring and route to the focused scene window while the DE owns the screen.
from sys.src.port9.port.devcons import kbd_pump_to_compositor
# #169 vDSO: republish the shared time data page each tick so a
# userspace __vdso_clock_gettime read sees a fresh, seqlock-consistent
# clock. No-op until vdso_init() runs (vdso_data_phys still 0).
#
# F4 #449 leaf inversion: this used to `from linux_abi.vdso import
# vdso_update_time` and call it directly, which made the native arch
# core a static consumer of a linux_abi/ symbol. Now we publish a hook
# pointer the linux_abi/vdso.ad init body registers. Default null = no-
# op (a pure-native build never advances the vDSO seqlock, which is
# correct: there is no vDSO data page in that build).
vdso_tick_hook: Fn[None]


def register_vdso_tick_hook(hook: Fn[None]):
    # linux_abi/vdso.ad's init body calls this once. The timer tick then
    # republishes the shared time-data page through this pointer. See
    # the F4 #449 hook-table inversion plan.
    vdso_tick_hook = hook

# Softirq bottom-half tick hook. Same leaf-inversion discipline as
# vdso_tick_hook: the native arch timer must NOT statically import
# kernel/softirq.ad (softirq -> api_timer -> arch.time would cycle). So
# softirq_init() publishes a hook here; the timer tick raises TIMER_SOFTIRQ
# and runs the IRQ-return softirq pass through it. Null = no-op (pre-init).
softirq_tick_hook: Fn[None]


def register_softirq_tick_hook(hook: Fn[None]):
    # kernel/softirq.ad's softirq_init() calls this once.
    softirq_tick_hook = hook

# Hi-res timer tick hook. kernel/time/tick.ad registers tick_handle_
# interrupt() here at boot:16.time; the timer ISR then runs the hrtimer
# expiry pass + clockevent reprogram through this pointer on every firing
# (periodic tick OR one-shot). Hook-pointer indirection (same pattern as
# vdso_tick_hook) keeps arch/ from a static import of kernel/time/, which
# would form a cycle (kernel.time.tick imports get_jiffies from here).
# Default null = no-op (a build without the time subsystem keeps the
# legacy jiffies tick).
hrtimer_tick_hook: Fn[None]


def register_hrtimer_tick_hook(hook: Fn[None]):
    hrtimer_tick_hook = hook

# Audio service tick hook. drivers/audio/hda.ad registers hda_service_tick()
# here at hda_init().
#
# WHY THE AUDIO DRIVER NEEDS A TICK AT ALL. Every other guard in the HDA
# driver — the underrun silencer, the play-cursor repair, the write-cursor
# resync — runs from a PRODUCER CALL. But an HDA stream buffer is CYCLIC: once
# RUN is set the engine walks it and wraps, forever, and there is no
# "stop at the end" bit. So a process that stages a clip, starts it and exits
# leaves the hardware replaying that clip with nobody left to call into the
# driver and stop it (measured: a 3.000 s clip emitted for 7.272 s). The tick
# is the only code that still runs after the owner is gone, so it is where an
# audio stream's lifetime actually ends. Same leaf-inversion discipline as
# vdso_tick_hook: hda.ad imports get_jiffies from here, so a static import
# back would cycle. Null = no-op (no audio hardware / pre-init).
audio_tick_hook: Fn[None]


def register_audio_tick_hook(hook: Fn[None]):
    audio_tick_hook = hook

# Linux-ABI no-syscall watchdog tick hook. When a Linux-ABI (is_linux_
# userspace) task spins in userspace without issuing a syscall for N
# seconds, the running instruction never traps — the only kernel entry
# left is this timer IRQ. The watchdog fires from the tick: it compares
# jiffies against the task's last-syscall stamp and, past the threshold,
# dumps the interrupted RIP/RSP + the containing VMA (library+offset) to
# serial. mm/vma.ad owns the body (it has vma_find + the VMA fields +
# uaccess); it registers the hook at boot. Null = no-op (pure-native
# build has no Linux-ABI tasks to watch).
#   args: (user_ctx, interrupted_rip, interrupted_rsp)
# Linux-ABI bounded-futex-park tick hook. Same leaf-inversion discipline as
# vdso_tick_hook / linux_nosyscall_wd_hook: arch/ must not statically import a
# linux_abi/ symbol, so linux_abi/u_syscalls.ad publishes a hook here at boot.
#
# WHY A TICK IS REQUIRED. A FUTEX_WAIT parker in the large-thread-group arm
# sleeps in STATE_WAIT off the runqueue. Its "bounded recheck" deadline is
# evaluated only by its OWN loop in wq_wait_commit_timeout — and that loop only
# keeps running while nothing else is runnable (the sti;hlt idle arm). The
# instant it hands off via schedule(), _pick_next will never select it again
# (STATE_WAIT), so nothing can service its deadline. Without an independent
# clock the "bounded" park is INFINITE, and a futex word mutated with the
# FUTEX_WAKE elided (glibc/musl/cairo/pango do this whenever no waiter is
# registered) parks the thread for the life of the process. This hook is that
# clock. Null = no-op (pure-native boot with no Linux ABI).
linux_futex_tick_hook: Fn[None]


def register_linux_futex_tick_hook(hook: Fn[None]):
    # Publish the Layer-2 bounded-futex-park sweep. Called from
    # u_syscalls_init(); the arch timer never names the Layer-2 symbol.
    linux_futex_tick_hook = hook


linux_nosyscall_wd_hook: Fn[None, uint64, uint64, uint64]


def register_linux_nosyscall_wd_hook(hook: Fn[None, uint64, uint64, uint64]):
    linux_nosyscall_wd_hook = hook


PIT_CHANNEL0_DATA: int32 = 0x40
PIT_CMD:           int32 = 0x43

# Command byte: channel 0, lobyte/hibyte access, mode 3 (square wave),
# binary count. = 0x36.
PIT_CMD_CH0_LOHI_MODE3: int32 = 0x36

HZ:           uint64 = 100
PIT_BASE_HZ:  uint64 = 1193182

jiffies: uint64 = 0

# When 0, timer_interrupt bumps `jiffies` by one per BSP timer IRQ — correct
# ONLY under the legacy fixed-rate periodic tick (early boot, before the
# high-res clockevent comes up). Once the tick layer switches into high-res
# one-shot mode the LAPIC no longer fires at a fixed 100 Hz — it fires once
# per pending hrtimer — so a per-IRQ bump OVER-counts whenever user hrtimers
# (nanosleep/itimer/DE animation) fire between scheduler ticks (uptime runs
# FAST) and FREEZES across a NO_HZ idle. tick_init() then sets this to 1 and
# drives `jiffies` from the monotonic clocksource instead (kernel/time/tick.ad
# _tick_account_jiffies), so it tracks real wall-clock time exactly.
jiffies_external_drive: uint8 = 0


# Let the tick layer take over jiffies bookkeeping (see the banner above).
def time_jiffies_set_external(v: uint8):
    jiffies_external_drive = v


# Advance `jiffies` by `n` ticks. Used by the clocksource-driven tick
# accounting once external drive is enabled; BSP-only, matching the single
# writer in timer_interrupt.
def time_jiffies_advance(n: uint64):
    jiffies = jiffies + n

# /proc/stat 3-way CPU-time split. Each timer tick charges EXACTLY one
# of these buckets, classified from user_ctx + the pure-instrumentation
# idle flag (kernel/sched/loadavg.ad cpu_is_idle):
#   * user   — the timer froze ring-3 (userland) code.
#   * idle   — non-userland AND the CPU was parked in an idle-wait hlt.
#   * system — non-userland AND NOT idle: the kernel was doing real work.
# These are independent of loadavg.ad's _la_idle_jiffies (which folds
# idle+system into one "non-userland" bucket and is depended on by a
# devloadavg test — left untouched). devstat.ad renders these three as
# the real user / system / idle columns of /proc/stat.
g_stat_user_jiffies:   uint64 = 0
g_stat_system_jiffies: uint64 = 0
g_stat_idle_jiffies:   uint64 = 0

# Per-CPU tick counter — proves Percpu[T] codegen works for both
# read and write in interrupt context. Each CPU keeps its own count;
# on uniprocessor we expect this to track `jiffies`.
local_timer_ticks: Percpu[uint64]


def time_init():
    # Program PIT channel 0 for HZ Hz square-wave interrupts.
    divisor: uint64 = PIT_BASE_HZ / HZ
    div_lo: int32 = cast[int32](divisor & 0xFF)
    div_hi: int32 = cast[int32]((divisor >> 8) & 0xFF)

    outb(PIT_CMD_CH0_LOHI_MODE3, PIT_CMD)
    outb(div_lo, PIT_CHANNEL0_DATA)
    outb(div_hi, PIT_CHANNEL0_DATA)

    # Unmask IRQ 0 on the PIC so the timer line can actually fire.
    # CPU interrupts (EFLAGS.IF) are still off here — caller is
    # responsible for `sti` once IDT vector 32 is populated.
    i8259_unmask_irq(0)


# #55: AP preemption-tick period. An AP with no periodic clockevent re-arms
# its one-shot to this interval on every tick so a running user task keeps
# getting preempt_tick ticks. Matched to the BSP's 100 Hz (10 ms) so per-CPU
# quantum aging is uniform across cores. See timer_interrupt's AP re-arm.
AP_PREEMPT_TICK_NS: uint64 = 10000000            # 10 ms == 100 Hz


# --- POINTER-SERVICE GAP INSTRUMENT (user: "the mouse must keep working
# --- even when a process is taking 100% CPU") ------------------------------
#
# On a live rl5 desktop the cursor is composited ENTIRELY in the kernel from
# THIS interrupt handler: timer_interrupt -> mouse_pump_to_compositor() ->
# wsys_route_mouse_rel/abs -> _wsys_route_common -> _wsys_present_cursor().
# No userland thread is in the loop at all. Therefore the pointer's worst-case
# staleness is EXACTLY the wall-clock gap between two consecutive pump calls:
# a mouse packet that lands just after one pump cannot move a pixel until the
# next one. "Pointer latency" and "inter-pump gap" are the same number, and
# measuring the gap needs no mouse injection at all (which is historically
# flaky here) — it is a property of the tick, not of the input.
#
# At the nominal 100 Hz tick the gap is 10 ms. It grows only when the timer
# IRQ cannot be DELIVERED, i.e. when some other code is running with
# EFLAGS.IF clear. Two such regions exist and both are on the hot path of a
# busy system:
#   * IA32_FMASK = 0x0200, so SYSCALL entry clears IF and the ENTIRE syscall
#     runs interrupts-off (arch/x86/kernel/syscall_64.S has no sti).
#   * wsys_scene_present / _wsys_present_commit_impl wrap the whole
#     rasterize+recompose+flush in local_irq_save() (they must: the pump
#     re-enters the same lock from IRQ context).
# So every long syscall — above all a full-screen present by a busy client —
# is a hard pointer freeze of exactly its own duration.
#
# The instrument is always compiled in (never #ifdef'd out) and costs one
# RDTSC + a handful of compares per tick. Buckets are cumulative counts;
# ptrlat_max_ns is the number the user actually feels.
ptrlat_last_ns:  uint64 = 0
ptrlat_n:        uint64 = 0        # gaps sampled
ptrlat_sum_ns:   uint64 = 0
ptrlat_max_ns:   uint64 = 0
ptrlat_b15:      uint64 = 0        # <= 15 ms  (a healthy 100 Hz tick)
ptrlat_b30:      uint64 = 0        # <= 30 ms
ptrlat_b60:      uint64 = 0        # <= 60 ms
ptrlat_b120:     uint64 = 0        # <= 120 ms
ptrlat_b250:     uint64 = 0        # <= 250 ms
ptrlat_over:     uint64 = 0        # >  250 ms — a visible freeze


def ptrlat_reset():
    # Zero the window. ptrlat_last_ns is cleared too so the first gap after a
    # reset is DISCARDED rather than being measured from the pre-reset tick.
    ptrlat_last_ns = 0
    ptrlat_n = 0
    ptrlat_sum_ns = 0
    ptrlat_max_ns = 0
    ptrlat_b15 = 0
    ptrlat_b30 = 0
    ptrlat_b60 = 0
    ptrlat_b120 = 0
    ptrlat_b250 = 0
    ptrlat_over = 0


# Attribution aid: when a gap exceeds PTRLAT_TRACE_NS, print it together with
# the RIP the timer finally caught. The offending region ran with IF clear, so
# the first instruction to execute after IF comes back is at (or just past) the
# end of that region — enough to name the culprit with `nm` on the kernel ELF.
# Rate-limited so a pathological boot can't drown the console.
PTRLAT_TRACE_NS:   uint64 = 100000000        # 100 ms
ptrlat_trace_left: uint64 = 24
ptrlat_trace_on:   int32  = 1
# Last syscall ENTERED, stamped by do_syscall. During an IF=0 stall no other
# syscall can start, so on a long gap this names the syscall that was running.
ptrlat_last_sysnr: uint64 = 0
ptrlat_last_sysns: uint64 = 0


def ptrlat_note_syscall(nr: uint64, now_ns: uint64):
    ptrlat_last_sysnr = nr
    ptrlat_last_sysns = now_ns


def ptrlat_trace_enable(on: int32):
    ptrlat_trace_on = on
    if on != 0:
        ptrlat_trace_left = 24


def ptrlat_account(gap: uint64):
    # Bucket one pointer-service interval. Split out of ptrlat_sample so the
    # INLINE service path (pointer_service_poll) feeds the SAME histogram.
    #
    # WHY THIS MATTERS (measurement validity). The metric has to be "wall-clock
    # interval between successive cursor updates", NOT "interval between timer
    # ticks". Those were the same number before pointer_service_poll() existed,
    # and they are NOT the same number after it: the whole point of the fix is
    # to move the cursor from inside a long IF=0 region that no tick can
    # interrupt. An instrument that only samples the tick is blind to its own
    # fix — it would report an unchanged max_us on a build where the pointer
    # visibly kept moving, and would equally report success for a build that
    # merely made ticks more frequent without servicing the pointer. Sampling
    # every actual pump makes max_us the number the USER feels.
    ptrlat_n = ptrlat_n + 1
    ptrlat_sum_ns = ptrlat_sum_ns + gap
    if gap > ptrlat_max_ns:
        ptrlat_max_ns = gap
    if gap <= 15000000:
        ptrlat_b15 = ptrlat_b15 + 1
    elif gap <= 30000000:
        ptrlat_b30 = ptrlat_b30 + 1
    elif gap <= 60000000:
        ptrlat_b60 = ptrlat_b60 + 1
    elif gap <= 120000000:
        ptrlat_b120 = ptrlat_b120 + 1
    elif gap <= 250000000:
        ptrlat_b250 = ptrlat_b250 + 1
    else:
        ptrlat_over = ptrlat_over + 1


def ptrlat_sample_inline():
    # The INLINE service path: pointer_service_poll() is about to run the pump
    # from inside a long IRQ-off kernel region. Close the current interval here
    # so the histogram credits the cursor update that actually happened.
    # No RIP/CS trace: we are not in an interrupt frame and there is no
    # "interrupted" context to name — the caller IS the long region.
    now: uint64 = tsc_monotonic_ns()
    if ptrlat_last_ns == 0:
        ptrlat_last_ns = now
        return
    if now <= ptrlat_last_ns:
        return
    gap: uint64 = now - ptrlat_last_ns
    ptrlat_last_ns = now
    ptrlat_account(gap)


def ptrlat_sample(interrupted_rip: uint64, interrupted_cs: uint64):
    # Called from timer_interrupt on the BSP immediately before the mouse
    # pump. BSP-only: APs are tickless and their backstop cadence is not the
    # pointer's service rate.
    now: uint64 = tsc_monotonic_ns()
    if ptrlat_last_ns == 0:
        ptrlat_last_ns = now
        return
    if now <= ptrlat_last_ns:
        return
    gap: uint64 = now - ptrlat_last_ns
    ptrlat_last_ns = now
    if ptrlat_trace_on != 0 and gap > PTRLAT_TRACE_NS and ptrlat_trace_left > 0:
        ptrlat_trace_left = ptrlat_trace_left - 1
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk3("[ptrlat-trace] gap_us=%d rip=%x cs=%x\n",
                gap / 1000, interrupted_rip, interrupted_cs)
        insys: uint64 = 0
        if now > ptrlat_last_sysns:
            insys = (now - ptrlat_last_sysns) / 1000
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk2("[ptrlat-trace]   last_sysnr=%d in_syscall_us=%d\n",
                ptrlat_last_sysnr, insys)
    ptrlat_account(gap)


# Accessors so port code (sys/src/9/port/devwsys.ad) can render the report
# without importing arch globals directly.
def ptrlat_get_n() -> uint64:
    return ptrlat_n


def ptrlat_get_max_us() -> uint64:
    return ptrlat_max_ns / 1000


def ptrlat_get_mean_us() -> uint64:
    if ptrlat_n == 0:
        return 0
    return (ptrlat_sum_ns / ptrlat_n) / 1000


def ptrlat_get_b15() -> uint64:
    return ptrlat_b15


def ptrlat_get_b30() -> uint64:
    return ptrlat_b30


def ptrlat_get_b60() -> uint64:
    return ptrlat_b60


def ptrlat_get_b120() -> uint64:
    return ptrlat_b120


def ptrlat_get_b250() -> uint64:
    return ptrlat_b250


def ptrlat_get_over() -> uint64:
    return ptrlat_over


# ======================================================================
# m2p — MOTION-TO-PHOTON FOR THE POINTER
# ======================================================================
#
# WHY THIS EXISTS AND WHY ptrlat IS NOT IT.
#
# Everything measured for the user's report so far has been a PROXY:
#   * wklat  — how long a woken task waits for the CPU.
#   * sysirq — how long EFLAGS.IF stays clear inside a syscall.
#   * ptrlat — the wall-clock GAP between two consecutive cursor services.
#
# All three can look perfect while the user still sees a stuttering pointer.
# ptrlat is the closest, but it is a gap between SERVICES, not the age of an
# EVENT: a pump that runs punctually every 10 ms and each time re-blits a
# cursor whose position came from a packet that has been sitting in the ring
# for 200 ms scores a flawless ptrlat and looks broken on screen. Nothing has
# ever measured the number the user actually perceives, which is the age of a
# mouse packet at the moment its pixels reach scanout.
#
# WHAT IS MEASURED. One interval per pointer event, split at the two seams
# that separate the candidate explanations from one another:
#
#   t0  m2p_note_ingest()   the packet lands in the mouse ring
#                           (drivers/input/auxmouse.ad, all three push paths:
#                            PS/2 relative, HID wheel, HID absolute/tablet)
#   t1  m2p_note_service()  _wsys_route_common begins — the pump has picked
#                           the packet up and cursor work is starting
#   t2  m2p_note_photon()   _wsys_present_cursor_locked has finished flushing
#                           both the restored old footprint and the new
#                           sprite to scanout
#
#   total   = t2 - t0   the user's symptom
#   deliver = t1 - t0   INPUT DELIVERY: ring wait — the pump is not running
#                       (tick starved, IF masked, DE not live, device polling
#                       starved). This is the half wklat/sysirq speak to.
#   render  = t2 - t1   COMPOSITOR: recompose of the old footprint, cursor
#                       rasterize, keyed blit, two flush_rects, and any wait
#                       for wsys_present_lock behind a full-screen present.
#
# The split is the whole point. A large `deliver` and a small `render`
# indicts input delivery / the tick; a small `deliver` and a large `render`
# indicts the compositor redraw path, which no instrument here has ever been
# able to see. Whichever it is, the other is RULED OUT by the same run.
#
# OLDEST-EVENT ATTRIBUTION. If several packets arrive before one pump, t0 is
# the arrival of the FIRST unserviced one and is not overwritten — the number
# reported is the worst age in that batch, which is what the user feels. The
# interval is only accounted when a present actually followed a route
# (m2p_t1_ns != 0), so an unrelated cursor re-blit (window close, outline
# erase) cannot manufacture a sample.
#
# DEFAULT OFF. Unlike ptrlat this costs an RDTSC on the input path, and it is
# only meaningful across a window someone deliberately opened. `m2p 1` on
# /dev/wsys/ctl arms and resets; `m2p 2` reports.
m2p_on:        int32  = 0
m2p_pending:   int32  = 0
m2p_t0_ns:     uint64 = 0
m2p_t1_ns:     uint64 = 0
m2p_ingest:    uint64 = 0        # events stamped (armed only)
m2p_n:         uint64 = 0        # intervals completed
m2p_sum_ns:    uint64 = 0
m2p_max_ns:    uint64 = 0
m2p_dsum_ns:   uint64 = 0        # deliver = t1 - t0
m2p_dmax_ns:   uint64 = 0
m2p_rsum_ns:   uint64 = 0        # render  = t2 - t1
m2p_rmax_ns:   uint64 = 0
m2p_b15:       uint64 = 0        # <= 15 ms — one healthy tick
m2p_b30:       uint64 = 0
m2p_b60:       uint64 = 0
m2p_b120:      uint64 = 0
m2p_b250:      uint64 = 0
m2p_over:      uint64 = 0        # > 250 ms — a visible freeze


def m2p_reset():
    m2p_pending = 0
    m2p_t0_ns = 0
    m2p_t1_ns = 0
    m2p_ingest = 0
    m2p_n = 0
    m2p_sum_ns = 0
    m2p_max_ns = 0
    m2p_dsum_ns = 0
    m2p_dmax_ns = 0
    m2p_rsum_ns = 0
    m2p_rmax_ns = 0
    m2p_b15 = 0
    m2p_b30 = 0
    m2p_b60 = 0
    m2p_b120 = 0
    m2p_b250 = 0
    m2p_over = 0


def m2p_enable(on: int32):
    m2p_on = on


def m2p_enabled() -> int32:
    return m2p_on


def m2p_note_ingest():
    # t0. Called from the mouse ring push paths. Latches the OLDEST unserviced
    # packet; a later packet in the same batch does not overwrite it.
    if m2p_on == 0:
        return
    m2p_ingest = m2p_ingest + 1
    if m2p_pending != 0:
        return
    m2p_pending = 1
    m2p_t1_ns = 0
    m2p_t0_ns = tsc_monotonic_ns()


def m2p_note_service():
    # t1. Called at the top of _wsys_route_common: the pump has the packet and
    # cursor work is about to begin. First route of a batch wins, matching the
    # oldest-event t0.
    if m2p_on == 0:
        return
    if m2p_pending == 0:
        return
    if m2p_t1_ns != 0:
        return
    m2p_t1_ns = tsc_monotonic_ns()


def m2p_note_photon():
    # t2. Called at the very end of _wsys_present_cursor_locked, after BOTH
    # flush_rects — i.e. once the restored old footprint and the new sprite
    # are in scanout. Requires a t1 so an unrelated cursor re-blit cannot
    # fabricate a sample.
    if m2p_on == 0:
        return
    if m2p_pending == 0:
        return
    if m2p_t1_ns == 0:
        return
    now: uint64 = tsc_monotonic_ns()
    m2p_pending = 0
    if now <= m2p_t0_ns:
        return
    total: uint64 = now - m2p_t0_ns
    deliver: uint64 = 0
    if m2p_t1_ns > m2p_t0_ns:
        deliver = m2p_t1_ns - m2p_t0_ns
    render: uint64 = 0
    if now > m2p_t1_ns:
        render = now - m2p_t1_ns
    m2p_n = m2p_n + 1
    m2p_sum_ns = m2p_sum_ns + total
    if total > m2p_max_ns:
        m2p_max_ns = total
    m2p_dsum_ns = m2p_dsum_ns + deliver
    if deliver > m2p_dmax_ns:
        m2p_dmax_ns = deliver
    m2p_rsum_ns = m2p_rsum_ns + render
    if render > m2p_rmax_ns:
        m2p_rmax_ns = render
    if total <= 15000000:
        m2p_b15 = m2p_b15 + 1
    elif total <= 30000000:
        m2p_b30 = m2p_b30 + 1
    elif total <= 60000000:
        m2p_b60 = m2p_b60 + 1
    elif total <= 120000000:
        m2p_b120 = m2p_b120 + 1
    elif total <= 250000000:
        m2p_b250 = m2p_b250 + 1
    else:
        m2p_over = m2p_over + 1


def _m2p_mean_us(sum_ns: uint64) -> uint64:
    if m2p_n == 0:
        return 0
    return (sum_ns / m2p_n) / 1000


def m2p_report():
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk3("[m2p] armed=%d ingest=%d n=%d\n",
            cast[uint64](m2p_on), m2p_ingest, m2p_n)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[m2p] total_max_us=%d total_mean_us=%d\n",
            m2p_max_ns / 1000, _m2p_mean_us(m2p_sum_ns))
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[m2p] deliver_max_us=%d deliver_mean_us=%d\n",
            m2p_dmax_ns / 1000, _m2p_mean_us(m2p_dsum_ns))
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[m2p] render_max_us=%d render_mean_us=%d\n",
            m2p_rmax_ns / 1000, _m2p_mean_us(m2p_rsum_ns))
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk3("[m2p] le15ms=%d le30ms=%d le60ms=%d\n",
            m2p_b15, m2p_b30, m2p_b60)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk3("[m2p] le120ms=%d le250ms=%d over250ms=%d\n",
            m2p_b120, m2p_b250, m2p_over)


def m2p_ctl(verb: int64) -> int32:
    # 0 disarm   1 arm + reset   2 report   3 reset (stay armed)
    # Every accepted verb ACKs, for the reason spelled out on wklat_ctl: a
    # silently refused control write is indistinguishable from a working one
    # and turns an A/B into two identical arms.
    if verb == 0:
        m2p_enable(0)
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[m2p] ack armed=0\n")
        return 1
    if verb == 1:
        m2p_reset()
        m2p_enable(1)
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[m2p] ack armed=1\n")
        return 1
    if verb == 2:
        m2p_report()
        return 1
    if verb == 3:
        m2p_reset()
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[m2p] ack reset\n")
        return 1
    return 0


# ======================================================================
# sysirq — INTERRUPT-MASKED (EFLAGS.IF=0) DURATION, ATTRIBUTED BY SYSCALL
# ======================================================================
#
# WHAT THIS MEASURES AND WHY IT IS NOT THE SAME AS "SYSCALL DURATION".
#
# IA32_FMASK = 0x0200, so SYSCALL entry clears IF and the syscall body runs
# with interrupts masked unless something inside it re-enables them. While IF
# is clear the timer IRQ cannot be DELIVERED, and the timer IRQ is the only
# thing that pumps the mouse (mouse_pump_to_compositor, above). So a long
# IF-off stretch is a hard pointer freeze of exactly its own duration, no
# matter how responsive the scheduler is — the sibling wake->dispatch work
# (kernel/sched/core.ad::wklat_*) measured the scheduler directly and cleared
# it, which is what leaves this path as the remaining suspect.
#
# Wall-clock syscall duration is the WRONG number here and would badly
# over-report: the blocking syscalls (nanosleep, blocking read, the
# cond_resched spin loops) do sti+hlt+cli per iteration, so a 5-second sleep
# is 5 seconds of syscall with interrupts ENABLED nearly the whole way. An
# instrument that timed syscalls would name nanosleep the worst offender and
# be entirely wrong.
#
# THE MEASUREMENT. The timer tick is its own witness: a tick can only land
# when IF is set, so a tick that is LATE is direct evidence that IF was clear
# across the lateness. Per syscall invocation:
#
#   d       = wall duration of the call
#   ticks   = timer ticks that landed during the call
#   ingap   = longest interval between two consecutive ticks during the call
#   tail    = time from the last tick to the syscall's return
#   tk0     = stamp of the last tick BEFORE the call
#
#   ticks == 0  ->  the next tick was due at tk0 + TICK. Everything past that
#                   is masked time:            blocked = now - (tk0 + TICK)
#   ticks >  0  ->  blocked = min(d, max(ingap, tail) - TICK)
#
# THE `- TICK` IS THE WHOLE POINT, and leaving it out is the trap this
# instrument fell into first. Ticks are 10 ms apart BY DESIGN; a syscall that
# runs 11 ms and sees one tick has an inter-tick gap of ~10 ms for reasons
# that have nothing to do with interrupt masking. Without the subtraction
# every syscall longer than a tick period reports ~10 ms of "masked" time and
# the instrument's headline number is just the tick period wearing a
# disguise — the first run of this gate duly reported an 11.7 ms worst case
# and it was 100% tick cadence and 0% evidence. Charging only the EXCESS over
# the nominal period makes every reported nanosecond a nanosecond the timer
# IRQ was demonstrably due and demonstrably undelivered.
#
# The min(d, ...) clamp is the other half: `ingap` and `tail` are measured
# from a tick that may predate the call, so without it a 50 us syscall could
# be charged for masking that happened before it started. Both adjustments
# push the same way — this instrument UNDER-reports (a masked stretch that
# straddles entry is truncated at entry, and one shorter than the remaining
# tick period is invisible), which is the right direction for attribution:
# everything it names is real, and a zero is not a proof of innocence.
SYSIRQ_TICK_NS: uint64 = 10000000   # nominal 100 Hz period; see above
#
# NESTING. A blocking syscall yields, and the task that runs next enters
# do_syscall too. The gap-max window is therefore saved on the C stack at
# entry and merged back at exit (sysirq_gap_take / the merge in
# sysirq_account), so an inner call cannot steal or corrupt the outer call's
# window. Attribution is still approximate across a context switch inside a
# syscall — but only for syscalls that BLOCK, and those re-enable interrupts
# by construction, so they contribute ~one tick and cannot masquerade as an
# offender.
#
# COST WHEN DISARMED: one global load + branch in do_syscall, one in the tick.
# Default off, armed at runtime through /proc/self/ctl `sysirq 1`, matching
# the precedent of --track-allocs, kmtrack and wklat_*.
SYSIRQ_NSLOT: uint64 = 352          # native syscall nrs run 0..324
SYSIRQ_SPAN:  uint64 = 349          # window spanned a context switch (see below)
SYSIRQ_OTHER: uint64 = 350          # native nr >= 350: lumped here
SYSIRQ_LINUX: uint64 = 351          # any Linux-ABI syscall (different numbering)

sysirq_on:        int32  = 0
sysirq_tick_n:    uint64 = 0        # instrument-local monotonic BSP tick count
sysirq_tick_ns:   uint64 = 0        # ns stamp of the most recent BSP tick
sysirq_gapmax_ns: uint64 = 0        # longest inter-tick gap in the CURRENT window

# Distribution of the attributed masked interval, over every sampled syscall.
sysirq_n:      uint64 = 0
# Samples with a NON-ZERO masked excess, i.e. syscalls that provably held the
# timer IRQ off past its due time. With excess accounting this, not the mean,
# is the headline: on a healthy tree it should be a vanishing fraction of n.
sysirq_hit:    uint64 = 0
# Samples discarded because the window spanned a context switch (see
# sysirq_account). Reported, never asserted on: they are real masked time,
# just not attributable to the syscall that happened to enclose them.
sysirq_span:   uint64 = 0
sysirq_sum_ns: uint64 = 0
sysirq_max_ns: uint64 = 0
sysirq_b1:     uint64 = 0           # <=  1 ms — imperceptible
sysirq_b5:     uint64 = 0           # <=  5 ms
sysirq_b12:    uint64 = 0           # <= 12 ms — one 100 Hz tick + slack
sysirq_b25:    uint64 = 0           # <= 25 ms
sysirq_b60:    uint64 = 0           # <= 60 ms
sysirq_over:   uint64 = 0           # >  60 ms — a visible pointer freeze

# Per-syscall attribution. Counts, summed masked ns, and the worst single
# masked stretch. The MAX column is the one that matters: a long tail is the
# whole complaint, and a mean hides it completely.
sysirq_cnt: Array[352, uint64]
sysirq_sum: Array[352, uint64]
sysirq_max: Array[352, uint64]


def sysirq_reset():
    sysirq_n      = 0
    sysirq_hit    = 0
    sysirq_span   = 0
    sysirq_sum_ns = 0
    sysirq_max_ns = 0
    sysirq_b1     = 0
    sysirq_b5     = 0
    sysirq_b12    = 0
    sysirq_b25    = 0
    sysirq_b60    = 0
    sysirq_over   = 0
    sysirq_gapmax_ns = 0
    i: uint64 = 0
    while i < SYSIRQ_NSLOT:
        sysirq_cnt[i] = 0
        sysirq_sum[i] = 0
        sysirq_max[i] = 0
        i = i + 1


def sysirq_enable(on: int32):
    sysirq_on = on
    if on != 0:
        sysirq_reset()
        sysirq_tick_ns = 0


def sysirq_is_on() -> int32:
    return sysirq_on


def sysirq_tick():
    # Called from timer_interrupt on the BSP only, and only while armed. The
    # tick IS the witness that IF was set at this instant; the interval since
    # the previous tick is the longest stretch we can prove was masked.
    now: uint64 = tsc_monotonic_ns()
    sysirq_tick_n = sysirq_tick_n + 1
    if sysirq_tick_ns != 0 and now > sysirq_tick_ns:
        gap: uint64 = now - sysirq_tick_ns
        if gap > sysirq_gapmax_ns:
            sysirq_gapmax_ns = gap
    sysirq_tick_ns = now


def sysirq_now_ns() -> uint64:
    return tsc_monotonic_ns()


def sysirq_tick_count() -> uint64:
    return sysirq_tick_n


def sysirq_gap_take() -> uint64:
    # Open a fresh gap-max window and hand the enclosing one back to the
    # caller, which parks it on its own stack until sysirq_account merges it.
    g: uint64 = sysirq_gapmax_ns
    sysirq_gapmax_ns = 0
    return g


def sysirq_last_tick_ns() -> uint64:
    # Stamp of the most recent tick. Captured at syscall entry so the "no tick
    # arrived" case knows when the next one was DUE.
    return sysirq_tick_ns


def sysirq_account(nr: uint64, is_linux: uint64, t0: uint64,
                   tick0: uint64, outer_gap: uint64, tk0: uint64,
                   spanned: uint64):
    # Close one syscall's masked-time window. See the banner for the formula.
    ingap: uint64 = sysirq_gapmax_ns
    # Merge the enclosing window back: it must end up holding the max of what
    # it had before this call and what this call observed.
    if outer_gap > ingap:
        sysirq_gapmax_ns = outer_gap
    if sysirq_on == 0:
        return
    now: uint64 = tsc_monotonic_ns()
    if now <= t0:
        return
    d: uint64 = now - t0
    blocked: uint64 = 0
    if sysirq_tick_n == tick0:
        # Not one tick landed. The next one was due TICK after the last one
        # seen before entry; everything past that instant is time the timer
        # IRQ was pending and undeliverable.
        due: uint64 = tk0 + SYSIRQ_TICK_NS
        if tk0 != 0 and now > due:
            blocked = now - due
    else:
        cand: uint64 = 0
        if ingap > SYSIRQ_TICK_NS:
            cand = ingap - SYSIRQ_TICK_NS
        if now > sysirq_tick_ns:
            tail: uint64 = now - sysirq_tick_ns
            if tail > SYSIRQ_TICK_NS and (tail - SYSIRQ_TICK_NS) > cand:
                cand = tail - SYSIRQ_TICK_NS
        blocked = cand
    if blocked > d:
        blocked = d
    idx: uint64 = SYSIRQ_LINUX
    if is_linux == 0:
        idx = nr
        if idx >= SYSIRQ_OTHER:
            idx = SYSIRQ_OTHER
    if spanned != 0:
        # The window contained a context switch, so whatever masking it saw
        # may belong to the task that ran in the middle -- and that task's own
        # syscall recorded it too, so charging it here would double-count it
        # AND name the wrong syscall. Park it in its own row: visible, and
        # excluded from both the per-syscall attribution and the histogram
        # the gate asserts on. Measured worth: with a 20 ms masked spin
        # injected into getcwd, `yield` reported a max within 24 us of
        # getcwd's purely by containing it.
        idx = SYSIRQ_SPAN
        sysirq_span = sysirq_span + 1
        sysirq_cnt[idx] = sysirq_cnt[idx] + 1
        sysirq_sum[idx] = sysirq_sum[idx] + blocked
        if blocked > sysirq_max[idx]:
            sysirq_max[idx] = blocked
        return
    sysirq_cnt[idx] = sysirq_cnt[idx] + 1
    sysirq_sum[idx] = sysirq_sum[idx] + blocked
    if blocked > sysirq_max[idx]:
        sysirq_max[idx] = blocked
    sysirq_n = sysirq_n + 1
    if blocked != 0:
        sysirq_hit = sysirq_hit + 1
    sysirq_sum_ns = sysirq_sum_ns + blocked
    if blocked > sysirq_max_ns:
        sysirq_max_ns = blocked
    if blocked <= 1000000:
        sysirq_b1 = sysirq_b1 + 1
    elif blocked <= 5000000:
        sysirq_b5 = sysirq_b5 + 1
    elif blocked <= 12000000:
        sysirq_b12 = sysirq_b12 + 1
    elif blocked <= 25000000:
        sysirq_b25 = sysirq_b25 + 1
    elif blocked <= 60000000:
        sysirq_b60 = sysirq_b60 + 1
    else:
        sysirq_over = sysirq_over + 1


def sysirq_name(nr: uint64) -> Ptr[char]:
    # Names for the syscalls that can plausibly hold the CPU. Anything not
    # listed still reports its number, so an unnamed offender is visible —
    # it just has to be looked up. Ordered roughly by how often it shows up.
    if nr == 8:
        return "write"
    if nr == 6:
        return "read"
    if nr == 5:
        return "open"
    if nr == 7:
        return "close"
    if nr == 13:
        return "open_write"
    if nr == 23:
        return "read_nb"
    if nr == 9:
        return "lseek"
    if nr == 10:
        return "execve"
    if nr == 3:
        return "clone"
    if nr == 12:
        return "waitpid"
    if nr == 14:
        return "pipe"
    if nr == 21:
        return "unlink"
    if nr == 22:
        return "mkdir"
    if nr == 24:
        return "yield"
    if nr == 2:
        return "get_jiffies"
    if nr == 4:
        return "getpid"
    if nr == 1:
        return "exit"
    if nr == 299:
        return "waitpid_jc"
    if nr == 20:
        return "getcwd"
    if nr == 256:
        return "rfork"
    if nr == 265:
        return "errstr"
    if nr == 269:
        return "resolve"
    if nr == 276:
        return "srv_open"
    if nr == 278:
        return "fdbind"
    if nr == 281:
        return "openchan"
    if nr == 293:
        return "wsys_alloc"
    if nr == 302:
        return "mmap"
    if nr == 303:
        return "mprotect"
    if nr == 304:
        return "munmap"
    if nr == 307:
        return "clock_gettime"
    if nr == 308:
        return "nanosleep"
    if nr == 312:
        return "vk_window_frame"
    if nr == 313:
        return "waitfds"
    if nr == 317:
        return "msync"
    if nr == 318:
        return "listdir_records"
    if nr == SYSIRQ_SPAN:
        return "spanning(ctxsw)"
    if nr == SYSIRQ_LINUX:
        return "linux-abi(all)"
    if nr == SYSIRQ_OTHER:
        return "native(other)"
    return "?"


def sysirq_report():
    # One parseable block, EMERG on every line: the console tightens its
    # threshold to suppress INFO once an interactive shell is up
    # (console_set_interactive), so an INFO-level report is invisible in
    # exactly the situation this instrument is used in.
    mean: uint64 = 0
    if sysirq_n > 0:
        mean = sysirq_sum_ns / sysirq_n
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] n=%d armed=%d\n", sysirq_n, cast[uint64](sysirq_on))
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] delayed=%d tick_ns=%d\n", sysirq_hit, SYSIRQ_TICK_NS)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk1("[sysirq] spanning=%d\n", sysirq_span)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] max_us=%d mean_us=%d\n", sysirq_max_ns / 1000,
            mean / 1000)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] le1ms=%d le5ms=%d\n", sysirq_b1, sysirq_b5)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] le12ms=%d le25ms=%d\n", sysirq_b12, sysirq_b25)
    printk_set_level(PRINTK_LEVEL_EMERG)
    printk2("[sysirq] le60ms=%d over60ms=%d\n", sysirq_b60, sysirq_over)
    # The worst offenders, by the WORST SINGLE masked stretch. Selection sort
    # over the table, 8 passes; the table is small and this runs once per
    # report, off the hot path entirely.
    rank: uint64 = 0
    while rank < 8:
        best: uint64 = SYSIRQ_NSLOT
        bestv: uint64 = 0
        i: uint64 = 0
        while i < SYSIRQ_NSLOT:
            if sysirq_cnt[i] != 0 and sysirq_max[i] > bestv:
                bestv = sysirq_max[i]
                best = i
            i = i + 1
        if best >= SYSIRQ_NSLOT:
            rank = 8
        else:
            # Two whole lines, not one line split across two printk calls: a
            # concurrent printk from another CPU would interleave into the
            # middle of a split line and the parser would silently lose the
            # sample.
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[sysirq] top nr=%d n=%d max_us=%d\n",
                    best, sysirq_cnt[best], sysirq_max[best] / 1000)
            printk_set_level(PRINTK_LEVEL_EMERG)
            printk3("[sysirq] top+ nr=%d sum_us=%d name=%s\n", best,
                    sysirq_sum[best] / 1000,
                    cast[uint64](sysirq_name(best)))
            # Consume it so the next pass finds the next-worst. The counter is
            # kept so the entry is not resurrected by a later sample in the
            # same report.
            sysirq_max[best] = 0
            rank = rank + 1


def sysirq_ctl(verb: int64) -> int32:
    # /proc/self/ctl `sysirq <n>`:
    #   0 = disarm   1 = arm + reset   2 = report   3 = reset (stay armed)
    # Every accepted verb ACKs. Without the ack a control write that is
    # silently refused (a permission gate, a parse miss) is indistinguishable
    # from a working one, and the measurement silently measures nothing —
    # which is exactly how the wklat instrument's first two runs were lost.
    if verb == 0:
        sysirq_enable(0)
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[sysirq] ack armed=0\n")
        return 1
    if verb == 1:
        sysirq_enable(1)
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[sysirq] ack armed=1\n")
        return 1
    if verb == 2:
        sysirq_report()
        return 1
    if verb == 3:
        sysirq_reset()
        printk_set_level(PRINTK_LEVEL_EMERG)
        printk0("[sysirq] ack reset\n")
        return 1
    return 0


def timer_interrupt(interrupted_cs: uint64, interrupted_rip: uint64,
                    interrupted_rsp: uint64):
    # Called from do_irq() when vector 32 fires.  Since M16.22 the
    # interrupt source is the Local APIC timer (periodic, configured
    # in arch/x86/kernel/apic.ad); pre-M16.22 it was the PIT through
    # the 8259. The dispatch vector is identical so do_irq routes
    # the same way; the only change is which controller we EOI.
    #
    # `interrupted_cs` is the CS selector the CPU pushed in the iret
    # frame — the privilege level of the code this interrupt froze.
    # (interrupted_cs & 3) == 3 means ring 3 (userland); that is the
    # only context the preemption gate (preempt_tick) will switch out
    # of. See preempt_tick() in kernel/sched/core.ad for the policy.
    #
    # #55 (-smp 2 idle-shell wedge): jiffies is the GLOBAL monotonic tick
    # and must advance at a steady 100 Hz. The BSP (cpu 0) owns the periodic
    # LAPIC tick, so drive jiffies from the BSP ONLY. APs now also take a
    # ~100 Hz preemption tick WHILE THEY RUN WORK (see the AP one-shot
    # re-arm after the EOI below) — if an AP also bumped jiffies the clock
    # would run up to Ncpu× too fast whenever several cores are busy,
    # skewing uptime / nanosleep / timeouts. Per-CPU accounting
    # (local_timer_ticks, current_task_account_tick, preempt_tick) still
    # runs on every CPU below; only the shared jiffies word is BSP-driven.
    # Once the high-res clockevent is live, jiffies is driven from the
    # monotonic clocksource by the tick layer (jiffies_external_drive == 1),
    # NOT bumped per IRQ — otherwise the variable one-shot fire rate makes
    # uptime run fast (many hrtimers) or freeze (NO_HZ idle). See the
    # jiffies_external_drive banner.
    if get_cpu_id() == 0:
        # MACHINE-STALL control for the wklat instrument: the gap between two
        # BSP ticks, read from the same clocksource the wake->dispatch
        # histogram uses. A 90 ms gap here means the whole guest stopped (host
        # vCPU steal under KVM), which no scheduler change could fix and which
        # would otherwise be indistinguishable from a 90 ms dispatch delay.
        # Disarmed cost: one compare. Placed on the BSP branch only so APs
        # cannot interleave two clocks into one series.
        wklat_note_tick()
    if get_cpu_id() == 0 and jiffies_external_drive == 0:
        jiffies = jiffies + 1
    # Per-CPU counter (M16.14 Percpu[T] demo path). Codegen assigns its
    # %gs displacement; cpu_id_pcpu is pinned to offset 0, so this lands
    # after it, NOT at offset 0 — see compiler/codegen_x86.py and
    # arch/x86/kernel/setup_percpu_asm.S.
    local_timer_ticks = local_timer_ticks + 1
    # #169 vDSO: refresh the shared time data page so a userspace
    # __vdso_clock_gettime / __vdso_gettimeofday / __vdso_time read
    # sees the current clock without trapping into the kernel. The TSC
    # advances continuously, so a sub-tick read interpolates a slightly
    # stale value (granularity ~one tick = 10 ms), which is exactly the
    # accuracy contract Linux's CLOCK_*_COARSE-style vDSO fast path
    # gives. No-op before vdso_init() registers the hook (the data
    # page isn't allocated). F4 #449: dispatched through the registered
    # hook pointer rather than a static linux_abi import.
    if vdso_tick_hook != cast[Fn[None]](0):
        vdso_tick_hook()
    # M16.39: drain whatever the UART has into the software RX
    # FIFO, watching for Ctrl-C. If we saw one, post SIGINT to
    # every foreground task (pid > 1). The actual termination
    # happens when the signal'd task next hits a syscall return
    # or a yield_to_others — no preemption-with-signals yet.
    tctl: int32 = uart_drain_hw_to_fifo()
    if (tctl & 1) != 0:
        signal_post_to_foreground(SIGINT)
    if (tctl & 2) != 0:
        signal_post_to_foreground(SIGTSTP)
    # Event-driven belt-and-braces: the timer drain still runs every tick
    # to cover the window where IF was masked (no UART RX IRQ). Wake any
    # console-input sleeper after the drain so a byte buffered during a
    # masked window is consumed without a further tick of latency.
    console_input_wake()
    # M16.75: drain the PS/2 keyboard the same way. Lets the kernel
    # accept input from a real keyboard at boot, not just serial —
    # required for non-QEMU machines that don't expose a UART.
    atkbd_poll()
    # Real-hardware keyboard instrumentation: emit a periodic
    # [atkbd-diag] line (every ~5 s; the function self-rate-limits)
    # showing irq1_count / poll_calls / bytes_from_0x60 / fifo_depth.
    # On the dead-keyboard Asus laptop this transcript is what tells
    # us whether IRQ 1 fires, the tick poll runs, and any byte ever
    # leaves port 0x60.
    atkbd_diag_tick()
    # V1 USB HID: drain the xHCI Event Ring + dispatch any interrupt-IN
    # completions. xhci_poll() is a no-op if V1 enumeration didn't
    # reach kbd_enabled — so this is safe to call unconditionally.
    xhci_poll()
    # V1 USB 2.0 HID: drain the EHCI interrupt-IN qTD the same way.
    # ehci_poll() is a no-op if EHCI V1 didn't arm a keyboard.
    ehci_poll()
    # Audio stream lifetime: stop a staged clip after exactly one lap of the
    # cyclic buffer, and stop a streaming ring whose owning process has
    # exited. Nothing else runs once the producer is gone. See
    # register_audio_tick_hook and drivers/audio/hda.ad::hda_service_tick.
    if audio_tick_hook != cast[Fn[None]](0):
        audio_tick_hook()
    # LIVE-MOUSE FIX: drain whatever the PS/2 (IRQ12) and USB-HID producers
    # pushed onto the shared mouse ring this tick and route each event to
    # the scene compositor (cursor move + hit-test + window-local forward).
    # No-op until the DE owns the screen (wsys_de_is_live), so a userspace
    # /dev/mouse reader still owns the ring before the rl5 flip.
    #
    # POINTER-SERVICE GAP: sample the wall-clock interval between successive
    # pumps right here. This IS the pointer's worst-case staleness (see the
    # ptrlat_sample banner) and it is the number the latency gate asserts on.
    if get_cpu_id() == 0:
        ptrlat_sample(interrupted_rip, interrupted_cs)
        # sysirq: this tick is the witness that EFLAGS.IF was set right now.
        # Disarmed by default — one predictable-branch test per tick.
        if sysirq_on != 0:
            sysirq_tick()
    mouse_pump_to_compositor()
    # BUG 1 FIX: keyboard twin of the mouse pump. Drain the PS/2 keyboard
    # FIFO + UART RX ring and route each byte to the focused scene window's
    # /keys stream. No-op until the DE owns the screen (wsys_de_is_live).
    kbd_pump_to_compositor()
    # EOI the LAPIC NOW — before any possible context switch. The EOI
    # clears the timer vector's in-service bit; if we deferred it past
    # the schedule() below it would only land when THIS task is
    # rescheduled, and the task we switch to would never receive
    # another timer IRQ (its in-service bit would still be set). This
    # is also why do_irq() no longer EOIs the timer vector itself.
    lapic_send_eoi()
    # Bottom-half pass on the timer IRQ-return. The hook (registered by
    # softirq_init) raises TIMER_SOFTIRQ — whose handler drives the L9
    # timer wheel + hrtimers — then runs do_softirq() to drain TIMER plus
    # any tasklet/NET_RX raised since the last pass. Runs BEFORE the
    # preemption gate so a switch-out doesn't strand pending softirqs.
    # Null until softirq_init(); the pure-native early-boot tick is a
    # no-op here.
    if softirq_tick_hook != cast[Fn[None]](0):
        softirq_tick_hook()
    # Hi-res timer subsystem (kernel/time/): run the hrtimer expiry pass
    # against the live ns clocksource and reprogram the clockevent for the
    # next earliest deadline. In one-shot mode this is what RE-ARMS the
    # LAPIC for the next hrtimer; in periodic mode it still fires any due
    # hrtimers at ns-accurate deadlines. Done AFTER the EOI so the one-shot
    # reprogram lands on a clean in-service state. No-op before boot:16.time
    # registers the hook (legacy jiffies tick only).
    #
    # QA-N32b BSP-ONLY GUARD: run the hrtimer expiry + clockevent reprogram
    # ONLY on the BSP (cpu 0). The hrtimer queue (kernel/time/hrtimer.ad
    # ht_q/ht_qlen) and clockevent state are global and unlocked; the self-
    # rearming scheduler-tick hrtimer keeps the BSP LAPIC firing. If an AP —
    # woken by its local LAPIC backstop (kernel/sched/core.ad
    # sched_ap_idle_loop) — also ran this pass, two CPUs would mutate the
    # shared queue at once, occasionally dropping the sched-tick timer and
    # wedging the whole box with jiffies frozen (the long-parked #9 wedge).
    # APs still bump jiffies + run preempt_tick above; only the shared-state
    # hrtimer drive is BSP-exclusive. On UP (cpu 0 only) this is a no-op.
    if hrtimer_tick_hook != cast[Fn[None]](0) and get_cpu_id() == 0:
        hrtimer_tick_hook()
    # #55 AP PREEMPTION TICK — root fix for the -smp 2 idle-shell wedge.
    #
    # The BSP owns the shared clockevent: it keeps a periodic 100 Hz LAPIC
    # tick (or re-arms its one-shot via hrtimer_tick_hook just above), so the
    # BSP always has a preemption tick. An AP is otherwise TICKLESS — it only
    # arms a ONE-SHOT backstop right before it HLTs (sched_ap_idle_loop's
    # no-work branch and yield_to_others). That backstop fires ONCE to wake
    # the AP, and nothing re-arms it once the AP dispatches a real user task.
    # So a CPU-bound user task on an AP (e.g. a DE app spinning during rl5
    # bring-up) got NO further timer IRQs: preempt_tick never ran, its
    # quantum never drained, and it monopolized the core FOREVER — starving
    # every other STATE_READY task on that AP's runqueue, including the serial
    # shell, which then never emitted its [hamsh-alive] heartbeat. -smp 1 (BSP
    # only, always ticking) was 100% reliable; -smp 2 wedged. That is #55.
    #
    # Fix: on EVERY AP timer tick, re-arm this AP's one-shot so preemption
    # keeps firing at ~100 Hz while the AP has work. The always-armed idle
    # backstop guarantees the FIRST tick within a few ms of any wake (timer
    # OR reschedule IPI), and this re-arm perpetuates it thereafter. When the
    # AP next goes idle, sched_ap_idle_loop re-arms its own (shorter) backstop
    # via the same primitive, so tickless-idle for power is fully preserved.
    # The EOI above already cleared the in-service bit, so this reprogram
    # lands on a clean state. BSP is untouched.
    if get_cpu_id() != 0:
        lapic_timer_set_oneshot_ns(AP_PREEMPT_TICK_NS)
    # setitimer(2) ITIMER_REAL: decrement every armed task's wall-clock
    # countdown by one tick and post SIGALRM on expiry. BSP-only — the counters
    # are global task_table state with no cross-CPU lock, and ITIMER_REAL is
    # wall-clock (one decrement per real tick, not per CPU), so an AP backstop
    # tick must NOT also decrement or a 100 ms timer would fire early on SMP.
    # This is what lets xeyes/xclock (and most X/GTK apps) redraw off SIGALRM.
    if get_cpu_id() == 0:
        itimer_real_tick_all()
    # Preemption gate. preempt_tick() ages this task's quantum and
    # returns 1 only when the quantum is spent AND the timer caught
    # ring-3 (userland) code AND another task is STATE_READY. Ring-0
    # ticks (kthreads / IRQ context) never trigger a switch — kernel
    # code is treated as non-preemptible; the cooperative yields
    # already cover it. Only on a 1 do we run schedule(), whose
    # __switch_to_asm saves THIS task's full interrupted state (the
    # IRQ frame + caller-saved are already on its kstack) and resumes
    # the next task; when this task is later picked again, schedule()
    # returns here and we unwind back through do_irq -> common_irq's
    # iretq into the exact userland instruction we interrupted.
    user_ctx: uint64 = 0
    if (interrupted_cs & 3) == 3:
        user_ctx = 1
    # Linux-ABI no-syscall watchdog. Runs before the preemption gate so a
    # switch-out doesn't skip the check. Passes the interrupted RIP/RSP so
    # the hook can pin a userspace spin to a library+offset. No-op until
    # mm/vma.ad registers it; internally a no-op unless the running task is
    # a Linux-ABI task past the no-syscall threshold.
    if linux_nosyscall_wd_hook \
            != cast[Fn[None, uint64, uint64, uint64]](0):
        linux_nosyscall_wd_hook(user_ctx, interrupted_rip, interrupted_rsp)
    # Bounded-futex-park sweep: directed-wake any FUTEX_WAIT parker whose
    # recheck interval elapsed (see linux_futex_tick_hook above). IRQ-context
    # safe: the hook trylocks the futex table and simply skips this tick if the
    # interrupted code holds it.
    if linux_futex_tick_hook != cast[Fn[None]](0):
        linux_futex_tick_hook()
    # §13: per-tick load accounting — idle-jiffies bump (this tick
    # caught a non-userland context iff user_ctx == 0) plus the
    # 5-second EWMA sampler. Cheap; runs before the preemption gate
    # so a switch-out doesn't skip the sample.
    loadavg_tick(user_ctx)
    # getrusage(2): charge this tick to the running task — user time if it
    # caught ring-3 code, system time otherwise. Runs before the
    # preemption gate so a switch-out doesn't skip the accounting.
    current_task_account_tick(user_ctx)
    # /proc/stat 3-way split: charge this tick to EXACTLY one global
    # bucket. user if the timer froze ring-3 code; else idle if the CPU
    # was parked in an idle-wait hlt (pure-instrumentation flag); else
    # system (kernel doing real non-userland work). See devstat.ad.
    if user_ctx == 1:
        g_stat_user_jiffies = g_stat_user_jiffies + 1
    elif cpu_is_idle() != 0:
        g_stat_idle_jiffies = g_stat_idle_jiffies + 1
    else:
        g_stat_system_jiffies = g_stat_system_jiffies + 1
    if preempt_tick(user_ctx) != 0:
        schedule()


def get_local_timer_ticks() -> uint64:
    return local_timer_ticks


def get_jiffies() -> uint64:
    return jiffies


def stat_user_jiffies() -> uint64:
    # Ticks the timer froze ring-3 (userland) code. /proc/stat user col.
    return g_stat_user_jiffies


def stat_system_jiffies() -> uint64:
    # Ticks the kernel was doing real non-idle work. /proc/stat system col.
    return g_stat_system_jiffies


def stat_idle_jiffies() -> uint64:
    # Ticks the CPU was parked in an idle-wait hlt. /proc/stat idle col.
    return g_stat_idle_jiffies


# -- PIT-counter monotonic microsecond clock ---------------------------
#
# `jiffies` is bumped by the LAPIC timer interrupt; it FREEZES whenever
# CPU interrupts are masked. A SYSCALL entry clears EFLAGS.IF (IA32_FMASK
# = 0x0200), so for the whole duration of a userland read(2)/write(2)
# syscall `jiffies` does not advance — a `while get_jiffies() < deadline`
# loop in that context degenerates into `while True`.
#
# The 8254 PIT channel 0, by contrast, is a free-running hardware
# counter: it keeps decrementing at PIT_BASE_HZ (~1.193 MHz) regardless
# of EFLAGS.IF. By latching and reading its 16-bit count we get a time
# source that ADVANCES during a syscall. pit_monotonic_us() turns that
# into a monotonic microsecond counter: each call latches the counter,
# measures how far it moved since the previous call, and accumulates the
# elapsed microseconds. It MUST be polled often enough that the counter
# does not wrap more than once between calls (one wrap ≈ divisor/1.193MHz
# ≈ 10 ms at HZ=100) — the network poll loops that use it call it every
# virtio_net_poll() iteration, far faster than that.
#
# Channel 0 runs in mode 3 (square wave). In mode 3 the 8254 decrements
# the count by TWO on every PIT input clock, so the latched count value
# sweeps the full [0, divisor) range in only divisor/2 input clocks. The
# accumulator below measures count-VALUE units traversed; to convert to
# real elapsed time it must divide by 2 (a count-units delta of N
# corresponds to N/2 PIT input clocks at PIT_BASE_HZ). The pre-fix code
# omitted that /2 and over-reported elapsed time by exactly 2x — see the
# `(2 * PIT_BASE_HZ)` divisor in pit_monotonic_us().

pit_us_accum:   uint64 = 0      # accumulated microseconds since first call
pit_last_count: uint64 = 0      # last latched PIT counter value
pit_us_inited:  uint8  = 0      # 0 until the first pit_monotonic_us call
# Sub-microsecond remainder carried between calls so the integer divide
# by PIT_BASE_HZ does not drop fractional ticks over a long poll.
pit_tick_rem:   uint64 = 0


def _pit_read_count() -> uint64:
    # Latch channel 0 (counter-latch command: bits 7:6 = 00 select
    # channel 0, bits 5:4 = 00 = latch) then read lo, hi from the data
    # port. Returns the 16-bit count.
    outb(0x00, PIT_CMD)
    lo: uint64 = cast[uint64](inb(PIT_CHANNEL0_DATA)) & 0xFF
    hi: uint64 = cast[uint64](inb(PIT_CHANNEL0_DATA)) & 0xFF
    return (hi << 8) | lo


def pit_monotonic_us() -> uint64:
    # Free-running microsecond counter, valid even with CPU interrupts
    # masked. See the banner above. The first call seeds the baseline
    # and returns 0; each later call adds the elapsed microseconds.
    divisor: uint64 = PIT_BASE_HZ / HZ
    cur: uint64 = _pit_read_count()
    if pit_us_inited == 0:
        pit_us_inited = 1
        pit_last_count = cur
        pit_us_accum = 0
        pit_tick_rem = 0
        return 0
    # PIT counts DOWN. ticks elapsed = last - cur when it did not wrap;
    # on a wrap (cur > last) the counter reloaded, so the elapsed span
    # is (last - 0) + (divisor - cur) = last + divisor - cur.
    ticks: uint64 = 0
    if cur <= pit_last_count:
        ticks = pit_last_count - cur
    else:
        ticks = pit_last_count + divisor - cur
    pit_last_count = cur
    # Convert traversed count-units to microseconds. Channel 0 is mode 3
    # (square wave): the count decrements by 2 per PIT input clock, so
    # `ticks` count-units == ticks/2 input clocks. Therefore
    #   us = (ticks / 2) * 1e6 / PIT_BASE_HZ = ticks * 1e6 / (2*PIT_BASE_HZ)
    # Doing the *1e6 before the divide (and carrying the remainder)
    # keeps sub-microsecond precision over a long poll.
    num: uint64 = ticks * 1000000 + pit_tick_rem
    pit_us_accum = pit_us_accum + (num / (2 * PIT_BASE_HZ))
    pit_tick_rem = num % (2 * PIT_BASE_HZ)
    return pit_us_accum


# -- TSC-based high-resolution monotonic clock -------------------------
#
# `jiffies` has 10 ms granularity and freezes whenever EFLAGS.IF is
# clear; pit_monotonic_us() has microsecond granularity but needs a
# 16-bit PIT latch + two `inb`s per call and depends on being polled
# faster than the ~10 ms PIT wrap. The CPU Time Stamp Counter is the
# real high-resolution monotonic source: a 64-bit register the CPU
# increments at a (constant, on every CPU we target) rate, readable in
# a handful of cycles by RDTSC. At a few GHz it gives sub-nanosecond
# resolution and a 64-bit counter does not wrap for ~100 years.
#
# To turn raw TSC ticks into nanoseconds we must know the TSC
# frequency. We measure it the same way calibrate_APIC_clock() in
# arch/x86/kernel/apic.ad measures the LAPIC: gate PIT channel 2 on
# for a precise 10 ms one-shot, sample RDTSC at both ends, and the
# delta is "TSC ticks per 10 ms". ×100 gives the TSC frequency in Hz.
#
# Conversion ns = ticks * 1e9 / tsc_hz is done as a fixed-point
# multiply: we precompute tsc_ns_mult = (1e9 << TSC_SHIFT) / tsc_hz
# once at calibration time, then each query is
#     ns = (delta_ticks * tsc_ns_mult) >> TSC_SHIFT
# which is a single 64-bit multiply + shift, no per-call division.
# TSC_SHIFT = 20 keeps the multiplier comfortably inside 64 bits for
# any plausible TSC frequency (at 1e12 Hz the multiplier is still only
# ~1e9) while giving ~1e-6 relative precision.
#
# Overflow note: `delta_ticks * tsc_ns_mult` is a 64-bit product. At a
# ~4 GHz TSC, tsc_ns_mult ≈ 2^18, so the product overflows once
# delta_ticks exceeds ~2^46 ticks ≈ several hours of uptime. That is
# well beyond any test horizon; a wrap-free multi-day clock would need
# a 128-bit intermediate (or periodic re-basing of tsc_base from a
# timer-driven seconds accumulator) — noted as a follow-up.

# Same PIT channel 2 wiring the LAPIC calibration uses. Channel 2 is
# the one channel whose GATE we can software-control (port 0x61 bit 0)
# and whose OUT pin we can poll (port 0x61 bit 5).
TSC_PIT_CH2_DATA:  int32 = 0x42
TSC_PIT_CTRL_PORT: int32 = 0x61
# Channel 2, lobyte/hibyte, mode 0 (one-shot), binary = 0xB0.
TSC_PIT_CMD_CH2:   int32 = 0xB0
# 10 ms at 1193182 Hz: 11932 = 0x2E9C.
TSC_PIT_10MS_DIV:  int32 = 0x2E9C
TSC_CAL_MS:        uint64 = 10
# Port 0x61: bit 0 GATE2, bit 1 speaker, bit 5 channel-2 OUT.
TSC_PIT_GATE:  int32 = 0x01
TSC_PIT_SPEAK: int32 = 0x02
TSC_PIT_OUT:   int32 = 0x20

# Fixed-point shift for the ticks->ns multiply (see banner).
TSC_SHIFT: uint64 = 20

tsc_hz:      uint64 = 0    # measured TSC frequency, Hz (0 until calibrated)
tsc_ns_mult: uint64 = 0    # (1e9 << TSC_SHIFT) / tsc_hz
tsc_base:    uint64 = 0    # RDTSC value captured at calibration ("t=0")
tsc_ready:   uint8  = 0    # 1 once tsc_init() succeeded


def _tsc_pit_gate_off():
    cur: int32 = inb(TSC_PIT_CTRL_PORT)
    outb(cur & ~(TSC_PIT_GATE | TSC_PIT_SPEAK), TSC_PIT_CTRL_PORT)


def _tsc_pit_gate_on():
    cur: int32 = inb(TSC_PIT_CTRL_PORT)
    outb((cur & ~TSC_PIT_SPEAK) | TSC_PIT_GATE, TSC_PIT_CTRL_PORT)


def tsc_init():
    # Calibrate the TSC frequency against a PIT channel 2 10 ms
    # one-shot, then derive the fixed-point ns multiplier and capture
    # the monotonic-clock zero point. Safe to call once, after the PIT
    # exists (post-time_init). Interrupts should be off; the busy-poll
    # below would otherwise be perturbed by an IRQ — but a perturbation
    # only stretches the measured window, it cannot make TSC run
    # backwards, so calibration stays monotonic-safe regardless.

    # Stop channel 2 + silence the speaker before programming.
    _tsc_pit_gate_off()

    # Program channel 2: mode 0 one-shot, 10 ms divisor.
    outb(TSC_PIT_CMD_CH2, PIT_CMD)
    outb(TSC_PIT_10MS_DIV & 0xFF, TSC_PIT_CH2_DATA)
    outb((TSC_PIT_10MS_DIV >> 8) & 0xFF, TSC_PIT_CH2_DATA)

    # Open the gate and immediately snapshot the TSC: t0.
    _tsc_pit_gate_on()
    t0: uint64 = read_tsc()

    # Spin until the channel-2 OUT pin (port 0x61 bit 5) goes high —
    # that is the 10 ms terminal count.
    while (inb(TSC_PIT_CTRL_PORT) & TSC_PIT_OUT) == 0:
        pass

    t1: uint64 = read_tsc()
    _tsc_pit_gate_off()

    delta: uint64 = t1 - t0
    # delta TSC ticks elapsed in TSC_CAL_MS milliseconds.
    # tsc_hz = delta * 1000 / TSC_CAL_MS.
    tsc_hz = delta * 1000 / TSC_CAL_MS

    # Guard: a wildly implausible measurement (PIT poll exited early,
    # or RDTSC unavailable) would poison every later conversion. If the
    # frequency is outside a sane window [1 MHz, 100 GHz], fall back to
    # a nominal 1 GHz so the clock still advances rather than dividing
    # by something absurd. Real CPUs and QEMU/TCG both land well inside.
    if tsc_hz < 1000000 or tsc_hz > 100000000000:
        printk1("tsc: calibration implausible (%d Hz) — fallback 1 GHz\n",
                tsc_hz)
        tsc_hz = 1000000000

    # Precompute the fixed-point ns multiplier: tsc_ns_mult such that
    # ns = (ticks * tsc_ns_mult) >> TSC_SHIFT  ≈  ticks * 1e9 / tsc_hz.
    tsc_ns_mult = (1000000000 << TSC_SHIFT) / tsc_hz

    # Capture the zero point. tsc_monotonic_ns() reports time since
    # this instant.
    tsc_base = read_tsc()
    tsc_ready = 1

    mhz: uint64 = tsc_hz / 1000000
    printk1("tsc: calibrated %d MHz", mhz)
    printk1(" (%d Hz)\n", tsc_hz)


def tsc_calibrated() -> uint64:
    # 1 once tsc_init() has run, else 0. Lets callers fall back to the
    # jiffies clock before the TSC is up.
    return cast[uint64](tsc_ready)


def tsc_hz_get() -> uint64:
    return tsc_hz


def tsc_monotonic_ns() -> uint64:
    # Nanoseconds since tsc_init() captured the zero point. Monotonic
    # and high-resolution; valid with CPU interrupts masked (RDTSC does
    # not depend on EFLAGS.IF). Before calibration, fall back to the
    # jiffies clock (10 ms granularity) so callers still get a sane,
    # advancing value.
    if tsc_ready == 0:
        return get_jiffies() * 10000000
    now: uint64 = read_tsc()
    # TSC is a free-running up-counter; `now` cannot be below tsc_base
    # in normal operation. Guard the subtraction anyway so a spurious
    # reading can never produce a gigantic unsigned wrap.
    delta: uint64 = 0
    if now > tsc_base:
        delta = now - tsc_base
    return (delta * tsc_ns_mult) >> TSC_SHIFT


def tsc_monotonic_us() -> uint64:
    # Microsecond form of tsc_monotonic_ns().
    return tsc_monotonic_ns() / 1000
