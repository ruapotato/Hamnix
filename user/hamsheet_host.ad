# user/hamsheet_host.ad — HOST driver + render harness for HamSheet, the office
# SPREADSHEET (built for x86_64-linux; runs on the dev host, no QEMU).
#
# Drives the SAME core the native app ships (lib/hamsheetcore.ad) AND exercises
# the formula engine + persistence end-to-end against the REAL host filesystem:
# it types numbers into A1/A2/A3, a `=SUM(A1:A3)` formula into B1 and a couple
# more formulas (AVG / a cell-arithmetic expression), asserts the COMPUTED
# results, renders the grid, SAVES it (Ctrl-S -> a HAMSHEET1 container on disk),
# CLEARS the sheet, then RE-OPENS the file off disk (Ctrl-O) — proving the cell
# text AND the formulas survive a save->load round-trip and recompute to the
# same values. Two PPMs are written for a human/agent to LOOK at.
#
# It also drives the SHARED Save-As dialog (lib/filepick.ad) exactly as the
# native driver does: the toolbar's SaveAs button raises action 11, the driver
# pops the chooser seeded with the sheet's own directory + basename, the dialog
# is RENDERED as a centred panel over the live grid, a new filename is typed and
# committed with Enter, and the returned ABSOLUTE path is then written and
# re-read to prove the round trip.
#
# USAGE (built to build/host/hamsheet_host):
#   hamsheet_host DOCPATH BEFORE.ppm AFTER.ppm SAVEDLG.ppm

extern def sys_open(path: Ptr[char], flags: int32, mode: int32) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32

from lib.hamscene import hamscene_bufptr, hamscene_length
from lib.hamui_host import hamui_host_begin, hamui_host_rasterize, \
    hamui_host_ppm_header, hamui_host_fb_ptr, hamui_host_fb_bytes, \
    hamui_host_pixel
from lib.filepick import filepick_open, filepick_active, filepick_emit_panel, \
    filepick_handle_code, filepick_take_result, filepick_result_path, \
    filepick_result_mode, filepick_save_name_ptr, FILEPICK_SAVE
from lib.hamfmcore import fmc_set_cur_path, fmc_model_reset, fmc_add_entry, \
    fmc_sort_entries, fmc_select
from lib.hamsheetcore import hamsheet_init, hamsheet_build_scene, \
    hamsheet_set_cell, hamsheet_cell_kind, hamsheet_cell_value_fp, \
    hamsheet_cell_display, hamsheet_recompute, hamsheet_serialize, \
    hamsheet_deserialize, hamsheet_clear, hamsheet_set_fname, \
    hamsheet_key_line, hamsheet_take_action, hamsheet_cur_ref, \
    hamsheet_sel_row, hamsheet_sel_col, hamsheet_cell_raw_ptr, \
    hamsheet_cell_raw_len, hamsheet_select, hamsheet_set_fmt, \
    hamsheet_export_csv, hamsheet_import_csv, hamsheet_col_width, \
    hamsheet_cell_fmt, hamsheet_undo_depth, hamsheet_hit, hamsheet_mark_saved


obuf: Array[512, uint8]
obuf_n: uint64 = 0


def _o_ch(c: uint8):
    if obuf_n < 511:
        obuf[obuf_n] = c
        obuf_n = obuf_n + 1


def _o_str(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        _o_ch(s[i])
        i = i + 1


def _o_dec(v: int64):
    if v < 0:
        _o_ch(45)
        v = 0 - v
    if v == 0:
        _o_ch(48)
        return
    digs: Array[24, uint8]
    n: uint64 = 0
    x: uint64 = cast[uint64](v)
    while x > 0:
        digs[n] = cast[uint8](x % 10) + 48
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        _o_ch(digs[n])


def _o_flush():
    if obuf_n > 0:
        sys_write(1, &obuf[0], obuf_n)
        obuf_n = 0


ppm_hdr: Array[64, uint8]


def _write_ppm(path: Ptr[char]) -> int32:
    fd: int32 = sys_open(path, 577, 420)               # O_WRONLY|O_CREAT|O_TRUNC
    if fd < 0:
        return -1
    hlen: uint64 = hamui_host_ppm_header(&ppm_hdr[0])
    sys_write(fd, &ppm_hdr[0], hlen)
    sys_write(fd, hamui_host_fb_ptr(), hamui_host_fb_bytes())
    sys_close(fd)
    return 0


def _render(w: int32, h: int32) -> int32:
    hamsheet_build_scene()
    hamui_host_begin(w, h)
    return hamui_host_rasterize()


# ---- host-side persistence (mirrors user/hamsheet.ad) ---------------------
ser_buf: Array[32768, uint8]
csv_buf: Array[8192, uint8]
h1_buf:  Array[512, uint8]
doc_path: Array[192, uint8]
doc_path_len: uint64 = 0


def _set_docpath(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and i < 191:
        doc_path[i] = s[i]
        i = i + 1
    doc_path[i] = 0
    doc_path_len = i


def _save_doc():
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 577, 420)
    if fd < 0:
        return
    n: uint64 = hamsheet_serialize(&ser_buf[0])
    sys_write(fd, &ser_buf[0], n)
    sys_close(fd)


def _load_doc():
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 0, 0)   # O_RDONLY
    if fd < 0:
        hamsheet_deserialize(&ser_buf[0], 0)
        return
    total: uint64 = 0
    while total < 32768:
        r: int64 = sys_read(fd, &ser_buf[total], 32768 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    hamsheet_deserialize(&ser_buf[0], total)


raw_buf: Array[16384, uint8]


def _file_len() -> int64:
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 0, 0)
    if fd < 0:
        return -1
    total: int64 = 0
    while total < 16384:
        r: int64 = sys_read(fd, &raw_buf[total], 16384 - cast[uint64](total))
        if r <= 0:
            break
        total = total + r
    sys_close(fd)
    return total


def _dispatch(act: int32):
    if act == 1:
        _save_doc()
    elif act == 2:
        _load_doc()


# ---- the SHARED Save/Open dialog (mirrors user/hamsheet.ad) ---------------
# The driver pops lib/filepick.ad seeded with the sheet's own DIRECTORY and
# basename, renders it as a centred panel over the live grid, and on commit
# adopts the returned absolute path. Directory enumeration is a kernel path the
# dev host cannot run, so the listing is injected with the browse core's own
# model primitives (the same records fmc_load_dir yields on-device).
dlg_dir:  Array[192, uint8]
alt_path: Array[192, uint8]
alt_path_len: uint64 = 0


def _doc_dir(out: Ptr[uint8]) -> uint64:
    cut: uint64 = 0
    k: uint64 = 0
    while k < doc_path_len:
        if doc_path[k] == 47:
            cut = k + 1
        k = k + 1
    p: uint64 = 0
    while p < cut:
        out[p] = doc_path[p]
        p = p + 1
    # Strip the trailing slash (fmc keeps paths without one, except at root).
    if p > 1 and out[p - 1] == 47:
        p = p - 1
    out[p] = 0
    return p


def _doc_base() -> Ptr[uint8]:
    cut: uint64 = 0
    k: uint64 = 0
    while k < doc_path_len:
        if doc_path[k] == 47:
            cut = k + 1
        k = k + 1
    return &doc_path[cut]


def _pop_dialog(mode: int32):
    _doc_dir(&dlg_dir[0])
    filepick_open(mode, &dlg_dir[0], _doc_base())
    # Host stand-in for fmc_load_dir(): a representative listing to browse.
    fmc_set_cur_path(&dlg_dir[0])
    fmc_model_reset()
    fmc_add_entry(cast[Ptr[uint8]]("Reports"), 1, 0)
    fmc_add_entry(cast[Ptr[uint8]]("hamsheet_scratch.hsheet"), 0, 0)
    fmc_sort_entries()
    fmc_select(-1)


def _render_with_dialog(w: int32, h: int32) -> int32:
    hamsheet_build_scene()
    filepick_emit_panel(w, h)
    hamui_host_begin(w, h)
    return hamui_host_rasterize()


# Adopt a committed pick: the returned path becomes the sheet's path, then the
# document is written there (SAVE) exactly as user/hamsheet.ad does.
def _apply_pick():
    src: Ptr[uint8] = filepick_result_path()
    p: uint64 = 0
    while src[p] != 0 and p < 191:
        alt_path[p] = src[p]
        p = p + 1
    alt_path[p] = 0
    alt_path_len = p
    cut: uint64 = 0
    k: uint64 = 0
    while k < alt_path_len:
        if alt_path[k] == 47:
            cut = k + 1
        k = k + 1
    hamsheet_set_fname(&alt_path[cut])                 # title bar basename
    fd: int32 = sys_open(cast[Ptr[char]](&alt_path[0]), 577, 420)
    if fd < 0:
        return
    n: uint64 = hamsheet_serialize(&ser_buf[0])
    sys_write(fd, &ser_buf[0], n)
    sys_close(fd)
    hamsheet_mark_saved()


# Re-read the Save-As target off disk into the live sheet (round-trip proof).
def _load_alt() -> int64:
    fd: int32 = sys_open(cast[Ptr[char]](&alt_path[0]), 0, 0)
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < 32768:
        r: int64 = sys_read(fd, &ser_buf[total], 32768 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    hamsheet_deserialize(&ser_buf[0], total)
    return cast[int64](total)


# Feed one keypress via the "d <code>" wire line, then drain+dispatch action.
kl: Array[16, uint8]
last_action: int32 = 0


def _press(code: int32) -> int32:
    kl[0] = 100                                        # 'd'
    kl[1] = 32
    p: uint64 = 2
    if code < 0:
        kl[p] = 45
        p = p + 1
        code = 0 - code
    if code >= 100:
        kl[p] = cast[uint8](code / 100) + 48
        p = p + 1
    if code >= 10:
        kl[p] = cast[uint8]((code / 10) % 10) + 48
        p = p + 1
    kl[p] = cast[uint8](code % 10) + 48
    p = p + 1
    ch: int32 = hamsheet_key_line(&kl[0], p)
    last_action = 0
    if ch == 1:
        act: int32 = hamsheet_take_action()
        last_action = act
        if act != 0:
            _dispatch(act)
    return ch


# Type a NUL-terminated ASCII string through the key path.
def _type(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        _press(cast[int32](s[i]))
        i = i + 1


# Dump the display string of cell (r,c) as `<tag> <text>`.
dbuf: Array[48, uint8]


def _dump_cell(tag: Ptr[uint8], r: uint64, c: uint64):
    _o_str(tag)
    _o_ch(32)
    hamsheet_cell_display(r, c, &dbuf[0])
    _o_str(&dbuf[0])
    _o_ch(10)


# Dump the RAW source text of cell (r,c) as `<tag> <text>`.
def _dump_raw(tag: Ptr[uint8], r: uint64, c: uint64):
    _o_str(tag)
    _o_ch(32)
    p: Ptr[uint8] = hamsheet_cell_raw_ptr(r, c)
    n: uint64 = hamsheet_cell_raw_len(r, c)
    i: uint64 = 0
    while i < n:
        _o_ch(p[i])
        i = i + 1
    _o_ch(10)


hb_n: uint64 = 0


def _hb(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        if hb_n < 511:
            h1_buf[hb_n] = s[i]
            hb_n = hb_n + 1
        i = i + 1


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 5:
        _o_str(cast[Ptr[uint8]](
            "usage: hamsheet_host DOCPATH BEFORE.ppm AFTER.ppm SAVEDLG.ppm\n"))
        _o_flush()
        return 2

    _set_docpath(cast[Ptr[uint8]](argv[1]))
    hamsheet_init()
    hamsheet_set_fname(cast[Ptr[uint8]]("budget.hsheet"))

    W: int32 = 600
    H: int32 = 384

    # ---- (1) empty grid: title bar + formula bar + headers -------------
    prims: int32 = _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[2]))
    _o_str(cast[Ptr[uint8]]("PRIMS "))
    _o_dec(cast[int64](prims))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("PIX 4 4 "))
    _o_dec(cast[int64](hamui_host_pixel(4, 4)))        # title bar (green)
    _o_ch(10)

    # ---- (2) enter values into A1/A2/A3 --------------------------------
    hamsheet_set_cell(0, 0, cast[Ptr[uint8]]("10"))    # A1
    hamsheet_set_cell(1, 0, cast[Ptr[uint8]]("20"))    # A2
    hamsheet_set_cell(2, 0, cast[Ptr[uint8]]("30"))    # A3
    hamsheet_set_cell(3, 0, cast[Ptr[uint8]]("Total")) # A4 (text label)

    # ---- (3) formulas: SUM range, AVG range, cell arithmetic -----------
    hamsheet_set_cell(0, 1, cast[Ptr[uint8]]("=SUM(A1:A3)"))     # B1 -> 60
    hamsheet_set_cell(1, 1, cast[Ptr[uint8]]("=AVG(A1:A3)"))     # B2 -> 20
    hamsheet_set_cell(2, 1, cast[Ptr[uint8]]("=A1+A2*2"))        # B3 -> 50
    hamsheet_set_cell(3, 1, cast[Ptr[uint8]]("=MAX(A1:A3)"))     # B4 -> 30
    hamsheet_set_cell(4, 1, cast[Ptr[uint8]]("=COUNT(A1:A3)"))   # B5 -> 3
    hamsheet_recompute()

    # Assert computed values (scaled by 10^6).
    _o_str(cast[Ptr[uint8]]("SUM_FP "))
    _o_dec(hamsheet_cell_value_fp(0, 1))               # 60000000
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("AVG_FP "))
    _o_dec(hamsheet_cell_value_fp(1, 1))               # 20000000
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("EXPR_FP "))
    _o_dec(hamsheet_cell_value_fp(2, 1))               # 50000000
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("MAX_FP "))
    _o_dec(hamsheet_cell_value_fp(3, 1))               # 30000000
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("COUNT_FP "))
    _o_dec(hamsheet_cell_value_fp(4, 1))               # 3000000
    _o_ch(10)
    # And their human display strings.
    _dump_cell(cast[Ptr[uint8]]("SUM_DISP"), 0, 1)     # 60
    _dump_cell(cast[Ptr[uint8]]("AVG_DISP"), 1, 1)     # 20
    _dump_cell(cast[Ptr[uint8]]("EXPR_DISP"), 2, 1)    # 50
    _o_str(cast[Ptr[uint8]]("A4_KIND "))
    _o_dec(cast[int64](hamsheet_cell_kind(3, 0)))      # 2 = TEXT
    _o_ch(10)
    _o_flush()

    # ---- (4) render the populated grid ---------------------------------
    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[3]))
    _o_str(cast[Ptr[uint8]]("SCENE-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("SCENE-END\n"))
    _o_flush()

    # ---- (5) SAVE (Ctrl-S) ---------------------------------------------
    _press(19)
    _o_str(cast[Ptr[uint8]]("FILE_LEN "))
    _o_dec(_file_len())
    _o_ch(10)
    _o_flush()

    # ---- (6) CLEAR, then RE-OPEN off disk (round-trip proof) -----------
    hamsheet_clear()
    _o_str(cast[Ptr[uint8]]("SUM_AFTER_CLEAR "))
    _o_dec(hamsheet_cell_value_fp(0, 1))               # 0
    _o_ch(10)
    # Ctrl-O now raises the SHARED Open dialog (action 12) rather than blindly
    # reloading the fixed path; the driver's answer to that action is the
    # chooser, and the chooser's answer is a path this harness then loads.
    _press(15)
    _o_str(cast[Ptr[uint8]]("CTRLO_ACTION "))
    _o_dec(cast[int64](last_action))                   # 12 = ACT_OPEN
    _o_ch(10)
    _load_doc()
    _o_str(cast[Ptr[uint8]]("SUM_AFTER_OPEN "))
    _o_dec(hamsheet_cell_value_fp(0, 1))               # 60000000 again
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("EXPR_AFTER_OPEN "))
    _o_dec(hamsheet_cell_value_fp(2, 1))               # 50000000
    _o_ch(10)

    # ---- (7) TYPE into A1 via the keyboard, commit, watch recalc cascade
    # A1 is the selected cell after a load. Type "5" then Enter -> A1 becomes 5,
    # and the dependent =SUM(A1:A3) in B1 must recompute to 5+20+30 = 55.
    _type(cast[Ptr[uint8]]("5"))
    _press(13)                                         # Enter -> commit
    _o_str(cast[Ptr[uint8]]("A1_AFTER_TYPE "))
    _o_dec(hamsheet_cell_value_fp(0, 0))               # 5000000
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SUM_AFTER_EDIT "))
    _o_dec(hamsheet_cell_value_fp(0, 1))               # 55000000 (recalc cascade)
    _o_ch(10)
    _o_flush()
    # The reloaded B1 raw formula text (proves it round-tripped verbatim).
    _o_str(cast[Ptr[uint8]]("B1RAW-BEGIN\n"))
    _o_flush()
    hamsheet_cell_display(0, 1, &dbuf[0])              # value view
    # dump the RAW formula bytes for byte-exact check
    from_raw: Ptr[uint8] = hamsheet_cell_raw_ptr(0, 1)
    rl: uint64 = hamsheet_cell_raw_len(0, 1)
    sys_write(1, from_raw, rl)
    _o_str(cast[Ptr[uint8]]("\nB1RAW-END\n"))
    _o_flush()

    # ================================================================
    # (8) FORMULA-ENGINE DEPTH: functions, strings, booleans, errors
    # ================================================================
    # A1=5, A2=20, A3=30 at this point (A1 was typed in step 7).
    hamsheet_set_cell(0, 3, cast[Ptr[uint8]]("=IF(A1>10,\"big\",\"small\")"))
    hamsheet_set_cell(1, 3, cast[Ptr[uint8]]("=ROUND(2/3,2)"))
    hamsheet_set_cell(2, 3, cast[Ptr[uint8]]("=ABS(0-7)"))
    hamsheet_set_cell(3, 3, cast[Ptr[uint8]]("=SQRT(16)"))
    hamsheet_set_cell(4, 3, cast[Ptr[uint8]]("=POWER(2,10)"))
    hamsheet_set_cell(5, 3, cast[Ptr[uint8]]("=MOD(7,3)"))
    hamsheet_set_cell(6, 3, cast[Ptr[uint8]]("=2^3+1"))
    hamsheet_set_cell(7, 3, cast[Ptr[uint8]]("=LEN(\"hello\")"))
    hamsheet_set_cell(8, 3, cast[Ptr[uint8]]("=LEFT(\"hamnix\",3)&\"-\"&RIGHT(\"hamnix\",2)"))
    hamsheet_set_cell(9, 3, cast[Ptr[uint8]]("=MID(\"spreadsheet\",7,5)"))
    hamsheet_set_cell(10, 3, cast[Ptr[uint8]]("=UPPER(\"ok\")"))
    hamsheet_set_cell(11, 3, cast[Ptr[uint8]]("=AND(1>0,2>1)"))
    hamsheet_set_cell(12, 3, cast[Ptr[uint8]]("=OR(FALSE,FALSE)"))
    hamsheet_set_cell(13, 3, cast[Ptr[uint8]]("=NOT(TRUE)"))
    hamsheet_set_cell(14, 3, cast[Ptr[uint8]]("=CONCAT(\"a\",\"b\",\"c\")"))
    hamsheet_set_cell(15, 3, cast[Ptr[uint8]]("=1/0"))
    hamsheet_set_cell(16, 3, cast[Ptr[uint8]]("=FOO(1)"))
    hamsheet_set_cell(17, 3, cast[Ptr[uint8]]("=IFERROR(1/0,42)"))
    hamsheet_set_cell(18, 3, cast[Ptr[uint8]]("=COUNTIF(A1:A3,\">10\")"))
    hamsheet_set_cell(19, 3, cast[Ptr[uint8]]("=SUMIF(A1:A3,\">10\")"))
    hamsheet_set_cell(20, 3, cast[Ptr[uint8]]("=\"x\"&5"))
    hamsheet_set_cell(21, 3, cast[Ptr[uint8]]("=3=3"))
    hamsheet_set_cell(22, 3, cast[Ptr[uint8]]("=A1>=5"))
    hamsheet_set_cell(23, 3, cast[Ptr[uint8]]("=D24"))
    hamsheet_set_cell(24, 3, cast[Ptr[uint8]]("=(1+2)*3"))
    hamsheet_set_cell(25, 3, cast[Ptr[uint8]]("=AVG(A1:A3)>10"))
    hamsheet_recompute()
    _dump_cell(cast[Ptr[uint8]]("FN_IF"), 0, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_ROUND"), 1, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_ABS"), 2, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_SQRT"), 3, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_POWER"), 4, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_MOD"), 5, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_CARET"), 6, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_LEN"), 7, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_LEFTRIGHT"), 8, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_MID"), 9, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_UPPER"), 10, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_AND"), 11, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_OR"), 12, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_NOT"), 13, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_CONCAT"), 14, 3)
    _dump_cell(cast[Ptr[uint8]]("ERR_DIV0"), 15, 3)
    _dump_cell(cast[Ptr[uint8]]("ERR_NAME"), 16, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_IFERROR"), 17, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_COUNTIF"), 18, 3)
    _dump_cell(cast[Ptr[uint8]]("FN_SUMIF"), 19, 3)
    _dump_cell(cast[Ptr[uint8]]("OP_AMP"), 20, 3)
    _dump_cell(cast[Ptr[uint8]]("OP_EQ"), 21, 3)
    _dump_cell(cast[Ptr[uint8]]("OP_GE"), 22, 3)
    _dump_cell(cast[Ptr[uint8]]("ERR_CIRC"), 23, 3)
    _dump_cell(cast[Ptr[uint8]]("OP_PARENS"), 24, 3)
    _dump_cell(cast[Ptr[uint8]]("OP_CMPAGG"), 25, 3)
    _o_flush()

    # ================================================================
    # (9) ABSOLUTE REFS + FILL-DOWN with reference adjustment
    # ================================================================
    hamsheet_set_cell(0, 7, cast[Ptr[uint8]]("10"))       # H1 = rate
    hamsheet_set_cell(0, 4, cast[Ptr[uint8]]("1"))        # E1
    hamsheet_set_cell(1, 4, cast[Ptr[uint8]]("2"))        # E2
    hamsheet_set_cell(2, 4, cast[Ptr[uint8]]("3"))        # E3
    hamsheet_set_cell(0, 5, cast[Ptr[uint8]]("=E1*$H$1")) # F1
    hamsheet_select(0, 5, 2, 5)                           # F1:F3
    _press(4)                                             # Ctrl-D fill down
    _dump_raw(cast[Ptr[uint8]]("FILL_RAW_F3"), 2, 5)
    _dump_cell(cast[Ptr[uint8]]("FILL_VAL_F2"), 1, 5)
    _dump_cell(cast[Ptr[uint8]]("FILL_VAL_F3"), 2, 5)

    # ---- copy / paste with reference adjustment --------------------
    hamsheet_select(0, 5, 0, 5)
    _press(3)                                             # Ctrl-C
    hamsheet_select(4, 5, 4, 5)
    _press(22)                                            # Ctrl-V
    _dump_raw(cast[Ptr[uint8]]("PASTE_RAW_F5"), 4, 5)
    _o_flush()

    # ================================================================
    # (10) INSERT / DELETE ROW — formulas are RE-POINTED
    # ================================================================
    hamsheet_set_cell(9, 1, cast[Ptr[uint8]]("100"))      # B10
    hamsheet_set_cell(10, 1, cast[Ptr[uint8]]("=B10*2"))  # B11 -> 200
    _dump_cell(cast[Ptr[uint8]]("ROWOPS_BEFORE"), 10, 1)
    hamsheet_select(9, 1, 9, 1)
    _press(14)                                            # Ctrl-N insert row
    _dump_raw(cast[Ptr[uint8]]("INSROW_RAW"), 11, 1)
    _dump_cell(cast[Ptr[uint8]]("INSROW_VAL"), 11, 1)
    hamsheet_select(9, 1, 9, 1)
    _press(11)                                            # Ctrl-K delete row
    _dump_raw(cast[Ptr[uint8]]("DELROW_RAW"), 10, 1)
    _dump_cell(cast[Ptr[uint8]]("DELROW_VAL"), 10, 1)
    hamsheet_select(9, 1, 9, 1)
    _press(11)                                            # delete the SOURCE row
    _dump_cell(cast[Ptr[uint8]]("DELROW_REF"), 9, 1)
    _press(26)                                            # Ctrl-Z undo
    _dump_cell(cast[Ptr[uint8]]("UNDO_ROWOPS"), 10, 1)
    _dump_raw(cast[Ptr[uint8]]("UNDO_ROWOPS_RAW"), 10, 1)
    _o_flush()

    # ---- undo of a plain typed edit --------------------------------
    hamsheet_select(0, 2, 0, 2)                           # C1
    _type(cast[Ptr[uint8]]("77"))
    _press(13)
    _dump_cell(cast[Ptr[uint8]]("UNDO_BEFORE"), 0, 2)
    _press(26)
    _dump_cell(cast[Ptr[uint8]]("UNDO_AFTER"), 0, 2)
    _o_flush()

    # ================================================================
    # (11) NUMBER FORMATS + bold + column width
    # ================================================================
    hamsheet_set_cell(0, 6, cast[Ptr[uint8]]("1234.5"))
    hamsheet_set_fmt(0, 6, 4)                             # currency
    hamsheet_set_cell(1, 6, cast[Ptr[uint8]]("0.125"))
    hamsheet_set_fmt(1, 6, 5)                             # percent
    hamsheet_set_cell(2, 6, cast[Ptr[uint8]]("9876.543"))
    hamsheet_set_fmt(2, 6, 3)                             # thousands
    hamsheet_set_cell(3, 6, cast[Ptr[uint8]]("3"))
    hamsheet_set_fmt(3, 6, 2)                             # 2 decimals
    hamsheet_recompute()
    _dump_cell(cast[Ptr[uint8]]("FMT_CURRENCY"), 0, 6)
    _dump_cell(cast[Ptr[uint8]]("FMT_PERCENT"), 1, 6)
    _dump_cell(cast[Ptr[uint8]]("FMT_THOUSANDS"), 2, 6)
    _dump_cell(cast[Ptr[uint8]]("FMT_2DP"), 3, 6)
    hamsheet_select(0, 6, 0, 6)
    _press(2)                                             # Ctrl-B bold
    _o_str(cast[Ptr[uint8]]("FMT_BOLD_BIT "))
    _o_dec(cast[int64](hamsheet_cell_fmt(0, 6)))          # 4 + 8 = 12
    _o_ch(10)
    hamsheet_select(0, 0, 0, 0)
    _press(23)                                            # Ctrl-W widen
    _o_str(cast[Ptr[uint8]]("COLW_A "))
    _o_dec(cast[int64](hamsheet_col_width(0)))            # 80
    _o_ch(10)
    _o_flush()

    # ================================================================
    # (12) SAVE / RE-OPEN: formats, widths and formulas all round-trip
    # ================================================================
    _press(19)                                            # Ctrl-S
    hamsheet_clear()
    _load_doc()                                           # re-open off disk
    _dump_cell(cast[Ptr[uint8]]("RT_CURRENCY"), 0, 6)
    _dump_raw(cast[Ptr[uint8]]("RT_ABSREF"), 2, 5)
    _dump_cell(cast[Ptr[uint8]]("RT_IF"), 0, 3)
    _o_str(cast[Ptr[uint8]]("RT_COLW_A "))
    _o_dec(cast[int64](hamsheet_col_width(0)))            # 80
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("RT_FMT_BITS "))
    _o_dec(cast[int64](hamsheet_cell_fmt(0, 6)))          # 12
    _o_ch(10)
    _o_flush()

    # ================================================================
    # (13) BACKWARD COMPAT: an old HAMSHEET1 container still loads
    # ================================================================
    hb_n = 0
    _hb(cast[Ptr[uint8]]("HAMSHEET1\n2\n0 0 2\n42\n0 1 5\n=A1*2\n"))
    hamsheet_deserialize(&h1_buf[0], hb_n)
    _dump_cell(cast[Ptr[uint8]]("V1_A1"), 0, 0)
    _dump_cell(cast[Ptr[uint8]]("V1_B1"), 0, 1)
    _o_flush()

    # ================================================================
    # (14) CSV EXPORT / IMPORT
    # ================================================================
    hamsheet_clear()
    hamsheet_set_cell(0, 0, cast[Ptr[uint8]]("Item"))
    hamsheet_set_cell(0, 1, cast[Ptr[uint8]]("Qty"))
    hamsheet_set_cell(1, 0, cast[Ptr[uint8]]("nut, bolt"))
    hamsheet_set_cell(1, 1, cast[Ptr[uint8]]("3"))
    hamsheet_set_cell(2, 0, cast[Ptr[uint8]]("Total"))
    hamsheet_set_cell(2, 1, cast[Ptr[uint8]]("=SUM(B2:B2)*2"))
    hamsheet_recompute()
    csv_n: uint64 = hamsheet_export_csv(&csv_buf[0])
    _o_str(cast[Ptr[uint8]]("CSV-BEGIN\n"))
    _o_flush()
    sys_write(1, &csv_buf[0], csv_n)
    _o_str(cast[Ptr[uint8]]("CSV-END\n"))
    _o_flush()
    hamsheet_import_csv(&csv_buf[0], csv_n)
    _dump_cell(cast[Ptr[uint8]]("CSVIN_A2"), 1, 0)
    _dump_cell(cast[Ptr[uint8]]("CSVIN_B3"), 2, 1)
    _o_flush()

    # ---- (15) a presentable demo sheet for the eye -----------------
    hamsheet_clear()
    hamsheet_set_cell(0, 0, cast[Ptr[uint8]]("Item"))
    hamsheet_set_cell(0, 1, cast[Ptr[uint8]]("Qty"))
    hamsheet_set_cell(0, 2, cast[Ptr[uint8]]("Price"))
    hamsheet_set_cell(0, 3, cast[Ptr[uint8]]("Total"))
    hamsheet_set_cell(0, 4, cast[Ptr[uint8]]("Bulk?"))
    hamsheet_set_cell(1, 0, cast[Ptr[uint8]]("Widget"))
    hamsheet_set_cell(1, 1, cast[Ptr[uint8]]("12"))
    hamsheet_set_cell(1, 2, cast[Ptr[uint8]]("2.5"))
    hamsheet_set_cell(2, 0, cast[Ptr[uint8]]("Gadget"))
    hamsheet_set_cell(2, 1, cast[Ptr[uint8]]("3"))
    hamsheet_set_cell(2, 2, cast[Ptr[uint8]]("19.99"))
    hamsheet_set_cell(3, 0, cast[Ptr[uint8]]("Doohickey"))
    hamsheet_set_cell(3, 1, cast[Ptr[uint8]]("40"))
    hamsheet_set_cell(3, 2, cast[Ptr[uint8]]("0.75"))
    hamsheet_set_cell(1, 3, cast[Ptr[uint8]]("=B2*C2"))
    hamsheet_set_cell(1, 4, cast[Ptr[uint8]]("=IF(B2>=10,\"yes\",\"no\")"))
    hamsheet_select(1, 3, 3, 4)
    _press(4)                                             # fill down D2:E4
    hamsheet_set_cell(5, 0, cast[Ptr[uint8]]("Subtotal"))
    hamsheet_set_cell(5, 3, cast[Ptr[uint8]]("=SUM(D2:D4)"))
    hamsheet_set_cell(6, 0, cast[Ptr[uint8]]("Tax 8%"))
    hamsheet_set_cell(6, 3, cast[Ptr[uint8]]("=ROUND(D6*0.08,2)"))
    hamsheet_set_cell(7, 0, cast[Ptr[uint8]]("Grand total"))
    hamsheet_set_cell(7, 3, cast[Ptr[uint8]]("=D6+D7"))
    hamsheet_set_cell(9, 0, cast[Ptr[uint8]]("Big lines"))
    hamsheet_set_cell(9, 3, cast[Ptr[uint8]]("=COUNTIF(D2:D4,\">20\")"))
    dr: uint64 = 1
    while dr <= 7:
        hamsheet_set_fmt(dr, 2, 4)                        # currency
        hamsheet_set_fmt(dr, 3, 4)
        dr = dr + 1
    hamsheet_select(0, 0, 0, 4)
    _press(2)                                             # bold the header row
    hamsheet_select(5, 3, 7, 3)                           # show a live range
    hamsheet_recompute()
    _dump_cell(cast[Ptr[uint8]]("DEMO_SUBTOTAL"), 5, 3)
    _dump_cell(cast[Ptr[uint8]]("DEMO_GRAND"), 7, 3)
    _dump_cell(cast[Ptr[uint8]]("DEMO_BULK"), 3, 4)
    _o_flush()
    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[3]))
    _o_str(cast[Ptr[uint8]]("SCENE2-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("SCENE2-END\n"))
    _o_flush()

    # ================================================================
    # (16) SAVE AS through the SHARED file dialog (lib/filepick.ad)
    # ================================================================
    # The toolbar's "SaveAs" button no longer saves blindly to the launch path:
    # it asks the DRIVER for the shared, file-browser-backed chooser (action 11),
    # exactly as HamWrite and HamSlides do.
    saveas_act: int32 = hamsheet_hit(484, 32)          # SaveAs toolbar button
    _o_str(cast[Ptr[uint8]]("SAVEAS_ACTION "))
    _o_dec(cast[int64](saveas_act))                    # 11 = ACT_SAVE_AS
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("OPENBTN_ACTION "))
    _o_dec(cast[int64](hamsheet_hit(436, 32)))         # 12 = ACT_OPEN
    _o_ch(10)
    # Ctrl-U is the keyboard route to the same action.
    _press(21)
    _o_str(cast[Ptr[uint8]]("CTRLU_ACTION "))
    _o_dec(cast[int64](last_action))                   # 11 = ACT_SAVE_AS
    _o_ch(10)
    # The driver's response: pop lib/filepick.ad seeded with the sheet's own
    # directory + basename (user/hamsheet.ad _pop_dialog does exactly this).
    _pop_dialog(FILEPICK_SAVE)
    _o_str(cast[Ptr[uint8]]("DIALOG_ACTIVE "))
    _o_dec(cast[int64](filepick_active()))             # 2 = SAVE
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_SEED "))
    _o_str(filepick_save_name_ptr())                   # the current basename
    _o_ch(10)
    # SCREENDUMP: the live spreadsheet with the shared Save dialog over it.
    _render_with_dialog(W, H)
    _write_ppm(cast[Ptr[char]](argv[4]))
    _o_str(cast[Ptr[uint8]]("SAVEDLG-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("SAVEDLG-END\n"))
    _o_flush()
    # Clear the seeded name, type a new one, commit with Enter.
    bs: int32 = 0
    while bs < 48:
        filepick_handle_code(8)
        bs = bs + 1
    nm2: Ptr[uint8] = cast[Ptr[uint8]]("renamed.hsheet")
    q: uint64 = 0
    while nm2[q] != 0:
        filepick_handle_code(cast[int32](nm2[q]))
        q = q + 1
    _o_str(cast[Ptr[uint8]]("DIALOG_NAME "))
    _o_str(filepick_save_name_ptr())
    _o_ch(10)
    filepick_handle_code(13)                           # Enter -> commit
    _o_str(cast[Ptr[uint8]]("DIALOG_AFTER "))
    _o_dec(cast[int64](filepick_active()))             # 0 = closed
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_RESULT "))
    _o_dec(cast[int64](filepick_take_result()))        # 1 = a pick is waiting
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_MODE "))
    _o_dec(cast[int64](filepick_result_mode()))        # 2 = SAVE
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_PATH "))
    _o_str(filepick_result_path())                     # <docdir>/renamed.hsheet
    _o_ch(10)
    _o_flush()
    _apply_pick()                                      # driver: adopt + save
    # PROVE the round trip: clear the sheet, re-read the file the dialog named.
    hamsheet_clear()
    _o_str(cast[Ptr[uint8]]("SAVEAS_CLEARED "))
    _o_dec(hamsheet_cell_value_fp(5, 3))               # 0 (subtotal gone)
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SAVEAS_LEN "))
    _o_dec(_load_alt())                                # bytes read back
    _o_ch(10)
    _dump_cell(cast[Ptr[uint8]]("SAVEAS_SUBTOTAL"), 5, 3)
    _dump_cell(cast[Ptr[uint8]]("SAVEAS_GRAND"), 7, 3)
    _dump_raw(cast[Ptr[uint8]]("SAVEAS_RAW_GRAND"), 7, 3)
    _o_flush()
    return 0
