# user/arm64_a11_echo.ad — the ARM64 LLVM lane's FIRST EL0 PROGRAM THAT CONSUMES
# INPUT (docs/arm64_llvm_scoping.md A11).
#
# A10 proved a compiled Adder program runs at EL0 and can write(2). A program
# that can only write is a banner; a shell needs read(2). This program is the
# read half: it calls read(0, buf, N) — which traps svc #0 into the kernel's
# real dispatcher, which polls the PL011 receive FIFO through the kernel's own
# early_getc_polled()-shaped path — echoes what it got, and folds the bytes into
# a checksum that becomes its exit status.
#
# WHY THE CHECKSUM. "read returned 5" is satisfiable by a stub. The exit status
# here is a function of the ACTUAL BYTES, so the gate can feed a known line on
# QEMU's stdin, compute the expected status independently (the same source
# compiled for x86-64 and fed the same bytes), and require them to agree. A
# read() that returns the right COUNT but the wrong BYTES still reds.
#
# The program is 100% Adder; only _start is assembly (arch/arm64/llvm/user_rt.S).
# It is linked at the same VA as every other archive member (user.lds) and
# loaded BY NAME out of the embedded archive — see arm64_a11_load_named_arm64().

A11_ECHO_BUFN: int64 = 64

a11_inbuf: Array[64, uint8]
a11_outbuf: Array[96, uint8]


# --- syscall wrappers (x86-64 numbers; the aarch64 backend remaps them) ---
def a11_read(fd: int64, buf: Ptr[uint8], len_: uint64) -> int64:
    return cast[int64](__syscall3(cast[int64](0), fd, buf, len_))


def a11_write(fd: int64, buf: Ptr[uint8], len_: uint64) -> int64:
    return cast[int64](__syscall3(cast[int64](1), fd, buf, len_))


def a11_exit(status: int64) -> int64:
    return cast[int64](__syscall1(cast[int64](60), status))


def a11_put(at: int64, c: int64) -> int64:
    if at < 96:
        a11_outbuf[at] = cast[uint8](c)
        return at + 1
    return at


def a11_put_u64(at: int64, v: int64) -> int64:
    # decimal, no division-by-10 helper needed beyond the compiler's own
    if v == 0:
        return a11_put(at, 48)
    digits: Array[24, uint8]
    n: int64 = 0
    t: int64 = v
    while t > 0:
        digits[n] = cast[uint8](48 + t % 10)
        t = t / 10
        n = n + 1
    k: int64 = at
    while n > 0:
        n = n - 1
        k = a11_put(k, cast[int64](digits[n]))
    return k


# The checksum every byte read must move. Position-weighted so a REORDERED
# stream (a FIFO read backwards, say) does not collide with the right one.
def a11_echo_checksum(n: int64) -> int64:
    sum: int64 = 17
    i: int64 = 0
    while i < n:
        sum = (sum * 31 + cast[int64](a11_inbuf[i]) * (i + 1)) % 1000003
        i = i + 1
    return sum


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    got: int64 = a11_read(0, &a11_inbuf[0], cast[uint64](A11_ECHO_BUFN))
    if got < 0:
        got = 0
    # Strip a single trailing newline so the checksum is over the LINE, not over
    # whatever line terminator the feeding side happened to use.
    if got > 0:
        if a11_inbuf[got - 1] == cast[uint8](10):
            got = got - 1
    sum: int64 = a11_echo_checksum(got)

    at: int64 = 0
    at = a11_put(at, 65)        # 'A'
    at = a11_put(at, 49)        # '1'
    at = a11_put(at, 49)        # '1'
    at = a11_put(at, 58)        # ':'
    at = a11_put(at, 32)        # ' '
    at = a11_put(at, 82)        # 'R'
    at = a11_put(at, 61)        # '='
    i: int64 = 0
    while i < got:
        at = a11_put(at, cast[int64](a11_inbuf[i]))
        i = i + 1
    at = a11_put(at, 32)        # ' '
    at = a11_put(at, 78)        # 'N'
    at = a11_put(at, 61)        # '='
    at = a11_put_u64(at, got)
    at = a11_put(at, 32)        # ' '
    at = a11_put(at, 67)        # 'C'
    at = a11_put(at, 61)        # '='
    at = a11_put_u64(at, sum)
    at = a11_put(at, 10)        # '\n'
    a11_write(1, &a11_outbuf[0], cast[uint64](at))

    a11_exit(sum % 256)
    return cast[int32](sum % 256)
