# user/hamwrite_host.ad — HOST driver + render harness for HamWrite, the office
# word processor (built for x86_64-linux; runs on the dev host, no QEMU).
#
# Drives the SAME core the native app ships (lib/hamwritecore.ad) AND exercises
# the persistence end-to-end against the REAL host filesystem: it types a
# document, selects a word and applies BOLD, renders the formatted page,
# SAVES it (Ctrl-S -> a HAMWRITE2 container on disk), CLEARS the buffer, then
# RE-OPENS the file off disk (Ctrl-O) — proving the text AND the bold span
# survive a save->load round-trip. It then drives the features a real user
# leans on: MULTI-LEVEL UNDO/REDO (including a redo-branch truncation and an
# undone FORMATTING change), FIND & REPLACE (hit counts, wrapping Find Next,
# case-insensitivity, Replace All as ONE undo step) and BULLET/NUMBERED LISTS
# with indent, text colour and highlight — round-tripping the SECOND attribute
# plane through the container too. PPMs are written for a human/agent to LOOK
# at, and every model counter is dumped for asserts.
#
# USAGE (built to build/host/hamwrite_host):
#   hamwrite_host DOCPATH BEFORE.ppm AFTER.ppm [TEXT] [SHOW.ppm] [FIND.ppm]

extern def sys_open(path: Ptr[char], flags: int32, mode: int32) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32

from lib.hamscene import hamscene_bufptr, hamscene_length
from lib.hamui_host import hamui_host_begin, hamui_host_rasterize, \
    hamui_host_ppm_header, hamui_host_fb_ptr, hamui_host_fb_bytes, \
    hamui_host_pixel
from lib.hamwritecore import hamwrite_build_scene, hamwrite_key, \
    hamwrite_key_line, hamwrite_len, hamwrite_dirty, hamwrite_mark_saved, \
    hamwrite_set_text, hamwrite_text_ptr, hamwrite_take_action, \
    hamwrite_serialize, hamwrite_deserialize, hamwrite_word_count, \
    hamwrite_attr_count, hamwrite_clear, hamwrite_hit, hamwrite_select_word, \
    hamwrite_select_line, hamwrite_sel_len, hamwrite_toggle_bold, \
    hamwrite_set_fname, hamwrite_drag, hamwrite_size_count, \
    hamwrite_align_count, hamwrite_menu_open, \
    hamwrite_fname_ptr, hamwrite_row_count, \
    hamwrite_scroll_top, hamwrite_scroll, hamwrite_undo_depth, \
    hamwrite_redo_depth, hamwrite_can_undo, hamwrite_can_redo, \
    hamwrite_set_find, hamwrite_set_repl, hamwrite_find_open, \
    hamwrite_find_close, hamwrite_find_next, hamwrite_replace, \
    hamwrite_replace_all, hamwrite_find_hits, hamwrite_find_cur, \
    hamwrite_find_active, hamwrite_find_ptr, hamwrite_sel_ptr, \
    hamwrite_list_count, hamwrite_indent_count, hamwrite_color_count, \
    hamwrite_hilite_count, hamwrite_heading_count, hamwrite_find_msg, \
    hamwrite_heading_level_at, hamwrite_toggle_heading_level, \
    hamwrite_active_attr
from lib.filepick import filepick_open, filepick_active, filepick_emit_panel, \
    filepick_handle_code, filepick_take_result, filepick_result_path, \
    filepick_result_mode, filepick_save_name_ptr, FILEPICK_SAVE
from lib.hamfmcore import fmc_set_cur_path, fmc_model_reset, fmc_add_entry, \
    fmc_sort_entries, fmc_select


obuf: Array[512, uint8]
obuf_n: uint64 = 0


def _o_ch(c: uint8):
    if obuf_n < 511:
        obuf[obuf_n] = c
        obuf_n = obuf_n + 1


def _o_str(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        _o_ch(s[i])
        i = i + 1


def _o_dec(v: int64):
    if v < 0:
        _o_ch(45)
        v = 0 - v
    if v == 0:
        _o_ch(48)
        return
    digs: Array[24, uint8]
    n: uint64 = 0
    x: uint64 = cast[uint64](v)
    while x > 0:
        digs[n] = cast[uint8](x % 10) + 48
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        _o_ch(digs[n])


def _o_hexcol(v: uint32):
    _o_ch(35)
    i: int32 = 0
    while i < 6:
        nyb: uint32 = (v >> cast[uint32]((5 - i) * 4)) & 15
        d: uint8 = cast[uint8](nyb)
        if d < 10:
            _o_ch(d + 48)
        else:
            _o_ch(d - 10 + 97)
        i = i + 1


def _o_flush():
    if obuf_n > 0:
        sys_write(1, &obuf[0], obuf_n)
        obuf_n = 0


ppm_hdr: Array[64, uint8]


def _write_ppm(path: Ptr[char]) -> int32:
    fd: int32 = sys_open(path, 577, 420)               # O_WRONLY|O_CREAT|O_TRUNC
    if fd < 0:
        return -1
    hlen: uint64 = hamui_host_ppm_header(&ppm_hdr[0])
    sys_write(fd, &ppm_hdr[0], hlen)
    sys_write(fd, hamui_host_fb_ptr(), hamui_host_fb_bytes())
    sys_close(fd)
    return 0


def _render(w: int32, h: int32) -> int32:
    hamwrite_build_scene()
    hamui_host_begin(w, h)
    return hamui_host_rasterize()


# ---- host-side persistence (mirrors user/hamwrite.ad) ---------------------
ser_buf: Array[12416, uint8]  # magic+len + 3*CAP
doc_path: Array[192, uint8]
doc_path_len: uint64 = 0


def _set_docpath(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and i < 191:
        doc_path[i] = s[i]
        i = i + 1
    doc_path[i] = 0
    doc_path_len = i


def _save_doc():
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 577, 420)
    if fd < 0:
        return
    n: uint64 = hamwrite_serialize(&ser_buf[0])
    sys_write(fd, &ser_buf[0], n)
    sys_close(fd)
    hamwrite_mark_saved()


def _load_doc():
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 0, 0)   # O_RDONLY
    if fd < 0:
        hamwrite_deserialize(&ser_buf[0], 0)
        return
    total: uint64 = 0
    while total < 12416:
        r: int64 = sys_read(fd, &ser_buf[total], 12416 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    hamwrite_deserialize(&ser_buf[0], total)


# On-disk byte count of the document file.
raw_buf: Array[12416, uint8]


def _file_len() -> int64:
    fd: int32 = sys_open(cast[Ptr[char]](&doc_path[0]), 0, 0)
    if fd < 0:
        return -1
    total: int64 = 0
    while total < 12416:
        r: int64 = sys_read(fd, &raw_buf[total], 12416 - cast[uint64](total))
        if r <= 0:
            break
        total = total + r
    sys_close(fd)
    return total


# The path the Save-As dialog committed to. The dialog returns an ABSOLUTE
# path, so unlike the retired one-line prompt there is no directory to rejoin.
alt_path: Array[192, uint8]
alt_path_len: uint64 = 0


# ---- the SHARED Save/Open dialog (mirrors user/hamwrite.ad) ---------------
# The driver pops lib/filepick.ad seeded with the document's own DIRECTORY and
# basename, renders it as a centred panel over the live document, and on commit
# adopts the returned absolute path. Directory enumeration is a kernel path the
# dev host cannot run, so the listing is injected with the browse core's own
# model primitives (the same records fmc_load_dir yields on-device).
def _doc_dir(out: Ptr[uint8]) -> uint64:
    cut: uint64 = 0
    k: uint64 = 0
    while k < doc_path_len:
        if doc_path[k] == 47:
            cut = k + 1
        k = k + 1
    p: uint64 = 0
    while p < cut:
        out[p] = doc_path[p]
        p = p + 1
    # Strip the trailing slash (fmc keeps paths without one, except at root).
    if p > 1 and out[p - 1] == 47:
        p = p - 1
    out[p] = 0
    return p


def _doc_base() -> Ptr[uint8]:
    cut: uint64 = 0
    k: uint64 = 0
    while k < doc_path_len:
        if doc_path[k] == 47:
            cut = k + 1
        k = k + 1
    return &doc_path[cut]


dlg_dir: Array[192, uint8]


def _pop_dialog(mode: int32):
    _doc_dir(&dlg_dir[0])
    filepick_open(mode, &dlg_dir[0], _doc_base())
    # Host stand-in for fmc_load_dir(): a representative listing to browse.
    fmc_set_cur_path(&dlg_dir[0])
    fmc_model_reset()
    fmc_add_entry(cast[Ptr[uint8]]("Reports"), 1, 0)
    fmc_add_entry(cast[Ptr[uint8]]("hamwrite_scratch.hdoc"), 0, 0)
    fmc_sort_entries()
    fmc_select(-1)


def _render_with_dialog(w: int32, h: int32) -> int32:
    hamwrite_build_scene()
    filepick_emit_panel(w, h)
    hamui_host_begin(w, h)
    return hamui_host_rasterize()


# Adopt a committed pick: the returned path becomes the document path.
def _apply_pick():
    src: Ptr[uint8] = filepick_result_path()
    p: uint64 = 0
    while src[p] != 0 and p < 191:
        alt_path[p] = src[p]
        p = p + 1
    alt_path[p] = 0
    alt_path_len = p
    # The title bar shows the new basename.
    cut: uint64 = 0
    k: uint64 = 0
    while k < alt_path_len:
        if alt_path[k] == 47:
            cut = k + 1
        k = k + 1
    hamwrite_set_fname(&alt_path[cut])
    fd: int32 = sys_open(cast[Ptr[char]](&alt_path[0]), 577, 420)
    if fd < 0:
        return
    n: uint64 = hamwrite_serialize(&ser_buf[0])
    sys_write(fd, &ser_buf[0], n)
    sys_close(fd)
    hamwrite_mark_saved()


def _alt_len() -> int64:
    fd: int32 = sys_open(cast[Ptr[char]](&alt_path[0]), 0, 0)
    if fd < 0:
        return -1
    total: int64 = 0
    while total < 12416:
        r: int64 = sys_read(fd, &raw_buf[total], 12416 - cast[uint64](total))
        if r <= 0:
            break
        total = total + r
    sys_close(fd)
    return total


def _dispatch(act: int32):
    if act == 1:                                       # Save
        _save_doc()
    elif act == 2:                                     # Open (reload docpath)
        _load_doc()
    elif act == 4:                                     # New
        hamwrite_clear()


# Feed one keypress via the "d <code>" wire line (exercises the parser too),
# then drain + dispatch any action it requested.
kl: Array[16, uint8]


def _press(code: int32) -> int32:
    kl[0] = 100                                        # 'd'
    kl[1] = 32
    p: uint64 = 2
    if code < 0:
        kl[p] = 45
        p = p + 1
        code = 0 - code
    if code >= 100:
        kl[p] = cast[uint8](code / 100) + 48
        p = p + 1
    if code >= 10:
        kl[p] = cast[uint8]((code / 10) % 10) + 48
        p = p + 1
    kl[p] = cast[uint8](code % 10) + 48
    p = p + 1
    ch: int32 = hamwrite_key_line(&kl[0], p)
    if ch == 1:
        act: int32 = hamwrite_take_action()
        if act != 0:
            _dispatch(act)
    return ch


# Type a whole NUL-terminated string through the key-wire parser.
def _type(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        _press(cast[int32](s[i]))
        i = i + 1


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 4:
        _o_str(cast[Ptr[uint8]](
            "usage: hamwrite_host DOC BEFORE.ppm AFTER.ppm [TEXT] [SHOW.ppm]\n"))
        _o_flush()
        return 2

    _set_docpath(cast[Ptr[uint8]](argv[1]))
    hamwrite_set_fname(cast[Ptr[uint8]]("report.hdoc"))

    W: int32 = 720
    H: int32 = 552

    # ---- (1) empty page: title bar + toolbar + blank paper -------------
    prims: int32 = _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[2]))
    _o_str(cast[Ptr[uint8]]("PRIMS "))
    _o_dec(cast[int64](prims))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("LEN0 "))
    _o_dec(cast[int64](hamwrite_len()))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("PIX 4 4 "))
    _o_hexcol(hamui_host_pixel(4, 4))                  # title bar #3f6fb5
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("PIX 200 200 "))
    _o_hexcol(hamui_host_pixel(200, 200))              # page paper #ffffff
    _o_ch(10)
    _o_flush()

    # ---- (2) TYPE the document body -----------------------------------
    keys: Ptr[uint8] = cast[Ptr[uint8]]("Hello world from HamWrite")
    if argc >= 5:
        keys = cast[Ptr[uint8]](argv[4])
    i: uint64 = 0
    while keys[i] != 0:
        _press(cast[int32](keys[i]))
        i = i + 1
    _o_str(cast[Ptr[uint8]]("LEN1 "))
    _o_dec(cast[int64](hamwrite_len()))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("WORDS "))
    _o_dec(cast[int64](hamwrite_word_count()))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIRTY "))
    _o_dec(cast[int64](hamwrite_dirty()))
    _o_ch(10)

    # ---- (3) SELECT the first word ("Hello") + apply BOLD -------------
    # A click inside the page places the caret; a double-click selects the word.
    # (TXT_X=26 is the paper's text left edge; x=40 lands inside "Hello", and
    # the first laid-out row occupies y 90..110.)
    hamwrite_hit(44, 138)
    hamwrite_select_word()
    _o_str(cast[Ptr[uint8]]("WORDSEL "))
    _o_dec(cast[int64](hamwrite_sel_len()))            # "Hello" = 5
    _o_ch(10)
    # Apply bold via the toolbar B button (the real hit-test path).
    bhit: int32 = hamwrite_hit(16, 58)                 # click Bold button
    _o_str(cast[Ptr[uint8]]("BOLD_HIT "))
    _o_dec(cast[int64](bhit))                           # 3 = redraw-only
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("BOLD1 "))
    _o_dec(cast[int64](hamwrite_attr_count(1)))        # 5 bold chars now
    _o_ch(10)
    _o_flush()

    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[3]))               # AFTER.ppm: bolded doc

    # dump the FORMATTED scene so the gate can assert a BOLD glyphs op ("... b")
    _o_str(cast[Ptr[uint8]]("SCENE-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("SCENE-END\n"))
    _o_flush()

    # ---- (3b) UNDERLINE the whole body via Ctrl-A + the toolbar U -----
    _press(1)                                          # Ctrl-A select all
    uhit: int32 = hamwrite_hit(78, 58)                 # click Underline button
    _o_str(cast[Ptr[uint8]]("UNDER_HIT "))
    _o_dec(cast[int64](uhit))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("UNDER1 "))
    _o_dec(cast[int64](hamwrite_attr_count(8)))        # every char underlined
    _o_ch(10)
    _o_flush()

    # ---- (3c) TEXT SIZE: select all -> the toolbar XL (title) button --
    _press(1)
    thit: int32 = hamwrite_hit(316, 58)
    _o_str(cast[Ptr[uint8]]("SIZE_HIT "))
    _o_dec(cast[int64](thit))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SIZE_TITLE "))
    _o_dec(cast[int64](hamwrite_size_count(3)))        # all chars title-sized
    _o_ch(10)
    _o_flush()

    # ---- (3d) PARAGRAPH ALIGNMENT: select all -> the Center button ----
    _press(1)
    ahit: int32 = hamwrite_hit(420, 58)
    _o_str(cast[Ptr[uint8]]("ALIGN_HIT "))
    _o_dec(cast[int64](ahit))
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("ALIGN_CENTER "))
    _o_dec(cast[int64](hamwrite_align_count(1)))       # whole paragraph centred
    _o_ch(10)
    _o_flush()

    # Render + dump the FULLY FORMATTED scene: title-sized, underlined,
    # centred text. Title runs are emitted PER CHARACTER at a scaled advance
    # with a second strike a pixel lower, so the gate can prove the size class
    # actually changed the drawing (not just the model).
    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[3]))
    _o_str(cast[Ptr[uint8]]("FMT-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("FMT-END\n"))
    _o_flush()

    # ---- (4) SAVE (Ctrl-S): text + formatting persist -----------------
    _press(19)                                         # Ctrl-S -> _save_doc
    _o_str(cast[Ptr[uint8]]("DIRTY_AFTER_SAVE "))
    _o_dec(cast[int64](hamwrite_dirty()))              # 0
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("FILE_LEN "))
    _o_dec(_file_len())                                # magic+len + 2*tlen
    _o_ch(10)
    _o_flush()

    # ---- (5) CLEAR, then RE-OPEN off disk (round-trip proof) ----------
    hamwrite_clear()
    _o_str(cast[Ptr[uint8]]("LEN_AFTER_CLEAR "))
    _o_dec(cast[int64](hamwrite_len()))                # 0
    _o_ch(10)
    _press(15)                                         # Ctrl-O -> _load_doc
    _o_str(cast[Ptr[uint8]]("LEN_AFTER_OPEN "))
    _o_dec(cast[int64](hamwrite_len()))                # back to LEN1
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("BOLD_AFTER_OPEN "))
    _o_dec(cast[int64](hamwrite_attr_count(1)))        # 5 -> bold survived!
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("UNDER_AFTER_OPEN "))
    _o_dec(cast[int64](hamwrite_attr_count(8)))        # underline survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SIZE_AFTER_OPEN "))
    _o_dec(cast[int64](hamwrite_size_count(3)))        # title size survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("ALIGN_AFTER_OPEN "))
    _o_dec(cast[int64](hamwrite_align_count(1)))       # centring survived
    _o_ch(10)
    _o_flush()

    # dump the reloaded body so the gate can assert the exact text round-tripped
    _o_str(cast[Ptr[uint8]]("BODY-BEGIN\n"))
    _o_flush()
    sys_write(1, hamwrite_text_ptr(), hamwrite_len())
    _o_str(cast[Ptr[uint8]]("\nBODY-END\n"))
    _o_flush()

    # ---- (6) MENU BAR: File -> "Save As..." -> the SHARED file dialog -
    mhit: int32 = hamwrite_hit(20, 32)                 # click "File"
    _o_str(cast[Ptr[uint8]]("MENU_HIT "))
    _o_dec(cast[int64](mhit))                          # 3 = redraw
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("MENU_OPEN "))
    _o_dec(cast[int64](hamwrite_menu_open()))          # 1 = File
    _o_ch(10)
    _render(W, H)
    _o_str(cast[Ptr[uint8]]("MENU-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("MENU-END\n"))
    _o_flush()
    # item 3 of the File menu = "Save As..." (drop-down rows are 20px from y=48).
    # It no longer raises a bespoke one-line prompt: it asks the DRIVER for the
    # shared, file-browser-backed dialog (action 11), exactly as HamSheet and
    # HamSlides now do.
    saveas_act: int32 = hamwrite_hit(30, 118)
    _o_str(cast[Ptr[uint8]]("SAVEAS_ACTION "))
    _o_dec(cast[int64](saveas_act))                    # 11 = ACT_SAVE_AS
    _o_ch(10)
    # The driver's response: pop lib/filepick.ad seeded with the document's own
    # directory + basename (user/hamwrite.ad _pop_dialog does exactly this).
    _pop_dialog(FILEPICK_SAVE)
    _o_str(cast[Ptr[uint8]]("DIALOG_ACTIVE "))
    _o_dec(cast[int64](filepick_active()))             # 2 = SAVE
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_SEED "))
    _o_str(filepick_save_name_ptr())                   # the current basename
    _o_ch(10)
    # SCREENDUMP: the document with the shared Save dialog floating over it.
    _render_with_dialog(W, H)
    _write_ppm(cast[Ptr[char]](argv[8]))
    _o_str(cast[Ptr[uint8]]("SAVEDLG-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("SAVEDLG-END\n"))
    _o_flush()
    # Clear the seeded name, type a new one, commit with Enter.
    bs: int32 = 0
    while bs < 40:
        filepick_handle_code(8)
        bs = bs + 1
    nm2: Ptr[uint8] = cast[Ptr[uint8]]("renamed.hdoc")
    q: uint64 = 0
    while nm2[q] != 0:
        filepick_handle_code(cast[int32](nm2[q]))
        q = q + 1
    _o_str(cast[Ptr[uint8]]("DIALOG_NAME "))
    _o_str(filepick_save_name_ptr())
    _o_ch(10)
    filepick_handle_code(13)                           # Enter -> commit
    _o_str(cast[Ptr[uint8]]("DIALOG_AFTER "))
    _o_dec(cast[int64](filepick_active()))             # 0 = closed
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_RESULT "))
    _o_dec(cast[int64](filepick_take_result()))        # 1 = a pick is waiting
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_MODE "))
    _o_dec(cast[int64](filepick_result_mode()))        # 2 = SAVE
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("DIALOG_PATH "))
    _o_str(filepick_result_path())                     # <docdir>/renamed.hdoc
    _o_ch(10)
    _apply_pick()                                      # driver: adopt + save
    _o_str(cast[Ptr[uint8]]("SAVEAS_NAME "))
    _o_str(hamwrite_fname_ptr())
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SAVEAS_LEN "))
    _o_dec(_alt_len())                                 # same 63-byte container
    _o_ch(10)
    _o_flush()

    # ---- (7) SCROLLING: fill past one screenful of rows ---------------
    hamwrite_clear()
    ln: int32 = 0
    while ln < 40:
        _press(76)                                     # 'L'
        _press(105)                                    # 'i'
        _press(110)                                    # 'n'
        _press(101)                                    # 'e'
        _press(13)                                     # Enter
        ln = ln + 1
    _render(W, H)
    _o_str(cast[Ptr[uint8]]("ROWS "))
    _o_dec(cast[int64](hamwrite_row_count()))          # 41 (40 lines + tail)
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("SCROLL_TOP "))
    _o_dec(cast[int64](hamwrite_scroll_top()))         # > 0: caret stayed in view
    _o_ch(10)
    hamwrite_scroll(-100)                              # wheel back to the top
    _o_str(cast[Ptr[uint8]]("SCROLL_HOME "))
    _o_dec(cast[int64](hamwrite_scroll_top()))         # 0
    _o_ch(10)
    _o_flush()

    # ---- (8) UNDO / REDO ----------------------------------------------
    # Typing "alpha beta gamma" leaves THREE undo groups (a space closes a
    # group), so Ctrl-Z peels the document back one WORD at a time and Ctrl-Y
    # puts it back — the multi-level history a word processor must have.
    hamwrite_clear()
    _type(cast[Ptr[uint8]]("alpha beta gamma"))
    _o_str(cast[Ptr[uint8]]("UNDO_LEN0 "))
    _o_dec(cast[int64](hamwrite_len()))                # 16
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("UNDO_DEPTH "))
    _o_dec(cast[int64](hamwrite_undo_depth()))         # 3 groups
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CAN_UNDO "))
    _o_dec(cast[int64](hamwrite_can_undo()))           # 1
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CAN_REDO0 "))
    _o_dec(cast[int64](hamwrite_can_redo()))           # 0
    _o_ch(10)
    _press(26)                                         # Ctrl-Z
    _o_str(cast[Ptr[uint8]]("UNDO_LEN1 "))
    _o_dec(cast[int64](hamwrite_len()))                # 11 ("alpha beta ")
    _o_ch(10)
    _press(26)                                         # Ctrl-Z
    _o_str(cast[Ptr[uint8]]("UNDO_LEN2 "))
    _o_dec(cast[int64](hamwrite_len()))                # 6  ("alpha ")
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CAN_REDO1 "))
    _o_dec(cast[int64](hamwrite_can_redo()))           # 1
    _o_ch(10)
    _press(25)                                         # Ctrl-Y
    _o_str(cast[Ptr[uint8]]("REDO_LEN1 "))
    _o_dec(cast[int64](hamwrite_len()))                # 11 again
    _o_ch(10)
    _press(25)
    _o_str(cast[Ptr[uint8]]("REDO_LEN2 "))
    _o_dec(cast[int64](hamwrite_len()))                # 16 — fully restored
    _o_ch(10)
    # a NEW edit after undoing truncates the redo branch (Word semantics)
    _press(26)
    _type(cast[Ptr[uint8]]("zzz"))
    _o_str(cast[Ptr[uint8]]("REDO_AFTER_EDIT "))
    _o_dec(cast[int64](hamwrite_can_redo()))           # 0
    _o_ch(10)
    # formatting is undoable too
    hamwrite_clear()
    _type(cast[Ptr[uint8]]("bolder"))
    _press(1)                                          # Ctrl-A
    hamwrite_hit(16, 58)                               # Bold
    _o_str(cast[Ptr[uint8]]("FMT_BOLD "))
    _o_dec(cast[int64](hamwrite_attr_count(1)))        # 6
    _o_ch(10)
    _press(26)                                         # Ctrl-Z
    _o_str(cast[Ptr[uint8]]("FMT_BOLD_UNDONE "))
    _o_dec(cast[int64](hamwrite_attr_count(1)))        # 0
    _o_ch(10)
    _o_flush()

    # ---- (9) FIND & REPLACE -------------------------------------------
    hamwrite_clear()
    _type(cast[Ptr[uint8]]("the cat sat on the mat"))
    _press(6)                                          # Ctrl-F opens the dialog
    _o_str(cast[Ptr[uint8]]("FIND_OPEN "))
    _o_dec(cast[int64](hamwrite_find_active()))        # 1
    _o_ch(10)
    hamwrite_set_find(cast[Ptr[uint8]]("at"))
    _o_str(cast[Ptr[uint8]]("FIND_HITS "))
    _o_dec(cast[int64](hamwrite_find_hits()))          # 3: cAT sAT mAT
    _o_ch(10)
    hamwrite_find_next()
    _o_str(cast[Ptr[uint8]]("FIND_CUR1 "))
    _o_dec(hamwrite_find_cur())                        # 5
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("FIND_SEL1 "))
    _o_dec(cast[int64](hamwrite_sel_len()))            # 2
    _o_ch(10)
    hamwrite_find_next()
    _o_str(cast[Ptr[uint8]]("FIND_CUR2 "))
    _o_dec(hamwrite_find_cur())                        # 9
    _o_ch(10)
    # render WITH the dialog up so the gate can see the match highlight bands
    _render(W, H)
    if argc >= 7:
        _write_ppm(cast[Ptr[char]](argv[6]))
    _o_str(cast[Ptr[uint8]]("FIND-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("FIND-END\n"))
    _o_flush()
    # case-INSENSITIVE matching
    hamwrite_set_find(cast[Ptr[uint8]]("THE"))
    _o_str(cast[Ptr[uint8]]("FIND_CI "))
    _o_dec(cast[int64](hamwrite_find_hits()))          # 2
    _o_ch(10)
    # a miss reports "not found"
    hamwrite_set_find(cast[Ptr[uint8]]("zebra"))
    hamwrite_find_next()
    _o_str(cast[Ptr[uint8]]("FIND_MISS "))
    _o_dec(cast[int64](hamwrite_find_msg()))           # 1 = not found
    _o_ch(10)
    # Replace All
    hamwrite_set_find(cast[Ptr[uint8]]("at"))
    hamwrite_set_repl(cast[Ptr[uint8]]("og"))
    _o_str(cast[Ptr[uint8]]("REPL_N "))
    _o_dec(cast[int64](hamwrite_replace_all()))        # 3
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("REPL_HITS "))
    _o_dec(cast[int64](hamwrite_find_hits()))          # 0 left
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("REPLBODY-BEGIN\n"))
    _o_flush()
    sys_write(1, hamwrite_text_ptr(), hamwrite_len())
    _o_str(cast[Ptr[uint8]]("\nREPLBODY-END\n"))
    _o_flush()
    hamwrite_find_close()
    _o_str(cast[Ptr[uint8]]("FIND_CLOSED "))
    _o_dec(cast[int64](hamwrite_find_active()))        # 0
    _o_ch(10)
    # and Replace All is ONE undoable step
    _press(26)
    _o_str(cast[Ptr[uint8]]("REPL_UNDO-BEGIN\n"))
    _o_flush()
    sys_write(1, hamwrite_text_ptr(), hamwrite_len())
    _o_str(cast[Ptr[uint8]]("\nREPL_UNDO-END\n"))
    _o_flush()

    # ---- (10) LISTS + INDENT + COLOUR + HIGHLIGHT, then a ROUND-TRIP --
    hamwrite_clear()
    _type(cast[Ptr[uint8]]("Milk"))
    _press(13)
    _type(cast[Ptr[uint8]]("Eggs"))
    _press(13)
    _type(cast[Ptr[uint8]]("Bread"))
    _press(1)                                          # Ctrl-A
    hamwrite_hit(124, 88)                              # toolbar "Bul"
    _o_str(cast[Ptr[uint8]]("LIST_BULLET "))
    _o_dec(cast[int64](hamwrite_list_count(1)))        # all 15 chars
    _o_ch(10)
    hamwrite_hit(206, 88)                              # toolbar ">>" indent
    _o_str(cast[Ptr[uint8]]("INDENT1 "))
    _o_dec(cast[int64](hamwrite_indent_count(1)))      # 15
    _o_ch(10)
    _render(W, H)
    _o_str(cast[Ptr[uint8]]("LIST-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("LIST-END\n"))
    _o_flush()
    hamwrite_hit(244, 88)                              # toolbar "<<" outdent
    _o_str(cast[Ptr[uint8]]("INDENT0 "))
    _o_dec(cast[int64](hamwrite_indent_count(0)))      # back to 15 at level 0
    _o_ch(10)
    hamwrite_hit(162, 88)                              # toolbar "Num"
    _o_str(cast[Ptr[uint8]]("LIST_NUMBER "))
    _o_dec(cast[int64](hamwrite_list_count(2)))        # 15
    _o_ch(10)
    hamwrite_hit(298, 88)                              # colour swatch 1 (red)
    _o_str(cast[Ptr[uint8]]("COLOR1 "))
    _o_dec(cast[int64](hamwrite_color_count(1)))       # 15
    _o_ch(10)
    hamwrite_hit(436, 88)                              # highlighter
    _o_str(cast[Ptr[uint8]]("HILITE "))
    _o_dec(cast[int64](hamwrite_hilite_count()))       # 15
    _o_ch(10)
    _render(W, H)
    _o_str(cast[Ptr[uint8]]("NUMLIST-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("NUMLIST-END\n"))
    _o_flush()
    # HEADING LEVELS: H2 = the heading bit + the large size class
    _press(1)
    hamwrite_hit(152, 58)                              # toolbar "H2"
    _o_str(cast[Ptr[uint8]]("HEAD2 "))
    _o_dec(cast[int64](hamwrite_heading_count(2)))     # 15
    _o_ch(10)
    _press(1)
    hamwrite_hit(186, 58)                              # toolbar "H3"
    _o_str(cast[Ptr[uint8]]("HEAD3 "))
    _o_dec(cast[int64](hamwrite_heading_count(3)))     # 15
    _o_ch(10)
    # HEADING TOGGLE: clicking the ACTIVE heading button again must return the
    # text to BODY, exactly like the B/I/U toggles beside it. It used to be a
    # one-way trip that could only be undone from Format > Body Text.
    _o_str(cast[Ptr[uint8]]("H3_ACTIVE_LEVEL "))
    _o_dec(cast[int64](hamwrite_heading_level_at(0)))  # 3
    _o_ch(10)
    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[9]))               # heading ON
    _o_str(cast[Ptr[uint8]]("HEADON-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("HEADON-END\n"))
    _o_flush()
    hamwrite_hit(186, 58)                              # toolbar "H3" AGAIN
    _o_str(cast[Ptr[uint8]]("HEAD3_AFTER_RECLICK "))
    _o_dec(cast[int64](hamwrite_heading_count(3)))     # 0: back to body text
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("BODY_AFTER_RECLICK "))
    _o_dec(cast[int64](hamwrite_heading_count(0)))     # 15: all body again
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("TOGGLED_LEVEL "))
    _o_dec(cast[int64](hamwrite_heading_level_at(0)))  # 0 = body
    _o_ch(10)
    _render(W, H)
    _write_ppm(cast[Ptr[char]](argv[10]))              # heading OFF again
    _o_str(cast[Ptr[uint8]]("HEADOFF-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("HEADOFF-END\n"))
    _o_flush()
    # A DIFFERENT heading button still switches level rather than toggling off.
    hamwrite_hit(152, 58)                              # H2 on body text
    _o_str(cast[Ptr[uint8]]("H2_FROM_BODY "))
    _o_dec(cast[int64](hamwrite_heading_count(2)))     # 15
    _o_ch(10)
    hamwrite_hit(186, 58)                              # H3 while H2 is active
    _o_str(cast[Ptr[uint8]]("H3_FROM_H2 "))
    _o_dec(cast[int64](hamwrite_heading_count(3)))     # 15 (switched, not off)
    _o_ch(10)
    hamwrite_hit(186, 58)                              # H3 again -> body
    _o_str(cast[Ptr[uint8]]("H3_TOGGLED_OFF "))
    _o_dec(cast[int64](hamwrite_heading_count(0)))     # 15 body
    _o_ch(10)
    # Restore H3 for the round-trip assertions that follow.
    hamwrite_hit(186, 58)
    # SAVE -> CLEAR -> RE-OPEN: the SECOND attribute plane must round-trip
    _press(19)                                         # Ctrl-S
    _o_str(cast[Ptr[uint8]]("A2_FILE_LEN "))
    _o_dec(_file_len())                                # 10 + 3 + 3*15 = 58
    _o_ch(10)
    hamwrite_clear()
    _press(15)                                         # Ctrl-O
    _o_str(cast[Ptr[uint8]]("A2_LEN "))
    _o_dec(cast[int64](hamwrite_len()))                # 15
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("A2_LIST "))
    _o_dec(cast[int64](hamwrite_list_count(2)))        # numbered list survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("A2_COLOR "))
    _o_dec(cast[int64](hamwrite_color_count(1)))       # red survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("A2_HILITE "))
    _o_dec(cast[int64](hamwrite_hilite_count()))       # highlight survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("A2_HEAD3 "))
    _o_dec(cast[int64](hamwrite_heading_count(3)))     # H3 survived
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("A2_UNDO_AT_LOAD "))
    _o_dec(cast[int64](hamwrite_can_undo()))           # 0: a load resets history
    _o_ch(10)
    _o_flush()

    # ---- (10a) the EDIT and FORMAT drop-downs carry the new commands --
    hamwrite_hit(70, 32)                               # click "Edit"
    _o_str(cast[Ptr[uint8]]("EDIT_MENU "))
    _o_dec(cast[int64](hamwrite_menu_open()))          # 2
    _o_ch(10)
    _render(W, H)
    _o_str(cast[Ptr[uint8]]("EDITMENU-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("EDITMENU-END\n"))
    _o_flush()
    hamwrite_hit(4, 300)                               # click away: close it
    hamwrite_hit(130, 32)                              # click "Format"
    _o_str(cast[Ptr[uint8]]("FMT_MENU "))
    _o_dec(cast[int64](hamwrite_menu_open()))          # 3
    _o_ch(10)
    _render(W, H)
    if argc >= 8:
        _write_ppm(cast[Ptr[char]](argv[7]))
    _o_str(cast[Ptr[uint8]]("FMTMENU-BEGIN\n"))
    _o_flush()
    sys_write(1, hamscene_bufptr(), hamscene_length())
    _o_str(cast[Ptr[uint8]]("FMTMENU-END\n"))
    _o_flush()
    hamwrite_hit(4, 300)                               # close the drop-down

    # ---- (10b) FULL-CAPACITY round-trip -------------------------------
    # A document at the 4096-char cap serialises to 10 + 5 + 3*4096 = 12303
    # bytes across three planes — this is the case that overflows an
    # under-sized ser_buf, so the gate pins it.
    big: Array[4097, uint8]
    bi: uint64 = 0
    while bi < 4096:
        big[bi] = 97 + cast[uint8](bi % 26)
        bi = bi + 1
    big[4096] = 0
    hamwrite_set_text(&big[0], 4096)
    _press(1)                                          # Ctrl-A
    hamwrite_hit(298, 88)                              # colour swatch 1
    _press(19)                                         # Ctrl-S
    _o_str(cast[Ptr[uint8]]("BIG_FILE_LEN "))
    _o_dec(_file_len())                                # 12303
    _o_ch(10)
    hamwrite_clear()
    _press(15)                                         # Ctrl-O
    _o_str(cast[Ptr[uint8]]("BIG_LEN "))
    _o_dec(cast[int64](hamwrite_len()))                # 4096
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("BIG_COLOR "))
    _o_dec(cast[int64](hamwrite_color_count(1)))       # 4096
    _o_ch(10)
    _o_flush()

    # ---- (11) SHOWCASE render: a realistic mixed-format document ------
    # Everything below goes through the SAME toolbar hit-tests a user clicks,
    # so the PNG is exactly what the app draws on the device.
    if argc >= 6:
        hamwrite_clear()
        hamwrite_set_fname(cast[Ptr[uint8]]("report.hdoc"))
        hamwrite_hit(316, 58)                          # size XL
        hamwrite_hit(420, 58)                          # align centre
        _type(cast[Ptr[uint8]]("Quarterly Report"))
        _press(13)
        hamwrite_hit(254, 58)                          # size M (normal)
        hamwrite_hit(360, 58)                          # align left
        hamwrite_hit(16, 58)                           # bold ON
        _type(cast[Ptr[uint8]]("Summary"))
        hamwrite_hit(16, 58)                           # bold OFF
        _press(13)
        _type(cast[Ptr[uint8]]("Revenue grew across every region this "))
        hamwrite_hit(78, 58)                           # underline ON
        _type(cast[Ptr[uint8]]("quarter"))
        hamwrite_hit(78, 58)                           # underline OFF
        _type(cast[Ptr[uint8]](", and the native office suite shipped its "))
        hamwrite_hit(48, 58)                           # italic ON
        _type(cast[Ptr[uint8]]("first word processor"))
        hamwrite_hit(48, 58)                           # italic OFF
        _type(cast[Ptr[uint8]](" on schedule."))
        _press(13)
        # a bold sub-head, then a real NUMBERED list in a colour
        hamwrite_hit(16, 58)                           # bold ON
        _type(cast[Ptr[uint8]]("Highlights"))
        hamwrite_hit(16, 58)                           # bold OFF
        _press(13)
        hamwrite_hit(162, 88)                          # numbered list ON
        hamwrite_hit(346, 88)                          # colour swatch 4 (green)
        _type(cast[Ptr[uint8]]("Multi-level undo and redo"))
        _press(13)
        _type(cast[Ptr[uint8]]("Find and replace with live highlighting"))
        _press(13)
        _type(cast[Ptr[uint8]]("Bullet and numbered lists, indent and outdent"))
        _press(13)
        hamwrite_hit(162, 88)                          # numbered list OFF
        hamwrite_hit(274, 88)                          # colour back to automatic
        hamwrite_hit(470, 58)                          # align right
        hamwrite_hit(224, 58)                          # size S (small)
        _type(cast[Ptr[uint8]]("-- HamWrite, the Hamnix word processor"))
        _render(W, H)
        _write_ppm(cast[Ptr[char]](argv[5]))
        _o_str(cast[Ptr[uint8]]("SHOWCASE_LEN "))
        _o_dec(cast[int64](hamwrite_len()))
        _o_ch(10)
        _o_flush()

    # ---- (11) HEADING TOGGLE with a BARE CARET ------------------------
    # The user's exact complaint was "if you select a header you can't click it
    # again to go back to normal text". The common case has NO selection at
    # all: the caret just sits in the paragraph. A heading is a PARAGRAPH
    # property, so one click restyles the whole paragraph and a second click on
    # the same button restores body text.
    hamwrite_clear()
    _type(cast[Ptr[uint8]]("Chapter One"))
    _press(13)
    _type(cast[Ptr[uint8]]("Body sentence."))
    # The caret now sits in paragraph 2 with NOTHING selected.
    _o_str(cast[Ptr[uint8]]("CARET_SEL "))
    _o_dec(cast[int64](hamwrite_sel_len()))            # 0 = no selection
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CARET_LEVEL_BEFORE "))
    _o_dec(cast[int64](hamwrite_para_heading_level()))  # 0 = body
    _o_ch(10)
    hamwrite_hit(120, 58)                              # toolbar "H1"
    _o_str(cast[Ptr[uint8]]("CARET_H1_ON "))
    _o_dec(cast[int64](hamwrite_para_heading_level()))  # 1 = the paragraph is H1
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CARET_H1_CHARS "))
    _o_dec(cast[int64](hamwrite_heading_count(1)))     # 14 = "Body sentence."
    _o_ch(10)
    hamwrite_hit(120, 58)                              # click "H1" AGAIN
    _o_str(cast[Ptr[uint8]]("CARET_H1_OFF "))
    _o_dec(cast[int64](hamwrite_para_heading_level()))  # 0 = back to body text
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("CARET_H1_CHARS_OFF "))
    _o_dec(cast[int64](hamwrite_heading_count(1)))     # 0
    _o_ch(10)
    # The OTHER paragraph was never touched: a heading is per-paragraph.
    _o_str(cast[Ptr[uint8]]("CARET_OTHER_PARA_BODY "))
    _o_dec(cast[int64](hamwrite_heading_level_at(0)))  # 0 = "Chapter One" body
    _o_ch(10)
    _o_flush()
    return 0
