# user/hamaudioscene.ad — NATIVE driver for the hamaudio player scene app.
#
# The player's UI STATE, LAYOUT, scene DISPLAY-LIST builder and pure input
# handlers live in lib/hamaudiocore.ad (extern-free, dual-target) so they can
# ALSO be rendered on the dev host (user/hamaudioscene_host.ad +
# scripts/test_hamaudio_host.sh). The .wav CONTAINER parse lives in the equally
# pure lib/wavdecode.ad. This file keeps ONLY the Hamnix-only side:
#   * open a wsys window, read its /keys + /event, commit the scene;
#   * READ the .wav file into memory and decode its header (lib/wavdecode);
#   * STREAM the decoded PCM to the native HDA sink — set rate/channels/format
#     by echoing verbs to /dev/audioctl, stage the sample bytes to /dev/audio,
#     and `start` — the SAME Plan-9 file path aplay/playtone use (no ioctls,
#     no sockets, just file writes). Playback position is tracked against the
#     100 Hz jiffies clock; the level meter reads the PCM around the cursor.
#
# USAGE:  hamaudioscene [file.wav|file.mp3 ...]  (defaults to the shipped
#         "Hamnix Music Demo" at /usr/share/music/hamnix-music-demo.mp3, with
#         the other preloaded clips seeded as extra playlist rows). Every argv
#         entry becomes a playlist track. A ".mp3" path is decoded to PCM by
#         lib/mp3decode (MPEG-1 Layer III) and streamed through the same sink.
#         The player is a VLC-style transport: playlist with Prev/Next, a seek
#         bar, Play/Pause/Stop, a volume slider, and Repeat/Shuffle toggles.

extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_get_jiffies() -> uint64
extern def sys_bind(new_path: Ptr[char], old_path: Ptr[char], flag: int32) -> int32

from lib.hamsceneloop import hamscene_park, HAMSCENE_IDLE_MS
from lib.hamui import hamscene_commit
from lib.wavdecode import wavdecode_parse, wavdecode_ok, wavdecode_rate, \
    wavdecode_channels, wavdecode_bits, wavdecode_data_off, wavdecode_data_len, \
    wavdecode_frame_bytes, wavdecode_duration_ms, wavdecode_peak
from lib.mp3decode import mp3decode_parse, mp3decode_ok, mp3decode_rate, \
    mp3decode_channels, mp3decode_data_len, mp3decode_duration_ms, \
    mp3decode_pcm_ptr, mp3decode_peak, \
    mp3decode_begin, mp3decode_pump, mp3decode_read, \
    mp3decode_frames_decoded, mp3decode_ring_frames, \
    mp3decode_total_pcm_frames
from lib.hamaudiocore import hamaudio_init, hamaudio_set_name, \
    hamaudio_set_format, hamaudio_set_duration_ms, hamaudio_set_position_ms, \
    hamaudio_set_level, hamaudio_set_playing, hamaudio_is_playing, \
    hamaudio_duration_ms, hamaudio_take_command, hamaudio_seek_ms, \
    hamaudio_key_line, hamaudio_press_at, hamaudio_release, \
    hamaudio_handle_pointer_line, \
    hamaudio_build_scene, hamaudio_layout, \
    hamaudio_playlist_clear, hamaudio_playlist_add, hamaudio_track_count, \
    hamaudio_set_selected_track, hamaudio_select_index, hamaudio_selected_track, \
    hamaudio_volume, hamaudio_repeat, hamaudio_shuffle, \
    HAMAUDIO_CMD_PLAYPAUSE, HAMAUDIO_CMD_STOP, HAMAUDIO_CMD_SEEK, \
    HAMAUDIO_CMD_SELECT, HAMAUDIO_CMD_PREV, HAMAUDIO_CMD_NEXT, \
    HAMAUDIO_CMD_VOLUME

# The whole file, read into memory (bounded). This buffer must hold the ENTIRE
# source file: the loader reads up to FILE_CAP bytes and the decoder parses that
# in-memory span. The old 320 KiB was sized for the ~105 KiB test.wav fixture,
# but the DEFAULT bare-launch track is now /usr/share/music/hamnix-music-demo.mp3
# (a ~2.2 MiB, 48 kHz stereo MPEG-1 Layer III clip). At 320 KiB the demo file did
# not fit — the loader only ever saw a truncated prefix — which is exactly why
# "unreadable audio" hit the big demo while the small test.mp3 (30 KiB) and
# test.wav (105 KiB), which fit whole, played fine. 4 MiB holds the shipped demo
# with headroom for real songs. (This is the ENCODED file; the decoded PCM is
# produced incrementally into lib/mp3decode's ring as the track plays, so a
# long track never needs its full decoded size in memory.)
FILE_CAP: uint64 = 4194304
au_filebuf: Array[4194304, uint8]
au_filelen: uint64 = 0

# ---- streaming transport --------------------------------------------------
#
# The player FEEDS the driver's continuous ring (drivers/audio/hda.ad) instead
# of staging fixed windows. The old model wrote one DMA-buffer-full and let the
# CYCLIC engine repeat it, then tried to swap in the next window from a WALL
# CLOCK — which both reprogrammed a running DMA engine (illegal, and it went
# silent) and could never stay in sync. Now:
#   * `streamopen` arms the ring, `nonblock 1` guarantees writes never stall
#     this UI event loop;
#   * every iteration we top the ring up by however many bytes the driver says
#     it can take (the " space " field of /dev/audio's status line);
#   * the progress indicator comes from the HARDWARE play cursor (the " pos "
#     field = unwrapped LPIB), so it reflects what was actually heard;
#   * for .mp3 the decoder is pumped INCREMENTALLY just ahead of the feed
#     cursor, so a 2:19 track streams without needing 27 MB of decoded PCM.
FEED_CHUNK: uint64 = 16384                  # staging buffer for one write
feed_buf: Array[16384, uint8]

feed_frame: uint64 = 0        # next sample-frame to hand to the driver
base_frame: uint64 = 0        # frame the current stream started at (seek base)
audfd_g: int32 = -1           # persistent /dev/audio fd (streaming appends)
stream_done: int32 = 0        # all of the track has been handed to the driver
# The frame the stream actually ENDS at. Normally the whole track, but if the
# decoder runs out of input early (a truncated/odd file, or a header scan that
# over-counted) it is wherever the decoder stopped. Ending on this instead of
# on the header-scan total is what stops the player sitting forever at 99 %
# waiting for a hardware cursor that can never get there.
stream_end_frame: uint64 = 0

# Decode LEAD. The decoder is pumped to stay this far ahead of the bytes handed
# to the driver, so a slow tick eats the lead instead of starving the ring. Two
# seconds costs ~380 KiB of the decoder's 20 s PCM ring and buys the software
# MP3 decoder a whole scheduling hiccup of slack under desktop load — the root
# of "it got stuck ~35 s in".
DECODE_LEAD_FRAMES: uint64 = 96000
# Hard cap on MPEG frames decoded per UI tick. The old inner loop could run 64
# pumps of 4 frames PER 16 KiB chunk — up to ~1000 MPEG frames, seconds of work
# in one tick. A tick that long overshoots a whole DMA ring lap, which used to
# desynchronise the driver's play cursor permanently. 32 frames is 37 k sample
# frames (~0.77 s of audio) per 16 ms tick: 48x realtime, plenty to catch up,
# and bounded.
PUMP_BUDGET_FRAMES: uint64 = 32

# Pending seek that needs the mp3 decoder rewound + pumped forward; done a
# bounded slice per UI tick so the window stays responsive. -1 == none.
seek_target: uint64 = 0
seek_active: int32 = 0

# Driver telemetry, refreshed once per loop from /dev/audio.
hda_space: uint64 = 0
hda_pos: uint64 = 0

ctlfd_g: int32 = -1

# 0 = WAV (raw PCM streamed straight from au_filebuf), 1 = MP3 (PCM decoded by
# lib/mp3decode into its own buffer). The source-accessor helpers below hide the
# difference so the transport/streaming code is format-agnostic.
src_is_mp3: int32 = 0

# ---- playlist: file paths of every track passed on argv (default = 1) -----
# The core (lib/hamaudiocore) holds the DISPLAY names + active row; the driver
# keeps the real paths and does the load on a SELECT command.
track_paths: Array[8, uint64]
ntrack: int32 = 0


# ---- format-agnostic PCM source accessors --------------------------------
def _src_base() -> Ptr[uint8]:
    if src_is_mp3 != 0:
        return mp3decode_pcm_ptr()
    return &au_filebuf[0]


def _src_off() -> uint64:
    if src_is_mp3 != 0:
        return 0
    return wavdecode_data_off()


def _src_len() -> uint64:
    if src_is_mp3 != 0:
        # WHOLE-track PCM length (from the header scan), not just the slice
        # decoded so far — decoding is incremental now.
        return mp3decode_total_pcm_frames() * cast[uint64](mp3decode_channels()) * 2
    return wavdecode_data_len()


def _src_rate() -> uint32:
    if src_is_mp3 != 0:
        return mp3decode_rate()
    return wavdecode_rate()


def _src_channels() -> uint32:
    if src_is_mp3 != 0:
        return mp3decode_channels()
    return wavdecode_channels()


def _src_bits() -> uint32:
    if src_is_mp3 != 0:
        return 16
    return wavdecode_bits()


def _src_frame_bytes() -> uint64:
    return cast[uint64](_src_channels()) * (cast[uint64](_src_bits()) / 8)


def _src_duration_ms() -> uint64:
    if src_is_mp3 != 0:
        return mp3decode_duration_ms()
    return wavdecode_duration_ms()


# Total sample-frames in the WHOLE track. For .mp3 this comes from the frame
# header scan, so it is the real track length even though only a slice has
# been decoded so far.
def _src_total_frames() -> uint64:
    fb: uint64 = _src_frame_bytes()
    if fb == 0:
        return 0
    if src_is_mp3 != 0:
        return mp3decode_total_pcm_frames()
    return wavdecode_data_len() / fb


# Peak |sample| over PCM data span [dataoff, dataoff+n) (offsets are relative to
# the START of the PCM payload, not the file).
def _src_peak(dataoff: uint64, n: uint64) -> uint32:
    if src_is_mp3 != 0:
        return mp3decode_peak(dataoff, n)
    return wavdecode_peak(&au_filebuf[0], wavdecode_data_off() + dataoff, n)


def _slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _writeall(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, _slen(s))


def _u64_to_dec(value: uint64, out: Ptr[uint8]) -> uint64:
    if value == 0:
        out[0] = 48
        out[1] = 0
        return 1
    digits: Array[24, uint8]
    n: uint64 = 0
    v: uint64 = value
    while v != 0:
        digits[n] = cast[uint8](v % 10) + 48
        v = v / 10
        n = n + 1
    written: uint64 = n
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digits[n]
        i = i + 1
    out[written] = 0
    return written


# ---- wsys window transport (mirrors user/hamcalcscene.ad) ----------------
def _newwindow() -> int32:
    wfd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/ctl"))
    if wfd < 0:
        return -1
    sys_write(wfd, cast[Ptr[uint8]]("newwindow\n"), 10)
    sys_close(wfd)
    rfd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/ctl"))
    if rfd < 0:
        return -1
    rbuf: Array[32, uint8]
    r: int64 = sys_read(rfd, &rbuf[0], 31)
    sys_close(rfd)
    if r <= 0:
        return -1
    wid: int32 = 0
    i: uint64 = 0
    while i < cast[uint64](r):
        c: uint8 = rbuf[i]
        if c >= 48 and c <= 57:
            wid = wid * 10 + cast[int32](c) - 48
        i = i + 1
    return wid


def _winpath(out: Ptr[uint8], wid: int32, leaf: Ptr[uint8]):
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/dev/wsys/")
    j: uint64 = 0
    while pre[j] != 0:
        out[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](wid), &out[p])
    k: uint64 = 0
    while leaf[k] != 0:
        out[p] = leaf[k]
        p = p + 1
        k = k + 1
    out[p] = 0


def emit_scene(wid: int32):
    hamaudio_build_scene()
    hamscene_commit(wid)


# ---- HDA control -----------------------------------------------------
def _ctl_verb(verb: Ptr[uint8], value: uint64):
    if ctlfd_g < 0:
        return
    line: Array[48, uint8]
    p: uint64 = 0
    j: uint64 = 0
    while verb[j] != 0:
        line[p] = verb[j]
        p = p + 1
        j = j + 1
    line[p] = 32
    p = p + 1
    p = p + _u64_to_dec(value, &line[p])
    line[p] = 10
    p = p + 1
    sys_write(ctlfd_g, &line[0], p)


def _ctl_word(s: Ptr[uint8]):
    if ctlfd_g >= 0:
        _writeall(ctlfd_g, s)


# Find `key` in `buf` and parse the decimal number that follows it.
def _status_field(buf: Ptr[uint8], n: uint64, key: Ptr[uint8]) -> uint64:
    klen: uint64 = _slen(key)
    if klen == 0 or n < klen:
        return 0
    i: uint64 = 0
    while i + klen <= n:
        j: uint64 = 0
        hit: int32 = 1
        while j < klen:
            if buf[i + j] != key[j]:
                hit = 0
                j = klen
            else:
                j = j + 1
        if hit == 1:
            k: uint64 = i + klen
            while k < n and (buf[k] < 48 or buf[k] > 57):
                k = k + 1
            v: uint64 = 0
            while k < n and buf[k] >= 48 and buf[k] <= 57:
                v = v * 10 + cast[uint64](buf[k] - 48)
                k = k + 1
            return v
        i = i + 1
    return 0


# Refresh hda_space / hda_pos from the driver's /dev/audio status line.
def _refresh_status():
    hda_space = 0
    hda_pos = 0
    sfd: int32 = sys_open(cast[Ptr[char]]("/dev/audio"))
    if sfd < 0:
        return
    sbuf: Array[224, uint8]
    r: int64 = sys_read(sfd, &sbuf[0], 223)
    sys_close(sfd)
    if r <= 0:
        return
    n: uint64 = cast[uint64](r)
    hda_space = _status_field(&sbuf[0], n, cast[Ptr[uint8]]("space "))
    hda_pos = _status_field(&sbuf[0], n, cast[Ptr[uint8]]("pos "))


# Open the streaming ring and begin playing at sample-frame `from_frame`.
def _start_stream_at(from_frame: uint64):
    total: uint64 = _src_total_frames()
    if from_frame >= total:
        return
    if audfd_g >= 0:
        sys_close(audfd_g)
        audfd_g = -1
    _ctl_word(cast[Ptr[uint8]]("stop\n"))
    _configure_format()
    # Arm the continuous ring, and make our writes NON-BLOCKING so a full ring
    # never freezes the UI event loop.
    _ctl_word(cast[Ptr[uint8]]("streamopen\n"))
    _ctl_word(cast[Ptr[uint8]]("nonblock 1\n"))
    audfd_g = sys_open_write(cast[Ptr[char]]("/dev/audio"))
    feed_frame = from_frame
    base_frame = from_frame
    stream_done = 0
    stream_end_frame = total
    hda_pos = 0
    hda_space = 0


# Hand the driver as much PCM as its ring will take, decoding .mp3 just ahead
# of the feed cursor. Bounded per call so the UI stays responsive.
def _feed():
    if audfd_g < 0:
        return
    if seek_active != 0:
        return                             # _pump_seek owns the decoder
    total: uint64 = _src_total_frames()
    fb: uint64 = _src_frame_bytes()
    if fb == 0 or total == 0:
        return
    if feed_frame >= total:
        stream_done = 1
        return
    # Keep the DECODER ahead of the feed cursor before touching the ring. The
    # old code only ever decoded to exactly the bytes it was about to push, so
    # the decoder had ZERO lead: the very first tick that ran slow left the
    # driver with nothing to play. Building (and holding) a couple of seconds
    # of decoded lead is the difference between a hiccup and a dropout.
    pumped: uint64 = 0
    if src_is_mp3 != 0:
        while pumped < PUMP_BUDGET_FRAMES \
                and mp3decode_frames_decoded() < feed_frame + DECODE_LEAD_FRAMES:
            n: uint64 = mp3decode_pump(4)
            if n == 0:
                # End of the encoded input. The track ENDS here, wherever the
                # header scan said it should. Recording it (instead of silently
                # breaking out of the feed loop, which is what used to happen)
                # is what stops a short/odd file freezing the transport.
                stream_end_frame = mp3decode_frames_decoded()
                if feed_frame >= stream_end_frame:
                    stream_done = 1
                pumped = PUMP_BUDGET_FRAMES
            else:
                pumped = pumped + n

    budget: uint64 = 65536                 # max bytes pushed per UI tick
    space: uint64 = hda_space
    while space > 0 and budget > 0 and feed_frame < total:
        want: uint64 = space
        if want > budget:
            want = budget
        if want > FEED_CHUNK:
            want = FEED_CHUNK
        wf: uint64 = want / fb             # whole sample-frames
        if wf == 0:
            break
        if feed_frame + wf > total:
            wf = total - feed_frame
        got: uint64 = 0
        if src_is_mp3 != 0:
            got = mp3decode_read(&feed_buf[0], feed_frame, wf)
            if got == 0:
                # Nothing readable at the feed cursor. Either the decoder has
                # not reached it yet (we are out of pump budget for this tick —
                # try again next tick) or the window has been evicted from the
                # decoder's ring, in which case SKIP FORWARD to the live edge.
                # Never just give up: leaving feed_frame parked is precisely
                # how the player wedged with the ring looping its last lap.
                dec: uint64 = mp3decode_frames_decoded()
                ring: uint64 = mp3decode_ring_frames()
                if dec > ring and feed_frame < dec - ring:
                    feed_frame = dec - ring
                    got = mp3decode_read(&feed_buf[0], feed_frame, wf)
                if got == 0:
                    break
        else:
            avail: uint64 = 0
            dl: uint64 = _src_len()
            if feed_frame * fb < dl:
                avail = (dl - feed_frame * fb) / fb
            if avail > wf:
                avail = wf
            src: uint64 = cast[uint64](_src_base()) + _src_off() \
                + feed_frame * fb
            bi: uint64 = 0
            while bi < avail * fb:
                feed_buf[bi] = cast[Ptr[uint8]](src)[bi]
                bi = bi + 1
            got = avail
        if got == 0:
            break
        w: int64 = sys_write(audfd_g, &feed_buf[0], got * fb)
        if w <= 0:
            break
        adv: uint64 = cast[uint64](w) / fb
        if adv == 0:
            break
        feed_frame = feed_frame + adv
        space = space - cast[uint64](w)
        budget = budget - cast[uint64](w)
    if feed_frame >= total:
        stream_done = 1
        stream_end_frame = total
    if stream_end_frame > 0 and feed_frame >= stream_end_frame:
        stream_done = 1


# Peak-level sample of the PCM window around the current byte cursor, fed to
# the level meter. Reads straight from the in-memory file buffer.
def _level_at(cur_byte: uint64) -> uint32:
    data_len: uint64 = _src_len()
    if cur_byte >= data_len:
        return 0
    win: uint64 = 2048
    if cur_byte + win > data_len:
        win = data_len - cur_byte
    return _src_peak(cur_byte, win)


# Sample-frame the HARDWARE has actually played up to (stream base + the
# driver's unwrapped LPIB cursor). This is the truthful transport position.
def _pos_frame() -> uint64:
    fb: uint64 = _src_frame_bytes()
    if fb == 0:
        return base_frame
    f: uint64 = base_frame + hda_pos / fb
    total: uint64 = _src_total_frames()
    if total > 0 and f > total:
        f = total
    return f


def _pos_ms() -> uint64:
    r: uint64 = cast[uint64](_src_rate())
    if r == 0:
        return 0
    return _pos_frame() * 1000 / r


def _ms_to_frames(ms: uint64) -> uint64:
    return ms * cast[uint64](_src_rate()) / 1000


# Seek to `target`. A .mp3 window that is still resident in the decoder's ring
# can be replayed directly; otherwise the decoder is REWOUND and pumped
# forward a slice at a time by _pump_seek() so the UI never freezes.
def _seek_to_frame(target: uint64):
    t: uint64 = target
    total: uint64 = _src_total_frames()
    if total > 0 and t >= total:
        t = 0
    seek_active = 0
    if src_is_mp3 != 0:
        dec: uint64 = mp3decode_frames_decoded()
        ring: uint64 = mp3decode_ring_frames()
        resident: int32 = 0
        if t < dec and (dec - t) <= ring:
            resident = 1
        if resident == 0:
            # Rewind the decoder and catch up incrementally.
            mp3decode_begin(&au_filebuf[0], au_filelen)
            seek_target = t
            seek_active = 1
            _ctl_word(cast[Ptr[uint8]]("stop\n"))
            base_frame = t
            feed_frame = t
            hda_pos = 0
            return
    _start_stream_at(t)


# Advance a pending long seek by a bounded number of mp3 frames per UI tick.
def _pump_seek():
    if seek_active == 0:
        return
    if mp3decode_frames_decoded() >= seek_target:
        seek_active = 0
        _start_stream_at(seek_target)
        return
    if mp3decode_pump(48) == 0:
        seek_active = 0                    # hit EOF before the target
        _start_stream_at(mp3decode_frames_decoded())


def _ms_to_bytes(ms: uint64) -> uint64:
    # bytes = ms/1000 * rate * frame_bytes
    rate: uint64 = cast[uint64](_src_rate())
    fb: uint64 = _src_frame_bytes()
    return ms * rate * fb / 1000


# Basename (past the last '/') of a NUL-terminated path.
def _basename(path: Ptr[char]) -> Ptr[uint8]:
    nm: Ptr[uint8] = cast[Ptr[uint8]](path)
    base: Ptr[uint8] = nm
    z: uint64 = 0
    while nm[z] != 0:
        if nm[z] == 47:
            base = &nm[z + 1]
        z = z + 1
    return base


# Read `path` into au_filebuf and decode it (.mp3 -> lib/mp3decode, else WAV).
# Sets src_is_mp3 + the core format/duration/name. Returns 1 on success.
def _load_and_decode(path: Ptr[char]) -> int32:
    au_filelen = 0
    infd: int32 = sys_open(path)
    if infd >= 0:
        while au_filelen < FILE_CAP:
            r: int64 = sys_read(infd, &au_filebuf[au_filelen],
                                FILE_CAP - au_filelen)
            if r <= 0:
                break
            au_filelen = au_filelen + cast[uint64](r)
        sys_close(infd)

    src_is_mp3 = 0
    plen: uint64 = 0
    while cast[Ptr[uint8]](path)[plen] != 0:
        plen = plen + 1
    if plen >= 4:
        e0: uint8 = cast[Ptr[uint8]](path)[plen - 3]
        e1: uint8 = cast[Ptr[uint8]](path)[plen - 2]
        e2: uint8 = cast[Ptr[uint8]](path)[plen - 1]
        if (e0 == 109 or e0 == 77) and (e1 == 112 or e1 == 80) and e2 == 51:
            src_is_mp3 = 1

    ok: int32 = 0
    if src_is_mp3 != 0:
        # INCREMENTAL: prime the decoder (scan the headers for the true
        # duration + decode the first frame) and let _feed() pump the rest as
        # it plays. Decoding the whole track up front would need ~27 MB of PCM
        # for the shipped demo and would stall the window on launch.
        ok = mp3decode_begin(&au_filebuf[0], au_filelen)
    elif au_filelen >= 44:
        ok = wavdecode_parse(&au_filebuf[0], au_filelen)
    if ok != 0:
        hamaudio_set_format(_src_rate(), _src_channels())
        hamaudio_set_duration_ms(_src_duration_ms())
        hamaudio_set_name(_basename(path))
    else:
        hamaudio_set_name(cast[Ptr[uint8]]("(unreadable audio)"))
    return ok


# Push the current source's rate/channels/format to /dev/audioctl.
def _configure_format():
    if ctlfd_g < 0:
        return
    _ctl_verb(cast[Ptr[uint8]]("rate"), cast[uint64](_src_rate()))
    _ctl_verb(cast[Ptr[uint8]]("channels"), cast[uint64](_src_channels()))
    if _src_bits() == 8:
        _ctl_word(cast[Ptr[uint8]]("format u8\n"))
    else:
        _ctl_word(cast[Ptr[uint8]]("format s16le\n"))


# Push the UI volume (0..100) to the HDA software mixer's master control. The
# `master <pct>` ctl verb is handled by drivers/audio/audio_cdev.ad.
def _push_volume():
    if ctlfd_g < 0:
        return
    _ctl_verb(cast[Ptr[uint8]]("master"), cast[uint64](hamaudio_volume()))


# ---- shuffle PRNG (xorshift64, lazily seeded from the jiffies clock) ------
rng_state: uint64 = 0


def _rand_u64() -> uint64:
    if rng_state == 0:
        rng_state = sys_get_jiffies() | 1
    x: uint64 = rng_state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    rng_state = x
    return x


# A random track index != cur (falls back to cur when the list has <2 tracks).
def _rand_other(cur: int32) -> int32:
    if ntrack <= 1:
        return cur
    r: int32 = cast[int32](_rand_u64() % cast[uint64](ntrack))
    if r == cur:
        r = r + 1
        if r >= ntrack:
            r = 0
    return r


# Next/previous track index honouring the shuffle toggle (wraps at the ends).
def _next_index(cur: int32) -> int32:
    if ntrack <= 1:
        return cur
    if hamaudio_shuffle() != 0:
        return _rand_other(cur)
    n: int32 = cur + 1
    if n >= ntrack:
        n = 0
    return n


def _prev_index(cur: int32) -> int32:
    if ntrack <= 1:
        return cur
    if hamaudio_shuffle() != 0:
        return _rand_other(cur)
    p: int32 = cur - 1
    if p < 0:
        p = ntrack - 1
    return p


# Stop the current stream, load+decode track `sel`, reconfigure the HDA stream
# format + volume, and autoplay it from the top. Resets the play anchors. The
# caller is responsible for resetting its own byte cursor to 0. Returns 1 if
# `sel` was a valid row (whether or not the file decoded).
def _switch_to(sel: int32) -> int32:
    if sel < 0 or sel >= ntrack:
        return 0
    _ctl_word(cast[Ptr[uint8]]("stop\n"))
    _ctl_word(cast[Ptr[uint8]]("reset\n"))
    okk: int32 = _load_and_decode(cast[Ptr[char]](track_paths[sel]))
    hamaudio_set_selected_track(sel)
    hamaudio_set_position_ms(0)
    hamaudio_set_level(0)
    if okk != 0:
        _configure_format()
        _push_volume()
        _start_stream_at(0)
        hamaudio_set_playing(1)
    else:
        hamaudio_set_playing(0)
    return 1


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    sys_bind(cast[Ptr[char]]("/dev"), cast[Ptr[char]]("#c"), 0)

    hamaudio_init()

    # --- build the playlist from argv (each arg is a track); default to the
    # shipped clip when launched bare. The core keeps display names; we keep the
    # real paths. The first track is the one that autoplays. ---
    hamaudio_playlist_clear()
    if argc >= 2:
        ai: int32 = 1
        while ai < argc and ntrack < 8:
            p: Ptr[char] = cast[Ptr[char]](argv[ai])
            track_paths[ntrack] = cast[uint64](p)
            hamaudio_playlist_add(_basename(p))
            ntrack = ntrack + 1
            ai = ai + 1
    else:
        # Bare launch: DEFAULT to the shipped "Hamnix Music Demo" (48 kHz
        # MPEG-1 Layer III at /usr/share/music/hamnix-music-demo.mp3, installed
        # by scripts/build_packages.py). It is track 0 and autoplays — no more
        # test.wav as the default open. The other preloaded clips are seeded as
        # additional playlist rows so Prev/Next have somewhere to go out of the
        # box; _load_and_decode() falls back gracefully if any is absent.
        track_paths[0] = cast[uint64](cast[Ptr[char]]("/usr/share/music/hamnix-music-demo.mp3"))
        hamaudio_playlist_add(cast[Ptr[uint8]]("hamnix-music-demo.mp3"))
        track_paths[1] = cast[uint64](cast[Ptr[char]]("/usr/share/sounds/test.wav"))
        hamaudio_playlist_add(cast[Ptr[uint8]]("test.wav"))
        track_paths[2] = cast[uint64](cast[Ptr[char]]("/usr/share/sounds/test.mp3"))
        hamaudio_playlist_add(cast[Ptr[uint8]]("test.mp3"))
        ntrack = 3

    # --- load + decode the first track ---
    path: Ptr[char] = cast[Ptr[char]](track_paths[0])
    ok: int32 = _load_and_decode(path)
    hamaudio_set_selected_track(0)

    # --- window ---
    wid: int32 = _newwindow()
    if wid < 0:
        _writeall(1, cast[Ptr[uint8]]("[hamaudio] FAIL newwindow\n"))
        return 1

    ctlp: Array[64, uint8]
    evp: Array[64, uint8]
    keysp: Array[64, uint8]
    _winpath(&ctlp[0], wid, cast[Ptr[uint8]]("/ctl"))
    _winpath(&evp[0], wid, cast[Ptr[uint8]]("/event"))
    _winpath(&keysp[0], wid, cast[Ptr[uint8]]("/keys"))

    # A multi-track playlist needs a taller window to show the track panel;
    # a single bare clip keeps the original compact 220 px window.
    lay_h: int32 = 200
    wcfd: int32 = sys_open_write(cast[Ptr[char]](&ctlp[0]))
    if wcfd >= 0:
        if ntrack > 1:
            _writeall(wcfd, cast[Ptr[uint8]]("geometry 480 160 360 360\n"))
            lay_h = 340
        else:
            _writeall(wcfd, cast[Ptr[uint8]]("geometry 480 200 360 220\n"))
        _writeall(wcfd, cast[Ptr[uint8]]("decorate 1\n"))
        _writeall(wcfd, cast[Ptr[uint8]]("z 6\n"))
        _writeall(wcfd, cast[Ptr[uint8]]("title Audio Player\n"))
        sys_close(wcfd)

    hamaudio_layout(360, lay_h)

    # --- HDA control fd; configure the stream format ---
    ctlfd_g = sys_open_write(cast[Ptr[char]]("/dev/audioctl"))
    if ctlfd_g >= 0 and ok != 0:
        _configure_format()
        _push_volume()

    emit_scene(wid)
    _writeall(1, cast[Ptr[uint8]]("[hamaudio] scene window ready\n"))

    kfd: int32 = sys_open(cast[Ptr[char]](&keysp[0]))

    # Autoplay the loaded clip on start so a bare launch produces sound (the
    # on-device gate opens the window and immediately hears playback).
    cur_byte: uint64 = 0
    if ok != 0:
        _start_stream_at(0)
        hamaudio_set_playing(1)
        _writeall(1, cast[Ptr[uint8]]("[hamaudio] playing\n"))
        emit_scene(wid)

    evbuf: Array[256, uint8]
    kbuf: Array[256, uint8]
    while True:
        changed: int32 = 0

        # --- KEYBOARD ---
        if kfd >= 0:
            kr: int64 = sys_read_nb(kfd, &kbuf[0], 255)
            if kr > 0:
                kls: uint64 = 0
                ki: uint64 = 0
                while ki <= cast[uint64](kr):
                    katend: int32 = 0
                    if ki == cast[uint64](kr):
                        katend = 1
                    if katend == 1 or kbuf[ki] == 10:
                        if ki > kls:
                            if hamaudio_key_line(&kbuf[kls], ki - kls) == 1:
                                changed = 1
                        kls = ki + 1
                    ki = ki + 1

        # --- POINTER (non-blocking drain of /event) ---
        efd: int32 = sys_open(cast[Ptr[char]](&evp[0]))
        if efd >= 0:
            r2: int64 = sys_read_nb(efd, &evbuf[0], 255)
            sys_close(efd)
            if r2 > 0:
                ls: uint64 = 0
                i: uint64 = 0
                while i <= cast[uint64](r2):
                    atend: int32 = 0
                    if i == cast[uint64](r2):
                        atend = 1
                    if atend == 1 or evbuf[i] == 10:
                        if i > ls:
                            if _handle_pointer(&evbuf[ls], i - ls) == 1:
                                changed = 1
                        ls = i + 1
                    i = i + 1

        # --- drain any queued command from the input handlers ---
        cmd: int32 = hamaudio_take_command()
        if cmd == HAMAUDIO_CMD_PLAYPAUSE:
            if hamaudio_is_playing() != 0:
                # Pause: stop DMA where it is; resume restarts the ring at the
                # frame the HARDWARE actually reached.
                _ctl_word(cast[Ptr[uint8]]("stop\n"))
                hamaudio_set_playing(0)
            else:
                _start_stream_at(_pos_frame())
                hamaudio_set_playing(1)
            changed = 1
        elif cmd == HAMAUDIO_CMD_STOP:
            _ctl_word(cast[Ptr[uint8]]("stop\n"))
            _ctl_word(cast[Ptr[uint8]]("reset\n"))
            hamaudio_set_playing(0)
            base_frame = 0
            feed_frame = 0
            hda_pos = 0
            cur_byte = 0
            hamaudio_set_position_ms(0)
            hamaudio_set_level(0)
            changed = 1
        elif cmd == HAMAUDIO_CMD_SEEK:
            tgt_ms: uint64 = hamaudio_seek_ms()
            _seek_to_frame(_ms_to_frames(tgt_ms))
            hamaudio_set_position_ms(tgt_ms)
            cur_byte = _ms_to_bytes(tgt_ms)
            hamaudio_set_level(_level_at(cur_byte))
            changed = 1
        elif cmd == HAMAUDIO_CMD_SELECT:
            # A playlist-row click: switch straight to that track.
            if _switch_to(hamaudio_select_index()) != 0:
                cur_byte = 0
            changed = 1
        elif cmd == HAMAUDIO_CMD_NEXT:
            if _switch_to(_next_index(hamaudio_selected_track())) != 0:
                cur_byte = 0
            changed = 1
        elif cmd == HAMAUDIO_CMD_PREV:
            if _switch_to(_prev_index(hamaudio_selected_track())) != 0:
                cur_byte = 0
            changed = 1
        elif cmd == HAMAUDIO_CMD_VOLUME:
            # The slider moved: push the new master volume to the HDA mixer.
            _push_volume()
            changed = 1

        # --- keep the ring fed and advance the play position while playing ---
        if hamaudio_is_playing() != 0:
            _refresh_status()
            _pump_seek()
            _feed()
            now_ms: uint64 = _pos_ms()
            dur: uint64 = hamaudio_duration_ms()
            # The track ends when everything has been handed to the driver AND
            # the hardware cursor has played it all out — NOT when a wall clock
            # says so.
            # End on the frame the stream ACTUALLY ends at, which is the whole
            # track normally but wherever the decoder ran out of input if the
            # file is short of what its header scan promised. Waiting on the
            # header-scan total in that case left the transport pinned at the
            # end forever with the ring cycling.
            end_at: uint64 = stream_end_frame
            if end_at == 0:
                end_at = _src_total_frames()
            ended: int32 = 0
            if stream_done != 0 and _pos_frame() + 1 >= end_at:
                ended = 1
            if ended != 0:
                # Reached the end. VLC-style follow-on, driven by the transport
                # toggles:
                #   * repeat-one         -> restage the SAME track from 0.
                #   * shuffle / more     -> auto-advance to the next track.
                #     tracks remain,        (sequential wraps only under
                #                            repeat-all; the last track stops
                #                            when repeat is off).
                #   * otherwise          -> stop + REWIND to 0 so the very next
                #                            Play restarts from the top.
                rep: int32 = hamaudio_repeat()
                cursel: int32 = hamaudio_selected_track()
                advance: int32 = 0
                target: int32 = cursel
                if rep == 2:
                    # repeat-one: restage current track.
                    advance = 1
                    target = cursel
                elif ntrack > 1:
                    if hamaudio_shuffle() != 0:
                        advance = 1
                        target = _rand_other(cursel)
                    elif cursel < ntrack - 1:
                        advance = 1
                        target = cursel + 1
                    elif rep == 1:
                        advance = 1                 # repeat-all wraps to 0
                        target = 0
                elif rep == 1:
                    advance = 1                     # single track, repeat-all
                    target = cursel

                if advance != 0:
                    _switch_to(target)
                    cur_byte = 0
                    changed = 1
                    _writeall(1, cast[Ptr[uint8]]("[hamaudio] EOF -> next\n"))
                else:
                    _ctl_word(cast[Ptr[uint8]]("stop\n"))
                    _ctl_word(cast[Ptr[uint8]]("reset\n"))
                    hamaudio_set_playing(0)
                    base_frame = 0
                    feed_frame = 0
                    hda_pos = 0
                    cur_byte = 0
                    hamaudio_set_position_ms(0)
                    hamaudio_set_level(0)
                    changed = 1
                    _writeall(1, cast[Ptr[uint8]]("[hamaudio] EOF -> idle (rewound)\n"))
            else:
                hamaudio_set_position_ms(now_ms)
                cur_byte = _ms_to_bytes(now_ms)
                hamaudio_set_level(_level_at(cur_byte))
                changed = 1

        if changed != 0:
            emit_scene(wid)
        hamscene_park(kfd, HAMSCENE_IDLE_MS)
    return 0


# Parse one /event pointer line and drive press/release edges. Delegates to the
# shared lib/hamaudiocore.ad handler (single source of truth, host-gated) which
# takes the FIRST THREE ints after the leading 'm' as x, y, buttons and ignores
# the trailing dz — the old inline copy took the LAST THREE, so buttons always
# read as dz==0 and no mouse transport ever fired.
def _handle_pointer(line: Ptr[uint8], n: uint64) -> int32:
    return hamaudio_handle_pointer_line(line, n)
