# ====================================================================
# Tiny libc-free helpers (front-end only; the engine has its own).
# ====================================================================
def _slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _writeall(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, _slen(s))


# Parse a non-negative decimal argv string into an int32 (stops at the first
# non-digit). Used only by the --click-link N test entry point.
def _arg_atoi(s: Ptr[uint8]) -> int32:
    v: int32 = 0
    i: uint64 = 0
    while s[i] >= 48 and s[i] <= 57:
        v = v * 10 + cast[int32](s[i] - 48)
        i = i + 1
    return v


# Append a NUL-terminated string into dst at pos; return the new position. Used
# to compose a whole diagnostic line into ONE buffer so it can be emitted with a
# SINGLE sys_write — the serial console interleaves concurrent DE writers, so a
# line built from many small writes gets torn apart (a gate grepping for the
# contiguous line then false-fails). One write per line keeps it atomic.
def _sapp(dst: Ptr[uint8], pos: uint64, s: Ptr[uint8]) -> uint64:
    i: uint64 = 0
    while s[i] != 0:
        dst[pos] = s[i]
        pos = pos + 1
        i = i + 1
    return pos


def _u64_to_dec(v: uint64, out: Ptr[uint8]) -> uint64:
    if v == 0:
        out[0] = 48
        return 1
    digs: Array[24, uint8]
    n: uint64 = 0
    x: uint64 = v
    while x > 0:
        digs[n] = cast[uint8](x % 10) + 48
        x = x / 10
        n = n + 1
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digs[n]
        i = i + 1
    return i


# ====================================================================
# FRONT-END I/O + UI state (the engine owns geometry + the layout model).
#
# resp_buf holds an HTTP response; html_buf holds a local file / the built-in
# demo / an error page.  src_ptr/src_len (in the engine) point at the HTML to
# parse (either &resp_buf[body_off] or &html_buf[0]).
# ====================================================================
RESP_CAP: uint64 = 4194304
HTML_CAP: uint64 = 4194304
resp_buf: Array[4194304, uint8]
html_buf: Array[4194304, uint8]
html_len: uint64 = 0

# Dedicated buffers for the JS fetch() transport, kept SEPARATE from resp_buf so a
# page-script's fetch (which runs during he_layout, while resp_buf still holds the
# page bytes) cannot corrupt the document being laid out.
JSFETCH_CAP: uint64 = 131072
jsfetch_buf: Array[131072, uint8]     # raw HTTP response for a script fetch()
jsfetch_url: Array[2048, uint8]       # NUL-terminated URL for http_get
jsfetch_body: Array[65536, uint8]     # POST body bytes (copied from the engine)
jsfetch_ctype: Array[256, uint8]      # NUL-terminated POST Content-Type

cur_url:  Array[1024, uint8]     # current URL / path (base for link resolve)
status_buf: Array[160, uint8]
status_len: uint64 = 0

# ADDRESS BAR — an editable text buffer shown across the top of the window.
addr_buf:   Array[1024, uint8]
addr_len:   uint64 = 0
addr_focus: int32 = 0
# #315: caret index (0..addr_len) + selection anchor so arrow keys move the
# cursor, a click lands it on the clicked glyph, and a drag / Ctrl+A selects a
# span of the URL (was append-only with the caret pinned to the end). Selection
# is [min(caret,anchor), max); shown only while addr_sel is set.
addr_cur:  uint64 = 0
addr_anc:  uint64 = 0
addr_sel:  int32 = 0
addr_esc:  int32 = 0            # CSI decode: 0 none, 1 ESC, 2 ESC[
addr_par:  int32 = 0           # CSI numeric param (for ESC '[' <n> '~')
addr_drag: int32 = 0           # 1 while a button-1 select-drag is in progress
addr_mid:  int32 = 0           # previous middle-button state (edge-detect paste)
addr_clip: Array[1024, uint8]  # paste scratch (/dev/snarf read)

# SEARCH BOX — a second editable field beside the URL bar (Firefox/Chrome-style).
# On Enter the query is URL-encoded and we navigate to Google's results page
# (https://www.google.com/search?q=<query>) — a working search path that does
# NOT depend on google.com's homepage JS. Simpler than the URL bar: append/
# backspace/Enter with a trailing caret (no selection/drag/clipboard).
search_buf:  Array[1024, uint8]
search_len:  uint64 = 0
search_focus: int32 = 0
search_cur:  uint64 = 0          # caret index (kept at search_len)
search_url:  Array[2048, uint8]  # composed https://www.google.com/search?q=...

# IN-PAGE FIELD FOCUS — the DOM element index of the page <input>/<textarea>
# the user clicked into (-1 = none). field_buf mirrors the address-bar edit
# pattern: keystrokes append/delete here, then the whole string is pushed into
# the engine (he_dom_set_value_index) so the typed text renders in the field box
# AND lands in the DOM value the form serializes on submit.
field_focus: int32 = -1
field_buf:   Array[1024, uint8]
field_len:   uint64 = 0


# ====================================================================
# TAB SESSIONS — the I/O half of the tab strip.
#
# The pure session model (per-tab URL / title / scroll / Back-Forward stack)
# lives in user/hambrowse_tabs.ad so a host gate can drive it with no kernel.
# What is left here is the part that needs the browser: computing a tab's label
# from the live page <title>, and the fetch + re-layout that makes a switched-to
# tab actually appear.
# ====================================================================

# Compute the strip label for the LIVE page into the tab-title scratch: the page
# <title> when the engine has one, else the address, else "New Tab".
tab_lbl: Array[48, uint8]


def _tab_label() -> int32:
    n: int32 = 0
    if he_dom_title_present() != 0:
        tp: Ptr[uint8] = he_dom_title_ptr()
        tn: uint64 = he_dom_title_len()
        while cast[uint64](n) < tn and n < TAB_TITSZ - 1:
            tab_lbl[n] = tp[cast[uint64](n)]
            n = n + 1
    if n == 0:
        k: uint64 = 0
        while k < addr_len and k < cast[uint64](TAB_TITSZ - 1):
            tab_lbl[k] = addr_buf[k]
            k = k + 1
        n = cast[int32](k)
    if n == 0:
        nt: Ptr[uint8] = cast[Ptr[uint8]]("New Tab")
        while nt[cast[uint64](n)] != 0:
            tab_lbl[n] = nt[cast[uint64](n)]
            n = n + 1
    tab_lbl[n] = 0
    return n


# Refresh the ACTIVE tab's strip label from the live page (called every present,
# so a page that just loaded — or set document.title from a script — relabels
# its own tab).
def _tab_sync_title():
    tabs_set_title(tabs_active(), &tab_lbl[0], _tab_label())


# Freeze the live browser state into the active tab's slot.
def _tab_save():
    tabs_save(&cur_url[0], &tab_lbl[0], _tab_label(), scroll_px)


# Bring tab `i`'s page on screen: its Back/Forward stack becomes the live one,
# then its URL is re-fetched and laid out (an empty slot = a brand-new tab, which
# shows the offline new-tab page). Chrome-shell focus state is cleared, exactly
# as a real tab switch does.
def _tab_show(i: int32):
    tabs_restore_history(i)
    addr_focus = 0
    search_focus = 0
    field_focus = -1
    menu_open = 0
    u: Ptr[uint8] = tabs_url_slot(i)
    if u[0] == 0:
        _set_cur_url(cast[Ptr[uint8]]("about:newtab"))
        _fetch(cast[Ptr[uint8]]("about:newtab"))
    else:
        _set_cur_url(u)
        _fetch(u)
    _reload_layout()
    scroll_px = tabs_scroll(i)
    _clamp_scroll()
    _tab_sync_title()


# The "+" button: open a tab on the new-tab page and switch to it.
def _tab_new() -> int32:
    _tab_save()
    ni: int32 = tabs_open()
    if ni < 0:
        return 0                                   # strip full (TAB_MAX)
    _tab_show(ni)
    return 1


# Click on a tab: switch to it.
def _tab_select(i: int32) -> int32:
    if i == tabs_active():
        return 0
    _tab_save()
    if tabs_select(i) == 0:
        return 0
    _tab_show(tabs_active())
    return 1


# Click on a tab's close (x) box.
def _tab_close(i: int32) -> int32:
    if i != tabs_active():
        _tab_save()
    if tabs_close(i) != 0:
        _tab_show(tabs_active())
        return 1
    return 0


# ====================================================================
# RENDER — the browser now presents the PIXEL engine (lib/htmlpage +
# lib/htmlpaint): the laid-out page is rasterised to a tall RGB document canvas
# (proportional AA text + decoded PNG <img>), then a scrolled viewport of it is
# blitted into the compositor v2 backbuffer alongside the chrome.
# ====================================================================
# PIXEL scroll state (replaces the old row-based scroll). scroll_px is the
# document-space y of the top of the content viewport; doc_*_px cache the last
# render's canvas size so scrolling re-blits without re-rendering.
scroll_px: int32 = 0
doc_w_px:  int32 = 0
doc_h_px:  int32 = 0
SCROLL_LINE: int32 = 40          # px per line-scroll (arrow / j / k / wheel)

# ---- Chrome-shell UI state (application menu / zoom / dev-tools) ------
menu_open:  int32 = 0            # ⋮ application menu overlay visible
zoom_pct:   int32 = 100         # page zoom (menu Zoom row)
devtools_open: int32 = 0        # docked Elements/Console panel visible
# Dev-tools text buffers (Elements tree + Console log), rebuilt on demand.
dt_dom_buf: Array[4096, uint8]
dt_dom_len: int32 = 0
dt_con_buf: Array[2048, uint8]
dt_con_len: int32 = 0


def _content_h() -> int32:
    ch: int32 = bh - CONTENT_Y - STATUS_H
    if ch < 0:
        return 0
    return ch


def _max_scroll() -> int32:
    m: int32 = doc_h_px - _content_h()
    if m < 0:
        return 0
    return m


def _clamp_scroll():
    if scroll_px < 0:
        scroll_px = 0
    ms: int32 = _max_scroll()
    if scroll_px > ms:
        scroll_px = ms


# Rasterise the current engine layout to the pixel document canvas and cache its
# size. he_layout() must have run first. Clamps the scroll to the new height.
def _render_doc():
    doc_h_px = htmlpage_render()
    doc_w_px = htmlpage_doc_width()
    _clamp_scroll()


# ---- <img> decode (native): resolve + slurp/fetch + PNG-decode into the
# shared htmlimg store, mirroring the host driver's two-pass image flow so the
# pixel renderer blits real bitmaps. Also decodes the embedded demo image.
png_file_buf: Array[262144, uint8]
img_path: Array[1024, uint8]


# Resolve an <img src> (src,slen) against cur_url into img_path (NUL-terminated).
# Absolute URLs and root-relative/document-relative refs reuse the exact same
# rules as link navigation (_resolve builds nav_buf); here we build img_path.
def _resolve_img(src: Ptr[uint8], slen: uint64):
    p: uint64 = 0
    # absolute http(s):// or file:// or "/abs" -> hand to _fetch-style open.
    # For simplicity resolve like a link: copy verbatim if it has a scheme or is
    # root/relative against cur_url's dir.
    if slen >= 7 and src[0] == 104 and src[1] == 116 and src[2] == 116 and \
       src[3] == 112:
        k: uint64 = 0
        while k < slen and p < 1023:
            img_path[p] = src[k]
            p = p + 1
            k = k + 1
        img_path[p] = 0
        return
    if slen > 0 and src[0] == 47:                    # root-relative "/x"
        alen: uint64 = _authority_len()
        j: uint64 = 0
        while j < alen and p < 1023:
            img_path[p] = cur_url[j]
            p = p + 1
            j = j + 1
        k2: uint64 = 0
        while k2 < slen and p < 1023:
            img_path[p] = src[k2]
            p = p + 1
            k2 = k2 + 1
        img_path[p] = 0
        return
    # document-relative: cur_url dir + src (strip a file:// on the way).
    dlen: uint64 = _dir_len()
    j2: uint64 = 0
    while j2 < dlen and p < 1023:
        img_path[p] = cur_url[j2]
        p = p + 1
        j2 = j2 + 1
    soff: uint64 = 0
    if slen >= 7 and src[0] == 102 and src[1] == 105 and src[2] == 108 and \
       src[3] == 101 and src[4] == 58 and src[5] == 47 and src[6] == 47:
        soff = 7
    k3: uint64 = soff
    while k3 < slen and p < 1023:
        img_path[p] = src[k3]
        p = p + 1
        k3 = k3 + 1
    img_path[p] = 0


# Slurp img_path into png_file_buf. Handles http(s):// via http_get, otherwise a
# local file / file:// path. Returns byte count or -1.
def _slurp_img() -> int64:
    if _starts(&img_path[0], cast[Ptr[uint8]]("http://")) != 0 or \
       _starts(&img_path[0], cast[Ptr[uint8]]("https://")) != 0:
        st: Array[1, int64]
        bo: Array[1, uint64]
        bl: Array[1, uint64]
        st[0] = 0
        bo[0] = 0
        bl[0] = 0
        rc: int64 = http_get(&img_path[0], &png_file_buf[0], 262144,
                             &st[0], &bo[0], &bl[0])
        if rc < 0 or bl[0] == 0:
            return -1
        # Move the body to the front of png_file_buf so png_decode sees it at [0].
        m: uint64 = 0
        while m < bl[0]:
            png_file_buf[m] = png_file_buf[bo[0] + m]
            m = m + 1
        return cast[int64](bl[0])
    path: Ptr[uint8] = &img_path[0]
    if _starts(&img_path[0], cast[Ptr[uint8]]("file://")) != 0:
        path = cast[Ptr[uint8]](cast[uint64](&img_path[0]) + 7)
    fd: int32 = sys_open(cast[Ptr[char]](path))
    if fd < 0:
        return -1
    got: uint64 = 0
    while got < 262143:
        n: int64 = sys_read(fd, &png_file_buf[got], 262144 - 1 - got)
        if n <= 0:
            break
        got = got + cast[uint64](n)
    sys_close(fd)
    return cast[int64](got)


# ---- external <link rel=stylesheet> fetch (native) ------------------
# Reuse the img resolve/fetch path (http9 for http(s)://, sys_open otherwise) to
# slurp each linked sheet, handing the raw CSS to the engine's cascade. No new
# fetch mechanism; same-origin/relative hrefs resolve exactly like <img src>.
css_dl_buf: Array[262144, uint8]


def _slurp_css() -> int64:
    if _starts(&img_path[0], cast[Ptr[uint8]]("http://")) != 0 or \
       _starts(&img_path[0], cast[Ptr[uint8]]("https://")) != 0:
        st: Array[1, int64]
        bo: Array[1, uint64]
        bl: Array[1, uint64]
        st[0] = 0
        bo[0] = 0
        bl[0] = 0
        rc: int64 = http_get(&img_path[0], &css_dl_buf[0], 262144,
                             &st[0], &bo[0], &bl[0])
        if rc < 0 or bl[0] == 0:
            return -1
        m: uint64 = 0
        while m < bl[0]:
            css_dl_buf[m] = css_dl_buf[bo[0] + m]
            m = m + 1
        return cast[int64](bl[0])
    path: Ptr[uint8] = &img_path[0]
    if _starts(&img_path[0], cast[Ptr[uint8]]("file://")) != 0:
        path = cast[Ptr[uint8]](cast[uint64](&img_path[0]) + 7)
    fd: int32 = sys_open(cast[Ptr[char]](path))
    if fd < 0:
        return -1
    got: uint64 = 0
    while got < 262143:
        n: int64 = sys_read(fd, &css_dl_buf[got], 262144 - 1 - got)
        if n <= 0:
            break
        got = got + cast[uint64](n)
    sys_close(fd)
    return cast[int64](got)


# Fetch every <link rel=stylesheet> the loaded HTML declares and feed the raw
# bytes to the engine's cascade so external stylesheets lay out like inline
# <style>. Bounded by the engine's MAX_CSS_LINKS + 256K buffer cap; a sheet that
# fails to fetch is simply skipped. Must run before the first he_layout().
def _fetch_stylesheets():
    he_css_reset()
    he_css_scan_links()
    nlk: int32 = he_css_link_count()
    li: int32 = 0
    while li < nlk:
        off: uint64 = he_css_link_off(li)
        ln: int32 = he_css_link_len(li)
        href: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](src_ptr) + off)
        _resolve_img(href, cast[uint64](ln))
        got: int64 = _slurp_css()
        if got > 0:
            he_css_append(&css_dl_buf[0], cast[uint64](got))
        li = li + 1


# Decode every <img src> the last he_layout() recorded, registering each in the
# htmlimg store so a second he_layout() sizes the boxes and htmlpage blits them.
def _decode_images():
    htmlimg_reset()
    _register_demo_image()
    ni: uint64 = he_n_images()
    idx: uint64 = 0
    while idx < ni:
        nm: Ptr[uint8] = he_img_name_ptr(idx)
        nl: uint64 = he_img_name_len(idx)
        _resolve_img(nm, nl)
        got: int64 = _slurp_img()
        # Dispatch by magic: PNG signature (89 50) vs JPEG SOI (FF D8). Both
        # decoders expose a parallel width/height/rgba-ptr API.
        if got >= 2:
            if png_file_buf[0] == 137 and png_file_buf[1] == 80:
                if png_decode(&png_file_buf[0], cast[uint64](got)) == 0:
                    htmlimg_add(nm, nl, png_width(), png_height(), png_rgba_ptr())
            elif png_file_buf[0] == 255 and png_file_buf[1] == 216:
                if jpeg_decode(&png_file_buf[0], cast[uint64](got)) == 0:
                    htmlimg_add(nm, nl, jpeg_width(), jpeg_height(), jpeg_rgba_ptr())
            elif png_file_buf[0] == 71 and png_file_buf[1] == 73 and \
                 png_file_buf[2] == 70 and png_file_buf[3] == 56:
                if gif_decode(&png_file_buf[0], cast[uint64](got)) == 0:
                    htmlimg_add(nm, nl, gif_width(), gif_height(), gif_rgba_ptr())
            elif svg_sniff(&png_file_buf[0], cast[uint64](got)) != 0:
                # SVG has no binary magic — dispatch by CONTENT (XML text).
                if svg_decode(&png_file_buf[0], cast[uint64](got)) == 0:
                    htmlimg_add(nm, nl, svg_width(), svg_height(), svg_rgba_ptr())
        idx = idx + 1


# Embedded demo image (the 48x32 checked-in sample PNG, 130 bytes as ASCII-hex)
# so the built-in demo page proves REAL PNG decode+blit on device with no file
# or network. Registered under "demo.png" (the demo's <img src>).
_DEMO_PNG_HEX: Array[261, uint8] = "89504e470d0a1a0a0000000d494844520000003000000020080600000054d4fb1c000000494944415478daedcf311100211004b09573f5d728410df25e045ec00333d7a5888064579d4ef58f561110101010101010101010780e7c739f4e49562b010101010101010101018157175b24dc177c32a80e0000000049454e44ae426082"


def _hexnib(c: uint8) -> int32:
    if c >= 48 and c <= 57:
        return cast[int32](c) - 48
    if c >= 97 and c <= 102:
        return cast[int32](c) - 97 + 10
    return 0


# Set to 1 once the embedded demo PNG decodes + registers (for the loud
# on-device asset diagnostic printed before the window rebinds stdout).
demo_img_decoded: int32 = 0


def _register_demo_image():
    # Decode the embedded hex -> png_file_buf, PNG-decode, register "demo.png".
    n: uint64 = 0
    while _DEMO_PNG_HEX[n * 2] != 0:
        hi: int32 = _hexnib(_DEMO_PNG_HEX[n * 2])
        lo: int32 = _hexnib(_DEMO_PNG_HEX[n * 2 + 1])
        png_file_buf[n] = cast[uint8](hi * 16 + lo)
        n = n + 1
    if png_decode(&png_file_buf[0], n) == 0:
        htmlimg_add(cast[Ptr[uint8]]("demo.png"), 8,
                    png_width(), png_height(), png_rgba_ptr())
        demo_img_decoded = 1


# Full re-layout after src_ptr/src_len point at new HTML: two engine passes
# around image decode (pass 1 records <img src>, decode fills htmlimg, pass 2
# sizes the boxes), then rasterise the pixel canvas + surface any JS output.
def _reload_layout():
    _fetch_stylesheets()
    he_layout()
    _decode_images()
    he_layout()
    scroll_px = 0
    _render_doc()
    _surface_js()


render_tmp: Array[1024, uint8]
seg_hex: Array[8, uint8]
bg_hex: Array[8, uint8]


def _set_status(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and i < 159:
        status_buf[i] = s[i]
        i = i + 1
    status_buf[i] = 0
    status_len = i


# Surface any JS run by the just-completed he_layout() in the status bar: the
# first console.log line (prefixed "JS: "), or a "JS error" note. Called after
# each he_layout() so a page's <script> output is visible on the native path.
# Pages without a <script> leave the fetch status untouched.
def _surface_js():
    if he_js_error() != 0:
        _set_status(cast[Ptr[uint8]]("JS error (see script)"))
        return
    n: uint64 = he_js_console_len()
    if n == 0:
        return
    cp: Ptr[uint8] = he_js_console_ptr()
    p: uint64 = 4
    status_buf[0] = 74                                # 'J'
    status_buf[1] = 83                                # 'S'
    status_buf[2] = 58                                # ':'
    status_buf[3] = 32                                # ' '
    i: uint64 = 0
    while i < n and cp[i] != 10 and p < 159:          # first console line only
        status_buf[p] = cp[i]
        p = p + 1
        i = i + 1
    status_buf[p] = 0
    status_len = p


# Serial-visible mirror of the page's JS console. The status bar (_surface_js)
# only shows the FIRST console line as pixels; this dumps the WHOLE console
# buffer to fd 2 (the serial console — stdout is rebound to the scene window)
# with a per-line "[hambrowse] js-console: " marker so a page <script>'s output
# — e.g. a fetch(url).then(r=>r.text()) body — is visible in the boot log,
# matching this file's other LOUD serial diagnostics. Emits nothing for a
# script-less page (empty console).
jscon_line: Array[2048, uint8]


def _surface_js_serial():
    n: uint64 = he_js_console_len()
    if n == 0:
        return
    cp: Ptr[uint8] = he_js_console_ptr()
    pre: Ptr[uint8] = cast[Ptr[uint8]]("[hambrowse] js-console: ")
    i: uint64 = 0
    while i < n:
        p: uint64 = 0
        a: uint64 = 0
        while pre[a] != 0 and p < 2046:
            jscon_line[p] = pre[a]
            p = p + 1
            a = a + 1
        while i < n and cp[i] != 10 and p < 2046:
            jscon_line[p] = cp[i]
            p = p + 1
            i = i + 1
        jscon_line[p] = 10
        p = p + 1
        sys_write(2, &jscon_line[0], p)
        while i < n and cp[i] == 10:
            i = i + 1


# Tell the SCENE-FILE DE to composite our v2 backbuffer. The kernel scene
# compositor (which owns /dev/fb at runlevel 5) only z-blits windows whose
# SCENE is non-empty, and the only scene verb that carries pixels is
# `buffer <x> <y> <w> <h>` — it copies the window's kernel-side v2 backbuffer
# (populated by our 'B' blit) into the window's scene cache. So after each
# commit we write a one-line scene with that verb; without it a pure-v2 window
# is invisible under the scene compositor (hamUId's v2 path only serves its own
# overlay slots). Replaces the scene each frame (full-window present).
scene_line: Array[80, uint8]


def _present_buffer(wid: int32, w: int32, h: int32):
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("buffer 0 0 ")
    a: uint64 = 0
    while pre[a] != 0:
        scene_line[p] = pre[a]
        p = p + 1
        a = a + 1
    p = p + _u64_to_dec(cast[uint64](w), &scene_line[p])
    scene_line[p] = 32
    p = p + 1
    p = p + _u64_to_dec(cast[uint64](h), &scene_line[p])
    scene_line[p] = 10
    p = p + 1
    scenep: Array[64, uint8]
    _winpath(&scenep[0], wid, cast[Ptr[uint8]]("/scene"))
    fd: int32 = sys_open_write(cast[Ptr[char]](&scenep[0]))
    if fd >= 0:
        sys_write(fd, &scene_line[0], p)
        sys_close(fd)
    # Poke `commit` on the window ctl: presents the scene (compositing our
    # backbuffer) AND resets the scene write cursor so the next frame is fresh.
    cp: Array[64, uint8]
    _winpath(&cp[0], wid, cast[Ptr[uint8]]("/ctl"))
    cfd: int32 = sys_open_write(cast[Ptr[char]](&cp[0]))
    if cfd >= 0:
        sys_write(cfd, cast[Ptr[uint8]]("commit\n"), 7)
        sys_close(cfd)


# Rebuild the dev-tools Elements (content outline from the display list) and
# Console (the JS console log) text blobs the docked panel renders. Cheap; only
# called while the panel is open.
def _build_devtools_text():
    # Elements: URL header then each text run as an indented node line.
    p: int32 = 0
    hdr: Ptr[uint8] = cast[Ptr[uint8]]("URL: ")
    k: int32 = 0
    while hdr[k] != 0 and p < 4090:
        dt_dom_buf[p] = hdr[k]
        p = p + 1
        k = k + 1
    i: uint64 = 0
    while i < addr_len and p < 4090:
        dt_dom_buf[p] = addr_buf[i]
        p = p + 1
        i = i + 1
    dt_dom_buf[p] = 10
    p = p + 1
    ns: uint64 = he_n_segs()
    tp: Ptr[uint8] = he_seg_text_ptr()
    si: uint64 = 0
    while si < ns and p < 4000:
        so: int32 = he_seg_off(si)
        sl: int32 = he_seg_len(si)
        if sl > 0:
            dt_dom_buf[p] = 32                        # two-space indent
            dt_dom_buf[p + 1] = 32
            p = p + 2
            j: int32 = 0
            while j < sl and j < 80 and p < 4090:
                c: uint8 = tp[so + j]
                if c < 32:
                    c = 32
                dt_dom_buf[p] = c
                p = p + 1
                j = j + 1
            dt_dom_buf[p] = 10
            p = p + 1
        si = si + 1
    dt_dom_len = p

    # Console: copy the engine's JS console log (or a placeholder).
    cp: Ptr[uint8] = he_js_console_ptr()
    cl: uint64 = he_js_console_len()
    q: int32 = 0
    if cl == 0:
        ph: Ptr[uint8] = cast[Ptr[uint8]]("(console is empty)")
        while ph[q] != 0 and q < 2040:
            dt_con_buf[q] = ph[q]
            q = q + 1
    else:
        ci: uint64 = 0
        while ci < cl and q < 2040:
            dt_con_buf[q] = cp[ci]
            q = q + 1
            ci = ci + 1
    dt_con_len = q


# Present one frame: paint the SHARED window compositor (lib/browserwin.ad —
# identical code to the host parity render) into our v2 backbuffer, blit it to
# the kernel backbuffer, then emit the `buffer` scene verb so the scene-file
# compositor puts our pixels on screen.
def emit(wid: int32):
    if hamui_v2_is_active() == 0:
        return
    bb: Ptr[uint8] = hamui_v2_bb_ptr()
    bbw: int32 = hamui_v2_bb_w()
    bbh: int32 = hamui_v2_bb_h()
    if cast[uint64](bb) == 0 or bbw <= 0 or bbh <= 0:
        return
    w: int32 = bw
    h: int32 = bh
    if w > bbw:
        w = bbw
    if h > bbh:
        h = bbh
    # Feed the Chrome-shell state into the shared compositor: the LIVE tab set
    # (each tab labelled by its page <title>, falling back to its URL), zoom %,
    # the menu overlay and (when open) the dev-tools Elements/Console text.
    # The active tab's label is refreshed here so a page that just finished
    # loading — or set document.title from a script — relabels its own tab.
    _tab_sync_title()
    browserwin_set_tabs(tabs_count(), tabs_active())
    tsi: int32 = 0
    while tsi < tabs_count():
        browserwin_set_tab_title(tsi, tabs_title_slot(tsi), tabs_title_len(tsi))
        tsi = tsi + 1
    browserwin_set_zoom(zoom_pct)
    browserwin_set_menu_open(menu_open)
    if devtools_open != 0:
        _build_devtools_text()
        browserwin_set_devtools(1, &dt_dom_buf[0], dt_dom_len,
                                &dt_con_buf[0], dt_con_len)
    else:
        browserwin_set_devtools(0, &dt_dom_buf[0], 0, &dt_con_buf[0], 0)
    browserwin_paint(bb, bbw, bbh, w, h, scroll_px, doc_h_px,
                     &addr_buf[0], addr_len, addr_focus,
                     &status_buf[0], status_len,
                     browserhist_can_back(), browserhist_can_fwd(),
                     addr_cur, _addr_sel_active(), _addr_sel_lo(), _addr_sel_hi(),
                     &search_buf[0], search_len, search_focus, search_cur)
    hamui_v2_commit_rect(0, 0, w, h)
    _present_buffer(wid, w, h)


# ====================================================================
# JS fetch() TRANSPORT — the real over-the-wire path for the JS engine's fetch().
#
# The engine (extern-free) calls back here with (url, method, body, content_type);
# we perform an ACTUAL HTTP request through user/http9.ad — the SAME Plan-9 /net
# client (sys_resolve DNS, net_dial / net_dial_tls connect; NO sockets) that a
# page navigation uses — and hand the engine the RAW response bytes (status line +
# headers + body). A GET routes through http_get; a POST routes through http_post
# (which writes a POST request line + Content-Type / Content-Length + the body
# over that same connection). The engine parses status/headers/body itself. A
# transport/DNS/connect failure returns NULL -> the engine rejects the Promise
# (TypeError), per the Fetch spec (a non-2xx status still fulfils with ok=false).
# ====================================================================
def _js_fetch_transport(url: Ptr[uint8], url_len: int32,
                        method: Ptr[uint8], method_len: int32,
                        body: Ptr[uint8], body_len: int32,
                        content_type: Ptr[uint8], content_type_len: int32,
                        out_status: Ptr[int64], out_len: Ptr[int32]) -> Ptr[uint8]:
    # Ad-block: drop a fetch() to a known ad/tracker endpoint (the common way
    # trackers exfiltrate) — reject the Promise by returning NULL, and count it.
    if adblock_should_block(url, url_len) != 0:
        out_status[0] = 0
        out_len[0] = 0
        return cast[Ptr[uint8]](0)

    # Copy the (ptr,len) URL into a NUL-terminated buffer for http_get/http_post.
    i: int32 = 0
    while i < url_len and i < 2047:
        jsfetch_url[i] = url[i]
        i = i + 1
    jsfetch_url[i] = 0

    # A POST if the method is exactly "POST" (case-sensitive; the engine upper-
    # cases nothing, but fetch users write POST). Everything else goes out as GET.
    is_post: int32 = 0
    if method_len == 4 and method[0] == 80 and method[1] == 79 \
            and method[2] == 83 and method[3] == 84:
        is_post = 1

    st: int64 = 0
    bo: uint64 = 0
    bl: uint64 = 0
    rc: int64 = 0
    if is_post != 0:
        # Copy the body + content-type into transport-owned buffers (the engine's
        # backing strings may move); http_post BORROWS them for the call.
        bn: int32 = body_len
        if bn > 65535:
            bn = 65535
        b: int32 = 0
        while b < bn:
            jsfetch_body[b] = body[b]
            b = b + 1
        c: int32 = 0
        while c < content_type_len and c < 255:
            jsfetch_ctype[c] = content_type[c]
            c = c + 1
        jsfetch_ctype[c] = 0
        rc = http_post(&jsfetch_url[0], &jsfetch_body[0], cast[uint64](bn),
                       &jsfetch_ctype[0], &jsfetch_buf[0], JSFETCH_CAP,
                       &st, &bo, &bl)
    else:
        rc = http_get(&jsfetch_url[0], &jsfetch_buf[0], JSFETCH_CAP,
                      &st, &bo, &bl)
    if rc < 0:
        out_len[0] = 0
        return cast[Ptr[uint8]](0)
    out_status[0] = st
    # Raw response length = header block (up to body_off) + body length. http_get
    # decodes chunked bodies in place, so bo+bl spans headers + the decoded body.
    out_len[0] = cast[int32](bo + bl)
    return &jsfetch_buf[0]


# ====================================================================
# FETCH — HTTP via http9 (the wget/curl path) or a local file.
# ====================================================================
def _app(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and html_len < HTML_CAP - 1:
        html_buf[html_len] = s[i]
        html_len = html_len + 1
        i = i + 1


def _build_error(msg: Ptr[uint8], detail: Ptr[uint8]):
    # Compose a tiny HTML error page in html_buf and point src at it.
    html_len = 0
    _app(cast[Ptr[uint8]]("<h1>"))
    _app(msg)
    _app(cast[Ptr[uint8]]("</h1><p>"))
    _app(detail)
    _app(cast[Ptr[uint8]]("</p>"))
    src_ptr = &html_buf[0]
    src_len = html_len


def _starts(s: Ptr[uint8], pfx: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while pfx[i] != 0:
        if s[i] != pfx[i]:
            return 0
        i = i + 1
    return 1


# Copy cur_url into the (unfocused) address-bar buffer so the bar reflects
# wherever we actually navigated.
def _sync_addr_from_url():
    i: uint64 = 0
    while cur_url[i] != 0 and i < 1023:
        addr_buf[i] = cur_url[i]
        i = i + 1
    addr_buf[i] = 0
    addr_len = i
    addr_cur = i               # #315: caret to end on a fresh URL load
    addr_anc = i
    addr_sel = 0


def _set_cur_url(u: Ptr[uint8]):
    i: uint64 = 0
    while u[i] != 0 and i < 1023:
        cur_url[i] = u[i]
        i = i + 1
    cur_url[i] = 0
    _sync_addr_from_url()
    # Tell the ENGINE the document URL, so IDL URL reflection (a.href / img.src)
    # returns the ABSOLUTISED url a real browser returns instead of the raw
    # attribute. Without this a page that reads `a.href` and re-navigates gets a
    # relative string back (measured against chromium --headless).
    he_set_document_url(&cur_url[0], cast[int32](i))


# Fetch `url` into src_ptr/src_len. Sets the status line. cur_url must be set.
def _fetch(url: Ptr[uint8]):
    # "about:" pseudo-URLs are served from memory — no network, no file. A tab
    # opened with "+" lands on about:newtab, so the "+" works with the network
    # down and a gate can drive it offline.
    if _starts(url, cast[Ptr[uint8]]("about:")) != 0:
        if _starts(url, cast[Ptr[uint8]]("about:demo")) != 0:
            _load_demo()
        else:
            _load_newtab()
        return
    if _starts(url, cast[Ptr[uint8]]("http://")) != 0 or \
       _starts(url, cast[Ptr[uint8]]("https://")) != 0:
        st: Array[1, int64]
        bo: Array[1, uint64]
        bl: Array[1, uint64]
        st[0] = 0
        bo[0] = 0
        bl[0] = 0
        rc: int64 = http_get(url, &resp_buf[0], RESP_CAP,
                             &st[0], &bo[0], &bl[0])
        if rc < 0:
            _build_error(cast[Ptr[uint8]]("Fetch failed"), url)
            _set_status(cast[Ptr[uint8]]("transport error (DNS/connect/TLS)"))
            # LOUD serial diagnostic (printed BEFORE newwindow rebinds stdout):
            # capture the exact transport failure so a network gate can see the
            # WALL (connect refused / chunked / cap) instead of a silent blank.
            fl: Array[96, uint8]
            fp: uint64 = _sapp(&fl[0], 0,
                cast[Ptr[uint8]]("[hambrowse] fetch FAILED rc=-"))
            fp = fp + _u64_to_dec(cast[uint64](0 - rc), &fl[fp])
            fl[fp] = 10
            fp = fp + 1
            sys_write(1, &fl[0], fp)
            return
        src_ptr = cast[Ptr[uint8]](cast[uint64](&resp_buf[0]) + bo[0])
        src_len = bl[0]
        # http_get may have followed 3xx redirects; adopt the FINAL URL so
        # relative links + the address bar resolve against where we landed.
        _set_cur_url(http_effective_url())
        sb: Array[64, uint8]
        sp: uint64 = 0
        pf: Ptr[uint8] = cast[Ptr[uint8]]("HTTP ")
        a: uint64 = 0
        while pf[a] != 0:
            sb[sp] = pf[a]
            sp = sp + 1
            a = a + 1
        sp = sp + _u64_to_dec(cast[uint64](st[0]), &sb[sp])
        pf2: Ptr[uint8] = cast[Ptr[uint8]]("  bytes ")
        a = 0
        while pf2[a] != 0:
            sb[sp] = pf2[a]
            sp = sp + 1
            a = a + 1
        sp = sp + _u64_to_dec(bl[0], &sb[sp])
        sb[sp] = 0
        _set_status(&sb[0])
        # LOUD serial diagnostic (printed BEFORE newwindow rebinds stdout off
        # serial): proves hambrowse completed a NETWORK fetch and how many body
        # bytes it will lay out. A network gate asserts on this byte count +
        # HTTP status to distinguish a genuine served-page render from the
        # built-in demo / a local file / an error page.
        dl: Array[96, uint8]
        dp: uint64 = _sapp(&dl[0], 0,
            cast[Ptr[uint8]]("[hambrowse] fetched http status="))
        dp = dp + _u64_to_dec(cast[uint64](st[0]), &dl[dp])
        dp = _sapp(&dl[0], dp, cast[Ptr[uint8]](" bytes="))
        dp = dp + _u64_to_dec(bl[0], &dl[dp])
        dl[dp] = 10
        dp = dp + 1
        sys_write(1, &dl[0], dp)
        return
    # Local file path (strip a file:// prefix if present).
    path: Ptr[uint8] = url
    if _starts(url, cast[Ptr[uint8]]("file://")) != 0:
        path = cast[Ptr[uint8]](cast[uint64](url) + 7)
    fd: int32 = sys_open(cast[Ptr[char]](path))
    if fd < 0:
        _build_error(cast[Ptr[uint8]]("Cannot open file"), url)
        _set_status(cast[Ptr[uint8]]("open failed"))
        return
    html_len = 0
    while html_len < HTML_CAP - 1:
        n: int64 = sys_read(fd, &html_buf[html_len], HTML_CAP - 1 - html_len)
        if n <= 0:
            break
        html_len = html_len + cast[uint64](n)
    sys_close(fd)
    src_ptr = &html_buf[0]
    src_len = html_len
    sb2: Array[48, uint8]
    sp2: uint64 = 0
    pf3: Ptr[uint8] = cast[Ptr[uint8]]("file  ")
    a2: uint64 = 0
    while pf3[a2] != 0:
        sb2[sp2] = pf3[a2]
        sp2 = sp2 + 1
        a2 = a2 + 1
    sp2 = sp2 + _u64_to_dec(html_len, &sb2[sp2])
    pf4: Ptr[uint8] = cast[Ptr[uint8]](" bytes")
    a2 = 0
    while pf4[a2] != 0:
        sb2[sp2] = pf4[a2]
        sp2 = sp2 + 1
        a2 = a2 + 1
    sb2[sp2] = 0
    _set_status(&sb2[0])


# POST-fetch `url` with an application/x-www-form-urlencoded body (a form submit
# whose method=POST). The GET twin of this is _fetch; the request goes out through
# http9's http_post (method + Content-Type + body written onto the wire — the SAME
# /net client, no sockets). On success src_ptr/src_len point at the response body
# and cur_url follows redirects, exactly like _fetch. body[0..blen) is the request
# body; it is NUL-terminated by the caller but http_post takes an explicit length.
def _fetch_post(url: Ptr[uint8], body: Ptr[uint8], blen: uint64):
    st: Array[1, int64]
    bo: Array[1, uint64]
    bl: Array[1, uint64]
    st[0] = 0
    bo[0] = 0
    bl[0] = 0
    ct: Ptr[uint8] = cast[Ptr[uint8]]("application/x-www-form-urlencoded")
    rc: int64 = http_post(url, body, blen, ct, &resp_buf[0], RESP_CAP,
                          &st[0], &bo[0], &bl[0])
    if rc < 0:
        _build_error(cast[Ptr[uint8]]("Form POST failed"), url)
        _set_status(cast[Ptr[uint8]]("transport error (DNS/connect/TLS)"))
        fl: Array[96, uint8]
        fp: uint64 = _sapp(&fl[0], 0,
            cast[Ptr[uint8]]("[hambrowse] form-POST FAILED rc=-"))
        fp = fp + _u64_to_dec(cast[uint64](0 - rc), &fl[fp])
        fl[fp] = 10
        fp = fp + 1
        sys_write(1, &fl[0], fp)
        return
    src_ptr = cast[Ptr[uint8]](cast[uint64](&resp_buf[0]) + bo[0])
    src_len = bl[0]
    _set_cur_url(http_effective_url())
    sb: Array[64, uint8]
    sp: uint64 = _sapp(&sb[0], 0, cast[Ptr[uint8]]("HTTP "))
    sp = sp + _u64_to_dec(cast[uint64](st[0]), &sb[sp])
    sp = _sapp(&sb[0], sp, cast[Ptr[uint8]]("  bytes "))
    sp = sp + _u64_to_dec(bl[0], &sb[sp])
    sb[sp] = 0
    _set_status(&sb[0])
    # LOUD serial proof that a FORM POST left the browser over the wire — a nav
    # gate greps this to distinguish a real POST navigation from a GET.
    dl: Array[96, uint8]
    dp: uint64 = _sapp(&dl[0], 0,
        cast[Ptr[uint8]]("[hambrowse] form-POST http status="))
    dp = dp + _u64_to_dec(cast[uint64](st[0]), &dl[dp])
    dp = _sapp(&dl[0], dp, cast[Ptr[uint8]](" reqbytes="))
    dp = dp + _u64_to_dec(blen, &dl[dp])
    dp = _sapp(&dl[0], dp, cast[Ptr[uint8]](" bytes="))
    dp = dp + _u64_to_dec(bl[0], &dl[dp])
    dl[dp] = 10
    dp = dp + 1
    sys_write(1, &dl[0], dp)


# Built-in demo page (no network) — exercises every supported feature.
# The NEW TAB page — what "+" opens. Deliberately tiny and static (no network),
# so a fresh tab always renders something useful even offline: the product mark,
# a real <form> pointed at the current search engine, and shortcut links.
def _load_newtab():
    html_len = 0
    _app(cast[Ptr[uint8]]("<html><head><title>New Tab</title>"))
    _app(cast[Ptr[uint8]]("<style>body{text-align:center}"))
    _app(cast[Ptr[uint8]]("h1{color:#1a73e8}"))
    _app(cast[Ptr[uint8]](".sb{max-width:520px;margin:0 auto}"))
    _app(cast[Ptr[uint8]](".sb input{width:100%}</style></head><body>"))
    _app(cast[Ptr[uint8]]("<h1>hambrowse</h1>"))
    _app(cast[Ptr[uint8]]("<div class=\"sb\">"))
    _app(cast[Ptr[uint8]]("<form action=\"https://www.google.com/search\" "))
    _app(cast[Ptr[uint8]]("method=\"get\">"))
    _app(cast[Ptr[uint8]]("<input name=\"q\" placeholder=\"Search the web\">"))
    _app(cast[Ptr[uint8]]("</form></div>"))
    _app(cast[Ptr[uint8]]("<p>"))
    _app(cast[Ptr[uint8]]("<a href=\"https://www.google.com/\">Google</a> &middot; "))
    _app(cast[Ptr[uint8]]("<a href=\"https://en.wikipedia.org/\">Wikipedia</a> &middot; "))
    _app(cast[Ptr[uint8]]("<a href=\"about:demo\">Demo page</a>"))
    _app(cast[Ptr[uint8]]("</p></body></html>"))
    src_ptr = &html_buf[0]
    src_len = html_len
    _set_status(cast[Ptr[uint8]]("new tab"))


def _load_demo():
    html_len = 0
    _app(cast[Ptr[uint8]]("<html><head><title>ignored</title>"))
    _app(cast[Ptr[uint8]]("<style>body{color:red}</style></head><body>"))
    _app(cast[Ptr[uint8]]("<h1>Hamnix Web</h1>"))
    _app(cast[Ptr[uint8]]("<p>Welcome to <b>hambrowse</b>, the native "))
    _app(cast[Ptr[uint8]]("<i>scene-DE</i> web browser. It fetches a page "))
    _app(cast[Ptr[uint8]]("over HTTP and renders a tolerant subset of HTML "))
    _app(cast[Ptr[uint8]]("&mdash; now with <span style=\"color:#c00000\">"))
    _app(cast[Ptr[uint8]]("basic CSS colour</span>.</p>"))
    _app(cast[Ptr[uint8]]("<p><img src=\"demo.png\" width=\"96\" height=\"64\"> "))
    _app(cast[Ptr[uint8]]("a real decoded PNG, blitted at 2x.</p>"))
    _app(cast[Ptr[uint8]]("<h2>Features</h2>"))
    _app(cast[Ptr[uint8]]("<ul>"))
    _app(cast[Ptr[uint8]]("<li>Headings h1&#45;h3, paragraphs and "))
    _app(cast[Ptr[uint8]]("line<br>breaks</li>"))
    _app(cast[Ptr[uint8]]("<li>Bold, lists, and <b>nested <i>inline</i> "))
    _app(cast[Ptr[uint8]]("markup</b></li>"))
    _app(cast[Ptr[uint8]]("<li><font color=\"green\">Coloured</font> text via "))
    _app(cast[Ptr[uint8]]("<font color=\"blue\">font</font> and "))
    _app(cast[Ptr[uint8]]("<span style=\"color:purple\">span</span></li>"))
    _app(cast[Ptr[uint8]]("<li>Hyperlinks that "))
    _app(cast[Ptr[uint8]]("<a href=\"http://example.com/\">navigate</a> "))
    _app(cast[Ptr[uint8]]("when clicked</li>"))
    _app(cast[Ptr[uint8]]("<li>Word wrapping to the window width</li>"))
    _app(cast[Ptr[uint8]]("</ul>"))
    _app(cast[Ptr[uint8]]("<h3>Preformatted</h3>"))
    _app(cast[Ptr[uint8]]("<pre>  fn main() {\n"))
    _app(cast[Ptr[uint8]]("      print(\"hello, hamnix\");\n  }</pre>"))
    _app(cast[Ptr[uint8]]("<p>Entities work too: 1 &lt; 2 &amp;&amp; 3 "))
    _app(cast[Ptr[uint8]]("&gt; 2, &quot;quoted&quot;, and &#72;&#105;.</p>"))
    _app(cast[Ptr[uint8]]("<p>Visit "))
    _app(cast[Ptr[uint8]]("<a href=\"http://127.0.0.1/index.html\">the "))
    _app(cast[Ptr[uint8]]("local server</a> or scroll for more. "))
    _app(cast[Ptr[uint8]]("This paragraph is intentionally long so that "))
    _app(cast[Ptr[uint8]]("the layout engine has to wrap it across several "))
    _app(cast[Ptr[uint8]]("lines inside the content area, demonstrating "))
    _app(cast[Ptr[uint8]]("the inline flow and right margin handling of "))
    _app(cast[Ptr[uint8]]("the renderer in a real window.</p>"))
    _app(cast[Ptr[uint8]]("</body></html>"))
    src_ptr = &html_buf[0]
    src_len = html_len
    sb: Array[40, uint8]
    sp: uint64 = 0
    df: Ptr[uint8] = cast[Ptr[uint8]]("demo page  ")
    a: uint64 = 0
    while df[a] != 0:
        sb[sp] = df[a]
        sp = sp + 1
        a = a + 1
    sp = sp + _u64_to_dec(html_len, &sb[sp])
    sb[sp] = 0
    _set_status(&sb[0])


# ====================================================================
# LINK NAVIGATION.
# ====================================================================
nav_buf: Array[1024, uint8]
# POST form submit: the urlencoded request body, captured out of the engine's
# he_nav_body_* before he_nav_clear() wipes it (the clear resets dom_body_len).
post_body_buf: Array[8192, uint8]
post_body_len: uint64 = 0


def _href_starts(ho: uint64, hl: uint64, pfx: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while pfx[i] != 0:
        if i >= hl:
            return 0
        if link_href_buf[ho + i] != pfx[i]:
            return 0
        i = i + 1
    return 1


# Length of "scheme://authority" in cur_url (up to the first '/' after "://").
def _authority_len() -> uint64:
    n: uint64 = _slen(&cur_url[0])
    i: uint64 = 0
    while i + 2 < n:
        if cur_url[i] == 58 and cur_url[i + 1] == 47 and cur_url[i + 2] == 47:
            j: uint64 = i + 3
            while j < n and cur_url[j] != 47:
                j = j + 1
            return j
        i = i + 1
    return 0


# Length of cur_url up to and including the last '/' (the "directory").
def _dir_len() -> uint64:
    n: uint64 = _slen(&cur_url[0])
    last: int64 = -1
    al: uint64 = _authority_len()
    i: uint64 = al
    while i < n:
        if cur_url[i] == 47:
            last = cast[int64](i)
        i = i + 1
    if last < 0:
        return n                                      # no path slash: append
    return cast[uint64](last) + 1


# Resolve href (link id) against cur_url into nav_buf. Returns 1 if usable.
def _resolve(lid: int32) -> int32:
    if lid < 0 or cast[uint64](lid) >= n_links:
        return 0
    ho: uint64 = cast[uint64](link_off[lid])
    hl: uint64 = cast[uint64](link_len[lid])
    # in-page anchor: ignore
    if hl > 0 and link_href_buf[ho] == 35:           # '#'
        return 0
    # absolute URL
    if hl >= 7:
        if _href_starts(ho, hl, cast[Ptr[uint8]]("http://")) != 0 or \
           _href_starts(ho, hl, cast[Ptr[uint8]]("https://")) != 0:
            k: uint64 = 0
            while k < hl and k < 1023:
                nav_buf[k] = link_href_buf[ho + k]
                k = k + 1
            nav_buf[k] = 0
            return 1
    # root-relative ("/path"): scheme://authority + href
    if hl > 0 and link_href_buf[ho] == 47:
        alen: uint64 = _authority_len()
        if alen == 0:
            return 0
        p: uint64 = 0
        while p < alen and p < 1023:
            nav_buf[p] = cur_url[p]
            p = p + 1
        k2: uint64 = 0
        while k2 < hl and p < 1023:
            nav_buf[p] = link_href_buf[ho + k2]
            p = p + 1
            k2 = k2 + 1
        nav_buf[p] = 0
        return 1
    # document-relative: cur_url up to last '/' + href
    dlen: uint64 = _dir_len()
    p2: uint64 = 0
    while p2 < dlen and p2 < 1023:
        nav_buf[p2] = cur_url[p2]
        p2 = p2 + 1
    k3: uint64 = 0
    while k3 < hl and p2 < 1023:
        nav_buf[p2] = link_href_buf[ho + k3]
        p2 = p2 + 1
        k3 = k3 + 1
    nav_buf[p2] = 0
    return 1


def _cur_url_len() -> uint64:
    i: uint64 = 0
    while cur_url[i] != 0 and i < 1023:
        i = i + 1
    return i


# Record the page we just landed on in the Back/Forward session history. cur_url
# has been updated by _fetch (following any redirects), so we push where we
# actually ARE, not where we aimed. A reload of the same URL is a no-op.
def _hist_record():
    browserhist_push(&cur_url[0], _cur_url_len())


def _navigate(lid: int32) -> int32:
    if _resolve(lid) == 0:
        return 0
    _set_cur_url(&nav_buf[0])
    _fetch(&nav_buf[0])
    _reload_layout()
    _hist_record()
    return 1


# BACK / FORWARD — re-fetch a URL from the session history WITHOUT pushing it
# (walking history must leave the stack, and the opposite button, intact).
def _nav_back() -> int32:
    u: Ptr[uint8] = browserhist_back()
    if cast[uint64](u) == 0:
        return 0
    _set_cur_url(u)
    _fetch(u)
    _reload_layout()
    return 1


def _nav_fwd() -> int32:
    u: Ptr[uint8] = browserhist_fwd()
    if cast[uint64](u) == 0:
        return 0
    _set_cur_url(u)
    _fetch(u)
    _reload_layout()
    return 1


# Build the effective URL for a user-typed address into nav_buf, defaulting a
# scheme: http:// https:// file:// pass through; an absolute path ("/x") or an
# "about:" pseudo-URL passes through (handled by _fetch/demo); anything else is
# treated as a bare host and gets an "http://" prefix.
def _apply_scheme(url: Ptr[uint8]):
    passthru: int32 = 0
    if _starts(url, cast[Ptr[uint8]]("http://")) != 0 or \
       _starts(url, cast[Ptr[uint8]]("https://")) != 0 or \
       _starts(url, cast[Ptr[uint8]]("file://")) != 0 or \
       _starts(url, cast[Ptr[uint8]]("about:")) != 0:
        passthru = 1
    if url[0] == 47:                                 # '/' absolute local path
        passthru = 1
    p: uint64 = 0
    if passthru == 0:
        pre: Ptr[uint8] = cast[Ptr[uint8]]("http://")
        a: uint64 = 0
        while pre[a] != 0 and p < 1023:
            nav_buf[p] = pre[a]
            p = p + 1
            a = a + 1
    i: uint64 = 0
    while url[i] != 0 and p < 1023:
        nav_buf[p] = url[i]
        p = p + 1
        i = i + 1
    nav_buf[p] = 0


# Navigate to a user-typed URL string (address bar Enter / "Go" / --url arg).
def _navigate_url(url: Ptr[uint8]) -> int32:
    if url[0] == 0:
        return 0
    _apply_scheme(url)
    # Ad-block: a navigation to a known ad/tracker host is dropped when the
    # filter is on (resets the per-page blocked counter for the new page first).
    adblock_reset_count()
    if adblock_should_block(&nav_buf[0], cast[int32](_slen(&nav_buf[0]))) != 0:
        return 0
    _set_cur_url(&nav_buf[0])
    _fetch(&nav_buf[0])
    _reload_layout()
    _hist_record()
    return 1


# Reload the current page (refetch + relayout) — the toolbar Reload button.
def _reload_page() -> int32:
    addr_buf[addr_len] = 0
    if addr_len == 0:
        return 0
    return _navigate_url(&addr_buf[0])


# Navigate to the home page — the toolbar Home button.
def _go_home() -> int32:
    return _navigate_url(cast[Ptr[uint8]]("https://www.google.com/"))


# Consume a pending form-submit navigation the engine set (he_dom_submit_index
# GET-serialized the form into he_nav_*). Resolve the target (an absolute URL, a
# root-relative "/search?q=..", a bare "?q=.." to the current path, or a
# document-relative ref) against cur_url into nav_buf, then run the SAME
# fetch+render+history path as an address-bar navigation. Returns 1 if it
# navigated. Clears the request so it can't re-fire on the next poll.
def _navigate_form() -> int32:
    if he_nav_present() == 0:
        return 0
    np: Ptr[uint8] = he_nav_ptr()
    nl: uint64 = he_nav_len()
    # Capture the method + POST body BEFORE he_nav_clear() wipes them. For a GET
    # submit nav_ptr already carries "action?a=1&b=2"; for a POST the nav_ptr is
    # the bare action and the urlencoded body lives in he_nav_body_*.
    is_post: int32 = he_nav_method()
    post_body_len = 0
    if is_post != 0:
        bp: Ptr[uint8] = he_nav_body_ptr()
        bnl: uint64 = he_nav_body_len()
        bi: uint64 = 0
        while bi < bnl and bi < 8191:
            post_body_buf[bi] = bp[bi]
            bi = bi + 1
        post_body_buf[bi] = 0
        post_body_len = bi
    he_nav_clear()
    if nl == 0:
        return 0
    p: uint64 = 0
    if nl >= 7 and np[0] == 104 and np[1] == 116 and np[2] == 116 and \
       np[3] == 112:                                     # "http..." absolute
        k: uint64 = 0
        while k < nl and p < 1023:
            nav_buf[p] = np[k]
            p = p + 1
            k = k + 1
    elif np[0] == 47:                                    # "/path?q=.." root-rel
        alen: uint64 = _authority_len()
        j: uint64 = 0
        while j < alen and p < 1023:
            nav_buf[p] = cur_url[j]
            p = p + 1
            j = j + 1
        k2: uint64 = 0
        while k2 < nl and p < 1023:
            nav_buf[p] = np[k2]
            p = p + 1
            k2 = k2 + 1
    elif np[0] == 63:                                    # "?q=.." current path
        # cur_url up to (excluding) any existing '?' — replace its query.
        clen: uint64 = _slen(&cur_url[0])
        j2: uint64 = 0
        while j2 < clen and cur_url[j2] != 63 and p < 1023:
            nav_buf[p] = cur_url[j2]
            p = p + 1
            j2 = j2 + 1
        k3: uint64 = 0
        while k3 < nl and p < 1023:
            nav_buf[p] = np[k3]
            p = p + 1
            k3 = k3 + 1
    else:                                                # document-relative
        dlen: uint64 = _dir_len()
        j3: uint64 = 0
        while j3 < dlen and p < 1023:
            nav_buf[p] = cur_url[j3]
            p = p + 1
            j3 = j3 + 1
        k4: uint64 = 0
        while k4 < nl and p < 1023:
            nav_buf[p] = np[k4]
            p = p + 1
            k4 = k4 + 1
    nav_buf[p] = 0
    _set_cur_url(&nav_buf[0])
    if is_post != 0:
        _fetch_post(&nav_buf[0], &post_body_buf[0], post_body_len)
    else:
        _fetch(&nav_buf[0])
    _reload_layout()
    _hist_record()
    return 1


# Submit the form enclosing the focused/clicked control at DOM index `el`. Fires
# the engine submit (onsubmit + GET-serialize), then consumes the resulting nav
# request. Returns 1 if a navigation happened.
def _submit_field_form(el: int32) -> int32:
    fi: int32 = he_dom_field_form(el)
    if fi < 0:
        return 0
    if he_dom_submit_index(fi) == 0:
        return 0
    _surface_js()
    if _navigate_form() != 0:
        return 1
    # onsubmit preventDefault'd (SPA-style) — re-render in place.
    _render_doc()
    return 1


# Focus the page field at DOM index `el`: defocus the address bar, seed the edit
# buffer from the field's current value, and remember the element.
def _focus_field(el: int32):
    addr_focus = 0
    field_focus = el
    field_len = cast[uint64](he_dom_get_value(el, &field_buf[0], 1024))
    _field_status()


# Map a window-local click to a link id (or -1) in the PIXEL document via the
# proportional per-segment extents htmlpage recorded (window x maps directly to
# doc x; doc y adds the scroll offset).
def _hit_link(x: int32, y: int32) -> int32:
    # The content viewport ends ABOVE the docked dev-tools panel (browserwin
    # paints the page into `bh - CONTENT_Y - STATUS_H - devtools_h`). Without
    # subtracting it, a click on the Elements/Console panel was still mapped into
    # document space and could fire a link that is nowhere near the pointer.
    if y < CONTENT_Y or y >= bh - STATUS_H - browserwin_devtools_h(bh):
        return -1
    doc_y: int32 = scroll_px + (y - CONTENT_Y)
    return htmlpage_hit_link(x, doc_y)


# ====================================================================
# WINDOW + EVENT plumbing.
# ====================================================================
def _newwindow() -> int32:
    wfd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/ctl"))
    if wfd < 0:
        _writeall(1, cast[Ptr[uint8]]("[hambrowse] cannot open /dev/wsys/ctl for write (no window server in namespace, or permission denied)\n"))
        return -1
    sys_write(wfd, cast[Ptr[uint8]]("newwindow\n"), 10)
    sys_close(wfd)
    rfd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/ctl"))
    if rfd < 0:
        _writeall(1, cast[Ptr[uint8]]("[hambrowse] cannot reopen /dev/wsys/ctl to read back wid\n"))
        return -1
    rbuf: Array[32, uint8]
    r: int64 = sys_read(rfd, &rbuf[0], 31)
    sys_close(rfd)
    if r <= 0:
        _writeall(1, cast[Ptr[uint8]]("[hambrowse] /dev/wsys/ctl returned no wid (newwindow rejected: table full?)\n"))
        return -1
    wid: int32 = 0
    i: uint64 = 0
    while i < cast[uint64](r):
        c: uint8 = rbuf[i]
        if c >= 48 and c <= 57:
            wid = wid * 10 + cast[int32](c) - 48
        i = i + 1
    return wid


def _winpath(out: Ptr[uint8], wid: int32, leaf: Ptr[uint8]):
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/dev/wsys/")
    j: uint64 = 0
    while pre[j] != 0:
        out[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](wid), &out[p])
    k: uint64 = 0
    while leaf[k] != 0:
        out[p] = leaf[k]
        p = p + 1
        k = k + 1
    out[p] = 0


def _ctl_write(ctlp: Ptr[uint8], s: Ptr[uint8]):
    fd: int32 = sys_open_write(cast[Ptr[char]](ctlp))
    if fd >= 0:
        _writeall(fd, s)
        sys_close(fd)


# ---- physical screen geometry (for window-fit) ----------------------------
# /dev/fb exposes a one-line text header "WIDTH HEIGHT PITCH BPP PIXFMT\n"
# (drivers/video/console/fb_text.ad + fb_cdev). The native browser reads it so
# it can size its window to actually FIT the framebuffer: a window laid out at
# a width the compositor then clips at the screen edge would render the page
# content wider than the visible window (heading clipped, right-anchored
# absolute boxes off-screen). Returns 1 on success (out[0]=w, out[1]=h), 0 if
# /dev/fb is absent/unreadable (caller keeps its default geometry).
fbgeom_buf: Array[64, uint8]
# Scratch for the geometry ctl line + the serial geometry diagnostic. Top-level
# BSS (native user stack is a single 4 KiB page — keep sizable buffers off it).
geom_line: Array[64, uint8]
geom_diag: Array[128, uint8]


def _read_screen_dims(out: Ptr[int64]) -> int32:
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/fb"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &fbgeom_buf[0], 63)
    sys_close(fd)
    if n <= 0:
        return 0
    total: uint64 = cast[uint64](n)
    i: uint64 = 0
    k: int32 = 0
    while k < 2:
        while i < total and (fbgeom_buf[i] < 48 or fbgeom_buf[i] > 57):
            i = i + 1
        v: int64 = 0
        d: int32 = 0
        while i < total and fbgeom_buf[i] >= 48 and fbgeom_buf[i] <= 57:
            v = v * 10 + cast[int64](fbgeom_buf[i]) - 48
            i = i + 1
            d = 1
        if d == 0:
            return 0
        out[k] = v
        k = k + 1
    if out[0] <= 0 or out[1] <= 0:
        return 0
    return 1


# ---- /keys decode: arrows + scroll keys -----------------------------
kev_buf: Array[256, uint8]
kev_carry: uint64 = 0
esc_st: int32 = 0


# ---- URL-bar caret/selection primitives (#315) ---------------------------
def _addr_sel_lo() -> uint64:
    if addr_cur < addr_anc:
        return addr_cur
    return addr_anc


def _addr_sel_hi() -> uint64:
    if addr_cur > addr_anc:
        return addr_cur
    return addr_anc


def _addr_sel_active() -> int32:
    if addr_sel != 0 and addr_cur != addr_anc:
        return 1
    return 0


# Delete the live selection (if any); caret collapses to its start. Returns 1
# if bytes were removed.
def _addr_del_sel() -> int32:
    if _addr_sel_active() == 0:
        addr_sel = 0
        return 0
    a: uint64 = _addr_sel_lo()
    b: uint64 = _addr_sel_hi()
    span: uint64 = b - a
    j: uint64 = a
    while j + span < addr_len:
        addr_buf[j] = addr_buf[j + span]
        j = j + 1
    addr_len = addr_len - span
    addr_buf[addr_len] = 0
    addr_cur = a
    addr_anc = a
    addr_sel = 0
    return 1


# Insert one byte at the caret (shifting the tail right).
def _addr_insert(c: uint8):
    if addr_len >= 1023:
        return
    j: uint64 = addr_len
    while j > addr_cur:
        addr_buf[j] = addr_buf[j - 1]
        j = j - 1
    addr_buf[addr_cur] = c
    addr_len = addr_len + 1
    addr_cur = addr_cur + 1
    addr_buf[addr_len] = 0


# Insert n bytes of `src` at the caret (paste), keeping only printable ASCII.
def _addr_paste(src: Ptr[uint8], n: uint64):
    _addr_del_sel()
    i: uint64 = 0
    while i < n:
        c: uint8 = src[i]
        if c >= 32 and c < 127:
            _addr_insert(c)
        i = i + 1


# Apply a decoded CSI final byte to the URL bar: caret nav + Delete. Navigation
# collapses any selection. Returns 1 if state changed.
def _addr_nav(fin: int32) -> int32:
    addr_sel = 0
    if fin == 68:                                    # Left
        if addr_cur > 0:
            addr_cur = addr_cur - 1
    elif fin == 67:                                  # Right
        if addr_cur < addr_len:
            addr_cur = addr_cur + 1
    elif fin == 72 or fin == 65:                     # Home / Up
        addr_cur = 0
    elif fin == 70 or fin == 66:                     # End / Down
        addr_cur = addr_len
    elif fin == 51:                                  # Delete (3~)
        if addr_cur < addr_len:
            j: uint64 = addr_cur
            while j + 1 < addr_len:
                addr_buf[j] = addr_buf[j + 1]
                j = j + 1
            addr_len = addr_len - 1
            addr_buf[addr_len] = 0
        addr_anc = addr_cur
        return 1
    else:
        return 0
    addr_anc = addr_cur
    return 1


# Address-bar key handling (active only while addr_focus != 0). Returns 1 = bar
# changed (redraw), 2 = navigation happened, 0 = nothing. #315: arrow/Home/End/
# Delete navigate; edits happen AT the caret; Ctrl+A/C/V/X select/copy/paste/cut
# on /dev/snarf.
def _addr_key(code: int32) -> int32:
    if addr_esc == 1:                                # after ESC
        if code == 91:                               # '['
            addr_esc = 2
            return 0
        addr_esc = 0                                 # bare ESC -> cancel edit
        addr_focus = 0
        _sync_addr_from_url()
        return 1
    if addr_esc == 2:                                # inside CSI
        if code >= 48 and code <= 57:                # numeric param (e.g. 3~)
            addr_par = code
            return 0
        addr_esc = 0
        fin: int32 = code
        if code == 126:                              # '~' final: map by param
            p: int32 = addr_par
            addr_par = 0
            if p == 51:
                fin = 51
            elif p == 49:
                fin = 72
            elif p == 52:
                fin = 70
            else:
                return 0
        return _addr_nav(fin)
    if code == 27:                                   # ESC -> begin a sequence
        addr_esc = 1
        return 0
    if code == 13 or code == 10:                     # Enter -> navigate
        addr_buf[addr_len] = 0
        addr_focus = 0
        if _navigate_url(&addr_buf[0]) != 0:
            return 2
        _sync_addr_from_url()
        return 1
    if code == 1:                                    # Ctrl-A -> select all
        addr_anc = 0
        addr_cur = addr_len
        if addr_len > 0:
            addr_sel = 1
        else:
            addr_sel = 0
        return 1
    if code == 3:                                    # Ctrl-C -> copy selection
        if _addr_sel_active() != 0:
            htb_clip_put(0, &addr_buf[_addr_sel_lo()],
                         _addr_sel_hi() - _addr_sel_lo())
        return 1
    if code == 22:                                   # Ctrl-V -> paste
        n: uint64 = htb_clip_get(0, &addr_clip[0], 1023)
        if n > 0:
            _addr_paste(&addr_clip[0], n)
        return 1
    if code == 24:                                   # Ctrl-X -> cut selection
        if _addr_sel_active() != 0:
            htb_clip_put(0, &addr_buf[_addr_sel_lo()],
                         _addr_sel_hi() - _addr_sel_lo())
            _addr_del_sel()
        return 1
    if code == 8 or code == 127:                     # Backspace / DEL
        if _addr_sel_active() != 0:
            _addr_del_sel()
            return 1
        if addr_cur > 0:
            j: uint64 = addr_cur - 1
            while j + 1 < addr_len:
                addr_buf[j] = addr_buf[j + 1]
                j = j + 1
            addr_len = addr_len - 1
            addr_cur = addr_cur - 1
            addr_buf[addr_len] = 0
            addr_anc = addr_cur
        return 1
    if code >= 32 and code < 127:                    # printable -> insert
        _addr_del_sel()
        _addr_insert(cast[uint8](code))
        addr_anc = addr_cur
        return 1
    return 0


# ---- SEARCH BOX ------------------------------------------------------
# CSI decode state for the search box (so stray arrow/Home/End escape sequences
# are swallowed instead of inserted as literal "[C" junk). 0 none, 1 ESC, 2 CSI.
search_esc: int32 = 0

# URL-encode one query byte into search_url at offset p; returns the new offset.
# Unreserved (RFC 3986: A-Z a-z 0-9 - _ . ~) pass through, space -> '+', the rest
# percent-encode as %XX — the exact encoding google.com/search?q= expects.
def _searchenc_byte(c: uint8, p: uint64) -> uint64:
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or \
       (c >= 48 and c <= 57) or c == 45 or c == 95 or c == 46 or c == 126:
        if p < 2047:
            search_url[p] = c
            p = p + 1
        return p
    if c == 32:                                      # space -> '+'
        if p < 2047:
            search_url[p] = 43
            p = p + 1
        return p
    hexd: Ptr[uint8] = cast[Ptr[uint8]]("0123456789ABCDEF")
    if p < 2045:
        search_url[p] = 37                           # '%'
        search_url[p + 1] = hexd[(c / 16) & 15]
        search_url[p + 2] = hexd[c & 15]
        p = p + 3
    return p


# Compose https://www.google.com/search?q=<url-encoded query> and navigate to it.
# Returns whatever _navigate_url returns (non-zero = navigation happened).
def _search_navigate() -> int32:
    # Prefix comes from the currently selected search engine (Google / Bing /
    # DuckDuckGo / Brave) so the omnibox search routes to the user's choice.
    e: int32 = se_current()
    pre: Ptr[uint8] = se_prefix_ptr(e)
    plen: int32 = se_prefix_len(e)
    p: uint64 = 0
    while cast[int32](p) < plen and p < 96:
        search_url[p] = pre[p]
        p = p + 1
    i: uint64 = 0
    while i < search_len:
        p = _searchenc_byte(search_buf[i], p)
        i = i + 1
    search_url[p] = 0
    return _navigate_url(&search_url[0])


# Search-box key handling (active only while search_focus != 0). Returns
# 1 = redraw, 2 = navigation happened, 0 = nothing.
def _search_key(code: int32) -> int32:
    if search_esc == 1:
        if code == 91:                               # '[' -> enter CSI
            search_esc = 2
            return 0
        search_esc = 0
        search_focus = 0                             # bare ESC -> blur
        return 1
    if search_esc == 2:                              # swallow one CSI sequence
        if code >= 48 and code <= 57:                # numeric param byte
            return 0
        search_esc = 0
        return 0
    if code == 27:                                   # ESC -> begin sequence
        search_esc = 1
        return 0
    if code == 13 or code == 10:                     # Enter -> Google search
        search_focus = 0
        if search_len == 0:
            return 1
        if _search_navigate() != 0:
            return 2
        return 1
    if code == 8 or code == 127:                     # Backspace / DEL
        if search_len > 0:
            search_len = search_len - 1
            search_buf[search_len] = 0
            search_cur = search_len
        return 1
    if code >= 32 and code < 127:                    # printable -> append
        if search_len < 1023:
            search_buf[search_len] = cast[uint8](code)
            search_len = search_len + 1
            search_buf[search_len] = 0
            search_cur = search_len
        return 1
    return 0


# Reflect the focused field's edit buffer in the status bar (typed-text
# feedback that survives even where the in-box glyphs are hard to read).
def _field_status():
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("typing: ")
    while pre[p] != 0 and p < 159:
        status_buf[p] = pre[p]
        p = p + 1
    i: uint64 = 0
    while i < field_len and p < 159:
        status_buf[p] = field_buf[i]
        p = p + 1
        i = i + 1
    status_buf[p] = 0
    status_len = p


# In-page field key handling (active only while field_focus >= 0). Mirrors the
# address-bar text-entry pattern: printable chars append + backspace deletes,
# each pushing the whole buffer into the DOM value so the field box re-renders;
# Enter submits the enclosing form; ESC blurs. Returns 1 = redraw, 2 = nav.
def _field_key(code: int32) -> int32:
    if code == 27:                                   # ESC -> blur field
        field_focus = -1
        _surface_js()
        return 1
    if code == 13 or code == 10:                     # Enter -> submit form
        el: int32 = field_focus
        field_focus = -1
        if _submit_field_form(el) != 0:
            return 2
        return 1
    if code == 8 or code == 127:                     # Backspace / DEL
        if field_len > 0:
            field_len = field_len - 1
            field_buf[field_len] = 0
            he_dom_set_value_index(field_focus, &field_buf[0], \
                                   cast[int32](field_len))
            _render_doc()
            _field_status()
        return 1
    if code >= 32 and code < 127:                    # printable -> append
        if field_len < 1023:
            field_buf[field_len] = cast[uint8](code)
            field_len = field_len + 1
            field_buf[field_len] = 0
            he_dom_set_value_index(field_focus, &field_buf[0], \
                                   cast[int32](field_len))
            _render_doc()
            _field_status()
        return 1
    return 0


# Returns 1 if the view changed, 2 if a navigation happened (full redraw).
def _handle_code(code: int32) -> int32:
    if search_focus != 0:
        return _search_key(code)
    if addr_focus != 0:
        return _addr_key(code)
    if field_focus >= 0:
        return _field_key(code)
    if esc_st == 1:
        if code == 91:                              # '['
            esc_st = 2
            return 0
        esc_st = 0
    elif esc_st == 2:
        esc_st = 0
        if code == 65:                              # up
            scroll_px = scroll_px - SCROLL_LINE
            _clamp_scroll()
            return 1
        if code == 66:                              # down
            scroll_px = scroll_px + SCROLL_LINE
            _clamp_scroll()
            return 1
        return 0
    if code == 27:
        esc_st = 1
        return 0
    if code == 68:                                  # 'D' -> toggle dev tools
        if devtools_open != 0:
            devtools_open = 0
        else:
            devtools_open = 1
        return 1
    if code == 77:                                  # 'M' -> toggle ⋮ menu
        if menu_open != 0:
            menu_open = 0
        else:
            menu_open = 1
        return 1
    if code == 106:                                 # 'j'
        scroll_px = scroll_px + SCROLL_LINE
        _clamp_scroll()
        return 1
    if code == 107:                                 # 'k'
        scroll_px = scroll_px - SCROLL_LINE
        _clamp_scroll()
        return 1
    if code == 32 or code == 102:                   # space / 'f' page down
        scroll_px = scroll_px + _content_h() - SCROLL_LINE
        _clamp_scroll()
        return 1
    if code == 98:                                  # 'b' page up
        scroll_px = scroll_px - _content_h() + SCROLL_LINE
        _clamp_scroll()
        return 1
    if code == 103:                                 # 'g' top
        scroll_px = 0
        return 1
    if code == 71:                                  # 'G' bottom
        scroll_px = _max_scroll()
        return 1
    return 0


def _drain_keys(n: uint64, vp: Ptr[int32]) -> uint64:
    i: uint64 = 0
    consumed: uint64 = 0
    while i < n:
        t: uint8 = kev_buf[i]
        i = i + 1
        if i < n and kev_buf[i] == 32:
            i = i + 1
        code: int32 = 0
        have: int32 = 0
        neg: int32 = 0
        if i < n and kev_buf[i] == 45:
            neg = 1
            i = i + 1
        while i < n and kev_buf[i] >= 48 and kev_buf[i] <= 57:
            code = code * 10 + cast[int32](kev_buf[i]) - 48
            i = i + 1
            have = 1
        while i < n and kev_buf[i] != 10:
            i = i + 1
        if i >= n:
            return consumed
        i = i + 1
        consumed = i
        if neg != 0:
            code = 0 - code
        if t != 100 or have == 0:                    # only press ('d'=100)
            continue
        rc: int32 = _handle_code(code)
        if rc != 0 and vp[0] < rc:
            vp[0] = rc
    return consumed


# ---- /event poll: resize ('r w h'), wheel + click ('m x y btn dz') --
ev_buf: Array[256, uint8]
ev_carry: uint64 = 0


def _parse_ints(ls: uint64, le: uint64, out: Ptr[int64], maxf: int32) -> int32:
    # parse up to maxf signed ints from ev_buf[ls..le) skipping the leading
    # type token; returns count parsed.
    p: uint64 = ls
    # skip first token (type char) + spaces
    while p < le and ev_buf[p] != 32:
        p = p + 1
    cnt: int32 = 0
    while cnt < maxf:
        while p < le and ev_buf[p] == 32:
            p = p + 1
        if p >= le:
            break
        neg: int32 = 0
        if ev_buf[p] == 45:
            neg = 1
            p = p + 1
        v: int64 = 0
        d: int32 = 0
        while p < le and ev_buf[p] >= 48 and ev_buf[p] <= 57:
            v = v * 10 + cast[int64](ev_buf[p]) - 48
            p = p + 1
            d = 1
        if d == 0:
            break
        if neg != 0:
            v = 0 - v
        out[cnt] = v
        cnt = cnt + 1
    return cnt


def _poll_events(efd: int32, vp: Ptr[int32]) -> int32:
    if efd < 0:
        return 0
    changed: int32 = 0
    passes: int32 = 0
    while passes < 4:
        room: uint64 = 256 - ev_carry
        if room == 0:
            ev_carry = 0
            room = 256
        en: int64 = sys_read_nb(efd, &ev_buf[ev_carry], room)
        if en <= 0:
            break
        total: uint64 = ev_carry + cast[uint64](en)
        i: uint64 = 0
        ls: uint64 = 0
        while i < total:
            if ev_buf[i] == 10:
                if i > ls and ev_buf[ls] == 114:     # 'r' resize
                    f: Array[2, int64]
                    if _parse_ints(ls, i, &f[0], 2) == 2:
                        if f[0] > 80 and f[1] > 80:
                            if cast[int32](f[0]) != bw or cast[int32](f[1]) != bh:
                                bw = cast[int32](f[0])
                                bh = cast[int32](f[1])
                                # Grow the v2 backbuffer if the window enlarged.
                                hamui_set_protocol_v2_dims(bw, bh)
                                he_layout()
                                _render_doc()
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                elif i > ls and ev_buf[ls] == 109:   # 'm' pointer
                    f2: Array[4, int64]
                    nf: int32 = _parse_ints(ls, i, &f2[0], 4)
                    # X11 PRIMARY middle-click paste (#315). Button 2 (bit2) over
                    # the URL band pastes the PRIMARY selection at the caret —
                    # independent of Ctrl+V, which pastes the CLIPBOARD. Edge-
                    # detected on addr_mid so a held/jittering middle button
                    # pastes exactly once per press.
                    mid_now: int32 = 0
                    if nf >= 3 and (f2[2] & 4) != 0:
                        mid_now = 1
                    # SHARED rising-edge detector (uniform with terminal/editor/
                    # Notes): paste PRIMARY once per middle-button press.
                    if nf >= 3 and \
                       htb_mid_edge(f2[2], cast[int64](addr_mid) << 2) != 0:
                        mcx: int32 = cast[int32](f2[0])
                        mcy: int32 = cast[int32](f2[1])
                        if mcy >= ADDR_Y and mcy < ADDR_Y + ADDR_H \
                           and mcx >= NAV_BAR_W and mcx < bw - GO_W:
                            addr_focus = 1
                            field_focus = -1
                            midx: uint64 = browserwin_addr_caret_at(
                                bw, &addr_buf[0], addr_len, addr_cur, mcx)
                            addr_cur = midx
                            addr_anc = midx
                            addr_sel = 0
                            mpn: uint64 = htb_clip_get(1, &addr_clip[0], 1023)
                            if mpn > 0:
                                _addr_paste(&addr_clip[0], mpn)
                            if vp[0] < 1:
                                vp[0] = 1
                            changed = 1
                    addr_mid = mid_now
                    if nf >= 4 and f2[3] != 0:        # wheel dz
                        prev: int32 = scroll_px
                        scroll_px = scroll_px - cast[int32](f2[3]) * SCROLL_LINE
                        _clamp_scroll()
                        if scroll_px != prev:
                            if vp[0] < 1:
                                vp[0] = 1
                            changed = 1
                    elif nf >= 3 and (f2[2] & 1) == 0 and addr_drag != 0:  # RELEASE
                        # End a URL-bar select-drag; auto-copy the highlight to
                        # the PRIMARY selection (middle-click paste). #315.
                        addr_drag = 0
                        if _addr_sel_active() != 0:
                            htb_clip_put(1, &addr_buf[_addr_sel_lo()],
                                         _addr_sel_hi() - _addr_sel_lo())
                    elif nf >= 3 and (f2[2] & 1) != 0:   # button-1 click
                        cx: int32 = cast[int32](f2[0])
                        cy: int32 = cast[int32](f2[1])
                        # ---- application MENU overlay handling (highest prio) ----
                        if menu_open != 0:
                            mid2: int32 = browserwin_menu_item_at(bw, cx, cy)
                            if mid2 >= 0:
                                if mid2 == 6:            # zoom out
                                    if zoom_pct > 25:
                                        zoom_pct = zoom_pct - 10
                                elif mid2 == 8:          # zoom in
                                    if zoom_pct < 300:
                                        zoom_pct = zoom_pct + 10
                                elif mid2 == 7:          # zoom reset
                                    zoom_pct = 100
                                elif mid2 >= 20 and mid2 < 30:   # pick engine
                                    se_set_current(mid2 - 20)
                                    menu_open = 0
                                elif mid2 == 30:         # ad-block toggle
                                    adblock_toggle()
                                elif mid2 == 31:         # dev tools
                                    if devtools_open != 0:
                                        devtools_open = 0
                                    else:
                                        devtools_open = 1
                                    menu_open = 0
                                else:                    # other rows: dismiss
                                    menu_open = 0
                            else:
                                menu_open = 0            # click outside = close
                            if vp[0] < 1:
                                vp[0] = 1
                            changed = 1
                        elif cy < TITLE_H:
                            # ---- TAB STRIP ----
                            # browserwin_tab_hit reports: 0..n-1 = switch to that
                            # tab, -2 = the "+" new-tab button, -10-i = tab i's
                            # close (×) box, -1 = dead space in the strip.
                            th: int32 = browserwin_tab_hit(bw, cx, cy)
                            tdid: int32 = 0
                            if th == 0 - 2:
                                tdid = _tab_new()
                            elif th <= 0 - 10:
                                ntb: int32 = tabs_count()
                                tdid = _tab_close(0 - 10 - th)
                                if tdid == 0 and tabs_count() != ntb:
                                    # A NON-active tab closed: the strip shrank
                                    # even though the live page did not change.
                                    tdid = 1
                            elif th >= 0:
                                tdid = _tab_select(th)
                            if tdid != 0:
                                if vp[0] < 2:
                                    vp[0] = 2
                            elif vp[0] < 1:
                                vp[0] = 1
                            changed = 1
                        elif cy >= ADDR_Y and cy < ADDR_Y + ADDR_H:
                            # Click landed in the toolbar band.
                            nbtn: int32 = browserwin_navbtn_hit(cx, cy)
                            if nbtn >= 0:                # Back/Fwd/Reload/Home
                                did: int32 = 0
                                if nbtn == 0:
                                    did = _nav_back()
                                elif nbtn == 1:
                                    did = _nav_fwd()
                                elif nbtn == 2:
                                    did = _reload_page()
                                else:
                                    did = _go_home()
                                if did != 0:
                                    if vp[0] < 2:
                                        vp[0] = 2
                                changed = 1
                            elif cx >= browserwin_menu_x(bw):   # ⋮ menu button
                                if menu_open != 0:
                                    menu_open = 0
                                else:
                                    menu_open = 1
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            elif cx >= browserwin_adblock_x(bw):  # shield badge
                                adblock_toggle()
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            elif browserwin_search_x0(bw) >= 0 and \
                                 cx >= browserwin_search_x0(bw) and \
                                 cx < browserwin_search_x0(bw) + 24:
                                # Engine CHIP (left of the search pill): cycle the
                                # active search engine (Google->Bing->DDG->Brave).
                                se_cycle()
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            elif browserwin_search_x0(bw) >= 0 and \
                                 cx >= browserwin_search_x0(bw):
                                # SEARCH BOX: click anywhere in it to focus + type.
                                search_focus = 1
                                search_esc = 0
                                addr_focus = 0
                                addr_drag = 0
                                field_focus = -1
                                search_cur = search_len
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            else:                        # click-to-position/drag
                                # #315: map the click x to a caret glyph. First
                                # press focuses + collapses; a held drag extends
                                # the selection (keeping the anchor).
                                search_focus = 0
                                idx: uint64 = browserwin_addr_caret_at(
                                    bw, &addr_buf[0], addr_len, addr_cur, cx)
                                if addr_focus != 0 and addr_drag != 0:
                                    addr_cur = idx
                                    if addr_cur != addr_anc:
                                        addr_sel = 1
                                    else:
                                        addr_sel = 0
                                else:
                                    addr_focus = 1
                                    field_focus = -1     # leave any page field
                                    addr_cur = idx
                                    addr_anc = idx
                                    addr_sel = 0
                                    addr_drag = 1
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                        else:
                            addr_drag = 0
                            if addr_focus != 0:
                                addr_focus = 0           # click away = defocus
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            if search_focus != 0:
                                search_focus = 0         # click away = defocus
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            lid: int32 = _hit_link(cx, cy)
                            hit_field: int32 = 0
                            if lid >= 0:
                                # The engine wraps focusable form controls AND
                                # click-handler elements in a synthetic
                                # "#__evt_N" link (he_set_click_links on).
                                # he_link_evt_index maps the hit link back to the
                                # DOM element; then: a text field FOCUSES (typed
                                # keys route to it), a submit button SUBMITS its
                                # form, a handler element runs its JS onclick, and
                                # a real href navigates.
                                evi: int32 = he_link_evt_index(lid)
                                if evi >= 0 and he_dom_is_textfield(evi) != 0:
                                    hit_field = 1
                                    _focus_field(evi)
                                    if vp[0] < 1:
                                        vp[0] = 1
                                    changed = 1
                                elif evi >= 0 and he_dom_is_submit(evi) != 0:
                                    hit_field = 1
                                    field_focus = -1
                                    if _submit_field_form(evi) != 0:
                                        if vp[0] < 2:
                                            vp[0] = 2
                                        changed = 1
                                elif evi >= 0:
                                    hit_field = 1
                                    if he_dom_click_index(evi) != 0:
                                        _surface_js()
                                        _render_doc()
                                        if vp[0] < 2:
                                            vp[0] = 2
                                        changed = 1
                                elif _navigate(lid) != 0:
                                    if vp[0] < 2:
                                        vp[0] = 2
                                    changed = 1
                            if hit_field == 0 and field_focus >= 0:
                                field_focus = -1         # click away = blur field
                                if vp[0] < 1:
                                    vp[0] = 1
                                changed = 1
                            # NOTE(js-click): the click->element hit test reuses the
                            # existing pointer link hit-test — the engine wraps
                            # handler elements in "#__evt_N" links, so a pointer
                            # click resolves to a DOM record and he_dom_click_index
                            # runs the stored handler in the live JS context, then
                            # re-lays-out. Caveat: this styles clickable elements
                            # like links (blue/underlined). Native JS itself is
                            # still gated by the float-div #DE (task #51), so a
                            # handler doing float division may #DE until that lands.
                ls = i + 1
            i = i + 1
        leftover: uint64 = total - ls
        m: uint64 = 0
        while m < leftover:
            ev_buf[m] = ev_buf[ls + m]
            m = m + 1
        ev_carry = leftover
        passes = passes + 1
    return changed


# ====================================================================
def main(argc: int32, argv: Ptr[uint64]) -> int32:
    sys_bind(cast[Ptr[char]]("/dev"), cast[Ptr[char]]("#c"), 0)

    # Route pointer clicks on JS click-handler elements to their handlers: the
    # engine wraps such elements in synthetic "#__evt_N" links reusing the link
    # hit-test. (Host harness leaves this off so its render stays stable.)
    he_set_click_links(1)

    # Give the page's JS a REAL fetch(): register the http9-backed transport so
    # `fetch(url)` in a <script> makes an actual network request (same /net client
    # as a navigation). Must precede the first he_layout() (scripts run there).
    js_set_fetch_transport(cast[Fn[Ptr[uint8], int32, Ptr[uint8], int32, Ptr[uint8], int32, Ptr[uint8], int32, Ptr[int64], Ptr[int32], Ptr[uint8]]](cast[uint64](_js_fetch_transport)))

    # Resolve the page to load.
    is_demo: int32 = 0
    target: Ptr[uint8] = cast[Ptr[uint8]](0)
    if argc >= 2 and argv != cast[Ptr[uint64]](0):
        a1: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        if _starts(a1, cast[Ptr[uint8]]("--demo")) != 0:
            is_demo = 1
        elif _starts(a1, cast[Ptr[uint8]]("--url")) != 0:
            # `hambrowse --url <URL>` — explicit address (bare host allowed).
            if argc >= 3:
                target = cast[Ptr[uint8]](argv[2])
            else:
                is_demo = 1
        else:
            target = a1
    else:
        is_demo = 1

    # `--click-link N` (test entry): after the page loads, programmatically CLICK
    # link N — the SAME _navigate()/_resolve()/_fetch() path a real pointer click
    # runs — so a navigation gate can drive a link-click over the wire without
    # flaky pointer injection. -1 = no scripted click. Scanned from ANY position
    # so it can trail the URL: `hambrowse <url> --click-link 0`.
    click_link: int32 = -1
    ci: int32 = 1
    while ci < argc:
        ai: Ptr[uint8] = cast[Ptr[uint8]](argv[ci])
        if _starts(ai, cast[Ptr[uint8]]("--click-link")) != 0 and ci + 1 < argc:
            click_link = _arg_atoi(cast[Ptr[uint8]](argv[ci + 1]))
        ci = ci + 1

    # WINDOW-FIRST. Open + map the scene window and paint a minimal "Loading"
    # frame BEFORE the heavy fetch/decode/rasterise. On a low-RAM (~256 MB) DE
    # image the render's fault-in (paint fb + image decode + layout) can trip an
    # OOM; hambrowse used to build the window LAST (after fetch+layout), so any
    # such fault killed the process before ANY window existed — "the web browser
    # doesn't open at all", not even a flash. Creating the window up front means
    # the browser always OPENS (chrome + a Loading page); a later fault degrades
    # the CONTENT, never the existence of the window, and it matches how a real
    # browser shows its chrome immediately.
    #
    # Fonts + the reflow hook are needed to paint anything, so load them first.
    # They are cheap and page-independent (the DE's other scene apps load fonts
    # pre-window too); this is NOT the memory-heavy part.
    browserfonts_load()
    # TRUE reflow: wrap prose to the window in real TrueType advances (not the
    # 8px char grid). Installed after the faces load, before the first layout;
    # every later resize re-lays-out through the same hook.
    htmlpage_install_reflow()

    _writeall(2, cast[Ptr[uint8]]("[hambrowse] opening scene window\n"))
    wid: int32 = _newwindow()
    if wid < 0:
        _writeall(2, cast[Ptr[uint8]]("[hambrowse] FAIL newwindow\n"))
        return 1

    # Publish wid for scripted key/pointer injection.
    widf: int32 = sys_open_write(cast[Ptr[char]]("/tmp/.hambrowse_wid"))
    if widf >= 0:
        wt: Array[24, uint8]
        wl: uint64 = _u64_to_dec(cast[uint64](wid), &wt[0])
        wt[wl] = 10
        sys_write(widf, &wt[0], wl + 1)
        sys_close(widf)

    ctlp: Array[64, uint8]
    keysp: Array[64, uint8]
    evtp: Array[64, uint8]
    _winpath(&ctlp[0], wid, cast[Ptr[uint8]]("/ctl"))
    _winpath(&keysp[0], wid, cast[Ptr[uint8]]("/keys"))
    _winpath(&evtp[0], wid, cast[Ptr[uint8]]("/event"))

    # A wider default window lets the engine's readable-measure default centre
    # the text column (see MEASURE_MAX in lib/htmlengine.ad) instead of stretching
    # body text edge-to-edge — the page reads as a document, not a terminal dump.
    #
    # WINDOW-FIT: the layout engine wraps + centres the page to `bw` (the window
    # CONTENT width). If the requested window would spill past the physical
    # framebuffer, the compositor clips it at the screen edge while the engine
    # still lays out to the full `bw` — so the page renders WIDER than the visible
    # window: the heading is cut off at the right edge and right-anchored absolute
    # boxes land off-screen. Read the real screen size and shrink the window (and
    # therefore `bw`/`bh`) so the whole window fits; the page then lays out to the
    # width actually on screen. On a screen large enough for the 880x600 default
    # this is a no-op. Falls back to the default when /dev/fb is unreadable.
    win_x: int64 = 50
    win_y: int64 = 40
    req_w: int64 = 880
    req_h: int64 = 600
    scr: Array[2, int64]
    scr[0] = 0
    scr[1] = 0
    # Only trust a PLAUSIBLE framebuffer size (>= 640x480). A bogus/partial
    # /dev/fb read must never shrink the window on a real large screen — when in
    # doubt, keep the 880x600 default (which already fits every mainstream mode).
    if _read_screen_dims(&scr[0]) != 0 and scr[0] >= 640 and scr[1] >= 480:
        # Keep a small right/bottom margin so decoration + a fully-visible
        # window fit inside the framebuffer; leave headroom above win_y for the
        # server-side titlebar the DE draws for a decorated window.
        margin: int64 = 12
        if win_x + req_w + margin > scr[0]:
            req_w = scr[0] - win_x - margin
        if win_y + req_h + margin > scr[1]:
            req_h = scr[1] - win_y - margin
        if req_w < 320:
            req_w = 320
        if req_h < 240:
            req_h = 240
    bw = cast[int32](req_w)
    bh = cast[int32](req_h)
    gp: uint64 = _sapp(&geom_line[0], 0, cast[Ptr[uint8]]("geometry "))
    gp = gp + _u64_to_dec(cast[uint64](win_x), &geom_line[gp])
    geom_line[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](win_y), &geom_line[gp])
    geom_line[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](req_w), &geom_line[gp])
    geom_line[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](req_h), &geom_line[gp])
    geom_line[gp] = 10
    gp = gp + 1
    geom_line[gp] = 0
    _ctl_write(&ctlp[0], &geom_line[0])
    _ctl_write(&ctlp[0], cast[Ptr[uint8]]("decorate 1\n"))
    _ctl_write(&ctlp[0], cast[Ptr[uint8]]("z 12\n"))
    _ctl_write(&ctlp[0], cast[Ptr[uint8]]("title Browser\n"))

    # LOUD geometry diagnostic (serial): granted window + screen so a device
    # gate can confirm the page is laid out to the on-screen width.
    dp: uint64 = _sapp(&geom_diag[0], 0, cast[Ptr[uint8]]("[hambrowse] geom bw="))
    dp = dp + _u64_to_dec(cast[uint64](bw), &geom_diag[dp])
    dp = _sapp(&geom_diag[0], dp, cast[Ptr[uint8]](" bh="))
    dp = dp + _u64_to_dec(cast[uint64](bh), &geom_diag[dp])
    dp = _sapp(&geom_diag[0], dp, cast[Ptr[uint8]](" scr="))
    dp = dp + _u64_to_dec(cast[uint64](scr[0]), &geom_diag[dp])
    geom_diag[dp] = 120                                    # 'x'
    dp = dp + 1
    dp = dp + _u64_to_dec(cast[uint64](scr[1]), &geom_diag[dp])
    geom_diag[dp] = 10
    dp = dp + 1
    sys_write(2, &geom_diag[0], dp)

    # Bind the hamui toolkit to our window and negotiate the v2 blit protocol
    # so a kernel-side RGBA backbuffer exists; emit() then blits the pixel page
    # into it and publishes it through the scene-file `buffer` verb (see emit).
    hamui_window_on(0, wid)
    hamui_set_protocol_v2_dims(bw, bh)

    # Paint an immediate LOADING frame (a one-line page) so the window is up and
    # visible before the real fetch/layout runs.
    _set_status(cast[Ptr[uint8]]("Loading..."))
    html_len = 0
    _app(cast[Ptr[uint8]]("<h1>Loading...</h1>"))
    src_ptr = &html_buf[0]
    src_len = html_len
    _reload_layout()
    emit(wid)

    # NOW the heavy work: fetch/parse the requested page (or the demo), decode
    # its images and lay it out — with the window already up. Stdout (fd 1) is
    # rebound to the scene window by `newwindow` above, so the serial
    # diagnostics below go to STDERR (fd 2), which stays on the console
    # (mirrors user/hamview.ad).
    if is_demo != 0:
        _set_cur_url(cast[Ptr[uint8]]("about:demo"))
        _load_demo()
    else:
        _apply_scheme(target)                 # scheme-default a bare host
        _set_cur_url(&nav_buf[0])
        _fetch(&nav_buf[0])
    _reload_layout()
    # Seed the Back/Forward session history with the first page loaded.
    browserhist_reset()
    _hist_record()
    # A page whose <script> calls form.submit() (or a control's) during load has
    # already serialized a pending navigation into he_nav_* — consume it now so an
    # on-load submit navigates for real (GET query or POST body), the same drain
    # the event loop runs after a user submit. This is also the programmatic entry
    # a navigation gate drives without flaky pointer injection.
    _navigate_form()

    # `--click-link N`: fire a scripted link click (real _navigate path) so a gate
    # can prove click-navigation end-to-end over the wire. Runs after the first
    # render + history seed, so Back returns to the start page.
    if click_link >= 0:
        _writeall(2, cast[Ptr[uint8]]("[hambrowse] scripted click-link\n"))
        _navigate(click_link)

    # Compose each diagnostic line into ONE buffer + a SINGLE write so it stays
    # atomic on the shared serial console (see _sapp).
    line: Array[192, uint8]
    lp: uint64 = _sapp(&line[0], 0, cast[Ptr[uint8]]("[hambrowse] rendered segs="))
    lp = lp + _u64_to_dec(n_segs, &line[lp])
    lp = _sapp(&line[0], lp, cast[Ptr[uint8]](" rows="))
    lp = lp + _u64_to_dec(total_rows, &line[lp])
    lp = _sapp(&line[0], lp, cast[Ptr[uint8]](" links="))
    lp = lp + _u64_to_dec(n_links, &line[lp])
    line[lp] = 10
    lp = lp + 1
    sys_write(2, &line[0], lp)

    # Mirror any page-<script> console output (e.g. a fetch() body) to serial.
    _surface_js_serial()

    # LOUD asset-load diagnostics. If the embedded TTF faces or the demo PNG
    # fail to decode, this line makes it VISIBLE in the boot log instead of
    # silently degrading to blank/blocky text + an empty image box (see #79).
    nfaces: int32 = font_ttf_loaded(FACE_TT_SANS) + \
                    font_ttf_loaded(FACE_TT_SANS_BOLD) + \
                    font_ttf_loaded(FACE_TT_SERIF) + \
                    font_ttf_loaded(FACE_TT_MONO)
    lp = _sapp(&line[0], 0, cast[Ptr[uint8]]("[hambrowse] assets: ttf_faces="))
    lp = lp + _u64_to_dec(cast[uint64](nfaces), &line[lp])
    lp = _sapp(&line[0], lp, cast[Ptr[uint8]]("/4 demo_img="))
    lp = lp + _u64_to_dec(cast[uint64](demo_img_decoded), &line[lp])
    lp = _sapp(&line[0], lp, cast[Ptr[uint8]](" images="))
    lp = lp + _u64_to_dec(htmlimg_count(), &line[lp])
    if nfaces < 4 or demo_img_decoded == 0:
        lp = _sapp(&line[0], lp, cast[Ptr[uint8]](" DEGRADED"))
    line[lp] = 10
    lp = lp + 1
    sys_write(2, &line[0], lp)

    # Repaint with the real page now that layout is done.
    emit(wid)

    kfd: int32 = sys_open(cast[Ptr[char]](&keysp[0]))
    efd: int32 = sys_open(cast[Ptr[char]](&evtp[0]))
    if kfd < 0:
        while True:
            sys_yield()
        return 1

    IDLE_MS: int64 = 12
    while True:
        room: uint64 = 256 - kev_carry
        if room == 0:
            kev_carry = 0
            room = 256
        kn: int64 = sys_read_nb(kfd, &kev_buf[kev_carry], room)
        vchg: Array[1, int32]
        vchg[0] = 0
        _poll_events(efd, &vchg[0])
        if kn > 0:
            total: uint64 = kev_carry + cast[uint64](kn)
            done: uint64 = _drain_keys(total, &vchg[0])
            leftover: uint64 = total - done
            m: uint64 = 0
            while m < leftover:
                kev_buf[m] = kev_buf[done + m]
                m = m + 1
            kev_carry = leftover
        if vchg[0] != 0:
            emit(wid)
        else:
            wfds: Array[1, int32]
            wfds[0] = kfd
            sys_waitfds(&wfds[0], 1, IDLE_MS)
    return 0
