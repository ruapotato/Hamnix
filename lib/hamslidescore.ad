def _th_paper() -> Ptr[uint8]:                   # the slide canvas itself
    if theme == 3:
        return cast[Ptr[uint8]]("#fffdfa")
    return cast[Ptr[uint8]]("#ffffff")


def _th_ink() -> Ptr[uint8]:                     # body text
    if theme == 1:
        return cast[Ptr[uint8]]("#33404a")
    if theme == 2:
        return cast[Ptr[uint8]]("#2c4038")
    if theme == 3:
        return cast[Ptr[uint8]]("#4a3728")
    return cast[Ptr[uint8]]("#333a4d")


def _th_titleink() -> Ptr[uint8]:                # slide title text
    if theme == 1:
        return cast[Ptr[uint8]]("#1b2a33")
    if theme == 2:
        return cast[Ptr[uint8]]("#10352a")
    if theme == 3:
        return cast[Ptr[uint8]]("#40210f")
    return cast[Ptr[uint8]]("#1c2340")


def _th_winbg() -> Ptr[uint8]:                   # app window background
    if theme == 1:
        return cast[Ptr[uint8]]("#eceff1")
    if theme == 2:
        return cast[Ptr[uint8]]("#edf4ef")
    if theme == 3:
        return cast[Ptr[uint8]]("#f6efe9")
