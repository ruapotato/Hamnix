def _th_edge() -> Ptr[uint8]:                    # 1px borders
    if theme == 1:
        return cast[Ptr[uint8]]("#9aa6ae")
    if theme == 2:
        return cast[Ptr[uint8]]("#9ab8a8")
    if theme == 3:
        return cast[Ptr[uint8]]("#c8ab92")
    return cast[Ptr[uint8]]("#9aa2c4")


def _th_present_bg() -> Ptr[uint8]:
    if theme == 1:
        return cast[Ptr[uint8]]("#f2f5f7")
    if theme == 2:
        return cast[Ptr[uint8]]("#f2fbf6")
