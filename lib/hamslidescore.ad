def _th_railbg() -> Ptr[uint8]:
    if theme == 1:
        return cast[Ptr[uint8]]("#d5dde2")
    if theme == 2:
        return cast[Ptr[uint8]]("#d7e6dc")
    if theme == 3:
        return cast[Ptr[uint8]]("#ecdccd")
