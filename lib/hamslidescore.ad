# lib/hamslidescore.ad — PURE, extern-free core for HamSlides, the Hamnix office
# PRESENTATION app (/bin/hamslides). The office suite's THIRD app alongside
# HamWrite (word processor) and HamSheet (spreadsheet): a small
# PowerPoint / LibreOffice-Impress that edits and presents a DECK of slides.
#
#   1. a DECK model — an ordered list of slides. Each slide carries a TITLE, an
#      ordered list of BULLETS with an INDENT LEVEL (0..2, multi-level lists),
#      a per-slide LAYOUT and per-slide SPEAKER NOTES. Add / duplicate / delete
#      / MOVE UP / MOVE DOWN, next/prev navigation, in-place text editing and a
#      4-deep UNDO stack over the whole deck,
#   2. five LAYOUTS — Title+Content (default), Title Slide (big centred title +
#      subtitle), Two Column (bullets split across two columns), Picture
#      (bullets left + a picture placeholder right) and Blank. The layout
#      really changes the geometry: render, focus highlight, caret and pointer
#      hit-testing all read the SAME _title_box()/_bul_box() placement
#      functions, so a click always lands where the glyph was drawn,
#   3. four THEMES — Indigo (default), Slate, Emerald and Sunset: a deck-wide
#      colour scheme (deep chrome, accent, tint, paper, ink) applied to the app
#      chrome, the slide canvas, the thumbnails AND the PRESENT view,
#   4. a MENU BAR (File / Edit / Slide / View) with working drop-downs plus a
#      toolbar and a status bar, mirroring HamWrite/HamSheet chrome,
#   5. two VIEWS — EDIT (thumbnail rail, the current slide large, a speaker
#      NOTES strip and a status bar) and PRESENT (full-window themed slide,
#      Space/Right advance, Left/Backspace back, Home/End first/last, 'b'
#      blanks the screen, 'n' overlays the speaker notes, Esc exits) with a
#      slide counter and a progress bar,
#   6. a real DOCUMENT FILE — the HAMSLIDES2 container round-trips EVERYTHING
#      (theme, per-slide layout, titles, bullet text + levels, notes and slide
#      ORDER). HAMSLIDES1 files (title + bullets only) still load.
#
# Like the other dual-target office apps (docs/hamui_dual_target.md) this file
# imports ONLY lib/hamscene (the pure display-list builder) and performs NO
# syscalls: it owns the deck model, the keyboard editing, the menu/toolbar/
# thumbnail hit-testing and BOTH view renders, and it SERIALISES the deck as a
# pure byte string — but the DRIVERS (native user/hamslides.ad + the host
# harness user/hamslides_host.ad) do the open/read/write. That lets the exact
# shipping code path render to a PNG on the dev host and be driven by scripted
# keystrokes deterministically (scripts/test_hamslides_host.sh).

from lib.hamscene import hamscene_begin, hamscene_fill, hamscene_stroke, \
    hamscene_glyphs, hamscene_glyphs_bold, hamscene_line


# ---- deck dimensions -------------------------------------------------------
MAXSLIDES:  uint64 = 16
TITLECAP:   uint64 = 48                   # bytes of title text per slide
MAXBULLETS: uint64 = 8                    # bullets per slide
BULLETCAP:  uint64 = 64                   # bytes per bullet line
NOTESCAP:   uint64 = 128                  # bytes of speaker notes per slide
MAXLEVEL:   uint64 = 2                    # deepest bullet indent level

# Title text (row-major, TITLECAP bytes/slide) + its length.
title_buf: Array[768, uint8]             # MAXSLIDES * TITLECAP
title_len: Array[16, uint8]              # MAXSLIDES

# Bullet text ((slide*MAXBULLETS + b) * BULLETCAP bytes) + per-bullet length +
# per-bullet indent LEVEL + how many bullets each slide currently has.
bullet_buf: Array[8192, uint8]           # MAXSLIDES * MAXBULLETS * BULLETCAP
bullet_len: Array[128, uint8]            # MAXSLIDES * MAXBULLETS
bullet_lvl: Array[128, uint8]            # MAXSLIDES * MAXBULLETS
slide_nbul: Array[16, uint8]             # MAXSLIDES

# Speaker notes (NOTESCAP bytes/slide) + length.
notes_buf: Array[2048, uint8]            # MAXSLIDES * NOTESCAP
notes_len: Array[16, uint8]

# Per-slide layout id (see LAY_* below).
slide_lay: Array[16, uint8]

nslides: uint64 = 1                       # deck length (>= 1 always)
cur:     uint64 = 0                       # current slide index

# Edit focus: 0 = title, 1..nbul = bullet (index focus_row-1), FOCUS_NOTES =
# the speaker-notes strip. caret = byte insertion point within that field.
FOCUS_NOTES: uint64 = 99
focus_row: uint64 = 0
caret:     uint64 = 0

# View: 0 EDIT, 1 PRESENT.
VIEW_EDIT:    int32 = 0
VIEW_PRESENT: int32 = 1
view: int32 = 0

# PRESENT-mode toggles: blank the screen ('b') / overlay speaker notes ('n').
present_black: int32 = 0
present_notes: int32 = 0

# Thumbnail rail scroll (index of first visible thumbnail).
thumb_top: uint64 = 0

dirty: int32 = 0
flash: int32 = 0                          # "saved!" ack countdown

# Action requested by a keystroke/click, drained by the driver:
#   0 none, 1 save, 2 open, 3 quit, 11 Save As..., 12 Open...
pending_action: int32 = 0

# Actions that need the DRIVER to raise the SHARED file dialog (lib/filepick.ad)
# — the core stays extern-free and never touches the picker itself: it only
# names the action and the driver decides. Numbered to match HamWrite/HamSheet
# so the whole office suite speaks one action vocabulary.
ACT_SAVE_AS: int32 = 11
ACT_OPEN:    int32 = 12

# CSI escape decode (arrow/page navigation): 0 ground, 1 saw ESC, 2 saw ESC '['.
hs_esc: int32 = 0
hs_par: int32 = 0

# Open drop-down menu: 0 none, 1 File, 2 Edit, 3 Slide, 4 View.
menu_open: int32 = 0

# Current document filename (display only; the driver owns the real path).
FNAME_CAP: uint64 = 128
fname: Array[128, uint8]
fname_len: uint64 = 0


# ====================================================================
# THEME — a deck-wide colour scheme. Theme 0 (Indigo) is the historical
# HamSlides palette, so an untouched deck renders exactly as before.
# ====================================================================
THEME_COUNT: int32 = 4
theme: int32 = 0


def hamslides_theme() -> int32:
    return theme


def hamslides_theme_count() -> int32:
    return THEME_COUNT


def hamslides_set_theme(t: int32):
    if t < 0:
        return
    if t >= THEME_COUNT:
        return
    theme = t
    dirty = 1


def hamslides_cycle_theme():
    theme = theme + 1
    if theme >= THEME_COUNT:
        theme = 0
    dirty = 1


def hamslides_theme_name() -> Ptr[uint8]:
    return _th_name()


def _th_name() -> Ptr[uint8]:
    if theme == 1:
        return cast[Ptr[uint8]]("Slate")
    if theme == 2:
        return cast[Ptr[uint8]]("Emerald")
    if theme == 3:
        return cast[Ptr[uint8]]("Sunset")
    return cast[Ptr[uint8]]("Indigo")


def _th_deep() -> Ptr[uint8]:                    # app title bar / deep chrome
    if theme == 1:
        return cast[Ptr[uint8]]("#263238")
    if theme == 2:
        return cast[Ptr[uint8]]("#14452f")
    if theme == 3:
        return cast[Ptr[uint8]]("#6b2d12")
    return cast[Ptr[uint8]]("#2b2d5c")


def _th_deep_edge() -> Ptr[uint8]:
    if theme == 1:
        return cast[Ptr[uint8]]("#161e22")
    if theme == 2:
        return cast[Ptr[uint8]]("#0b2e20")
    if theme == 3:
        return cast[Ptr[uint8]]("#4a1d0b")
    return cast[Ptr[uint8]]("#1f2044")


def _th_accent() -> Ptr[uint8]:                  # rules, discs, present band
    if theme == 1:
        return cast[Ptr[uint8]]("#45718f")
    if theme == 2:
        return cast[Ptr[uint8]]("#1f8a5f")
    if theme == 3:
        return cast[Ptr[uint8]]("#c05621")
    return cast[Ptr[uint8]]("#4453b8")


def _th_tint() -> Ptr[uint8]:                    # title band / focus wash
    if theme == 1:
        return cast[Ptr[uint8]]("#eef2f5")
    if theme == 2:
        return cast[Ptr[uint8]]("#eaf7f0")
    if theme == 3:
        return cast[Ptr[uint8]]("#fdf0e6")
    return cast[Ptr[uint8]]("#f2f3fb")


def _th_focus() -> Ptr[uint8]:                   # focused-field highlight
    if theme == 1:
        return cast[Ptr[uint8]]("#e3ecf3")
    if theme == 2:
        return cast[Ptr[uint8]]("#dff3e8")
    if theme == 3:
        return cast[Ptr[uint8]]("#fbe6d5")
