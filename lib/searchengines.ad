# lib/searchengines.ad — the browser's selectable SEARCH ENGINES.
#
# A tiny, pure (no extern/IO) registry the browser chrome + omnibox share: a
# fixed table of engines (Google / Bing / DuckDuckGo / Brave), the currently
# selected one, and the query-prefix each uses. The front-end composes a search
# URL by concatenating the selected engine's prefix with the percent-encoded
# query; the chrome shows a small coloured chip with the engine's initial and
# the application menu lists them with a check on the active one.
#
# PURE: links into both the native browser and the x86_64-linux host harness.

SE_COUNT: int32 = 4

# selected engine index (0 = Google default).
_se_cur: int32 = 0


def se_count() -> int32:
    return SE_COUNT


def se_current() -> int32:
    return _se_cur


def se_set_current(i: int32):
    if i >= 0 and i < SE_COUNT:
        _se_cur = i


# Advance to the next engine (wraps). Returns the new index.
def se_cycle() -> int32:
    _se_cur = (_se_cur + 1) % SE_COUNT
    return _se_cur


# Human name of engine i.
def se_name_ptr(i: int32) -> Ptr[uint8]:
    if i == 0:
        return cast[Ptr[uint8]]("Google")
    if i == 1:
        return cast[Ptr[uint8]]("Bing")
    if i == 2:
        return cast[Ptr[uint8]]("DuckDuckGo")
    if i == 3:
        return cast[Ptr[uint8]]("Brave")
    return cast[Ptr[uint8]]("Google")


def se_name_len(i: int32) -> int32:
    if i == 0:
        return 6
    if i == 1:
        return 4
    if i == 2:
        return 10
    if i == 3:
        return 5
    return 6


# Single-letter chip glyph (uppercase initial).
def se_letter(i: int32) -> Ptr[uint8]:
    if i == 0:
        return cast[Ptr[uint8]]("G")
    if i == 1:
        return cast[Ptr[uint8]]("b")
    if i == 2:
        return cast[Ptr[uint8]]("D")
    if i == 3:
        return cast[Ptr[uint8]]("B")
    return cast[Ptr[uint8]]("G")


# Chip brand colour components (kept as three accessors so the pure module needs
# no packed-colour helper). Google blue, Bing teal, DuckDuckGo orange, Brave.
def se_col_r(i: int32) -> uint8:
    if i == 0:
        return 66
    if i == 1:
        return 0
    if i == 2:
        return 222
    if i == 3:
        return 251
    return 66


def se_col_g(i: int32) -> uint8:
    if i == 0:
        return 133
    if i == 1:
        return 120
    if i == 2:
        return 88
    if i == 3:
        return 84
    return 133


def se_col_b(i: int32) -> uint8:
    if i == 0:
        return 244
    if i == 1:
        return 215
    if i == 2:
        return 51
    if i == 3:
        return 54
    return 244


# The query-URL PREFIX for engine i: concatenate with the percent-encoded query
# to form the full search URL. https everywhere; each ends at the query value.
def se_prefix_ptr(i: int32) -> Ptr[uint8]:
    if i == 0:
        return cast[Ptr[uint8]]("https://www.google.com/search?q=")
    if i == 1:
        return cast[Ptr[uint8]]("https://www.bing.com/search?q=")
    if i == 2:
        return cast[Ptr[uint8]]("https://duckduckgo.com/?q=")
    if i == 3:
        return cast[Ptr[uint8]]("https://search.brave.com/search?q=")
    return cast[Ptr[uint8]]("https://www.google.com/search?q=")


def se_prefix_len(i: int32) -> int32:
    if i == 0:
        return 32
    if i == 1:
        return 30
    if i == 2:
        return 26
    if i == 3:
        return 34
    return 32
