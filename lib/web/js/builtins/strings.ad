# lib/web/js/builtins/strings.ad — part of the modular web engine (extracted from jsengine.ad).
# builtin String and Array prototype methods (call_string_method / call_array_method dispatch).
#
# Behavior-preserving split: Adder is a single-compilation-unit language
# (merge_programs merges all imported files into one Program), so every
# public top-level name here resolves globally across the merged engine.


# ====================================================================
# BUILTIN string / array methods.
# ====================================================================
def call_string_method(sv: int32, name: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    r: int32 = string_method(sv, name, base, argc)
    call_top = base
    return r


def arg_or(base: int32, argc: int32, i: int32) -> int32:
    if i < argc:
        return call_args[base + i]
    return v_undef()


# String.prototype.split's `limit`: ToUint32, so `undefined` and any NEGATIVE
# value mean "no limit" (2^32-1, which no array here can reach) while 0 means an
# EMPTY result. node: "a,b,c".split(",",-1) is ["a","b","c"], split(",",0) is [].
SPLIT_NOLIMIT: int32 = 2147483647


def split_limit(v: int32) -> int32:
    if tag_of(v) == TAG_UNDEF:
        return SPLIT_NOLIMIT
    u: uint32 = to_uint32(v)
    if u > cast[uint32](SPLIT_NOLIMIT):
        return SPLIT_NOLIMIT
    return cast[int32](u)


# ---- position-argument conversions (UTF-16 code units) ----
#
# ECMAScript position arguments are ToIntegerOrInfinity — TRUNCATE toward zero
# FIRST, then clamp. Doing it the other way round is observably different:
# `"hello".slice(-2.5)` is "lo" (trunc -2.5 -> -2, then 5 + -2 = 3), not "o"
# (5 + -2.5 = 2.5 -> 2). Every caller below went through `cast[int32](
# to_number(...))`, which silently produced garbage for NaN/Infinity and never
# clamped at all.

# ToIntegerOrInfinity, clamped into [0, len]. NaN / undefined / -Infinity -> 0,
# +Infinity -> len. This is the `substring` / `startsWith` / `endsWith` /
# `includes` shape: a NEGATIVE argument clamps to 0, it does NOT wrap.
def clamp_pos(v: int32, len: int32) -> int32:
    x: float64 = to_number(v)
    if is_nan(x) != 0:
        return 0
    x = f_trunc(x)
    if x <= 0.0:
        return 0
    if x >= cast[float64](len):
        return len
    return cast[int32](x)


# ToIntegerOrInfinity with RELATIVE (negative-wraps) semantics, clamped into
# [0, len]. This is the `slice` / `at` / `substr` shape.
def rel_pos(v: int32, len: int32) -> int32:
    x: float64 = to_number(v)
    if is_nan(x) != 0:
        return 0
    x = f_trunc(x)
    if x < 0.0:
        x = cast[float64](len) + x
        if x < 0.0:
            return 0
    if x >= cast[float64](len):
        return len
    return cast[int32](x)


def string_method(sv: int32, name: int32, base: int32, argc: int32) -> int32:
    sid: int32 = strid_of(sv)
    # `slen` is the ECMAScript length: UTF-16 CODE UNITS, not stored bytes.
    # Every position argument and every returned index below is in those units;
    # str_sub_u16 does the extraction so a multi-byte sequence is never split.
    slen: int32 = str_u16_len(sid)
    if str_eq_cstr(name, cast[Ptr[uint8]]("charAt")) != 0:
        idx: int32 = 0
        if argc > 0:
            idx = cast[int32](to_number(call_args[base]))
        if idx >= 0 and idx < slen:
            return v_string_id(str_sub_u16(sid, idx, idx + 1))
        return v_string_cstr(cast[Ptr[uint8]](""))
    if str_eq_cstr(name, cast[Ptr[uint8]]("charCodeAt")) != 0:
        idx2: int32 = 0
        if argc > 0:
            idx2 = cast[int32](to_number(call_args[base]))
        cu: int32 = str_u16_at(sid, idx2)
        if cu >= 0:
            return v_number(cast[float64](cu))
        return v_number(0.0 / 0.0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("indexOf")) != 0:
        ifrom: int32 = 0
        if argc > 1:
            ifrom = cast[int32](to_number(call_args[base + 1]))
            if ifrom < 0:
                ifrom = 0
        ibyte: int32 = str_indexof_fromb(sid, strid_of(to_string_val(arg_or(base, argc, 0))), \
                                        str_u16_to_byte(sid, ifrom))
        if ibyte < 0:
            return v_number(-1.0)
        return v_number(cast[float64](str_byte_to_u16(sid, ibyte)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("toUpperCase")) != 0:
        return str_map_case(sid, 1)
    if str_eq_cstr(name, cast[Ptr[uint8]]("toLowerCase")) != 0:
        return str_map_case(sid, 0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("slice")) != 0:
        # slice: RELATIVE indices (negative counts back from the end); an empty
        # or inverted range yields "".
        st: int32 = rel_pos(arg_or(base, argc, 0), slen)
        en: int32 = slen
        if argc > 1 and tag_of(call_args[base + 1]) != TAG_UNDEF:
            en = rel_pos(call_args[base + 1], slen)
        if st > en:
            st = en
        return v_string_id(str_sub_u16(sid, st, en))
    if str_eq_cstr(name, cast[Ptr[uint8]]("substring")) != 0:
        # substring is NOT slice: both arguments clamp into [0, length] (a
        # negative one becomes 0, it does NOT count from the end) and are then
        # SWAPPED when start > end. node: "hello".substring(3,1) === "el",
        # "hello".substring(-2) === "hello".
        ss: int32 = clamp_pos(arg_or(base, argc, 0), slen)
        se: int32 = slen
        if argc > 1 and tag_of(call_args[base + 1]) != TAG_UNDEF:
            se = clamp_pos(call_args[base + 1], slen)
        if ss > se:
            sw: int32 = ss
            ss = se
            se = sw
        return v_string_id(str_sub_u16(sid, ss, se))
    if str_eq_cstr(name, cast[Ptr[uint8]]("split")) != 0:
        sep0: int32 = arg_or(base, argc, 0)
        spl: int32 = split_limit(arg_or(base, argc, 1))
        if is_regex(sep0) != 0:
            return str_regex_split(sid, sep0, spl)
        return str_split(sid, sep0, spl)
    if str_eq_cstr(name, cast[Ptr[uint8]]("match")) != 0:
        return str_regex_match(sid, to_regex(arg_or(base, argc, 0)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("matchAll")) != 0:
        return str_regex_matchall(sid, to_regex(arg_or(base, argc, 0)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("search")) != 0:
        return str_regex_search(sid, to_regex(arg_or(base, argc, 0)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("replace")) != 0:
        pat: int32 = arg_or(base, argc, 0)
        rep: int32 = arg_or(base, argc, 1)
        if is_regex(pat) != 0:
            return str_regex_replace(sid, pat, rep)
        return str_replace_string(sid, pat, rep)
    if str_eq_cstr(name, cast[Ptr[uint8]]("replaceAll")) != 0:
        patA: int32 = arg_or(base, argc, 0)
        repA: int32 = arg_or(base, argc, 1)
        if is_regex(patA) != 0:
            return str_regex_replace(sid, patA, repA)
        return str_replace_all_string(sid, patA, repA)
    if str_eq_cstr(name, cast[Ptr[uint8]]("substr")) != 0:
        st2: int32 = 0
        ln: int32 = slen
        if argc > 0:
            st2 = cast[int32](to_number(call_args[base]))
        if argc > 1:
            ln = cast[int32](to_number(call_args[base + 1]))
        if st2 < 0:
            st2 = slen + st2
            if st2 < 0:
                st2 = 0
        if st2 + ln > slen:
            ln = slen - st2
        if ln < 0:
            ln = 0
        return v_string_id(str_sub_u16(sid, st2, st2 + ln))
    if str_eq_cstr(name, cast[Ptr[uint8]]("trim")) != 0:
        # Whitespace is ASCII here, so trimming BYTES can only ever cut on a
        # sequence boundary — no index conversion needed.
        a: int32 = 0
        b2: int32 = str_len(sid)
        while a < b2 and is_ws(str_char(sid, a)) != 0:
            a = a + 1
        while b2 > a and is_ws(str_char(sid, b2 - 1)) != 0:
            b2 = b2 - 1
        return v_string_bytes(&sp_buf[st_off[sid] + a], b2 - a)
    if str_eq_cstr(name, cast[Ptr[uint8]]("toString")) != 0:
        return sv
    if str_eq_cstr(name, cast[Ptr[uint8]]("lastIndexOf")) != 0:
        lbyte: int32 = str_lastindexof(sid, strid_of(to_string_val(arg_or(base, argc, 0))))
        if lbyte < 0:
            return v_number(-1.0)
        return v_number(cast[float64](str_byte_to_u16(sid, lbyte)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("includes")) != 0:
        # arg1 = START position (code units), clamped into [0, length].
        incp: int32 = clamp_pos(arg_or(base, argc, 1), slen)
        return v_boolv(bool_of(str_indexof_fromb(sid, \
                    strid_of(to_string_val(arg_or(base, argc, 0))), \
                    str_u16_to_byte(sid, incp)) >= 0))
    if str_eq_cstr(name, cast[Ptr[uint8]]("startsWith")) != 0:
        # arg1 = START position: the search string must sit AT that offset.
        swp: int32 = clamp_pos(arg_or(base, argc, 1), slen)
        return v_boolv(str_matches_at(sid, \
                    strid_of(to_string_val(arg_or(base, argc, 0))), \
                    str_u16_to_byte(sid, swp)))
    if str_eq_cstr(name, cast[Ptr[uint8]]("endsWith")) != 0:
        # arg1 is an END position, NOT a start: `"hello".endsWith("hell",4)` is
        # true (node) because the comparison is against the first 4 code units.
        # Default is the whole length.
        ewe: int32 = slen
        if argc > 1 and tag_of(call_args[base + 1]) != TAG_UNDEF:
            ewe = clamp_pos(call_args[base + 1], slen)
        eid: int32 = strid_of(to_string_val(arg_or(base, argc, 0)))
        ebe: int32 = str_u16_to_byte(sid, ewe)
        ebs: int32 = ebe - str_len(eid)
        if ebs < 0:
            return v_boolv(0)
        return v_boolv(str_matches_at(sid, eid, ebs))
    if str_eq_cstr(name, cast[Ptr[uint8]]("at")) != 0:
        ai: int32 = 0
        if argc > 0:
            ai = cast[int32](to_number(call_args[base]))
        if ai < 0:
            ai = slen + ai
        if ai >= 0 and ai < slen:
            return v_string_id(str_sub_u16(sid, ai, ai + 1))
        return v_undef()
    if str_eq_cstr(name, cast[Ptr[uint8]]("codePointAt")) != 0:
        ci: int32 = 0
        if argc > 0:
            ci = cast[int32](to_number(call_args[base]))
        cp: int32 = str_cp_at_u16(sid, ci)
        if cp >= 0:
            return v_number(cast[float64](cp))
        return v_undef()
    if str_eq_cstr(name, cast[Ptr[uint8]]("concat")) != 0:
        save2: int32 = emit_tgt
        emit_tgt = 0
        bld_begin()
        emit_strid(sid)
        ce: int32 = 0
        while ce < argc:
            emit_strid(strid_of(to_string_val(call_args[base + ce])))
            ce = ce + 1
        cid: int32 = bld_end()
        emit_tgt = save2
        return v_string_id(cid)
    if str_eq_cstr(name, cast[Ptr[uint8]]("padStart")) != 0:
        return str_pad(sid, base, argc, 1)
    if str_eq_cstr(name, cast[Ptr[uint8]]("padEnd")) != 0:
        return str_pad(sid, base, argc, 0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("trimStart")) != 0:
        bl3: int32 = str_len(sid)                  # ASCII whitespace: BYTES are safe
        a3: int32 = 0
        while a3 < bl3 and is_ws(str_char(sid, a3)) != 0:
            a3 = a3 + 1
        return v_string_bytes(&sp_buf[st_off[sid] + a3], bl3 - a3)
    if str_eq_cstr(name, cast[Ptr[uint8]]("trimEnd")) != 0:
        b3: int32 = str_len(sid)                   # ASCII whitespace: BYTES are safe
        while b3 > 0 and is_ws(str_char(sid, b3 - 1)) != 0:
            b3 = b3 - 1
        return v_string_bytes(&sp_buf[st_off[sid]], b3)
    if str_eq_cstr(name, cast[Ptr[uint8]]("repeat")) != 0:
        cnt: int32 = cast[int32](to_number(arg_or(base, argc, 0)))
        save: int32 = emit_tgt
        emit_tgt = 0
        bld_begin()
        j: int32 = 0
        while j < cnt:
            emit_strid(sid)
            j = j + 1
        rid: int32 = bld_end()
        emit_tgt = save
        return v_string_id(rid)
    if str_eq_cstr(name, cast[Ptr[uint8]]("normalize")) != 0:
        # ASCII text is already in any normalization form; return as-is.
        return sv
    if str_eq_cstr(name, cast[Ptr[uint8]]("localeCompare")) != 0:
        other: int32 = strid_of(to_string_val(arg_or(base, argc, 0)))
        c: int32 = str_cmp(sid, other)
        return v_number(cast[float64](c))
    set_error(cast[Ptr[uint8]]("TypeError: unknown string method"))
    return v_undef()


# ====================================================================
# URI HANDLING — encodeURI / encodeURIComponent / decodeURI /
# decodeURIComponent / escape / unescape.
#
# These were entirely absent (a bare ReferenceError), which is fatal on any
# page that builds a query string, posts a form or fires an analytics beacon.
#
# Two things make this less code than it looks:
#   * strings are ALREADY stored as UTF-8, so encodeURI's "UTF-8 encode, then
#     %XX each byte" is just "%XX the stored bytes" — no re-encoding at all.
#     The only extra duty is REJECTING a lone surrogate (stored as a WTF-8
#     3-byte sequence in D800-DFFF), which node reports as a URIError.
#   * decode goes the other way: reassemble the %XX bytes, VALIDATE them as
#     UTF-8 (over-long forms, surrogates and >U+10FFFF are all URIError in
#     node), and emit.
#
# escape/unescape are NOT UTF-8: they are the legacy Latin-1/%uXXXX pair and
# operate on UTF-16 CODE UNITS — node `escape("é")` is "%E9" (not "%C3%A9")
# and `escape("\u{1F600}")` is "%uD83D%uDE00" (the surrogate halves).
#
# Every expectation is a measured `node` value; see scripts/test_jsengine_uri_host.sh.
# ====================================================================

# Set while building a URI result: the throw has to wait until bld_end() has
# closed the string builder, so the failure is recorded and raised after.
uri_err: int32 = 0


def uri_hexu(n: int32) -> uint8:
    if n < 10:
        return cast[uint8](48 + n)
    return cast[uint8](55 + n)                 # 'A'..'F' — node emits UPPERCASE


def uri_emit_pct(b: int32):
    emit_c(37)                                 # '%'
    emit_c(uri_hexu((b >> 4) & 15))
    emit_c(uri_hexu(b & 15))


# Hex digit value of one byte, or -1.
def uri_hexval(c: uint8) -> int32:
    if c >= 48 and c <= 57:
        return cast[int32](c) - 48
    if c >= 65 and c <= 70:
        return cast[int32](c) - 55
    if c >= 97 and c <= 102:
        return cast[int32](c) - 87
    return -1


# uriUnescaped = alphanumeric + uriMark ("-_.!~*'()"). Never percent-encoded by
# either encodeURI or encodeURIComponent.
def uri_is_unescaped(c: int32) -> int32:
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
        return 1
    if c == 45 or c == 95 or c == 46 or c == 33 or c == 126 or c == 42 \
       or c == 39 or c == 40 or c == 41:       # - _ . ! ~ * ' ( )
        return 1
    return 0


# uriReserved (";/?:@&=+$,") plus '#'. encodeURI leaves these alone;
# encodeURIComponent escapes them. decodeURI symmetrically REFUSES to decode
# a %XX that would produce one, leaving the escape sequence in place.
def uri_is_reserved(c: int32) -> int32:
    if c == 59 or c == 47 or c == 63 or c == 58 or c == 64 or c == 38 \
       or c == 61 or c == 43 or c == 36 or c == 44 or c == 35:
        return 1
    return 0


def uri_encode(v: int32, set: int32) -> int32:
    sid: int32 = strid_of(to_string_val(v))
    n: int32 = str_len(sid)
    uri_err = 0
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    i: int32 = 0
    while i < n:
        c: int32 = cast[int32](str_char(sid, i))
        if c < 128:
            if uri_is_unescaped(c) != 0 or (set == URI_SET_FULL and uri_is_reserved(c) != 0):
                emit_c(cast[uint8](c))
            else:
                uri_emit_pct(c)
            i = i + 1
            continue
        l: int32 = str_seqlen_at(sid, i)
        cp: int32 = u8_decode(st_off[sid] + i, l)
        if l == 3 and cp >= 55296 and cp <= 57343:
            # a LONE surrogate reached encodeURI: node throws URIError here
            # rather than emitting the (illegal) CESU-8 bytes.
            uri_err = 1
            break
        k: int32 = 0
        while k < l:
            uri_emit_pct(cast[int32](str_char(sid, i + k)))
            k = k + 1
        i = i + l
    rid: int32 = bld_end()
    emit_tgt = save
    if uri_err != 0:
        throw_error(cast[Ptr[uint8]]("URIError"), cast[Ptr[uint8]]("URI malformed"))
        return v_undef()
    return v_string_id(rid)


# Read the two hex digits of a "%XX" whose '%' is at byte `i`; -1 if malformed.
def uri_pct_at(sid: int32, n: int32, i: int32) -> int32:
    if i + 2 >= n:
        return -1
    h: int32 = uri_hexval(str_char(sid, i + 1))
    lo: int32 = uri_hexval(str_char(sid, i + 2))
    if h < 0 or lo < 0:
        return -1
    return (h << 4) | lo


def uri_decode(v: int32, set: int32) -> int32:
    sid: int32 = strid_of(to_string_val(v))
    n: int32 = str_len(sid)
    uri_err = 0
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    i: int32 = 0
    while i < n:
        if str_char(sid, i) != 37:                       # not '%': verbatim byte
            emit_c(str_char(sid, i))
            i = i + 1
            continue
        b0: int32 = uri_pct_at(sid, n, i)
        if b0 < 0:
            uri_err = 1
            break
        if b0 < 128:
            if set == URI_SET_FULL and uri_is_reserved(b0) != 0:
                # decodeURI PRESERVES an escaped reserved character as the
                # escape sequence (node: decodeURI("%2F") === "%2F").
                emit_c(37)
                emit_c(str_char(sid, i + 1))
                emit_c(str_char(sid, i + 2))
            else:
                emit_c(cast[uint8](b0))
            i = i + 3
            continue
        # multi-byte: the lead byte fixes the length, and every continuation
        # byte must ALSO arrive percent-encoded.
        extra: int32 = 0
        cp: int32 = 0
        if b0 >= 240 and b0 <= 247:
            extra = 3
            cp = b0 & 7
        elif b0 >= 224:
            extra = 2
            cp = b0 & 15
        elif b0 >= 192:
            extra = 1
            cp = b0 & 31
        else:
            uri_err = 1                                  # bare continuation byte
            break
        j: int32 = i + 3
        k: int32 = 0
        while k < extra:
            if j >= n or str_char(sid, j) != 37:
                uri_err = 1
                break
            bx: int32 = uri_pct_at(sid, n, j)
            if bx < 128 or bx >= 192:
                uri_err = 1
                break
            cp = (cp << 6) | (bx & 63)
            j = j + 3
            k = k + 1
        if uri_err != 0:
            break
        # over-long forms, surrogates and out-of-range are all URIError in node.
        if extra == 1 and cp < 128:
            uri_err = 1
        if extra == 2 and (cp < 2048 or (cp >= 55296 and cp <= 57343)):
            uri_err = 1
        if extra == 3 and (cp < 65536 or cp > 1114111):
            uri_err = 1
        if uri_err != 0:
            break
        emit_cp_utf8(cp)
        i = j
    rid: int32 = bld_end()
    emit_tgt = save
    if uri_err != 0:
        throw_error(cast[Ptr[uint8]]("URIError"), cast[Ptr[uint8]]("URI malformed"))
        return v_undef()
    return v_string_id(rid)


# escape()'s keep-set: alphanumeric plus "@*_+-./". Note it does NOT match
# encodeURIComponent's — `!()'~` ARE escaped here and are not there.
def uri_esc_keep(c: int32) -> int32:
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
        return 1
    if c == 64 or c == 42 or c == 95 or c == 43 or c == 45 or c == 46 or c == 47:
        return 1
    return 0


def uri_emit_u4(cp: int32):
    emit_c(37)                                 # '%'
    emit_c(117)                                # 'u'
    emit_c(uri_hexu((cp >> 12) & 15))
    emit_c(uri_hexu((cp >> 8) & 15))
    emit_c(uri_hexu((cp >> 4) & 15))
    emit_c(uri_hexu(cp & 15))


def uri_escape(v: int32) -> int32:
    sid: int32 = strid_of(to_string_val(v))
    n: int32 = str_len(sid)
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    i: int32 = 0
    while i < n:
        l: int32 = str_seqlen_at(sid, i)
        cp: int32 = u8_decode(st_off[sid] + i, l)
        if l == 1 and uri_esc_keep(cp) != 0:
            emit_c(cast[uint8](cp))
        elif cp < 256:
            uri_emit_pct(cp)
        elif cp < 65536:
            uri_emit_u4(cp)
        else:
            # astral: escape() sees the SURROGATE PAIR, not the code point.
            hi: int32 = cp - 65536
            uri_emit_u4(55296 + ((hi >> 10) & 1023))
            uri_emit_u4(56320 + (hi & 1023))
        i = i + l
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


# unescape(): %uXXXX and %XX are decoded into CODE UNITS; anything that is not
# a well-formed escape (including a trailing bare '%') passes through unchanged.
# unescape never throws.
def uri_unescape(v: int32) -> int32:
    sid: int32 = strid_of(to_string_val(v))
    n: int32 = str_len(sid)
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    i: int32 = 0
    while i < n:
        if str_char(sid, i) == 37:
            if i + 5 < n and str_char(sid, i + 1) == 117:        # "%uXXXX"
                h3: int32 = uri_hexval(str_char(sid, i + 2))
                h2: int32 = uri_hexval(str_char(sid, i + 3))
                h1: int32 = uri_hexval(str_char(sid, i + 4))
                h0: int32 = uri_hexval(str_char(sid, i + 5))
                if h3 >= 0 and h2 >= 0 and h1 >= 0 and h0 >= 0:
                    emit_cp_utf8((h3 << 12) | (h2 << 8) | (h1 << 4) | h0)
                    i = i + 6
                    continue
            b: int32 = uri_pct_at(sid, n, i)
            if b >= 0:
                emit_cp_utf8(b)                # a CODE UNIT, i.e. Latin-1
                i = i + 3
                continue
        emit_c(str_char(sid, i))
        i = i + 1
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


# The BYTE before the sequence at `i` decodes back to which code point? Walks
# off the continuation bytes. Returns -1 at the start of the string.
def str_cp_before(sid: int32, i: int32) -> int32:
    j: int32 = i - 1
    while j > 0 and (str_char(sid, j) & 192) == 128:
        j = j - 1
    if j < 0:
        return -1
    return u8_decode(st_off[sid] + j, str_seqlen_at(sid, j))


# GREEK FINAL SIGMA: lowercase U+03A3 is U+03C2 at the end of a word and
# U+03C3 elsewhere. node: "ΑΣ" -> "ας" but "ΑΣΒ" -> "ασβ" and lone "Σ" -> "σ".
def sigma_final(sid: int32, i: int32, l: int32) -> int32:
    n: int32 = str_len(sid)
    before: int32 = str_cp_before(sid, i)
    if before < 0 or cp_is_cased(before) == 0:
        return 0                           # nothing cased before: not final
    if i + l >= n:
        return 1
    after: int32 = u8_decode(st_off[sid] + i + l, str_seqlen_at(sid, i + l))
    if cp_is_cased(after) != 0:
        return 0
    return 1


def str_map_case(sid: int32, upper: int32) -> int32:
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    n: int32 = str_len(sid)
    i: int32 = 0
    while i < n:
        c: uint8 = str_char(sid, i)
        if c < 128:
            # ASCII fast path: one byte in, one byte out, no table lookup.
            if upper != 0:
                if c >= 97 and c <= 122:
                    c = c - 32
            else:
                if c >= 65 and c <= 90:
                    c = c + 32
            emit_c(c)
            i = i + 1
            continue
        l: int32 = str_seqlen_at(sid, i)
        cp: int32 = u8_decode(st_off[sid] + i, l)
        m: int32 = case_multi(cp, upper)
        if m > 0:
            k: int32 = 0
            while k < m:
                emit_cp_utf8(cm_out[k])
                k = k + 1
        elif upper != 0:
            emit_cp_utf8(cp_toupper(cp))
        elif cp == 0x03A3:
            if sigma_final(sid, i, l) != 0:
                emit_cp_utf8(0x03C2)
            else:
                emit_cp_utf8(0x03C3)
        else:
            emit_cp_utf8(cp_tolower(cp))
        i = i + l
    id: int32 = bld_end()
    emit_tgt = save
    return v_string_id(id)


def str_indexof(hay: int32, needle: int32) -> int32:
    return str_indexof_fromb(hay, needle, 0)


# BYTE index of `needle` at or after BYTE offset `from` (-1 if absent).
# Callers that expose the result to JS convert it with str_byte_to_u16.
def str_indexof_fromb(hay: int32, needle: int32, fromb: int32) -> int32:
    hn: int32 = str_len(hay)
    nn: int32 = str_len(needle)
    if fromb < 0:
        fromb = 0
    if nn == 0:
        if fromb > hn:
            return hn
        return fromb
    i: int32 = fromb
    while i + nn <= hn:
        j: int32 = 0
        while j < nn and str_char(hay, i + j) == str_char(needle, j):
            j = j + 1
        if j == nn:
            return i
        i = i + 1
    return -1


def bool_of(c: int32) -> int32:
    if c != 0:
        return 1
    return 0


def str_lastindexof(hay: int32, needle: int32) -> int32:
    hn: int32 = str_len(hay)
    nn: int32 = str_len(needle)
    if nn == 0:
        return hn
    i: int32 = hn - nn
    while i >= 0:
        j: int32 = 0
        while j < nn and str_char(hay, i + j) == str_char(needle, j):
            j = j + 1
        if j == nn:
            return i
        i = i - 1
    return -1


# Does `needle` occur in `hay` starting at BYTE offset `off`? Backs both
# startsWith(s,pos) and endsWith(s,endPos) — the only difference between them is
# which byte offset the caller computes.
def str_matches_at(hay: int32, needle: int32, off: int32) -> int32:
    hn: int32 = str_len(hay)
    nn: int32 = str_len(needle)
    if off < 0 or off + nn > hn:
        return 0
    i: int32 = 0
    while i < nn:
        if str_char(hay, off + i) != str_char(needle, i):
            return 0
        i = i + 1
    return 1


def str_startswith(hay: int32, pre: int32) -> int32:
    return str_matches_at(hay, pre, 0)


def str_endswith(hay: int32, suf: int32) -> int32:
    return str_matches_at(hay, suf, str_len(hay) - str_len(suf))


# padStart (at_start=1) / padEnd (at_start=0). arg0 = target length,
# arg1 = pad string (default " ").
def str_pad(sid: int32, base: int32, argc: int32, at_start: int32) -> int32:
    slen: int32 = str_u16_len(sid)     # target length is in UTF-16 code units
    tgt: int32 = 0
    if argc > 0:
        tgt = cast[int32](to_number(call_args[base]))
    if tgt <= slen:
        return v_string_id(sid)
    pad: int32 = -1
    if argc > 1 and tag_of(call_args[base + 1]) != TAG_UNDEF:
        pad = strid_of(to_string_val(call_args[base + 1]))
    pn: int32 = 0
    if pad >= 0:
        pn = str_u16_len(pad)          # the filler repeats by CODE UNIT too
    need: int32 = tgt - slen
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    if at_start == 0:
        emit_strid(sid)
    k: int32 = 0
    while k < need:
        if pn == 0:
            emit_c(32)                 # default space
        else:
            # emit_cp_utf8, not emit_c: the pad string may be multi-byte, and
            # allocating a substring here would bump sp_top INSIDE the builder.
            emit_cp_utf8(str_u16_at(pad, k % pn))
        k = k + 1
    if at_start != 0:
        emit_strid(sid)
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


# plain (non-regex) String.replace / replaceAll. `all` replaces every
# occurrence; repl may be a function or a string ($& / $$ supported). Two-phase
# for the same reason as the regex path (a replacer function builds strings).
def str_replace_plain(sid: int32, patv: int32, replv: int32, all: int32) -> int32:
    pat: int32 = strid_of(to_string_val(patv))
    pn: int32 = str_len(pat)
    is_fn: int32 = is_callable(replv)
    n: int32 = str_len(sid)
    count: int32 = 0
    pos: int32 = 0
    while pos <= n and count < MAX_REP:
        found: int32 = -1
        if pn == 0:
            found = pos
        else:
            i: int32 = pos
            while i + pn <= n:
                j: int32 = 0
                while j < pn and str_char(sid, i + j) == str_char(pat, j):
                    j = j + 1
                if j == pn:
                    found = i
                    break
                i = i + 1
        if found < 0:
            break
        rid0: int32 = 0
        if is_fn != 0:
            rid0 = re_plain_fn_id(sid, replv, found, pn)
        else:
            rid0 = re_plain_str_id(sid, replv, found, pn)
        rep_start[count] = found
        rep_end[count] = found + pn
        rep_id[count] = rid0
        count = count + 1
        if pn == 0:
            pos = found + 1
        else:
            pos = found + pn
        if all == 0:
            break
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    last: int32 = 0
    a: int32 = 0
    while a < count:
        k: int32 = last
        while k < rep_start[a]:
            emit_c(str_char(sid, k))
            k = k + 1
        emit_strid(rep_id[a])
        last = rep_end[a]
        a = a + 1
    tail: int32 = last
    while tail < n:
        emit_c(str_char(sid, tail))
        tail = tail + 1
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


def re_plain_str_id(sid: int32, replv: int32, found: int32, pn: int32) -> int32:
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    rsid: int32 = strid_of(to_string_val(replv))
    ri: int32 = 0
    rl: int32 = str_len(rsid)
    while ri < rl:
        rc: uint8 = str_char(rsid, ri)
        if rc == 36 and ri + 1 < rl:
            dd: uint8 = str_char(rsid, ri + 1)
            if dd == 36:
                emit_c(36)
                ri = ri + 2
                continue
            if dd == 38:
                m: int32 = 0
                while m < pn:
                    emit_c(str_char(sid, found + m))
                    m = m + 1
                ri = ri + 2
                continue
        emit_c(rc)
        ri = ri + 1
    rid: int32 = bld_end()
    emit_tgt = save
    return rid


def re_plain_fn_id(sid: int32, fnv: int32, found: int32, pn: int32) -> int32:
    base: int32 = call_top
    call_args[call_top] = v_string_bytes(&sp_buf[st_off[sid] + found], pn)
    call_top = call_top + 1
    call_args[call_top] = v_number(cast[float64](found))
    call_top = call_top + 1
    call_args[call_top] = v_string_id(sid)
    call_top = call_top + 1
    rvf: int32 = invoke(fnv, v_undef(), base, 3)
    call_top = base
    return strid_of(to_string_val(rvf))


def str_replace_string(sid: int32, patv: int32, replv: int32) -> int32:
    return str_replace_plain(sid, patv, replv, 0)


def str_replace_all_string(sid: int32, patv: int32, replv: int32) -> int32:
    return str_replace_plain(sid, patv, replv, 1)


# `lim` is the already-ToUint32'd second argument (SPLIT_NOLIMIT when absent).
# A limit of 0 yields [] for EVERY separator, including an absent one:
# node `"abc".split(undefined, 0)` is [], not ["abc"].
def str_split(sid: int32, sepv: int32, lim: int32) -> int32:
    v: int32 = v_new_array()
    o: int32 = objid_of(v)
    n: int32 = str_len(sid)
    if lim <= 0:
        return v
    if tag_of(sepv) == TAG_UNDEF:
        arr_push(o, v_string_id(sid))
        return v
    sep: int32 = strid_of(to_string_val(sepv))
    sl: int32 = str_len(sep)
    if sl == 0:
        # split into UTF-16 CODE UNITS (not bytes, and — unlike the string
        # iterator — not code points: `"\u{1d11e}".split("")` is 2 elements).
        i: int32 = 0
        nu: int32 = str_u16_len(sid)
        if nu > lim:
            nu = lim
        while i < nu:
            arr_push(o, v_string_id(str_sub_u16(sid, i, i + 1)))
            i = i + 1
        return v
    cnt: int32 = 0
    start: int32 = 0
    i2: int32 = 0
    while i2 + sl <= n:
        j: int32 = 0
        while j < sl and str_char(sid, i2 + j) == str_char(sep, j):
            j = j + 1
        if j == sl:
            arr_push(o, v_string_bytes(&sp_buf[st_off[sid] + start], i2 - start))
            cnt = cnt + 1
            if cnt >= lim:
                return v
            i2 = i2 + sl
            start = i2
        else:
            i2 = i2 + 1
    arr_push(o, v_string_bytes(&sp_buf[st_off[sid] + start], n - start))
    return v


def emit_frac_padded(fp: uint64, d: int32):
    place: uint64 = 1
    i: int32 = 0
    while i < d - 1:
        place = place * 10
        i = i + 1
    while place > 0:
        emit_c(cast[uint8](48 + cast[int32]((fp / place) % 10)))
        place = place / 10


def num_tofixed(x: float64, d: int32) -> int32:
    if d < 0:
        d = 0
    if d > 20:
        d = 20
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    if is_nan(x) != 0:
        emit_cstr(cast[Ptr[uint8]]("NaN"))
        rid0: int32 = bld_end()
        emit_tgt = save
        return v_string_id(rid0)
    neg: int32 = 0
    if x < 0.0:
        neg = 1
        x = 0.0 - x
    # ES Number.prototype.toFixed step 5: |x| >= 10^21 returns ToString(x), i.e.
    # the exponential form, NOT a fixed-point expansion. Without this the scaled
    # value below overflows the uint64 it is cast through and (1e21).toFixed(2)
    # printed the wrapped 92233720368547758.08.
    if x >= 1.0e21 or is_inf(x) != 0:
        if neg != 0:
            emit_c(45)
        emit_num(x)
        ridb: int32 = bld_end()
        emit_tgt = save
        return v_string_id(ridb)
    # Between 2^53 and 10^21 every double is a whole number, so the fraction is
    # all zeros — and x * 10^d would blow past the uint64 the fixed-point path
    # casts through ((1e20).toFixed(2) wrapped to 92233720368547758.08). Print
    # the integer digits and pad.
    if x >= 9007199254740992.0:
        if neg != 0:
            emit_c(45)
        emit_num(x)
        if d > 0:
            emit_c(46)
            zf: int32 = 0
            while zf < d:
                emit_c(48)
                zf = zf + 1
        ridc: int32 = bld_end()
        emit_tgt = save
        return v_string_id(ridc)
    p10: float64 = 1.0
    i: int32 = 0
    while i < d:
        p10 = p10 * 10.0
        i = i + 1
    scaled: float64 = f_floor(x * p10 + 0.5)
    s64: uint64 = cast[uint64](scaled)
    p64: uint64 = cast[uint64](p10)
    ip: uint64 = s64 / p64
    fp: uint64 = s64 % p64
    if neg != 0:
        emit_c(45)
    emit_u64(ip)
    if d > 0:
        emit_c(46)
        emit_frac_padded(fp, d)
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


def emit_radix(v: uint64, radix: int32):
    if v >= cast[uint64](radix):
        emit_radix(v / cast[uint64](radix), radix)
    dgt: int32 = cast[int32](v % cast[uint64](radix))
    if dgt < 10:
        emit_c(cast[uint8](48 + dgt))
    else:
        emit_c(cast[uint8](97 + dgt - 10))


def num_tostring_radix(x: float64, radix: int32) -> int32:
    if radix == 10 or radix < 2 or radix > 36 or f_trunc(x) != x or is_nan(x) != 0 or is_inf(x) != 0:
        return v_string_id(num_to_strid(x))
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    neg: int32 = 0
    if x < 0.0:
        neg = 1
        x = 0.0 - x
    if neg != 0:
        emit_c(45)
    emit_radix(cast[uint64](f_trunc(x)), radix)
    rid: int32 = bld_end()
    emit_tgt = save
    return v_string_id(rid)


# Number.prototype methods. Returns -2 if unrecognized (fall through to prop).
def try_number_method(nv: int32, name: int32, argnode: int32, env: int32) -> int32:
    x: float64 = v_num[nv]
    if str_eq_cstr(name, cast[Ptr[uint8]]("toFixed")) != 0:
        base: int32 = call_top
        argc: int32 = eval_args_into(argnode, env)
        d: int32 = 0
        if argc > 0:
            d = cast[int32](to_number(call_args[base]))
        call_top = base
        return num_tofixed(x, d)
    if str_eq_cstr(name, cast[Ptr[uint8]]("toString")) != 0:
        base2: int32 = call_top
        argc2: int32 = eval_args_into(argnode, env)
        radix: int32 = 10
        if argc2 > 0:
            radix = cast[int32](to_number(call_args[base2]))
        call_top = base2
        return num_tostring_radix(x, radix)
    if str_eq_cstr(name, cast[Ptr[uint8]]("valueOf")) != 0:
        eval_args_into(argnode, env)
        return nv
    return -2


# BigInt.prototype methods: toString([radix]), valueOf(), toLocaleString().
def try_bigint_method(bv: int32, name: int32, argnode: int32, env: int32) -> int32:
    if str_eq_cstr(name, cast[Ptr[uint8]]("toString")) != 0:
        base: int32 = call_top
        argc: int32 = eval_args_into(argnode, env)
        radix: int32 = 10
        if argc > 0:
            radix = cast[int32](to_number(call_args[base]))
        call_top = base
        if radix < 2 or radix > 36:
            radix = 10
        return v_string_id(bi_to_strid(bigid_of(bv), radix))
    if str_eq_cstr(name, cast[Ptr[uint8]]("toLocaleString")) != 0:
        eval_args_into(argnode, env)
        return v_string_id(bi_to_strid(bigid_of(bv), 10))
    if str_eq_cstr(name, cast[Ptr[uint8]]("valueOf")) != 0:
        eval_args_into(argnode, env)
        return bv
    return -2


def try_array_method(av: int32, name: int32, argnode: int32, env: int32) -> int32:
    # returns -2 if not a recognized array method (fall through to prop)
    o: int32 = objid_of(av)
    if str_eq_cstr(name, cast[Ptr[uint8]]("push")) != 0:
        base: int32 = call_top
        argc: int32 = eval_args_into(argnode, env)
        i: int32 = 0
        while i < argc:
            arr_push(o, call_args[base + i])
            i = i + 1
        call_top = base
        return v_number(cast[float64](arr_len[o]))
    if str_eq_cstr(name, cast[Ptr[uint8]]("pop")) != 0:
        eval_args_into(argnode, env)     # no args, but keep cursor clean
        call_top = call_top
        if arr_len[o] == 0:
            return v_undef()
        r: int32 = arr_get(o, arr_len[o] - 1)
        arr_len[o] = arr_len[o] - 1
        return r
    if str_eq_cstr(name, cast[Ptr[uint8]]("join")) != 0:
        base2: int32 = call_top
        argc2: int32 = eval_args_into(argnode, env)
        sepid: int32 = -1
        if argc2 > 0:
            sepid = strid_of(to_string_val(call_args[base2]))
        call_top = base2
        return array_join(o, sepid)
    if str_eq_cstr(name, cast[Ptr[uint8]]("indexOf")) != 0:
        base3: int32 = call_top
        argc3: int32 = eval_args_into(argnode, env)
        target: int32 = arg_or(base3, argc3, 0)
        idx: int32 = -1
        i2: int32 = 0
        while i2 < arr_len[o]:
            if strict_eq(arr_get(o, i2), target) != 0:
                idx = i2
                break
            i2 = i2 + 1
        call_top = base3
        return v_number(cast[float64](idx))
    if str_eq_cstr(name, cast[Ptr[uint8]]("map")) != 0:
        return array_map(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("forEach")) != 0:
        return array_foreach(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("filter")) != 0:
        return array_filter(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("reduce")) != 0:
        return array_reduce(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("slice")) != 0:
        return array_slice(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("shift")) != 0:
        eval_args_into(argnode, env)
        if arr_len[o] == 0:
            return v_undef()
        r2: int32 = arr_get(o, 0)
        i3: int32 = 1
        while i3 < arr_len[o]:
            arr_set(o, i3 - 1, arr_get(o, i3))
            i3 = i3 + 1
        arr_len[o] = arr_len[o] - 1
        return r2
    if str_eq_cstr(name, cast[Ptr[uint8]]("reverse")) != 0:
        eval_args_into(argnode, env)
        lo: int32 = 0
        hi: int32 = arr_len[o] - 1
        while lo < hi:
            t: int32 = arr_get(o, lo)
            arr_set(o, lo, arr_get(o, hi))
            arr_set(o, hi, t)
            lo = lo + 1
            hi = hi - 1
        return av
    if str_eq_cstr(name, cast[Ptr[uint8]]("lastIndexOf")) != 0:
        baseL: int32 = call_top
        argcL: int32 = eval_args_into(argnode, env)
        tgtL: int32 = arg_or(baseL, argcL, 0)
        idxL: int32 = -1
        iL: int32 = arr_len[o] - 1
        while iL >= 0:
            if strict_eq(arr_get(o, iL), tgtL) != 0:
                idxL = iL
                break
            iL = iL - 1
        call_top = baseL
        return v_number(cast[float64](idxL))
    if str_eq_cstr(name, cast[Ptr[uint8]]("includes")) != 0:
        baseI: int32 = call_top
        argcI: int32 = eval_args_into(argnode, env)
        tgtI: int32 = arg_or(baseI, argcI, 0)
        foundI: int32 = 0
        iI: int32 = 0
        while iI < arr_len[o]:
            if strict_eq(arr_get(o, iI), tgtI) != 0:
                foundI = 1
                break
            iI = iI + 1
        call_top = baseI
        return v_boolv(foundI)
    if str_eq_cstr(name, cast[Ptr[uint8]]("find")) != 0:
        return array_find(o, argnode, env, 0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("findIndex")) != 0:
        return array_find(o, argnode, env, 1)
    if str_eq_cstr(name, cast[Ptr[uint8]]("some")) != 0:
        return array_some_every(o, argnode, env, 0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("every")) != 0:
        return array_some_every(o, argnode, env, 1)
    if str_eq_cstr(name, cast[Ptr[uint8]]("concat")) != 0:
        return array_concat(av, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("reduceRight")) != 0:
        return array_reduce_right(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("sort")) != 0:
        return array_sort(av, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("toReversed")) != 0:
        # ES2023 change-array-by-copy: reversed copy, original untouched
        eval_args_into(argnode, env)
        rv: int32 = v_new_array()
        rvo: int32 = objid_of(rv)
        ir: int32 = arr_len[o] - 1
        while ir >= 0:
            arr_push(rvo, arr_get(o, ir))
            ir = ir - 1
        return rv
    if str_eq_cstr(name, cast[Ptr[uint8]]("toSorted")) != 0:
        cp: int32 = v_new_array()
        cpo: int32 = objid_of(cp)
        ic: int32 = 0
        while ic < arr_len[o]:
            arr_push(cpo, arr_get(o, ic))
            ic = ic + 1
        return array_sort(cp, argnode, env)     # sorts the copy, honors a comparator
    if str_eq_cstr(name, cast[Ptr[uint8]]("with")) != 0:
        baseW: int32 = call_top
        argcW: int32 = eval_args_into(argnode, env)
        idxW: int32 = cast[int32](to_number(arg_or(baseW, argcW, 0)))
        valW: int32 = arg_or(baseW, argcW, 1)
        if idxW < 0:
            idxW = arr_len[o] + idxW
        wv: int32 = v_new_array()
        wvo: int32 = objid_of(wv)
        iw: int32 = 0
        while iw < arr_len[o]:
            if iw == idxW:
                arr_push(wvo, valW)
            else:
                arr_push(wvo, arr_get(o, iw))
            iw = iw + 1
        call_top = baseW
        return wv
    if str_eq_cstr(name, cast[Ptr[uint8]]("flat")) != 0:
        return array_flat(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("fill")) != 0:
        return array_fill(av, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("splice")) != 0:
        return array_splice(av, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("unshift")) != 0:
        baseU: int32 = call_top
        argcU: int32 = eval_args_into(argnode, env)
        # shift existing elements right by argcU, then place new ones at front
        old: int32 = arr_len[o]
        k: int32 = old - 1
        while k >= 0:
            arr_set_ext(o, k + argcU, arr_get(o, k))
            k = k - 1
        j: int32 = 0
        while j < argcU:
            arr_set(o, j, call_args[baseU + j])
            j = j + 1
        arr_len[o] = old + argcU
        call_top = baseU
        return v_number(cast[float64](arr_len[o]))
    if str_eq_cstr(name, cast[Ptr[uint8]]("entries")) != 0:
        eval_args_into(argnode, env)
        res_e: int32 = v_new_array()
        reo: int32 = objid_of(res_e)
        ie: int32 = 0
        while ie < arr_len[o]:
            pr: int32 = v_new_array()
            pro: int32 = objid_of(pr)
            arr_push(pro, v_number(cast[float64](ie)))
            arr_push(pro, arr_get(o, ie))
            arr_push(reo, pr)
            ie = ie + 1
        return res_e
    if str_eq_cstr(name, cast[Ptr[uint8]]("keys")) != 0:
        eval_args_into(argnode, env)
        res_k: int32 = v_new_array()
        rko: int32 = objid_of(res_k)
        ik: int32 = 0
        while ik < arr_len[o]:
            arr_push(rko, v_number(cast[float64](ik)))
            ik = ik + 1
        return res_k
    if str_eq_cstr(name, cast[Ptr[uint8]]("values")) != 0:
        eval_args_into(argnode, env)
        res_v: int32 = v_new_array()
        rvo: int32 = objid_of(res_v)
        iv: int32 = 0
        while iv < arr_len[o]:
            arr_push(rvo, arr_get(o, iv))
            iv = iv + 1
        return res_v
    if str_eq_cstr(name, cast[Ptr[uint8]]("findLast")) != 0:
        return array_find_last(o, argnode, env, 0)
    if str_eq_cstr(name, cast[Ptr[uint8]]("findLastIndex")) != 0:
        return array_find_last(o, argnode, env, 1)
    if str_eq_cstr(name, cast[Ptr[uint8]]("flatMap")) != 0:
        return array_flatmap(o, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("copyWithin")) != 0:
        return array_copy_within(av, argnode, env)
    if str_eq_cstr(name, cast[Ptr[uint8]]("at")) != 0:
        baseAt: int32 = call_top
        argcAt: int32 = eval_args_into(argnode, env)
        rel: int32 = 0
        if argcAt >= 1:
            rel = cast[int32](to_number(call_args[baseAt]))
        call_top = baseAt
        if rel < 0:
            rel = arr_len[o] + rel
        if rel < 0 or rel >= arr_len[o]:
            return v_undef()
        return arr_get(o, rel)
    return -2


def array_find_last(o: int32, argnode: int32, env: int32, want_index: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    res: int32 = v_undef()
    if want_index != 0:
        res = v_number(-1.0)
    # Phase-2 GC: pin `res` across the loop (see array_find). Re-enable GC.
    gsave: int32 = gc_top
    gc_push(res)
    gc_disabled = gc_disabled - 1
    i: int32 = arr_len[o] - 1
    while i >= 0 and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        rv: int32 = invoke(fn, v_undef(), cb, 2)
        call_top = cb
        if to_bool(rv) != 0:
            if want_index != 0:
                res = v_number(cast[float64](i))
            else:
                res = arr_get(o, i)
            break
        i = i - 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsave)
    call_top = base
    return res


# flatMap: map each element, then flatten one level (array results spread in).
def array_flatmap(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    # Phase-2 GC: pin the result-array VALUE cell `res`. (It is also passed as the
    # 3rd callback arg, so it additionally sits under call_top during each invoke,
    # but not during the v_number alloc that precedes the increment — the pin
    # covers that gap.) `rv` is spread with no allocation, so needs no pin.
    gsave: int32 = gc_top
    res: int32 = v_new_array()
    gc_push(res)
    ro: int32 = objid_of(res)
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_args[call_top + 2] = res           # thisArg slot unused; array as 3rd arg
        call_top = call_top + 3
        rv: int32 = invoke(fn, v_undef(), cb, 3)
        call_top = cb
        if is_array(rv) != 0:
            so: int32 = objid_of(rv)
            j: int32 = 0
            while j < arr_len[so]:
                arr_push(ro, arr_get(so, j))
                j = j + 1
        else:
            arr_push(ro, rv)
        i = i + 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsave)
    call_top = base
    return res


# copyWithin(target, start[, end]) — in-place block copy; returns the array.
def array_copy_within(av: int32, argnode: int32, env: int32) -> int32:
    o: int32 = objid_of(av)
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    len: int32 = arr_len[o]
    target: int32 = rel_index(arg_or(base, argc, 0), len, 0)
    start: int32 = rel_index(arg_or(base, argc, 1), len, 0)
    end: int32 = len
    if argc >= 3 and tag_of(call_args[base + 2]) != TAG_UNDEF:
        end = rel_index(call_args[base + 2], len, len)
    call_top = base
    count: int32 = end - start
    if count > len - target:
        count = len - target
    # copy into a scratch buffer first to handle overlap correctly
    if count <= 0:
        return av
    tmp: int32 = v_new_array()
    to: int32 = objid_of(tmp)
    k: int32 = 0
    while k < count:
        arr_push(to, arr_get(o, start + k))
        k = k + 1
    k = 0
    while k < count:
        arr_set(o, target + k, arr_get(to, k))
        k = k + 1
    return av


# Resolve a possibly-negative relative index argument against `len`.
def rel_index(v: int32, len: int32, dflt: int32) -> int32:
    if tag_of(v) == TAG_UNDEF:
        return dflt
    n: int32 = cast[int32](to_number(v))
    if n < 0:
        n = len + n
        if n < 0:
            n = 0
    if n > len:
        n = len
    return n


# arr_set that also grows arr_len to cover idx (used by unshift/splice growth).
def arr_set_ext(o: int32, idx: int32, val: int32):
    if idx >= arr_len[o]:
        arr_len[o] = idx + 1
    arr_set(o, idx, val)


def array_find(o: int32, argnode: int32, env: int32, want_index: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    res: int32 = v_undef()
    if want_index != 0:
        res = v_number(-1.0)
    # Phase-2 GC: for findIndex, `res` starts as v_number(-1.0) — a heap value cell
    # carried across the whole loop's allocations — so pin it. On a match res is
    # reassigned then we break+return with no further alloc (stale pin harmless).
    gsave: int32 = gc_top
    gc_push(res)
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        rv: int32 = invoke(fn, v_undef(), cb, 2)
        call_top = cb
        if to_bool(rv) != 0:
            if want_index != 0:
                res = v_number(cast[float64](i))
            else:
                res = arr_get(o, i)
            break
        i = i + 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsave)
    call_top = base
    return res


def array_some_every(o: int32, argnode: int32, env: int32, is_every: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    result: int32 = is_every            # every starts true(1), some starts false(0)
    # Phase-2 GC: `result` is an int flag, not a value; `fn` is rooted at
    # call_args[base]; elements live in ax_val. Nothing to pin — re-enable GC.
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        rv: int32 = invoke(fn, v_undef(), cb, 2)
        call_top = cb
        tb: int32 = to_bool(rv)
        if is_every != 0 and tb == 0:
            result = 0
            break
        if is_every == 0 and tb != 0:
            result = 1
            break
        i = i + 1
    gc_disabled = gc_disabled + 1
    call_top = base
    return v_boolv(result)


def array_concat(av: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    res: int32 = v_new_array()
    ro: int32 = objid_of(res)
    src: int32 = objid_of(av)
    i: int32 = 0
    while i < arr_len[src]:
        arr_push(ro, arr_get(src, i))
        i = i + 1
    a: int32 = 0
    while a < argc:
        el: int32 = call_args[base + a]
        if is_array(el) != 0:
            eo: int32 = objid_of(el)
            j: int32 = 0
            while j < arr_len[eo]:
                arr_push(ro, arr_get(eo, j))
                j = j + 1
        else:
            arr_push(ro, el)
        a = a + 1
    call_top = base
    return res


def array_reduce_right(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    acc: int32 = v_undef()
    i: int32 = arr_len[o] - 1
    if argc > 1:
        acc = call_args[base + 1]
    else:
        if arr_len[o] > 0:
            acc = arr_get(o, i)
            i = i - 1
    # Phase-2 GC: pin the accumulator across each callback (see array_reduce).
    gc_disabled = gc_disabled - 1
    while i >= 0 and err_flag == 0:
        gsave: int32 = gc_top
        gc_push(acc)
        cb: int32 = call_top
        call_args[call_top] = acc
        call_args[call_top + 1] = arr_get(o, i)
        call_args[call_top + 2] = v_number(cast[float64](i))
        call_top = call_top + 3
        acc = invoke(fn, v_undef(), cb, 3)
        call_top = cb
        gc_popto(gsave)
        i = i - 1
    gc_disabled = gc_disabled + 1
    call_top = base
    return acc


# String-key lexicographic compare of two values as their toString(). -1/0/1.
def cmp_str_vals(a: int32, b: int32) -> int32:
    sa: int32 = strid_of(to_string_val(a))
    sb: int32 = strid_of(to_string_val(b))
    la: int32 = str_len(sa)
    lb: int32 = str_len(sb)
    i: int32 = 0
    while i < la and i < lb:
        ca: uint8 = str_char(sa, i)
        cbc: uint8 = str_char(sb, i)
        if ca < cbc:
            return -1
        if ca > cbc:
            return 1
        i = i + 1
    if la < lb:
        return -1
    if la > lb:
        return 1
    return 0


# In-place stable insertion sort. Default = lexicographic on toString();
# with a comparator fn, use its sign. Returns the array value.
def array_sort(av: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    has_fn: int32 = is_callable(fn)
    o: int32 = objid_of(av)
    n: int32 = arr_len[o]
    # Phase-2 GC: pin the receiver VALUE cell `av` — sort returns it (and for
    # `toSorted` it is a fresh copy held only in the caller's local), so it must
    # survive the comparator invokes. `cur` (below) is the element being inserted,
    # held across the invokes AND across arr_set shifts that may overwrite its
    # original array slot, so pin it per outer iteration. `fn` is rooted at
    # call_args[base]. Re-enable GC.
    gsort: int32 = gc_top
    gc_push(av)
    gc_disabled = gc_disabled - 1
    i: int32 = 1
    while i < n and err_flag == 0:
        cur: int32 = arr_get(o, i)
        gsave: int32 = gc_top
        gc_push(cur)
        j: int32 = i - 1
        while j >= 0:
            c: int32 = 0
            if has_fn != 0:
                cb: int32 = call_top
                call_args[call_top] = arr_get(o, j)
                call_args[call_top + 1] = cur
                call_top = call_top + 2
                rv: int32 = invoke(fn, v_undef(), cb, 2)
                call_top = cb
                d: float64 = to_number(rv)
                if d > 0.0:
                    c = 1
                elif d < 0.0:
                    c = -1
                else:
                    c = 0
            else:
                c = cmp_str_vals(arr_get(o, j), cur)
            if c > 0:
                arr_set(o, j + 1, arr_get(o, j))
                j = j - 1
            else:
                break
        arr_set(o, j + 1, cur)
        gc_popto(gsave)
        i = i + 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsort)
    call_top = base
    return av


def array_flat(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    depth: int32 = 1
    if argc > 0:
        depth = cast[int32](to_number(call_args[base]))
    call_top = base
    res: int32 = v_new_array()
    array_flat_into(o, objid_of(res), depth)
    return res


def array_flat_into(o: int32, ro: int32, depth: int32):
    i: int32 = 0
    while i < arr_len[o]:
        el: int32 = arr_get(o, i)
        if depth > 0 and is_array(el) != 0:
            array_flat_into(objid_of(el), ro, depth - 1)
        else:
            arr_push(ro, el)
        i = i + 1


def array_fill(av: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    o: int32 = objid_of(av)
    val: int32 = arg_or(base, argc, 0)
    n: int32 = arr_len[o]
    st: int32 = 0
    en: int32 = n
    if argc > 1:
        st = cast[int32](to_number(call_args[base + 1]))
    if argc > 2:
        en = cast[int32](to_number(call_args[base + 2]))
    call_top = base
    if st < 0:
        st = n + st
        if st < 0:
            st = 0
    if en < 0:
        en = n + en
    if en > n:
        en = n
    i: int32 = st
    while i < en:
        arr_set(o, i, val)
        i = i + 1
    return av


# Array.prototype.splice(start, deleteCount, ...items). Mutates av; returns an
# array of the removed elements.
def array_splice(av: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    o: int32 = objid_of(av)
    n: int32 = arr_len[o]
    st: int32 = 0
    if argc > 0:
        st = cast[int32](to_number(call_args[base]))
    if st < 0:
        st = n + st
        if st < 0:
            st = 0
    if st > n:
        st = n
    delc: int32 = n - st
    if argc > 1:
        delc = cast[int32](to_number(call_args[base + 1]))
        if delc < 0:
            delc = 0
        if delc > n - st:
            delc = n - st
    n_ins: int32 = argc - 2
    if n_ins < 0:
        n_ins = 0
    # removed slice
    removed: int32 = v_new_array()
    rro: int32 = objid_of(removed)
    r: int32 = 0
    while r < delc:
        arr_push(rro, arr_get(o, st + r))
        r = r + 1
    # build the new tail into a scratch by rebuilding the array in place.
    new_len: int32 = n - delc + n_ins
    diff: int32 = n_ins - delc
    if diff > 0:
        # shift right, from the end
        k: int32 = n - 1
        while k >= st + delc:
            arr_set_ext(o, k + diff, arr_get(o, k))
            k = k - 1
    elif diff < 0:
        # shift left
        k2: int32 = st + delc
        while k2 < n:
            arr_set(o, k2 + diff, arr_get(o, k2))
            k2 = k2 + 1
    # insert new items
    ins: int32 = 0
    while ins < n_ins:
        arr_set(o, st + ins, call_args[base + 2 + ins])
        ins = ins + 1
    arr_len[o] = new_len
    call_top = base
    return removed


def array_join(o: int32, sepid: int32) -> int32:
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    i: int32 = 0
    while i < arr_len[o]:
        if i > 0:
            if sepid >= 0:
                emit_strid(sepid)
            else:
                emit_c(44)             # default ','
        el: int32 = arr_get(o, i)
        if tag_of(el) != TAG_UNDEF and tag_of(el) != TAG_NULL:
            display_val(el)
        i = i + 1
    id: int32 = bld_end()
    emit_tgt = save
    return v_string_id(id)


def array_map(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    # Phase-2 GC: `fn`/`thisArg` sit at call_args[base..] (< call_top for the whole
    # loop → wholesale-rooted); `o`'s elements live in ax_val (rooted). The only
    # unrooted native local held across the callback is the result array VALUE
    # cell `res` — pin it, then re-enable collection so a large map can reclaim.
    gsave: int32 = gc_top
    res: int32 = v_new_array()
    gc_push(res)
    ro: int32 = objid_of(res)
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        rv: int32 = invoke(fn, v_undef(), cb, 2)
        call_top = cb
        arr_push(ro, rv)
        i = i + 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsave)
    call_top = base
    return res


def array_filter(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    # Phase-2 GC: pin the result-array VALUE cell (only unrooted local across the
    # callback); kept elements come from ax_val (rooted). Re-enable collection.
    gsave: int32 = gc_top
    res: int32 = v_new_array()
    gc_push(res)
    ro: int32 = objid_of(res)
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        rv: int32 = invoke(fn, v_undef(), cb, 2)
        call_top = cb
        if to_bool(rv) != 0:
            arr_push(ro, arr_get(o, i))
        i = i + 1
    gc_disabled = gc_disabled + 1
    gc_popto(gsave)
    call_top = base
    return res


def array_reduce(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    acc: int32 = v_undef()
    i: int32 = 0
    if argc > 1:
        acc = call_args[base + 1]
    else:
        if arr_len[o] > 0:
            acc = arr_get(o, 0)
            i = 1
    # Phase-2 GC: the accumulator `acc` is a value handle carried in a native local
    # from one callback to the next — it is NOT in any arena slot while the args are
    # being built (v_number below allocates with acc not yet under call_top), so pin
    # it for each iteration. Re-enable collection for the loop.
    gc_disabled = gc_disabled - 1
    while i < arr_len[o] and err_flag == 0:
        gsave: int32 = gc_top
        gc_push(acc)
        cb: int32 = call_top
        call_args[call_top] = acc
        call_args[call_top + 1] = arr_get(o, i)
        call_args[call_top + 2] = v_number(cast[float64](i))
        call_top = call_top + 3
        acc = invoke(fn, v_undef(), cb, 3)
        call_top = cb
        gc_popto(gsave)
        i = i + 1
    gc_disabled = gc_disabled + 1
    call_top = base
    return acc


def array_foreach(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    fn: int32 = arg_or(base, argc, 0)
    # Phase-2 GC: no accumulator — `fn` is rooted at call_args[base], elements live
    # in ax_val, and nothing else is carried across the callback. Re-enable GC.
    gc_disabled = gc_disabled - 1
    i: int32 = 0
    while i < arr_len[o] and err_flag == 0:
        cb: int32 = call_top
        call_args[call_top] = arr_get(o, i)
        call_args[call_top + 1] = v_number(cast[float64](i))
        call_top = call_top + 2
        invoke(fn, v_undef(), cb, 2)
        call_top = cb
        i = i + 1
    gc_disabled = gc_disabled + 1
    call_top = base
    return v_undef()


def array_slice(o: int32, argnode: int32, env: int32) -> int32:
    base: int32 = call_top
    argc: int32 = eval_args_into(argnode, env)
    st: int32 = 0
    en: int32 = arr_len[o]
    if argc > 0:
        st = cast[int32](to_number(call_args[base]))
    if argc > 1:
        en = cast[int32](to_number(call_args[base + 1]))
    call_top = base
    if st < 0:
        st = arr_len[o] + st
        if st < 0:
            st = 0
    if en < 0:
        en = arr_len[o] + en
    if en > arr_len[o]:
        en = arr_len[o]
    res: int32 = v_new_array()
    ro: int32 = objid_of(res)
    i: int32 = st
    while i < en:
        arr_push(ro, arr_get(o, i))
        i = i + 1
    return res

