# lib/web/js/builtins/unicase.ad — UNICODE case mapping for
# String.prototype.toUpperCase / toLowerCase.
#
# WHY: case mapping was ASCII-ONLY. "café".toUpperCase() was "CAFé",
# "ПРИВЕТ".toLowerCase() came back unchanged and "ß".toUpperCase() was not
# "SS" — wrong on every page not written in English, and wrong in the two
# places case mapping actually gets used on the web: normalising user input
# before comparison, and normalising markup/CSS keywords that arrived with
# non-ASCII text mixed in.
#
# SHAPE. The whole SIMPLE (1:1) mapping compresses to 327 RANGE RULES,
# because Unicode lays case pairs out in exactly two patterns:
#   CM_PAIR  — alternating upper/lower (Latin Extended-A/B, Cyrillic 0460+):
#              an EVEN offset from the rule start is the capital and odd is
#              the small letter, so toUpper is `cp - 1` on odd offsets and
#              toLower is `cp + 1` on even ones.
#   CM_CONST — one constant delta across the range (Latin-1's +-32, Greek's
#              +-32, Cyrillic 0410-044F's +-32, ...).
# Lookup is a binary search over the rule starts, so any character costs ~9
# comparisons; pure-ASCII text never reaches the table at all (there is a byte
# fast path in str_map_case).
#
# The FULL (1:many) mappings do not compress, so they are a flat sorted table
# of 102 uppercase entries (ss -> SS, the fi/fl/ffi ligatures, the polytonic
# Greek iota-subscript expansions, ...) and 1 lowercase entry (U+0130, the
# dotted capital I, -> "i" + U+0307), searched the same way.
#
# COVERAGE, stated exactly:
#   * COMPLETE for ALL of Unicode, U+0080..U+10FFFF, simple AND full, in both
#     directions -- ASTRAL included (Deseret, Osage, Vithkuqi, Old Hungarian,
#     Warang Citi, Medefaidrin, Adlam). Both tables were GENERATED FROM `node`
#     ITSELF: every code point's .toUpperCase()/.toLowerCase() was dumped, the
#     ranges derived from that dump, then replayed code point by code point
#     against it, with a completeness check that nothing cased was left out.
#     node is the oracle, not a spec reading -- an earlier pass generated from
#     Python's unicodedata diverged from node on 10 code points (U+019B,
#     U+0264, U+1C89/8A, U+A7CB..U+A7DC) where node's ICU carries a newer
#     Unicode version, and a first pass at this file left astral out until an
#     exhaustive replay showed node lowercasing U+10400 to U+10428.
#   * Locale-sensitive mappings (Turkish dotless i, Lithuanian retained dot)
#     are deliberately NOT applied: toUpperCase/toLowerCase are locale-
#     INDEPENDENT by spec, which is exactly what this does.
#   * The Greek FINAL SIGMA context rule IS applied: lowercasing U+03A3 gives
#     U+03C2 at the end of a word and U+03C3 otherwise (node: "ΑΣ" -> "ας",
#     "ΑΣΒ" -> "ασβ", lone "Σ" -> "σ").

CM_CONST: int32 = 0
CM_PAIR:  int32 = 1

CM_CAP: int32 = 384
cm_lo:   Array[384, int32]
cm_hi:   Array[384, int32]
cm_kind: Array[384, int32]
cm_du:   Array[384, int32]         # CM_CONST: delta to the UPPERCASE form
cm_dl:   Array[384, int32]         # CM_CONST: delta to the LOWERCASE form
cm_n: int32 = 0

# 1:many tables (uppercase / lowercase), sorted by code point. A 2-character
# expansion stores 0 in the third slot.
MU_CAP: int32 = 128
mu_cp: Array[128, int32]
mu_a:  Array[128, int32]
mu_b:  Array[128, int32]
mu_c:  Array[128, int32]
mu_n: int32 = 0

ml_cp: Array[8, int32]
ml_a:  Array[8, int32]
ml_b:  Array[8, int32]
ml_c:  Array[8, int32]
ml_n: int32 = 0

# Where case_multi leaves its result.
cm_out: Array[4, int32]


def cm_add(lo: int32, hi: int32, kind: int32, du: int32, dl: int32):
    if cm_n >= CM_CAP:
        return
    cm_lo[cm_n] = lo
    cm_hi[cm_n] = hi
    cm_kind[cm_n] = kind
    cm_du[cm_n] = du
    cm_dl[cm_n] = dl
    cm_n = cm_n + 1


def mu_add(cp: int32, a: int32, b: int32, c: int32):
    if mu_n >= MU_CAP:
        return
    mu_cp[mu_n] = cp
    mu_a[mu_n] = a
    mu_b[mu_n] = b
    mu_c[mu_n] = c
    mu_n = mu_n + 1


def ml_add(cp: int32, a: int32, b: int32, c: int32):
    if ml_n >= 8:
        return
    ml_cp[ml_n] = cp
    ml_a[ml_n] = a
    ml_b[ml_n] = b
    ml_c[ml_n] = c
    ml_n = ml_n + 1


# Rule index covering `cp`, or -1. Binary search: the rules are emitted in
# ascending order and never overlap (both properties are asserted by the
# generator that produced the table).
def cm_find(cp: int32) -> int32:
    a: int32 = 0
    b: int32 = cm_n - 1
    while a <= b:
        m: int32 = (a + b) / 2
        if cp < cm_lo[m]:
            b = m - 1
        elif cp > cm_hi[m]:
            a = m + 1
        else:
            return m
    return -1


def mu_find(cp: int32) -> int32:
    a: int32 = 0
    b: int32 = mu_n - 1
    while a <= b:
        m: int32 = (a + b) / 2
        if cp < mu_cp[m]:
            b = m - 1
        elif cp > mu_cp[m]:
            a = m + 1
        else:
            return m
    return -1


def cp_toupper(cp: int32) -> int32:
    if cp < 128:
        if cp >= 97 and cp <= 122:
            return cp - 32
        return cp
    cm_init()
    i: int32 = cm_find(cp)
    if i < 0:
        return cp
    if cm_kind[i] == CM_PAIR:
        if ((cp - cm_lo[i]) & 1) != 0:
            return cp - 1                  # odd offset = the small letter
        return cp
    return cp + cm_du[i]


def cp_tolower(cp: int32) -> int32:
    if cp < 128:
        if cp >= 65 and cp <= 90:
            return cp + 32
        return cp
    cm_init()
    i: int32 = cm_find(cp)
    if i < 0:
        return cp
    if cm_kind[i] == CM_PAIR:
        if ((cp - cm_lo[i]) & 1) == 0:
            return cp + 1                  # even offset = the capital
        return cp
    return cp + cm_dl[i]


# Does `cp` have a case at all? Used for the final-sigma context test. (The
# spec's Cased property also covers a few caseless-but-cased modifier letters;
# the difference is not observable in real text.)
def cp_is_cased(cp: int32) -> int32:
    if cp_toupper(cp) != cp or cp_tolower(cp) != cp:
        return 1
    return 0


# 1:many mapping. Fills cm_out and returns the count, or 0 when `cp` has no
# multi-character mapping in the requested direction.
def case_multi(cp: int32, upper: int32) -> int32:
    if cp < 128:
        return 0
    cm_init()
    if upper == 0:
        i: int32 = 0
        while i < ml_n:
            if ml_cp[i] == cp:
                cm_out[0] = ml_a[i]
                cm_out[1] = ml_b[i]
                cm_out[2] = ml_c[i]
                if ml_c[i] == 0:
                    return 2
                return 3
            i = i + 1
        return 0
    j: int32 = mu_find(cp)
    if j < 0:
        return 0
    cm_out[0] = mu_a[j]
    cm_out[1] = mu_b[j]
    cm_out[2] = mu_c[j]
    if mu_c[j] == 0:
        return 2
    return 3


# ====================================================================
# THE TABLES. GENERATED by dumping every code point's toUpperCase() /
# toLowerCase() from `node` (U+0080..U+10FFFF) and deriving the ranges from
# that dump; each rule is then replayed code point by code point against the
# same dump. Regenerate rather than hand-edit.
# ====================================================================
def cm_init():
    if cm_n != 0:
        return
    cm_add(0x000B5, 0x000B5, CM_CONST, 743, 0)
    cm_add(0x000C0, 0x000D6, CM_CONST, 0, 32)
    cm_add(0x000D8, 0x000DE, CM_CONST, 0, 32)
    cm_add(0x000E0, 0x000F6, CM_CONST, -32, 0)
