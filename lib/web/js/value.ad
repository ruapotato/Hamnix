# lib/web/js/value.ad — part of the modular web engine (extracted from jsengine.ad).
# string pool, JS value constructors/accessors, objects (props/array), environments (scope chain), and the catchable runtime-exception mechanism.
#
# Behavior-preserving split: Adder is a single-compilation-unit language
# (merge_programs merges all imported files into one Program), so every
# public top-level name here resolves globally across the merged engine.

# ====================================================================
# STRING pool.
# ====================================================================
# Allocate a string id — pop the Phase-4 free list before bumping the id table.
# Returns -1 when the table is genuinely full (no free id AND n_strs == MAX_STR).
# In a DEFAULT run the free list is always empty (a collection never fired), so
# this bumps n_strs exactly as the old code did — byte-for-byte identical.
def str_alloc_id() -> int32:
    if str_free_head >= 0:
        f: int32 = str_free_head
        str_free_head = st_off[f]          # st_off is repurposed as the free link
        return f
    if n_strs >= MAX_STR:
        return -1
    id: int32 = n_strs
    n_strs = n_strs + 1
    return id


def str_new(p: Ptr[uint8], n: int32) -> int32:
    # Phase-4 GC trigger: when the id table nears its cap and no free id is
    # waiting, reclaim dead string ids. NON-MOVING, so the source `p` (which may
    # point INTO sp_buf for `&sp_buf[st_off[sid]+j]` callers) stays valid across
    # the collection. gc_disabled gates it OFF inside un-audited builtins (same
    # discipline as mk_val). Default str_hi_water is 80% of MAX_STR, so a program
    # that fit the id table before never reaches here and stays byte-identical.
    if str_free_head < 0 and gc_disabled == 0 and n_strs >= str_hi_water:
        gc_collect_strings()
    # Guard the string pool BYTES: bytes are never reclaimed (non-moving), so a
    # copy that would overflow sp_buf still fails cleanly (catchable empty-string
    # id) rather than writing past sp_buf into adjacent BSS.
    if sp_top + n >= SP_CAP:
        if sp_exhaust_noted == 0:
            sp_exhaust_noted = 1
            js_out_note(cast[Ptr[uint8]]("[engine] CEILING string pool exhausted (sp_buf bytes). SP_CAP="), SP_CAP)
        set_error(cast[Ptr[uint8]]("string pool exhausted"))
        eid: int32 = str_alloc_id()
        if eid >= 0:
            st_off[eid] = sp_top
            st_len[eid] = 0
            st_asc[eid] = 1
            return eid
        return MAX_STR - 1
    off: int32 = sp_top
    i: int32 = 0
    hi: int32 = 0                      # any byte >= 0x80? (classify while copying)
    while i < n:
        if p[i] >= 128:
            hi = 1
        sp_buf[sp_top] = p[i]
        sp_top = sp_top + 1
        i = i + 1
    id: int32 = str_alloc_id()
    # Guard the id table: a full table (even after a collection) fails cleanly.
    if id < 0:
        if sp_exhaust_noted == 0:
            sp_exhaust_noted = 1
            js_out_note(cast[Ptr[uint8]]("[engine] CEILING string pool exhausted (MAX_STR ids, after a collection). MAX_STR="), MAX_STR)
        set_error(cast[Ptr[uint8]]("string pool exhausted"))
        return MAX_STR - 1
    st_off[id] = off
    st_len[id] = n
    st_asc[id] = cast[uint8](1 + hi)   # 1 = ASCII, 2 = has multi-byte sequences
    return id


def str_len(id: int32) -> int32:
    return st_len[id]


def str_ptr(id: int32) -> Ptr[uint8]:
    return &sp_buf[st_off[id]]


def str_char(id: int32, i: int32) -> uint8:
    return sp_buf[st_off[id] + i]


# ====================================================================
# UTF-16 INDEX LAYER.
# ====================================================================
# Strings are STORED as UTF-8 bytes (st_len = bytes), but every ECMAScript
# string operation is defined over UTF-16 CODE UNITS: "©".length is 1, not 2,
# and "café".slice(3,4) is "é", not the first byte of its two-byte sequence.
# Indexing UTF-8 bytes as if they were code units does not merely miscount —
# it SPLITS multi-byte sequences and produces invalid strings that propagate.
#
# Storage is deliberately unchanged (a UTF-16 rewrite would touch ~400 call
# sites and every DOM/render consumer). Instead this layer converts indices at
# the ECMAScript boundary, with a per-id ASCII flag so the overwhelmingly
# common all-ASCII string keeps byte index == code-unit index and costs one
# cached byte read.
#
# Astral (non-BMP) code points are TWO UTF-16 code units. Slicing one in half
# yields a LONE SURROGATE, which has no UTF-8 encoding; we store it in WTF-8
# (the surrogate encoded as a plain 3-byte sequence), so that
# `s.slice(0,1) + s.slice(1)` still round-trips byte-for-byte.

# Lazily classify a string as pure-ASCII (fast path) or not.
def str_is_ascii(id: int32) -> int32:
    f: int32 = cast[int32](st_asc[id])
    if f == 0:
        n: int32 = st_len[id]
        o: int32 = st_off[id]
        i: int32 = 0
        f = 1
        while i < n:
            if sp_buf[o + i] >= 128:
                f = 2
                i = n
            else:
                i = i + 1
        st_asc[id] = cast[uint8](f)
    if f == 1:
        return 1
    return 0


# Byte length of the UTF-8 sequence a lead byte starts. An invalid/continuation
# byte counts as 1 so a malformed string still advances and terminates.
def u8_seqlen(b: uint8) -> int32:
    if b < 128:
        return 1
    if b >= 240:
        return 4
    if b >= 224:
        return 3
    if b >= 192:
        return 2
    return 1


# Decode the code point starting at byte offset `o` (already bounds-checked by
# the caller via u8_seqlen clamping). A malformed lead byte decodes to itself.
def u8_decode(o: int32, len: int32) -> int32:
    b0: int32 = cast[int32](sp_buf[o])
    if len == 1:
        return b0
    if len == 2:
        return ((b0 & 31) << 6) | (cast[int32](sp_buf[o + 1]) & 63)
    if len == 3:
        return ((b0 & 15) << 12) | ((cast[int32](sp_buf[o + 1]) & 63) << 6) \
               | (cast[int32](sp_buf[o + 2]) & 63)
    return ((b0 & 7) << 18) | ((cast[int32](sp_buf[o + 1]) & 63) << 12) \
           | ((cast[int32](sp_buf[o + 2]) & 63) << 6) | (cast[int32](sp_buf[o + 3]) & 63)


# Sequence length at byte `i`, clamped so it never runs past the string end.
def str_seqlen_at(id: int32, i: int32) -> int32:
    n: int32 = st_len[id]
    l: int32 = u8_seqlen(sp_buf[st_off[id] + i])
    if i + l > n:
        return 1
    return l


# ---- length ----
def str_u16_len(id: int32) -> int32:
    if st_asc[id] == 1:                # inlined fast path (avoid the call)
        return st_len[id]
    if str_is_ascii(id) != 0:
        return st_len[id]
    n: int32 = st_len[id]
    o: int32 = st_off[id]
    i: int32 = 0
    u: int32 = 0
    while i < n:
        l: int32 = u8_seqlen(sp_buf[o + i])
        if i + l > n:
            l = 1
        if l == 4:
            u = u + 2                  # astral: surrogate PAIR
        else:
            u = u + 1
        i = i + l
    return u


# ---- index conversion ----
# Set by str_u16_to_byte: 1 when the requested code unit is the TRAILING
# surrogate of a pair (i.e. the returned byte offset is the START of a 4-byte
# sequence whose SECOND half was asked for), else 0.
u16_half: int32 = 0

# UTF-16 code-unit index -> byte offset. `u` past the end returns st_len.
def str_u16_to_byte(id: int32, u: int32) -> int32:
    u16_half = 0
    if str_is_ascii(id) != 0:          # (cached after the first query)
        n0: int32 = st_len[id]
        if u > n0:
            return n0
        return u
    n: int32 = st_len[id]
    o: int32 = st_off[id]
    i: int32 = 0
    c: int32 = 0
    while i < n:
        if c == u:
            return i
        l: int32 = u8_seqlen(sp_buf[o + i])
        if i + l > n:
            l = 1
        if l == 4:
            if c + 1 == u:
                u16_half = 1
                return i
            c = c + 2
        else:
            c = c + 1
        i = i + l
    return n


# byte offset -> UTF-16 code-unit index (offsets landing mid-sequence round
# DOWN to the unit that sequence starts at).
def str_byte_to_u16(id: int32, b: int32) -> int32:
    if str_is_ascii(id) != 0:
        return b
    n: int32 = st_len[id]
    o: int32 = st_off[id]
    i: int32 = 0
    c: int32 = 0
    while i < n and i < b:
        l: int32 = u8_seqlen(sp_buf[o + i])
        if i + l > n:
            l = 1
        if l == 4:
            c = c + 2
        else:
            c = c + 1
        i = i + l
    return c


# ---- code units / code points ----
# The UTF-16 code unit at index `u`, or -1 when out of range.
def str_u16_at(id: int32, u: int32) -> int32:
    if u < 0:
        return -1
    if st_asc[id] == 1:                # inlined fast path (avoid the call)
        if u >= st_len[id]:
            return -1
        return cast[int32](sp_buf[st_off[id] + u])
    if str_is_ascii(id) != 0:
        if u >= st_len[id]:
            return -1
        return cast[int32](sp_buf[st_off[id] + u])
    b: int32 = str_u16_to_byte(id, u)
    if b >= st_len[id]:
        return -1
    half: int32 = u16_half
    l: int32 = str_seqlen_at(id, b)
    cp: int32 = u8_decode(st_off[id] + b, l)
    if l == 4:
        cp = cp - 65536
        if half != 0:
            return 56320 + (cp & 1023)         # 0xDC00 + low 10 bits
        return 55296 + ((cp >> 10) & 1023)     # 0xD800 + high 10 bits
    return cp


# The full code point whose FIRST code unit is at index `u` (String.prototype.
# codePointAt semantics), or -1 when out of range. Asking for the trailing half
# of a pair yields that lone surrogate, exactly as codePointAt does.
def str_cp_at_u16(id: int32, u: int32) -> int32:
    if u < 0:
        return -1
    if str_is_ascii(id) != 0:
        if u >= st_len[id]:
            return -1
        return cast[int32](sp_buf[st_off[id] + u])
    b: int32 = str_u16_to_byte(id, u)
    if b >= st_len[id]:
        return -1
    half: int32 = u16_half
    l: int32 = str_seqlen_at(id, b)
    cp: int32 = u8_decode(st_off[id] + b, l)
    if l == 4 and half != 0:
        return 56320 + ((cp - 65536) & 1023)
    return cp


# ---- emission ----
# Encode a code point as UTF-8. Surrogates (0xD800-0xDFFF) are encoded as
# 3-byte sequences (WTF-8) so a half-sliced astral character round-trips.
def emit_cp_utf8(cp: int32):
    if cp < 0:
        return
    if cp < 128:
        emit_c(cast[uint8](cp))
        return
    if cp < 2048:
        emit_c(cast[uint8](192 | (cp >> 6)))
        emit_c(cast[uint8](128 | (cp & 63)))
        return
    if cp >= 56320 and cp <= 57343:
        # trailing surrogate: fold it back into a preceding lead half if there
        # is one (see bld_join_trail).
        if bld_join_trail(cp) != 0:
            return
    if cp < 65536:
        emit_c(cast[uint8](224 | (cp >> 12)))
        emit_c(cast[uint8](128 | ((cp >> 6) & 63)))
        emit_c(cast[uint8](128 | (cp & 63)))
        return
    emit_c(cast[uint8](240 | (cp >> 18)))
    emit_c(cast[uint8](128 | ((cp >> 12) & 63)))
    emit_c(cast[uint8](128 | ((cp >> 6) & 63)))
    emit_c(cast[uint8](128 | (cp & 63)))


# ---- substring by UTF-16 range ----
# Returns a string id for [u0, u1) in code units. Callers must have clamped
# u0/u1 into [0, str_u16_len] with u0 <= u1.
def str_sub_u16(id: int32, u0: int32, u1: int32) -> int32:
    if u0 >= u1:
        return str_new(&sp_buf[st_off[id]], 0)
    if st_asc[id] == 1:                # inlined fast path (avoid the call)
        return str_new(&sp_buf[st_off[id] + u0], u1 - u0)
    if str_is_ascii(id) != 0:
        return str_new(&sp_buf[st_off[id] + u0], u1 - u0)
    b0: int32 = str_u16_to_byte(id, u0)
    h0: int32 = u16_half
    b1: int32 = str_u16_to_byte(id, u1)
    h1: int32 = u16_half
    # Whole-sequence range (the common case even for non-ASCII text): copy the
    # bytes straight through, no re-encoding.
    if h0 == 0 and h1 == 0:
        return str_new(&sp_buf[st_off[id] + b0], b1 - b0)
    # A boundary falls INSIDE an astral pair: rebuild, emitting the lone
    # surrogate halves in WTF-8.
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    if h0 != 0:
        emit_cp_utf8(56320 + ((u8_decode(st_off[id] + b0, 4) - 65536) & 1023))
        b0 = b0 + 4
    if h1 != 0:
        i: int32 = b0
        while i < b1:
            emit_c(sp_buf[st_off[id] + i])
            i = i + 1
        emit_cp_utf8(55296 + (((u8_decode(st_off[id] + b1, 4) - 65536) >> 10) & 1023))
    else:
        i2: int32 = b0
        while i2 < b1:
            emit_c(sp_buf[st_off[id] + i2])
            i2 = i2 + 1
    rid: int32 = bld_end()
    emit_tgt = save
    return rid


def str_eq(a: int32, b: int32) -> int32:
    if st_len[a] != st_len[b]:
        return 0
    n: int32 = st_len[a]
    i: int32 = 0
    oa: int32 = st_off[a]
    ob: int32 = st_off[b]
    while i < n:
        if sp_buf[oa + i] != sp_buf[ob + i]:
            return 0
        i = i + 1
    return 1


def str_eq_cstr(a: int32, s: Ptr[uint8]) -> int32:
    n: int32 = st_len[a]
    oa: int32 = st_off[a]
    i: int32 = 0
    while i < n:
        if s[i] == 0:
            return 0
        if sp_buf[oa + i] != s[i]:
            return 0
        i = i + 1
    if s[i] != 0:
        return 0
    return 1


def cstr_len(s: Ptr[uint8]) -> int32:
    n: int32 = 0
    while s[n] != 0:
        n = n + 1
    return n


def str_from_cstr(s: Ptr[uint8]) -> int32:
    return str_new(s, cstr_len(s))


# ---- build a string / write output through emit_c ----
_bld_start: int32 = 0

def bld_begin():
    _bld_start = sp_top


def bld_end() -> int32:
    # Guard the id table exactly as str_new() does: without this, a builder that
    # runs when the pool is full wrote st_off/st_len[n_strs] with n_strs >= MAX_STR
    # — out of bounds into adjacent BSS (the intern table / globals), which
    # surfaced downstream as a spurious "console is not defined" instead of a
    # clean, catchable "string pool exhausted". Fail cleanly (empty-string id).
    # Phase-4 GC trigger (same discipline as str_new): reclaim dead string ids
    # when the table nears its cap. Non-moving, so the already-built bytes at
    # [_bld_start, sp_top) are untouched and _bld_start stays valid across it.
    if str_free_head < 0 and gc_disabled == 0 and n_strs >= str_hi_water:
        gc_collect_strings()
    id: int32 = str_alloc_id()
    if id < 0:
        set_error(cast[Ptr[uint8]]("string pool exhausted"))
        return MAX_STR - 1
    st_off[id] = _bld_start
    st_len[id] = sp_top - _bld_start
    st_asc[id] = 0                     # UTF-16 class not yet computed (lazy)
    return id


# One-shot latch so an exhausted string pool reports ONCE, not once per byte.
sp_exhaust_noted: int32 = 0


def emit_c(c: uint8):
    if emit_tgt == 1:
        if out_top < OUT_CAP - 1:
            out_buf[out_top] = c
            out_top = out_top + 1
    else:
        if sp_top < SP_CAP - 1:
            sp_buf[sp_top] = c
            sp_top = sp_top + 1
        else:
            # SAY SO. str_new() guarded the BYTES and reported, but the string
            # BUILDER (every `a + b` concatenation) came through here and just
            # stopped writing: the program kept running and every string it
            # built from then on was silently EMPTY. Observed as a loop printing
            # "i=200000 n=3088906" and then blank lines, with exit status 0 and
            # no error anywhere — the failure mode test_jsengine_strpool_clean
            # was red for.
            if sp_exhaust_noted == 0:
                sp_exhaust_noted = 1
                js_out_note(cast[Ptr[uint8]]("[engine] CEILING string pool exhausted (sp_buf bytes; strings built from here on would be empty). SP_CAP="), SP_CAP)
            set_error(cast[Ptr[uint8]]("string pool exhausted"))


def emit_cstr(s: Ptr[uint8]):
    i: int32 = 0
    while s[i] != 0:
        emit_c(s[i])
        i = i + 1


# WTF-8 CONCATENATION. Half-slicing an astral character leaves a LONE
# surrogate, which we store as a 3-byte WTF-8 sequence. Re-joining the halves
# (`s.slice(0,1) + s.slice(1) === s`, which JS says is true) must fold the
# lead+trail pair back into the single 4-byte UTF-8 sequence, or the result
# would merely LOOK equal while comparing unequal byte-wise. Returns 1 when a
# pending lead surrogate at the end of the current build was consumed.
# Costs one byte compare on the string-builder path, and only when the appended
# text actually begins 0xED (i.e. never for ASCII or ordinary UTF-8 text).
def bld_join_trail(trail_cp: int32) -> int32:
    if emit_tgt != 0:
        return 0
    if sp_top - 3 < _bld_start:
        return 0
    if sp_buf[sp_top - 3] != 237:                      # 0xED
        return 0
    b1: int32 = cast[int32](sp_buf[sp_top - 2])
    if b1 < 160 or b1 > 175:                           # lead half is 0xA0..0xAF
        return 0
    lead: int32 = u8_decode(sp_top - 3, 3)
    if lead < 55296 or lead > 56319:
        return 0
    sp_top = sp_top - 3
    emit_cp_utf8(65536 + ((lead - 55296) << 10) + (trail_cp - 56320))
    return 1


def emit_strid(id: int32):
    n: int32 = st_len[id]
    off: int32 = st_off[id]
    i: int32 = 0
    # leading WTF-8 TRAIL surrogate (0xED 0xB0..0xBF ..)? try to rejoin it with
    # a lead surrogate already at the end of the build.
    if n >= 3 and sp_buf[off] == 237 and sp_buf[off + 1] >= 176 and sp_buf[off + 1] <= 191:
        tcp: int32 = u8_decode(off, 3)
        if tcp >= 56320 and tcp <= 57343:
            if bld_join_trail(tcp) != 0:
                i = 3
    while i < n:
        emit_c(sp_buf[off + i])
        i = i + 1


def emit_u64(v: uint64):
    if v == 0:
        emit_c(48)
        return
    digs: Array[24, uint8]
    n: int32 = 0
    while v > 0:
        digs[n] = cast[uint8](v % 10) + 48
        v = v / 10
        n = n + 1
    while n > 0:
        n = n - 1
        emit_c(digs[n])


def emit_i64(v: int64):
    if v < 0:
        emit_c(45)
        emit_u64(cast[uint64](0 - v))
    else:
        emit_u64(cast[uint64](v))


# ---- ECMAScript Number::toString (ES2023 6.1.6.1.20, radix 10) --------------
# The spec picks integers n, k and s with k >= 1, 10^(k-1) <= s < 10^k and
# s * 10^(n-k) = the value, k AS SMALL AS POSSIBLE (the shortest digit run that
# reads back as the same double), then chooses one of FIVE layouts from n and k:
#
#   k <= n <= 21   -> the s digits followed by n-k zeros            (100, 1e20)
#   0 < n <= 21    -> s with a point after n digits                 (1.5, 3.25)
#   -6 < n <= 0    -> "0." + (-n) zeros + s                         (0.000001)
#   otherwise, k=1 -> s "e" sign (n-1)                              (1e+21, 1e-7)
#   otherwise      -> s[0] "." s[1..] "e" sign (n-1)                (1.5e+300)
#
# The previous code only ever produced the middle three shapes: it split the
# value into f_floor() integer part + fraction, so EXPONENT FORM did not exist.
# `1e-7` printed 0.0000001 (V8 prints 1e-7 — the -6 < n cut) and anything past
# 2^63 printed the clamped garbage 9223372036854775808 because the integer part
# went through cast[uint64]. Both thresholds and the e+/e- spelling below are
# V8's, verified value-by-value against `node`.
#
# The significand digits are found by normalising |x| into [1,10) with EXACT
# powers of ten (10^0..10^22 are the only ones a double holds exactly, so the
# scaling walks in <=22-decade steps), extracting 18 digits, and then taking the
# SHORTEST prefix — truncated or rounded half-up — that recomposes to exactly x
# again through the same scaling. Values needing more than 17 significant digits
# cannot exist (a double carries at most 17), so the search is bounded.

NUM_MAXD: int32 = 18

g_nd:   Array[24, uint8]      # raw digits of the normalised significand
g_ndc:  Array[24, uint8]      # the candidate digits actually printed
g_ndt:  Array[24, uint8]      # scratch for a uint64's digits (LSB first)
g_ndk:  int32 = 0             # how many of g_ndc are significant
g_ndn:  int32 = 0             # decimal point position (value = 0.<g_ndc> * 10^n)
g_p10:  Array[24, float64]    # 10^0 .. 10^22, every one exact in a double
g_p10_ready: int32 = 0
# 1 while formatting an INTEGRAL value whose digits were read out exactly (see
# _num_digits): the round-trip test then runs in uint64 instead of float64.
g_num_int: int32 = 0


def _p10_init():
    if g_p10_ready != 0:
        return
    v: float64 = 1.0
    i: int32 = 0
    while i <= 22:
        g_p10[i] = v
        v = v * 10.0
        i = i + 1
    g_p10_ready = 1


# v * 10^e, walking in <=22-decade steps so every individual multiply/divide has
# an EXACT power-of-ten operand (10^23 and up are not representable). Each step
# moves v monotonically toward the final magnitude, so no intermediate can
# overflow to Infinity or flush to zero unless the result itself does.
def _scale10(v: float64, e: int32) -> float64:
    _p10_init()
    while e > 22:
        v = v * g_p10[22]
        e = e - 22
    while e < -22:
        v = v / g_p10[22]
        e = e + 22
    if e > 0:
        v = v * g_p10[e]
    elif e < 0:
        v = v / g_p10[0 - e]
    return v


# Recompose the first k candidate digits at decimal position n back into a
# double: (the k digits read as an integer) * 10^(n-k). This is the round-trip
# oracle the shortest-digit search below tests against.
def _num_recon(k: int32, n: int32) -> float64:
    # INTEGRAL values: build the candidate in uint64 (every step exact) and let
    # ONE hardware int->double conversion round it. The float path below has to
    # multiply by a power of ten, and this engine's float64 multiply/divide is
    # not always the IEEE correctly-rounded result, so a 16/17-digit candidate
    # that is NOT the same double as x could still compare equal and win the
    # shortest-digits race (1234567890123456789 printed ...457000 instead of
    # V8's ...456800). Integer arithmetic sidesteps that entirely.
    u: uint64 = 0
    iu: int32 = 0
    while iu < k:
        u = u * 10 + cast[uint64](g_ndc[iu])
        iu = iu + 1
    if g_num_int != 0 and n >= k:
        z: int32 = n - k
        while z > 0:
            u = u * 10
            z = z - 1
        return cast[float64](cast[int64](u))
    # The k digits (k <= 18) are EXACT in a uint64; one int->double conversion
    # rounds once, then one power-of-ten scale rounds once. Building the same
    # integer by Horner in float64 instead cost a rounding PER DIGIT, and that
    # noise decided the shortest-digits race wrongly for most 17-digit values.
    return _scale10(cast[float64](cast[int64](u)), n - k)


# Copy the first k raw digits into the candidate buffer, optionally rounding the
# k-th up (half-up) with carry. A carry out of the leading digit makes the value
# 10^k, i.e. a single '1' one decade higher — reported by returning 1 so the
# caller can bump n.
def _num_cand(k: int32, roundup: int32) -> int32:
    i: int32 = 0
    while i < k:
        g_ndc[i] = g_nd[i]
        i = i + 1
    if roundup == 0:
        return 0
    j: int32 = k - 1
    carry: int32 = 1
    while j >= 0 and carry != 0:
        v: int32 = cast[int32](g_ndc[j]) + 1
        if v > 9:
            g_ndc[j] = cast[uint8](0)
        else:
            g_ndc[j] = cast[uint8](v)
            carry = 0
        j = j - 1
    if carry != 0:
        g_ndc[0] = cast[uint8](1)
        i = 1
        while i < k:
            g_ndc[i] = cast[uint8](0)
            i = i + 1
        return 1
    return 0


# Fill g_ndc / g_ndk / g_ndn for a FINITE, STRICTLY POSITIVE x.
def _num_digits(x: float64):
    _p10_init()
    # EXACT PATH: an integral value inside uint64 range has its decimal digits
    # available exactly, with no float scaling in the way. That matters because
    # the shortest-digit search below decides on the LAST digit, and a value like
    # 2**53 (9007199254740992) has 16 significant digits — one more than a double
    # can carry through a divide-and-extract round trip. Normalising it into
    # [1,10) and reading digits back gave a bogus tail, so the half-up rule fired
    # and printed 9007199254740993. Integers are also by far the most common
    # thing a page prints. Extract them exactly here; every other value falls
    # through to the float path.
    if x == f_floor(x) and x < 9.0e18:
        g_num_int = 1
        u: uint64 = cast[uint64](x)
        nd: int32 = 0
        while u > 0:
            g_nd[nd] = cast[uint8](u % 10)
            u = u / 10
            nd = nd + 1
        # the loop above produced least-significant-first; reverse in place.
        a: int32 = 0
        b: int32 = nd - 1
        while a < b:
            sw: uint8 = g_nd[a]
            g_nd[a] = g_nd[b]
            g_nd[b] = sw
            a = a + 1
            b = b - 1
        i0: int32 = nd
        while i0 < NUM_MAXD:
            g_nd[i0] = cast[uint8](0)
            i0 = i0 + 1
        _num_search(x, nd)
        g_num_int = 0
        return
    g_num_int = 0
    # MIXED PATH: |x| >= 1 with a fraction. Read the INTEGER part out of a
    # uint64 exactly and peel the fraction from the exact remainder x - floor(x).
    # No normalising divide is involved at all, so nothing perturbs the digits
    # the shortest-round-trip search is about to weigh — the decade normalisation
    # below costs a rounding, and on a 17-significant-digit value like
    # 943226.1374251065 that rounding is what decides the final digit.
    if x >= 1.0 and x < 9.0e18:
        ipf: float64 = f_floor(x)
        u2: uint64 = cast[uint64](ipf)
        nd2: int32 = 0
        while u2 > 0:
            g_ndt[nd2] = cast[uint8](u2 % 10)
            u2 = u2 / 10
            nd2 = nd2 + 1
        j: int32 = 0
        while j < nd2:
            g_nd[j] = g_ndt[nd2 - 1 - j]
            j = j + 1
        t2: float64 = x - ipf
        j2: int32 = nd2
        while j2 < NUM_MAXD:
            t2 = t2 * 10.0
            dv2: int32 = cast[int32](f_floor(t2))
            if dv2 > 9:
                dv2 = 9
            if dv2 < 0:
                dv2 = 0
            g_nd[j2] = cast[uint8](dv2)
            t2 = t2 - cast[float64](dv2)
            j2 = j2 + 1
        _num_search(x, nd2)
        return
    # ESTIMATE the decade with a cheap stepwise walk. Its ACCURACY does not
    # matter (only its integer answer does) because the significand is then
    # recomputed from the ORIGINAL x in one shot below — walking a decade at a
    # time and keeping the running quotient would have cost one rounding per
    # step (six of them for 1.2e20), and that noise lands squarely on the 17th
    # significant digit, which is where V8 is still making decisions.
    e10: int32 = 0
    d: float64 = x
    while d >= g_p10[22]:
        d = d / g_p10[22]
        e10 = e10 + 22
    while d >= g_p10[8]:
        d = d / g_p10[8]
        e10 = e10 + 8
    while d >= 10.0:
        d = d / 10.0
        e10 = e10 + 1
    while d < 1.0 and d > 0.0:
        if d < 1.0e-22:
            d = d * g_p10[22]
            e10 = e10 - 22
        elif d < 1.0e-8:
            d = d * g_p10[8]
            e10 = e10 - 8
        else:
            d = d * 10.0
            e10 = e10 - 1
    # Recompute the significand from x directly: for the |decade| <= 22 range
    # that covers essentially every number a page produces, _scale10 is a SINGLE
    # correctly-rounded divide by an exact power of ten.
    d = _scale10(x, 0 - e10)
    while d >= 10.0:
        e10 = e10 + 1
        d = _scale10(x, 0 - e10)
    while d < 1.0 and d > 0.0:
        e10 = e10 - 1
        d = _scale10(x, 0 - e10)
    # raw significand digits, peeled one at a time (`t - digit` is exact; only
    # the *10 rounds).
    t: float64 = d
    i: int32 = 0
    while i < NUM_MAXD:
        dv: int32 = cast[int32](f_floor(t))
        if dv > 9:
            dv = 9
        if dv < 0:
            dv = 0
        g_nd[i] = cast[uint8](dv)
        t = (t - cast[float64](dv)) * 10.0
        i = i + 1
    _num_search(x, e10 + 1)


# SHORTEST digit prefix of g_nd that reads back as exactly x. `n0` is the decimal
# point position of the full run (x = 0.<g_nd> * 10^n0).
def _num_search(x: float64, n0: int32):
    k: int32 = 1
    while k < NUM_MAXD:
        # Try the CORRECTLY ROUNDED k-digit candidate first (half-up on the next
        # raw digit), and only then the other direction. Order matters once k
        # reaches 17: an integer of 17 digits is past 2^53, so truncated and
        # rounded-up candidates can recompose to the SAME double and both
        # "round-trip" — testing the rounded one first makes us print V8's
        # 123456789012345680000 rather than ...670000, and 5e-324 rather than
        # 4e-324 for the smallest denormal.
        up: int32 = 0
        if g_nd[k] >= cast[uint8](5):
            up = 1
        bump: int32 = _num_cand(k, up)
        if _num_recon(k, n0 + bump) == x:
            g_ndk = k
            g_ndn = n0 + bump
            _num_trim()
            return
        bump = _num_cand(k, 1 - up)
        if _num_recon(k, n0 + bump) == x:
            g_ndk = k
            g_ndn = n0 + bump
            _num_trim()
            return
        k = k + 1
    # No prefix round-trips (only reachable when the <=22-decade scaling lost a
    # low bit on an extreme exponent): print the full 17-digit form, which is
    # always enough to identify a double.
    bump2: int32 = _num_cand(17, 1)
    g_ndk = 17
    g_ndn = n0 + bump2
    _num_trim()


# Trailing zeros are never part of the spec's s (it requires 10^(k-1) <= s).
def _num_trim():
    while g_ndk > 1 and g_ndc[g_ndk - 1] == cast[uint8](0):
        g_ndk = g_ndk - 1


def emit_num(x: float64):
    if is_nan(x) != 0:
        emit_cstr(cast[Ptr[uint8]]("NaN"))
        return
    if is_inf(x) != 0:
        if x < 0.0:
            emit_c(45)
        emit_cstr(cast[Ptr[uint8]]("Infinity"))
        return
    if x == 0.0:
        emit_c(48)                               # String(-0) is "0"
        return
    if x < 0.0:
        emit_c(45)
        x = 0.0 - x
    _num_digits(x)
    k: int32 = g_ndk
    n: int32 = g_ndn
    i: int32 = 0
    if k <= n and n <= 21:
        # integer, then the zeros the exponent implies: 100, 1e20.
        while i < k:
            emit_c(g_ndc[i] + 48)
            i = i + 1
        z: int32 = n - k
        while z > 0:
            emit_c(48)
            z = z - 1
        return
    if 0 < n and n <= 21:
        while i < n:
            emit_c(g_ndc[i] + 48)
            i = i + 1
        emit_c(46)
        while i < k:
            emit_c(g_ndc[i] + 48)
            i = i + 1
        return
    if -6 < n and n <= 0:
        emit_c(48)
        emit_c(46)
        z2: int32 = 0 - n
        while z2 > 0:
            emit_c(48)
            z2 = z2 - 1
        while i < k:
            emit_c(g_ndc[i] + 48)
            i = i + 1
        return
    # EXPONENT FORM. V8 always spells the sign: 1e+21, 1e-7, 1.5e+300.
    emit_c(g_ndc[0] + 48)
    if k > 1:
        emit_c(46)
        i = 1
        while i < k:
            emit_c(g_ndc[i] + 48)
            i = i + 1
    emit_c(101)                                  # 'e'
    ex: int32 = n - 1
    if ex < 0:
        emit_c(45)
        ex = 0 - ex
    else:
        emit_c(43)
    emit_u64(cast[uint64](ex))


# ---- number-string helper making a fresh string value ----
def num_to_strid(x: float64) -> int32:
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    emit_num(x)
    id: int32 = bld_end()
    emit_tgt = save
    return id


# parse a JS numeric literal / string to float64
def parse_num_bytes(p: Ptr[uint8], n: int32) -> float64:
    i: int32 = 0
    while i < n and is_ws(p[i]) != 0:
        i = i + 1
    sign: float64 = 1.0
    if i < n and p[i] == 43:
        i = i + 1
    elif i < n and p[i] == 45:
        sign = -1.0
        i = i + 1
    # hex (ES2021 numeric separators `_` are skipped in every digit run below)
    if i + 1 < n and p[i] == 48 and (p[i + 1] == 120 or p[i + 1] == 88):
        i = i + 2
        hv: float64 = 0.0
        any: int32 = 0
        while i < n and (is_hexdig(p[i]) != 0 or p[i] == 95):
            c: uint8 = p[i]
            if c == 95:
                i = i + 1
            else:
                d: int32 = 0
                if c >= 48 and c <= 57:
                    d = cast[int32](c) - 48
                elif c >= 97 and c <= 102:
                    d = cast[int32](c) - 87
                else:
                    d = cast[int32](c) - 55
                hv = hv * 16.0 + cast[float64](d)
                any = 1
                i = i + 1
        if any == 0:
            return 0.0 / 0.0
        return sign * hv
    # binary 0b / 0B
    if i + 1 < n and p[i] == 48 and (p[i + 1] == 98 or p[i + 1] == 66):
        i = i + 2
        bv: float64 = 0.0
        anyb: int32 = 0
        while i < n and ((p[i] >= 48 and p[i] <= 49) or p[i] == 95):
            if p[i] != 95:
                bv = bv * 2.0 + cast[float64](cast[int32](p[i]) - 48)
                anyb = 1
            i = i + 1
        if anyb == 0:
            return 0.0 / 0.0
        return sign * bv
    # octal 0o / 0O
    if i + 1 < n and p[i] == 48 and (p[i + 1] == 111 or p[i + 1] == 79):
        i = i + 2
        ov: float64 = 0.0
        anyo: int32 = 0
        while i < n and ((p[i] >= 48 and p[i] <= 55) or p[i] == 95):
            if p[i] != 95:
                ov = ov * 8.0 + cast[float64](cast[int32](p[i]) - 48)
                anyo = 1
            i = i + 1
        if anyo == 0:
            return 0.0 / 0.0
        return sign * ov
    # DECIMAL MANTISSA in uint64. Accumulating into a float64 (val*10+digit) is
    # exact only while the running value stays under 2^53 — past that every step
    # rounds, and this engine's float multiply is not always the IEEE
    # correctly-rounded result, so `1234567890123456789` landed on a double one
    # step away from the one V8 parses (and then printed ...457000 instead of
    # ...456800). A uint64 carries 19 significant digits with no rounding at all;
    # ONE int->double conversion at the end rounds exactly once, and the decimal
    # exponent (digits dropped past capacity, minus fraction digits, plus any
    # e-notation) is applied by _scale10 with exact powers of ten. Digits past
    # the 19th cannot move a double, so they only shift the exponent.
    mant: uint64 = 0
    dexp: int32 = 0                              # decimal exponent owed to mant
    any2: int32 = 0
    while i < n and (is_digit(p[i]) != 0 or p[i] == 95):
        if p[i] != 95:
            if mant < 900000000000000000:
                mant = mant * 10 + cast[uint64](cast[int32](p[i]) - 48)
            else:
                dexp = dexp + 1                  # too big to hold: scale instead
            any2 = 1
        i = i + 1
    if i < n and p[i] == 46:
        i = i + 1
        while i < n and (is_digit(p[i]) != 0 or p[i] == 95):
            if p[i] != 95:
                if mant < 900000000000000000:
                    mant = mant * 10 + cast[uint64](cast[int32](p[i]) - 48)
                    dexp = dexp - 1
                any2 = 1
            i = i + 1
    val: float64 = cast[float64](cast[int64](mant))
    if any2 == 0:
        return 0.0 / 0.0
    if i < n and (p[i] == 101 or p[i] == 69):    # e / E
        i = i + 1
        esign: int32 = 1
        if i < n and p[i] == 43:
            i = i + 1
        elif i < n and p[i] == 45:
            esign = -1
            i = i + 1
        ev: int32 = 0
        while i < n and (is_digit(p[i]) != 0 or p[i] == 95):
            if p[i] != 95:
                ev = ev * 10 + (cast[int32](p[i]) - 48)
            i = i + 1
        # Apply the exponent with EXACT powers of ten (<=22 decades per step).
        # The old loop stepped one decade at a time and, for a negative
        # exponent, multiplied by 0.1 — which is not representable, so `1e-7`
        # parsed to a double a few ulp off the one V8 produces and could not
        # round-trip through emit_num. 10^k is exact through 10^22 and each step
        # here moves monotonically toward the result, so nothing can overflow on
        # the way to a finite answer.
        if esign > 0:
            dexp = dexp + ev
        else:
            dexp = dexp - ev
    if dexp != 0:
        val = _scale10(val, dexp)
    return sign * val


# ====================================================================
# VALUE constructors / accessors.
# ====================================================================
def mk_val(tag: int32) -> int32:
    # GC trigger (Phase 1): when the arena reaches the high-water mark and no
    # reclaimed cell is waiting, run a stop-the-world collection to repopulate the
    # free list. gc_disabled gates it OFF inside un-audited native/builtin calls.
    # Default gc_hi_water is 80% of MAX_VAL, so a program that fit the arena
    # before never reaches here and stays byte-for-byte identical.
    if gc_free_head < 0 and gc_disabled == 0 and n_vals >= gc_hi_water:
        gc_collect()
    # Prefer a reclaimed cell before bumping the arena.
    if gc_free_head >= 0:
        fh: int32 = gc_free_head
        gc_free_head = v_ref[fh]
        v_tag[fh] = cast[uint8](tag)
        v_ref[fh] = 0
        v_num[fh] = 0.0
        return fh
    # Guard the value pool: overflowing n_vals used to write past v_tag/v_num/
    # v_ref into adjacent BSS, silently corrupting globals/env (spurious
    # "x is not defined") or crashing. Fail cleanly instead, reusing the last
    # slot so callers get a valid (if meaningless) handle rather than an OOB one.
    if n_vals >= MAX_VAL:
        set_error(cast[Ptr[uint8]]("value pool exhausted"))
        return MAX_VAL - 1
    h: int32 = n_vals
    v_tag[h] = cast[uint8](tag)
    v_ref[h] = 0
    v_num[h] = 0.0
    n_vals = n_vals + 1
    return h


def v_undef() -> int32:
    return 0


def v_null() -> int32:
    return 1


def v_true() -> int32:
    return 2


def v_false() -> int32:
    return 3


def v_boolv(b: int32) -> int32:
    if b != 0:
        return 2
    return 3


def v_number(x: float64) -> int32:
    h: int32 = mk_val(TAG_NUM)
    v_num[h] = x
    return h


def v_string_id(sid: int32) -> int32:
    h: int32 = mk_val(TAG_STR)
    v_ref[h] = sid
    return h


def v_string_bytes(p: Ptr[uint8], n: int32) -> int32:
    return v_string_id(str_new(p, n))


def v_string_cstr(s: Ptr[uint8]) -> int32:
    return v_string_id(str_from_cstr(s))


def tag_of(h: int32) -> int32:
    return cast[int32](v_tag[h])


def num_of(h: int32) -> float64:
    return v_num[h]


def strid_of(h: int32) -> int32:
    return v_ref[h]


def objid_of(h: int32) -> int32:
    return v_ref[h]


# ====================================================================
# OBJECTS.
# ====================================================================
def obj_new(kind: int32) -> int32:
    # Guard the object pool. Phase-1 GC reclaims only the VALUE arena, so an
    # allocation-heavy run can now reach this bump limit; without a check,
    # obj_new wrote past the obj_* arrays into adjacent BSS (corrupting env /
    # string tables — surfacing as spurious "x is not defined"). Fail cleanly,
    # reusing the last slot so callers get a valid (if meaningless) id.
    if n_objs >= MAX_OBJ:
        set_error(cast[Ptr[uint8]]("object pool exhausted"))
        return MAX_OBJ - 1
    o: int32 = n_objs
    obj_kind[o] = cast[uint8](kind)
    obj_head[o] = -1
    obj_fn_node[o] = -1
    obj_fn_env[o] = -1
    obj_fn_native[o] = -1
    arr_len[o] = 0
    arr_cap[o] = 0
    arr_base[o] = -1
    obj_proto[o] = -1
    obj_fn_this[o] = -2
    obj_fn_home[o] = -1
    obj_fn_super[o] = -1
    obj_fn_btarget[o] = -1
    obj_fn_bthis[o] = 0
    obj_fn_bargs[o] = -1
    obj_class[o] = 0
    obj_class_node[o] = -1
    obj_re_prog[o] = -1
    obj_re_ncap[o] = 0
    obj_re_flags[o] = 0
    obj_is_date[o] = cast[uint8](0)
    obj_date_ms[o] = 0.0
    obj_is_prom[o] = cast[uint8](0)
    prom_alreadyres[o] = cast[uint8](0)
    obj_frozen[o] = cast[uint8](0)
    obj_nonext[o] = cast[uint8](0)
    obj_map_kind[o] = cast[uint8](MAP_KIND_NONE)
    obj_ms_head[o] = -1
    obj_ms_tail[o] = -1
    obj_ms_size[o] = 0
    obj_proxy_target[o] = -1
    obj_proxy_handler[o] = -1
    obj_ab_off[o] = -1
    obj_ta_kind[o] = cast[uint8](0)
    obj_ta_buf[o] = -1
    obj_ta_off[o] = 0
    obj_ta_len[o] = 0
    n_objs = n_objs + 1
    return o


def is_proxy(h: int32) -> int32:
    if tag_of(h) != TAG_OBJ:
        return 0
    if obj_proxy_target[objid_of(h)] >= 0:
        return 1
    return 0


def is_typed_array(h: int32) -> int32:
    if tag_of(h) != TAG_OBJ:
        return 0
    if cast[int32](obj_ta_kind[objid_of(h)]) != 0:
        return 1
    return 0


def v_new_object() -> int32:
    h: int32 = mk_val(TAG_OBJ)
    o: int32 = obj_new(OK_PLAIN)
    # Chain a plain object's [[Prototype]] to the real Object.prototype (once it
    # has been installed) so reading a method as a VALUE — `var has =
    # {}.hasOwnProperty; has.call(o,'k')`, the shape transpiled/minified bundles
    # emit — resolves through the chain to the same native-function value.
    # g_object_proto is 0 during its own construction, so Object.prototype itself
    # (and everything built before it) keeps a null [[Prototype]]. Enumeration
    # (for-in / Object.keys / JSON.stringify / spread) walks obj_head OWN props
    # only and never the proto chain, so no prototype method leaks into it.
    if g_object_proto != 0:
        obj_proto[o] = objid_of(g_object_proto)
    v_ref[h] = o
    return h


def v_new_array() -> int32:
    h: int32 = mk_val(TAG_OBJ)
    o: int32 = obj_new(OK_ARRAY)
    # Chain the array's [[Prototype]] to the real Array.prototype (once it has
    # been installed) so member reads of method names resolve to the SAME native
    # function values — i.e. `[].slice === Array.prototype.slice`. The fast
    # name-dispatch in eval_call still short-circuits direct `arr.m(...)` calls;
    # this only makes the methods first-class VALUES. for-in/Object.keys are
    # own-only, so inheriting these methods does not leak into enumeration.
    if g_array_proto != 0:
        obj_proto[o] = objid_of(g_array_proto)
    v_ref[h] = o
    return h


def v_new_native(native_id: int32) -> int32:
    h: int32 = mk_val(TAG_OBJ)
    o: int32 = obj_new(OK_FUNC)
    obj_fn_native[o] = native_id
    # Function instances chain to Function.prototype so `var b = fn.bind; b(x)`
    # and `var c = fn.call; c.call(...)` resolve call/apply/bind as VALUES.
    if g_func_proto != 0:
        obj_proto[o] = objid_of(g_func_proto)
    v_ref[h] = o
    return h


def v_new_closure(node: int32, env: int32) -> int32:
    h: int32 = mk_val(TAG_OBJ)
    o: int32 = obj_new(OK_FUNC)
    obj_fn_node[o] = node
    obj_fn_env[o] = env
    # User closures are functions too — chain to Function.prototype.
    if g_func_proto != 0:
        obj_proto[o] = objid_of(g_func_proto)
    v_ref[h] = o
    return h


# A break/continue's target label (a string id) matches a loop/label's own
# label. Label ids are compared by TEXT (str_eq), not by ==: the same source
# identifier can carry different string ids at its definition and use sites.
def label_eq(target: int32, own: int32) -> int32:
    if target < 0 or own < 0:
        return 0
    return str_eq(target, own)


def is_callable(h: int32) -> int32:
    if tag_of(h) != TAG_OBJ:
        return 0
    if cast[int32](obj_kind[objid_of(h)]) == OK_FUNC:
        return 1
    return 0


def is_array(h: int32) -> int32:
    if tag_of(h) != TAG_OBJ:
        return 0
    if cast[int32](obj_kind[objid_of(h)]) == OK_ARRAY:
        return 1
    return 0


def is_symbol(h: int32) -> int32:
    if tag_of(h) != TAG_OBJ:
        return 0
    if cast[int32](obj_kind[objid_of(h)]) == OK_SYMBOL:
        return 1
    return 0


# A Symbol primitive: unique identity (a distinct object) with an optional
# `description` own property. typeof -> "symbol". Used as an object property key
# via symbol_key() which derives a stable, collision-free string from its id.
def v_new_symbol(desc: int32) -> int32:
    h: int32 = mk_val(TAG_OBJ)
    o: int32 = obj_new(OK_SYMBOL)
    v_ref[h] = o
    obj_set(o, str_from_cstr(cast[Ptr[uint8]]("description")), desc)
    return h


# Stable private property-key string for a symbol used as a computed key:
# "@@sym:<objid>" — unique per symbol, never collides with a normal string key
# that a script would write (those don't start with @@sym:).
def symbol_key(h: int32) -> int32:
    save: int32 = emit_tgt
    emit_tgt = 0
    bld_begin()
    emit_cstr(cast[Ptr[uint8]]("@@sym:"))
    emit_u64(cast[uint64](objid_of(h)))
    id: int32 = bld_end()
    emit_tgt = save
    return id


# A property key that must never surface to script enumeration/serialization:
#   "#..."   class private fields/methods (leading '#')
#   "@@..."  engine-internal keys — symbol keys ("@@sym:") and the like
# These are stored as ordinary string-keyed properties for uniform get/set, but
# Object.keys / for-in / JSON.stringify skip them.
def is_hidden_key(sid: int32) -> int32:
    if str_len(sid) >= 1 and str_char(sid, 0) == 35:          # '#'
        return 1
    if str_len(sid) >= 2 and str_char(sid, 0) == 64 and str_char(sid, 1) == 64:  # '@@'
        return 1
    return 0


# ---- named property get/set (string-keyed) on an object id ----
def obj_find_prop(o: int32, key: int32) -> int32:
    p: int32 = obj_head[o]
    while p >= 0:
        if str_eq(p_key[p], key) != 0:
            return p
        p = p_next[p]
    return -1


# allocation-free lookup by C-string key (safe to call mid string-build)
def obj_find_prop_cstr(o: int32, s: Ptr[uint8]) -> int32:
    p: int32 = obj_head[o]
    while p >= 0:
        if str_eq_cstr(p_key[p], s) != 0:
            return p
        p = p_next[p]
    return -1


def obj_get_cstr(o: int32, s: Ptr[uint8]) -> int32:
    p: int32 = obj_find_prop_cstr(o, s)
    if p >= 0:
        return p_val[p]
    return v_undef()


PF_ENUM:  int32 = 1
PF_WRITE: int32 = 2
PF_CONF:  int32 = 4
PF_ALL:   int32 = 7


# [[Enumerable]] of property slot `p` — the single predicate every enumeration
# site (for-in, Object.keys/values/entries, JSON, assign/spread/rest) consults.
def prop_is_enum(p: int32) -> int32:
    if (cast[int32](p_flags[p]) & PF_ENUM) != 0:
        return 1
    return 0


# Clear [[Enumerable]] on an own property that was just installed with obj_set /
# obj_define_accessor. Used for the spec's non-enumerable built-ins: every
# builtin method, `F.prototype`, `F.prototype.constructor` and class members.
def obj_mark_nonenum(o: int32, key: int32):
    p: int32 = obj_find_prop(o, key)
    if p >= 0:
        p_flags[p] = cast[uint8](cast[int32](p_flags[p]) & (PF_ALL - PF_ENUM))


# Set an own property's full attribute mask outright. Engine-internal only: it is
# how the built-ins get the exact { writable, enumerable, configurable } triples
# the spec gives them (e.g. `F.prototype` is writable but NOT configurable, and
# `Math.PI` is none of the three).
def obj_mark_flags(o: int32, key: int32, flags: int32):
    p: int32 = obj_find_prop(o, key)
    if p >= 0:
        p_flags[p] = cast[uint8](flags)


def obj_set(o: int32, key: int32, val: int32):
    if obj_frozen[o] != 0:             # Object.freeze: writes and additions are no-ops
        return
    p: int32 = obj_find_prop(o, key)
    if p >= 0:
        if p_acc[p] == 0 and (cast[int32](p_flags[p]) & PF_WRITE) == 0:
            return                     # non-writable data property: silent no-op (sloppy mode)
        p_acc[p] = cast[uint8](0)      # a plain data write demotes any accessor
        p_get[p] = -1
        p_set[p] = -1
        p_val[p] = val
        return
    if obj_nonext[o] != 0:             # preventExtensions/seal: existing-prop writes OK, new props dropped
        return
    if n_props >= MAX_PROP:            # bump limit (Phase-1 GC doesn't reclaim props)
        set_error(cast[Ptr[uint8]]("property pool exhausted"))
        return
    np: int32 = n_props
    p_key[np] = key
    p_val[np] = val
    p_acc[np] = cast[uint8](0)
    p_get[np] = -1
    p_set[np] = -1
    p_flags[np] = cast[uint8](PF_ALL)
    p_next[np] = obj_head[o]
    obj_head[o] = np
    n_props = n_props + 1


# Define an accessor property (getter/setter) on object `o`. A -1 fn leaves that
# half unchanged if the property already exists as an accessor (so `get x`/`set x`
# for the same key compose); otherwise it installs a fresh accessor slot.
def obj_define_accessor(o: int32, key: int32, getter: int32, setter: int32):
    if obj_frozen[o] != 0:
        return
    p: int32 = obj_find_prop(o, key)
    if p < 0:
        if n_props >= MAX_PROP:
            set_error(cast[Ptr[uint8]]("property pool exhausted"))
            return
        p = n_props
        p_key[p] = key
        p_val[p] = v_undef()
        p_get[p] = -1
        p_set[p] = -1
        p_flags[p] = cast[uint8](PF_ALL)
        p_next[p] = obj_head[o]
        obj_head[o] = p
        n_props = n_props + 1
    elif p_acc[p] == 0:                 # was a data property: convert
        p_get[p] = -1
        p_set[p] = -1
    p_acc[p] = cast[uint8](1)
    if getter >= 0:
        p_get[p] = getter
    if setter >= 0:
        p_set[p] = setter


def obj_del_prop(o: int32, key: int32) -> int32:
    # Unlink the own property `key` from o's chain. Returns 1 if removed.
    prev: int32 = -1
    p: int32 = obj_head[o]
    while p >= 0:
        if str_eq(p_key[p], key) != 0:
            if (cast[int32](p_flags[p]) & PF_CONF) == 0:
                return 0               # non-configurable: `delete` fails (sloppy mode: false)
            if prev < 0:
                obj_head[o] = p_next[p]
            else:
                p_next[prev] = p_next[p]
            return 1
        prev = p
        p = p_next[p]
    return 0


def obj_get(o: int32, key: int32) -> int32:
    p: int32 = obj_find_prop(o, key)
    if p >= 0:
        return p_val[p]
    return v_undef()


# [[Get]] on own property slot `p` of `ownerv`: a data slot yields its value, an
# accessor slot INVOKES its getter with this=ownerv (Object.values/entries see the
# getter's result, not the empty accessor slot). Callers must have `ownerv` pinned.
def prop_read(p: int32, ownerv: int32) -> int32:
    if p_acc[p] == 0:
        return p_val[p]
    if p_get[p] < 0:
        return v_undef()
    gb: int32 = call_top
    r: int32 = invoke(p_get[p], ownerv, gb, 0)
    call_top = gb
    return r


# copy own (enumerable) props of src into dst, preserving insertion order.
# ES Object.assign / object-spread use [[Get]] on the source, so an ACCESSOR
# property is read by INVOKING its getter (this = the source object) and the
# resulting data value is written to dst — never the (empty) accessor slot.
# Safe to invoke getters here: both callers run during ordinary evaluation, not
# inside a string build.
def copy_own_props(src: int32, dst: int32):
    gsc: int32 = gc_top
    srcv: int32 = mk_val(TAG_OBJ)
    v_ref[srcv] = src
    gc_push(srcv)                          # pin the source view across getter calls
    copy_own_props_rec(obj_head[src], dst, srcv)
    gc_popto(gsc)


def copy_own_props_rec(p: int32, dst: int32, srcv: int32):
    if p < 0:
        return
    copy_own_props_rec(p_next[p], dst, srcv)
    if ctl == CTL_THROW or err_flag != 0:
        return
    if prop_is_enum(p) == 0:               # CopyDataProperties: own ENUMERABLE only
        return
    if p_acc[p] != 0:
        val: int32 = v_undef()
        if p_get[p] >= 0:
            gb: int32 = call_top
            val = invoke(p_get[p], srcv, gb, 0)
            call_top = gb
        obj_set(dst, p_key[p], val)
    else:
        obj_set(dst, p_key[p], p_val[p])


# ---- array element storage ----
def arr_grow(o: int32, need: int32):
    if need <= arr_cap[o]:
        return
    ncap: int32 = arr_cap[o] * 2
    if ncap < 4:
        ncap = 4
    while ncap < need:
        ncap = ncap * 2
    ob: int32 = arr_base[o]
    # Fast path: this array's backing chunk is the MOST-RECENT bump allocation
    # (its end coincides with ax_top), so grow it IN PLACE — just extend the
    # bump cursor. No copy, and crucially NO abandoned old chunk. The old code
    # allocated a fresh chunk on every doubling and leaked the previous one
    # (~2x waste, never reclaimed until js_init); building one array in a loop —
    # or the many small arrays a DOM build / re-entrant callback churns — then
    # overran ax_val and silently corrupted or dropped a later array's elements.
    if ob >= 0 and ob + arr_cap[o] == ax_top:
        add: int32 = ncap - arr_cap[o]
        if ax_top + add > MAX_AX:
            set_error(cast[Ptr[uint8]]("array storage exhausted"))
            return
        j: int32 = arr_cap[o]
        while j < ncap:
            ax_val[ob + j] = v_undef()
            j = j + 1
        ax_top = ax_top + add
        arr_cap[o] = ncap
        return
    # Slow path: the array is not on top of the bump (something was allocated
    # after it), so it must move — allocate a fresh chunk and copy.
    if ax_top + ncap > MAX_AX:
        set_error(cast[Ptr[uint8]]("array storage exhausted"))
        return
    nbase: int32 = ax_top
    ax_top = ax_top + ncap
    # copy old elements
    i: int32 = 0
    while i < arr_len[o]:
        ax_val[nbase + i] = ax_val[ob + i]
        i = i + 1
    # fill remainder with undefined
    while i < ncap:
        ax_val[nbase + i] = v_undef()
        i = i + 1
    arr_base[o] = nbase
    arr_cap[o] = ncap


def arr_set(o: int32, idx: int32, val: int32):
    if idx < 0:
        return
    if idx >= arr_cap[o]:
        arr_grow(o, idx + 1)
    if idx >= arr_len[o]:
        # fill holes with undefined
        i: int32 = arr_len[o]
        while i < idx:
            ax_val[arr_base[o] + i] = v_undef()
            i = i + 1
        arr_len[o] = idx + 1
    ax_val[arr_base[o] + idx] = val


def arr_get(o: int32, idx: int32) -> int32:
    if idx < 0 or idx >= arr_len[o]:
        return v_undef()
    return ax_val[arr_base[o] + idx]


def arr_push(o: int32, val: int32):
    arr_set(o, arr_len[o], val)


# ====================================================================
# ENVIRONMENTS.
# ====================================================================
def env_new(parent: int32, is_func: int32) -> int32:
    # Phase-3 GC trigger: when the arena reaches its high-water mark and no
    # reclaimed env is waiting, run a stop-the-world ENV collection to repopulate
    # the free list. gc_disabled gates it OFF inside un-audited native/builtin
    # calls (same discipline as mk_val). Default env_hi_water is near the ceiling,
    # so a program that fit the env arena before never reaches here.
    if env_free_head < 0 and gc_disabled == 0 and n_envs >= env_hi_water:
        gc_collect_envs()
    # Prefer a reclaimed env before bumping the arena.
    if env_free_head >= 0:
        fe: int32 = env_free_head
        env_free_head = env_parent[fe]     # env_parent is repurposed as the free link
        env_freed[fe] = cast[uint8](0)
        env_parent[fe] = parent
        env_head[fe] = -1
        if is_func != 0:
            env_is_func[fe] = 1
        else:
            env_is_func[fe] = 0
        return fe
    # Guard the environment pool. A block body inside a hot loop allocates one
    # env per iteration; Phase-1 GC reclaims values (letting such loops run much
    # longer). Without a check env_new wrote past env_* into adjacent BSS. Fail
    # cleanly (reuse last slot).
    if n_envs >= MAX_ENV:
        set_error(cast[Ptr[uint8]]("environment pool exhausted"))
        return MAX_ENV - 1
    e: int32 = n_envs
    env_parent[e] = parent
    env_head[e] = -1
    env_freed[e] = cast[uint8](0)          # clear any stale free flag from a prior run
    if is_func != 0:
        env_is_func[e] = 1
    else:
        env_is_func[e] = 0
    n_envs = n_envs + 1
    return e


def env_find_local(e: int32, name: int32) -> int32:
    b: int32 = env_head[e]
    while b >= 0:
        if str_eq(b_name[b], name) != 0:
            return b
        b = b_next[b]
    return -1


def env_define(e: int32, name: int32, val: int32, is_const: int32):
    b: int32 = env_find_local(e, name)
    if b >= 0:
        b_val[b] = val
        return
    # Prefer a reclaimed binding (Phase-3 env GC frees binding chains) before
    # bumping the arena.
    nb: int32 = -1
    if bind_free_head >= 0:
        nb = bind_free_head
        bind_free_head = b_next[nb]
    else:
        if n_binds >= MAX_BIND:
            set_error(cast[Ptr[uint8]]("binding pool exhausted"))
            return
        nb = n_binds
        n_binds = n_binds + 1
    b_name[nb] = name
    b_val[nb] = val
    if is_const != 0:
        b_const[nb] = 1
    else:
        b_const[nb] = 0
    b_next[nb] = env_head[e]
    env_head[e] = nb


def env_lookup_bind(e: int32, name: int32) -> int32:
    while e >= 0:
        b: int32 = env_find_local(e, name)
        if b >= 0:
            return b
        e = env_parent[e]
    return -1


def env_func_scope(e: int32) -> int32:
    while e >= 0:
        if env_is_func[e] != 0:
            return e
        if env_parent[e] < 0:
            return e
        e = env_parent[e]
    return e


# ====================================================================
# error handling
# ====================================================================
# A catchable runtime exception: builds an Error-like object and unwinds via
# CTL_THROW (as opposed to set_error, which is a fatal parse/engine error).
def throw_error(name: Ptr[uint8], msg: Ptr[uint8]):
    if ctl == CTL_THROW or err_flag != 0:
        return
    ev: int32 = v_new_object()
    o: int32 = objid_of(ev)
    obj_set(o, str_from_cstr(name_key()), v_string_cstr(name))
    obj_set(o, str_from_cstr(msg_key()), v_string_cstr(msg))
    # Link the error to its constructor's prototype so `e instanceof TypeError`
    # (and `instanceof Error`) hold for engine-thrown errors, not just
    # user-`throw new TypeError()`. Looks up the constructor by name in globals.
    ctorb: int32 = env_lookup_bind(g_env, str_from_cstr(name))
    if ctorb >= 0:
        ctorv: int32 = b_val[ctorb]
        if tag_of(ctorv) == TAG_OBJ:
            ep: int32 = obj_get(objid_of(ctorv), str_from_cstr(cast[Ptr[uint8]]("prototype")))
            if tag_of(ep) == TAG_OBJ:
                obj_proto[o] = objid_of(ep)
    throw_val = ev
    ctl = CTL_THROW


def name_key() -> Ptr[uint8]:
    return cast[Ptr[uint8]]("name")


def msg_key() -> Ptr[uint8]:
    return cast[Ptr[uint8]]("message")


def set_error(msg: Ptr[uint8]):
    if err_flag != 0:
        return
    err_flag = 1
    i: int32 = 0
    while msg[i] != 0 and i < 255:
        err_str[i] = msg[i]
        i = i + 1
    err_str[i] = 0
    ctl = CTL_RETURN
    ctl_val = v_undef()


