# lib/web/js/state.ad — part of the modular web engine (extracted from jsengine.ad).
# POOLS: all engine BSS pools (value/string/object/env/token/AST/regex), bump-allocated. The state-owner module every consumer imports.
#
# Behavior-preserving split: Adder is a single-compilation-unit language
# (merge_programs merges all imported files into one Program), so every
# public top-level name here resolves globally across the merged engine.

# ====================================================================
# POOLS (all BSS; bump-allocated).
# ====================================================================
MAX_VAL:  int32 = 1000000
v_tag: Array[1000000, uint8]
v_num: Array[1000000, float64]
v_ref: Array[1000000, int32]
n_vals: int32 = 4                 # 0..3 reserved for the singletons

# ====================================================================
# GARBAGE COLLECTOR (Phase 1: stop-the-world mark-sweep of the VALUE arena).
# ====================================================================
# A JS value is a bare int32 handle into the parallel v_* arenas. Before this,
# n_vals only ever bumped: allocation-heavy scripts (~400-500k allocs) exhausted
# the arena and failed. The collector reclaims dead value CELLS onto a free list
# that mk_val pops before bumping. Object/prop/env arenas stay bump-only this
# phase (see gc.ad). DEFAULT-OFF in practice: gc_hi_water starts at 80% of
# MAX_VAL, so any program that fit the arena before NEVER triggers a collection
# and stays byte-for-byte identical.
#
# Roots are marked WHOLESALE from every arena that can store a value handle (see
# gc_collect in gc.ad), so a value that lives in ANY arena slot is retained
# without a transitive graph walk. The only values not covered that way are
# handles held transiently in Adder native locals across a nested allocation;
# those are pinned explicitly via this root stack (gc_push/gc_popto) at the core
# interpreter sites, and collection is SUPPRESSED (gc_disabled) for the duration
# of any un-audited native/builtin call.
GC_ROOT_CAP: int32 = 4096
gc_root: Array[4096, int32]       # explicit pin stack of value handles
gc_top:  int32 = 0
v_mark:  Array[1000000, uint8]    # per-value mark bit (GC scratch; parallels v_*)
gc_free_head: int32 = -1          # intrusive free list head; chained through v_ref (-1 = empty)
gc_disabled:  int32 = 0           # >0 suppresses auto-collection (inside natives/builtins)
gc_stress:    int32 = 0           # test-only: force very frequent collection
GC_STRESS_GAP: int32 = 64         # stress: collect every ~this-many new allocations
GC_MIN_FREE:  int32 = 8192        # a collection freeing fewer cells "did not free enough"
GC_GROW:      int32 = 65536       # then raise the water mark by this before retrying
gc_base_water: int32 = 800000     # normal high-water (80% of MAX_VAL)
gc_hi_water:  int32 = 800000      # current high-water (raised on low-yield collections)
gc_last_freed: int32 = 0          # cells reclaimed by the most recent collection
gc_collections: int32 = 0         # total collections this run (stats/debug)

# EXTERNAL (embedder) VALUE PIN — see ext_pin in api.ad.
#
# The wholesale roots above cover every ENGINE arena, but NOT the embedder's own
# Adder-side tables: the DOM keeps JS handles in dom_obj / dom_clsobj /
# dom_on*_fn / evl_fn / mo_cb / cv_sstk_* / mrec_attr / g_cur_event, and the
# engine cannot see them. That was a latent live-free — unreachable in practice
# only because a page died on the OBJECT ceiling (13,086 turns of a render loop)
# long before it could allocate the 800,000 values a collection needs. Phase 5
# lifts that ceiling, so the gap became reachable and MEASURABLY broke a page:
# 200,000 turns of churn silently lost an addEventListener handler whose cell
# had been recycled underneath evl_fn.
#
# Every handle crossing the js_* API boundary therefore pins its VALUE CELL
# permanently, the same way it pins its object. A pinned cell is never swept, so
# nothing an embedder holds can be recycled underneath it, and no per-call-site
# audit in another module can be wrong. The cost is a leak bounded by the number
# of distinct handles the embedder ever touched — which is exactly the set that
# was already immortal before Phase 5.
v_pin: Array[1000000, uint8]      # 1 = permanently rooted (handle crossed the js_* API)
v_pin_hi: int32 = 0               # highest pinned index + 1 (bounds the js_init clear)


# Pin a value handle so a collection triggered during a nested allocation cannot
# free it while it is still held only in an Adder native local. Returns the new
# top so a caller can `gc_popto` back to it. Overflow is a stuck-open root (a
# bug): fail loudly rather than silently under-pin and later free a live value.
def gc_push(h: int32) -> int32:
    if gc_top >= GC_ROOT_CAP:
        set_error(cast[Ptr[uint8]]("gc root stack overflow"))
        return gc_top
    gc_root[gc_top] = h
    gc_top = gc_top + 1
    return gc_top


# Release every pin above slot `n` (paired with a `save = gc_top` at entry).
def gc_popto(n: int32):
    gc_top = n

MAX_STR: int32 = 400000
# SP_CAP is a CUMULATIVE LIFETIME BYTE BUDGET, NOT a live-set budget. Read that
# again before reaching for a bigger number: gc_collect_strings reclaims string
# IDs, but sp_top only ever moves FORWARD (the pool is non-moving because
# builtins hold raw `&sp_buf[...]` pointers across calls, and bld_begin/bld_end
# keeps an open [_bld_start, sp_top) span across a collection). Every string the
# program has EVER built still owns its bytes.
#
# Measured on the 284-page host corpus (peak sp_top per page, 800px):
#     mean                                        25,175 B   (0.3% of SP_CAP)
#     worst REAL page (realsites/google_search)  328,762 B   (3.9%,  25x headroom)
#     worst ordinary fixture (hambrowse_elbudget) 748,006 B  (8.9%,  11x headroom)
#     worst fixture overall (hambrowse_ceilings) 3,680,922 B (43.9%, 2.3x headroom)
# So for PAGE LOADS 8 MiB is comfortable and the constant is not the problem.
#
# What no constant fixes: `for (var i=0;i<N;i++) { s = "row-" + i }` exhausts
# the pool after ~520,000 iterations — about ONE SECOND of host CPU — because
# each iteration leaks ~16 B forever. 64 MiB would buy 8 seconds; 1 GiB about 2
# minutes. A long-lived SPA is the same story on a slower clock. The fix is BYTE
# reclamation (compacting sp_buf during gc_collect_strings, which first requires
# retiring the raw-pointer and open-builder assumptions above), not a larger
# SP_CAP. Until then the ceiling is deliberately LOUD: str_intern/emit_c report
# "[engine] CEILING string pool exhausted" and set a catchable error rather than
# corrupting BSS (scripts/test_jsengine_strpool_clean_host.sh pins that).
SP_CAP:  int32 = 8388608
sp_buf: Array[8388608, uint8]           # 8 MiB string pool (bump; freed only at js_init)
sp_top: int32 = 0
st_off: Array[400000, int32]
st_len: Array[400000, int32]
# UTF-16 fast-path cache, one byte per string id (see value.ad str_is_ascii):
#   0 = not yet computed, 1 = pure ASCII (byte index == UTF-16 index),
#   2 = has bytes >= 0x80 (indices must be converted).
# Computed LAZILY on the first index/length query, so the overwhelming majority
# of ids (identifiers, property keys, internal cstrings) never pay for it, and
# a string whose length is read repeatedly pays exactly one scan.
st_asc: Array[400000, uint8]
n_strs: int32 = 0

# ====================================================================
# GARBAGE COLLECTOR (Phase 4: NON-MOVING mark-sweep of the STRING ID TABLE).
# ====================================================================
# The string pool was bump-only, capping DISTINCT string allocations at MAX_STR
# (the id table) — the #1 remaining memory ceiling: string-heavy JS exhausted at
# ~200k allocations ("string pool exhausted"). Phase 4 reclaims dead string IDS
# onto a free list that str_new/bld_end pop before bumping n_strs, mirroring the
# value (Phase 1) and env (Phase 3) collectors' SOUNDNESS MODEL:
#
#   * NON-MOVING. Only the ID TABLE (st_off/st_len) is reclaimed; sp_buf BYTES
#     are NEVER moved or freed (a reclaimed id's bytes are orphaned — a bounded
#     LEAK). This is the crucial safety property. String IDS are stable handles
#     indirected through st_off[id], and because bytes never move, every raw
#     sp_buf offset/pointer any code holds stays valid across a collection: the
#     regex subject/source cursors, the bld cursor `_bld_start` held across an
#     entire (even getter-invoking) string build, every str_ptr() result, and the
#     `&sp_buf[st_off[sid]+j]` copy-sources callers pass STRAIGHT INTO str_new.
#     A COMPACTING (byte-reclaiming) collector would invalidate all of those; it
#     is deliberately NOT shipped (see docs/js_string_gc_compaction_plan.md).
#   * WHOLESALE ROOTS. Every id referenced from a value (v_ref of a TAG_STR
#     cell), a property key (p_key), a binding name (b_name), the PERMANENT AST
#     (n_str + the secondary sid fields n_a/n_b/n_c/n_d — the parser stores
#     regex-flag / template-raw / import-export-name sids there; marking those
#     four fields WHOLESALE cannot miss an AST sid, and a field that actually
#     holds a child-node id just PINS that string id: a harmless leak, never a
#     free-of-live), the token arrays (tk_str/tk_str2), a module specifier
#     (mod_spec), a fetch fixture field (fx_*), a break/continue label
#     (ctl_label/pending_label), or a native method-name payload
#     (obj_p_a/obj_p_b) is retained WITHOUT a transitive walk. Conservative: may
#     retain floating garbage, can never free a still-referenced string.
#   * SUPPRESSION for transients. The only ids not covered wholesale are held in
#     Adder native locals across a nested allocation. Every string/array/regex/
#     object builtin already runs with gc_disabled > 0 (interp.ad native
#     dispatch), so a string collection can never fire while a builtin's un-rooted
#     sid is live. The core build helpers (to_string_val/strid_concat/template)
#     keep their operands live as TAG_STR VALUE handles or AST n_str for the whole
#     build, so those ids stay rooted via the value/AST scan.
#   * TRIGGER at str_new/bld_end ENTRY only — never mid-build, and never at
#     mk_val (which would race the `h = mk_val(); v_ref[h] = sid` window inside
#     v_string_id, where the just-built sid is momentarily un-rooted). Default
#     str_hi_water is 80% of MAX_STR, so a program that fit the id table before
#     NEVER triggers and stays byte-for-byte identical.
str_mark:  Array[400000, uint8]   # per-id mark bit (GC scratch; parallels st_*)
str_free_head: int32 = -1         # free-id list head; chained through st_off (-1 = empty)
STR_STRESS_GAP: int32 = 64        # stress: collect every ~this-many new string ids
STR_MIN_FREE:  int32 = 8192       # a collection freeing fewer ids "did not free enough"
STR_GROW:      int32 = 16384      # then raise the string water mark by this before retrying
str_base_water: int32 = 320000   # normal string high-water (80% of MAX_STR)
str_hi_water:  int32 = 320000    # current string high-water (raised on low-yield collections)
str_last_freed: int32 = 0         # ids reclaimed by the most recent string collection
str_collections: int32 = 0        # total string collections this run (stats/debug)

# Real sites (Google, etc.) ship — and eval() — large minified bundles: the
# Google SERP bootstrap eval()s a single ~67 KB generated string that lexes to
# ~37 000 tokens / a comparable number of AST nodes. A cap of 30 000 truncated
# that mid-expression and surfaced as a spurious "unexpected token" SyntaxError
# that blanked the page.
#
# Sizing, measured on a live google.com snapshot (2026-07-25): minified JS costs
# ~1 AST node per 2.9 source bytes and ~1 token per 1.9 bytes. Google's homepage
# ships 14 inline scripts; the largest that a browser must actually run is
# 233 KB => 81 695 nodes / 121 865 tokens.
#
# The NODE arena is CUMULATIVE for the whole document (nodes are bump-allocated
# and can never be freed — a closure from script 1 still points at its function
# node when script 14 runs), so it must hold the SUM of every script on the page.
# At 131 072 google's later scripts ran out of room and died with "script too
# large", taking the globals they define (`Ti`, `_DumpException`, …) with them.
# 262 144 covers google's whole page with headroom. The TOKEN arena is reset per
# script, so it only needs the largest SINGLE script.
MAX_NODE: int32 = 262144
n_kind: Array[262144, uint8]
n_a:    Array[262144, int32]
n_b:    Array[262144, int32]
n_c:    Array[262144, int32]
n_d:    Array[262144, int32]
n_next: Array[262144, int32]
n_str:  Array[262144, int32]
n_op:   Array[262144, int32]
n_num:  Array[262144, float64]
n_nodes: int32 = 0

MAX_TOK: int32 = 262144
tk_kind: Array[262144, uint8]
tk_num:  Array[262144, float64]
tk_str:  Array[262144, int32]
tk_str2: Array[262144, int32]       # secondary string id (regex flags)
n_toks:  int32 = 0
tk_pos:  int32 = 0

# ---- REGEX pools (all BSS; compiled programs persist for the run) ----
MAX_REPROG: int32 = 40000
re_op: Array[40000, int32]
re_x:  Array[40000, int32]
re_y:  Array[40000, int32]
re_n:  int32 = 0                   # next free program slot

MAX_RENODE: int32 = 20000          # regex AST scratch (reset per compile)
rn_op:   Array[20000, int32]
rn_a:    Array[20000, int32]
rn_b:    Array[20000, int32]
rn_c:    Array[20000, int32]
rn_d:    Array[20000, int32]
rn_next: Array[20000, int32]
rn_n: int32 = 0

MAX_RECLS: int32 = 4096            # char classes; 32-byte (256-bit) bitmap each
cls_bits: Array[131072, uint8]     # 4096 * 32
cls_neg:  Array[4096, uint8]
n_cls: int32 = 0

RE_CAP_MAX: int32 = 128            # 64 groups * 2 slots
re_cap: Array[128, int32]

# ---- named capture groups `(?<name>...)` (persist for the run) ----
# One row per named group across ALL compiled regexes (bump-allocated); each
# regex object records its [start,count) slice so exec() can build `.groups`.
RE_GNAME_CAP: int32 = 512
gname_idx:  Array[512, int32]      # capture index of this named group
gname_soff: Array[512, int32]      # name bytes: offset into gname_buf
gname_slen: Array[512, int32]      # name length
gname_n:    int32 = 0
gname_buf:  Array[8192, uint8]
gname_buf_n: int32 = 0
gname_compile_start: int32 = 0     # gname_n at the start of the current compile
lb_target:  int32 = 0              # lookbehind: subject pos the child must end at

# replace() is two-phase: resolve every replacement string id FIRST (a user
# replacer function does its own string-building, which cannot run while our
# result builder holds the shared build cursor), then assemble in one pass.
MAX_REP: int32 = 16384
rep_start: Array[16384, int32]
rep_end:   Array[16384, int32]
rep_id:    Array[16384, int32]

# regex compile/match transient state
rc_off: int32 = 0                  # source byte offset (into sp_buf)
rc_len: int32 = 0                  # source length
rc_i:   int32 = 0                  # source cursor
re_gcount: int32 = 0               # capture groups seen during compile
re_ic:  int32 = 0                  # ignore-case (compile + match)
re_ml:  int32 = 0                  # multiline
re_da:  int32 = 0                  # dotAll (`s` flag): `.` also matches newline
re_uni: int32 = 0                  # unicode (`u`/`v` flag): \u{cp} code-point escapes,
                                   #   surrogate-pair combining, \p{...} property classes
rx_off: int32 = 0                  # subject byte offset (into sp_buf)
rx_len: int32 = 0                  # subject length
rx_matchend: int32 = 0             # end position set by a successful match

MAX_OBJ: int32 = 40000
obj_kind: Array[40000, uint8]
obj_head: Array[40000, int32]     # prop chain head (-1)
obj_fn_node:   Array[40000, int32]
obj_fn_env:    Array[40000, int32]
obj_fn_native: Array[40000, int32]
arr_len:  Array[40000, int32]
arr_cap:  Array[40000, int32]
arr_base: Array[40000, int32]     # offset into ax_val
obj_proto:    Array[40000, int32] # [[Prototype]] chain: another object id, or -1
obj_fn_this:  Array[40000, int32] # arrow: captured lexical `this` handle; -2 = not-arrow
obj_fn_home:  Array[40000, int32] # method/ctor: home prototype object id (for `super`); -1 none
obj_fn_super: Array[40000, int32] # class constructor: superclass function VALUE handle; -1 none
obj_fn_btarget: Array[40000, int32] # bound function (.bind): target function VALUE handle; -1 = not bound
obj_fn_bthis:  Array[40000, int32] # bound function: the bound `this` VALUE handle
obj_fn_bargs:  Array[40000, int32] # bound function: JS array handle of pre-applied args, or -1
obj_class:    Array[40000, uint8] # bit0 = class constructor, bit1 = default (implicit) constructor
obj_class_node: Array[40000, int32] # class constructor: ND_CLASS node id (for instance-field init), else -1
obj_re_prog:  Array[40000, int32] # regex object: start pc of compiled program, else -1
obj_re_ncap:  Array[40000, int32] # regex object: number of capture groups
obj_re_flags: Array[40000, int32] # regex object: bit0=g, bit1=i, bit2=m
obj_re_gnstart: Array[40000, int32] # regex object: first named-group row (gname_*)
obj_re_gncount: Array[40000, int32] # regex object: number of named groups
obj_is_date:  Array[40000, uint8] # 1 if this object is a Date instance
obj_date_ms:  Array[40000, float64] # Date instance: epoch-ms as float64 (exact for integer ms)
# ---- Map / Set state (indexed by object id; obj_map_kind gates the rest) ----
obj_frozen:   Array[40000, uint8]  # 1 if Object.freeze'd (writes/adds are dropped)
obj_nonext:   Array[40000, uint8]  # 1 if Object.preventExtensions/seal'd (adds dropped, existing writes OK)
obj_map_kind: Array[40000, uint8]  # 0 none, 1 Map, 2 Set
obj_ms_head:  Array[40000, int32]  # first entry index in the mse_* pool (-1)
obj_ms_tail:  Array[40000, int32]  # last entry index (O(1) append), -1
obj_ms_size:  Array[40000, int32]  # live (non-deleted) entry count
# ---- Promise state (indexed by object id; obj_is_prom gates the rest) ----
obj_is_prom:  Array[40000, uint8] # 1 if this object is a Promise instance
prom_state:   Array[40000, uint8] # 0 pending, 1 fulfilled, 2 rejected
prom_result:  Array[40000, int32] # settled value (fulfilled) / reason (rejected)
prom_react:   Array[40000, int32] # head of the pending-reaction list (-1 = none)
prom_alreadyres: Array[40000, uint8] # resolution-procedure guard (settle-once)
# generic per-native-function-object payload: for a resolve/reject closure it is
# the target promise obj id; for a combinator hook it is (comb cell id, index);
# for a finally wrapper it is the user callback value handle.
obj_p_a:      Array[40000, int32]
obj_p_b:      Array[40000, int32]
# ---- Proxy state (round 7). obj_proxy_target >= 0 gates a proxy exotic object;
# both hold VALUE handles (target object value, handler object value). Common
# traps (get/set/has/deleteProperty/ownKeys) route through member_get/set,
# op_in, eval_delete, and object_keys; apply/construct traps are NOT wired. ----
obj_proxy_target:  Array[40000, int32]   # target VALUE handle, or -1 = not a proxy
obj_proxy_handler: Array[40000, int32]   # handler VALUE handle
# ---- Typed-array + ArrayBuffer state (round 7). ----
# ArrayBuffer: obj_ab_off >= 0 gates it; a [off,off+len) slice of the ta_bytes pool.
obj_ab_off:  Array[40000, int32]    # byte offset into ta_bytes, or -1 = not an ArrayBuffer
obj_ab_len:  Array[40000, int32]    # byte length
# TypedArray view: obj_ta_kind != 0 gates it; a typed window over an ArrayBuffer.
obj_ta_kind: Array[40000, uint8]    # element type code TA_* (0 = not a typed array)
obj_ta_buf:  Array[40000, int32]    # backing ArrayBuffer VALUE handle
obj_ta_off:  Array[40000, int32]    # byte offset of element 0 within the buffer
obj_ta_len:  Array[40000, int32]    # element count
n_objs: int32 = 0

# ====================================================================
# GARBAGE COLLECTOR (Phase 5: TRACING mark-sweep of the OBJECT arena).
# ====================================================================
# The object arena was bump-only. MEASURED on the ordinary render-loop shape
# (one closure + one object literal + one array per turn, O(1) live set):
#
#     60000-turn loop -> "object pool exhausted" at 13,086 turns
#     ARENA objs=40000 objmax=40000
#
# so MAX_OBJ was the binding constraint for any long-running page — and unlike
# the value/env/string arenas NO trigger tweak could help, because the value
# collector's roots are WHOLESALE (it marks p_val/ax_val/b_val over the entire
# arena regardless of who owns the slot) and therefore carry no reachability
# information at all: every object ever allocated stays "reachable".
#
# Phase 5 is the first collector in this engine that actually TRACES. Its
# soundness model differs from Phases 1/3/4 in exactly one way — it must be
# PRECISE about ownership (props / array slots / Map entries are reached only
# FROM a live owner object) or it reclaims nothing — so the root set has to be
# provably complete rather than conservatively wholesale:
#
#   * NON-MOVING mark-sweep, never mark-compact. Object IDS are stable raw
#     handles stored where a compactor could not fix them up: obj_proto /
#     obj_fn_home / curfn_stack / home_stack / native_self / gen_collect /
#     join_stack / sc_src / pr_source hold bare ids, every builtin holds ids in
#     Adder locals across nested calls, and the embedder (the DOM) holds value
#     handles whose v_ref is an id. The same constraint that keeps the string
#     pool non-moving (raw sp_buf pointers) binds here, harder. Slots are
#     recycled through a free list; nothing ever moves.
#   * ROOTS — the complete set of places an object can be named WITHOUT going
#     through another live object (enumerated in gc_collect_objs): the gc_root
#     pin stack, every binding value (b_val, conservative over env liveness — a
#     freed binding's b_val is CLEARED so it cannot pin), the call-arg / this /
#     new.target stacks, ctl_val / throw_val / mset_*, Map-Set entries, promise
#     reaction + combinator cells, the timer queue, module namespaces, every g_*
#     builtin global, the raw-id stacks (curfn / home / native_self /
#     gen_collect / join_stack / sc_src / pr_source), and EXTERNAL handles.
#   * EXTERNAL HANDLES ARE PINNED, NOT TRACKED. Every object value handle that
#     crosses the public js_* API boundary — in either direction — sets
#     obj_pin[id] permanently (api.ad ext_pin). That is what makes the collector
#     safe for the BROWSER without auditing the ~33 embedder call sites that
#     hold a JS handle in an Adder local across a js_call_fn / js_eval: such a
#     handle is immortal by construction, so a collection triggered deep inside
#     the callback it is held across cannot free it. The cost is a LEAK of
#     embedder-touched objects (DOM wrappers, event objects) — exactly the
#     status quo ante, never a corruption — while objects created and dropped
#     purely inside JS (the render-loop shape) are reclaimed.
#   * SUPPRESSION. The trigger sits at obj_new entry and is gated on
#     gc_disabled == 0, so a collection can never fire while an un-audited
#     builtin holds a raw object id in an Adder local. (Unlike the ENV arena,
#     which has no such exposure, objects are handled by every builtin.)
#   * CYCLES terminate: marking is a worklist trace (obj_work), never recursion,
#     and an object is pushed at most once (marked on push).
obj_mark:  Array[40000, uint8]    # per-object mark bit (GC scratch)
obj_freed: Array[40000, uint8]    # 1 while the slot sits on the object free list
obj_pin:   Array[40000, uint8]    # 1 = permanently rooted (handle crossed the js_* API)
obj_free_head: int32 = -1         # free-slot list head; chained through obj_head (-1 = empty)
OBJ_WORK_CAP: int32 = 40000
obj_work: Array[40000, int32]     # mark worklist (bounded by MAX_OBJ: each id enters once)
obj_work_n: int32 = 0
OBJ_STRESS_GAP: int32 = 64        # stress: collect every ~this-many new objects
OBJ_MIN_FREE:  int32 = 4096       # a collection freeing fewer slots "did not free enough"
OBJ_GROW:      int32 = 4000       # then raise the object water mark by this before retrying
obj_base_water: int32 = 32000     # normal object high-water (80% of MAX_OBJ)
obj_hi_water:  int32 = 32000      # current object high-water (raised on low-yield collections)
obj_last_freed: int32 = 0         # slots reclaimed by the most recent object collection
obj_collections: int32 = 0        # total object collections this run (stats/debug)
# Object collection is DISARMED until js_init has finished installing the
# builtins: setup.ad builds hundreds of prototype objects whose value handles
# live only in Adder locals until they are stored into a g_* global, and those
# locals are not on the gc_root pin stack. Nothing collectable exists that early
# anyway, so arming at the end of js_init costs nothing and closes the window.
obj_gc_armed: int32 = 0
# Reclaimed PROPERTY slots (freed with their owner object) — a free list that
# obj_set / obj_define_accessor pop before bumping n_props. Chained through
# p_next; a slot on the list has p_key = -1 and p_val / p_get / p_set cleared so
# neither the wholesale value scan nor the string scan can pin through it.
prop_free_head: int32 = -1
# Reclaimed ARRAY-STORAGE blocks, bucketed by capacity (always 4 << k: arr_grow
# only ever allocates a power of two >= 4). ax_val[base] of a free block links
# to the next free block of the same class. ONLY blocks freed by the collector
# (i.e. belonging to a DEAD object) are recycled — a block abandoned by
# arr_grow's move path belongs to a LIVE array whose base a caller may still
# hold in a local, so recycling THAT would turn a stale-base read into a
# live-data corruption instead of a harmless read of abandoned bytes.
AX_CLASSES: int32 = 24
ax_free: Array[24, int32]

# ---- typed-array byte backing store (bump; freed only at js_init) ----
TA_BYTES_CAP: int32 = 8388608       # 8 MiB shared across all ArrayBuffers
ta_bytes: Array[8388608, uint8]
ta_bytes_top: int32 = 0

# ---- structuredClone visited map (cycle handling; reset per top-level call) ----
SC_SEEN_CAP: int32 = 8192
sc_src: Array[8192, int32]          # source object id already cloned
sc_dst: Array[8192, int32]          # its clone VALUE handle
sc_n: int32 = 0
sc_depth: int32 = 0                 # recursion guard

# TypedArray element-type codes (also the per-view obj_ta_kind value).
TA_INT8:    int32 = 1
TA_UINT8:   int32 = 2
TA_UINT8C:  int32 = 3               # Uint8ClampedArray
TA_INT16:   int32 = 4
TA_UINT16:  int32 = 5
TA_INT32:   int32 = 6
TA_UINT32:  int32 = 7
TA_FLOAT32: int32 = 8
TA_FLOAT64: int32 = 9

# ---- Promise reaction records (a pending .then registration) ----
PROM_REACT_CAP: int32 = 16384
pr_onful:  Array[16384, int32]    # onFulfilled handler value (-1 = pass through)
pr_onrej:  Array[16384, int32]    # onRejected handler value (-1 = pass through)
pr_result: Array[16384, int32]    # dependent (result) promise VALUE handle
pr_source: Array[16384, int32]    # source promise obj id (read for state+value)
pr_next:   Array[16384, int32]    # next reaction in the source's pending list;
                                  # doubles as the FREE-LIST link while free
pr_n: int32 = 0
#
# SLOT REUSE (see pr_alloc / pr_free_slot in builtins/promise.ad). This pool was
# BUMP-ONLY too, so a `.then` chain died at PROM_REACT_CAP registrations — the
# second silent ceiling under every async page.
#
# RETENTION ARGUMENT — a reaction id has exactly ONE owner at any moment, and it
# is never the GC that decides:
#   * REGISTERED on a still-pending promise: the id is in that promise's
#     prom_react list (reached only from the promise, traced by obj_gc_trace).
#   * SCHEDULED: the settle path (promise_fulfill / promise_reject) walks the list,
#     schedules every record and then sets prom_react = -1, so a scheduled record
#     is NOT in any list — its only reference is a NUMBER inside the microtask
#     timer's timer_args. That number is invisible to both collectors (it is not a
#     value handle), which is exactly why liveness here CANNOT be a GC question.
#   * Each id is therefore scheduled AT MOST ONCE, ever: from the settle walk (the
#     list is cleared) or from promise_then's already-settled branch (never listed).
#   * So the free points are: the END of run_reaction (the single consumer has
#     finished with it — after resolve_promise, which may allocate records itself)
#     and obj_gc_free (the source promise is unreachable, so it can never settle
#     and the records in its list can never be scheduled). The two are disjoint.
#   * run_reaction additionally REJECTS a record whose pr_source is -1 (i.e. a
#     freed one), so a double-schedule bug reports itself instead of silently
#     running a recycled record.
<<<<<<< HEAD
#
# pr_sched SPLITS the two ownerships above, and that is what makes the OBJECT
# collector precise here. It used to root every record over 0..pr_n WHOLESALE,
# including a record merely REGISTERED on a promise nobody can reach any more —
# and since the promise roots the record (prom_react) while the wholesale scan
# rooted the promise back (pr_source), an abandoned `new Promise(() => {})` with
# a .then on it was IMMORTAL, one dead promise + handler closure + dependent
# promise per registration. That is the leak behind "object pool exhausted" in a
# page that fires requests it never gets answers to. Only a SCHEDULED record is
# rooted wholesale now (it must be: its one reference is an invisible number in
# a timer arg); a REGISTERED one is reached through its live owner by
# obj_gc_trace, and freed by obj_gc_free when that owner dies.
pr_sched:  Array[16384, uint8]    # 1 = handed to the microtask queue (rooted wholesale)
