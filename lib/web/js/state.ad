pr_free_head: int32 = -1
pr_live:      int32 = 0           # reaction records currently outstanding
pr_live_hi:   int32 = 0           # high-water of pr_live
pr_recycled:  int32 = 0           # records served off the free list
pr_overflow:  int32 = 0           # .then registrations DROPPED (pool full)
pr_noted:     int32 = 0           # one-shot latch for the CEILING report

# ---- Promise combinator cells (Promise.all / race / allSettled shared state) ----
COMB_CAP: int32 = 4096
comb_result:    Array[4096, int32]   # result promise VALUE handle
comb_remaining: Array[4096, int32]   # count still to settle (all / allSettled)
comb_results:   Array[4096, int32]   # results ARRAY value (all / allSettled)
comb_kind:      Array[4096, uint8]   # 0 = all, 1 = race, 2 = allSettled
comb_n: int32 = 0

# ---- resolver "alreadyCalled" cells shared by a resolve/reject closure pair ----
RES_FLAG_CAP: int32 = 16384
res_flag: Array[16384, uint8]
res_flag_n: int32 = 0

# ---- fetch() fixture table (deterministic data source; no network) ----
# Each __setFetchFixture(url, {...}) registration is one row keyed by the url
# STRING id. fetch(url) scans for a matching url and settles a Response from the
# row; an unmatched url REJECTS (so .catch fires). A row with status 0 models a
# network error (reject). This is the sole data source on BOTH targets — the
# engine is extern-free by mandate, so on-device http lives in a front-end.
FETCH_FIXTURE_CAP: int32 = 512
fx_url:    Array[512, int32]   # url string id (key)
fx_status: Array[512, int32]   # HTTP status number (0 = network error -> reject)
fx_stext:  Array[512, int32]   # statusText string id
fx_body:   Array[512, int32]   # response body string id
fx_ctype:  Array[512, int32]   # content-type header string id
fx_n: int32 = 0

# ---- Map/Set entry pool (append-only; insertion order preserved; delete marks
# an entry unused so iteration order is stable and `.size` stays exact). ----
MS_CAP: int32 = 131072
mse_key:  Array[131072, int32]    # entry key value handle
mse_val:  Array[131072, int32]    # entry value handle (Set: same as key)
mse_used: Array[131072, uint8]    # 1 = live, 0 = deleted
mse_next: Array[131072, int32]    # next entry index in insertion order (-1);
                                  # doubles as the FREE-LIST link while free
mse_n: int32 = 0
#
# SLOT REUSE (see ms_alloc in builtins/collections.ad, obj_gc_free in gc.ad).
# Entries owned by a DEAD Map/Set go on a free list, so the `new Map()` per turn
# shape stops being a hard ceiling.
#
# RETENTION ARGUMENT — and what is deliberately NOT reclaimed:
#   * Freed ONLY from obj_gc_free, i.e. when the owning Map/Set object is proven
#     unreachable by the tracing object collector. obj_gc_free then clears
#     obj_ms_head/tail, so no live list can reach the freed entries, and
#     obj_gc_trace only ever walks a LIVE owner's list.
#   * A `.delete()`d entry is still only marked mse_used = 0 and LEFT IN the
#     owner's list. That is not an oversight: ms_forEach / the iterators hold a
#     raw entry index in an Adder local across arbitrary JS (the callback), and
#     `m.delete(k)` from inside a forEach is ordinary JS. Unlinking + freeing
#     there would repurpose mse_next as a free link under a walk in progress —
#     a live-free. Reclaiming per-delete needs the iterators to hold something
#     revalidatable first; until then a delete-heavy long-lived Map still counts
#     against MS_CAP, and now says so out loud when it runs out.
mse_free_head: int32 = -1
mse_live:      int32 = 0          # entries currently allocated (occupancy)
mse_live_hi:   int32 = 0          # high-water of mse_live
mse_recycled:  int32 = 0          # entries served off the free list
mse_overflow:  int32 = 0          # Map/Set insertions DROPPED (pool full)
mse_noted:     int32 = 0          # one-shot latch for the CEILING report

MAP_KIND_NONE: int32 = 0
MAP_KIND_MAP:  int32 = 1
MAP_KIND_SET:  int32 = 2

MAX_PROP: int32 = 400000
p_next: Array[400000, int32]
p_key:  Array[400000, int32]      # string id
p_val:  Array[400000, int32]
p_acc:  Array[400000, uint8]      # 1 = accessor property (p_get/p_set), 0 = data (p_val)
p_get:  Array[400000, int32]      # accessor getter function VALUE handle, or -1
p_set:  Array[400000, int32]      # accessor setter function VALUE handle, or -1
# ES property ATTRIBUTES, one bitmask per property slot:
#   bit0 PF_ENUM  — [[Enumerable]]: shows in for-in / Object.keys|values|entries /
#                   JSON.stringify / Object.assign / object spread / rest.
#   bit1 PF_WRITE — [[Writable]]: a plain data write is a silent no-op without it.
#   bit2 PF_CONF  — [[Configurable]]: `delete` is a no-op without it.
# Ordinary assignment creates 7 (all set). Object.defineProperty is the ONLY way
# to clear a bit from JS, and — per ES OrdinaryDefineOwnProperty — an ABSENT
# attribute in a descriptor defaults to FALSE for a NEW property and LEAVES the
# existing value alone for an existing one. Engine-internal installs (builtin
# methods, `Function.prototype.constructor`, class methods) clear PF_ENUM to
# match the spec's non-enumerable built-ins.
p_flags: Array[400000, uint8]
n_props: int32 = 0

MAX_ENV: int32 = 80000
env_parent:  Array[80000, int32]
env_head:    Array[80000, int32]
env_is_func: Array[80000, uint8]
n_envs: int32 = 0

MAX_BIND: int32 = 250000
b_next:  Array[250000, int32]
b_name:  Array[250000, int32]
b_val:   Array[250000, int32]
b_const: Array[250000, uint8]
n_binds: int32 = 0

# ---- Phase 3 GC: ENV (scope) arena reclamation ----------------------------
# The env arena was bump-only, capping total user-callback invocations / deep
# recursion at MAX_ENV. Phase 3 reclaims dead scope envs (and their bindings)
# with a mark-sweep that mirrors the value collector's SOUNDNESS MODEL:
#
#   * WHOLESALE ROOTS. Envs are rooted by g_env, every mod_env[], and every
#     live closure's obj_fn_env (objects are never freed, so ALL obj_fn_env
#     are marked wholesale). The env forest has env_parent[child] < child
#     (parent created first, no cycles), so ONE descending pass over
#     [n_envs-1 .. 0] marking each marked env's parent completes the closure.
#   * PINNED ACTIVE ENVS. The currently-executing call/block/loop/catch/switch
#     envs are threaded ONLY as the `env` parameter through exec_stmt/eval_expr
#     recursion — reachable from NO arena. EVERY such active env is pinned on
#     the env_root stack (env_push/env_popto) at its env_new site, for exactly
#     as long as its frame is on the dynamic stack. A missed active-env pin is
#     a live-free (corruption); a stale pin only leaks. Overflow HARD-ERRORS.
#   * BINDING mark stays WHOLESALE in the value collector (b_val over 0..n_binds
#     incl. freed binds) — over-marking a freed binding's stale value is a
#     harmless leak, never a corruption.
env_mark:    Array[80000, uint8]  # per-env mark bit (GC scratch; parallels env_*)
env_freed:   Array[80000, uint8]  # 1 while the env sits on the env free list
env_free_head: int32 = -1         # free-env list head; chained through env_parent (-1 = empty)
bind_free_head: int32 = -1        # free-binding list head; chained through b_next (-1 = empty)
# Active-env pin stack — exact analog of gc_root/gc_top for the ENV arena.
ENV_ROOT_CAP: int32 = 100000
env_root: Array[100000, int32]
env_gc_top: int32 = 0
# Trigger policy (mirrors the value arena's gc_hi_water machinery).
ENV_STRESS_GAP: int32 = 16        # stress: collect every ~this-many new envs
ENV_MIN_FREE:  int32 = 4096       # a collection freeing fewer envs "did not free enough"
ENV_GROW:      int32 = 8000       # then raise the env water mark by this before retrying
env_base_water: int32 = 72000     # normal env high-water (near the 80000 ceiling)
env_hi_water:  int32 = 72000      # current env high-water (raised on low-yield collections)
env_last_freed: int32 = 0         # envs reclaimed by the most recent env collection
env_collections: int32 = 0        # total env collections this run (stats/debug)


# Pin an active env so an env collection triggered during a nested env/value
# allocation cannot free it while its frame is still on the dynamic stack.
# Overflow is a stuck-open pin (a bug): fail loudly rather than under-pin and
# later live-free an active scope.
def env_push(e: int32):
    if env_gc_top >= ENV_ROOT_CAP:
        set_error(cast[Ptr[uint8]]("env root stack overflow"))
        return
    env_root[env_gc_top] = e
    env_gc_top = env_gc_top + 1


# Release every env pin above slot `n` (paired with `esave = env_gc_top` at entry).
def env_popto(n: int32):
    env_gc_top = n

MAX_AX: int32 = 1000000
ax_val: Array[1000000, int32]      # array element storage (bump; grows on top in place)
ax_top: int32 = 0

OUT_CAP: int32 = 4194304
out_buf: Array[4194304, uint8]          # 4 MiB console.log accumulation buffer
out_top: int32 = 0

MAX_CALLARG: int32 = 8192
call_args: Array[8192, int32]
call_top: int32 = 0

MAX_THIS: int32 = 20000
this_stack: Array[20000, int32]
home_stack: Array[20000, int32]   # home prototype (for `super`) per active frame
curfn_stack: Array[20000, int32]  # object id of the function currently executing
newtarget_stack: Array[20000, int32]  # per-frame `new.target` value (0/v_undef when not a construct call)
pending_newtarget: int32 = 0      # new.target to hand the NEXT ordinary-function frame (set by eval_new)
# Per-frame snapshot of the caller's evaluated-arg window (call_args base + count),
# so a body's bare `arguments` can be materialized LAZILY (only when referenced —
# no per-call allocation). argc = -1 marks a frame with no `arguments` (arrows,
# class field/static-init frames). The arg slots stay live for the whole body
# because eval_call only reclaims them (call_top = base) AFTER invoke returns.
argbase_stack: Array[20000, int32]
argc_stack: Array[20000, int32]
this_top: int32 = 0

# thrown value (CTL_THROW). throw_val holds the exception handle.
throw_val: int32 = 0

# ---- async/await parse state ----
# in_async is nonzero while parsing an async function body, so `await` is only
# treated as a keyword there (elsewhere `await` stays a plain identifier).
# pending_async is set by a caller immediately before a function/arrow parse to
# tell the parse routine that the function it is about to build is `async`.
in_async: int32 = 0
pending_async: int32 = 0

# ---- generator parse state ----
# in_gen is nonzero while parsing a generator (`function*`) body, so `yield` is
# only treated as a keyword there (elsewhere `yield` stays a plain identifier).
# pending_gen is set by a caller immediately before a function parse to tell the
# routine that the function it is about to build is a generator.
in_gen: int32 = 0
pending_gen: int32 = 0

# template-literal lexer state (nested interpolations)
MAX_TMPL: int32 = 64
tmpl_bdepth: Array[64, int32]     # object-brace depth inside the top interpolation
tmpl_sp: int32 = 0

SRC_CAP: int32 = 262144

# global roots / state
g_env:    int32 = 0               # global environment id
g_global_obj: int32 = 0           # the global object (host bindings)
g_math:   int32 = 0
g_json:   int32 = 0
g_object: int32 = 0
g_console: int32 = 0
g_array:  int32 = 0
g_function: int32 = 0              # the Function constructor value (for `instanceof Function`)
g_number: int32 = 0
g_bigint: int32 = 0                # the BigInt() conversion function value
g_promise: int32 = 0               # the Promise constructor value
g_promise_proto: int32 = 0         # Promise.prototype (holds then/catch/finally)
g_promise_job: int32 = 0           # shared native fn value for a reaction microtask
g_sym_iterator: int32 = 0          # the well-known Symbol.iterator VALUE handle (for the iteration protocol)
g_sym_async: int32 = 0             # the well-known Symbol.asyncIterator VALUE handle (for-await-of protocol)
g_prim_key: int32 = -1             # interned "@@prim" key: a wrapper's [[PrimitiveValue]] slot
g_sym_toprim: int32 = 0            # the well-known Symbol.toPrimitive VALUE handle (ToPrimitive override)
g_sym_tostringtag: int32 = 0       # the well-known Symbol.toStringTag VALUE handle (Object.prototype.toString)
# ToPrimitive re-entrancy guard. The engine has no JS call-depth limit, so a
# self-referential conversion (`{valueOf(){ return ""+this }}`) would ride the
# HOST C stack into a segfault. Cap the nesting and throw the same RangeError a
# real engine would.
toprim_depth: int32 = 0
TOPRIM_MAX_DEPTH: int32 = 64
# Array.prototype.join cycle guard: object ids whose join is in progress. A
# self-containing array (`a=[1]; a.push(a)`) must render the cyclic element as
# the empty string (what every engine does), not recurse forever.
JOIN_STACK_CAP: int32 = 64
join_stack: Array[64, int32]
join_depth: int32 = 0
g_gen_proto: int32 = 0             # shared prototype object for generator instances (next/return/throw/@@iterator)
# Real builtin prototype OBJECTS. Their methods are genuine native-function VALUES
# (not just name-dispatch), so the transpiled idioms `Array.prototype.slice.call`,
# `Object.prototype.toString.call`, `hasOwnProperty.call`, `Function.prototype.call.bind`
# all resolve as first-class values. Array instances chain their [[Prototype]] here
# so `[].slice === Array.prototype.slice`.
g_object_proto: int32 = 0
# Error.prototype. Held as a global so Object.prototype.toString can brand any
# object whose [[Prototype]] chain reaches it as "[object Error]" (node's
# [[ErrorData]] slot), and so install_error can share one toString.
g_error_proto: int32 = 0
g_regexp_proto: int32 = 0          # RegExp.prototype (regex instances chain here)
g_array_proto: int32 = 0
g_func_proto: int32 = 0
g_string_proto: int32 = 0
g_number_proto: int32 = 0
g_boolean_proto: int32 = 0
# Per-kind TypedArray.prototype VALUE handles (indexed by TA_* element code, 1..9);
# make_typed_array links a fresh view's [[Prototype]] to the matching entry.
g_ta_proto: Array[16, int32]
native_self: int32 = -1            # obj id of the native fn currently being invoked

# ---- generator instance state (indexed by object id; obj_is_gen gates the rest) ----
# The tree-walker cannot reify a resumable C-stack, so generators use a BOUNDED
# EAGER model: calling a generator runs its whole body once, materializing every
# yielded value into gen_buf (an ordinary JS array); .next() then REPLAYS that
# buffer. Limits: side effects run at call time (not lazily per .next()); two-way
# .next(v) communication is unsupported (yield evaluates to undefined); an
# unbounded generator is capped at GEN_YIELD_CAP yields.
obj_is_gen: Array[40000, uint8]    # 1 if this object is a generator instance
gen_buf:    Array[40000, int32]    # materialized yielded-values ARRAY value handle
gen_idx:    Array[40000, int32]    # replay cursor into gen_buf
gen_done:   Array[40000, uint8]    # 1 once exhausted / returned / thrown
gen_ret:    Array[40000, int32]    # the generator body's `return` value handle

# ---- generator body-collection state (active only while running a gen body) ----
# gen_collect is the obj id of the array currently being filled by `yield`, or -1
# when not inside a generator body. Saved/restored across nested generator calls.
GEN_YIELD_CAP: int32 = 10000
gen_collect: int32 = -1
gen_count: int32 = 0
iter_result_done: int32 = 0        # set by iter_next(): 1 when the iterator reported done

ctl:      int32 = 0               # CTL_*
ctl_val:  int32 = 0               # return value handle
ctl_label: int32 = -1             # target label sid for CTL_BREAK/CTL_CONTINUE (-1 = none)
pending_label: int32 = -1         # label sid to hand to the next loop it wraps (-1 = none)
no_in: int32 = 0                   # parser: suppress `in` as a binop (for-header init)
oc_short: int32 = 0                 # eval: optional-chain `?.` short-circuit latch (nullish base seen)
st_buf_z: Array[96, uint8]


# Build "<name><suffix>" into st_buf_z and return it, so errors can name the
# offending identifier ("google is not defined", "x.call is not a function")
# the way a real engine does. `name_sid` may be -1 (name omitted).
def named_error_msg(prefix: Ptr[uint8], name_sid: int32, suffix: Ptr[uint8]) -> Ptr[uint8]:
    i: int32 = 0
    p: int32 = 0
    while prefix[p] != 0 and i < 40:
        st_buf_z[i] = prefix[p]
        i = i + 1
        p = p + 1
    if name_sid >= 0:
        n: int32 = st_len[name_sid]
        o: int32 = st_off[name_sid]
        j: int32 = 0
        while j < n and i < 78:
            st_buf_z[i] = sp_buf[o + j]
            i = i + 1
            j = j + 1
    k: int32 = 0
    while suffix[k] != 0 and i < 94:
        st_buf_z[i] = suffix[k]
        i = i + 1
        k = k + 1
    st_buf_z[i] = 0
    return &st_buf_z[0]

err_flag: int32 = 0
err_str:  Array[256, uint8]

# Host dispatch is stored as a raw address (cast to Fn at call time). A Fn-typed
# GLOBAL initialized to a function name would emit a 64-bit relocation the
# native elf32-i386 wrapper cannot represent; a runtime uint64 avoids that.
host_dispatch_addr: uint64 = 0
host_dispatch_set: int32 = 0

# ---- member-set notification seam ----
# An embedder may register a hook that fires AFTER every `obj.prop = val` on a
# plain object (not arrays/globals). The browser uses it so assigning
# `el.innerHTML = "…"` parses the fragment into real child nodes eagerly, so a
# SUBSEQUENT `el.childNodes[…]` read in the same script sees the new subtree
# (jsengine has no accessor properties). The hook reads the receiver/key/value
# through js_mset_this()/js_mset_key()/js_mset_val(); its int32 return is
# ignored. Default OFF — pure JS scripts never touch it.
member_set_hook_addr: uint64 = 0
member_set_hook_set: int32 = 0
mset_this_v: int32 = 0
mset_key_v: int32 = 0
mset_val_v: int32 = 0
mset_in_hook: int32 = 0

# ---- deferred-callback task queue (setTimeout/setInterval/queueMicrotask) ----
# The interpreter is a synchronous tree-walk; there is NO wall-clock async
# runtime. Timers are modelled as a bounded QUEUE of pending callbacks that the
# engine DRAINS after the top-level script (and after each embedder event
# dispatch). Each registration is one slot: a callback fn value-handle, its
# captured args, a requested delay (used only for ordering), an insertion
# sequence, and flags for interval / microtask / active. The drain pops due
# callbacks in (microtask-first, then delay, then insertion) order and invokes
# them, capping total invocations so a self-re-enqueuing setInterval cannot spin
# forever. This is enough for the deferred-init / "run after load" patterns real
# pages use — it is explicitly NOT wall-clock async.
#
# SLOT REUSE (see timer_alloc / timer_free in builtins/timers.ad). The table was
# BUMP-ONLY: every setTimeout consumed a slot forever, so a self-rescheduling
# setTimeout chain — the shape of every async SPA render loop — stopped dead at
# exactly TIMER_CAP turns, SILENTLY (timer_schedule just `return`ed 0). Retired
# slots now go on an intrusive free list, so the ceiling is the number of
# SIMULTANEOUSLY PENDING registrations, not the number ever made.
#
# RETENTION ARGUMENT — a freed slot must be referable by nothing:
#   * A slot is freed only when timer_active == 0 (fired one-shot / cancelled)
#     AND timer_busy == 0. An INTERVAL re-arms its OWN slot, so it stays
#     active==1 across firing and is never a free-list candidate.
#   * timer_busy counts native frames currently executing that slot's callback
#     (a COUNT, not a flag: drain_until_settled re-enters run_one_task, so an
#     interval slot can legitimately be on the stack more than once). While
#     busy > 0 the slot is off-limits, so `clearTimeout(myOwnId)` from inside the
#     handler cannot hand the slot to a `setTimeout` the same handler makes next
#     — which would leave run_one_task's post-callback re-arm/retire logic
#     operating on a DIFFERENT registration.
#   * The JS-visible id embeds a per-slot GENERATION (bumped on every free), so a
#     stale id held by the page cannot cancel the unrelated timer that now owns
#     the slot. This ABA hazard is the one thing a bump-only table could not have.
#   * A freed slot's fn/args handles are CLEARED: gc_collect and gc_collect_objs
#     root timer_fn/timer_args WHOLESALE over 0..timer_next, so a corpse holding
#     a stale handle would pin a callback closure (and its whole subgraph) for
#     the life of the page.
TIMER_CAP: int32 = 4096            # max SIMULTANEOUSLY PENDING registrations
TIMER_MAX_ARGS: int32 = 4          # captured extra args per timer
TIMER_DRAIN_CAP: int32 = 10000     # DEFAULT per-drain invocation budget
timer_fn:       Array[4096, int32]     # callback fn value-handle
timer_delay:    Array[4096, float64]   # requested delay (ordering only)
timer_seq:      Array[4096, int32]     # insertion order key (re-bumped on re-arm);
                                       # doubles as the FREE-LIST link while the
                                       # slot is free (an inactive slot is never
                                       # scanned for ordering)
timer_argc:     Array[4096, int32]     # captured arg count
timer_args:     Array[16384, int32]    # TIMER_CAP * TIMER_MAX_ARGS flat pool
timer_active:   Array[4096, uint8]     # 1 = pending, 0 = fired/cancelled
timer_interval: Array[4096, uint8]     # 1 = re-arms after firing
timer_micro:    Array[4096, uint8]     # 1 = microtask (runs before macrotasks)
timer_raf:      Array[4096, uint8]     # 1 = requestAnimationFrame callback (frame macrotask)
timer_gen:      Array[4096, int32]     # ABA generation: id = reg+1 + gen*TIMER_CAP
timer_busy:     Array[4096, int32]     # native frames running this slot's callback
timer_next:     int32 = 0              # bump frontier (allocated EXTENT, not "free")
timer_seq_ctr:  int32 = 0             # monotonic insertion counter
timer_free_head: int32 = -1            # head of the retired-slot free list
timer_live:      int32 = 0             # registrations currently pending (occupancy)
timer_live_hi:   int32 = 0             # high-water of timer_live (sizing evidence)
timer_recycled:  int32 = 0             # slots served off the free list
timer_overflow:  int32 = 0             # registrations DROPPED (table genuinely full)
timer_noted:     int32 = 0             # one-shot latch for the CEILING report

# Per-drain invocation budget (settable: js_set_drain_cap). This is a FAIRNESS
# limit, not a capacity one: a drain that hits it leaves its remaining tasks
# QUEUED and the next drain (the next embedder event / the next js_drain_timers)
# continues them, so no work is lost — unlike the old TIMER_CAP, which destroyed
# the registration. It exists because the drain is SYNCHRONOUS: without it a page
# whose setInterval never stops would never return to the embedder. Truncation is
# counted (timer_drain_trunc) and reported once per js_init so it is never silent.
timer_drain_cap:   int32 = 10000
timer_drain_trunc: int32 = 0           # drains cut short with work still pending
timer_trunc_noted: int32 = 0           # one-shot latch for the truncation report

# ---- requestAnimationFrame virtual-clock frame model ----
# rAF callbacks are macrotasks that fire at simulated frame boundaries. There is
# NO wall clock: frame N runs at virtual timestamp (N+1)*FRAME_MS_VC, which is
# also the DOMHighResTimeStamp handed to the callback. Because the timestamp is
# purely derived from a frame counter, drains are fully deterministic (no Date,
# no random, no sleeping). rAF callbacks live in the SAME timer table (so their
# ids/cancellation reuse timer_clear); timer_raf flags them and their effective
# ordering delay is the frame timestamp, so a setTimeout(...,0) (delay 0) fires
# before the first frame (t=FRAME_MS_VC) — matching virtual time. A rAF that
# re-schedules a rAF from inside its own callback lands in the NEXT frame, not an
# infinite same-frame loop: raf_sched_gen (the frame new rAFs enqueue into) is
# bumped the moment the first callback of the current frame fires.
FRAME_MS_VC:   float64 = 16.0         # simulated per-frame advance (~60fps)
raf_sched_gen: int32 = 0              # frame index new rAF() calls enqueue into

# Scratch buffers for js_str_ptr / js_to_display (each a NUL-terminated C
# string). A RING of buffers, not one shared buffer: an embedder routinely reads
# two (or more) JS strings back-to-back — e.g. `ktp = js_str_ptr(kt); knp =
# js_str_ptr(kn)` — and with a single buffer the second call clobbered the first,
# corrupting the earlier pointer. The ring keeps the SCRATCH_RING most-recent
# results simultaneously valid so those adjacent reads no longer alias.
SCRATCH_RING: int32 = 8
SCRATCH_SZ:   int32 = 65536
scratch: Array[524288, uint8]      # SCRATCH_RING * SCRATCH_SZ
scratch_slot: int32 = 0            # next ring slot to hand out

# emit target: 0 = string-pool build (bld_*), 1 = out_buf
emit_tgt: int32 = 1

# ====================================================================
# ES MODULES (import / export) — module registry + linker state.
# ====================================================================
# A loaded module is one row: its canonical specifier (sid), its parsed AST root
# (an ND_BLOCK), its own module-scope environment, a namespace OBJECT value that
# holds every exported binding (the storage for exports AND the value handed to
# `import * as ns`), and an evaluation state. Modules are keyed/deduped by their
# canonical specifier so a diamond dependency is loaded + evaluated exactly once.
#   mod_state: 0 = registered (source known, not parsed), 1 = parsed/loading,
#              2 = instantiated (deps resolved), 3 = evaluated.
# Source bytes are copied into a shared arena (mod_src) so a module's text is not
# clobbered when the next module tokenizes over the shared token pool.
MODULE_CAP: int32 = 256
MODULE_SRC_CAP: int32 = 1048576     # 1 MiB shared source arena across all modules
mod_spec:   Array[256, int32]       # canonical specifier sid
mod_ast:    Array[256, int32]       # parsed program node (ND_BLOCK) or -1
mod_env:    Array[256, int32]       # module-scope environment id or -1
mod_ns:     Array[256, int32]       # namespace object value-handle or -1
mod_state:  Array[256, uint8]       # 0 registered / 1 loading / 2 instantiated / 3 evaluated
mod_src_off: Array[256, int32]      # offset of this module's source in mod_src
mod_src_len: Array[256, int32]      # length of this module's source
mod_src:    Array[1048576, uint8]   # shared source arena
mod_n:      int32 = 0               # number of registered modules
mod_src_top: int32 = 0             # next free byte in mod_src
mod_load_err: int32 = 0           # a specifier failed to resolve (fatal to the graph)

# Module resolver seam: given a specifier (relative to the importer's spec), the
# embedder returns the module source bytes. Stored as a raw address (cast to Fn
# at call time) for the same elf32 relocation reason as host_dispatch_addr.
# Signature: fn(spec: Ptr[uint8], spec_len: int32, out_len: Ptr[int32]) -> Ptr[uint8]
# Returns a pointer to source bytes (length via out_len) or NULL if unresolved.
module_resolver_addr: uint64 = 0
module_resolver_set: int32 = 0
# The specifier of the module whose imports are currently being resolved, so the
# resolver can interpret a relative specifier against the right base.
mod_cur_base: int32 = -1

# fetch() TRANSPORT seam: the embedder (browser) registers a real over-the-wire
# HTTP transport so fetch() performs an ACTUAL network request through the
# kernel's Plan-9 /net http9 client (user/http9.ad -> net_dial + sys_resolve;
# NO sockets in the engine, NO sockets anywhere — the /net file tree). The engine
# stays extern-free + dual-target: it holds only a raw address (cast to Fn at
# call time, same elf32-relocation reason as module_resolver_addr) and calls it
# synchronously from do_fetch, settling the Promise against the returned bytes.
# When NO transport is registered (host unit tests, dual-target host driver),
# fetch() falls back to the JS-settable FIXTURE table — so existing gates stay
# green and a page can still stub responses.
# Signature: fn(url: Ptr[uint8], url_len: int32, method: Ptr[uint8],
#               method_len: int32, body: Ptr[uint8], body_len: int32,
#               out_status: Ptr[int64], out_len: Ptr[int32]) -> Ptr[uint8]
# Returns a pointer to the RAW HTTP response bytes (status line + headers +
# CRLFCRLF + body), with the total length via out_len and the parsed HTTP status
# via out_status; or NULL (out_len <= 0) on a transport/DNS/connect failure,
# which fetch() surfaces as a rejected Promise (TypeError "network error"), per
# the Fetch spec (a non-2xx HTTP status still FULFILLS with ok=false).
fetch_transport_addr: uint64 = 0
fetch_transport_set: int32 = 0

