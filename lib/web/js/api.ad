# lib/web/js/api.ad — part of the modular web engine (extracted from jsengine.ad).
# PUBLIC API — the 41 js_* names the browser/host embedder + htmlengine call (js_init/js_eval/js_out_*/js_set_host_dispatch/...).
#
# Behavior-preserving split: Adder is a single-compilation-unit language
# (merge_programs merges all imported files into one Program), so every
# public top-level name here resolves globally across the merged engine.

# ====================================================================
# PUBLIC API — the embedder (host driver, native tool, browser) calls these.
# ====================================================================
def js_init():
    # reset all pools
    sp_exhaust_noted = 0
    n_vals = 4
    # GC state: fresh free list + root stack every run. gc_stress persists (an
    # embedder sets it once, after js_init); gc_hi_water is reset to the base so
    # a non-stress run starts from the 80%-of-arena water mark.
    gc_top = 0
    gc_free_head = -1
    gc_disabled = 0
    gc_last_freed = 0
    gc_collections = 0
    gc_hi_water = gc_base_water
    # Phase-3 env-arena GC: fresh free lists + pin stack every run. gc_stress
    # persists (set once by the embedder after js_init); env_hi_water resets to
    # base so a non-stress run starts from the near-ceiling water mark.
    env_free_head = -1
    bind_free_head = -1
    env_gc_top = 0
    env_last_freed = 0
    env_collections = 0
    if gc_stress != 0:
        env_hi_water = ENV_STRESS_GAP
    else:
        env_hi_water = env_base_water
    sp_top = 0
    n_strs = 0
    # Phase-4 string-id GC: fresh free list every run. gc_stress persists (set
    # once by the embedder after js_init); str_hi_water resets to base (or the
    # stress gap) so a non-stress run starts from the 80%-of-MAX_STR water mark.
    str_free_head = -1
    str_last_freed = 0
    str_collections = 0
    if gc_stress != 0:
        str_hi_water = STR_STRESS_GAP
    else:
        str_hi_water = str_base_water
    n_nodes = 0
    n_toks = 0
    n_objs = 0
    n_props = 0
    mse_n = 0
    n_envs = 0
    n_binds = 0
    ax_top = 0
    out_top = 0
    call_top = 0
    this_top = 0
    err_flag = 0
    err_str[0] = 0
    ctl = CTL_NONE
    ctl_val = 0
    throw_val = 0
    tmpl_sp = 0
    re_n = 0
    rn_n = 0
    n_cls = 0
    gname_n = 0
    gname_buf_n = 0
    json_emitted_any = 0
    timer_next = 0
    timer_seq_ctr = 0
    raf_sched_gen = 0
    pr_n = 0
    comb_n = 0
    res_flag_n = 0
    fx_n = 0
    native_self = -1
    scratch_slot = 0
    emit_tgt = 1
    # Reset the builtin PROTOTYPE-object handles. These are part of the object
    # pool (n_objs was just zeroed), so a stale handle from a previous js_init
    # now points at a REUSED slot. v_new_object/v_new_native/v_new_array and the
    # Promise/typed-array/Intl/URL constructors gate on these being their initial
    # sentinel ("not yet installed"); if they carried over non-sentinel, the fresh
    # Object.prototype would be wired to a stale/reused object and the
    # [[Prototype]] chain would form a CYCLE — member reads then spin forever.
    # (Sentinel is 0 for the state.ad protos, -1 for the intl/url ones.)
    g_object_proto = 0
    g_error_proto = 0
    g_regexp_proto = 0
    g_array_proto = 0
    g_func_proto = 0
    g_string_proto = 0
    g_number_proto = 0
    g_boolean_proto = 0
    g_promise_proto = 0
    g_gen_proto = 0
    g_intl_nf_proto = -1
    g_intl_dtf_proto = -1
    g_url_proto = -1
    g_urlsp_proto = -1
    g_formdata_proto = -1
    g_xhr_proto = -1
    tap: int32 = 0
    while tap < 16:
        g_ta_proto[tap] = 0
        tap = tap + 1
    # ES-module registry (import/export). The resolver address persists across
    # js_init so an embedder that registered it once keeps working; the graph
    # cache itself is cleared for each fresh program.
    mod_n = 0
    mod_src_top = 0
    mod_load_err = 0
    mod_cur_base = -1
    # singleton values
    v_tag[0] = cast[uint8](TAG_UNDEF)
    v_tag[1] = cast[uint8](TAG_NULL)
    v_tag[2] = cast[uint8](TAG_BOOL)
    v_tag[3] = cast[uint8](TAG_BOOL)
    v_ref[2] = 1
    v_ref[3] = 0
    # global env + object
    g_env = env_new(-1, 1)
    g_global_obj = v_new_object()
    install_builtins()


# Run a program. Returns a pointer to the NUL-terminated output buffer
# (accumulated console.log output). js_out_len() gives its length; js_error()
# is nonzero on a parse/runtime error and js_error_msg() the message.
#
# js_eval is a TURN BOUNDARY: it ends by draining the deferred-callback queue,
# because a <script> element finishing is exactly the point at which the event
# loop is allowed to run queued tasks. See _js_eval_core / js_eval_nested for
# the entry point that engine-internal source must use instead.
def js_eval(src: Ptr[uint8], slen: uint64) -> Ptr[uint8]:
    return _js_eval_core(src, slen, 0)


# js_eval_nested — evaluate ENGINE-GENERATED source in the CALLER'S turn.
#
# The engine compiles a few small helpers by handing JS source to its own
# evaluator: the CSSOM getPropertyValue thunk (_cs_gpv_fn) and the inline-
# event-handler wrapper (_compile_inline_handler). Those are *compilations* —
# they define a function and immediately hand back its value. They are not
# script elements and they are not tasks.
#
# Routing them through js_eval made them turn boundaries, and that was a real
# and expensive bug. js_eval ends with drain_timers(), so `getComputedStyle()`
# — a synchronous CSSOM getter — pumped the event loop from inside the call the
# first time a page used it. On a Web Platform Tests page that meant
# testharness.js's own watchdog timer fired in the MIDDLE of the first test()
# body: the harness concluded it had timed out, declared itself complete with a
# single test registered, and every later test() on the page was dropped. It
# cost all 243 subtests of css/css-cascade and 166 confirmed failures beyond.
#
# The naive fix is to stop js_eval draining, or to force drain_enabled off
# around the helper. Both are wrong: the drain is load-bearing for real script
# elements (a page's setTimeout(f,0) initialiser must run before we lay out and
# render), and drain_enabled is a HOST-owned control — the browser front-end
# flips it off deliberately to observe the pre-drain DOM, so an engine-internal
# save/restore would fight the embedder over the same flag.
#
# The distinction that actually matters is "is this a turn?", so that is what is
# parameterised. A nested eval runs the same tokenize/parse/exec pipeline and
# reports its own err_flag (callers check js_error() to detect a failed
# compile), but it does NOT drain, and it SAVES AND RESTORES the caller's
# control-flow latches. That second half matters on its own: js_eval clears
# ctl / ctl_label / pending_label at entry, so compiling a helper from inside a
# labelled loop used to discard the pending `continue outer` of the script that
# called it.
def js_eval_nested(src: Ptr[uint8], slen: uint64) -> Ptr[uint8]:
    return _js_eval_core(src, slen, 1)


def _js_eval_core(src: Ptr[uint8], slen: uint64, nested: int32) -> Ptr[uint8]:
    # A nested eval borrows the caller's turn, so the caller's in-flight control
    # flow (a pending break/continue label, an exception on its way out) has to
    # survive it untouched.
    save_ctl: int32 = ctl
    save_ctl_label: int32 = ctl_label
    save_pending: int32 = pending_label
    save_throw: int32 = throw_val
    # Each top-level eval (a <script> element or an inline event handler) runs
    # INDEPENDENTLY, exactly like a browser: a parse error or uncaught throw in
    # one <script> must NOT abort the scripts that follow. Clear the error and
    # control-flow latches so the shared context (globals/DOM) is reused but the
    # previous script's failure does not leak forward.
    err_flag = 0
    ctl = CTL_NONE
    ctl_label = -1
    pending_label = -1
    # AST nodes are BUMP-ALLOCATED and never reclaimed, because a closure created
    # by script N keeps pointing at its function node for the life of the page.
    # So the arena is CUMULATIVE across every <script> in the document — and a
    # single oversized bundle used to consume ALL the remaining slots on its way
    # to failing, leaving nothing for the scripts after it. On google.com that
    # turned one over-cap bundle into FIVE dead scripts, and the globals those
    # later scripts define (`Ti`, `_DumpException`, …) went missing, which is
    # exactly the "X is not a function" cascade users hit.
    #
    # Remember the high-water mark, and if the parse FAILED, roll it back. That is
    # always safe: a script that did not parse never ran, so nothing can hold a
    # reference to the nodes it allocated. The oversized script still fails — but
    # it now fails ALONE instead of taking the rest of the page with it.
    node_mark: int32 = n_nodes
    tokenize(src, cast[int32](slen))
    prog: int32 = -1
    if err_flag == 0:                  # don't parse a truncated token stream
        prog = parse_program()
    if err_flag != 0:
        n_nodes = node_mark
    if err_flag == 0:
        hoist_scan(prog, g_env)
        exec_stmt(prog, g_env)
        # drain deferred callbacks (setTimeout(f,0) etc.) so they run before
        # rendering — only if the top-level script did not itself throw, and
        # only at a real turn boundary. A nested (engine-internal) eval is part
        # of the caller's turn and must not run the event loop; see
        # js_eval_nested.
        if err_flag == 0 and ctl != CTL_THROW and drain_enabled != 0 and nested == 0:
            if page_parsing != 0:
                # Still parsing the document: a script element ending is a
                # MICROTASK CHECKPOINT, not the end of the event loop. The
                # timer queue must wait for DOMContentLoaded and load.
                drain_microtasks()
            else:
                drain_timers()
    if err_flag == 0 and ctl == CTL_THROW:
        # uncaught exception -> print like a host runtime
        emit_tgt = 1
        emit_cstr(cast[Ptr[uint8]]("Uncaught "))
        display_val(throw_val)
        emit_c(10)
        ctl = CTL_NONE
    if err_flag != 0:
        # append the error message to the output for visibility
        emit_tgt = 1
        emit_cstr(&err_str[0])
        emit_c(10)
    if nested != 0:
        # err_flag deliberately survives: _compile_inline_handler reads
        # js_error() to detect a helper that failed to compile.
        ctl = save_ctl
        ctl_label = save_ctl_label
        pending_label = save_pending
        throw_val = save_throw
    out_buf[out_top] = 0
    return &out_buf[0]


# ---- ES modules ----
# Register the module resolver: given a specifier and its length, plus an out
# pointer for the length, it returns the module's source bytes (or NULL if the
# specifier cannot be resolved). Fetch happens on the EMBEDDER side (browser
# http9 / host file read) — the engine itself opens no sockets. Call after
# js_init(); the address persists across js_init so one registration suffices.
def js_set_module_resolver(fn: Fn[Ptr[uint8], int32, Ptr[int32], Ptr[uint8]]):
    module_resolver_addr = cast[uint64](fn)
    module_resolver_set = 1


# ---- fetch() transport ----
# Register a REAL over-the-wire HTTP transport for fetch(). The embedder (the
# browser front-end) supplies a function that performs the actual request via the
# kernel's Plan-9 /net http9 client (DNS via sys_resolve, connect via net_dial /
# net_dial_tls) and returns the RAW HTTP response bytes; fetch() parses status /
# headers / body out of them. The engine opens NO sockets — it only calls back
# into the embedder's transport. Call after js_init(); the address persists
# across js_init so one registration suffices. With no transport registered,
# fetch() resolves from the __setFetchFixture table (host / dual-target).
# Signature: fn(url, url_len, method, method_len, body, body_len,
#               content_type, content_type_len,
#               out_status: Ptr[int64], out_len: Ptr[int32]) -> Ptr[uint8]
# content_type is the request Content-Type for a body (empty => the transport
# applies the Fetch string-body default); the transport forwards method + body
# + content_type to the kernel http9 client (http_get for GET, http_post for
# POST). No sockets — the engine only calls back into this function.
def js_set_fetch_transport(fn: Fn[Ptr[uint8], int32, Ptr[uint8], int32, Ptr[uint8], int32, Ptr[uint8], int32, Ptr[int64], Ptr[int32], Ptr[uint8]]):
    fetch_transport_addr = cast[uint64](fn)
    fetch_transport_set = 1


# Evaluate ENTRY as an ES module: parse it, resolve + load its dependency graph
# through the registered resolver, then evaluate the graph in dependency order.
# `spec` is the entry's own specifier (its base for relative resolution).
# Returns the accumulated console output like js_eval (js_out_len / js_error).
def js_run_module(src: Ptr[uint8], slen: uint64, spec: Ptr[uint8], spec_len: uint64) -> Ptr[uint8]:
    err_flag = 0
    ctl = CTL_NONE
    ctl_label = -1
    pending_label = -1
    entry_spec: int32 = str_new(spec, cast[int32](spec_len))
    idx: int32 = module_intern(entry_spec, src, cast[int32](slen))
    if idx >= 0:
        module_load(idx)
    if err_flag == 0 and mod_load_err == 0 and idx >= 0:
        module_evaluate(idx)
        if err_flag == 0 and ctl != CTL_THROW and drain_enabled != 0:
            drain_timers()
    if err_flag == 0 and ctl == CTL_THROW:
        emit_tgt = 1
        emit_cstr(cast[Ptr[uint8]]("Uncaught "))
        display_val(throw_val)
        emit_c(10)
        ctl = CTL_NONE
    if mod_load_err != 0 and err_flag == 0:
        set_error(cast[Ptr[uint8]]("Error: module specifier could not be resolved"))
    if err_flag != 0:
        emit_tgt = 1
        emit_cstr(&err_str[0])
        emit_c(10)
    out_buf[out_top] = 0
    return &out_buf[0]


# The specifier of the module whose imports the resolver is currently being
# asked to resolve (its base, for interpreting a relative specifier). Valid only
# inside the resolver callback.
def js_module_base() -> Ptr[uint8]:
    if mod_cur_base < 0:
        return cast[Ptr[uint8]]("")
    return str_ptr(mod_cur_base)


def js_out_len() -> uint64:
    return cast[uint64](out_top)


def js_out_ptr() -> Ptr[uint8]:
    out_buf[out_top] = 0
    return &out_buf[0]


# Host-side diagnostic line, appended to the SAME buffer console.log writes, so
# it surfaces on the harness's JSLOG channel. The embedder has hard per-page
# ceilings (DOM_MAX element objects, EVL_MAX listeners, TX_MAX tree nodes) that
# used to be crossed in COMPLETE SILENCE: past DOM_MAX, _dom_register_el handed
# scripts `undefined` and the page's own loop then threw on `a[i].getAttribute`,
# with nothing in the output naming the real cause. A ceiling that cannot report
# itself cannot be sized against evidence, so every one of them now says so.
# Pass n < 0 to emit the message alone.
js_note_dbuf: Array[16, uint8]

def js_out_note(msg: Ptr[uint8], n: int32):
    save: int32 = emit_tgt
    emit_tgt = 1
    emit_cstr(msg)
    if n >= 0:
        d: int32 = 0
        v: int32 = n
        if v == 0:
            js_note_dbuf[0] = 48
            d = 1
        while v > 0:
            js_note_dbuf[d] = cast[uint8](48 + (v % 10))
            v = v / 10
            d = d + 1
        while d > 0:
            d = d - 1
            emit_c(js_note_dbuf[d])
    emit_c(10)
    emit_tgt = save


def js_error() -> int32:
    return err_flag


def js_error_msg() -> Ptr[uint8]:
    return &err_str[0]


# ---- value constructors for embedders ----
def js_undefined() -> int32:
    return v_undef()


def js_null() -> int32:
    return v_null()


def js_bool(b: int32) -> int32:
    return v_boolv(b)


def js_number(x: float64) -> int32:
    return v_number(x)


def js_new_string(p: Ptr[uint8], n: uint64) -> int32:
    return v_string_bytes(p, cast[int32](n))


def js_new_object_v() -> int32:
    return v_new_object()


def js_new_array_v() -> int32:
    return v_new_array()


def js_new_native_fn(native_id: int32) -> int32:
    return v_new_native(native_id)


# ---- prototype wiring (host classes) --------------------------------------
# The embedder's host objects (DOM elements, text nodes, the document) are
# ordinary objects with own properties, so `el instanceof Element` was always
# false — instance_of() only walks [[Prototype]]. These two entry points let the
# embedder build the real DOM class hierarchy: js_fn_prototype(Ctor) materialises
# (and returns) `Ctor.prototype`, js_set_proto_v(obj, proto) links an instance —
# or another prototype — to it. Enumeration (for-in / Object.keys / spread) walks
# OWN properties only (see v_new_object), so nothing on a prototype leaks into it.
def js_fn_prototype(fnv: int32) -> int32:
    p: int32 = ensure_fn_prototype(fnv)
    if tag_of(p) == TAG_OBJ:
        return p
    # ensure_fn_prototype only auto-creates for ORDINARY function declarations —
    # a native function (which is what every host interface object is) is not
    # constructable, so it never gets one. Mint it here; instance_of() then finds
    # it as an own property on the next lookup.
    if tag_of(fnv) != TAG_OBJ:
        return v_undef()
    proto: int32 = v_new_object()
    obj_set(objid_of(proto), str_from_cstr(cast[Ptr[uint8]]("constructor")), fnv)
    obj_set(objid_of(fnv), str_from_cstr(cast[Ptr[uint8]]("prototype")), proto)
    return proto


def js_set_proto_v(objv: int32, protov: int32):
    if tag_of(objv) != TAG_OBJ:
        return
    if tag_of(protov) != TAG_OBJ:
        return
    obj_proto[objid_of(objv)] = objid_of(protov)


# ---- object / global manipulation ----
def js_set_prop(objv: int32, name: Ptr[uint8], n: uint64, val: int32):
    member_set(objv, str_new(name, cast[int32](n)), val)


def js_get_prop(objv: int32, name: Ptr[uint8], n: uint64) -> int32:
    return member_get(objv, str_new(name, cast[int32](n)))


# Does `objv` carry `name` as its OWN property (not inherited)?
# The embedder needs the distinction once an IDL attribute becomes a LAZY
# prototype accessor: for `el.textContent`, "has an own property" means script
# (or a memoizing getter) actually touched this element, while "no own property"
# means untouched — which is what the DOM readback must test instead of diffing
# a snapshot it can no longer afford to take for every element on the page.
def js_has_own(objv: int32, name: Ptr[uint8], n: uint64) -> int32:
    if tag_of(objv) != TAG_OBJ:
        return 0
    if obj_find_prop(objid_of(objv), str_new(name, cast[int32](n))) >= 0:
        return 1
    return 0


# Install an OWN DATA property, bypassing the accessor walk and the member-set
# hook. This is how a lazy accessor memoizes itself: the getter computes the
# value once and stores it as a plain own property, which then shadows the
# prototype accessor for every later read and write (own props win in both
# member_get and member_set). Going through js_set_prop would re-enter the very
# setter that is running.
def js_set_own(objv: int32, name: Ptr[uint8], n: uint64, val: int32):
    if tag_of(objv) != TAG_OBJ:
        return
    obj_set(objid_of(objv), str_new(name, cast[int32](n)), val)


# UNTRUNCATED view of a string value's bytes.
# js_str_ptr() renders through a 64 KiB scratch ring slot, so anything longer
# came back SILENTLY TRUNCATED — which is what made the DOM readback mistake an
# intact <body>.textContent for a mutated one and re-serialise a whole page as
# escaped text. The string pool is documented NON-MOVING, so a pointer straight
# into it is valid for as long as the value is live. NOT NUL-terminated: pair
# with js_str_bytelen(). Non-string values fall back to js_str_ptr's rendering.
def js_str_bytes(val: int32) -> Ptr[uint8]:
    if tag_of(val) == TAG_STR:
        return &sp_buf[st_off[strid_of(val)]]
    return js_to_display(val)


def js_str_bytelen(val: int32) -> int32:
    if tag_of(val) == TAG_STR:
        return st_len[strid_of(val)]
    p: Ptr[uint8] = js_to_display(val)
    i: int32 = 0
    while p[i] != 0:
        i = i + 1
    return i


# Define an ACCESSOR property from the host side. The embedder needs this for
# the IDL attributes whose value cannot be a snapshot — `document.cookie` must
# re-serialise the jar on every read and PARSE on every write, which a data
# property cannot do. Pass -1 for a half you do not want.
def js_define_accessor(objv: int32, name: Ptr[uint8], n: uint64, \
                       getter: int32, setter: int32):
    if tag_of(objv) != TAG_OBJ:
        return
    obj_define_accessor(objid_of(objv), str_new(name, cast[int32](n)), \
                        getter, setter)


def js_array_push(arrv: int32, val: int32):
    if is_array(arrv) != 0:
        arr_push(objid_of(arrv), val)


def js_global_set(name: Ptr[uint8], n: uint64, val: int32):
    env_define(g_env, str_new(name, cast[int32](n)), val, 0)


# Read a global binding's current value by name (the mirror of js_global_set).
# Returns undefined if the name is not bound. Lets an embedder recover a value
# that a js_eval'd snippet stored in the global scope (e.g. a function compiled
# from inline-handler source).
def js_global_get(name: Ptr[uint8], n: uint64) -> int32:
    b: int32 = env_lookup_bind(g_env, str_new(name, cast[int32](n)))
    if b < 0:
        return v_undef()
    return b_val[b]


# ---- value inspection (for host dispatch) ----
def js_type_of(val: int32) -> int32:
    return tag_of(val)


def js_to_number(val: int32) -> float64:
    return to_number(val)


def js_to_bool(val: int32) -> int32:
    return to_bool(val)


def js_is_array(val: int32) -> int32:
    return is_array(val)


def js_array_len(val: int32) -> int32:
    if is_array(val) != 0:
        return arr_len[objid_of(val)]
    return 0


def js_array_get(val: int32, i: int32) -> int32:
    if is_array(val) != 0:
        return arr_get(objid_of(val), i)
    return v_undef()


# Copy a value's string form into a scratch buffer (NUL-terminated). Hands out
# the NEXT buffer in the ring (see state.ad) so consecutive calls do not clobber
# each other's result — an embedder can hold SCRATCH_RING recent pointers live.
def js_to_display(val: int32) -> Ptr[uint8]:
    save: int32 = emit_tgt
    save_out: int32 = out_top
    # render into out_buf temporarily then copy into this call's ring slot.
    emit_tgt = 1
    tmpstart: int32 = out_top
    display_val(val)
    ln: int32 = out_top - tmpstart
    slot: int32 = scratch_slot
    scratch_slot = scratch_slot + 1
    if scratch_slot >= SCRATCH_RING:
        scratch_slot = 0
    dbase: int32 = slot * SCRATCH_SZ
    i: int32 = 0
    while i < ln and i < SCRATCH_SZ - 1:
        scratch[dbase + i] = out_buf[tmpstart + i]
        i = i + 1
    scratch[dbase + i] = 0
    out_top = save_out                 # roll back the temporary render
    emit_tgt = save
    return &scratch[dbase]


def js_str_ptr(val: int32) -> Ptr[uint8]:
    return js_to_display(val)


# ---- host native dispatch seam ----
# The embedder registers fn(native_id) -> value-handle. Inside it, the embedder
# reads arguments via js_arg_count()/js_arg(i) and returns any value handle
# (build with js_number/js_new_string/js_new_object/...). Route calls to your
# host object's native methods (e.g. a future `document`) here. Host natives
# MUST use ids >= HOST_NATIVE_BASE (1000).
def js_set_host_dispatch(fn: Fn[int32, int32]):
    host_dispatch_addr = cast[uint64](fn)
    host_dispatch_set = 1


# ---- member-set notification seam (see member_set) ----
def js_set_member_hook(fn: Fn[int32, int32]):
    member_set_hook_addr = cast[uint64](fn)
    member_set_hook_set = 1


def js_mset_this() -> int32:
    return mset_this_v


def js_mset_key() -> int32:
    return mset_key_v


def js_mset_val() -> int32:
    return mset_val_v


def js_arg_count() -> int32:
    return hostcall_argc


def js_arg(i: int32) -> int32:
    if i < hostcall_argc:
        return call_args[hostcall_base + i]
    return v_undef()


def js_host_base() -> int32:
    return HOST_NATIVE_BASE


# The receiver (`this`) of the native method currently being dispatched, so a
# host method like element.addEventListener / element.appendChild can identify
# which host object it was invoked on. Valid only inside the dispatch fn.
def js_this() -> int32:
    return hostcall_this


# Is `val` a callable JS function value? (For an embedder deciding whether a
# stored event handler can be invoked.)
def js_is_callable(val: int32) -> int32:
    return is_callable(val)


# Invoke a JS function VALUE from native/embedder code with `argc` argument
# value-handles (argv[0..argc), built via js_number/js_new_string/...), and
# `thisval` as the receiver. Returns the call's result value-handle. This is
# the seam that lets native code call a stored JS event handler AFTER the
# initial js_eval has returned — the JS context persists until the next
# js_init(), so handler function values stay live across a page's lifetime.
def js_call_fn(fnval: int32, thisval: int32, argv: Ptr[int32], argc: int32) -> int32:
    if is_callable(fnval) == 0:
        return v_undef()
    base: int32 = call_top
    i: int32 = 0
    while i < argc:
        call_args[call_top] = argv[i]
        call_top = call_top + 1
        i = i + 1
    r: int32 = invoke(fnval, thisval, base, argc)
    call_top = base
    return r


# Drain the deferred-callback task queue on demand. js_eval already drains at
# end-of-script; an embedder that dispatches DOM events via js_call_fn should
# call this AFTER each event turn so setTimeout(f,0) handlers scheduled by the
# event fire before the next render.
# Set by the page pipeline while the document's <script>s are being executed,
# so js_eval stops at a microtask checkpoint instead of running the timer queue
# between script elements. The embedder owns the flag because only the embedder
# knows when the parse is finished; a bare js_eval (js.ad, js_host.ad, the REPL)
# leaves it 0 and keeps the full end-of-turn drain.
def js_set_page_parsing(on: int32):
    page_parsing = on


def js_drain_timers():
    drain_timers()


# Drain only if the embedder has not turned the end-of-turn drain off. Firing a
# document lifecycle event (DOMContentLoaded / load) is a TASK, so tasks it
# queues have to run -- but js_set_drain(0) is the host's deliberate "let me see
# the pre-drain DOM" control and must keep working, so this honours it where a
# bare js_drain_timers() would override it.
def js_drain_timers_if_enabled():
    if drain_enabled != 0:
        drain_timers()
