            return 42
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("p"), 1) != 0:
            return 40
    elif c0 == 113:                                # 'q'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("q"), 1) != 0:
            return 44
    elif c0 == 115:                                # 's'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("script"), 6) != 0:
            return 45
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("select"), 6) != 0:
            return 46
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("source"), 6) != 0:
            return 47
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("style"), 5) != 0:
            return 49
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("span"), 4) != 0:
            return 48
    elif c0 == 116:                                # 't'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("template"), 8) != 0:
            return 56
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("textarea"), 8) != 0:
            return 57
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("table"), 5) != 0:
            return 53
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("tbody"), 5) != 0:
            return 55
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("thead"), 5) != 0:
            return 55
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("tfoot"), 5) != 0:
            return 55
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("title"), 5) != 0:
            return 59
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("track"), 5) != 0:
            return 60
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("time"), 4) != 0:
            return 58
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("td"), 2) != 0:
            return 51
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("th"), 2) != 0:
            return 51
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("tr"), 2) != 0:
            return 54
    elif c0 == 117:                                # 'u'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("ul"), 2) != 0:
            return 61
    elif c0 == 118:                                # 'v'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("video"), 5) != 0:
            return 62
    return -1


# Brand `o` with the interface prototype for its tag (falls back to HTMLElement).
def _brand_by_tag(o: int32):
    if g_proto_elem == 0:
        return
    tv: int32 = js_get_prop(o, cast[Ptr[uint8]]("tagName"), 7)
    if js_type_of(tv) != TAG_STR:
        return
    tp: Ptr[uint8] = js_str_bytes(tv)
    tl: int32 = js_str_bytelen(tv)
    if tl > 31:
        return
    lb: Array[32, uint8]
    i: int32 = 0
    while i < tl:
        lb[i] = _hx_lower(tp[i])
        i = i + 1
    ii: int32 = _tag_iface(&lb[0], tl)
    if ii >= 0 and g_iface_proto[ii] != 0:
        js_set_proto_v(o, g_iface_proto[ii])

# Swap a DOM interface object's backing native for a real constructor, keeping
# the prototype identity _dom_interface already established (so
# `x instanceof Text` and `Text.prototype` both keep working).
# The NodeFilter namespace object: SHOW_* bit constants and the three
# FILTER_* return codes. Scripts read them off the global, and the interface
# object is also usable as `NodeFilter.SHOW_ELEMENT` inside a filter callback.
def _build_nodefilter():
    nf: int32 = js_new_object_v()
    js_set_prop(nf, cast[Ptr[uint8]]("FILTER_ACCEPT"), 13, js_number(1.0))
    js_set_prop(nf, cast[Ptr[uint8]]("FILTER_REJECT"), 13, js_number(2.0))
    js_set_prop(nf, cast[Ptr[uint8]]("FILTER_SKIP"), 11, js_number(3.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_ALL"), 8, js_number(4294967295.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_ELEMENT"), 12, js_number(1.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_ATTRIBUTE"), 14, js_number(2.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_TEXT"), 9, js_number(4.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_CDATA_SECTION"), 18, js_number(8.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_ENTITY_REFERENCE"), 21, js_number(16.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_ENTITY"), 11, js_number(32.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_PROCESSING_INSTRUCTION"), 27, \
                js_number(64.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_COMMENT"), 12, js_number(128.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_DOCUMENT"), 13, js_number(256.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_DOCUMENT_TYPE"), 18, js_number(512.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_DOCUMENT_FRAGMENT"), 22, \
                js_number(1024.0))
    js_set_prop(nf, cast[Ptr[uint8]]("SHOW_NOTATION"), 13, js_number(2048.0))
    js_global_set(cast[Ptr[uint8]]("NodeFilter"), 10, nf)
    g_nodefilter = nf


def _rebrand_ctor(proto: int32, nid: int32) -> int32:
    c: int32 = js_new_native_fn(js_hbase + nid)
    js_set_fn_prototype(c, proto)
    js_set_prop(proto, cast[Ptr[uint8]]("constructor"), 11, c)
    return c


def _dom_interface(name: Ptr[uint8], nlen: uint64, parent_proto: int32) -> int32:
    ctor: int32 = js_new_native_fn(js_hbase + NID_NODE_CTOR)
    js_global_set(name, nlen, ctor)
    proto: int32 = js_fn_prototype(ctor)
    if parent_proto != 0:
        js_set_proto_v(proto, parent_proto)
    return proto


# The Node nodeType / DOCUMENT_POSITION constants, mirrored onto both `Node` and
# every interface that inherits them (scripts read `Node.ELEMENT_NODE` and
# `Element.ELEMENT_NODE` interchangeably; the spec puts them on both).
def _node_constants(target: int32):
    js_set_prop(target, cast[Ptr[uint8]]("ELEMENT_NODE"), 12, js_number(1.0))
    js_set_prop(target, cast[Ptr[uint8]]("ATTRIBUTE_NODE"), 14, js_number(2.0))
    js_set_prop(target, cast[Ptr[uint8]]("TEXT_NODE"), 9, js_number(3.0))
    js_set_prop(target, cast[Ptr[uint8]]("CDATA_SECTION_NODE"), 18, js_number(4.0))
    js_set_prop(target, cast[Ptr[uint8]]("ENTITY_REFERENCE_NODE"), 21, js_number(5.0))
    js_set_prop(target, cast[Ptr[uint8]]("ENTITY_NODE"), 11, js_number(6.0))
    js_set_prop(target, cast[Ptr[uint8]]("PROCESSING_INSTRUCTION_NODE"), 27, \
                js_number(7.0))
    js_set_prop(target, cast[Ptr[uint8]]("COMMENT_NODE"), 12, js_number(8.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_NODE"), 13, js_number(9.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_TYPE_NODE"), 18, js_number(10.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_FRAGMENT_NODE"), 22, \
                js_number(11.0))
    js_set_prop(target, cast[Ptr[uint8]]("NOTATION_NODE"), 13, js_number(12.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_POSITION_DISCONNECTED"), 30, \
                js_number(1.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_POSITION_PRECEDING"), 27, \
                js_number(2.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_POSITION_FOLLOWING"), 27, \
                js_number(4.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_POSITION_CONTAINS"), 26, \
                js_number(8.0))
    js_set_prop(target, cast[Ptr[uint8]]("DOCUMENT_POSITION_CONTAINED_BY"), 30, \
                js_number(16.0))
    js_set_prop(target, \
                cast[Ptr[uint8]]("DOCUMENT_POSITION_IMPLEMENTATION_SPECIFIC"), 41, \
                js_number(32.0))


# Build the DOM class hierarchy (Node / Element / HTMLElement / CharacterData /
# Text / Comment / DocumentFragment / Document) as real global constructors with
# linked prototypes, and stash each prototype so every node the engine mints can
# be branded. Called FIRST in _js_build_document, before any element object is
# registered, so _attach_el_methods can link elements as they are created.
def _build_dom_interfaces():
    g_proto_node = _dom_interface(cast[Ptr[uint8]]("Node"), 4, 0)
    nodector: int32 = js_global_get(cast[Ptr[uint8]]("Node"), 4)
    _node_constants(nodector)
    _node_constants(g_proto_node)
    # EventTarget + Node methods live HERE, so Text / Comment / Document /
    # DocumentFragment / DocumentType / Attr inherit appendChild / cloneNode /
    # normalize / isEqualNode / lookupNamespaceURI instead of reporting them
    # `undefined` (94 WPT subtests were failing on the missing-method TypeError).
    _attach_node_natives(g_proto_node)
    g_proto_elem = _dom_interface(cast[Ptr[uint8]]("Element"), 7, g_proto_node)
    # HTMLElement inherits Element; elements are branded with the HTMLElement
    # prototype so `el instanceof HTMLElement`, `instanceof Element` and
    # `instanceof Node` are all true, exactly as in a browser.
    g_proto_elem = _dom_interface(cast[Ptr[uint8]]("HTMLElement"), 11, g_proto_elem)
    # The stateless element methods live HERE, once, not on every element (see
    # _attach_proto_methods: 32 fewer JS objects per registered element).
    _attach_proto_methods(g_proto_elem)
    # textContent / innerHTML are LAZY here, not snapshots on every element:
    # one accessor pair on the prototype instead of two strings per element.
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("textContent"), 11, \
                       js_new_native_fn(js_hbase + NID_TC_GET), \
                       js_new_native_fn(js_hbase + NID_TC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("innerHTML"), 9, \
                       js_new_native_fn(js_hbase + NID_IH_GET), \
                       js_new_native_fn(js_hbase + NID_IH_SET))
    # style / classList / dataset: built on first access, not on registration.
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("style"), 5, \
                       js_new_native_fn(js_hbase + NID_STYLE_ACC), \
                       js_new_native_fn(js_hbase + NID_STYLE_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("classList"), 9, \
                       js_new_native_fn(js_hbase + NID_CLS_ACC), \
                       js_new_native_fn(js_hbase + NID_CLS_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("dataset"), 7, \
                       js_new_native_fn(js_hbase + NID_DS_ACC), \
                       js_new_native_fn(js_hbase + NID_DS_ACC_SET))
    # children / childNodes: the tree wiring is done on FIRST ACCESS (see the
    # NID_KIDS_ACC comment) so document.body.children stops being `undefined`
    # without eagerly registering the whole document.
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("children"), 8, \
                       js_new_native_fn(js_hbase + NID_KIDS_ACC), \
                       js_new_native_fn(js_hbase + NID_KIDS_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("childNodes"), 10, \
                       js_new_native_fn(js_hbase + NID_NODES_ACC), \
                       js_new_native_fn(js_hbase + NID_NODES_ACC_SET))
    # NODE-level traversal, off the same lazy child-NODE list.
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("firstChild"), 10, \
                       js_new_native_fn(js_hbase + NID_FCH_ACC), \
                       js_new_native_fn(js_hbase + NID_FCH_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("lastChild"), 9, \
                       js_new_native_fn(js_hbase + NID_LCH_ACC), \
                       js_new_native_fn(js_hbase + NID_LCH_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("previousSibling"), 15, \
                       js_new_native_fn(js_hbase + NID_PSIB_ACC), \
                       js_new_native_fn(js_hbase + NID_PSIB_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("nextSibling"), 11, \
                       js_new_native_fn(js_hbase + NID_NSIB_ACC), \
                       js_new_native_fn(js_hbase + NID_NSIB_ACC_SET))
    # attributes / localName / prefix: derived on demand from the start tag +
    # override store, so no per-element cost until something asks.
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("attributes"), 10, \
                       js_new_native_fn(js_hbase + NID_ATTRS_ACC), \
                       js_new_native_fn(js_hbase + NID_ATTRS_ACC_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("localName"), 9, \
                       js_new_native_fn(js_hbase + NID_LOCALNAME_ACC), \
                       js_new_native_fn(js_hbase + NID_LOCALNAME_SET))
    js_define_accessor(g_proto_elem, cast[Ptr[uint8]]("prefix"), 6, \
                       js_new_native_fn(js_hbase + NID_PREFIX_ACC), \
                       js_new_native_fn(js_hbase + NID_PREFIX_SET))
    # el.style / el.classList carry per-element STATE, but their methods do not:
    # one shared copy each on the real interface prototype (which also makes
    # `el.style instanceof CSSStyleDeclaration` and
    # `el.classList instanceof DOMTokenList` true, as in a browser).
    g_proto_style = _dom_interface(cast[Ptr[uint8]]("CSSStyleDeclaration"), 19, 0)
    _attach_style_natives(g_proto_style)
    g_proto_clslist = _dom_interface(cast[Ptr[uint8]]("DOMTokenList"), 12, 0)
    _attach_clslist_natives(g_proto_clslist)
    # WPT's assert_class_string() IS Object.prototype.toString.call(), so an
    # untagged host prototype reports the generic "[object Object]". Tagged
    # here (not on the element interfaces, whose per-tag class we do not model).
    js_tag_object(g_proto_clslist, cast[Ptr[uint8]]("DOMTokenList"))
    js_tag_object(g_proto_style, cast[Ptr[uint8]]("CSSStyleDeclaration"))
    _attach_childnode_mixin(g_proto_elem)
    _attach_parentnode_mixin(g_proto_elem)
    chard: int32 = _dom_interface(cast[Ptr[uint8]]("CharacterData"), 13, g_proto_node)
    _attach_childnode_mixin(chard)
    _attach_chardata_natives(chard)
    g_proto_text = _dom_interface(cast[Ptr[uint8]]("Text"), 4, chard)
    js_set_prop(g_proto_text, cast[Ptr[uint8]]("splitText"), 9, \
                js_new_native_fn(js_hbase + NID_TEXT_SPLIT))
    # `new Text(data)` / `new Comment(data)` — the interface objects _dom_interface
    # minted are generic NID_NODE_CTOR stubs, which threw "value is not a
    # constructor"; point them at real factories instead.
    js_global_set(cast[Ptr[uint8]]("Text"), 4, \
                  _rebrand_ctor(g_proto_text, NID_TEXT_CTOR))
    g_proto_comm = _dom_interface(cast[Ptr[uint8]]("Comment"), 7, chard)
    js_global_set(cast[Ptr[uint8]]("Comment"), 7, \
                  _rebrand_ctor(g_proto_comm, NID_COMMENT_CTOR))
    g_proto_pi = _dom_interface(cast[Ptr[uint8]]("ProcessingInstruction"), 21, \
                                chard)
    _attach_childnode_mixin(g_proto_pi)
    g_proto_frag = _dom_interface(cast[Ptr[uint8]]("DocumentFragment"), 16, \
                                  g_proto_node)
    g_proto_doc = _dom_interface(cast[Ptr[uint8]]("Document"), 8, g_proto_node)
    _dom_interface(cast[Ptr[uint8]]("HTMLDocument"), 12, g_proto_doc)
    _dom_interface(cast[Ptr[uint8]]("XMLDocument"), 11, g_proto_doc)
    _attach_parentnode_mixin(g_proto_frag)
    _attach_parentnode_mixin(g_proto_doc)
    g_proto_doctype = _dom_interface(cast[Ptr[uint8]]("DocumentType"), 12, \
                                     g_proto_node)
    _attach_childnode_mixin(g_proto_doctype)
    g_proto_attr = _dom_interface(cast[Ptr[uint8]]("Attr"), 4, g_proto_node)
    # Range / StaticRange / TreeWalker / NodeIterator / NodeFilter.
    g_proto_range = _dom_interface(cast[Ptr[uint8]]("Range"), 5, 0)
    js_global_set(cast[Ptr[uint8]]("Range"), 5, \
                  _rebrand_ctor(g_proto_range, NID_RNG_CTOR))
    _attach_range_natives(g_proto_range)
    js_tag_object(g_proto_range, cast[Ptr[uint8]]("Range"))
    sproto: int32 = _dom_interface(cast[Ptr[uint8]]("StaticRange"), 11, 0)
    js_global_set(cast[Ptr[uint8]]("StaticRange"), 11, \
                  _rebrand_ctor(sproto, NID_STATICRANGE_CTOR))
    g_proto_tw = _dom_interface(cast[Ptr[uint8]]("TreeWalker"), 10, 0)
    _attach_tw_natives(g_proto_tw)
    js_tag_object(g_proto_tw, cast[Ptr[uint8]]("TreeWalker"))
    g_proto_ni = _dom_interface(cast[Ptr[uint8]]("NodeIterator"), 12, 0)
    _attach_ni_natives(g_proto_ni)
    js_tag_object(g_proto_ni, cast[Ptr[uint8]]("NodeIterator"))
    _build_nodefilter()
    g_proto_nnm = _dom_interface(cast[Ptr[uint8]]("NamedNodeMap"), 12, 0)
    g_proto_impl = _dom_interface(cast[Ptr[uint8]]("DOMImplementation"), 17, 0)
    js_tag_object(g_proto_doctype, cast[Ptr[uint8]]("DocumentType"))
    js_tag_object(g_proto_attr, cast[Ptr[uint8]]("Attr"))
    js_tag_object(g_proto_nnm, cast[Ptr[uint8]]("NamedNodeMap"))
    js_tag_object(g_proto_impl, cast[Ptr[uint8]]("DOMImplementation"))
    _build_iface_protos()
    g_proto_html = g_iface_proto[_tag_iface(cast[Ptr[uint8]]("html"), 4)]
    g_proto_head = g_iface_proto[_tag_iface(cast[Ptr[uint8]]("head"), 4)]
    g_proto_body = g_iface_proto[_tag_iface(cast[Ptr[uint8]]("body"), 4)]
    g_proto_title = g_iface_proto[_tag_iface(cast[Ptr[uint8]]("title"), 5)]
    _dom_interface(cast[Ptr[uint8]]("SVGElement"), 10, \
                   js_fn_prototype(js_global_get(cast[Ptr[uint8]]("Element"), 7)))
    # MessageChannel — React 18's scheduler prefers it over setTimeout for its
    # "yield to the browser" hop (`"undefined"!==typeof MessageChannel`), and
    # falls back to a 0ms timer otherwise. Ours delivers through the same task
    # queue, so a posted message runs as a macrotask, after microtasks.
    js_global_set(cast[Ptr[uint8]]("MessageChannel"), 14, \
                  js_new_native_fn(js_hbase + NID_MSGCHANNEL))


def _doc_set_el(doc: int32, prop: Ptr[uint8], plen: uint64, name: Ptr[uint8]):
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and src_ptr[i + 1] != 47 and \
           _tagname_is(i + 1, name) != 0:
            _scan_start_tag(i)
            o: int32 = _dom_register_el()
            js_set_prop(doc, prop, plen, o)
            return
        i = i + 1


# ---- CSSOM stylesheet JS objects (document.styleSheets / .sheet / constructible
#      CSSStyleSheet) — wired to the cascade rule model in css/cascade.ad -------
cssom_argbuf: Array[65536, uint8]    # insertRule/replaceSync text scratch


# End index (exclusive) of the top-level ruleset starting at p[s]. Balances
# braces so `@media{...}` and nested blocks count as ONE rule; tolerant of a
# rule missing its closing brace at EOF (returns n).
def _css_rule_end(p: Ptr[uint8], s: int32, n: int32) -> int32:
    i: int32 = s
    depth: int32 = 0
    seen: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c == 123:                       # '{'
            depth = depth + 1
            seen = 1
        elif c == 125:                     # '}'
            depth = depth - 1
            if depth <= 0 and seen != 0:
                return i + 1
        i = i + 1
    return n


# Build a CSSRule-ish JS object for rule text p[0..n): { cssText, selectorText,
# type }. selectorText is the prelude up to the first '{' (trimmed).
def _cssom_ruleobj(p: Ptr[uint8], n: int32) -> int32:
    o: int32 = js_new_object_v()
    js_set_prop(o, cast[Ptr[uint8]]("cssText"), 7, js_new_string(p, cast[uint64](n)))
    sl: int32 = 0
    while sl < n and p[sl] != 123:
        sl = sl + 1
    # trim trailing whitespace from the selector prelude
    while sl > 0 and (p[sl - 1] == 32 or p[sl - 1] == 9 or \
                      p[sl - 1] == 10 or p[sl - 1] == 13):
        sl = sl - 1
    js_set_prop(o, cast[Ptr[uint8]]("selectorText"), 12, js_new_string(p, cast[uint64](sl)))
    js_set_prop(o, cast[Ptr[uint8]]("type"), 4, js_number(cast[float64](1)))
    return o
# Split CSS text p[0..n) into top-level rules. Each rule's cssText object is
# pushed onto JS array `arr`; when to_model != 0 each rule is ALSO appended to
# sheet `sid`'s cascade model (so it re-cascades). Returns the rule count.
def _sheet_split_load(sid: int32, arr: int32, to_model: int32, \
                      p: Ptr[uint8], n: int32) -> int32:
    count: int32 = 0
    i: int32 = 0
    while i < n:
        while i < n and (p[i] == 32 or p[i] == 9 or p[i] == 10 or p[i] == 13):
            i = i + 1
        if i >= n:
            break
        rs: int32 = i
        re: int32 = _css_rule_end(p, i, n)
        if re <= rs:
            break
        if to_model != 0:
            _cssom_insert_rule(sid, cssom_sheet_nrules[sid], &p[rs], re - rs)
        js_array_push(arr, _cssom_ruleobj(&p[rs], re - rs))
        count = count + 1
        i = re
    return count


# Fresh CSSStyleSheet JS object bound to cascade-model sheet id `sid`.
def _new_sheet_obj(sid: int32) -> int32:
    o: int32 = js_new_object_v()
    js_set_prop(o, cast[Ptr[uint8]]("__sheetid"), 9, js_number(cast[float64](sid)))
    cr: int32 = js_new_array_v()
    js_set_prop(o, cast[Ptr[uint8]]("cssRules"), 8, cr)
    js_set_prop(o, cast[Ptr[uint8]]("rules"), 5, cr)          # legacy alias
    js_set_prop(o, cast[Ptr[uint8]]("type"), 4, js_new_string(cast[Ptr[uint8]]("text/css"), 8))
    js_set_prop(o, cast[Ptr[uint8]]("disabled"), 8, js_bool(0))
    js_set_prop(o, cast[Ptr[uint8]]("insertRule"), 10, \
                js_new_native_fn(js_hbase + NID_SS_INSERTRULE))
    js_set_prop(o, cast[Ptr[uint8]]("deleteRule"), 10, \
                js_new_native_fn(js_hbase + NID_SS_DELETERULE))
    js_set_prop(o, cast[Ptr[uint8]]("replaceSync"), 11, \
                js_new_native_fn(js_hbase + NID_SS_REPLACESYNC))
    js_set_prop(o, cast[Ptr[uint8]]("replace"), 7, \
                js_new_native_fn(js_hbase + NID_SS_REPLACE))
    return o


# Recover the cascade-model sheet id stored on a sheet JS object, or -1.
def _sheet_id_of(thisv: int32) -> int32:
    v: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("__sheetid"), 9)
    if js_type_of(v) != TAG_NUM:
        return -1
    return cast[int32](js_to_number(v))


# Return a copy of JS array `arr` with element `idx` removed (deleteRule keeps
# the cssRules length honest; the JS engine has no in-place array splice seam).
def _cssrules_without(arr: int32, idx: int32) -> int32:
    out: int32 = js_new_array_v()
    ln: int32 = js_array_len(arr)
    i: int32 = 0
    while i < ln:
        if i != idx:
            js_array_push(out, js_array_get(arr, i))
        i = i + 1
    return out


# Build document.styleSheets from the source <style> blocks and register each
# owning <style> element so `document.querySelector('style').sheet` returns the
# SAME sheet object (anchor-dedup). External <link> sheets are represented in
# the cascade via he_css_buf but are not modeled here (documented residual).
def _build_stylesheets(doc: int32):
    arr: int32 = js_new_array_v()
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and src_ptr[i + 1] != 47 and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("style")) != 0:
            anchor: uint64 = i
            j: uint64 = i
            j = _hx_tag_end_p(src_ptr, src_len, j)       # end of opening tag
            if j < src_len:
                j = j + 1
            body: uint64 = j
            e: uint64 = body
            while e < src_len:
                if src_ptr[e] == 60 and e + 1 < src_len and src_ptr[e + 1] == 47 and \
                   _tagname_is(e + 2, cast[Ptr[uint8]]("style")) != 0:
                    break
                e = e + 1
            sid: int32 = _cssom_new_sheet(1, 0)
            if sid >= 0:
                obj: int32 = _new_sheet_obj(sid)
                cr: int32 = js_get_prop(obj, cast[Ptr[uint8]]("cssRules"), 8)
                sc: int32 = _sheet_split_load(sid, cr, 0, &src_ptr[body], \
                                              cast[int32](e - body))
                cssom_sheet_srccount[sid] = sc
                _scan_start_tag(anchor)
                sel: int32 = _dom_register_el()
                if js_type_of(sel) == TAG_OBJ:
                    js_set_prop(sel, cast[Ptr[uint8]]("sheet"), 5, obj)
                js_array_push(arr, obj)
            i = e
            continue
        i = i + 1
    js_set_prop(doc, cast[Ptr[uint8]]("styleSheets"), 11, arr)


# Set document.readyState and fire `readystatechange` at the document, which is
# how the spec pairs them. Safe before any listener exists (_fire_document
# pre-scans and no-ops), so the initial "loading" set costs nothing.
def _doc_set_ready(st: Ptr[uint8], n: int32):
    if js_type_of(js_doc) != 5:
        return
    js_set_prop(js_doc, cast[Ptr[uint8]]("readyState"), 10, \
                js_new_string(st, cast[uint64](n)))
    _fire_document(cast[Ptr[uint8]]("readystatechange"), 16)


def _js_build_document():
    _cssom_reset()                       # fresh CSSOM rule model for this page
    doc: int32 = js_new_object_v()
    js_doc = doc
    # DOM interface objects FIRST: every element registered below is branded with
    # HTMLElement.prototype as it is minted, so the class chain is complete
    # without a second pass.
    _build_dom_interfaces()
    js_set_proto_v(doc, g_proto_doc)
    js_set_prop(doc, cast[Ptr[uint8]]("nodeType"), 8, js_number(cast[float64](9)))
    js_set_prop(doc, cast[Ptr[uint8]]("nodeName"), 8, \
                js_new_string(cast[Ptr[uint8]]("#document"), 9))
    # document.readyState — "loading" while the page's <script>s run (they run
    # during the parse, as in a browser), then "interactive" before
    # DOMContentLoaded and "complete" before load. Scripts branch on this
    # constantly ("run now if already loaded, else wait for DOMContentLoaded"),
    # and it read as undefined, which is neither.
    _doc_set_ready(cast[Ptr[uint8]]("loading"), 7)
    js_set_prop(doc, cast[Ptr[uint8]]("getElementById"), 14, \
                js_new_native_fn(js_hbase + NID_GETBYID))
    js_set_prop(doc, cast[Ptr[uint8]]("createElement"), 13, \
                js_new_native_fn(js_hbase + NID_CREATE))
    js_set_prop(doc, cast[Ptr[uint8]]("createTextNode"), 14, \
                js_new_native_fn(js_hbase + NID_CTEXT))
    # document.createEvent(iface) -- the legacy event factory. Still ubiquitous
    # in the wild (and in WPT), and an unknown interface must throw
    # NotSupportedError rather than be silently tolerated.
    js_set_prop(doc, cast[Ptr[uint8]]("createEvent"), 11, \
                js_new_native_fn(js_hbase + NID_CREATEEVENT))
    # The rest of the node-factory surface a framework renderer calls. React
    # creates SVG/MathML hosts through createElementNS, marks Suspense/portal
    # boundaries with createComment, and batches offscreen subtrees into a
    # DocumentFragment before a single mounting append.
    js_set_prop(doc, cast[Ptr[uint8]]("createElementNS"), 15, \
                js_new_native_fn(js_hbase + NID_CREATE_NS))
    js_set_prop(doc, cast[Ptr[uint8]]("createComment"), 13, \
                js_new_native_fn(js_hbase + NID_CREATECOMMENT))
    js_set_prop(doc, cast[Ptr[uint8]]("createRange"), 11, \
                js_new_native_fn(js_hbase + NID_CREATERANGE))
    js_set_prop(doc, cast[Ptr[uint8]]("createTreeWalker"), 16, \
                js_new_native_fn(js_hbase + NID_CREATETW))
    js_set_prop(doc, cast[Ptr[uint8]]("createNodeIterator"), 18, \
                js_new_native_fn(js_hbase + NID_CREATENI))
    js_set_prop(doc, cast[Ptr[uint8]]("createProcessingInstruction"), 27, \
                js_new_native_fn(js_hbase + NID_CREATEPI))
    js_set_prop(doc, cast[Ptr[uint8]]("createDocumentFragment"), 22, \
                js_new_native_fn(js_hbase + NID_CREATEFRAG))
    js_set_prop(doc, cast[Ptr[uint8]]("createAttribute"), 15, \
                js_new_native_fn(js_hbase + NID_CREATEATTR))
    js_set_prop(doc, cast[Ptr[uint8]]("createAttributeNS"), 17, \
                js_new_native_fn(js_hbase + NID_CREATEATTRNS))
    # A document's ownerDocument is null (it IS the document) — code that walks
    # `n.ownerDocument || n` relies on the null, not on undefined.
    js_set_prop(doc, cast[Ptr[uint8]]("ownerDocument"), 13, js_null())
    # document.implementation — the DOMImplementation for THIS document. It is
    # a per-document object (Document-implementation.html asserts a scratch
    # document's implementation is a different object), minted once here.
    js_set_prop(doc, cast[Ptr[uint8]]("implementation"), 14, _new_impl_obj(doc))
    # document.cookie — a live accessor over the jar (see _cookie_read/_write).
    js_define_accessor(doc, cast[Ptr[uint8]]("cookie"), 6, \
                       js_new_native_fn(js_hbase + NID_COOKIE_GET), \
                       js_new_native_fn(js_hbase + NID_COOKIE_SET))
    _node_constants(doc)
    js_set_prop(doc, cast[Ptr[uint8]]("querySelector"), 13, \
                js_new_native_fn(js_hbase + NID_QUERY))
    js_set_prop(doc, cast[Ptr[uint8]]("querySelectorAll"), 16, \
                js_new_native_fn(js_hbase + NID_QUERYALL))
    js_set_prop(doc, cast[Ptr[uint8]]("getElementsByClassName"), 22, \
                js_new_native_fn(js_hbase + NID_GETBYCLASS))
    js_set_prop(doc, cast[Ptr[uint8]]("getElementsByTagName"), 20, \
                js_new_native_fn(js_hbase + NID_GETBYTAG))
    js_set_prop(doc, cast[Ptr[uint8]]("getElementsByTagNameNS"), 22, \
                js_new_native_fn(js_hbase + NID_GETBYTAGNS))
    js_set_prop(doc, cast[Ptr[uint8]]("addEventListener"), 16, \
                js_new_native_fn(js_hbase + NID_ADDEVT))
    # The other two halves of the EventTarget interface on `document`: pages do
    # `document.removeEventListener('keydown', h)` on teardown and
    # `document.dispatchEvent(new Event('visibilitychange'))` (routers, focus
    # traps, custom pub/sub). Both resolve the DOC_EL sentinel — see NID_REMEVT
    # and _fire_document_ev.
    js_set_prop(doc, cast[Ptr[uint8]]("removeEventListener"), 19, \
                js_new_native_fn(js_hbase + NID_REMEVT))
    js_set_prop(doc, cast[Ptr[uint8]]("dispatchEvent"), 13, \
                js_new_native_fn(js_hbase + NID_DISPATCH))
    tl: int32 = _scan_title()
    dom_title_len = tl
    dom_title_present = 1
    js_set_prop(doc, cast[Ptr[uint8]]("title"), 5, \
                js_new_string(&dom_title_buf[0], cast[uint64](tl)))
    _build_forms(doc)
    _build_handler_els()
    # document.documentElement / body / head resolve to the <html> / <body> /
    # <head> element nodes so `document.body.appendChild(...)`, `.style`,
    # `.classList` and `document.documentElement.classList` work. Each is the
    # SAME registered object getElementById/querySelector return, so mutations
    # (appendChild, style, className) reach the live tree + render.
    _doc_set_el(doc, cast[Ptr[uint8]]("documentElement"), 15, \
                cast[Ptr[uint8]]("html"))
    _doc_set_el(doc, cast[Ptr[uint8]]("body"), 4, cast[Ptr[uint8]]("body"))
    _doc_set_el(doc, cast[Ptr[uint8]]("head"), 4, cast[Ptr[uint8]]("head"))
    # document.fonts — a minimal FontFaceSet. Init code (google's emoji probe,
    # webfont loaders) calls .load()/.check() and awaits `.ready`; headless has
    # every font available synchronously, so load()/ready resolve immediately.
    fonts: int32 = js_new_object_v()
    js_set_prop(fonts, cast[Ptr[uint8]]("load"), 4, \
                js_new_native_fn(js_hbase + NID_FONTS_LOAD))
    js_set_prop(fonts, cast[Ptr[uint8]]("check"), 5, \
                js_new_native_fn(js_hbase + NID_FONTS_CHECK))
    js_set_prop(fonts, cast[Ptr[uint8]]("add"), 3, \
                js_new_native_fn(js_hbase + NID_FONTS_NOOP))
    js_set_prop(fonts, cast[Ptr[uint8]]("delete"), 6, \
                js_new_native_fn(js_hbase + NID_FONTS_NOOP))
    js_set_prop(fonts, cast[Ptr[uint8]]("clear"), 5, \
                js_new_native_fn(js_hbase + NID_FONTS_NOOP))
    js_set_prop(fonts, cast[Ptr[uint8]]("forEach"), 7, \
                js_new_native_fn(js_hbase + NID_FONTS_NOOP))
    js_set_prop(fonts, cast[Ptr[uint8]]("ready"), 5, promise_resolve_static(fonts))
    js_set_prop(fonts, cast[Ptr[uint8]]("status"), 6, \
                js_new_string(cast[Ptr[uint8]]("loaded"), 6))
    js_set_prop(fonts, cast[Ptr[uint8]]("size"), 4, js_number(0.0))
    js_set_prop(doc, cast[Ptr[uint8]]("fonts"), 5, fonts)
    # document.styleSheets + each <style>'s `.sheet` (CSSOM). Built AFTER the
    # element accessors so the style elements dedup against any earlier register.
    _build_stylesheets(doc)
    js_global_set(cast[Ptr[uint8]]("document"), 8, doc)
    # window.addEventListener('load'|'DOMContentLoaded'|…, fn) — the `window`
    # object is the JS global; give it the same listener methods as `document` so
    # `window.addEventListener('load', …)` and `window.onload = fn` (real pages'
    # dominant init hook) fire at load time. window-registered listeners record
    # under the DOC_EL sentinel (the headless model fires the window + document
    # load lifecycle together — see _fire_document / the _run_scripts tail).
    js_win = js_global_get(cast[Ptr[uint8]]("window"), 6)
    if js_type_of(js_win) == 5:                           # 5 == object tag
        # document.defaultView === window. Frameworks resolve the owning window
        # from a node this way — React's selection restore does
        # `(c.ownerDocument||document).defaultView||window` — and a getSelection
        # or event-constructor lookup off `undefined` is a hard throw.
        js_set_prop(doc, cast[Ptr[uint8]]("defaultView"), 11, js_win)
        js_set_prop(js_win, cast[Ptr[uint8]]("document"), 8, doc)
        js_set_prop(js_win, cast[Ptr[uint8]]("addEventListener"), 16, \
                    js_new_native_fn(js_hbase + NID_ADDEVT))
        js_set_prop(js_win, cast[Ptr[uint8]]("removeEventListener"), 19, \
                    js_new_native_fn(js_hbase + NID_REMEVT))
        # window.dispatchEvent(new Event('resize'|'hashchange'|…)) — same DOC_EL
        # listener pool as document (the headless model unifies the two).
        js_set_prop(js_win, cast[Ptr[uint8]]("dispatchEvent"), 13, \
                    js_new_native_fn(js_hbase + NID_DISPATCH))
    # Global event constructors: `new Event('x',{bubbles})`, `new CustomEvent
    # ('x',{detail})`, plus MouseEvent/KeyboardEvent (extra fields). Each returns
    # a fresh event object usable with dispatchEvent (which reads ev.type).
    # Real, constructable interfaces (their NID natives build fields on `new`).
    _mk_ev_iface(cast[Ptr[uint8]]("Event"), 5, NID_EVENT_CTOR, 0)
    # Event.NONE / CAPTURING_PHASE / AT_TARGET / BUBBLING_PHASE live on the
    # interface object as well as on instances, and on Event.prototype so an
    # `ev.NONE`-through-the-chain read resolves too.
    _event_constants(js_global_get(cast[Ptr[uint8]]("Event"), 5))
    _event_constants(g_ev_proto[0])
    # window.DOMException. Needed as a real constructor, not just a name: a
    # thrown DOMException must satisfy `e.constructor === self.DOMException`,
    # which is the last thing testharness's assert_throws_dom checks.
    g_domexc_ctor = js_new_native_fn(js_hbase + NID_DOMEXC_CTOR)
    js_global_set(cast[Ptr[uint8]]("DOMException"), 12, g_domexc_ctor)
    g_proto_domexc = js_fn_prototype(g_domexc_ctor)
    _mk_ev_iface(cast[Ptr[uint8]]("CustomEvent"), 11, NID_CUSTOMEVENT, 1)
    _mk_ev_iface(cast[Ptr[uint8]]("MouseEvent"), 10, NID_MOUSEEVENT, 2)
    _mk_ev_iface(cast[Ptr[uint8]]("KeyboardEvent"), 13, NID_KEYBDEVENT, 3)
    # UIEvent + the legacy-only interfaces document.createEvent must still mint.
    # They are not independently constructable in this engine, so their global
    # constructor reuses the base Event native — but each carries its OWN
    # prototype object, because createEvent brands the returned event with
    # exactly window[iface].prototype and the WPT alias test compares identity.
    # UIEvent / FocusEvent / CompositionEvent / WheelEvent ARE constructable and
    # each carries its own init dictionary — they get their own natives so
    # _make_event knows which members to read. (They also need the interface's
    # OWN prototype on the instance, which the shared-native wiring could not
    # give them: `new UIEvent("x") instanceof UIEvent` was false.)
    _mk_ev_iface(cast[Ptr[uint8]]("UIEvent"), 7, NID_UIEVENT, 4)
    _mk_ev_iface(cast[Ptr[uint8]]("BeforeUnloadEvent"), 17, NID_EVENT_CTOR, 5)
    _mk_ev_iface(cast[Ptr[uint8]]("CompositionEvent"), 16, NID_COMPEVENT, 6)
    _mk_ev_iface(cast[Ptr[uint8]]("DeviceMotionEvent"), 17, NID_EVENT_CTOR, 7)
    _mk_ev_iface(cast[Ptr[uint8]]("DeviceOrientationEvent"), 22, NID_EVENT_CTOR, 8)
    _mk_ev_iface(cast[Ptr[uint8]]("DragEvent"), 9, NID_EVENT_CTOR, 9)
    _mk_ev_iface(cast[Ptr[uint8]]("FocusEvent"), 10, NID_FOCUSEVENT, 10)
    _mk_ev_iface(cast[Ptr[uint8]]("HashChangeEvent"), 15, NID_EVENT_CTOR, 11)
    _mk_ev_iface(cast[Ptr[uint8]]("MessageEvent"), 12, NID_EVENT_CTOR, 12)
    _mk_ev_iface(cast[Ptr[uint8]]("StorageEvent"), 12, NID_EVENT_CTOR, 13)
    _mk_ev_iface(cast[Ptr[uint8]]("TextEvent"), 9, NID_EVENT_CTOR, 14)
    _mk_ev_iface(cast[Ptr[uint8]]("WheelEvent"), 10, NID_WHEELEVENT, 15)
    # Link the event interface prototypes into the spec's inheritance chain.
    # Each _mk_ev_iface built a FREESTANDING prototype, so `new MouseEvent(…)
    # instanceof UIEvent` (and instanceof Event) was false for every subclass.
    _ev_inherit(1, 0)        # CustomEvent        -> Event
    _ev_inherit(4, 0)        # UIEvent            -> Event
    _ev_inherit(5, 0)        # BeforeUnloadEvent  -> Event
    _ev_inherit(7, 0)        # DeviceMotionEvent  -> Event
    _ev_inherit(8, 0)        # DeviceOrientation  -> Event
    _ev_inherit(11, 0)       # HashChangeEvent    -> Event
    _ev_inherit(12, 0)       # MessageEvent       -> Event
    _ev_inherit(13, 0)       # StorageEvent       -> Event
    _ev_inherit(2, 4)        # MouseEvent         -> UIEvent
    _ev_inherit(3, 4)        # KeyboardEvent      -> UIEvent
    _ev_inherit(6, 4)        # CompositionEvent   -> UIEvent
    _ev_inherit(10, 4)       # FocusEvent         -> UIEvent
    _ev_inherit(14, 4)       # TextEvent          -> UIEvent
    _ev_inherit(9, 2)        # DragEvent          -> MouseEvent
    _ev_inherit(15, 2)       # WheelEvent         -> MouseEvent
    # `new Image()` constructor — a common preload/beacon global (round: google).
    js_global_set(cast[Ptr[uint8]]("Image"), 5, \
                  js_new_native_fn(js_hbase + NID_IMAGE_CTOR))
    # `new CSSStyleSheet()` — constructible stylesheet (adoptedStyleSheets +
    # replaceSync); inactive until adopted, so it adds nothing to the cascade
    # until `document.adoptedStyleSheets = [sheet]`.
    js_global_set(cast[Ptr[uint8]]("CSSStyleSheet"), 13, \
                  js_new_native_fn(js_hbase + NID_CSSSHEET_CTOR))
    # getComputedStyle(el) — a window/global function returning a resolved-style
    # object (dropdown/tooltip/carousel code reads .display / .width off it).
    js_global_set(cast[Ptr[uint8]]("getComputedStyle"), 16, \
                  js_new_native_fn(js_hbase + NID_GETCOMPSTYLE))
    # window.matchMedia(query) — a MediaQueryList whose `.matches` re-uses the
    # engine's @media evaluator (he_media_match) against the LIVE viewport. Both
    # `window.matchMedia` and the bare global resolve (like getComputedStyle).
    js_global_set(cast[Ptr[uint8]]("matchMedia"), 10, \
                  js_new_native_fn(js_hbase + NID_MATCHMEDIA))
    if js_type_of(js_win) == 5:
        js_set_prop(js_win, cast[Ptr[uint8]]("matchMedia"), 10, \
                    js_new_native_fn(js_hbase + NID_MATCHMEDIA))
    # Observer constructors modern frameworks depend on. Each is a native
    # constructor; `new X(cb)` runs the ctor NID handler with the fresh instance
    # as `this` (see _obs_dispatch). Reset the (per-page) observer registries so a
    # fresh js_init starts clean.
    _obs_reset()
    js_global_set(cast[Ptr[uint8]]("MutationObserver"), 16, \
                  js_new_native_fn(js_hbase + NID_MO_CTOR))
    js_global_set(cast[Ptr[uint8]]("IntersectionObserver"), 20, \
                  js_new_native_fn(js_hbase + NID_IO_CTOR))
    js_global_set(cast[Ptr[uint8]]("ResizeObserver"), 14, \
                  js_new_native_fn(js_hbase + NID_RO_CTOR))
    # window.history + window.location methods (History API / Location).
    _wire_history_location()
    # The DOCUMENT URL, when the front-end supplied one: <base href> is applied
    # (HTML "document base URL"), then location.* / document.URL /
    # document.baseURI / document.documentURI are filled in from it. Without a
    # document URL none of this runs and location stays the about:blank stub the
    # JS engine installs, exactly as before.
    _apply_base_href()
    if doc_url_len > 0:
        _url_parse_into(g_js_location, &doc_url[0], doc_url_len)
        js_set_prop(js_doc, cast[Ptr[uint8]]("URL"), 3, \
                    js_new_string(&doc_url[0], cast[uint64](doc_url_len)))
        js_set_prop(js_doc, cast[Ptr[uint8]]("documentURI"), 11, \
                    js_new_string(&doc_url[0], cast[uint64](doc_url_len)))
        js_set_prop(js_doc, cast[Ptr[uint8]]("baseURI"), 7, \
                    js_new_string(&base_url[0], cast[uint64](base_url_len)))


# Eagerly register every <form> and its fields, exposing document.forms and
# each form's .elements array so a script can iterate them. Registering here
# means getElementById later returns the SAME element objects.
def _build_forms(doc: int32):
    forms: int32 = js_new_array_v()
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("form")) != 0:
            _scan_start_tag(i)
            fclose: uint64 = g_close_end
            fi: int32 = _dom_lookup_anchor(cast[int32](g_el_lt))
            if fi < 0:
                _dom_register_el()
                fi = _dom_lookup_anchor(cast[int32](g_el_lt))
            if fi >= 0:
                fobj: int32 = dom_obj[fi]
                elems: int32 = js_new_array_v()
                cs: uint64 = cast[uint64](dom_cstart[fi])
                ce: uint64 = cast[uint64](dom_cend[fi])
                j: uint64 = cs
                while j < ce:
                    if src_ptr[j] == 60 and j + 1 < ce and \
                       (_tagname_is(j + 1, cast[Ptr[uint8]]("input")) != 0 or \
                        _tagname_is(j + 1, cast[Ptr[uint8]]("select")) != 0 or \
                        _tagname_is(j + 1, cast[Ptr[uint8]]("textarea")) != 0):
                        _scan_start_tag(j)
                        jclose: uint64 = g_close_end
                        ei: int32 = _dom_lookup_anchor(cast[int32](g_el_lt))
                        if ei < 0:
                            _dom_register_el()
                            ei = _dom_lookup_anchor(cast[int32](g_el_lt))
                        if ei >= 0:
                            js_array_push(elems, dom_obj[ei])
                        j = jclose
                        continue
                    j = j + 1
                js_set_prop(fobj, cast[Ptr[uint8]]("elements"), 8, elems)
                js_array_push(forms, fobj)
            i = fclose
            continue
        i = i + 1
    js_set_prop(doc, cast[Ptr[uint8]]("forms"), 5, forms)


# Does the start tag beginning at `lt` (the '<') carry an inline on<evt>=""
# attribute? Same name test _page_has_js uses, applied to ONE tag.
def _tag_has_inline_handler(lt: uint64) -> int32:
    q: uint64 = lt + 1
    prev_ws: int32 = 0
    qe: uint64 = _hx_tag_end_p(src_ptr, src_len, lt + 1)      # quote-aware '>'
    while q < qe:
        c: uint8 = src_ptr[q]
        # A quoted attribute VALUE is not attribute-name text: skip it whole, so
        # `title="tap onx=1"` cannot be mistaken for an on<evt>= handler.
        if c == 61:                                          # '='
            q = _hx_attr_val_skip(q)
            prev_ws = 0
            continue
        if prev_ws != 0 and (c == 111 or c == 79) and \
           q + 2 < src_len and (src_ptr[q + 1] == 110 or src_ptr[q + 1] == 78):
            r: uint64 = q + 2
            nletters: int32 = 0
            while r < src_len and src_ptr[r] != 62 and \
                  ((src_ptr[r] >= 97 and src_ptr[r] <= 122) or \
                   (src_ptr[r] >= 65 and src_ptr[r] <= 90)):
                r = r + 1
                nletters = nletters + 1
            while r < src_len and \
                  (src_ptr[r] == 32 or src_ptr[r] == 9 or \
                   src_ptr[r] == 10 or src_ptr[r] == 13):
                r = r + 1
            if nletters >= 1 and r < src_len and src_ptr[r] == 61:   # '='
                return 1
        if c == 32 or c == 9 or c == 10 or c == 13:
            prev_ws = 1
        else:
            prev_ws = 0
        q = q + 1
    return 0


# Eagerly register every element carrying an inline on<evt>="" handler, for the
# NATIVE pointer path only (he_click_links).
#
# DOM records are minted lazily — an element gets one the first time a script
# looks it up. A page whose only interactivity is `<div onclick="...">` never
# looks anything up, so the element had NO record, _el_has_handler() could not
# see it, the rewrite never wrapped it in the synthetic "#__evt_N" link, and a
# pointer click on it hit nothing at all (HITLINK -1). Registering the handler
# elements up front is what makes them reachable; everything downstream (the
# wrap, he_link_evt_index, he_dom_click_index) already existed.
#
# Host renders (he_click_links == 0) do nothing here, so their output and every
# host gate stay byte-identical.
def _build_handler_els():
    if he_click_links == 0:
        return
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and src_ptr[i + 1] != 47 and \
           src_ptr[i + 1] != 33 and src_ptr[i + 1] != 63 and \
           _alnum_at(i + 1) != 0:
            if _tag_has_inline_handler(i) != 0:
                _scan_start_tag(i)
                if _dom_lookup_anchor(cast[int32](g_el_lt)) < 0:
                    _dom_register_el()
        i = i + 1


# Is `p[0..n)` the literal "undefined"? (a read of a never-set JS property).
def _is_undef_str(p: Ptr[uint8], n: int32) -> int32:
    return _bytes_eq(p, n, cast[Ptr[uint8]]("undefined"), 9)


# Read one JS string property `name` of object `o`; if non-empty and not
# "undefined", copy it into dom_ovbuf and set *off/*len via the returned pair
# encoded as: returns the length, and sets g_rb_off to the offset. -1 = unset.
g_rb_off: int32 = 0


def _readback_str(o: int32, name: Ptr[uint8], nlen: uint64) -> int32:
    v: int32 = js_get_prop(o, name, nlen)
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if n == 0 or _is_undef_str(p, n) != 0:
        return -1
    g_rb_off = dom_ov_len
    k: int32 = 0
    while k < n and dom_ov_len < DOM_OV_CAP:
        dom_ovbuf[dom_ov_len] = p[k]
        dom_ov_len = dom_ov_len + 1
        k = k + 1
    return k


# Read the JS-mutated DOM back into the override tables. Idempotent: resets the
# override accumulators first, so it can run after the initial scripts AND
# again after an event handler mutates the DOM.
# Find the setAttribute-override slot for (element, name), or -1.
def _sattr_find(el: int32, np: Ptr[uint8], nn: int32) -> int32:
    i: int32 = 0
    while i < sattr_n:
        if sattr_el[i] == el and sattr_nlen[i] == nn and \
           _idbytes_buf_eq(sattr_noff[i], nn, np, nn) != 0:
            return i
        i = i + 1
    return -1


# Case-insensitive compare of sattr_buf[off..off+n) against p[0..pn).
def _idbytes_buf_eq(off: int32, n: int32, p: Ptr[uint8], pn: int32) -> int32:
    if n != pn:
        return 0
    i: int32 = 0
    while i < n:
        if _hx_lower(sattr_buf[off + i]) != _hx_lower(p[i]):
            return 0
        i = i + 1
    return 1


# Record `el.name = value` (vlen < 0 = removeAttribute tombstone). Overwrites an
# existing slot only when the new value fits it exactly; otherwise a fresh slot
# is appended and _sattr_find's linear scan (which returns the FIRST match)
# would find the stale one — so the old slot is retired by clearing its element.
def _sattr_set(el: int32, np: Ptr[uint8], nn: int32, vp: Ptr[uint8], vn: int32):
    if el < 0 or nn <= 0:
        return
    old: int32 = _sattr_find(el, np, nn)
    if old >= 0:
        sattr_el[old] = -1
    if sattr_n >= SATTR_MAX:
        return
    if sattr_buf_len + nn + vn >= SATTR_BUF_CAP:
        return
    s: int32 = sattr_n
    sattr_el[s] = el
    sattr_noff[s] = sattr_buf_len
    sattr_nlen[s] = nn
    i: int32 = 0
    while i < nn:
        sattr_buf[sattr_buf_len] = np[i]
        sattr_buf_len = sattr_buf_len + 1
        i = i + 1
    sattr_voff[s] = sattr_buf_len
    if vn < 0:
        sattr_vlen[s] = -1
    else:
        sattr_vlen[s] = vn
        j: int32 = 0
        while j < vn:
            sattr_buf[sattr_buf_len] = vp[j]
            sattr_buf_len = sattr_buf_len + 1
            j = j + 1
    sattr_n = s + 1


# Assign a URL-VALUED IDL property (href / src) from an arbitrary string,
# resolved against the document base URL exactly as _reflect_url_attr does at
# registration time. setAttribute used to store the RAW string, so
# `a.setAttribute('href','b.html')` left `.href` relative where chromium
# reports the absolute URL.
def _set_url_prop(o: int32, name: Ptr[uint8], nlen: uint64, vp: Ptr[uint8], vn: int32):
    if base_url_len <= 0 or vn <= 0:
        js_set_prop(o, name, nlen, js_new_string(vp, cast[uint64](vn)))
        return
    sa: int32 = 0
    sb: int32 = vn
    while sa < sb and vp[sa] <= 32:
        sa = sa + 1
    while sb > sa and vp[sb - 1] <= 32:
        sb = sb - 1
    if sb <= sa:
        js_set_prop(o, name, nlen, js_new_string(vp, cast[uint64](vn)))
        return
    n2: int32 = _url_resolve(&vp[sa], sb - sa, &base_url[0], base_url_len)
    js_set_prop(o, name, nlen, js_new_string(&url_buf_a[0], cast[uint64](n2)))


# Is `name` a URL-valued content attribute whose IDL property is absolutised?
def _is_url_attr(p: Ptr[uint8], n: int32) -> int32:
    if _bytes_eq(p, n, cast[Ptr[uint8]]("href"), 4) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("src"), 3) != 0:
        return 1
    return 0


def _dom_readback():
    dom_ov_len = 0
    dom_n_overrides = 0
    idx: int32 = 0
    while idx < dom_n:
        o: int32 = dom_obj[idx]
        dom_ov_inner_off[idx] = -1
        dom_ov_inner_len[idx] = -1
        dom_ov_inner_html[idx] = 0
        dom_ov_col_off[idx] = -1
        dom_ov_col_len[idx] = -1
        dom_ov_bg_off[idx] = -1
        dom_ov_bg_len[idx] = -1
        dom_ov_wt_off[idx] = -1
        dom_ov_wt_len[idx] = -1
        dom_ov_al_off[idx] = -1
        dom_ov_al_len[idx] = -1
        dom_ov_wd_off[idx] = -1
        dom_ov_wd_len[idx] = -1
        dom_ov_cls_off[idx] = -1
        dom_ov_cls_len[idx] = -1
        dom_ov_hide[idx] = 0
        dom_ov_val_off[idx] = -1
        dom_ov_val_len[idx] = -1
        dom_ov_checked[idx] = -1
        changed: int32 = 0
        # DID SCRIPT TOUCH THIS ELEMENT'S INNER CONTENT?
        #
        # Two things used to make this question unanswerable on a real page.
        # (1) The baseline was a snapshot in a shared 64 KiB arena, so on any
        #     real document it was truncated or empty and the diff mis-fired —
        #     the rewrite then re-serialised the element as flat escaped text
        #     (tags lost, <style>/<script> leaking as prose). dom_orig_trunc
        #     papered over that by skipping the check entirely.
        # (2) The CURRENT value was read through js_str_ptr(), which renders via
        #     a 64 KiB scratch ring slot and SILENTLY TRUNCATES past it — so an
        #     untouched <body> looked mutated the moment its text exceeded 64 KiB.
        #
        # Both are gone. textContent/innerHTML are lazy prototype accessors, so
        # an OWN property exists only if script read or wrote one (js_has_own);
        # untouched elements are skipped without materialising anything. When
        # one does exist we compare it, UNTRUNCATED (js_str_bytes), against the
        # original re-derived by streaming the source span (_text_span_eq /
        # _html_span_eq) — no stored baseline, exact at any size.
        # innerHTML (raw) takes priority over textContent (escaped) as inner.
        hp: Ptr[uint8] = cast[Ptr[uint8]]("")
        hn: int32 = 0
        hown: int32 = js_has_own(o, cast[Ptr[uint8]]("innerHTML"), 9)
        if hown != 0:
            hv: int32 = js_get_prop(o, cast[Ptr[uint8]]("innerHTML"), 9)
            hp = js_str_bytes(hv)
            hn = js_str_bytelen(hv)
            if _is_undef_str(hp, hn) != 0:
                hown = 0
            elif _html_span_eq(hp, hn, cast[uint64](dom_cstart[idx]), \
                               cast[uint64](dom_cend[idx])) != 0:
                hown = 0                                  # identical: untouched
        if hown != 0:
            off: int32 = dom_ov_len
            k: int32 = 0
            while k < hn and dom_ov_len < DOM_OV_CAP:
                dom_ovbuf[dom_ov_len] = hp[k]
                dom_ov_len = dom_ov_len + 1
                k = k + 1
            if k < hn and dom_warn_ov == 0:
                dom_warn_ov = 1
                js_out_note(cast[Ptr[uint8]]("[engine] CEILING DOM_OV_CAP reached: a JS-written innerHTML/textContent is clipped in the render. DOM_OV_CAP="), DOM_OV_CAP)
            dom_ov_inner_off[idx] = off
            dom_ov_inner_len[idx] = k
            dom_ov_inner_html[idx] = 1
            changed = 1
        elif js_has_own(o, cast[Ptr[uint8]]("textContent"), 11) != 0:
            tc: int32 = js_get_prop(o, cast[Ptr[uint8]]("textContent"), 11)
            tp: Ptr[uint8] = js_str_bytes(tc)
            tn: int32 = js_str_bytelen(tc)
            if _is_undef_str(tp, tn) == 0 and \
               _text_span_eq(tp, tn, cast[uint64](dom_cstart[idx]), \
                             cast[uint64](dom_cend[idx])) == 0:
                off2: int32 = dom_ov_len
                k2: int32 = 0
                while k2 < tn and dom_ov_len < DOM_OV_CAP:
                    dom_ovbuf[dom_ov_len] = tp[k2]
                    dom_ov_len = dom_ov_len + 1
                    k2 = k2 + 1
                dom_ov_inner_off[idx] = off2
                dom_ov_inner_len[idx] = k2
                dom_ov_inner_html[idx] = 0
                changed = 1
        # style props. el.style is a LAZY accessor now, so reading it here for
        # every element would materialise a CSSStyleDeclaration for all of them
        # and undo the saving. No own property => script never touched .style =>
        # there is nothing to read back.
        # (member_get on undefined THROWS a TypeError, so this must be a real
        # branch, not an undefined sentinel fed to js_get_prop.)
        if js_has_own(o, cast[Ptr[uint8]]("style"), 5) != 0:
          stv: int32 = js_get_prop(o, cast[Ptr[uint8]]("style"), 5)
          r: int32 = _readback_str(stv, cast[Ptr[uint8]]("color"), 5)
          if r >= 0:
              dom_ov_col_off[idx] = g_rb_off
              dom_ov_col_len[idx] = r
              changed = 1
          r = _readback_str(stv, cast[Ptr[uint8]]("backgroundColor"), 15)
          if r >= 0:
              dom_ov_bg_off[idx] = g_rb_off
              dom_ov_bg_len[idx] = r
              changed = 1
          r = _readback_str(stv, cast[Ptr[uint8]]("fontWeight"), 10)
          if r >= 0:
              dom_ov_wt_off[idx] = g_rb_off
              dom_ov_wt_len[idx] = r
              changed = 1
          r = _readback_str(stv, cast[Ptr[uint8]]("textAlign"), 9)
          if r >= 0:
              dom_ov_al_off[idx] = g_rb_off
              dom_ov_al_len[idx] = r
              changed = 1
          r = _readback_str(stv, cast[Ptr[uint8]]("width"), 5)
          if r >= 0:
              dom_ov_wd_off[idx] = g_rb_off
              dom_ov_wd_len[idx] = r
              changed = 1
          # display:none
          dv: int32 = js_get_prop(stv, cast[Ptr[uint8]]("display"), 7)
          dp: Ptr[uint8] = js_str_ptr(dv)
          dn: int32 = _cstr_len(dp)
          if _bytes_eq(dp, dn, cast[Ptr[uint8]]("none"), 4) != 0:
              dom_ov_hide[idx] = 1
              changed = 1
        # className
        clv: int32 = js_get_prop(o, cast[Ptr[uint8]]("className"), 9)
        clp: Ptr[uint8] = js_str_ptr(clv)
        cln: int32 = _cstr_len(clp)
        if _bytes_eq(clp, cln, &dom_txtbuf[dom_origcls_off[idx]], \
                     dom_origcls_len[idx]) == 0 and _is_undef_str(clp, cln) == 0:
            cco: int32 = dom_ov_len
            kc: int32 = 0
            while kc < cln and dom_ov_len < DOM_OV_CAP:
                dom_ovbuf[dom_ov_len] = clp[kc]
                dom_ov_len = dom_ov_len + 1
                kc = kc + 1
            dom_ov_cls_off[idx] = cco
            dom_ov_cls_len[idx] = kc
            changed = 1
        # form value / checked read-back (input / textarea / select).
        if dom_kind[idx] == 1 or dom_kind[idx] == 2 or dom_kind[idx] == 3:
            vv: int32 = js_get_prop(o, cast[Ptr[uint8]]("value"), 5)
            vp: Ptr[uint8] = js_str_ptr(vv)
            vn: int32 = _cstr_len(vp)
            if _bytes_eq(vp, vn, &dom_txtbuf[dom_origval_off[idx]], \
                         dom_origval_len[idx]) == 0 and _is_undef_str(vp, vn) == 0:
                voff: int32 = dom_ov_len
                kv: int32 = 0
                while kv < vn and dom_ov_len < DOM_OV_CAP:
                    dom_ovbuf[dom_ov_len] = vp[kv]
                    dom_ov_len = dom_ov_len + 1
                    kv = kv + 1
                dom_ov_val_off[idx] = voff
                dom_ov_val_len[idx] = kv
                changed = 1
        # select: a JS `selectedIndex = N` write with no matching value write
        # resolves to the Nth option's text so the control re-marks + re-renders.
        if dom_kind[idx] == 3 and dom_ov_val_len[idx] < 0:
            siv: int32 = js_get_prop(o, cast[Ptr[uint8]]("selectedIndex"), 13)
            si: int32 = cast[int32](js_to_number(siv))
            oi: int32 = _select_index(cast[uint64](dom_cstart[idx]))
            if si != oi and si >= 0:
                sn: int32 = _select_optext_at(cast[uint64](dom_cstart[idx]), si)
                if sn >= 0:
                    soff: int32 = dom_ov_len
                    ks: int32 = 0
                    while ks < sn and dom_ov_len < DOM_OV_CAP:
                        dom_ovbuf[dom_ov_len] = fbuf[ks]
                        dom_ov_len = dom_ov_len + 1
                        ks = ks + 1
                    dom_ov_val_off[idx] = soff
                    dom_ov_val_len[idx] = ks
                    js_set_prop(o, cast[Ptr[uint8]]("value"), 5, \
                                js_new_string(&fbuf[0], cast[uint64](ks)))
                    changed = 1
        if dom_origchecked[idx] >= 0:
            ckv: int32 = js_get_prop(o, cast[Ptr[uint8]]("checked"), 7)
            ckb: int32 = 0
            if js_to_bool(ckv) != 0:
                ckb = 1
            if ckb != dom_origchecked[idx]:
                dom_ov_checked[idx] = ckb
                changed = 1
        # assigned handler-function properties (el.onX = fn).
        ocv: int32 = js_get_prop(o, cast[Ptr[uint8]]("onclick"), 7)
        if js_is_callable(ocv) != 0:
            dom_onclick_fn[idx] = ocv
        oiv: int32 = js_get_prop(o, cast[Ptr[uint8]]("oninput"), 7)
        if js_is_callable(oiv) != 0:
            dom_oninput_fn[idx] = oiv
        ocgv: int32 = js_get_prop(o, cast[Ptr[uint8]]("onchange"), 8)
        if js_is_callable(ocgv) != 0:
            dom_onchange_fn[idx] = ocgv
        osv: int32 = js_get_prop(o, cast[Ptr[uint8]]("onsubmit"), 8)
        if js_is_callable(osv) != 0:
            dom_onsubmit_fn[idx] = osv
        # appended children force a rewrite of this element too.
        a: int32 = 0
        while a < ap_n:
            if ap_removed[a] == 0 and ap_parent[a] == idx:
                changed = 1
            a = a + 1
        if changed != 0:
            dom_n_overrides = dom_n_overrides + 1
        idx = idx + 1
    # document.title
    tv: int32 = js_get_prop(js_doc, cast[Ptr[uint8]]("title"), 5)
    pp: Ptr[uint8] = js_str_ptr(tv)
    pn: int32 = _cstr_len(pp)
    if pn > 255:
        pn = 255
    j: int32 = 0
    while j < pn:
        dom_title_buf[j] = pp[j]
        j = j + 1
    dom_title_len = pn
    dom_title_present = 1


def _js_capture_console():
    p: Ptr[uint8] = js_out_ptr()
    n: int32 = cast[int32](js_out_len())
    i: int32 = 0
    while i < n and i < 1048575:
        js_con_buf[i] = p[i]
        i = i + 1
    js_con_buf[i] = 0
    js_con_len = i


# True if the source contains a <script> element OR any inline event-handler
# attribute (onclick=/oninput=/onchange=/onsubmit=/onkeyup=/...). A page whose
# only JS is inline handlers (no <script> block) — extremely common on real
# forms/buttons — still needs a live JS context so he_dom_click / set_value can
# fire those handlers and re-render. Attribute names are matched only at an
# attribute-name boundary (preceded by whitespace) inside a tag, so the word
# "onclick" in body text never triggers a spurious JS init.
def _page_has_js() -> int32:
    p: uint64 = 0
    while p < src_len:
        if src_ptr[p] != 60:                                 # '<'
            p = p + 1
            continue
        if p + 1 < src_len and \
           _tagname_is(p + 1, cast[Ptr[uint8]]("script")) != 0:
            return 1
        # scan this tag's attributes for an on<letters>= handler name
        q: uint64 = p + 1
        prev_ws: int32 = 0
        qe: uint64 = _hx_tag_end_p(src_ptr, src_len, p + 1)   # quote-aware '>'
        while q < qe:
            c: uint8 = src_ptr[q]
            # quoted attribute VALUE is not name text — skip it whole (see
            # _tag_has_inline_handler).
            if c == 61:                                      # '='
                q = _hx_attr_val_skip(q)
                prev_ws = 0
                continue
            if prev_ws != 0 and (c == 111 or c == 79) and \
               q + 2 < src_len and (src_ptr[q + 1] == 110 or src_ptr[q + 1] == 78):
                # "on" at a name boundary: require >=1 more letter then '='
                r: uint64 = q + 2
                nletters: int32 = 0
                while r < src_len and src_ptr[r] != 62 and \
                      ((src_ptr[r] >= 97 and src_ptr[r] <= 122) or \
                       (src_ptr[r] >= 65 and src_ptr[r] <= 90)):
                    r = r + 1
                    nletters = nletters + 1
                while r < src_len and \
                      (src_ptr[r] == 32 or src_ptr[r] == 9 or \
                       src_ptr[r] == 10 or src_ptr[r] == 13):
                    r = r + 1
                if nletters >= 1 and r < src_len and src_ptr[r] == 61:   # '='
                    return 1
            if c == 32 or c == 9 or c == 10 or c == 13:
                prev_ws = 1
            else:
                prev_ws = 0
            q = q + 1
        p = q
    return 0


# True if a <script> start tag [ts,te) carries `type="module"` (case-insensitive)
# — the trigger to evaluate its body as an ES module rather than a classic script.
# Lowercased, whitespace-stripped copy of a <script type=...> value.
_stype_buf: Array[80, uint8]
_stype_len: int32 = 0


def _stype_suffix_is(s: Ptr[uint8]) -> int32:
    # does _stype_buf end with the cstr `s`?
    n: int32 = 0
    while s[n] != 0:
        n = n + 1
    if n > _stype_len:
        return 0
    base: int32 = _stype_len - n
    k: int32 = 0
    while k < n:
        if _stype_buf[base + k] != s[k]:
            return 0
        k = k + 1
    return 1


def _stype_prefix_is(s: Ptr[uint8]) -> int32:
    k: int32 = 0
    while s[k] != 0:
        if k >= _stype_len:
            return 0
        if _stype_buf[k] != s[k]:
            return 0
        k = k + 1
    return 1


# The attribute names _dom_register_el reflects onto every element object with a
# "" default (see _reflect_str_attr). Kept in one place so getAttribute can tell
# "reflected default" apart from a real empty attribute.
def _is_reflected_idl_attr(nm: Ptr[uint8], n: int32) -> int32:
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("src"), 3) != 0:
        return 1
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("href"), 4) != 0:
        return 1
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("alt"), 3) != 0:
        return 1
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("title"), 5) != 0:
        return 1
    return 0


def _script_type_executable(ts: uint64, te: uint64) -> int32:
    # HTML's "classic script" gate. A <script> may only be EXECUTED when its
    # `type` is absent, empty, "module", or a JavaScript MIME type. Every other
    # value is a DATA BLOCK that the parser must leave alone — most importantly
    # `application/ld+json` (schema.org markup, present on a very large share of
    # the real web), plus `text/template` and `application/json`.
    #
    # We used to feed all of them to the JS engine, which reported a spurious
    # "SyntaxError: unexpected token in expression" on pages whose real
    # JavaScript is perfectly clean — this was Wikipedia's ONLY JS error.
    if _hx_find_attr(ts, te, cast[Ptr[uint8]]("type")) == 0:
        return 1                                  # no type => classic script
    n: int32 = 0
    p: uint64 = g_attr_start
    while p < g_attr_end and n < 79:
        c: uint8 = _hx_lower(src_ptr[p])
        # drop ASCII whitespace, and truncate at a MIME parameter
        # (`text/javascript; charset=utf-8`)
        if c == 59:
            break
        if c != 32 and c != 9 and c != 10 and c != 13 and c != 12:
            _stype_buf[n] = c
            n = n + 1
        p = p + 1
    _stype_buf[n] = 0
    _stype_len = n
    if n == 0:
        return 1                                  # type="" => classic script
    if _stype_suffix_is(cast[Ptr[uint8]]("module")) != 0 and n == 6:
        return 1
    # The whole legacy JS MIME list (text/javascript, application/javascript,
    # text/ecmascript, application/x-ecmascript, text/jscript, text/livescript,
    # text/javascript1.5, …) ends in one of these four words. `application/json`
    # and `application/ld+json` deliberately do NOT match.
    if _stype_suffix_is(cast[Ptr[uint8]]("javascript")) != 0:
        return 1
    if _stype_suffix_is(cast[Ptr[uint8]]("ecmascript")) != 0:
        return 1
    if _stype_suffix_is(cast[Ptr[uint8]]("jscript")) != 0:
        return 1
    if _stype_suffix_is(cast[Ptr[uint8]]("livescript")) != 0:
        return 1
    # versioned legacy types: `text/javascript1.5`, `text/javascript1.0`, …
    if _stype_prefix_is(cast[Ptr[uint8]]("text/javascript")) != 0:
        return 1
    return 0


def _script_type_is_module(ts: uint64, te: uint64) -> int32:
    if _hx_find_attr(ts, te, cast[Ptr[uint8]]("type")) == 0:
        return 0
    want: Ptr[uint8] = cast[Ptr[uint8]]("module")
    n: int32 = 0
    p: uint64 = g_attr_start
    while p < g_attr_end:
        if want[n] == 0:
            return 0                              # value longer than "module"
        if _hx_lower(src_ptr[p]) != want[n]:
            return 0
        n = n + 1
        p = p + 1
    if want[n] != 0:
        return 0                                  # value shorter than "module"
    return 1


# A unique specifier for an inline module, keyed off its source byte offset so
# two distinct <script type=module> blocks never collide in the module cache.
inline_spec_buf: Array[24, uint8]
_inline_spec_len: uint64 = 0

def _inline_module_spec(off: uint64) -> Ptr[uint8]:
    inline_spec_buf[0] = 105                       # 'i'
    inline_spec_buf[1] = 110                       # 'n'
    inline_spec_buf[2] = 58                        # ':'
    n: int32 = 3
    # decimal of off (offset 0 -> "in:0")
    if off == 0:
        inline_spec_buf[n] = 48
        n = n + 1
    else:
        start: int32 = n
        v: uint64 = off
        while v > 0:
            inline_spec_buf[n] = cast[uint8](48 + cast[int32](v % 10))
            v = v / 10
            n = n + 1
        # reverse the digits in place
        a: int32 = start
        b: int32 = n - 1
        while a < b:
            t: uint8 = inline_spec_buf[a]
            inline_spec_buf[a] = inline_spec_buf[b]
            inline_spec_buf[b] = t
            a = a + 1
            b = b - 1
    inline_spec_buf[n] = 0
    _inline_spec_len = cast[uint64](n)
    return &inline_spec_buf[0]


# Run every <script> body. Returns 1 if at least one script ran (so the DOM
# overrides are meaningful), 0 if the page had no scripts at all.
# Refresh the geometry data properties (offset*/client*/scroll*) of every
# already-registered element from the current layout. Called after the
# pre-layout pass so elements registered before layout (e.g. form fields wired
# up in _js_build_document) still report correct box metrics to scripts.
def _refresh_all_geom():
    i: int32 = 0
    while i < dom_n:
        _set_el_geom_props(dom_obj[i], i)
        i = i + 1


# LIVE-CLASS RESOLVER (bindings.ad seam). Maps a source '<' offset back to the
# element's registered DOM node and returns its LIVE className bytes so the
# selector matcher (_sel_match_at) sees classList/className/setAttribute
# mutations. Returns NULL when the offset is not a live node — the source class
# attribute is then authoritative (e.g. the post-script render relayout runs over
# the class-rewritten source, whose offsets match no original anchor).
def _live_cls_resolve(anchor: int32, out_len: Ptr[int32]) -> Ptr[uint8]:
    idx: int32 = _dom_lookup_anchor(anchor)
    if idx < 0:
        out_len[0] = 0
        return cast[Ptr[uint8]](0)
    p: Ptr[uint8] = _cls_read(idx)                        # NUL-terminated live className
    out_len[0] = _cstr_len(p)
    return p


def _run_scripts() -> int32:
    # A live JS context is needed if the page has a <script> element OR any
    # inline on<evt>="" handler (no <script> required for interactivity).
    has: int32 = _page_has_js()
    # A native front-end (he_click_links) needs a live JS context + registered
    # form fields even for a script-LESS page, so a plain <form> is still
    # pointer-focusable/typable/submittable. Host renders keep the old fast path.
    force_ctx: int32 = 0
    if has == 0 and he_click_links != 0 and _page_has_form() != 0:
        force_ctx = 1
    if has == 0 and force_ctx == 0:
        # No script, but the tab title still needs the page <title> (decoded).
        dom_title_len = _scan_title()
        if dom_title_len > 0:
            dom_title_present = 1
        return 0
    js_init()
    js_hbase = js_host_base()
    js_set_host_dispatch(cast[Fn[int32, int32]](cast[uint64](_js_host_dispatch)))
    js_set_member_hook(cast[Fn[int32, int32]](cast[uint64](_js_member_set_hook)))
    js_set_named_global_hook(js_hbase + NID_NAMED_GLOBAL)
    _js_build_document()
    _dom_build_tree_index()                               # parent/child overlay (round 2)
    js_ctx_live = 1
    # PRE-LAYOUT: lay out the (pre-script) source once so a page's <script>s can
    # read box geometry (getBoundingClientRect / offsetWidth / getComputedStyle).
    # The final _relayout() after scripts rebuilds the segment table with any DOM
    # overrides baked in, so this pass is invisible to the rendered output — it
    # only makes layout coordinates available to script code (as browsers do).
    _layout()
    _refresh_all_geom()
    # The document is now being parsed: script elements reach only a microtask
    # checkpoint, so the timer queue cannot run ahead of DOMContentLoaded/load.
    js_set_page_parsing(1)
    i: uint64 = 0
    while i < src_len:
        # A <script> inside <noscript> (RAWTEXT with scripting enabled — and
        # hambrowse always is) or inside <template> (an inert DocumentFragment)
        # is NOT executed by a browser. This scanner ran both. Verified against
        # chromium --headless on tests/fixtures/hambrowse_inert_sheets.html:
        # a noscript script and a template script both leave their globals
        # UNSET (ns=0 tp=0) while the page's real script runs. Executing the
        # noscript branch is actively wrong — it is the no-JS fallback, and on
        # real sites it redirects or rewrites the page for a JS-less client.
        if src_ptr[i] == 60:
            isk: uint64 = hx_inert_region_skip(i)
            if isk > 0:
                i = isk
                continue
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("script")) != 0:
            # body starts after this start tag's '>'
            j: uint64 = i + 1
            j = _hx_tag_end_p(src_ptr, src_len, j)
            tagclose: uint64 = j                 # position of the start tag's '>'
            if j < src_len:
                j = j + 1
            bs: uint64 = j
            is_mod: int32 = _script_type_is_module(i, tagclose)
            # data blocks (application/ld+json, text/template, …) are skipped
            runnable: int32 = _script_type_executable(i, tagclose)
            # body ends at </script>
            be: uint64 = bs
            while be < src_len:
                if src_ptr[be] == 60 and be + 1 < src_len and \
                   src_ptr[be + 1] == 47 and \
                   _tagname_is(be + 2, cast[Ptr[uint8]]("script")) != 0:
                    break
                be = be + 1
            if be > bs and runnable != 0:
                if is_mod != 0:
                    # `<script type=module>`: evaluate as an ES module (own scope,
                    # deferred-style, imports resolved through the browser's module
                    # resolver). A unique specifier per inline module keeps the
                    # module cache from collapsing distinct blocks together.
                    js_run_module(&src_ptr[bs], be - bs, _inline_module_spec(bs), _inline_spec_len)
                else:
                    js_eval(&src_ptr[bs], be - bs)
                if js_error() != 0:
                    js_had_error = 1
            # continue past </script>
            i = be
            i = _hx_tag_end_p(src_ptr, src_len, i)
            if i < src_len:
                i = i + 1
            continue
        i = i + 1
    # All page <script>s have run and the DOM is fully parsed: fire the document
    # lifecycle events in spec order — DOMContentLoaded, then load — so page code
    # that defers init to `document.addEventListener('DOMContentLoaded', …)` (the
    # dominant framework/analytics pattern) actually runs. No-ops when nothing
    # registered for the type (fast pre-scan in _fire_document).
    # Parsing is over, so the timer queue is allowed to run again — but only
    # AFTER the lifecycle events, which is the whole point of the flag.
    js_set_page_parsing(0)
    _doc_set_ready(cast[Ptr[uint8]]("interactive"), 11)
    _fire_document(cast[Ptr[uint8]]("DOMContentLoaded"), 16)
    _doc_set_ready(cast[Ptr[uint8]]("complete"), 8)
    _fire_document(cast[Ptr[uint8]]("load"), 4)
    # window.onload = fn (an IDL event-handler attribute on the window/global,
    # not an addEventListener registration) fires as part of the load event, once,
    # after the addEventListener('load') listeners. It is the single most common
    # page init hook, so honour it explicitly: read the global `onload` binding
    # (writing window.onload defines a global) and invoke it if callable.
    _fire_window_onload()
    # Firing DOMContentLoaded / load is a TASK, so anything those handlers
    # queued has to run -- they are not the end of the event loop, they are an
    # event in it. Without this the load handler could schedule work that never
    # happened: testharness.js sets its `all_loaded` flag inside
    # `on_event(window,'load', () => setTimeout(() => {...}, 0))`, that timer
    # never fired, and so EVERY WPT file reported harness status TIMEOUT even
    # when all of its subtests had completed and passed.
    js_drain_timers_if_enabled()
    _js_capture_console()
    _dom_readback()
    return 1


# Fire window.onload once, if the page assigned a callable to it. A fresh load
# event (type=load, target=document) is passed. Idempotent-safe: only runs when
# `onload` resolves to a callable global.
def _fire_window_onload() -> int32:
    ofn: int32 = js_global_get(cast[Ptr[uint8]]("onload"), 6)
    if js_is_callable(ofn) == 0:
        return 0
    ev: int32 = js_new_object_v()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(cast[Ptr[uint8]]("load"), 4))
    js_set_prop(ev, cast[Ptr[uint8]]("target"), 6, js_doc)
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), 13, js_doc)
    js_set_prop(ev, cast[Ptr[uint8]]("eventPhase"), 10, js_number(cast[float64](2)))
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("preventDefault"), 14, \
                js_new_native_fn(js_hbase + NID_PREVENT))
    js_global_set(cast[Ptr[uint8]]("event"), 5, ev)
    thisv: int32 = js_win
    if js_type_of(thisv) != 5:
        thisv = js_doc
    g_argv1[0] = ev
    js_call_fn(ofn, thisv, &g_argv1[0], 1)
    return 1


# ---- source rewrite (only when overrides exist) --------------------
def _rw_ch(c: uint8):
    if rw_len < RW_CAP:
        rw_buf[rw_len] = c
        rw_len = rw_len + 1


def _rw_range(a: uint64, b: uint64):
    i: uint64 = a
    while i < b:
        _rw_ch(src_ptr[i])
        i = i + 1


def _rw_cstr(s: Ptr[uint8]):
    i: int32 = 0
    while s[i] != 0:
        _rw_ch(s[i])
        i = i + 1


def _rw_ovbuf(off: int32, ln: int32):
    i: int32 = 0
    while i < ln:
        _rw_ch(dom_ovbuf[off + i])
        i = i + 1


# Emit `ln` raw bytes from a pointer (e.g. a created node's innerHTML markup).
def _rw_ovbuf_ptr(p: Ptr[uint8], ln: int32):
    i: int32 = 0
    while i < ln:
        _rw_ch(p[i])
        i = i + 1


# emit override bytes, escaping '<' and '&' so injected textContent renders as
# literal text (never re-parsed as markup).
def _rw_text_escaped(off: int32, ln: int32):
    i: int32 = 0
    while i < ln:
        c: uint8 = dom_ovbuf[off + i]
        if c == 60:
            _rw_cstr(cast[Ptr[uint8]]("&lt;"))
        elif c == 38:
            _rw_cstr(cast[Ptr[uint8]]("&amp;"))
        else:
            _rw_ch(c)
        i = i + 1


def _el_has_override(idx: int32) -> int32:
    if dom_detached[idx] != 0:
        return 1
    if dom_ov_hide[idx] != 0 or dom_ov_inner_len[idx] >= 0 or \
       dom_ov_col_len[idx] >= 0 or dom_ov_bg_len[idx] >= 0 or \
       dom_ov_wt_len[idx] >= 0 or dom_ov_al_len[idx] >= 0 or \
       dom_ov_wd_len[idx] >= 0 or \
       dom_ov_cls_len[idx] >= 0 or dom_ov_val_len[idx] >= 0 or \
       dom_ov_checked[idx] >= 0:
        return 1
    # a click handler alone makes the element a rewrite target when the native
    # front-end wants clickable event-links.
    if he_click_links != 0 and _el_has_handler(idx) != 0:
        return 1
    # a focusable/submit form control is wrapped so a pointer click reaches it.
    if _is_wrappable_field(idx) != 0:
        return 1
    a: int32 = 0
    while a < ap_n:
        if ap_removed[a] == 0 and ap_parent[a] == idx:
            return 1
        a = a + 1
    return 0


def _rw_dec(v: int32):
    if v == 0:
        _rw_ch(48)
        return
    d: Array[12, uint8]
    n: int32 = 0
    x: int32 = v
    while x > 0:
        d[n] = cast[uint8](x % 10) + 48
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        _rw_ch(d[n])


# Emit escaped text (rewriting '<' and '&') from a JS string value.
# Write a JS string to the rewrite buffer with NO markup escaping. Comment and
# processing-instruction data are serialised verbatim (chromium:
# document.createComment("a<b").parentElement.innerHTML is "<!--a<b-->").
def _rw_verbatim(v: int32):
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if _is_undef_str(p, n) != 0:
        return
    i: int32 = 0
    while i < n:
        _rw_ch(p[i])
        i = i + 1


def _rw_js_escaped(v: int32):
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if _is_undef_str(p, n) != 0:
        return
    i: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c == 60:
            _rw_cstr(cast[Ptr[uint8]]("&lt;"))
        elif c == 38:
            _rw_cstr(cast[Ptr[uint8]]("&amp;"))
        else:
            _rw_ch(c)
        i = i + 1


# Emit ` name="value"` for a created node's JS property (skips empty/undefined).
# The value is attribute-escaped ('"' -> &quot;, '&' -> &amp;).
def _emit_cre_attr(co: int32, prop: Ptr[uint8], plen: uint64, aname: Ptr[uint8]):
    v: int32 = js_get_prop(co, prop, plen)
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if n == 0 or _is_undef_str(p, n) != 0:
        return
    _rw_ch(32)
    _rw_cstr(aname)
    _rw_cstr(cast[Ptr[uint8]]("=\""))
    i: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c == 34:
            _rw_cstr(cast[Ptr[uint8]]("&quot;"))
        elif c == 38:
            _rw_cstr(cast[Ptr[uint8]]("&amp;"))
        else:
            _rw_ch(c)
        i = i + 1
    _rw_ch(34)


# Does this node's JS object carry a click listener of its own — an object-store
# addEventListener('click', …) registration or an `onclick` property?
def _obj_has_click(obj: int32) -> int32:
    ln: int32 = _obj_lp_name(cast[Ptr[uint8]]("click"), 5)
    arr: int32 = js_get_prop(obj, &g_lp_buf[0], cast[uint64](ln))
    if js_is_array(arr) != 0 and js_array_len(arr) > 0:
        return 1
    if js_is_callable(js_get_prop(obj, cast[Ptr[uint8]]("onclick"), 7)) != 0:
        return 1
    return 0


# Is created node `cid`'s tag name (case-insensitively) `s`?
def _cre_tag_is(cid: int32, s: Ptr[uint8]) -> int32:
    n: int32 = _cstr_len(s)
    if cre_tag_len[cid] != n:
        return 0
    i: int32 = 0
    while i < n:
        if _hx_lower(dom_idbuf[cre_tag_off[cid] + i]) != _hx_lower(s[i]):
            return 0
        i = i + 1
    return 1


# Is created node `cid` a form control? Such an element paints as ONE control
# box, so its "#__evt_N" link must wrap the tag from OUTSIDE (<a><button></a>) —
# an inner wrap lands inside a box the hit-test never splits, which is why a
# script-built <button> stayed unclickable while a script-built <div> worked.
def _cre_is_control(cid: int32) -> int32:
    if _cre_tag_is(cid, cast[Ptr[uint8]]("button")) != 0:
        return 1
    if _cre_tag_is(cid, cast[Ptr[uint8]]("input")) != 0:
        return 1
    if _cre_tag_is(cid, cast[Ptr[uint8]]("select")) != 0:
        return 1
    if _cre_tag_is(cid, cast[Ptr[uint8]]("textarea")) != 0:
        return 1
    return 0


# Is created node `cid` a pointer-click target — i.e. would a click on it reach
# ANY handler? True when it carries its own click listener, and also when an
# ancestor does (event delegation: the listener sits on a static container and
# the clicked node is the dynamic child). Walks the live parentNode chain, so it
# crosses from created nodes onto source-anchored ancestors and stops there.
def _cre_click_target(cid: int32) -> int32:
    obj: int32 = cre_obj[cid]
    depth: int32 = 0
    while depth < 64:
        el: int32 = _find_el_by_obj(obj)
        if el >= 0:
            if _el_has_handler(el) != 0:
                return 1
        elif _obj_has_click(obj) != 0:
            return 1
        pv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("parentNode"), 10)
        if js_type_of(pv) != 5:
            return 0
        obj = pv
        depth = depth + 1
    return 0


# Emit a script-created node's markup, RECURSIVELY: a text node emits only its
# escaped text; an element emits <tag id class style>inner</tag> where `inner`
# is innerHTML (raw) if set, else the escaped textContent followed by its nested
# created children (so a table > tr > td subtree built entirely in script
# renders with its full structure). Detached nodes (node.remove()) are skipped.
def _emit_created(cid: int32):
    if cre_gone[cid] != 0:
        return
    co: int32 = cre_obj[cid]
    if cre_is_text[cid] == 2:
        # <!--data-->, verbatim: comment data is NOT escaped.
        _rw_cstr(cast[Ptr[uint8]]("<!--"))
        _rw_verbatim(js_get_prop(co, cast[Ptr[uint8]]("data"), 4))
        _rw_cstr(cast[Ptr[uint8]]("-->"))
        return
    if cre_is_text[cid] == 3:
        _rw_cstr(cast[Ptr[uint8]]("<?"))
        _rw_verbatim(js_get_prop(co, cast[Ptr[uint8]]("target"), 6))
        _rw_ch(32)
        _rw_verbatim(js_get_prop(co, cast[Ptr[uint8]]("data"), 4))
        _rw_cstr(cast[Ptr[uint8]]("?>"))
        return
    if cre_is_text[cid] != 0:
        _rw_js_escaped(js_get_prop(co, cast[Ptr[uint8]]("textContent"), 11))
        return
    # native-only: a created node that a click would reach (its own listener, or
    # a delegating ancestor's) gets the same synthetic "#__evt_N" link wrap the
    # source elements get, addressed in the CRE_IDX_BASE half of the event-target
    # index space — so the pointer hit-test resolves a JS-built button exactly
    # like a parsed one. A form control is wrapped OUTSIDE its tag (its whole
    # box then carries the link); anything else wraps its inner content.
    wrap_evt: int32 = 0
    wrap_outer: int32 = 0
    if he_click_links != 0 and _cre_click_target(cid) != 0:
        wrap_evt = 1
        if _cre_is_control(cid) != 0:
            wrap_outer = 1
            _rw_cstr(cast[Ptr[uint8]]("<a href=\"#__evt_"))
            _rw_dec(CRE_IDX_BASE + cid)
            _rw_cstr(cast[Ptr[uint8]]("\">"))
    _rw_ch(60)                                            # '<'
    t: int32 = 0
    while t < cre_tag_len[cid]:
        _rw_ch(dom_idbuf[cre_tag_off[cid] + t])
        t = t + 1
    _emit_cre_attr(co, cast[Ptr[uint8]]("id"), 2, cast[Ptr[uint8]]("id"))
    _emit_cre_attr(co, cast[Ptr[uint8]]("className"), 9, cast[Ptr[uint8]]("class"))
    _rw_ch(62)                                            # '>'
    if wrap_evt != 0 and wrap_outer == 0:
        _rw_cstr(cast[Ptr[uint8]]("<a href=\"#__evt_"))
        _rw_dec(CRE_IDX_BASE + cid)
        _rw_cstr(cast[Ptr[uint8]]("\">"))
    # Inline `.style.*` overrides are carried on an INNER <span> — some elements
    # (e.g. <li>, table cells) don't parse an inline style="" on their own tag,
    # whereas an inline <span> reliably honours color/bg/weight/align. className
    # (a real class) is emitted as a tag attribute above so the CSS cascade sees
    # it. The span wraps both the textContent and any nested created children.
    stv: int32 = js_get_prop(co, cast[Ptr[uint8]]("style"), 5)
    dom_ov_len_save: int32 = dom_ov_len
    cl: int32 = _readback_str(stv, cast[Ptr[uint8]]("color"), 5)
    col_off: int32 = g_rb_off
    bg: int32 = _readback_str(stv, cast[Ptr[uint8]]("backgroundColor"), 15)
    bg_off: int32 = g_rb_off
    wt: int32 = _readback_str(stv, cast[Ptr[uint8]]("fontWeight"), 10)
    wt_off: int32 = g_rb_off
    al: int32 = _readback_str(stv, cast[Ptr[uint8]]("textAlign"), 9)
    al_off: int32 = g_rb_off
    has_style: int32 = 0
    if cl >= 0 or bg >= 0 or wt >= 0 or al >= 0:
        has_style = 1
        _rw_cstr(cast[Ptr[uint8]]("<span style=\""))
        if cl >= 0:
            _rw_cstr(cast[Ptr[uint8]]("color:"))
            _rw_ovbuf(col_off, cl)
            _rw_ch(59)
        if bg >= 0:
            _rw_cstr(cast[Ptr[uint8]]("background-color:"))
            _rw_ovbuf(bg_off, bg)
            _rw_ch(59)
        if wt >= 0:
            _rw_cstr(cast[Ptr[uint8]]("font-weight:"))
            _rw_ovbuf(wt_off, wt)
            _rw_ch(59)
        if al >= 0:
            _rw_cstr(cast[Ptr[uint8]]("text-align:"))
            _rw_ovbuf(al_off, al)
            _rw_ch(59)
        _rw_cstr(cast[Ptr[uint8]]("\">"))
    dom_ov_len = dom_ov_len_save                          # scratch reclaim
    # inner: innerHTML (raw) wins; else textContent (escaped) + nested children.
    # OWN property only. innerHTML is an ACCESSOR on HTMLElement.prototype that
    # now serialises created subtrees (see _serialize_inner_cre), so a plain
    # js_get_prop here would call back into this function and never return.
    # An own innerHTML exists exactly when the page ASSIGNED one, which is the
    # case this branch wants.
    hv: int32 = js_undefined()
    if js_has_own(co, cast[Ptr[uint8]]("innerHTML"), 9) != 0:
        hv = js_get_prop(co, cast[Ptr[uint8]]("innerHTML"), 9)
    hp: Ptr[uint8] = js_str_ptr(hv)
    hn: int32 = _cstr_len(hp)
    if hn > 0 and _is_undef_str(hp, hn) == 0:
        _rw_ovbuf_ptr(hp, hn)
    else:
        _rw_js_escaped(js_get_prop(co, cast[Ptr[uint8]]("textContent"), 11))
        a: int32 = 0
        while a < cc_n:
            if cc_removed[a] == 0 and cc_owner[a] == cid:
                _emit_created(cc_child[a])
            a = a + 1
    if has_style != 0:
        _rw_cstr(cast[Ptr[uint8]]("</span>"))
    if wrap_evt != 0 and wrap_outer == 0:
        _rw_cstr(cast[Ptr[uint8]]("</a>"))
    _rw_cstr(cast[Ptr[uint8]]("</"))
    t2: int32 = 0
    while t2 < cre_tag_len[cid]:
        _rw_ch(dom_idbuf[cre_tag_off[cid] + t2])
        t2 = t2 + 1
    _rw_ch(62)
    if wrap_outer != 0:
        _rw_cstr(cast[Ptr[uint8]]("</a>"))


# Emit the merged inline style="" for an element's style overrides (or nothing).
# `display:none` is a RENDER decision (the element is dropped outright, so the
# render never needs the declaration) but it IS part of the markup a browser
# serialises, so it joins the merged style in serialisation mode only — which
# keeps every rendered byte unchanged.
def _emit_merged_style(idx: int32):
    ser_disp: int32 = 0
    if g_ser_mode != 0 and dom_ov_hide[idx] != 0:
        ser_disp = 1
    if dom_ov_col_len[idx] < 0 and dom_ov_bg_len[idx] < 0 and \
       dom_ov_wt_len[idx] < 0 and dom_ov_al_len[idx] < 0 and \
       dom_ov_wd_len[idx] < 0 and ser_disp == 0:
        return
    _rw_cstr(cast[Ptr[uint8]](" style=\""))
    if ser_disp != 0:
        _rw_cstr(cast[Ptr[uint8]]("display:none;"))
    if dom_ov_col_len[idx] >= 0:
        _rw_cstr(cast[Ptr[uint8]]("color:"))
        _rw_ovbuf(dom_ov_col_off[idx], dom_ov_col_len[idx])
        _rw_ch(59)
    if dom_ov_bg_len[idx] >= 0:
        _rw_cstr(cast[Ptr[uint8]]("background-color:"))
        _rw_ovbuf(dom_ov_bg_off[idx], dom_ov_bg_len[idx])
        _rw_ch(59)
    if dom_ov_wt_len[idx] >= 0:
        _rw_cstr(cast[Ptr[uint8]]("font-weight:"))
        _rw_ovbuf(dom_ov_wt_off[idx], dom_ov_wt_len[idx])
        _rw_ch(59)
    if dom_ov_al_len[idx] >= 0:
        _rw_cstr(cast[Ptr[uint8]]("text-align:"))
        _rw_ovbuf(dom_ov_al_off[idx], dom_ov_al_len[idx])
        _rw_ch(59)
    if dom_ov_wd_len[idx] >= 0:
        _rw_cstr(cast[Ptr[uint8]]("width:"))
        _rw_ovbuf(dom_ov_wd_off[idx], dom_ov_wd_len[idx])
        _rw_ch(59)
    _rw_ch(34)


# Copy tag-body attributes [a,b) into rw_buf, dropping any attribute named
# `s1` or `s2` (case-insensitive; both valued `name="v"` and bare `name` forms).
def _rw_copy_attrs_except(a: uint64, b: uint64, s1: Ptr[uint8], s2: Ptr[uint8]):
    l1: int32 = _cstr_len(s1)
    l2: int32 = _cstr_len(s2)
    i: uint64 = a
    while i < b:
        c: uint8 = src_ptr[i]
        if c == 32 or c == 9 or c == 10 or c == 13:
            _rw_ch(c)
            i = i + 1
            continue
        ns: uint64 = i
        while i < b and _is_name_ch(src_ptr[i]) != 0:
            i = i + 1
        ne2: uint64 = i
        # look ahead past spaces for '=' to find a valued attribute
        k: uint64 = i
        while k < b and (src_ptr[k] == 32 or src_ptr[k] == 9):
            k = k + 1
        attr_end: uint64 = ne2
        if k < b and src_ptr[k] == 61:                    # '='
            k = k + 1
            while k < b and (src_ptr[k] == 32 or src_ptr[k] == 9):
                k = k + 1
            if k < b and (src_ptr[k] == 34 or src_ptr[k] == 39):
                q: uint8 = src_ptr[k]
                k = k + 1
                while k < b and src_ptr[k] != q:
                    k = k + 1
                if k < b:
                    k = k + 1
            else:
                while k < b and src_ptr[k] != 32 and src_ptr[k] != 9:
                    k = k + 1
            attr_end = k
        skip: int32 = 0
        if _idbytes_eq(ns, ne2, s1, l1) != 0 or _idbytes_eq(ns, ne2, s2, l2) != 0:
            skip = 1
        if skip == 0:
            _rw_range(ns, attr_end)
        i = attr_end


# Does dom_ovbuf[off..off+len) equal src span [a,b) (byte-exact)?
def _ovbuf_eq_src(off: int32, ln: int32, a: uint64, b: uint64) -> int32:
    if cast[int32](b - a) != ln:
        return 0
    i: int32 = 0
    while i < ln:
        if dom_ovbuf[off + i] != src_ptr[a + cast[uint64](i)]:
            return 0
        i = i + 1
    return 1


# Re-emit a <select>'s option list [cs,ce), moving `selected` onto the option
# whose visible text equals the override value dom_ovbuf[voff..voff+vlen).
def _rw_select_options(cs: uint64, ce: uint64, voff: int32, vlen: int32):
    i: uint64 = cs
    while i < ce:
        if src_ptr[i] == 60 and _tagname_is(i + 1, cast[Ptr[uint8]]("option")) != 0:
            je: uint64 = i + 1
            je = _hx_tag_end_p(src_ptr, ce, je)
            ne: uint64 = i + 1
            while ne < je and _alnum_at(ne) != 0:
                ne = ne + 1
            ots: uint64 = je + 1
            ote: uint64 = ots
            while ote < ce and src_ptr[ote] != 60:
                ote = ote + 1
            _rw_ch(60)
            _rw_range(i + 1, ne)                          # 'option'
            _rw_copy_attrs_except(ne, je, cast[Ptr[uint8]]("selected"), \
                                  cast[Ptr[uint8]]("selected"))
            if _ovbuf_eq_src(voff, vlen, ots, ote) != 0:
                _rw_cstr(cast[Ptr[uint8]](" selected"))
            _rw_ch(62)
            i = je + 1
            continue
        _rw_ch(src_ptr[i])
        i = i + 1


# Build rw_buf: a copy of the source with each overridden element's mutations
# baked in. Overridden elements are matched by their source anchor offset, so
# id-less querySelector matches work too. Elements without overrides copy
# through byte-for-byte, so the rest of the page's layout is unchanged.
def _build_rewrite():
    rw_len = 0
    _rewrite_range(0, src_len)


# Emit the source range [lo,hi) into rw_buf, baking in each overridden element's
# mutations. Recursive: an element whose inner content is NOT wholly replaced
# (only class/style/attr/appended-child overrides) re-processes its own inner
# range so descendant overrides still apply — e.g. document.body.appendChild()
# alongside a mutation on a node INSIDE body (the flat copy dropped the latter).
def _rewrite_range(lo: uint64, hi: uint64):
    i: uint64 = lo
    while i < hi:
        c: uint8 = src_ptr[i]
        if c == 60 and i + 1 < src_len and src_ptr[i + 1] != 47 and \
           src_ptr[i + 1] != 33 and src_ptr[i + 1] != 63:
            idx: int32 = _dom_lookup_anchor(cast[int32](i))
            if idx >= 0 and _el_has_override(idx) != 0:
                # A focusable/submit form control is wrapped OUTSIDE its tag
                # (<a ..><input></a>) so the input's own box word inherits the
                # link and the pointer hit-test resolves to it. Click-handler
                # elements keep the INNER wrap (their clickable content is the
                # element's text), so the two are mutually exclusive.
                wrap_outer: int32 = 0
                if g_ser_mode == 0 and _is_wrappable_field(idx) != 0:
                    wrap_outer = 1
                    _rw_cstr(cast[Ptr[uint8]]("<a href=\"#__evt_"))
                    _rw_dec(idx)
                    _rw_cstr(cast[Ptr[uint8]]("\">"))
                ts: uint64 = i + 1
                je: uint64 = ts
                je = _hx_tag_end_p(src_ptr, src_len, je)
                ne: uint64 = ts
                while ne < je and _alnum_at(ne) != 0:
                    ne = ne + 1
                clt: uint64 = cast[uint64](dom_cend[idx])
                # locate the close tag end
                _find_close(ts, ne - ts, je + 1)
                cend: uint64 = g_close_end
                # Render mode drops anything hidden; SERIALISATION mode drops
                # only what was really removed from the tree (a display:none
                # element is still in a browser's innerHTML).
                if dom_detached[idx] != 0 or \
                   (g_ser_mode == 0 and dom_ov_hide[idx] != 0):
                    i = cend
                    continue
                # rebuild the start tag: <name [class] [style] original-attrs>
                _rw_ch(60)
                _rw_range(ts, ne)
                if dom_ov_cls_len[idx] >= 0:
                    _rw_cstr(cast[Ptr[uint8]](" class=\""))
                    _rw_ovbuf(dom_ov_cls_off[idx], dom_ov_cls_len[idx])
                    _rw_ch(34)
                _emit_merged_style(idx)
                if dom_kind[idx] == 1 and \
                   (dom_ov_val_len[idx] >= 0 or dom_ov_checked[idx] >= 0):
                    # input: re-emit attrs without value/checked, then the new
                    # value/checked so the control renders its updated state.
                    _rw_copy_attrs_except(ne, je, cast[Ptr[uint8]]("value"), \
                                          cast[Ptr[uint8]]("checked"))
                    if dom_ov_val_len[idx] >= 0:
                        _rw_cstr(cast[Ptr[uint8]](" value=\""))
                        _rw_ovbuf(dom_ov_val_off[idx], dom_ov_val_len[idx])
                        _rw_ch(34)
                    if dom_ov_checked[idx] == 1:
                        _rw_cstr(cast[Ptr[uint8]](" checked"))
                else:
                    _rw_range(ne, je)                     # original attributes
                _rw_ch(62)
                # native-only: wrap a click-handler element's content in a
                # synthetic "#__evt_IDX" link so the existing pointer link
                # hit-test can route the click to he_dom_click_index.
                wrap_evt: int32 = 0
                if g_ser_mode == 0 and wrap_outer == 0 and he_click_links != 0 and \
                   _el_has_handler(idx) != 0:
                    wrap_evt = 1
                    _rw_cstr(cast[Ptr[uint8]]("<a href=\"#__evt_"))
                    _rw_dec(idx)
                    _rw_cstr(cast[Ptr[uint8]]("\">"))
                # inner content
                if dom_kind[idx] == 2 and dom_ov_val_len[idx] >= 0:
                    # textarea value change = new (escaped) inner text.
                    _rw_text_escaped(dom_ov_val_off[idx], dom_ov_val_len[idx])
                elif dom_kind[idx] == 3 and dom_ov_val_len[idx] >= 0:
                    # select value change = re-mark the selected <option>.
                    _rw_select_options(je + 1, clt, dom_ov_val_off[idx], \
                                       dom_ov_val_len[idx])
                elif dom_ov_inner_len[idx] >= 0:
                    if dom_ov_inner_html[idx] != 0:
                        _rw_ovbuf(dom_ov_inner_off[idx], dom_ov_inner_len[idx])
                    else:
                        _rw_text_escaped(dom_ov_inner_off[idx], \
                                         dom_ov_inner_len[idx])
                else:
                    # No inner-content override: re-process the original inner
                    # range so descendant overrides (a mutation on a node nested
                    # under this appended-to / restyled element) still bake in.
                    _rewrite_range(je + 1, clt)
                # appended created children, in insertion order
                a: int32 = 0
                while a < ap_n:
                    if ap_removed[a] == 0 and ap_parent[a] == idx:
                        _emit_created(ap_child[a])
                    a = a + 1
                if wrap_evt != 0:
                    _rw_cstr(cast[Ptr[uint8]]("</a>"))
                _rw_range(clt, cend)                      # original close tag
                if wrap_outer != 0:
                    _rw_cstr(cast[Ptr[uint8]]("</a>"))
                i = cend
                continue
        _rw_ch(c)
        i = i + 1


# LIVE innerHTML SERIALISATION for a source-anchored element.
#
# The DOM is anchored to byte spans in the original source, so for a long time
# `el.innerHTML` was literally src[cstart..cend) — correct at parse time and
# frozen forever after. Measured against chromium --headless on a clean
# fixture, EVERY script mutation was invisible: appendChild, a descendant's
# textContent= and removeChild all read back the untouched markup.
#
# Rather than give every node a heap representation (a rewrite of the whole
# engine), this reuses the emitter that ALREADY has to reproduce a mutated
# subtree — _rewrite_range, which bakes the override tables + appended created
# children into the markup it emits for the render. Running it over just this
# element's content span, in serialisation mode, IS the re-serialisation:
#
#   * a subtree script never touched has no overrides, so _rewrite_range copies
#     it through byte-for-byte and the answer is identical to the old slice;
#   * a mutated descendant is emitted with its mutation baked in;
#   * a detached child is elided;
#   * created children appended to THIS element are emitted after the span
#     (the enclosing-element branch of _rewrite_range would normally do this,
#     but we start INSIDE this element, so it is done here).
#
# _dom_readback() is what fills the override tables, and it normally runs only
# after all scripts finish; a getter called mid-script has to run it itself.
def _serialize_inner_of(idx: int32) -> int32:
    _dom_readback()
    save_links: int32 = he_click_links
    save_rw: uint64 = rw_len
    he_click_links = 0
    g_ser_mode = 1
    rw_len = 0
    _rewrite_range(cast[uint64](dom_cstart[idx]), cast[uint64](dom_cend[idx]))
    a: int32 = 0
    while a < ap_n:
        if ap_removed[a] == 0 and ap_parent[a] == idx:
            _emit_created(ap_child[a])
        a = a + 1
    v: int32 = js_new_string(&rw_buf[0], rw_len)
    rw_len = save_rw
    g_ser_mode = 0
    he_click_links = save_links
    return v


# innerHTML of a CREATED element (createElement / cloneNode / innerHTML
# fragment) — the ones with no source span. Until this existed, `innerHTML` on
# anything a script built read back `undefined`, which is not a small gap: the
# whole ChildNode-before/after/replaceWith and ParentNode-prepend/
# replaceChildren family asserts on `parent.innerHTML` after building `parent`
# with document.createElement, so 176 subtests could never pass no matter how
# correct the mutation methods were.
#
# Reuses _emit_created in g_ser_mode (the DOM-serialisation mode that drops the
# renderer's synthetic event-link wraps), exactly as _serialize_inner_of does
# for source elements.
def _serialize_inner_cre(cid: int32) -> int32:
    save_links: int32 = he_click_links
    save_rw: uint64 = rw_len
    he_click_links = 0
    g_ser_mode = 1
    rw_len = 0
    a: int32 = 0
    while a < cc_n:
        if cc_removed[a] == 0 and cc_owner[a] == cid:
            _emit_created(cc_child[a])
        a = a + 1
    v: int32 = js_new_string(&rw_buf[0], rw_len)
    rw_len = save_rw
    g_ser_mode = 0
    he_click_links = save_links
    return v


# ---- front-end accessors (console / title / error) ------------------
def he_js_console_ptr() -> Ptr[uint8]:
    js_con_buf[js_con_len] = 0
    return &js_con_buf[0]


def he_js_console_len() -> uint64:
    return cast[uint64](js_con_len)


def he_js_error() -> int32:
    return js_had_error


def he_dom_title_ptr() -> Ptr[uint8]:
    return &dom_title_buf[0]


def he_dom_title_len() -> uint64:
    return cast[uint64](dom_title_len)


def he_dom_title_present() -> int32:
    return dom_title_present


# Lay out either the original source or, when the DOM carries overrides, a
# rewritten copy with them baked in. Shared by he_layout and post-event
# re-layout (he_dom_click).
def _relayout():
    if dom_n_overrides > 0 or _n_wrappable() > 0:
        _build_rewrite()
        save_ptr: Ptr[uint8] = src_ptr
        save_len: uint64 = src_len
        src_ptr = &rw_buf[0]
        src_len = rw_len
        _layout()
        src_ptr = save_ptr
        src_len = save_len
    else:
        _layout()


# he_layout — public entry point (non-underscore so front-ends can call it
# without an underscore import). Runs the page's <script>s (if any) through
# the JS engine + minimal DOM, then lays out src_ptr/src_len into segments —
# re-laying-out a rewritten source when a script mutated the DOM. The JS
# context persists after this returns (until the next he_layout / js_init) so
# event handlers registered here stay live for he_dom_click().
def he_layout():
    _strip_comments()
    _dom_reset()
    _run_scripts()
    _relayout()


# he_set_scroll_rows — set the STATIC scroll offset (whole rows) the positioned
# resolver assumes for `position:sticky`/`position:fixed`. Call BEFORE he_layout
# to ask "with the page scrolled down N rows, where do sticky/fixed boxes pin?".
# Default 0 leaves every page byte-identical; the resolver only consults it for
# sticky/fixed runs. NOT cleared by he_layout, so the caller fully owns it.
def he_set_scroll_rows(n: int32):
    if n < 0:
        n = 0
    pos_scroll_y = n


# Dispatch a click to the DOM record at `idx`: invoke its stored handler (an
# el.onclick / addEventListener('click', fn) function value, or an inline
# onclick="" source string) in the LIVE JS context, then read the DOM back and
# re-lay-out so the handler's mutations render. Returns 1 if a handler ran.
g_argv1: Array[1, int32]

# ---- History API + Location state (browser round: web storage / history) ----
# The session-history stack, mirrored to the JS `history` object. Each entry
# carries a serialized `state` (the JS value handle passed to push/replaceState)
# and the entry's URL bytes (kept in an append-only ring so back()/forward() can
# restore location.href). pushState advances the index and truncates the forward
# tail (classic browser semantics); replaceState overwrites the current entry
# without growing. `history.state`/`history.length` are re-synced after every op.
JSHIST_MAX:        int32 = 128
jshist_state:      Array[128, int32]   # per-entry serialized state (JS value handle)
jshist_url_off:    Array[128, int32]   # entry URL: offset into jshist_urlbuf (-1 = none)
jshist_url_len:    Array[128, int32]
JSHIST_URLBUF_CAP: int32 = 8192
jshist_urlbuf:     Array[8192, uint8]
jshist_urlbuf_w:   int32 = 0
jshist_len:        int32 = 1           # >=1: the current document is entry 0
jshist_idx:        int32 = 0
g_js_history:    int32 = -1          # the JS `history` object handle
g_js_location:   int32 = -1          # the JS `location` object handle (from setup.ad)
url_scratch:     Array[2048, uint8]  # URL-component build scratch
url_scratch2:    Array[2048, uint8]  # incoming URL bytes
origin_scratch:  Array[600, uint8]   # protocol+"//"+host build scratch (origin/href)


# Compile an inline handler source string (the JS between the on<evt>="" quotes)
# into a callable function value, so it can be invoked with `this` bound to the
# element — real pages routinely use `this.value` / `this.checked` / `this.id`
# inside inline handlers. The body is wrapped as  function(event){ <src> }  so
# it also sees the event argument. Returns the function value, or -1 on a
# compile error (caller falls back to a bare global-scope eval).
HB_HWRAP_CAP: int32 = 8192
hb_hwrap: Array[8192, uint8]


def _compile_inline_handler(src: int32, srclen: int32) -> int32:
    pfx: Ptr[uint8] = cast[Ptr[uint8]]("var __hb_ev_fn__=function(event){\n")
    w: int32 = 0
    i: int32 = 0
    while pfx[i] != 0 and w < HB_HWRAP_CAP - 4:
        hb_hwrap[w] = pfx[i]
        w = w + 1
        i = i + 1
    j: int32 = 0
    while j < srclen and w < HB_HWRAP_CAP - 4:
        hb_hwrap[w] = dom_txtbuf[src + j]
        w = w + 1
        j = j + 1
    hb_hwrap[w] = 10                                          # '\n' (end any // comment)
    w = w + 1
    hb_hwrap[w] = 125                                         # '}'
    w = w + 1
    hb_hwrap[w] = 59                                          # ';'
    w = w + 1
    # NESTED: this only DEFINES the wrapper function; the handler itself is
    # called by the caller. Draining the timer queue here would run the event
    # loop in the middle of event dispatch — a handler's setTimeout(f,0) must
    # run after the handler returns, which _after_event_settle already ensures.
    js_eval_nested(&hb_hwrap[0], cast[uint64](w))
    if js_error() != 0:
        js_had_error = 1
        return -1
    return js_global_get(cast[Ptr[uint8]]("__hb_ev_fn__"), 12)


# Cache a just-compiled inline-handler function value into element `idx`'s slot
# for event `kind`, so subsequent events reuse it (no recompile).
def _store_handler_fn(idx: int32, kind: int32, fnval: int32):
    if kind == 0:
        dom_onclick_fn[idx] = fnval
    elif kind == 1:
        dom_oninput_fn[idx] = fnval
    elif kind == 2:
        dom_onchange_fn[idx] = fnval
    elif kind == 3:
        dom_onsubmit_fn[idx] = fnval


# Fire element `idx`'s handlers for event `kind` (0 click, 1 input, 2 change,
# 3 submit) in the live JS context, passing `evtobj` as the sole argument
# (-1 = call with no args). Fires, in order: every addEventListener registration
# for (idx,kind) in registration order, THEN the attribute handler (el.on<evt> /
# inline on<evt>="" — a stored function value wins over an inline source string).
# Returns 1 if at least one handler ran.
# Map an event-type string to one of the 4 attribute-backed kinds, or -1 for
# any other ("generic") type that lives in the string-typed listener table.
def _evt_std_kind(p: Ptr[uint8], n: int32) -> int32:
    if _bytes_eq(p, n, cast[Ptr[uint8]]("click"), 5) != 0:
        return 0
    if _bytes_eq(p, n, cast[Ptr[uint8]]("input"), 5) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("change"), 6) != 0:
        return 2
    if _bytes_eq(p, n, cast[Ptr[uint8]]("submit"), 6) != 0:
        return 3
    return -1


# Is p[0..n) an event type a POINTER PRESS delivers? Measured against chromium
# (CDP Input.dispatchMouseEvent mousePressed+mouseReleased on a <div> listening
# for every candidate type) — one left click delivers, in this order:
#     pointerover pointerenter mouseover mouseenter
#     pointerdown mousedown pointerup mouseup click
# so an element whose ONLY listener is any of those is something a user reaches
# by putting the pointer on it and pressing. dblclick/auxclick/contextmenu ride
# the same press machinery (a second/other-button press) and mousemove/
# pointermove/mouseout/mouseleave/pointerout/pointerleave the same hover, so all
# of them make the element pointer-live too; touchstart/touchend are the touch
# spelling real mobile-first pages use for the same gesture.
#
# This is the EVENT-TYPE half of the hit-test reachability gap: _el_has_handler
# used to match evl_kind == 0 (click) alone, so `el.addEventListener('mousedown',
# …)` — a menu button, a drag handle, a custom slider — had NO handler as far as
# the coordinate hit-test was concerned, was never wrapped in a synthetic
# "#__evt_N" link, and a pointer press on its pixels resolved to nothing.
def _is_pointer_type(p: Ptr[uint8], n: int32) -> int32:
    if n < 5 or n > 12:
        return 0
    if _bytes_eq(p, n, cast[Ptr[uint8]]("click"), 5) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("dblclick"), 8) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("auxclick"), 8) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("contextmenu"), 11) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mousedown"), 9) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mouseup"), 7) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mousemove"), 9) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mouseover"), 9) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mouseout"), 8) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mouseenter"), 10) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("mouseleave"), 10) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerdown"), 11) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerup"), 9) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointermove"), 11) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerover"), 11) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerout"), 10) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerenter"), 12) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("pointerleave"), 12) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("touchstart"), 10) != 0:
        return 1
    if _bytes_eq(p, n, cast[Ptr[uint8]]("touchend"), 8) != 0:
        return 1
    return 0


# Intern a generic event-type string into evt_tybuf; returns its offset, or -1
# if the buffer is full. Interning is de-duplicated so removeEventListener can
# compare by offset OR by bytes (we compare by bytes to stay robust).
def _evt_intern(p: Ptr[uint8], n: int32) -> int32:
    if evt_tybuf_len + n >= EVT_TYBUF_CAP:
        return -1
    off: int32 = evt_tybuf_len
    i: int32 = 0
    while i < n:
        evt_tybuf[off + i] = p[i]
        i = i + 1
    evt_tybuf_len = off + n
    return off


# Does GEN_KIND listener `li`'s stored type string equal p[0..n)?
def _evl_type_eq(li: int32, p: Ptr[uint8], n: int32) -> int32:
    if evl_type_len[li] != n:
        return 0
    return _bytes_eq(&evt_tybuf[evl_type_off[li]], n, p, n)


# Does listener `li` fire in propagation phase `phase`? A capture:true listener
# fires in the CAPTURE and TARGET phases; a capture:false listener fires in the
# TARGET and BUBBLE phases. At the target every listener fires (registration
# order), matching the DOM "at target" rule.
def _phase_wants(li: int32, phase: int32) -> int32:
    if phase == EPHASE_TARGET:
        return 1
    if phase == EPHASE_CAPTURE:
        if evl_capture[li] != 0:
            return 1
        return 0
    if evl_capture[li] == 0:                               # EPHASE_BUBBLE
        return 1
    return 0


# Fire every live string-typed (GEN_KIND) listener on element `idx` whose type
# equals typp[0..typn) AND whose capture flag matches propagation `phase`, in
# registration order. Returns 1 if any ran. Generic types have no
# attribute-handler slot (there is no dom_onkeydown_*), so only addEventListener
# registrations fire — which is exactly the DOM behaviour.
def _fire_generic(idx: int32, typp: Ptr[uint8], typn: int32, \
                  evtobj: int32, phase: int32) -> int32:
    ran: int32 = 0
    if evtobj >= 0:
        js_global_set(cast[Ptr[uint8]]("event"), 5, evtobj)
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_el[li] == idx and \
           evl_kind[li] == GEN_KIND and _evl_type_eq(li, typp, typn) != 0 and \
           _phase_wants(li, phase) != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_cur_passive = evl_passive[li]
                if evtobj >= 0:
                    g_argv1[0] = evtobj
                    js_call_fn(lfn, dom_obj[idx], &g_argv1[0], 1)
                else:
                    js_call_fn(lfn, dom_obj[idx], cast[Ptr[int32]](0), 0)
                g_cur_passive = 0
                ran = 1
                if evl_once[li] != 0:
                    evl_dead[li] = 1
                if g_stop_immediate != 0:
                    return ran
        li = li + 1
    return ran


# Fire every live document-level (evl_el == DOC_EL) string-typed listener whose
# type equals typp[0..typn), in registration order. Used for DOMContentLoaded /
# load after the page scripts run, and for any document.dispatchEvent(type). A
# fresh event object (type + document target + no-op preventDefault/
# stopPropagation) is passed so handlers reading event.type / event.target work.
# Returns 1 if any listener ran.
def _fire_document(typp: Ptr[uint8], typn: int32) -> int32:
    # Fast out: no document listener registered at all.
    any: int32 = 0
    li0: int32 = 0
    while li0 < evl_n:
        if evl_dead[li0] == 0 and evl_el[li0] == DOC_EL and \
           evl_kind[li0] == GEN_KIND and _evl_type_eq(li0, typp, typn) != 0:
            any = 1
        li0 = li0 + 1
    if any == 0:
        return 0
    ev: int32 = js_new_object_v()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, js_new_string(typp, cast[uint64](typn)))
    js_set_prop(ev, cast[Ptr[uint8]]("target"), 6, js_doc)
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), 13, js_doc)
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("cancelable"), 10, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("preventDefault"), 14, \
                js_new_native_fn(js_hbase + NID_PREVENT))
    js_set_prop(ev, cast[Ptr[uint8]]("stopPropagation"), 15, \
                js_new_native_fn(js_hbase + NID_STOPPROP))
    js_global_set(cast[Ptr[uint8]]("event"), 5, ev)
    ran: int32 = 0
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_el[li] == DOC_EL and \
           evl_kind[li] == GEN_KIND and _evl_type_eq(li, typp, typn) != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_argv1[0] = ev
                js_call_fn(lfn, js_doc, &g_argv1[0], 1)
                ran = 1
                if evl_once[li] != 0:
                    evl_dead[li] = 1
        li = li + 1
    return ran


# document.dispatchEvent(ev) / window.dispatchEvent(ev): fire every live
# DOC_EL listener whose type matches ev.type, in registration order, passing
# the CALLER's event object (so ev.detail / custom fields survive, unlike
# _fire_document which synthesises its own). Both the four standard kinds
# (click/input/change/submit, stored by kind) and GEN_KIND string listeners
# (keydown, custom types) are matched — a document click listener must fire for
# document.dispatchEvent(new Event('click')). Enriches the event with
# target/currentTarget = document and the no-op control methods, resets the
# g_prevent_default / g_stop_immediate flags first, and honours
# stopImmediatePropagation. Returns !defaultPrevented for the dispatchEvent
# return value.
def _fire_document_ev(evo: int32, typp: Ptr[uint8], typn: int32) -> int32:
    g_prevent_default = 0
    g_stop_prop = 0
    g_stop_immediate = 0
    ek: int32 = _evt_std_kind(typp, typn)
    if evo >= 0:
        js_set_prop(evo, cast[Ptr[uint8]]("target"), 6, js_doc)
        js_set_prop(evo, cast[Ptr[uint8]]("currentTarget"), 13, js_doc)
        js_set_prop(evo, cast[Ptr[uint8]]("preventDefault"), 14, \
                    js_new_native_fn(js_hbase + NID_PREVENT))
        js_set_prop(evo, cast[Ptr[uint8]]("stopPropagation"), 15, \
                    js_new_native_fn(js_hbase + NID_STOPPROP))
        js_set_prop(evo, cast[Ptr[uint8]]("stopImmediatePropagation"), 24, \
                    js_new_native_fn(js_hbase + NID_STOPIMMED))
        js_set_prop(evo, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
        js_global_set(cast[Ptr[uint8]]("event"), 5, evo)
    li: int32 = 0
    while li < evl_n:
        hit: int32 = 0
        if evl_dead[li] == 0 and evl_el[li] == DOC_EL:
            if ek >= 0 and evl_kind[li] == ek:
                hit = 1
            if evl_kind[li] == GEN_KIND and _evl_type_eq(li, typp, typn) != 0:
                hit = 1
        if hit != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_cur_passive = evl_passive[li]
                if evo >= 0:
                    g_argv1[0] = evo
                    js_call_fn(lfn, js_doc, &g_argv1[0], 1)
                else:
                    js_call_fn(lfn, js_doc, cast[Ptr[int32]](0), 0)
                g_cur_passive = 0
                if evl_once[li] != 0:
                    evl_dead[li] = 1
                if g_stop_immediate != 0:
                    li = evl_n
        li = li + 1
    if evo >= 0:
        js_set_prop(evo, cast[Ptr[uint8]]("@sp"), 3, js_bool(0))
    if g_prevent_default != 0:
        return 0
    return 1


def _fire_handler(idx: int32, kind: int32, evtobj: int32, phase: int32) -> int32:
    ran: int32 = 0
    # An inline on<evt>="" handler (and legacy code) references a global `event`;
    # bind it once so every handler in this fire sees it.
    if evtobj >= 0:
        js_global_set(cast[Ptr[uint8]]("event"), 5, evtobj)
    # (1) addEventListener registrations, in registration order, whose capture
    # flag matches this propagation phase.
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_el[li] == idx and evl_kind[li] == kind and \
           _phase_wants(li, phase) != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_cur_passive = evl_passive[li]
                if evtobj >= 0:
                    g_argv1[0] = evtobj
                    js_call_fn(lfn, dom_obj[idx], &g_argv1[0], 1)
                else:
                    js_call_fn(lfn, dom_obj[idx], cast[Ptr[int32]](0), 0)
                g_cur_passive = 0
                ran = 1
                # once:true listeners fire at most once (DOM addEventListener opt).
                if evl_once[li] != 0:
                    evl_dead[li] = 1
                # stopImmediatePropagation(): no further listeners on this element.
                if g_stop_immediate != 0:
                    return ran
        li = li + 1
    # (2) the attribute handler (el.on<evt> property or inline on<evt>="") — an
    # event-handler content/IDL attribute is a bubble-side listener, so it never
    # fires during the CAPTURE phase (only at-target and bubbling).
    if phase == EPHASE_CAPTURE:
        return ran
    fn: int32 = -1
    src: int32 = -1
    srclen: int32 = 0
    pnm: Ptr[uint8] = cast[Ptr[uint8]]("onclick")
    pnl: int32 = 7
    if kind == 0:
        fn = dom_onclick_fn[idx]
        src = dom_onclick_src[idx]
        srclen = dom_onclick_srclen[idx]
    elif kind == 1:
        fn = dom_oninput_fn[idx]
        src = dom_oninput_src[idx]
        srclen = dom_oninput_srclen[idx]
        pnm = cast[Ptr[uint8]]("oninput")
        pnl = 7
    elif kind == 2:
        fn = dom_onchange_fn[idx]
        src = dom_onchange_src[idx]
        srclen = dom_onchange_srclen[idx]
        pnm = cast[Ptr[uint8]]("onchange")
        pnl = 8
    elif kind == 3:
        fn = dom_onsubmit_fn[idx]
        src = dom_onsubmit_src[idx]
        srclen = dom_onsubmit_srclen[idx]
        pnm = cast[Ptr[uint8]]("onsubmit")
        pnl = 8
    # el.on<evt> = fn assigned by a still-running script is not synced to the
    # slot until _dom_readback; read it live so a load-time dispatch sees it.
    if fn < 0:
        pv: int32 = js_get_prop(dom_obj[idx], pnm, cast[uint64](pnl))
        if js_is_callable(pv) != 0:
            fn = pv
    if fn >= 0 and js_is_callable(fn) != 0:
        if evtobj >= 0:
            g_argv1[0] = evtobj
            js_call_fn(fn, dom_obj[idx], &g_argv1[0], 1)
        else:
            js_call_fn(fn, dom_obj[idx], cast[Ptr[int32]](0), 0)
        return 1
    if src >= 0:
        # Compile the inline source into a function so `this` binds to the
        # element (this.value / this.checked), then cache + call it.
        cfn: int32 = _compile_inline_handler(src, srclen)
        if cfn >= 0 and js_is_callable(cfn) != 0:
            _store_handler_fn(idx, kind, cfn)
            if evtobj >= 0:
                g_argv1[0] = evtobj
                js_call_fn(cfn, dom_obj[idx], &g_argv1[0], 1)
            else:
                js_call_fn(cfn, dom_obj[idx], cast[Ptr[int32]](0), 0)
            return 1
        # Fallback: run the raw source at global scope (legacy `this`==global).
        js_eval(&dom_txtbuf[src], cast[uint64](srclen))
        if js_error() != 0:
            js_had_error = 1
        return 1
    return ran


# The registered DOM element whose source anchor is `anchor`, or -1. Used to map
# a tx-tree ancestor back to a live dom element while bubbling.
def _dom_by_anchor(anchor: int32) -> int32:
    if anchor < 0:
        return -1
    j: int32 = 0
    while j < dom_n:
        if dom_anchor[j] == anchor:
            return j
        j = j + 1
    return -1


# Materialize the propagation path for a dispatch at `target_el`: disp_path[0]
# is the target and each higher slot the nearest registered ancestor element up
# the source (tx) tree, disp_path[disp_n-1] being the outermost. Returns disp_n.
def _build_disp_path(target_el: int32) -> int32:
    disp_n = 0
    cur: int32 = target_el
    while cur >= 0 and disp_n < DISP_PATH_MAX:
        disp_path[disp_n] = cur
        disp_n = disp_n + 1
        tn: int32 = _tx_by_anchor(dom_anchor[cur])
        cur = -1
        if tn >= 0:
            t: int32 = tx_parent[tn]
            while t >= 0:
                de: int32 = _dom_by_anchor(tx_anchor[t])
                if de >= 0:
                    cur = de
                    t = -1
                else:
                    t = tx_parent[t]
    return disp_n


# Set event.eventPhase (a no-op when there is no event object).
def _set_ephase(evtobj: int32, ph: int32):
    if evtobj >= 0:
        js_set_prop(evtobj, cast[Ptr[uint8]]("eventPhase"), 10, \
                    js_number(cast[float64](ph)))


# Does the event object bubble? Defaults to true (legacy plain {type:'click'}
# objects carry no `bubbles` field yet must bubble); only an explicit bubbles ==
# false (a `new Event(type)` with bubbles unset, or {bubbles:false}) suppresses
# the bubble phase.
def _evt_bubbles(evtobj: int32) -> int32:
    if evtobj < 0:
        return 1
    bv: int32 = js_get_prop(evtobj, cast[Ptr[uint8]]("bubbles"), 7)
    if js_type_of(bv) != 0 and js_to_bool(bv) == 0:       # 0 == undefined tag
        return 0
    return 1


# Dispatch event `evtobj` (of kind 0 click / 1 input / 2 change / 3 submit) at
# target dom element `target_el` through the real DOM three-phase propagation:
# CAPTURE (root->target's parent, capture:true listeners), TARGET (all listeners
# on the target), then — if the event bubbles — BUBBLE (target's parent->root,
# capture:false listeners). Sets event.target once, event.currentTarget +
# event.eventPhase per hop, and honours stop(Immediate)Propagation between and
# within hops. Resets g_prevent_default / g_stop_prop at the start. Returns 1 if
# any handler ran.
def _dispatch_event(target_el: int32, kind: int32, evtobj: int32) -> int32:
    g_prevent_default = 0
    g_stop_prop = 0
    g_stop_immediate = 0
    g_cur_event = evtobj
    ran: int32 = 0
    if evtobj >= 0:
        js_set_prop(evtobj, cast[Ptr[uint8]]("target"), 6, dom_obj[target_el])
    n: int32 = _build_disp_path(target_el)
    bub: int32 = _evt_bubbles(evtobj)
    # --- capture phase: root -> target's parent ---
    _set_ephase(evtobj, EPHASE_CAPTURE)
    i: int32 = n - 1
    while i >= 1 and g_stop_prop == 0:
        g_stop_immediate = 0
        if evtobj >= 0:
            js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                        dom_obj[disp_path[i]])
        if _fire_handler(disp_path[i], kind, evtobj, EPHASE_CAPTURE) != 0:
            ran = 1
        i = i - 1
    # --- target phase ---
    if g_stop_prop == 0:
        g_stop_immediate = 0
        _set_ephase(evtobj, EPHASE_TARGET)
        if evtobj >= 0:
            js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                        dom_obj[target_el])
        if _fire_handler(target_el, kind, evtobj, EPHASE_TARGET) != 0:
            ran = 1
    # --- bubble phase: target's parent -> root ---
    if bub != 0:
        _set_ephase(evtobj, EPHASE_BUBBLE)
        i = 1
        while i < n and g_stop_prop == 0:
            g_stop_immediate = 0
            if evtobj >= 0:
                js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                            dom_obj[disp_path[i]])
            if _fire_handler(disp_path[i], kind, evtobj, EPHASE_BUBBLE) != 0:
                ran = 1
            i = i + 1
        # terminal hop: document-level delegation (document.addEventListener)
        if g_stop_prop == 0:
            g_stop_immediate = 0
            if _fire_docel(kind, cast[Ptr[uint8]](0), 0, evtobj) != 0:
                ran = 1
    _set_ephase(evtobj, EPHASE_NONE)
    if evtobj >= 0:
        js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
        js_set_prop(evtobj, cast[Ptr[uint8]]("@sp"), 3, js_bool(0))
    g_cur_event = -1
    return ran


# Dispatch a string-typed event (type typp[0..typn)) at `target_el` through the
# same three-phase propagation as _dispatch_event, firing each hop's GEN_KIND
# listeners whose capture flag matches the phase. Honours bubbles + stop
# propagation. Returns 1 if any listener ran.
def _dispatch_generic(target_el: int32, typp: Ptr[uint8], typn: int32, \
                      evtobj: int32) -> int32:
    g_prevent_default = 0
    g_stop_prop = 0
    g_stop_immediate = 0
    g_cur_event = evtobj
    ran: int32 = 0
    if evtobj >= 0:
        js_set_prop(evtobj, cast[Ptr[uint8]]("target"), 6, dom_obj[target_el])
    n: int32 = _build_disp_path(target_el)
    bub: int32 = _evt_bubbles(evtobj)
    # --- capture phase ---
    _set_ephase(evtobj, EPHASE_CAPTURE)
    i: int32 = n - 1
    while i >= 1 and g_stop_prop == 0:
        g_stop_immediate = 0
        if evtobj >= 0:
            js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                        dom_obj[disp_path[i]])
        if _fire_generic(disp_path[i], typp, typn, evtobj, EPHASE_CAPTURE) != 0:
            ran = 1
        i = i - 1
    # --- target phase ---
    if g_stop_prop == 0:
        g_stop_immediate = 0
        _set_ephase(evtobj, EPHASE_TARGET)
        if evtobj >= 0:
            js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                        dom_obj[target_el])
        if _fire_generic(target_el, typp, typn, evtobj, EPHASE_TARGET) != 0:
            ran = 1
    # --- bubble phase ---
    if bub != 0:
        _set_ephase(evtobj, EPHASE_BUBBLE)
        i = 1
        while i < n and g_stop_prop == 0:
            g_stop_immediate = 0
            if evtobj >= 0:
                js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, \
                            dom_obj[disp_path[i]])
            if _fire_generic(disp_path[i], typp, typn, evtobj, EPHASE_BUBBLE) != 0:
                ran = 1
            i = i + 1
        # terminal hop: document-level delegation. _dispatch_event has always
        # ended its bubble at _fire_docel, but the string-typed twin stopped at
        # the source root — so `document.addEventListener('mousedown', …)`, the
        # delegation idiom real pages use for menus and outside-click dismissal,
        # never fired for an event raised on an element. Chromium bubbles every
        # type to the document; so do we now.
        if g_stop_prop == 0:
            g_stop_immediate = 0
            if _fire_docel(-1, typp, typn, evtobj) != 0:
                ran = 1
    _set_ephase(evtobj, EPHASE_NONE)
    if evtobj >= 0:
        js_set_prop(evtobj, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
        js_set_prop(evtobj, cast[Ptr[uint8]]("@sp"), 3, js_bool(0))
    g_cur_event = -1
    return ran


# ---- object-keyed event listeners (created / dynamic nodes) -----------------
# The evl_ table + _dispatch_event walk the SOURCE tree (tx index), so they
# cannot reach nodes built by createElement/innerHTML. For those, listeners are
# stored directly on the node's JS object under a per-type hidden array prop
# ("@L:<type>"), and click()/dispatchEvent fire them + bubble along the live JS
# parentNode chain. This is the Phase-0 programmatic-event path (target + bubble
# over the live tree) — distinct from the coordinate-driven he_dom_click path.
g_lp_buf: Array[288, uint8]


def _obj_lp_name(typep: Ptr[uint8], typen: int32) -> int32:
    g_lp_buf[0] = 64                                       # '@'
    g_lp_buf[1] = 76                                       # 'L'
    g_lp_buf[2] = 58                                       # ':'
    i: int32 = 0
    while i < typen and i < 250:
        g_lp_buf[3 + i] = typep[i]
        i = i + 1
    g_lp_buf[3 + i] = 0
    return 3 + i


def _obj_add_listener(obj: int32, typep: Ptr[uint8], typen: int32, fn: int32):
    ln: int32 = _obj_lp_name(typep, typen)
    arr: int32 = js_get_prop(obj, &g_lp_buf[0], cast[uint64](ln))
    if js_is_array(arr) == 0:
        arr = js_new_array_v()
        js_set_prop(obj, &g_lp_buf[0], cast[uint64](ln), arr)
    i: int32 = 0
    n: int32 = js_array_len(arr)
    while i < n:
        if js_array_get(arr, i) == fn:
            return                                        # de-dupe (spec)
        i = i + 1
    js_array_push(arr, fn)


def _obj_remove_listener(obj: int32, typep: Ptr[uint8], typen: int32, fn: int32):
    ln: int32 = _obj_lp_name(typep, typen)
    arr: int32 = js_get_prop(obj, &g_lp_buf[0], cast[uint64](ln))
    if js_is_array(arr) == 0:
        return
    nw: int32 = js_new_array_v()
    i: int32 = 0
    n: int32 = js_array_len(arr)
    while i < n:
        ev: int32 = js_array_get(arr, i)
        if ev != fn:
            js_array_push(nw, ev)
        i = i + 1
    js_set_prop(obj, &g_lp_buf[0], cast[uint64](ln), nw)


# Fire object-stored listeners of `type` on `obj` (+ its inline on<type> prop).
def _obj_fire_type(obj: int32, typep: Ptr[uint8], typen: int32, evo: int32) -> int32:
    ran: int32 = 0
    ln: int32 = _obj_lp_name(typep, typen)
    arr: int32 = js_get_prop(obj, &g_lp_buf[0], cast[uint64](ln))
    if js_is_array(arr) != 0:
        i: int32 = 0
        n: int32 = js_array_len(arr)
        while i < n and g_stop_immediate == 0:
            fn: int32 = js_array_get(arr, i)
            if js_is_callable(fn) != 0:
                g_argv1[0] = evo
                js_call_fn(fn, obj, &g_argv1[0], 1)
                ran = 1
            i = i + 1
    # inline on<type> handler property (el.onclick = fn)
    onm: Array[64, uint8]
    onm[0] = 111                                           # 'o'
    onm[1] = 110                                           # 'n'
    j: int32 = 0
    while j < typen and j < 60:
        onm[2 + j] = typep[j]
        j = j + 1
    onm[2 + j] = 0
    ofn: int32 = js_get_prop(obj, &onm[0], cast[uint64](2 + j))
    if js_is_callable(ofn) != 0 and g_stop_immediate == 0:
        g_argv1[0] = evo
        js_call_fn(ofn, obj, &g_argv1[0], 1)
        ran = 1
    return ran


# Fire the document/window-level (evl_el == DOC_EL) listeners for this event —
# the terminal hop of every bubble chain. `kind` is the attribute-backed kind
# (0 click / 1 input / 2 change / 3 submit) or -1, in which case GEN_KIND
# listeners are matched by type string. `this` is the document. Event delegation
# rooted at `document.addEventListener('click', …)` is one of the two dominant
# real-page interaction idioms, so no bubble may stop below it.
def _fire_docel(kind: int32, typep: Ptr[uint8], typen: int32, evo: int32) -> int32:
    ran: int32 = 0
    tp: Ptr[uint8] = typep
    tn: int32 = typen
    if kind == 0:
        tp = cast[Ptr[uint8]]("click")
        tn = 5
    elif kind == 1:
        tp = cast[Ptr[uint8]]("input")
        tn = 5
    elif kind == 2:
        tp = cast[Ptr[uint8]]("change")
        tn = 6
    elif kind == 3:
        tp = cast[Ptr[uint8]]("submit")
        tn = 6
    if evo >= 0:
        js_global_set(cast[Ptr[uint8]]("event"), 5, evo)
        js_set_prop(evo, cast[Ptr[uint8]]("currentTarget"), 13, js_doc)
    li: int32 = 0
    while li < evl_n and g_stop_immediate == 0:
        hit: int32 = 0
        if evl_dead[li] == 0 and evl_el[li] == DOC_EL:
            if kind >= 0 and evl_kind[li] == kind:
                hit = 1
            elif tn > 0 and evl_kind[li] == GEN_KIND and _evl_type_eq(li, tp, tn) != 0:
                hit = 1
        if hit != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_cur_passive = evl_passive[li]
                if evo >= 0:
                    g_argv1[0] = evo
                    js_call_fn(lfn, js_doc, &g_argv1[0], 1)
                else:
                    js_call_fn(lfn, js_doc, cast[Ptr[int32]](0), 0)
                g_cur_passive = 0
                ran = 1
                if evl_once[li] != 0:
                    evl_dead[li] = 1
        li = li + 1
    # `document.onclick = fn` is an IDL handler PROPERTY, not an evl_ row, so it
    # lives on the document object like any created node's would.
    if tn > 0 and g_stop_immediate == 0 and _obj_fire_type(js_doc, tp, tn, evo) != 0:
        ran = 1
    return ran


# Fire ONE hop of an object-chain dispatch. The two listener stores are disjoint
# by construction: a SOURCE-anchored element keeps its registrations in the evl_
# table (+ its on<evt> attribute slot), a CREATED node keeps them on its own JS
# object under "@L:<type>". Firing the wrong store at a hop either misses the
# listener (the live-DOM bug) or double-invokes it (el.onclick lives in BOTH the
# object property and dom_onclick_fn), so dispatch by which registry owns `obj`.
def _obj_fire_hop(obj: int32, typep: Ptr[uint8], typen: int32, evo: int32, \
                  kind: int32, phase: int32) -> int32:
    el: int32 = _find_el_by_obj(obj)
    if el >= 0:
        if kind >= 0:
            return _fire_handler(el, kind, evo, phase)
        return _fire_generic(el, typep, typen, evo, phase)
    return _obj_fire_type(obj, typep, typen, evo)


# Dispatch event `evo` of `type` at node `targetobj` — a created node OR a
# source-anchored element — target phase then (if bubbles) bubble up the live JS
# parentNode chain, firing whichever listener store owns each hop, and finally
# the document-level listeners. Honours stopPropagation /
# stopImmediatePropagation. preventDefault flips g_prevent_default (and
# evo.defaultPrevented via NID_PREVENT).
def _obj_dispatch(targetobj: int32, typep: Ptr[uint8], typen: int32, \
                  evo: int32, bubbles: int32) -> int32:
    g_prevent_default = 0
    g_stop_prop = 0
    g_stop_immediate = 0
    g_cur_event = evo
    if evo >= 0:
        js_set_prop(evo, cast[Ptr[uint8]]("target"), 6, targetobj)
        js_global_set(cast[Ptr[uint8]]("event"), 5, evo)
    ran: int32 = 0
    kind: int32 = _evt_std_kind(typep, typen)
    # target phase
    if evo >= 0:
        js_set_prop(evo, cast[Ptr[uint8]]("currentTarget"), 13, targetobj)
    _set_ephase(evo, EPHASE_TARGET)
    if _obj_fire_hop(targetobj, typep, typen, evo, kind, EPHASE_TARGET) != 0:
        ran = 1
    # bubble phase
    _set_ephase(evo, EPHASE_BUBBLE)
    cur: int32 = targetobj
    depth: int32 = 0
    while bubbles != 0 and g_stop_prop == 0 and depth < 256:
        pv: int32 = js_get_prop(cur, cast[Ptr[uint8]]("parentNode"), 10)
        if js_type_of(pv) != 5 or pv == js_doc:
            depth = 256
        else:
            cur = pv
            g_stop_immediate = 0
            if evo >= 0:
                js_set_prop(evo, cast[Ptr[uint8]]("currentTarget"), 13, cur)
            if _obj_fire_hop(cur, typep, typen, evo, kind, EPHASE_BUBBLE) != 0:
                ran = 1
            depth = depth + 1
    # terminal hop: document-level delegation
    if bubbles != 0 and g_stop_prop == 0:
        g_stop_immediate = 0
        if _fire_docel(kind, typep, typen, evo) != 0:
            ran = 1
    _set_ephase(evo, EPHASE_NONE)
    if evo >= 0:
        js_set_prop(evo, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
        js_set_prop(evo, cast[Ptr[uint8]]("@sp"), 3, js_bool(0))
    g_cur_event = -1
    return ran


# Settle the page after a dispatched event: drain deferred work, read the DOM
# back and re-lay it out so the handler's mutations render.
def _after_event_settle():
    js_drain_timers()
    _dom_readback()
    _js_capture_console()
    _relayout()


def he_dom_click_index(idx: int32) -> int32:
    if js_ctx_live == 0 or idx < 0:
        return 0
    # A SCRIPT-CREATED target (CRE_IDX_BASE + cre id) has no source anchor, so it
    # cannot go through the tx-tree walk _dispatch_event does. It dispatches over
    # the LIVE parentNode chain instead — which crosses back onto source-anchored
    # ancestors (and the document) at _obj_fire_hop, so delegation to a static
    # container still fires.
    if idx >= CRE_IDX_BASE:
        cid: int32 = idx - CRE_IDX_BASE
        if cid >= cre_n or cre_gone[cid] != 0:
            return 0
        cev: int32 = _new_event_obj()
        js_set_prop(cev, cast[Ptr[uint8]]("type"), 4, \
                    js_new_string(cast[Ptr[uint8]]("click"), 5))
        js_set_prop(cev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(1))
        if _obj_dispatch(cre_obj[cid], cast[Ptr[uint8]]("click"), 5, cev, 1) == 0:
            return 0
        _after_event_settle()
        return 1
    if idx >= dom_n:
        return 0
    # A real POINTER PRESS is not one `click` event. Measured with chromium over
    # CDP (Input.dispatchMouseEvent mousePressed+mouseReleased at the element's
    # centre, a <div> listening for every candidate type), one left click
    # delivers NINE events in this order:
    #     pointerover pointerenter mouseover mouseenter
    #     pointerdown mousedown pointerup mouseup click
    # We used to deliver only the last one, so a menu button / drag handle /
    # custom control whose handler is on mousedown (or pointerdown, or
    # mouseover) never ran even once its element became hit-testable. Deliver
    # the whole sequence, then the click.
    seq: int32 = _fire_pointer_seq(idx)
    # a real click routes through the same bubbling dispatch core as
    # el.dispatchEvent(), so ancestor click listeners fire.
    ev: int32 = _new_event_obj()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(cast[Ptr[uint8]]("click"), 5))
    if _dispatch_event(idx, 0, ev) == 0 and seq == 0:
        return 0
    # A handler may schedule deferred work (setTimeout/queueMicrotask) — real
    # sites debounce input, kick off async-then-update flows, "run after this
    # turn". Drain the task queue AFTER the dispatch (js_eval only drains at
    # load) so those callbacks + their DOM mutations run before we read back /
    # re-render. Without this a click handler's setTimeout(f,0) never fired.
    js_drain_timers()
    _dom_readback()
    _js_capture_console()
    _relayout()
    return 1


# Dispatch ONE string-typed pointer event at `idx`. `bub` = 0 for the two
# non-bubbling "enter" types (chromium: pointerenter/mouseenter do not bubble).
def _fire_ptr_evt(idx: int32, typp: Ptr[uint8], typn: int32, bub: int32) -> int32:
    ev: int32 = _new_event_obj()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(typp, cast[uint64](typn)))
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(bub))
    return _dispatch_generic(idx, typp, typn, ev)


# Is ANY live string-typed pointer listener registered anywhere on the page?
# Fast-out for _fire_pointer_seq: with none registered the eight extra dispatches
# cannot reach a handler, so skipping them is unobservable — and it keeps every
# page that registers no pointer listener (which is every existing host gate)
# byte-identical, allocating no extra event objects into the JS arena.
def _any_pointer_listener() -> int32:
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_kind[li] == GEN_KIND and \
           _is_pointer_type(&evt_tybuf[evl_type_off[li]], evl_type_len[li]) != 0:
            return 1
        li = li + 1
    return 0


# Deliver the pointer-press event sequence a real click delivers BEFORE `click`,
# in chromium's measured order (see he_dom_click_index). Returns 1 if any
# listener ran.
def _fire_pointer_seq(idx: int32) -> int32:
    if _any_pointer_listener() == 0:
        return 0
    ran: int32 = 0
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("pointerover"), 11, 1) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("pointerenter"), 12, 0) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("mouseover"), 9, 1) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("mouseenter"), 10, 0) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("pointerdown"), 11, 1) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("mousedown"), 9, 1) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("pointerup"), 9, 1) != 0:
        ran = 1
    if _fire_ptr_evt(idx, cast[Ptr[uint8]]("mouseup"), 7, 1) != 0:
        ran = 1
    return ran


# Look up a registered DOM element by id, registering it on demand (the JS
# context must be live). Returns its dom index, or -1.
# Locate a form control's start tag by its `name="..."` attribute (the id-less
# case). Real forms — google.com's `<input name="q">` — identify controls by
# `name`, not `id`, so field resolution must fall back to it. Returns 1 and sets
# g_el_lt (like _dom_find_by_id) when found.
def _dom_find_by_name(idp: Ptr[uint8], idn: int32) -> int32:
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           src_ptr[i + 1] != 47 and src_ptr[i + 1] != 33 and \
           src_ptr[i + 1] != 63:
            ts: uint64 = i + 1
            je: uint64 = ts
            je = _hx_tag_end_p(src_ptr, src_len, je)
            # only match form controls (input/textarea/select/button/form) so a
            # `<meta name=…>` or `<a name=…>` can't shadow the field.
            if _tagname_is(ts, cast[Ptr[uint8]]("input")) != 0 or \
               _tagname_is(ts, cast[Ptr[uint8]]("textarea")) != 0 or \
               _tagname_is(ts, cast[Ptr[uint8]]("select")) != 0 or \
               _tagname_is(ts, cast[Ptr[uint8]]("button")) != 0 or \
               _tagname_is(ts, cast[Ptr[uint8]]("form")) != 0:
                if _hx_find_attr(ts, je, cast[Ptr[uint8]]("name")) != 0:
                    if _idbytes_eq(g_attr_start, g_attr_end, idp, idn) != 0:
                        return _scan_start_tag(i)
            i = je
        i = i + 1
    return 0


# Build a form's `.elements` HTMLFormControlsCollection (+ `.length`): scan the
# form's content span for control start tags (input/select/textarea/button),
# register each, and expose the array. Real forms iterate form.elements and read
# form.elements.length / form.length. Called once at form registration; saves +
# restores the g_el_* scan globals it clobbers so the caller is unaffected.
def _lookup_or_register(idp: Ptr[uint8], idn: int32) -> int32:
    e: int32 = _dom_lookup_id(idp, idn)
    if e >= 0:
        return e
    if _dom_find_by_id(idp, idn) != 0:
        _dom_register_el()
        return _dom_lookup_anchor(cast[int32](g_el_lt))
    # id-less form control (google uses `name="q"`, no id) -> resolve by name
    if _dom_find_by_name(idp, idn) != 0:
        _dom_register_el()
        return _dom_lookup_anchor(cast[int32](g_el_lt))
    return -1


# Build a minimal event object exposing preventDefault()/stopPropagation() and
# the type/target/defaultPrevented properties handlers read.
def _new_event_obj() -> int32:
    ev: int32 = js_new_object_v()
    js_set_prop(ev, cast[Ptr[uint8]]("preventDefault"), 14, \
                js_new_native_fn(js_hbase + NID_PREVENT))
    js_set_prop(ev, cast[Ptr[uint8]]("stopPropagation"), 15, \
                js_new_native_fn(js_hbase + NID_STOPPROP))
    js_set_prop(ev, cast[Ptr[uint8]]("stopImmediatePropagation"), 24, \
                js_new_native_fn(js_hbase + NID_STOPIMMED))
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("target"), 6, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("eventPhase"), 10, js_number(cast[float64](0)))
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, js_new_string(&dom_txtbuf[0], 0))
    return ev


# Construct an Event / CustomEvent / MouseEvent / KeyboardEvent from the JS
# argument list. `flavor`: 0 Event, 1 CustomEvent, 2 MouseEvent, 3 KeyboardEvent.
# Reads the type string (arg0) and an options object (arg1): bubbles / cancelable
# (all), detail (CustomEvent), plus a few basic MouseEvent/KeyboardEvent fields.
# Returns a fresh object usable as an event (dispatchEvent reads .type).
# ---- DOMException + document.createEvent -----------------------------------
#
# The legacy DOM name -> code table (DOMException "legacy code"). Names minted
# after the legacy list -- SyntaxError as a DOMException, and everything newer
# -- carry code 0, which is correct and is what the spec says.
def _domexc_code(nm: Ptr[uint8], n: int32) -> int32:
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("IndexSizeError"), 14) != 0:
        return 1
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("HierarchyRequestError"), 21) != 0:
        return 3
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("WrongDocumentError"), 18) != 0:
        return 4
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InvalidCharacterError"), 21) != 0:
        return 5
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("NoModificationAllowedError"), 26) != 0:
        return 7
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("NotFoundError"), 13) != 0:
        return 8
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("NotSupportedError"), 17) != 0:
        return 9
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InUseAttributeError"), 19) != 0:
        return 10
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InvalidStateError"), 17) != 0:
        return 11
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("SyntaxError"), 11) != 0:
        return 12
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InvalidModificationError"), 24) != 0:
        return 13
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("NamespaceError"), 14) != 0:
        return 14
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InvalidAccessError"), 18) != 0:
        return 15
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("TypeMismatchError"), 17) != 0:
        return 17
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("SecurityError"), 13) != 0:
        return 18
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("NetworkError"), 12) != 0:
        return 19
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("AbortError"), 10) != 0:
        return 20
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("URLMismatchError"), 16) != 0:
        return 21
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("QuotaExceededError"), 18) != 0:
        return 22
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("TimeoutError"), 12) != 0:
        return 23
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("InvalidNodeTypeError"), 20) != 0:
        return 24
    if _bytes_eq(nm, n, cast[Ptr[uint8]]("DataCloneError"), 14) != 0:
        return 25
    return 0


# Build a DOMException object: name / message / legacy code, branded with
# DOMException.prototype and carrying `constructor` so assert_throws_dom's
# final "is this from the right global" check passes.
def _new_domexc(nm: Ptr[uint8], n: int32, msg: Ptr[uint8], mn: int32) -> int32:
    ev: int32 = js_new_object_v()
    if g_proto_domexc != 0:
        js_set_proto_v(ev, g_proto_domexc)
    js_set_prop(ev, cast[Ptr[uint8]]("name"), 4, js_new_string(nm, cast[uint64](n)))
    js_set_prop(ev, cast[Ptr[uint8]]("message"), 7, js_new_string(msg, cast[uint64](mn)))
    js_set_prop(ev, cast[Ptr[uint8]]("code"), 4, \
                js_number(cast[float64](_domexc_code(nm, n))))
    if g_domexc_ctor != 0:
        js_set_prop(ev, cast[Ptr[uint8]]("constructor"), 11, g_domexc_ctor)
    return ev


# Raise a DOMException from inside a host native, the way a browser binding
# does. Unwinds through the interpreter's normal CTL_THROW path, so a page's
# try/catch (and testharness's assert_throws_dom) sees it.
def _throw_domexc(nm: Ptr[uint8], n: int32, msg: Ptr[uint8], mn: int32) -> int32:
    js_throw_value(_new_domexc(nm, n, msg, mn))
    return js_undefined()


# document.createEvent(interface) -- the legacy event factory. Returns an
# UNINITIALISED event (type "", bubbles/cancelable false) which the caller then
# fills in with initEvent / initCustomEvent. An unrecognised interface name must
# throw NotSupportedError, and whole WPT files assert exactly that.
#
# Interface names are matched ASCII-case-INSENSITIVELY, which is what the spec
# requires here (createEvent("mouseevents") is legal and used in the wild).
# The spec "default passive value" for an addEventListener with no explicit
# passive option: TRUE only for the scroll-blocking event types on the four
# scroll-owning targets (window / document / documentElement / body), so a page
# cannot jank scrolling from those. Everything else defaults to non-passive.
def _default_passive(el: int32, typp: Ptr[uint8], typn: int32) -> int32:
    if _ascii_ci_eq(typp, typn, cast[Ptr[uint8]]("touchstart"), 10) == 0 and \
       _ascii_ci_eq(typp, typn, cast[Ptr[uint8]]("touchmove"), 9) == 0 and \
       _ascii_ci_eq(typp, typn, cast[Ptr[uint8]]("wheel"), 5) == 0 and \
       _ascii_ci_eq(typp, typn, cast[Ptr[uint8]]("mousewheel"), 10) == 0:
        return 0
    if el == DOC_EL:                                       # window / document
        return 1
    if el >= 0 and el < dom_n:
        if _el_tag_is(el, cast[Ptr[uint8]]("html")) != 0 or \
           _el_tag_is(el, cast[Ptr[uint8]]("body")) != 0:
            return 1
    return 0


# Mint one Event-interface object: a global constructor plus its own prototype,
# stashed in g_ev_proto[flavor] so createEvent can brand instances with exactly
# window[iface].prototype (WPT's alias test compares by identity).
def _mk_ev_iface(nm: Ptr[uint8], nlen: int32, nid: int32, flavor: int32):
    ctor: int32 = js_new_native_fn(js_hbase + nid)
    js_global_set(nm, cast[uint64](nlen), ctor)
    proto: int32 = js_fn_prototype(ctor)
    g_ev_proto[flavor] = proto
    # returnValue + cancelBubble are live accessors mapped onto the canceled /
    # stop-propagation flags, inherited by every event of this interface.
    js_define_accessor(proto, cast[Ptr[uint8]]("returnValue"), 11, \
                       js_new_native_fn(js_hbase + NID_RETVAL_GET), \
                       js_new_native_fn(js_hbase + NID_RETVAL_SET))
    js_define_accessor(proto, cast[Ptr[uint8]]("cancelBubble"), 12, \
                       js_new_native_fn(js_hbase + NID_CANCELBUB_GET), \
                       js_new_native_fn(js_hbase + NID_CANCELBUB_SET))


# Link one event interface's prototype onto its spec parent's, so `instanceof`
# walks the real chain (MouseEvent -> UIEvent -> Event).
def _ev_inherit(child: int32, parent: int32):
    if child < 0 or child >= 16 or parent < 0 or parent >= 16:
        return
    if g_ev_proto[child] == 0 or g_ev_proto[parent] == 0:
        return
    js_set_proto_v(g_ev_proto[child], g_ev_proto[parent])


# Map a document.createEvent() interface name to a `flavor`, or -1 if the name
# is not in the spec's legacy event-interface table. ASCII case-INSENSITIVE, and
# the plural legacy aliases (Events/HTMLEvents/SVGEvents -> Event, MouseEvents ->
# MouseEvent, UIEvents -> UIEvent, KeyEvents -> KeyboardEvent) collapse here.
def _ev_flavor(p: Ptr[uint8], n: int32) -> int32:
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("event"), 5) != 0 or \
       _ascii_ci_eq(p, n, cast[Ptr[uint8]]("events"), 6) != 0 or \
       _ascii_ci_eq(p, n, cast[Ptr[uint8]]("htmlevents"), 10) != 0 or \
       _ascii_ci_eq(p, n, cast[Ptr[uint8]]("svgevents"), 9) != 0:
        return 0
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("customevent"), 11) != 0:
        return 1
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("mouseevent"), 10) != 0 or \
       _ascii_ci_eq(p, n, cast[Ptr[uint8]]("mouseevents"), 11) != 0:
        return 2
    # NB: "KeyEvents" is deliberately NOT here — it is absent from the spec's
    # createEvent table, and WPT asserts createEvent("KeyEvents") throws.
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("keyboardevent"), 13) != 0:
        return 3
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("uievent"), 7) != 0 or \
       _ascii_ci_eq(p, n, cast[Ptr[uint8]]("uievents"), 8) != 0:
        return 4
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("beforeunloadevent"), 17) != 0:
        return 5
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("compositionevent"), 16) != 0:
        return 6
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("devicemotionevent"), 17) != 0:
        return 7
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("deviceorientationevent"), 22) != 0:
        return 8
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("dragevent"), 9) != 0:
        return 9
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("focusevent"), 10) != 0:
        return 10
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("hashchangeevent"), 15) != 0:
        return 11
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("messageevent"), 12) != 0:
        return 12
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("storageevent"), 12) != 0:
        return 13
    if _ascii_ci_eq(p, n, cast[Ptr[uint8]]("textevent"), 9) != 0:
        return 14
    return -1


def _create_event() -> int32:
    n: int32 = 0
    if js_arg_count() >= 1:
        n = _arg_bytes(0, &dom_idtmp[0], 256)
    flavor: int32 = _ev_flavor(&dom_idtmp[0], n)
    if flavor < 0:
        return _throw_domexc(cast[Ptr[uint8]]("NotSupportedError"), 17, \
                             cast[Ptr[uint8]]("createEvent: unsupported interface"), 34)
    ev: int32 = _blank_event(flavor)
    return ev


# A created-but-uninitialised event, plus the legacy init* methods that fill it
# in. Shares the shape _make_event produces so dispatch treats both alike.
def _blank_event(flavor: int32) -> int32:
    ev: int32 = js_new_object_v()
    if flavor >= 0 and flavor < 16 and g_ev_proto[flavor] != 0:
        js_set_proto_v(ev, g_ev_proto[flavor])
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("cancelable"), 10, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("detail"), 6, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("target"), 6, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("srcElement"), 10, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("eventPhase"), 10, js_number(cast[float64](0)))
    js_set_prop(ev, cast[Ptr[uint8]]("isTrusted"), 9, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("composed"), 8, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("timeStamp"), 9, js_number(cast[float64](0)))
    js_set_prop(ev, cast[Ptr[uint8]]("preventDefault"), 14, \
                js_new_native_fn(js_hbase + NID_PREVENT))
    js_set_prop(ev, cast[Ptr[uint8]]("stopPropagation"), 15, \
                js_new_native_fn(js_hbase + NID_STOPPROP))
    js_set_prop(ev, cast[Ptr[uint8]]("stopImmediatePropagation"), 24, \
                js_new_native_fn(js_hbase + NID_STOPIMMED))
    js_set_prop(ev, cast[Ptr[uint8]]("initEvent"), 9, \
                js_new_native_fn(js_hbase + NID_INITEVENT))
    if flavor == 1:
        js_set_prop(ev, cast[Ptr[uint8]]("initCustomEvent"), 15, \
                    js_new_native_fn(js_hbase + NID_INITCUSTOMEV))
    _event_constants(ev)
    return ev


# event.initEvent(type, bubbles, cancelable) / initCustomEvent(..., detail).
def _init_event(with_detail: int32) -> int32:
    ev: int32 = js_this()
    if js_type_of(ev) != 5:
        return js_undefined()
    tn: int32 = 0
    if js_arg_count() >= 1:
        tn = _arg_bytes(0, &dom_idtmp[0], 256)
        if _is_undef_str(&dom_idtmp[0], tn) != 0:
            tn = 0
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(&dom_idtmp[0], cast[uint64](tn)))
    b: int32 = 0
    if js_arg_count() >= 2 and js_to_bool(js_arg(1)) != 0:
        b = 1
    c: int32 = 0
    if js_arg_count() >= 3 and js_to_bool(js_arg(2)) != 0:
        c = 1
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(b))
    js_set_prop(ev, cast[Ptr[uint8]]("cancelable"), 10, js_bool(c))
    # initialize: unset the canceled + stop-propagation flags (so a reused
    # createEvent'd event re-inits cleanly — returnValue back to true,
    # cancelBubble back to false).
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("@sp"), 3, js_bool(0))
    if with_detail != 0:
        dv: int32 = js_null()
        if js_arg_count() >= 4:
            dv = js_arg(3)
        js_set_prop(ev, cast[Ptr[uint8]]("detail"), 6, dv)
    return js_undefined()


# The Event phase constants, which the spec puts on both the interface object
# and every instance.
def _event_constants(target: int32):
    js_set_prop(target, cast[Ptr[uint8]]("NONE"), 4, js_number(cast[float64](0)))
    js_set_prop(target, cast[Ptr[uint8]]("CAPTURING_PHASE"), 15, \
                js_number(cast[float64](1)))
    js_set_prop(target, cast[Ptr[uint8]]("AT_TARGET"), 9, js_number(cast[float64](2)))
    js_set_prop(target, cast[Ptr[uint8]]("BUBBLING_PHASE"), 14, \
                js_number(cast[float64](3)))


# ASCII case-insensitive byte compare.
def _ascii_ci_eq(a: Ptr[uint8], an: int32, b: Ptr[uint8], bn: int32) -> int32:
    if an != bn:
        return 0
    i: int32 = 0
    while i < an:
        ca: uint8 = a[i]
        cb: uint8 = b[i]
        if ca >= 65 and ca <= 90:
            ca = ca + 32
        if cb >= 65 and cb <= 90:
            cb = cb + 32
        if ca != cb:
            return 0
        i = i + 1
    return 1


# Was the event constructor called WITHOUT `new` on the global (`Event("x")` /
# `window.Event("x")`)? Then `this` is the window, not a fresh instance, and
# writing the event's fields into it would scribble over the global object.
def _ev_this_is_global(v: int32) -> int32:
    if v == js_win or v == js_doc:
        return 1
    return 0


# ---- event-constructor dictionary readers -----------------------------------
# Per WebIDL a dictionary argument that is undefined OR null means "every member
# absent", and an ABSENT member takes the declared default — it is not read at
# all. Before this, the constructor read members straight off the argument, so
# `new Event("x", null)` threw "cannot read property 'bubbles' of null" (18 WPT
# subtests) and a supplied-but-undefined member clobbered the default.
def _evd_get(opt: int32, name: Ptr[uint8], n: int32) -> int32:
    if js_type_of(opt) != TAG_OBJ:
        return js_undefined()
    return js_get_prop(opt, name, cast[uint64](n))


def _evd_bool(opt: int32, name: Ptr[uint8], n: int32) -> int32:
    v: int32 = _evd_get(opt, name, n)
    if js_type_of(v) == TAG_UNDEF:
        return 0
    return js_to_bool(v)


def _evd_num(opt: int32, name: Ptr[uint8], n: int32) -> float64:
    v: int32 = _evd_get(opt, name, n)
    if js_type_of(v) == TAG_UNDEF:
        return 0.0
    return js_to_number(v)


def _evd_str(opt: int32, name: Ptr[uint8], n: int32) -> int32:
    v: int32 = _evd_get(opt, name, n)
    if js_type_of(v) == TAG_STR:
        return v
    if js_type_of(v) == TAG_UNDEF:
        return js_new_string(cast[Ptr[uint8]](""), 0)
    sp: Ptr[uint8] = js_to_display(v)
    return js_new_string(sp, cast[uint64](_cstr_len(sp)))


# An interface-typed dictionary member (UIEventInit.view, MouseEventInit /
# FocusEventInit.relatedTarget). Default null; a value of the WRONG type is a
# TypeError when `strict` — WPT asserts `new UIEvent("x", {view: 7})` throws.
def _evd_iface(opt: int32, name: Ptr[uint8], n: int32, strict: int32) -> int32:
    v: int32 = _evd_get(opt, name, n)
    t: int32 = js_type_of(v)
    if t == TAG_OBJ:
        return v
    if t == TAG_UNDEF or t == TAG_NULL:
        return js_null()
    if strict != 0:
        js_throw_type_error(cast[Ptr[uint8]]( \
            "Failed to construct event: member is not of the expected type"))
    return js_null()


# The four EventModifierInit booleans shared by MouseEvent / KeyboardEvent /
# WheelEvent. Written unconditionally so `"ctrlKey" in ev` is true even when the
# dictionary omitted them (the WPT check is `property in event`, not truthiness).
def _ev_modifiers(ev: int32, opt: int32):
    js_set_prop(ev, cast[Ptr[uint8]]("ctrlKey"), 7, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("ctrlKey"), 7)))
    js_set_prop(ev, cast[Ptr[uint8]]("shiftKey"), 8, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("shiftKey"), 8)))
    js_set_prop(ev, cast[Ptr[uint8]]("altKey"), 6, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("altKey"), 6)))
    js_set_prop(ev, cast[Ptr[uint8]]("metaKey"), 7, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("metaKey"), 7)))


# Does this flavor inherit UIEvent? (UIEvent itself, and every interface whose
# spec parent chain reaches it.)
def _ev_is_ui(flavor: int32) -> int32:
    if flavor == 2 or flavor == 3 or flavor == 4 or flavor == 6 or \
       flavor == 9 or flavor == 10 or flavor == 14 or flavor == 15:
        return 1
    return 0


# Does this flavor inherit MouseEvent? (MouseEvent, DragEvent, WheelEvent.)
def _ev_is_mouse(flavor: int32) -> int32:
    if flavor == 2 or flavor == 9 or flavor == 15:
        return 1
    return 0


def _make_event(flavor: int32) -> int32:
    # Initialise the RECEIVER when the call gave us one. `new Event(...)` and
    # `super(type, init)` from a `class X extends Event` constructor both arrive
    # with `this` already linked to the correct prototype. Minting a fresh
    # object instead — what this did before — dropped every field on the floor
    # for the subclass case (super() discards the return value), and branded
    # `new UIEvent()` with Event.prototype so `instanceof UIEvent` was false.
    ev: int32 = js_this()
    if js_type_of(ev) != TAG_OBJ or _ev_this_is_global(ev) != 0:
        ev = js_new_object_v()
        if flavor >= 0 and flavor < 16 and g_ev_proto[flavor] != 0:
            js_set_proto_v(ev, g_ev_proto[flavor])
    # type (arg0) — copied into a stable buffer first (js_str_ptr shares scratch).
    tn: int32 = 0
    if js_arg_count() >= 1:
        tn = _arg_bytes(0, &dom_idtmp[0], 256)
        if _is_undef_str(&dom_idtmp[0], tn) != 0:
            tn = 0
    opt: int32 = js_undefined()
    if js_arg_count() >= 2:
        opt = js_arg(1)
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(&dom_idtmp[0], cast[uint64](tn)))
    # ---- EventInit ----------------------------------------------------------
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("bubbles"), 7)))
    js_set_prop(ev, cast[Ptr[uint8]]("cancelable"), 10, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("cancelable"), 10)))
    js_set_prop(ev, cast[Ptr[uint8]]("composed"), 8, \
                js_bool(_evd_bool(opt, cast[Ptr[uint8]]("composed"), 8)))
    js_set_prop(ev, cast[Ptr[uint8]]("defaultPrevented"), 16, js_bool(0))
    # isTrusted is a readonly Event attribute, NOT a dictionary member: a
    # script-constructed event is always untrusted no matter what the init says.
    js_set_prop(ev, cast[Ptr[uint8]]("isTrusted"), 9, js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("target"), 6, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), 13, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("srcElement"), 10, js_null())
    js_set_prop(ev, cast[Ptr[uint8]]("eventPhase"), 10, js_number(cast[float64](0)))
    g_ev_ts_tick = g_ev_ts_tick + 1
    js_set_prop(ev, cast[Ptr[uint8]]("timeStamp"), 9, \
                js_number(cast[float64](g_ev_ts_tick) * 0.005))
    js_set_prop(ev, cast[Ptr[uint8]]("preventDefault"), 14, \
                js_new_native_fn(js_hbase + NID_PREVENT))
    js_set_prop(ev, cast[Ptr[uint8]]("stopPropagation"), 15, \
                js_new_native_fn(js_hbase + NID_STOPPROP))
    js_set_prop(ev, cast[Ptr[uint8]]("stopImmediatePropagation"), 24, \
                js_new_native_fn(js_hbase + NID_STOPIMMED))
    _event_constants(ev)
    # ---- UIEventInit (view, detail) -----------------------------------------
    if _ev_is_ui(flavor) != 0:
        js_set_prop(ev, cast[Ptr[uint8]]("view"), 4, \
                    _evd_iface(opt, cast[Ptr[uint8]]("view"), 4, 1))
        js_set_prop(ev, cast[Ptr[uint8]]("detail"), 6, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("detail"), 6)))
    else:
        # CustomEvent's detail is `any` with default null; plain Event keeps the
        # null the dispatcher has always seen here.
        js_set_prop(ev, cast[Ptr[uint8]]("detail"), 6, js_null())
        if flavor == 1:
            dv: int32 = _evd_get(opt, cast[Ptr[uint8]]("detail"), 6)
            if js_type_of(dv) != TAG_UNDEF:
                js_set_prop(ev, cast[Ptr[uint8]]("detail"), 6, dv)
    # ---- MouseEventInit -----------------------------------------------------
    if _ev_is_mouse(flavor) != 0:
        _ev_modifiers(ev, opt)
        js_set_prop(ev, cast[Ptr[uint8]]("screenX"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("screenX"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("screenY"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("screenY"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("clientX"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("clientX"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("clientY"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("clientY"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("button"), 6, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("button"), 6)))
        js_set_prop(ev, cast[Ptr[uint8]]("buttons"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("buttons"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("relatedTarget"), 13, \
                    _evd_iface(opt, cast[Ptr[uint8]]("relatedTarget"), 13, 0))
    # ---- WheelEventInit -----------------------------------------------------
    if flavor == 15:
        js_set_prop(ev, cast[Ptr[uint8]]("deltaX"), 6, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("deltaX"), 6)))
        js_set_prop(ev, cast[Ptr[uint8]]("deltaY"), 6, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("deltaY"), 6)))
        js_set_prop(ev, cast[Ptr[uint8]]("deltaZ"), 6, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("deltaZ"), 6)))
        js_set_prop(ev, cast[Ptr[uint8]]("deltaMode"), 9, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("deltaMode"), 9)))
    # ---- KeyboardEventInit --------------------------------------------------
    if flavor == 3:
        _ev_modifiers(ev, opt)
        js_set_prop(ev, cast[Ptr[uint8]]("key"), 3, \
                    _evd_str(opt, cast[Ptr[uint8]]("key"), 3))
        js_set_prop(ev, cast[Ptr[uint8]]("code"), 4, \
                    _evd_str(opt, cast[Ptr[uint8]]("code"), 4))
        js_set_prop(ev, cast[Ptr[uint8]]("location"), 8, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("location"), 8)))
        js_set_prop(ev, cast[Ptr[uint8]]("repeat"), 6, \
                    js_bool(_evd_bool(opt, cast[Ptr[uint8]]("repeat"), 6)))
        js_set_prop(ev, cast[Ptr[uint8]]("isComposing"), 11, \
                    js_bool(_evd_bool(opt, cast[Ptr[uint8]]("isComposing"), 11)))
        js_set_prop(ev, cast[Ptr[uint8]]("charCode"), 8, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("charCode"), 8)))
        js_set_prop(ev, cast[Ptr[uint8]]("keyCode"), 7, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("keyCode"), 7)))
        js_set_prop(ev, cast[Ptr[uint8]]("which"), 5, \
                    js_number(_evd_num(opt, cast[Ptr[uint8]]("which"), 5)))
    # ---- FocusEventInit -----------------------------------------------------
    if flavor == 10:
        js_set_prop(ev, cast[Ptr[uint8]]("relatedTarget"), 13, \
                    _evd_iface(opt, cast[Ptr[uint8]]("relatedTarget"), 13, 0))
    # ---- CompositionEventInit / TextEvent -----------------------------------
    if flavor == 6 or flavor == 14:
        js_set_prop(ev, cast[Ptr[uint8]]("data"), 4, \
                    _evd_str(opt, cast[Ptr[uint8]]("data"), 4))
    return ev


# `new Image()` / `new Image(w, h)` -> a minimal HTMLImageElement stub. Real
# pages use this for preloading + analytics beacons (assign .src to a URL). We
# do not fetch it (Plan 9-shape: no side-channel loads), but the object must
# exist so scripts that construct one don't throw "Image is not defined".
# Carries the settable src/width/height/complete fields and a no-op
# addEventListener so listener wiring (onload/onerror) does not fault.
def _make_image() -> int32:
    img: int32 = js_new_object_v()
    js_set_prop(img, cast[Ptr[uint8]]("src"), 3, \
                js_new_string(cast[Ptr[uint8]](""), 0))
    js_set_prop(img, cast[Ptr[uint8]]("alt"), 3, \
                js_new_string(cast[Ptr[uint8]](""), 0))
    w: float64 = 0.0
    h: float64 = 0.0
    if js_arg_count() >= 1:
        w = js_to_number(js_arg(0))
    if js_arg_count() >= 2:
        h = js_to_number(js_arg(1))
    js_set_prop(img, cast[Ptr[uint8]]("width"), 5, js_number(w))
    js_set_prop(img, cast[Ptr[uint8]]("height"), 6, js_number(h))
    js_set_prop(img, cast[Ptr[uint8]]("naturalWidth"), 12, js_number(cast[float64](0)))
    js_set_prop(img, cast[Ptr[uint8]]("naturalHeight"), 13, js_number(cast[float64](0)))
    js_set_prop(img, cast[Ptr[uint8]]("complete"), 8, js_bool(0))
    js_set_prop(img, cast[Ptr[uint8]]("onload"), 6, js_null())
    js_set_prop(img, cast[Ptr[uint8]]("onerror"), 7, js_null())
    js_set_prop(img, cast[Ptr[uint8]]("addEventListener"), 16, \
                js_new_native_fn(js_hbase + NID_ADDEVT))
    js_set_prop(img, cast[Ptr[uint8]]("removeEventListener"), 19, \
                js_new_native_fn(js_hbase + NID_REMEVT))
    return img


# Programmatically set a form field's value (input/textarea/select) by element
# id, then fire its oninput + onchange handlers and re-lay-out so the change
# renders. The pointer-free equivalent of a user typing into a field. Returns 1
# on success (JS context live + element found).
# The live JS object backing an EVENT-TARGET index (he_dom_evt_index): the
# dom_obj slot of a source-anchored element, or the cre_obj slot of a
# script-created node (CRE_IDX_BASE + cre id). -1 when the index names nothing
# live. Lets a valued interaction (setval/check) reach a node React CREATED, the
# same way he_dom_click_index does — _lookup_or_register only sees source markup,
# so a React-rendered <input> (every input in a real SPA) was invisible to it.
def _evt_target_obj(idx: int32) -> int32:
    if idx < 0:
        return -1
    if idx >= CRE_IDX_BASE:
        cid: int32 = idx - CRE_IDX_BASE
        if cid >= cre_n or cre_gone[cid] != 0:
            return -1
        return cre_obj[cid]
    if idx >= dom_n:
        return -1
    return dom_obj[idx]


# Dispatch a BUBBLING value-change event (type typep[0..typen)) at an event-target
# index — created node OR source element — through the full three-phase core, so
# a delegated ancestor listener fires. React attaches its 'input'/'change'
# listeners on the ROOT CONTAINER (not the target input), reachable ONLY by
# bubbling; firing target-phase-only left React's onChange dead for every
# controlled input. Mirrors he_dom_click_index's created-vs-source branch.
def _fire_value_evt(idx: int32, typep: Ptr[uint8], typen: int32) -> int32:
    ev: int32 = _new_event_obj()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, js_new_string(typep, \
                cast[uint64](typen)))
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), 7, js_bool(1))
    if idx >= CRE_IDX_BASE:
        cid: int32 = idx - CRE_IDX_BASE
        if cid >= cre_n or cre_gone[cid] != 0:
            return 0
        return _obj_dispatch(cre_obj[cid], typep, typen, ev, 1)
    if idx < 0 or idx >= dom_n:
        return 0
    return _dispatch_event(idx, _evt_std_kind(typep, typen), ev)


def he_dom_set_value(idp: Ptr[uint8], idn: int32, valp: Ptr[uint8], \
                     valn: int32) -> int32:
    if js_ctx_live == 0:
        return 0
    idx: int32 = he_dom_evt_index(idp, idn)
    obj: int32 = _evt_target_obj(idx)
    if obj < 0:
        return 0
    js_set_prop(obj, cast[Ptr[uint8]]("value"), 5, \
                js_new_string(valp, cast[uint64](valn)))
    _fire_value_evt(idx, cast[Ptr[uint8]]("input"), 5)                   # oninput
    _fire_value_evt(idx, cast[Ptr[uint8]]("change"), 6)                 # onchange
    _after_event_settle()
    return 1


# Radio-group exclusivity: `keep` is a radio that just became checked; uncheck
# every OTHER radio sharing its `name`. Scans the whole source so all group
# members are registered (and thus re-rendered) even if the page never named
# them from JS. A no-op for non-radios or unnamed radios.
def _radio_enforce_group(keep: int32):
    kobj: int32 = dom_obj[keep]
    ktv: int32 = js_get_prop(kobj, cast[Ptr[uint8]]("type"), 4)
    ktp: Ptr[uint8] = js_str_ptr(ktv)
    if _bytes_eq(ktp, _cstr_len(ktp), cast[Ptr[uint8]]("radio"), 5) == 0:
        return
    knv: int32 = js_get_prop(kobj, cast[Ptr[uint8]]("name"), 4)
    knp: Ptr[uint8] = js_str_ptr(knv)
    knn: int32 = _cstr_len(knp)
    if knn == 0 or _is_undef_str(knp, knn) != 0:
        return
    # copy the name out of the shared JS scratch before further js_get_prop calls.
    kk: int32 = 0
    while kk < knn and kk < 127:
        g_radioname[kk] = knp[kk]
        kk = kk + 1
    g_radioname_len = kk
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("input")) != 0:
            _scan_start_tag(i)
            skip_to: uint64 = g_close_end
            ei: int32 = _dom_lookup_anchor(cast[int32](g_el_lt))
            if ei < 0:
                _dom_register_el()
                ei = _dom_lookup_anchor(cast[int32](g_el_lt))
            if ei >= 0 and ei != keep:
                eo: int32 = dom_obj[ei]
                etv: int32 = js_get_prop(eo, cast[Ptr[uint8]]("type"), 4)
                etp: Ptr[uint8] = js_str_ptr(etv)
                if _bytes_eq(etp, _cstr_len(etp), cast[Ptr[uint8]]("radio"), 5) != 0:
                    env: int32 = js_get_prop(eo, cast[Ptr[uint8]]("name"), 4)
                    enp: Ptr[uint8] = js_str_ptr(env)
                    if _bytes_eq(enp, _cstr_len(enp), &g_radioname[0], \
                                 g_radioname_len) != 0:
                        js_set_prop(eo, cast[Ptr[uint8]]("checked"), 7, js_bool(0))
            i = skip_to
            continue
        i = i + 1


# Set a checkbox/radio's checked state by id, fire oninput + onchange, re-lay.
def he_dom_set_checked(idp: Ptr[uint8], idn: int32, checked: int32) -> int32:
    if js_ctx_live == 0:
        return 0
    idx: int32 = he_dom_evt_index(idp, idn)
    obj: int32 = _evt_target_obj(idx)
    if obj < 0:
        return 0
    js_set_prop(obj, cast[Ptr[uint8]]("checked"), 7, js_bool(checked))
    if checked != 0 and idx < CRE_IDX_BASE:
        _radio_enforce_group(idx)
    _fire_value_evt(idx, cast[Ptr[uint8]]("input"), 5)
    _fire_value_evt(idx, cast[Ptr[uint8]]("change"), 6)
    _after_event_settle()
    return 1


# ---- form submission (GET query-string / POST request body) --------
def _nav_putc(c: uint8):
    if dom_nav_len < 2047:
        dom_nav_buf[dom_nav_len] = c
        dom_nav_len = dom_nav_len + 1


# Append one byte to whichever serialization target is active: the POST request
# body (dom_body_buf) when post != 0, else the GET nav/query buffer.
def _sfld_putc(post: int32, c: uint8):
    if post != 0:
        if dom_body_len < 2047:
            dom_body_buf[dom_body_len] = c
            dom_body_len = dom_body_len + 1
    else:
        _nav_putc(c)


# Append `p[0..n)` URL-form-encoded (space -> '+', unreserved kept, else '_')
# to the active target (GET query or POST body).
def _sfld_encoded(post: int32, p: Ptr[uint8], n: int32):
    i: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c == 32:
            _sfld_putc(post, 43)                         # '+'
        elif (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or \
             (c >= 48 and c <= 57) or c == 45 or c == 46 or c == 95:
            _sfld_putc(post, c)
        else:
            _sfld_putc(post, 95)                         # '_'
        i = i + 1


# Append `p[0..n)` URL-form-encoded to the GET nav buffer (kept for callers that
# encode directly into the query string).
def _nav_encoded(p: Ptr[uint8], n: int32):
    _sfld_encoded(0, p, n)


# Does the form at `fi` request method=POST? (case-insensitive `method` attr).
def _form_is_post(fi: int32) -> int32:
    if dom_anchor[fi] < 0:
        return 0
    ts: uint64 = cast[uint64](dom_anchor[fi])
    te: uint64 = cast[uint64](dom_cstart[fi])
    if _hx_find_attr(ts, te, cast[Ptr[uint8]]("method")) == 0:
        return 0
    if g_attr_end - g_attr_start != 4:
        return 0
    if _hx_lower(src_ptr[g_attr_start]) == 112 and \
       _hx_lower(src_ptr[g_attr_start + 1]) == 111 and \
       _hx_lower(src_ptr[g_attr_start + 2]) == 115 and \
       _hx_lower(src_ptr[g_attr_start + 3]) == 116:        # "post"
        return 1
    return 0


# Serialize the form at dom index `fi`. For method=GET dom_nav_buf becomes
# "action?a=1&b=2" (dom_nav_method 0). For method=POST dom_nav_buf carries the
# bare action target and the application/x-www-form-urlencoded body "a=1&b=2"
# lands in dom_body_buf (dom_nav_method 1) — enctype is urlencoded (the default;
# multipart/FormData is not yet modelled). Each field's value/checked is read
# live from its registered JS object.
def _serialize_form(fi: int32):
    dom_nav_len = 0
    dom_body_len = 0
    post: int32 = _form_is_post(fi)
    dom_nav_method = post
    # Prepend the form's action target (raw, un-encoded — a path keeps its '/')
    # so a search submits to "/search?q=cats", not the current page's "?q=cats".
    # Empty/absent action serializes to a bare "?..." (submit to current URL,
    # which is the HTML default).
    ats: uint64 = cast[uint64](dom_anchor[fi])
    ate: uint64 = cast[uint64](dom_cstart[fi])
    act_has_q: int32 = 0
    if dom_anchor[fi] >= 0 and \
       _hx_find_attr(ats, ate, cast[Ptr[uint8]]("action")) != 0 and \
       g_attr_end > g_attr_start:
        ap: uint64 = g_attr_start
        while ap < g_attr_end:
            ac: uint8 = src_ptr[ap]
            if ac == 63:                                 # action already has '?'
                act_has_q = 1
            _nav_putc(ac)
            ap = ap + 1
    # GET separates the query from the path in the nav buffer: '?' for the first
    # param, '&' when the action already carried a query string. POST leaves the
    # nav buffer at the bare action and builds the body separately.
    if post == 0:
        if act_has_q != 0:
            _nav_putc(38)                                # '&'
        else:
            _nav_putc(63)                                # '?'
    first: int32 = 1
    cs: uint64 = cast[uint64](dom_cstart[fi])
    ce: uint64 = cast[uint64](dom_cend[fi])
    i: uint64 = cs
    while i < ce:
        if src_ptr[i] == 60 and i + 1 < ce and \
           (_tagname_is(i + 1, cast[Ptr[uint8]]("input")) != 0 or \
            _tagname_is(i + 1, cast[Ptr[uint8]]("select")) != 0 or \
            _tagname_is(i + 1, cast[Ptr[uint8]]("textarea")) != 0):
            _scan_start_tag(i)
            skip_to: uint64 = g_close_end
            ei: int32 = _dom_lookup_anchor(cast[int32](g_el_lt))
            if ei < 0:
                _dom_register_el()
                ei = _dom_lookup_anchor(cast[int32](g_el_lt))
            if ei >= 0:
                _serialize_field(ei, &first, post)
            i = skip_to
            continue
        i = i + 1
    dom_nav_present = 1


# Emit one field's name=value pair into the active target (GET query / POST body)
# when it carries a name and is a successful control. *first tracks whether a '&'
# separator is needed. `post` selects the body vs the query buffer.
def _serialize_field(ei: int32, first: Ptr[int32], post: int32):
    obj: int32 = dom_obj[ei]
    nmv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("name"), 4)
    np: Ptr[uint8] = js_str_ptr(nmv)
    nn: int32 = _cstr_len(np)
    if nn == 0 or _is_undef_str(np, nn) != 0:
        return
    # copy the name out of the shared scratch before reading other props.
    kk: int32 = 0
    while kk < nn and kk < 127:
        g_nmtmp[kk] = np[kk]
        kk = kk + 1
    nn2: int32 = kk
    # a checkbox/radio contributes only when checked.
    if dom_origchecked[ei] >= 0:
        ckv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("checked"), 7)
        if js_to_bool(ckv) == 0:
            return
    # submit/reset/button inputs are not serialized.
    tyv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("type"), 4)
    typ: Ptr[uint8] = js_str_ptr(tyv)
    tyn: int32 = _cstr_len(typ)
    if _bytes_eq(typ, tyn, cast[Ptr[uint8]]("submit"), 6) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("reset"), 5) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("button"), 6) != 0:
        return
    if first[0] == 0:
        _sfld_putc(post, 38)                             # '&'
    first[0] = 0
    _sfld_encoded(post, &g_nmtmp[0], nn2)
    _sfld_putc(post, 61)                                 # '='
    vv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("value"), 5)
    vp: Ptr[uint8] = js_str_ptr(vv)
    vn: int32 = _cstr_len(vp)
    if _is_undef_str(vp, vn) != 0:
        vn = 0
    _sfld_encoded(post, vp, vn)


# Shared submit core: dispatch a cancelable `submit` event at form `idx` that
# BUBBLES to ancestor listeners (round 8 dispatch). If no handler called
# preventDefault() AND the form passes Constraint Validation (unless it carries
# `novalidate`), serialize the named controls (GET query / POST body) into the
# nav buffer. An invalid form blocks the navigation, exactly like a real browser.
# Used by the host entry points AND the JS form.submit() method.
def _do_submit(idx: int32):
    ev: int32 = _new_event_obj()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), 4, \
                js_new_string(cast[Ptr[uint8]]("submit"), 6))
    _dispatch_event(idx, 3, ev)                          # resets g_prevent_default
    _dom_readback()
    _js_capture_console()
    if g_prevent_default == 0:
        novalid: int32 = 0
        if dom_kind[idx] == 5:
            nts: uint64 = cast[uint64](dom_ns[idx])
            nte: uint64 = cast[uint64](dom_cstart[idx]) - 1
            if hx_has_bool_attr(nts, nte, cast[Ptr[uint8]]("novalidate")) != 0:
                novalid = 1
        if novalid != 0 or dom_kind[idx] != 5 or _form_check_all(idx) != 0:
            _serialize_form(idx)
    _relayout()


def he_dom_submit(idp: Ptr[uint8], idn: int32) -> int32:
    if js_ctx_live == 0:
        return 0
    idx: int32 = _lookup_or_register(idp, idn)
    if idx < 0:
        return 0
    _do_submit(idx)
    return 1


def he_nav_ptr() -> Ptr[uint8]:
    dom_nav_buf[dom_nav_len] = 0
    return &dom_nav_buf[0]


def he_nav_len() -> uint64:
    return cast[uint64](dom_nav_len)


def he_nav_present() -> int32:
    return dom_nav_present


# The submit method of the pending navigation: 0 = GET (target is he_nav_ptr with
# its query string), 1 = POST (target is he_nav_ptr, body is he_nav_body_ptr with
# Content-Type application/x-www-form-urlencoded).
def he_nav_method() -> int32:
    return dom_nav_method


# The POST request body ("a=1&b=2"), NUL-terminated. Empty for a GET submit.
def he_nav_body_ptr() -> Ptr[uint8]:
    dom_body_buf[dom_body_len] = 0
    return &dom_body_buf[0]


def he_nav_body_len() -> uint64:
    return cast[uint64](dom_body_len)


# Clear a consumed navigation request so the next poll doesn't re-fire it. The
# native front-end calls this immediately after it has read he_nav_ptr/len and
# started the fetch, so a stale request can't loop.
def he_nav_clear():
    dom_nav_present = 0
    dom_nav_len = 0
    dom_nav_method = 0
    dom_body_len = 0


# ---- native pointer/keyboard field interaction (index-based) --------
# The native front-end hit-tests a pointer click to a DOM element index (via the
# synthetic "#__evt_N" link wrap + he_link_evt_index), then asks these whether
# that element is a typing target or a submit control, edits it per-keystroke,
# and submits its enclosing form on Enter / a submit-button click.

# Resolve an element id to its DOM index (registering on demand), or -1. The
# native front-end addresses fields by the index its pointer hit-test yields;
# the host gate uses this to drive the same index-based chain from an id.
def he_dom_id_index(idp: Ptr[uint8], idn: int32) -> int32:
    if js_ctx_live == 0:
        return -1
    return _lookup_or_register(idp, idn)


# Is element `idx` a text-typing control (a textarea, or an <input> that is not
# a checkbox/radio/submit/button/reset/hidden)? Requires a live JS context (the
# element's `type` is read from its DOM object).
def he_dom_is_textfield(idx: int32) -> int32:
    if js_ctx_live == 0 or idx < 0 or idx >= dom_n:
        return 0
    if dom_kind[idx] == 2:                                # <textarea>
        return 1
    if dom_kind[idx] != 1:                                # not <input>
        return 0
    if dom_origchecked[idx] >= 0:                         # checkbox / radio
        return 0
    tyv: int32 = js_get_prop(dom_obj[idx], cast[Ptr[uint8]]("type"), 4)
    typ: Ptr[uint8] = js_str_ptr(tyv)
    tyn: int32 = _cstr_len(typ)
    if _bytes_eq(typ, tyn, cast[Ptr[uint8]]("submit"), 6) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("button"), 6) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("reset"), 5) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("hidden"), 6) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("checkbox"), 8) != 0 or \
       _bytes_eq(typ, tyn, cast[Ptr[uint8]]("radio"), 5) != 0:
        return 0
    return 1


# Is element `idx` a submit control (<input type=submit> or a <button>, whose
# default type is submit)? Such a click submits the enclosing form.
def he_dom_is_submit(idx: int32) -> int32:
    if js_ctx_live == 0 or idx < 0 or idx >= dom_n:
        return 0
    if dom_kind[idx] == 4:                                # <button>
        return 1
    if dom_kind[idx] != 1:
        return 0
    tyv: int32 = js_get_prop(dom_obj[idx], cast[Ptr[uint8]]("type"), 4)
    typ: Ptr[uint8] = js_str_ptr(tyv)
    tyn: int32 = _cstr_len(typ)
    if _bytes_eq(typ, tyn, cast[Ptr[uint8]]("submit"), 6) != 0:
        return 1
    return 0


# The dom index of the <form> enclosing element `idx` (the innermost form whose
# inner-content span contains the element's source anchor), or -1. Used to
# submit the form when Enter is pressed in a field or a submit button is clicked.
def he_dom_field_form(idx: int32) -> int32:
    if idx < 0 or idx >= dom_n:
        return -1
    a: int32 = dom_anchor[idx]
    if a < 0:
        return -1
    best: int32 = -1
    f: int32 = 0
    while f < dom_n:
        if dom_kind[f] == 5 and dom_cstart[f] <= a and a < dom_cend[f]:
            best = f                                      # innermost = last match
        f = f + 1
    return best


# Set element `idx`'s value to valp[0..valn) and fire its oninput handler, then
# re-lay-out so the typed text renders in the field box. The per-keystroke
# equivalent of he_dom_set_value but addressed by index (the front-end already
# has the hit-tested element index; no id string needed). onchange fires on
# submit/blur, not on every keystroke, so only oninput runs here.
def he_dom_set_value_index(idx: int32, valp: Ptr[uint8], valn: int32) -> int32:
    if js_ctx_live == 0 or idx < 0 or idx >= dom_n:
        return 0
    js_set_prop(dom_obj[idx], cast[Ptr[uint8]]("value"), 5, \
                js_new_string(valp, cast[uint64](valn)))
    _fire_handler(idx, 1, -1, EPHASE_TARGET)                             # oninput
    _dom_readback()
    _js_capture_console()
    _relayout()
    return 1


# Copy element `idx`'s current value into out[0..cap) (NUL-terminated); return
# its length. The front-end seeds its per-field edit buffer from this when a
# field is focused so pre-filled text isn't lost on the first keystroke.
def he_dom_get_value(idx: int32, out: Ptr[uint8], cap: int32) -> int32:
    if js_ctx_live == 0 or idx < 0 or idx >= dom_n or cap <= 0:
        out[0] = 0
        return 0
    vv: int32 = js_get_prop(dom_obj[idx], cast[Ptr[uint8]]("value"), 5)
    vp: Ptr[uint8] = js_str_ptr(vv)
    vn: int32 = _cstr_len(vp)
    if _is_undef_str(vp, vn) != 0:
        vn = 0
    k: int32 = 0
    while k < vn and k < cap - 1:
        out[k] = vp[k]
        k = k + 1
    out[k] = 0
    return k


# Submit the form at dom index `idx` (fire onsubmit; GET-serialize into the nav
# buffer if not preventDefault'd). Index-based twin of he_dom_submit.
def he_dom_submit_index(idx: int32) -> int32:
    if js_ctx_live == 0 or idx < 0 or idx >= dom_n:
        return 0
    _do_submit(idx)
    return 1


# Dispatch a click to the element with id idp[0..idn). Returns 1 if a handler
# ran, 0 otherwise. This is the programmatic, pointer-free dispatch used by the
# host gate AND (via he_dom_click_index) the native pointer path.
def he_dom_click(idp: Ptr[uint8], idn: int32) -> int32:
    # Register the target on demand so an element whose only handler is an
    # inline onclick="" (never touched by a <script>) still gets its handler
    # captured before dispatch.
    if js_ctx_live == 0:
        return 0
    return he_dom_click_index(he_dom_evt_index(idp, idn))


# Resolve an element id to an EVENT-TARGET index: a source-anchored element's
# dom index, or CRE_IDX_BASE + cre id for a node script built after load
# (createElement/appendChild, innerHTML, a framework re-render). Returns -1 when
# the id names nothing. The source registry is consulted first so an id that
# exists in the markup keeps its source identity.
def he_dom_evt_index(idp: Ptr[uint8], idn: int32) -> int32:
    if js_ctx_live == 0:
        return -1
    e: int32 = _lookup_or_register(idp, idn)
    if e >= 0:
        return e
    co: int32 = _cre_find_by_id(idp, idn)
    if co < 0:
        return -1
    cid: int32 = _find_cre_by_obj(co)
    if cid < 0:
        return -1
    return CRE_IDX_BASE + cid


# Does the DOM element at `idx` carry a click handler? Either an attribute-slot
# handler (inline onclick="" / el.onclick = fn) OR a live addEventListener
# registration — the latter lives in the evl_ table, never in the attribute slot,
# so checking only the slot left every addEventListener-only element out of the
# pointer-clickable set.
def _el_has_handler(idx: int32) -> int32:
    if dom_onclick_fn[idx] >= 0 or dom_onclick_src[idx] >= 0:
        return 1
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_el[li] == idx:
            if evl_kind[li] == 0:
                return 1
            if evl_kind[li] == GEN_KIND and \
               _is_pointer_type(&evt_tybuf[evl_type_off[li]], \
                                evl_type_len[li]) != 0:
                return 1
        li = li + 1
    return 0


# Native front-ends (he_click_links) make in-page form controls pointer-
# reachable by wrapping each in a synthetic "#__evt_N" link (the SAME hit-test
# path as click-handler elements), so a pointer click resolves to the control's
# DOM index. A "wrappable field" is a text-typing control or a submit button.
def _is_wrappable_field(idx: int32) -> int32:
    if he_click_links == 0:
        return 0
    if he_dom_is_textfield(idx) != 0:
        return 1
    if he_dom_is_submit(idx) != 0:
        return 1
    return 0


# Count elements the native rewrite must wrap in a "#__evt_N" link: click-
# handler elements AND focusable/submit form controls. Non-zero forces the
# rewrite path even when no script mutated the DOM (a plain form still needs its
# fields to be pointer-reachable). Host renders (he_click_links==0) return 0.
def _n_wrappable() -> int32:
    if he_click_links == 0:
        return 0
    c: int32 = 0
    i: int32 = 0
    while i < dom_n:
        if _el_has_handler(i) != 0 or _is_wrappable_field(i) != 0:
            c = c + 1
        i = i + 1
    return c


# Does the source contain a <form> (so a script-less page still warrants a live
# JS context + form registration for native pointer/type/submit)?
def _page_has_form() -> int32:
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("form")) != 0:
            return 1
        i = i + 1
    return 0


# If link `lid`'s href is the synthetic "#__evt_N" the native rewrite injects
# around a click-handler element, return the DOM record index N; else -1. The
# native front-end calls this on a hit-tested link to route a pointer click to
# he_dom_click_index instead of navigating.
def he_link_evt_index(lid: int32) -> int32:
    if lid < 0 or cast[uint64](lid) >= n_links:
        return -1
    o: uint64 = cast[uint64](link_off[lid])
    l: int32 = link_len[lid]
    pfx: Ptr[uint8] = cast[Ptr[uint8]]("#__evt_")
    k: int32 = 0
    while k < 7:
        if k >= l or link_href_buf[o + cast[uint64](k)] != pfx[k]:
            return -1
        k = k + 1
    v: int32 = 0
    while k < l:
        c: uint8 = link_href_buf[o + cast[uint64](k)]
        if c < 48 or c > 57:
            break
        v = v * 10 + cast[int32](c) - 48
        k = k + 1
    return v


# Native front-ends set this to 1 so the rewrite wraps click-handler elements
# in a synthetic "#__evt_N" link, reusing the existing pointer link hit-test
# for event dispatch. Host/default stays 0 so its render is byte-for-byte the
# same as with no handlers (keeps the host gate output stable).
def he_set_click_links(v: int32):
    he_click_links = v


# Register the ES-module resolver the browser uses to fetch `<script type=module>`
# dependencies (import specifiers). The embedder (native hambrowse via http9, or
# a host test harness reading files) supplies the source bytes; the engine opens
# no sockets itself. Registered once before layout — js_init preserves it across
# per-page resets, so inline modules can import through it.
def he_set_module_resolver(fn: Fn[Ptr[uint8], int32, Ptr[int32], Ptr[uint8]]):
    js_set_module_resolver(fn)


# Format a packed 0xRRGGBB into a "#rrggbb\0" string in `out` (>= 8 bytes).
def he_rgb_hex(rgb: int32, out: Ptr[uint8]):
    out[0] = 35                                       # '#'
    hexd: Ptr[uint8] = cast[Ptr[uint8]]("0123456789abcdef")
    k: int32 = 0
    while k < 6:
        shift: int32 = (5 - k) * 4
        nib: int32 = (rgb / (1 << shift)) & 15
        out[1 + k] = hexd[nib]
        k = k + 1
    out[7] = 0


# Resolve segment `si` to a "#rrggbb\0" colour string in the caller's buffer
# (>= 8 bytes). Explicit CSS colour wins; otherwise the role palette.
def he_seg_color_hex(si: uint64, out: Ptr[uint8]):
    rgb: int32 = seg_rgb[si]
    if rgb < 0:
        rgb = _palette_rgb(seg_color[si])
    he_rgb_hex(rgb, out)


# ---- accessors for the graphical (htmlpaint) pixel backend -----------
# The pixel renderer (lib/htmlpaint.ad, driven by user/hambrowse*_gfx) reads
# the laid-out segment table through these instead of reaching into globals,
# so the same engine feeds both the legacy monospace-grid dump and the new
# proportional-font pixel paint.
def he_n_segs() -> uint64:
    return n_segs


def he_total_rows() -> uint64:
    return total_rows


def he_page_width() -> int32:
    return bw


# Page-level background colour (0xRRGGBB) from <body>/<html>, or -1 for the
# default white. The pixel renderer clears the whole canvas to this (gap #3).
def he_page_bg() -> int32:
    return g_page_bg


def he_seg_line(si: uint64) -> int32:
    return seg_line[si]


# text-align of row `r` (0 none/left, 2 center, 3 right) — lets the pixel
# renderer re-centre a row using REAL proportional widths (the engine centred it
# on the 8px char grid, which mis-places large-font lines).
def he_row_align(r: uint64) -> int32:
    if r >= 12000:
        return 0
    return cast[int32](row_align[r])


def he_seg_x(si: uint64) -> int32:
    return seg_x[si]


def he_seg_off(si: uint64) -> int32:
    return seg_off[si]


def he_seg_len(si: uint64) -> int32:
    return seg_len[si]


def he_seg_text_ptr() -> Ptr[uint8]:
    return &seg_text_buf[0]


def he_seg_face(si: uint64) -> uint8:
    return seg_face[si]


def he_seg_gridx(si: uint64) -> int32:
    return cast[int32](seg_gridx[si])


def he_seg_cellx(si: uint64) -> int32:
    return cast[int32](seg_cellx[si])


# CSS font-size (px) for this segment, or 0 = use the face default.
def he_seg_pxsize(si: uint64) -> int32:
    return seg_pxsize[si]


# CSS line-height resolved to PIXELS (the line-box pitch) for this segment, or
# 0 = use the renderer's default vertical rhythm.
def he_seg_lineh(si: uint64) -> int32:
    return seg_lineh[si]


def he_seg_bold(si: uint64) -> int32:
    return cast[int32](seg_bold[si])


def he_seg_uline(si: uint64) -> int32:
    return cast[int32](seg_uline[si])


# Signed baseline offset (px): <0 raises (<sup>), >0 lowers (<sub>), 0 normal.
def he_seg_yoff(si: uint64) -> int32:
    return seg_yoff[si]


# 1 if segment si carries a line-through (<s>/<del>/<strike>).
def he_seg_strike(si: uint64) -> int32:
    return cast[int32](seg_strike[si])


# 1 if segment si is italic (<em>/<i> or CSS font-style:italic) and should be
# painted as a FAUX-OBLIQUE (horizontal shear of the upright bitmap glyphs).
def he_seg_italic(si: uint64) -> int32:
    return cast[int32](seg_italic[si])


def he_seg_link(si: uint64) -> int32:
    return seg_link[si]


def he_seg_bg(si: uint64) -> int32:
    return seg_bg[si]


# 1 if this run's background is already painted by a z-sorted block fill (a
# positioned box): the paint pass skips the redundant per-run seg_bg strip.
def he_seg_bgcov(si: uint64) -> int32:
    return cast[int32](seg_bgcov[si])


# 1 = segment si is a text-like <input> field (draw a real bordered box); 0 = no.
def he_seg_field(si: uint64) -> int32:
    return cast[int32](seg_field[si])


# For a seg_field segment, the count of real content chars after the '[' (the
# value / placeholder / masked '*' run) the pixel renderer should draw.
def he_seg_fieldlen(si: uint64) -> int32:
    return seg_fieldlen[si]


# For a checkbox/radio segment (seg_field 3/4), the resolved CSS accent-color
# (0xRRGGBB) or -1 to use the UA default accent blue.
def he_seg_accent(si: uint64) -> int32:
    return seg_accent[si]


# For a form-control segment (seg_field 1/2), 1 = CSS `appearance:none` is in
# effect (the painter suppresses the default field/button chrome), else 0.
def he_seg_appear(si: uint64) -> int32:
    return cast[int32](seg_appear[si])


# For a form-control segment (seg_field 1/2), the control's CSS `height` in whole
# text rows (>=1), or 0 for the default single-row height.
def he_seg_ctrlrows(si: uint64) -> int32:
    return seg_ctrlrows[si]


# For a push-button segment (seg_field 2), the CSS border COLOUR (0xRRGGBB), or
# -1 for the UA default grey. The painter strokes the button box in this colour.
def he_seg_btnbord(si: uint64) -> int32:
    return seg_btnbord[si]


# For a push-button segment (seg_field 2), the CSS border-RADIUS in px, or -1 for
# the UA default (3px). The painter rounds the button box corners by this amount.
def he_seg_btnrad(si: uint64) -> int32:
    return seg_btnrad[si]


# Effective 0xRRGGBB for segment si (explicit CSS colour, else role palette).
def he_seg_rgb(si: uint64) -> int32:
    rgb: int32 = seg_rgb[si]
    if rgb < 0:
        rgb = _palette_rgb(seg_color[si])
    return rgb


def he_row_rule(r: uint64) -> uint8:
    return row_rule[r]


# Real pixel height a lone heading-margin blank row should render at (0 = use the
# default body line height). Lets the pixel renderer draw a sub-row heading margin
# (h2{margin-bottom:12px}) at its true CSS px instead of a full ~19px grid row.
def he_row_mgap(r: uint64) -> int32:
    return row_mgap[r]


# ---- explicit-height pixel pins (see hpin_* in lib/web/layout/box.ad) -----
# A sized box's grid-row span plus the PIXEL height that span must total. The
# pixel renderer reconciles the two, because only it knows a row's real pitch.
def he_n_hpins() -> int32:
    return n_hpins


def he_hpin_r0(i: int32) -> int32:
    return hpin_r0[i]


def he_hpin_r1(i: int32) -> int32:
    return hpin_r1[i]


def he_hpin_px(i: int32) -> int32:
    return hpin_px[i]


# 0 = exact (`height`), 1 = at least (`min-height`), 2 = at most (`max-height`).
def he_hpin_kind(i: int32) -> int32:
    return hpin_kind[i]


# ---- <img> segment + src-registry accessors -------------------------
# he_seg_img: decoded-image slot for segment si, -1 = text seg, -2 = broken.
def he_seg_img(si: uint64) -> int32:
    return seg_img[si]


def he_seg_imgw(si: uint64) -> int32:
    return seg_imgw[si]


def he_seg_imgh(si: uint64) -> int32:
    return seg_imgh[si]


# 1 if segment si is ASCII box-art (border glyphs). The pixel renderer skips
# these and strokes real rectangles from the border-box registry instead.
def he_seg_boxart(si: uint64) -> int32:
    return cast[int32](seg_boxart[si])


# 1 if segment si is an unordered-list bullet marker. The pixel renderer draws
# a real round disc for it (in the gutter) instead of painting the placeholder.
def he_seg_marker(si: uint64) -> int32:
    return cast[int32](seg_marker[si])


# 1 if segment si is a list item's first text run: the pixel renderer jumps the
# pen forward to seg_x so the hanging indent (marker gutter) is preserved.
def he_seg_indjump(si: uint64) -> int32:
    return cast[int32](seg_indjump[si])


# Extra LEFT horizontal gap (px) the pixel renderer inserts before segment si's
# glyphs — an inline / inline-block element's CSS horizontal margin. 0 = none.
def he_seg_lmarg(si: uint64) -> int32:
    return seg_lmarg[si]


# ---- pixel border-box registry accessors ----------------------------
def he_n_bboxes() -> int32:
    return n_bboxes


def he_bbox_lx(i: int32) -> int32:
    return bbox_lx[i]


def he_bbox_rx(i: int32) -> int32:
    return bbox_rx[i]


def he_bbox_top(i: int32) -> int32:
    return bbox_top[i]


def he_bbox_bot(i: int32) -> int32:
    return bbox_bot[i]


def he_bbox_rgb(i: int32) -> int32:
    return bbox_rgb[i]


# Per-side border colours (0xRRGGBB) of bordered box i: right / bottom / left.
# The TOP colour (and the uniform fallback) is he_bbox_rgb. Each already resolves
# to its own declared colour or the uniform fallback.
def he_bbox_rgb_r(i: int32) -> int32:
    return bbox_rgb_r[i]


def he_bbox_rgb_b(i: int32) -> int32:
    return bbox_rgb_b[i]


def he_bbox_rgb_l(i: int32) -> int32:
    return bbox_rgb_l[i]


# border-radius px of bordered box i (0 = square corners).
def he_bbox_radius(i: int32) -> int32:
    return bbox_rad[i]


# ---- link-box (pointer hit-test) registry accessors ------------------
# The clickable box of a blockified / inline-block <a>. Consulted ONLY by
# htmlpage_hit_link as a fallback when no painted text segment matched, so a
# click in a nav pill's / card's padding resolves to the link like Chrome.
def he_n_lnkboxes() -> int32:
    return n_lnkboxes


def he_lnkbox_lid(i: int32) -> int32:
    return lnkbox_lid[i]


def he_lnkbox_lx(i: int32) -> int32:
    return lnkbox_lx[i]


def he_lnkbox_rx(i: int32) -> int32:
    return lnkbox_rx[i]


def he_lnkbox_top(i: int32) -> int32:
    return lnkbox_top[i]


def he_lnkbox_bot(i: int32) -> int32:
    return lnkbox_bot[i]


def he_lnkbox_padt(i: int32) -> int32:
    return lnkbox_padt[i]


def he_lnkbox_padb(i: int32) -> int32:
    return lnkbox_padb[i]


# ---- element background-fill registry accessors ---------------------
def he_n_bfills() -> int32:
    return n_bfills


def he_bfill_lx(i: int32) -> int32:
    return bfill_lx[i]


def he_bfill_rx(i: int32) -> int32:
    return bfill_rx[i]


def he_bfill_top(i: int32) -> int32:
    return bfill_top[i]


def he_bfill_bot(i: int32) -> int32:
    return bfill_bot[i]


def he_bfill_rgb(i: int32) -> int32:
    return bfill_rgb[i]


# Stacking order (z-index) of block background fill i; 0 = default flow order.
def he_bfill_z(i: int32) -> int32:
    return bfill_z[i]


# border-radius px of background fill i (0 = square corners).
def he_bfill_radius(i: int32) -> int32:
    return bfill_rad[i]


# Border stroke colour (0xRRGGBB) for the rounded rectangle of fill i, or -1 for
# no border. Set on inline-block chips (a styled search box / CTA / badge) so a
# `display:inline-block` element with a `border` paints a real outlined box.
def he_bfill_bord(i: int32) -> int32:
    return bfill_bord[i]


# CSS filter of background fill i, packed as (type << 20) | amount (0 = none).
# See lib/web/css/cascade.ad _filter_value for the encoding. The renderer applies
# it as a per-pixel post-pass over the fill's rectangle (htmlpaint_filter_rect).
def he_bfill_filter(i: int32) -> int32:
    return bfill_filter[i]


# Number of distinct <img src> strings seen in the last layout — the host
# driver iterates these to slurp + decode each PNG before a second layout pass.
def he_n_images() -> uint64:
    return n_eimg


def he_img_name_ptr(i: uint64) -> Ptr[uint8]:
    return &eimg_name_buf[eimg_noff[i]]


def he_img_name_len(i: uint64) -> uint64:
    return eimg_nlen[i]


# Image names the last layout could NOT record because the fixed-size registry
# was full (EIMG_MAX names / EIMG_NAME_CAP bytes). Non-zero means the page's
# image set was TRUNCATED and some <img>/background-image will paint empty --
# the drivers surface it rather than letting the cap fail silently.
def he_img_dropped() -> uint64:
    return eimg_dropped


heimg_msg_buf: Array[192, uint8]


def _heim_puts(p: uint64, t: Ptr[uint8]) -> uint64:
    i: uint64 = 0
    q: uint64 = p
    while t[i] != 0 and q < 190:
        heimg_msg_buf[q] = t[i]
        q = q + 1
        i = i + 1
    return q


def _heim_dec(p: uint64, v: uint64) -> uint64:
    if v == 0:
        if p < 190:
            heimg_msg_buf[p] = 48
            return p + 1
        return p
    heim_tmp: Array[24, uint8]
    n: uint64 = 0
    x: uint64 = v
    while x > 0:
        heim_tmp[n] = cast[uint8](48 + (x % 10))
        x = x / 10
        n = n + 1
    q: uint64 = p
    while n > 0 and q < 190:
        n = n - 1
        heimg_msg_buf[q] = heim_tmp[n]
        q = q + 1
    return q


# NUL-terminated one-line diagnostic naming the registry cap that was hit and
# its VALUE, and how many image names were lost. Empty (leading NUL) when
# nothing was dropped, so a page that fits prints nothing. Pure -- the driver
# writes it with whatever it has. Same shape as htmlimg_drop_message().
def he_img_drop_message() -> Ptr[uint8]:
    if eimg_dropped == 0:
        heimg_msg_buf[0] = 0
        return &heimg_msg_buf[0]
    p: uint64 = _heim_puts(0, cast[Ptr[uint8]]("hambrowse: "))
    p = _heim_dec(p, eimg_dropped)
    p = _heim_puts(p, cast[Ptr[uint8]](" image name(s) NOT decoded - src registry full: "))
    if eimg_drop_reason == EIMGDROP_SLOTS:
        p = _heim_puts(p, cast[Ptr[uint8]]("EIMG_MAX="))
        p = _heim_dec(p, EIMG_MAX)
        p = _heim_puts(p, cast[Ptr[uint8]](" slots"))
    else:
        p = _heim_puts(p, cast[Ptr[uint8]]("EIMG_NAME_CAP="))
        p = _heim_dec(p, EIMG_NAME_CAP)
        p = _heim_puts(p, cast[Ptr[uint8]](" name bytes"))
    p = _heim_puts(p, cast[Ptr[uint8]]("; the page above is INCOMPLETE\n"))
    heimg_msg_buf[p] = 0
    return &heimg_msg_buf[0]


def he_img_drop_message_len() -> uint64:
    n: uint64 = 0
    while heimg_msg_buf[n] != 0:
        n = n + 1
    return n



# ====================================================================
# OBSERVER APIs — MutationObserver / IntersectionObserver / ResizeObserver.
# ====================================================================
# The three observer surfaces modern frameworks (React, Vue, lazy-load libs,
# auto-resizing widgets) depend on. All callbacks are delivered as MICROTASKS
# on the shared JS microtask queue (via the global queueMicrotask), so:
#
#   * MutationObserver batches every mutation made during the current script and
#     fires its callback ONCE, as a microtask, AFTER the script finishes — the
#     spec's microtask-checkpoint "notify mutation observers" step. Records made
#     while the callback runs schedule a fresh microtask (the queued flag is
#     cleared before callbacks fire), so chained observers compose.
#
#   * IntersectionObserver / ResizeObserver deliver ONCE after observe(), against
#     the single (headless) layout the engine produced. There is NO live scroll
#     or resize loop in the headless single-layout render model: an entry is a
#     one-shot snapshot of the element's laid-out box vs the viewport. This is
#     documented honestly in docs/browser_w3c_conformance.md.
#
# Delivery is coalesced: the FIRST queued observer work schedules one
# NID_OBS_DELIVER microtask; that job flushes MutationObserver record batches,
# then IntersectionObserver entries, then ResizeObserver entries.

MO_MAX:      int32 = 64
MO_REG_MAX:  int32 = 256
MO_REC_MAX:  int32 = 512
MO_FILT_CAP: int32 = 4096

# MutationObserver instances (indexed by observer).
mo_this:  Array[64, int32]        # observer object value (identity key)
mo_cb:    Array[64, int32]        # callback fn value
mo_used:  Array[64, uint8]        # 1 = live
mo_n:     int32 = 0               # high-water of allocated observers

# MutationObserver observe() registrations (observer x target x options).
mreg_oidx:     Array[256, int32]  # owning observer index
mreg_target:   Array[256, int32]  # observed node object value
mreg_childlist: Array[256, uint8]
mreg_attr:     Array[256, uint8]
mreg_chardata: Array[256, uint8]
mreg_subtree:  Array[256, uint8]
mreg_attr_oldv: Array[256, uint8]
mreg_char_oldv: Array[256, uint8]
mreg_filt_off: Array[256, int32]  # offset into mo_filt_pool (-1 = no attributeFilter)
mreg_filt_len: Array[256, int32]  # byte length of the NUL-separated filter list
mreg_active:   Array[256, uint8]  # 1 = live (disconnect flips to 0)
mreg_n:        int32 = 0          # allocated registration count (also the live-registry gate)
mo_filt_pool:  Array[4096, uint8] # NUL-separated lowercase attribute names
mo_filt_w:     int32 = 0

# MutationObserver pending records (a shared FIFO tagged by observer).
mrec_oidx:    Array[512, int32]
mrec_type:    Array[512, int32]   # 0=childList 1=attributes 2=characterData
mrec_target:  Array[512, int32]
mrec_added:   Array[512, int32]   # JS array value
mrec_removed: Array[512, int32]   # JS array value
mrec_attr:    Array[512, int32]   # attributeName string value (or js_null)
mrec_oldv:    Array[512, int32]   # oldValue string value (or js_null)
mrec_pending: Array[512, uint8]   # 1 = not yet delivered/taken
mrec_n:       int32 = 0

# IntersectionObserver instances + registrations.
io_this: Array[64, int32]
io_cb:   Array[64, int32]
io_used: Array[64, uint8]
io_n:    int32 = 0
ioreg_oidx:   Array[256, int32]
ioreg_target: Array[256, int32]
ioreg_active: Array[256, uint8]
ioreg_n:      int32 = 0

# ResizeObserver instances + registrations.
ro_this: Array[64, int32]
ro_cb:   Array[64, int32]
ro_used: Array[64, uint8]
ro_n:    int32 = 0
roreg_oidx:   Array[256, int32]
roreg_target: Array[256, int32]
roreg_active: Array[256, uint8]
roreg_n:      int32 = 0

g_obs_micro_queued: int32 = 0     # 1 = a NID_OBS_DELIVER microtask is pending
g_obs_argv2: Array[2, int32]      # scratch arg vector for callback / queueMicrotask


# Reset every observer registry (called once per page from _js_build_document,
# i.e. after each js_init) so a fresh page starts with no observers/records.
def _obs_reset():
    mo_n = 0
    mreg_n = 0
    mrec_n = 0
    mo_filt_w = 0
    io_n = 0
    ioreg_n = 0
    ro_n = 0
    roreg_n = 0
    g_obs_micro_queued = 0


# Schedule the single coalesced delivery microtask, if not already pending. Runs
# the delivery job through the ENGINE microtask queue (global queueMicrotask) so
# it fires after the current script at the microtask checkpoint — no host-side
# timer plumbing, and it composes with Promise/queueMicrotask ordering.
def _obs_schedule():
    if g_obs_micro_queued != 0:
        return
    qm: int32 = js_global_get(cast[Ptr[uint8]]("queueMicrotask"), 14)
    if js_is_callable(qm) == 0:
        return
    g_obs_micro_queued = 1
    deliver: int32 = js_new_native_fn(js_hbase + NID_OBS_DELIVER)
    g_obs_argv2[0] = deliver
    js_call_fn(qm, js_undefined(), &g_obs_argv2[0], 1)


# Does the mutation on `mut_node` fall within registration `reg`'s scope? True
# when the observed target IS the node, or (subtree) an ancestor of it. Ancestor
# lookup walks the live parentNode back-links the mutation handlers maintain.
def _mo_scope_hit(mut_node: int32, reg: int32) -> int32:
    if mut_node == mreg_target[reg]:
        return 1
    if cast[int32](mreg_subtree[reg]) == 0:
        return 0
    cur: int32 = js_get_prop(mut_node, cast[Ptr[uint8]]("parentNode"), 10)
    d: int32 = 0
    while d < 64 and js_type_of(cur) == 5:
        if cur == mreg_target[reg]:
            return 1
        cur = js_get_prop(cur, cast[Ptr[uint8]]("parentNode"), 10)
        d = d + 1
    return 0


# Lowercase ascii byte.
def _obs_lc(c: uint8) -> uint8:
    if c >= 65 and c <= 90:
        return c + 32
    return c


# Does registration `reg`'s attributeFilter admit attribute `name`? A registration
# with no filter admits every attribute; otherwise the (case-insensitive) name
# must appear in the NUL-separated pool slice.
def _mo_filter_allows(reg: int32, name: Ptr[uint8], nlen: int32) -> int32:
    if mreg_filt_len[reg] == 0:
        return 1
    off: int32 = mreg_filt_off[reg]
    endp: int32 = off + mreg_filt_len[reg]
    i: int32 = off
    while i < endp:
        # one filter token runs to the next NUL
        ts: int32 = i
        while i < endp and mo_filt_pool[i] != 0:
            i = i + 1
        tlen: int32 = i - ts
        if tlen == nlen:
            k: int32 = 0
            eq: int32 = 1
            while k < tlen:
                if mo_filt_pool[ts + k] != _obs_lc(name[k]):
                    eq = 0
                    k = tlen
                k = k + 1
            if eq != 0:
                return 1
        i = i + 1                                # skip the NUL
    return 0


# Wrap a single node value (or js_null when `node` < 0, the "none" sentinel) as a
# fresh JS array, so addedNodes/removedNodes are always NodeList-shaped arrays.
def _mo_node_list(node: int32) -> int32:
    a: int32 = js_new_array_v()
    if node != -1 and node != js_null():
        js_array_push(a, node)
    return a


# Queue one record for every MutationObserver registration matching (mut_node,
# type). `added`/`removed` are node values or -1; `attr`/`oldv` are string values
# or js_null. Also (re)schedules the delivery microtask.
def _mo_queue(mut_node: int32, mtype: int32, added: int32, removed: int32, \
              attr: int32, aname: Ptr[uint8], anlen: int32):
    if mreg_n == 0:
        return
    queued: int32 = 0
    r: int32 = 0
    while r < mreg_n:
        take: int32 = 0
        if cast[int32](mreg_active[r]) != 0 and _mo_scope_hit(mut_node, r) != 0:
            if mtype == 0 and cast[int32](mreg_childlist[r]) != 0:
                take = 1
            elif mtype == 1 and cast[int32](mreg_attr[r]) != 0:
                if _mo_filter_allows(r, aname, anlen) != 0:
                    take = 1
            elif mtype == 2 and cast[int32](mreg_chardata[r]) != 0:
                take = 1
        if take != 0 and mrec_n < MO_REC_MAX:
            reci: int32 = mrec_n
            mrec_n = mrec_n + 1
            mrec_oidx[reci] = mreg_oidx[r]
            mrec_type[reci] = mtype
            mrec_target[reci] = mut_node
            mrec_added[reci] = _mo_node_list(added)
            mrec_removed[reci] = _mo_node_list(removed)
            mrec_attr[reci] = js_null()
            mrec_oldv[reci] = js_null()
            if mtype == 1:
                # `attr` carries the captured PRE-mutation value; the name comes
                # from aname[0..anlen). oldValue is exposed only when the matching
                # registration requested attributeOldValue.
                mrec_attr[reci] = js_new_string(aname, cast[uint64](anlen))
                if cast[int32](mreg_attr_oldv[r]) != 0:
                    mrec_oldv[reci] = attr
            mrec_pending[reci] = cast[uint8](1)
            queued = 1
        r = r + 1
    if queued != 0:
        _obs_schedule()


# Read a node's CURRENT value of attribute name[0..nlen) as a string value, for
# an attributeOldValue snapshot taken BEFORE the write. `tgt` is the JS object.
# class -> className; style -> serialized; else the reflected property (js_null
# when absent).
def _mo_attr_oldvalue(tgt: int32, name: Ptr[uint8], nlen: int32) -> int32:
    if _bytes_eq(name, nlen, cast[Ptr[uint8]]("class"), 5) != 0:
        return js_get_prop(tgt, cast[Ptr[uint8]]("className"), 9)
    if _bytes_eq(name, nlen, cast[Ptr[uint8]]("style"), 5) != 0:
        sto: int32 = js_get_prop(tgt, cast[Ptr[uint8]]("style"), 5)
        return _style_serialize(sto)
    return js_get_prop(tgt, name, cast[uint64](nlen))


# ---- mutation-point recording entrypoints (called from the NID handlers) ----
def _mo_record_childlist(parent: int32, added: int32, removed: int32):
    _mo_queue(parent, 0, added, removed, js_null(), cast[Ptr[uint8]](""), 0)


def _mo_record_attr(el: int32, name: Ptr[uint8], nlen: int32, oldv: int32):
    _mo_queue(el, 1, -1, -1, oldv, name, nlen)


def _mo_record_chardata(node: int32):
    _mo_queue(node, 2, -1, -1, js_null(), cast[Ptr[uint8]](""), 0)


# Find the observer index whose instance object is `thisobj`, or -1.
def _mo_find(thisobj: int32) -> int32:
    i: int32 = 0
    while i < mo_n:
        if cast[int32](mo_used[i]) != 0 and mo_this[i] == thisobj:
            return i
        i = i + 1
    return -1


# Build one MutationRecord JS object from pending-record slot `reci`.
def _mo_build_record(reci: int32) -> int32:
    r: int32 = js_new_object_v()
    t: int32 = mrec_type[reci]
    if t == 0:
        js_set_prop(r, cast[Ptr[uint8]]("type"), 4, \
                    js_new_string(cast[Ptr[uint8]]("childList"), 9))
    elif t == 1:
        js_set_prop(r, cast[Ptr[uint8]]("type"), 4, \
                    js_new_string(cast[Ptr[uint8]]("attributes"), 10))
    else:
        js_set_prop(r, cast[Ptr[uint8]]("type"), 4, \
                    js_new_string(cast[Ptr[uint8]]("characterData"), 13))
    js_set_prop(r, cast[Ptr[uint8]]("target"), 6, mrec_target[reci])
    js_set_prop(r, cast[Ptr[uint8]]("addedNodes"), 10, mrec_added[reci])
    js_set_prop(r, cast[Ptr[uint8]]("removedNodes"), 12, mrec_removed[reci])
    js_set_prop(r, cast[Ptr[uint8]]("previousSibling"), 15, js_null())
    js_set_prop(r, cast[Ptr[uint8]]("nextSibling"), 11, js_null())
    js_set_prop(r, cast[Ptr[uint8]]("attributeName"), 13, mrec_attr[reci])
    js_set_prop(r, cast[Ptr[uint8]]("attributeNamespace"), 18, js_null())
    js_set_prop(r, cast[Ptr[uint8]]("oldValue"), 8, mrec_oldv[reci])
    return r


# Drain pending records for observer `oidx` into a fresh JS array (FIFO), marking
# them delivered. Shared by takeRecords() and the delivery microtask.
def _mo_take(oidx: int32) -> int32:
    arr: int32 = js_new_array_v()
    i: int32 = 0
    while i < mrec_n:
        if cast[int32](mrec_pending[i]) != 0 and mrec_oidx[i] == oidx:
            js_array_push(arr, _mo_build_record(i))
            mrec_pending[i] = cast[uint8](0)
        i = i + 1
    return arr


# ---- IntersectionObserver -------------------------------------------------
def _io_find(thisobj: int32) -> int32:
    i: int32 = 0
    while i < io_n:
        if cast[int32](io_used[i]) != 0 and io_this[i] == thisobj:
            return i
        i = i + 1
    return -1


def _obs_viewport_w() -> float64:
    v: float64 = js_to_number(js_global_get(cast[Ptr[uint8]]("innerWidth"), 10))
    if v > 0.0:
        return v
    return 1024.0


def _obs_viewport_h() -> float64:
    v: float64 = js_to_number(js_global_get(cast[Ptr[uint8]]("innerHeight"), 11))
    if v > 0.0:
        return v
    return 768.0


# Build one IntersectionObserverEntry for `target` against the viewport root,
# from the element's laid-out box (single-layout snapshot).
def _io_build_entry(target: int32) -> int32:
    e: int32 = js_new_object_v()
    el: int32 = _find_el_by_obj(target)
    _el_bbox(el)
    rect: int32 = _new_rect_obj()
    left: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("left"), 4))
    top: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("top"), 3))
    w: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("width"), 5))
    h: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("height"), 6))
    vw: float64 = _obs_viewport_w()
    vh: float64 = _obs_viewport_h()
    ix0: float64 = left
    if 0.0 > ix0:
        ix0 = 0.0
    iy0: float64 = top
    if 0.0 > iy0:
        iy0 = 0.0
    ix1: float64 = left + w
    if vw < ix1:
        ix1 = vw
    iy1: float64 = top + h
    if vh < iy1:
        iy1 = vh
    iw: float64 = ix1 - ix0
    ih: float64 = iy1 - iy0
    if iw < 0.0:
        iw = 0.0
    if ih < 0.0:
        ih = 0.0
    inter: float64 = iw * ih
    area: float64 = w * h
    ratio: float64 = 0.0
    if area > 0.0:
        ratio = inter / area
    isect: int32 = 0
    if inter > 0.0:
        isect = 1
    js_set_prop(e, cast[Ptr[uint8]]("target"), 6, target)
    js_set_prop(e, cast[Ptr[uint8]]("isIntersecting"), 14, js_bool(isect))
    js_set_prop(e, cast[Ptr[uint8]]("intersectionRatio"), 17, js_number(ratio))
    js_set_prop(e, cast[Ptr[uint8]]("boundingClientRect"), 18, rect)
    js_set_prop(e, cast[Ptr[uint8]]("intersectionRect"), 16, rect)
    js_set_prop(e, cast[Ptr[uint8]]("time"), 4, js_number(0.0))
    return e


# ---- ResizeObserver -------------------------------------------------------
def _ro_find(thisobj: int32) -> int32:
    i: int32 = 0
    while i < ro_n:
        if cast[int32](ro_used[i]) != 0 and ro_this[i] == thisobj:
            return i
        i = i + 1
    return -1


# Build one ResizeObserverEntry for `target` with its laid-out content box.
def _ro_build_entry(target: int32) -> int32:
    e: int32 = js_new_object_v()
    el: int32 = _find_el_by_obj(target)
    _el_bbox(el)
    rect: int32 = _new_rect_obj()
    w: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("width"), 5))
    h: float64 = js_to_number(js_get_prop(rect, cast[Ptr[uint8]]("height"), 6))
    cr: int32 = js_new_object_v()
    js_set_prop(cr, cast[Ptr[uint8]]("x"), 1, js_number(0.0))
    js_set_prop(cr, cast[Ptr[uint8]]("y"), 1, js_number(0.0))
    js_set_prop(cr, cast[Ptr[uint8]]("left"), 4, js_number(0.0))
    js_set_prop(cr, cast[Ptr[uint8]]("top"), 3, js_number(0.0))
    js_set_prop(cr, cast[Ptr[uint8]]("width"), 5, js_number(w))
    js_set_prop(cr, cast[Ptr[uint8]]("height"), 6, js_number(h))
    js_set_prop(cr, cast[Ptr[uint8]]("right"), 5, js_number(w))
    js_set_prop(cr, cast[Ptr[uint8]]("bottom"), 6, js_number(h))
    js_set_prop(e, cast[Ptr[uint8]]("target"), 6, target)
    js_set_prop(e, cast[Ptr[uint8]]("contentRect"), 11, cr)
    bs: int32 = js_new_object_v()
    js_set_prop(bs, cast[Ptr[uint8]]("inlineSize"), 10, js_number(w))
    js_set_prop(bs, cast[Ptr[uint8]]("blockSize"), 9, js_number(h))
    bsl: int32 = js_new_array_v()
    js_array_push(bsl, bs)
    js_set_prop(e, cast[Ptr[uint8]]("contentBoxSize"), 14, bsl)
    js_set_prop(e, cast[Ptr[uint8]]("borderBoxSize"), 13, bsl)
    return e


# ---- coalesced delivery (the NID_OBS_DELIVER microtask body) ---------------
# Clear the queued flag FIRST (so callbacks that mutate/observe schedule a fresh
# microtask), then deliver MutationObserver batches, IntersectionObserver
# entries, then ResizeObserver entries. Each observer fires at most once here.
def _obs_deliver_all():
    g_obs_micro_queued = 0
    # MutationObservers: one batched callback per observer that has records.
    oi: int32 = 0
    while oi < mo_n:
        if cast[int32](mo_used[oi]) != 0:
            recs: int32 = _mo_take(oi)
            if js_array_len(recs) > 0:
                g_obs_argv2[0] = recs
                g_obs_argv2[1] = mo_this[oi]
                js_call_fn(mo_cb[oi], mo_this[oi], &g_obs_argv2[0], 2)
        oi = oi + 1
    # IntersectionObservers.
    ii: int32 = 0
    while ii < io_n:
        if cast[int32](io_used[ii]) != 0:
            entries: int32 = js_new_array_v()
            rr: int32 = 0
            while rr < ioreg_n:
                if cast[int32](ioreg_active[rr]) != 0 and ioreg_oidx[rr] == ii:
                    js_array_push(entries, _io_build_entry(ioreg_target[rr]))
                rr = rr + 1
            if js_array_len(entries) > 0:
                g_obs_argv2[0] = entries
                g_obs_argv2[1] = io_this[ii]
                js_call_fn(io_cb[ii], io_this[ii], &g_obs_argv2[0], 2)
        ii = ii + 1
    # ResizeObservers.
    ri: int32 = 0
    while ri < ro_n:
        if cast[int32](ro_used[ri]) != 0:
            rentries: int32 = js_new_array_v()
            qr: int32 = 0
            while qr < roreg_n:
                if cast[int32](roreg_active[qr]) != 0 and roreg_oidx[qr] == ri:
                    js_array_push(rentries, _ro_build_entry(roreg_target[qr]))
                qr = qr + 1
            if js_array_len(rentries) > 0:
                g_obs_argv2[0] = rentries
                g_obs_argv2[1] = ro_this[ri]
                js_call_fn(ro_cb[ri], ro_this[ri], &g_obs_argv2[0], 2)
        ri = ri + 1


# Attach the observe/disconnect/takeRecords (or unobserve) methods on a freshly
# constructed observer instance.
def _mo_attach_methods(inst: int32):
    js_set_prop(inst, cast[Ptr[uint8]]("observe"), 7, \
                js_new_native_fn(js_hbase + NID_MO_OBSERVE))
    js_set_prop(inst, cast[Ptr[uint8]]("disconnect"), 10, \
                js_new_native_fn(js_hbase + NID_MO_DISCONNECT))
    js_set_prop(inst, cast[Ptr[uint8]]("takeRecords"), 11, \
                js_new_native_fn(js_hbase + NID_MO_TAKEREC))


def _io_attach_methods(inst: int32):
    js_set_prop(inst, cast[Ptr[uint8]]("observe"), 7, \
                js_new_native_fn(js_hbase + NID_IO_OBSERVE))
    js_set_prop(inst, cast[Ptr[uint8]]("unobserve"), 9, \
                js_new_native_fn(js_hbase + NID_IO_UNOBSERVE))
    js_set_prop(inst, cast[Ptr[uint8]]("disconnect"), 10, \
                js_new_native_fn(js_hbase + NID_IO_DISCONNECT))
    js_set_prop(inst, cast[Ptr[uint8]]("takeRecords"), 11, js_new_array_v())


def _ro_attach_methods(inst: int32):
    js_set_prop(inst, cast[Ptr[uint8]]("observe"), 7, \
                js_new_native_fn(js_hbase + NID_RO_OBSERVE))
    js_set_prop(inst, cast[Ptr[uint8]]("unobserve"), 9, \
                js_new_native_fn(js_hbase + NID_RO_UNOBSERVE))
    js_set_prop(inst, cast[Ptr[uint8]]("disconnect"), 10, \
                js_new_native_fn(js_hbase + NID_RO_DISCONNECT))


# Parse a MutationObserver observe() options object into a fresh registration
# `reg`. attributeFilter (or attributeOldValue/attributes-absent-with-filter)
# implies attributes; attributeFilter names are stored NUL-separated, lowercased.
def _mo_parse_options(reg: int32, opts: int32):
    cl: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("childList"), 9))
    at: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("attributes"), 10))
    cd: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("characterData"), 13))
    st: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("subtree"), 7))
    aov: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("attributeOldValue"), 17))
    cov: int32 = js_to_bool(js_get_prop(opts, cast[Ptr[uint8]]("characterDataOldValue"), 21))
    filt: int32 = js_get_prop(opts, cast[Ptr[uint8]]("attributeFilter"), 15)
    mreg_filt_off[reg] = -1
    mreg_filt_len[reg] = 0
    if js_is_array(filt) != 0:
        at = 1                                   # attributeFilter implies attributes
        start: int32 = mo_filt_w
        n: int32 = js_array_len(filt)
        fi: int32 = 0
        while fi < n:
            sv: int32 = js_array_get(filt, fi)
            sp: Ptr[uint8] = js_str_ptr(sv)
            sl: int32 = _cstr_len(sp)
            k: int32 = 0
            while k < sl and mo_filt_w < MO_FILT_CAP:
                mo_filt_pool[mo_filt_w] = _obs_lc(sp[k])
                mo_filt_w = mo_filt_w + 1
                k = k + 1
            if mo_filt_w < MO_FILT_CAP:
                mo_filt_pool[mo_filt_w] = 0       # NUL separator
                mo_filt_w = mo_filt_w + 1
            fi = fi + 1
        mreg_filt_off[reg] = start
        mreg_filt_len[reg] = mo_filt_w - start
    # attributeOldValue/characterDataOldValue with no explicit attributes/
    # characterData still turn the respective observation on (spec).
    if aov != 0:
        at = 1
    if cov != 0:
        cd = 1
    mreg_childlist[reg] = cast[uint8](cl)
    mreg_attr[reg] = cast[uint8](at)
    mreg_chardata[reg] = cast[uint8](cd)
    mreg_subtree[reg] = cast[uint8](st)
    mreg_attr_oldv[reg] = cast[uint8](aov)
    mreg_char_oldv[reg] = cast[uint8](cov)


# The observer-API host dispatch arm (rel in [NID_MO_CTOR .. NID_OBS_DELIVER]).
def _obs_dispatch(rel: int32) -> int32:
    if rel == NID_MO_CTOR:
        inst: int32 = js_this()
        if mo_n < MO_MAX:
            idx: int32 = mo_n
            mo_n = mo_n + 1
            mo_this[idx] = inst
            mo_cb[idx] = js_arg(0)
            mo_used[idx] = cast[uint8](1)
        _mo_attach_methods(inst)
        return js_undefined()
    if rel == NID_MO_OBSERVE:
        oidx: int32 = _mo_find(js_this())
        if oidx >= 0 and js_arg_count() >= 1 and mreg_n < MO_REG_MAX:
            reg: int32 = mreg_n
            mreg_n = mreg_n + 1
            mreg_oidx[reg] = oidx
            mreg_target[reg] = js_arg(0)
            mreg_active[reg] = cast[uint8](1)
            _mo_parse_options(reg, js_arg(1))
        return js_undefined()
    if rel == NID_MO_DISCONNECT:
        doidx: int32 = _mo_find(js_this())
        if doidx >= 0:
            r: int32 = 0
            while r < mreg_n:
                if mreg_oidx[r] == doidx:
                    mreg_active[r] = cast[uint8](0)
                r = r + 1
            # disconnect() empties the observer's record queue (spec).
            q: int32 = 0
            while q < mrec_n:
                if mrec_oidx[q] == doidx:
                    mrec_pending[q] = cast[uint8](0)
                q = q + 1
        return js_undefined()
    if rel == NID_MO_TAKEREC:
        toidx: int32 = _mo_find(js_this())
        if toidx >= 0:
            return _mo_take(toidx)
        return js_new_array_v()
    if rel == NID_IO_CTOR:
        ioinst: int32 = js_this()
        if io_n < MO_MAX:
            iidx: int32 = io_n
            io_n = io_n + 1
            io_this[iidx] = ioinst
            io_cb[iidx] = js_arg(0)
            io_used[iidx] = cast[uint8](1)
        _io_attach_methods(ioinst)
        return js_undefined()
    if rel == NID_IO_OBSERVE:
        ioo: int32 = _io_find(js_this())
        if ioo >= 0 and js_arg_count() >= 1 and ioreg_n < MO_REG_MAX:
            ir: int32 = ioreg_n
            ioreg_n = ioreg_n + 1
            ioreg_oidx[ir] = ioo
            ioreg_target[ir] = js_arg(0)
            ioreg_active[ir] = cast[uint8](1)
            _obs_schedule()
        return js_undefined()
    if rel == NID_IO_UNOBSERVE:
        iou: int32 = _io_find(js_this())
        if iou >= 0 and js_arg_count() >= 1:
            k: int32 = 0
            while k < ioreg_n:
                if ioreg_oidx[k] == iou and ioreg_target[k] == js_arg(0):
                    ioreg_active[k] = cast[uint8](0)
                k = k + 1
        return js_undefined()
    if rel == NID_IO_DISCONNECT:
        iod: int32 = _io_find(js_this())
        if iod >= 0:
            k2: int32 = 0
            while k2 < ioreg_n:
                if ioreg_oidx[k2] == iod:
                    ioreg_active[k2] = cast[uint8](0)
                k2 = k2 + 1
        return js_undefined()
    if rel == NID_RO_CTOR:
        roinst: int32 = js_this()
        if ro_n < MO_MAX:
            ridx: int32 = ro_n
            ro_n = ro_n + 1
            ro_this[ridx] = roinst
            ro_cb[ridx] = js_arg(0)
            ro_used[ridx] = cast[uint8](1)
        _ro_attach_methods(roinst)
        return js_undefined()
    if rel == NID_RO_OBSERVE:
        roo: int32 = _ro_find(js_this())
        if roo >= 0 and js_arg_count() >= 1 and roreg_n < MO_REG_MAX:
            rr2: int32 = roreg_n
            roreg_n = roreg_n + 1
            roreg_oidx[rr2] = roo
            roreg_target[rr2] = js_arg(0)
            roreg_active[rr2] = cast[uint8](1)
            _obs_schedule()
        return js_undefined()
    if rel == NID_RO_UNOBSERVE:
        rou: int32 = _ro_find(js_this())
        if rou >= 0 and js_arg_count() >= 1:
            m: int32 = 0
            while m < roreg_n:
                if roreg_oidx[m] == rou and roreg_target[m] == js_arg(0):
                    roreg_active[m] = cast[uint8](0)
                m = m + 1
        return js_undefined()
    if rel == NID_RO_DISCONNECT:
        rod: int32 = _ro_find(js_this())
        if rod >= 0:
            m2: int32 = 0
            while m2 < roreg_n:
                if roreg_oidx[m2] == rod:
                    roreg_active[m2] = cast[uint8](0)
                m2 = m2 + 1
        return js_undefined()
    if rel == NID_OBS_DELIVER:
        _obs_deliver_all()
        return js_undefined()
    return js_undefined()


# Compute the DOCUMENT BASE URL: the document URL, overridden by the first
# <base href> in the source (itself resolved against the document URL, per the
# HTML spec's "document base URL" — chromium behaves the same way). Called once
# per page before any element reflects href/src.
def _apply_base_href():
    base_url_len = 0
    while base_url_len < doc_url_len:
        base_url[base_url_len] = doc_url[base_url_len]
        base_url_len = base_url_len + 1
    if doc_url_len <= 0:
        return
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("base")) != 0:
            ts: uint64 = i + 1
            je: uint64 = _hx_tag_end_p(src_ptr, src_len, ts)
            if _hx_find_attr(ts, je, cast[Ptr[uint8]]("href")) != 0:
                bl: int32 = _attr_decode_at(&url_bscratch[0], 0, DOC_URL_CAP)
                if bl > 0:
                    n2: int32 = _url_resolve(&url_bscratch[0], bl, \
                                             &doc_url[0], doc_url_len)
                    base_url_len = 0
                    while base_url_len < n2:
                        base_url[base_url_len] = url_buf_a[base_url_len]
                        base_url_len = base_url_len + 1
            return
        i = i + 1
