# ====================================================================
# <canvas> 2D context — the JS-facing side. Style state (fillStyle/strokeStyle/
# lineWidth/font/globalAlpha) lives as plain properties on the context object;
# each draw reads them back here and forwards resolved ints/colours to
# lib/htmlcanvas, which owns the pixels. See that module's header for scope.
# ====================================================================
cv_txt: Array[512, uint8]                 # scratch for a fillText/measureText arg
mq_scratch: Array[512, uint8]             # scratch for a window.matchMedia(query) arg
g_cv_px:   int32 = 10
g_cv_bold: int32 = 0


# Integer value of numeric JS argument `argi` (canvas coords are px).
def _cvn(argi: int32) -> int32:
    return cast[int32](js_to_number(js_arg(argi)))


# Case-insensitive equality of buf[0..n) with NUL-terminated `lit`.
def _ci_word_eq(p: Ptr[uint8], n: int32, lit: Ptr[uint8]) -> int32:
    i: int32 = 0
    while lit[i] != 0:
        if i >= n:
            return 0
        if _hx_lower(p[i]) != lit[i]:
            return 0
        i = i + 1
    if i != n:
        return 0
    return 1


# Does buf[0..n) contain NUL-terminated lowercase `lit` (case-insensitive)?
def _buf_contains(p: Ptr[uint8], n: int32, lit: Ptr[uint8]) -> int32:
    ll: int32 = 0
    while lit[ll] != 0:
        ll = ll + 1
    if ll == 0:
        return 0
    i: int32 = 0
    while i + ll <= n:
        k: int32 = 0
        while k < ll and _hx_lower(p[i + k]) == lit[k]:
            k = k + 1
        if k == ll:
            return 1
        i = i + 1
    return 0


# Parse a canvas colour string (#rgb / #rrggbb / a common CSS name) to packed
# 0xRRGGBB; defaults to black. A scoped named subset — the rest fall back to
# black, matching a browser's "unknown keyword => unchanged" only loosely, which
# is fine for the delivered fill/stroke set.
def _canvas_color(p: Ptr[uint8], n: int32) -> int32:
    if n <= 0:
        return 0
    if p[0] == 35:                                    # '#'
        if n >= 7:
            r: int32 = _hx_hexval(p[1]) * 16 + _hx_hexval(p[2])
            g: int32 = _hx_hexval(p[3]) * 16 + _hx_hexval(p[4])
            b: int32 = _hx_hexval(p[5]) * 16 + _hx_hexval(p[6])
            if r >= 0 and g >= 0 and b >= 0:
                return (r << 16) | (g << 8) | b
        if n >= 4:
            r3: int32 = _hx_hexval(p[1])
            g3: int32 = _hx_hexval(p[2])
            b3: int32 = _hx_hexval(p[3])
            if r3 >= 0 and g3 >= 0 and b3 >= 0:
                return ((r3 * 17) << 16) | ((g3 * 17) << 8) | (b3 * 17)
        return 0
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("white")) != 0:
        return 0xffffff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("red")) != 0:
        return 0xff0000
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("green")) != 0:
        return 0x008000
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("lime")) != 0:
        return 0x00ff00
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("blue")) != 0:
        return 0x0000ff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("navy")) != 0:
        return 0x000080
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("teal")) != 0:
        return 0x008080
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("aqua")) != 0:
        return 0x00ffff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("cyan")) != 0:
        return 0x00ffff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("olive")) != 0:
        return 0x808000
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("yellow")) != 0:
        return 0xffff00
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("orange")) != 0:
        return 0xffa500
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("gold")) != 0:
        return 0xffd700
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("purple")) != 0:
        return 0x800080
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("magenta")) != 0:
        return 0xff00ff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("fuchsia")) != 0:
        return 0xff00ff
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("maroon")) != 0:
        return 0x800000
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("silver")) != 0:
        return 0xc0c0c0
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("gray")) != 0:
        return 0x808080
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("grey")) != 0:
        return 0x808080
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("pink")) != 0:
        return 0xffc0cb
    if _ci_word_eq(p, n, cast[Ptr[uint8]]("brown")) != 0:
        return 0xa52a2a
    return 0                                           # black default


# Resolve a colour-string property (fillStyle/strokeStyle) on `ctx`. If the
# property holds a gradient object (used as a paint for stroke/path-fill/text
# where per-pixel interpolation is not wired), fall back to the gradient's first
# colour stop instead of black.
def _canvas_style_rgb(ctx: int32, name: Ptr[uint8], nlen: uint64) -> int32:
    v: int32 = js_get_prop(ctx, name, nlen)
    if js_type_of(v) == 5:                                # object -> gradient?
        gv: int32 = js_get_prop(v, cast[Ptr[uint8]]("__cvgrad"), 8)
        if js_type_of(gv) == 3:
            return htmlcanvas_grad_first_rgb(cast[int32](js_to_number(gv)))
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    return _canvas_color(p, n)


# ctx.lineWidth as a >=1 integer.
def _canvas_line_width(ctx: int32) -> int32:
    v: int32 = js_get_prop(ctx, cast[Ptr[uint8]]("lineWidth"), 9)
    lw: int32 = cast[int32](js_to_number(v))
    if lw < 1:
        lw = 1
    return lw


# ctx.globalAlpha (0..1) as 0..255 coverage. Only the translucent case touches
# a float multiply; opaque/clear are integer fast-paths.
def _canvas_alpha(ctx: int32) -> int32:
    v: int32 = js_get_prop(ctx, cast[Ptr[uint8]]("globalAlpha"), 11)
    af: float64 = js_to_number(v)
    if af >= cast[float64](1):
        return 255
    if af <= cast[float64](0):
        return 0
    return cast[int32](af * cast[float64](255))


# Read ctx.font into g_cv_px / g_cv_bold (default 10px, non-bold).
def _canvas_read_font(ctx: int32):
    g_cv_px = 10
    g_cv_bold = 0
    v: int32 = js_get_prop(ctx, cast[Ptr[uint8]]("font"), 4)
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if n <= 0:
        return
    if _buf_contains(p, n, cast[Ptr[uint8]]("bold")) != 0:
        g_cv_bold = 1
    num: int32 = 0
    seen: int32 = 0
    i: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c >= 48 and c <= 57:
            num = num * 10 + cast[int32](c - 48)
            seen = 1
        elif seen != 0:
            i = n
        i = i + 1
    if seen != 0 and num > 0:
        g_cv_px = num


# Map a JS radian angle argument to an integer step index (0..64 per turn).
def _canvas_ang_idx(argi: int32) -> int32:
    a: float64 = js_to_number(js_arg(argi))
    return cast[int32](a * cast[float64](10185916) / cast[float64](1000000) + \
                       cast[float64](5) / cast[float64](10))


# Does dom element `el`'s tag name equal NUL-terminated lowercase `lit`?
def _dom_tag_is(el: int32, lit: Ptr[uint8]) -> int32:
    nl: int32 = 0
    while lit[nl] != 0:
        nl = nl + 1
    if dom_nl[el] != nl:
        return 0
    k: int32 = 0
    while k < nl:
        if _hx_lower(src_ptr[cast[uint64](dom_ns[el]) + cast[uint64](k)]) != lit[k]:
            return 0
        k = k + 1
    return 1


# Build a fresh 2D-context JS object bound to htmlcanvas index `ci`: default
# style properties + the native drawing methods.
def _canvas_make_ctx() -> int32:
    ctx: int32 = js_new_object_v()
    js_set_prop(ctx, cast[Ptr[uint8]]("fillStyle"), 9, \
                js_new_string(cast[Ptr[uint8]]("#000000"), 7))
    js_set_prop(ctx, cast[Ptr[uint8]]("strokeStyle"), 11, \
                js_new_string(cast[Ptr[uint8]]("#000000"), 7))
    js_set_prop(ctx, cast[Ptr[uint8]]("lineWidth"), 9, js_number(cast[float64](1)))
    js_set_prop(ctx, cast[Ptr[uint8]]("font"), 4, \
                js_new_string(cast[Ptr[uint8]]("10px sans-serif"), 15))
    js_set_prop(ctx, cast[Ptr[uint8]]("globalAlpha"), 11, \
                js_number(cast[float64](1)))
    js_set_prop(ctx, cast[Ptr[uint8]]("fillRect"), 8, \
                js_new_native_fn(js_hbase + NID_CV_FILLRECT))
    js_set_prop(ctx, cast[Ptr[uint8]]("clearRect"), 9, \
                js_new_native_fn(js_hbase + NID_CV_CLEARRECT))
    js_set_prop(ctx, cast[Ptr[uint8]]("strokeRect"), 10, \
                js_new_native_fn(js_hbase + NID_CV_STROKERECT))
    js_set_prop(ctx, cast[Ptr[uint8]]("beginPath"), 9, \
                js_new_native_fn(js_hbase + NID_CV_BEGIN))
    js_set_prop(ctx, cast[Ptr[uint8]]("moveTo"), 6, \
                js_new_native_fn(js_hbase + NID_CV_MOVETO))
    js_set_prop(ctx, cast[Ptr[uint8]]("lineTo"), 6, \
                js_new_native_fn(js_hbase + NID_CV_LINETO))
    js_set_prop(ctx, cast[Ptr[uint8]]("closePath"), 9, \
                js_new_native_fn(js_hbase + NID_CV_CLOSE))
    js_set_prop(ctx, cast[Ptr[uint8]]("stroke"), 6, \
                js_new_native_fn(js_hbase + NID_CV_STROKE))
    js_set_prop(ctx, cast[Ptr[uint8]]("fill"), 4, \
                js_new_native_fn(js_hbase + NID_CV_FILL))
    js_set_prop(ctx, cast[Ptr[uint8]]("arc"), 3, \
                js_new_native_fn(js_hbase + NID_CV_ARC))
    js_set_prop(ctx, cast[Ptr[uint8]]("rect"), 4, \
                js_new_native_fn(js_hbase + NID_CV_RECT))
    js_set_prop(ctx, cast[Ptr[uint8]]("fillText"), 8, \
                js_new_native_fn(js_hbase + NID_CV_FILLTEXT))
    js_set_prop(ctx, cast[Ptr[uint8]]("strokeText"), 10, \
                js_new_native_fn(js_hbase + NID_CV_STROKETEXT))
    js_set_prop(ctx, cast[Ptr[uint8]]("measureText"), 11, \
                js_new_native_fn(js_hbase + NID_CV_MEASURE))
    js_set_prop(ctx, cast[Ptr[uint8]]("drawImage"), 9, \
                js_new_native_fn(js_hbase + NID_CV_DRAWIMAGE))
    js_set_prop(ctx, cast[Ptr[uint8]]("save"), 4, \
                js_new_native_fn(js_hbase + NID_CV_SAVE))
    js_set_prop(ctx, cast[Ptr[uint8]]("restore"), 7, \
                js_new_native_fn(js_hbase + NID_CV_RESTORE))
    js_set_prop(ctx, cast[Ptr[uint8]]("translate"), 9, \
                js_new_native_fn(js_hbase + NID_CV_TRANSLATE))
    js_set_prop(ctx, cast[Ptr[uint8]]("scale"), 5, \
                js_new_native_fn(js_hbase + NID_CV_SCALE))
    js_set_prop(ctx, cast[Ptr[uint8]]("rotate"), 6, \
                js_new_native_fn(js_hbase + NID_CV_ROTATE))
    js_set_prop(ctx, cast[Ptr[uint8]]("transform"), 9, \
                js_new_native_fn(js_hbase + NID_CV_TRANSFORM))
    js_set_prop(ctx, cast[Ptr[uint8]]("setTransform"), 12, \
                js_new_native_fn(js_hbase + NID_CV_SETTRANSFORM))
    js_set_prop(ctx, cast[Ptr[uint8]]("resetTransform"), 14, \
                js_new_native_fn(js_hbase + NID_CV_RESETTRANSFORM))
    js_set_prop(ctx, cast[Ptr[uint8]]("createLinearGradient"), 20, \
                js_new_native_fn(js_hbase + NID_CV_LINGRAD))
    js_set_prop(ctx, cast[Ptr[uint8]]("createRadialGradient"), 20, \
                js_new_native_fn(js_hbase + NID_CV_RADGRAD))
    js_set_prop(ctx, cast[Ptr[uint8]]("getImageData"), 12, \
                js_new_native_fn(js_hbase + NID_CV_GETIMGDATA))
    js_set_prop(ctx, cast[Ptr[uint8]]("putImageData"), 12, \
                js_new_native_fn(js_hbase + NID_CV_PUTIMGDATA))
    js_set_prop(ctx, cast[Ptr[uint8]]("createImageData"), 15, \
                js_new_native_fn(js_hbase + NID_CV_CREATEIMGDATA))
    return ctx


# ctx.fillStyle (or strokeStyle) resolved to a backend gradient index, or -1 if
# it is an ordinary colour string. A gradient object carries a numeric __cvgrad.
def _canvas_paint_grad(ctx: int32, name: Ptr[uint8], nlen: uint64) -> int32:
    v: int32 = js_get_prop(ctx, name, nlen)
    if js_type_of(v) != 5:                                # not an object
        return -1
    gv: int32 = js_get_prop(v, cast[Ptr[uint8]]("__cvgrad"), 8)
    if js_type_of(gv) != 3:                               # not a number
        return -1
    return cast[int32](js_to_number(gv))


# A float64 numeric JS argument (transform coefficients / gradient coords).
def _cvf(argi: int32) -> float64:
    return js_to_number(js_arg(argi))


# Find-or-create the canvas registration + 2D context for source element `el`.
# Returns the canv_* registry index, or -1.
def _canvas_get_for_el(el: int32) -> int32:
    i: int32 = 0
    while i < canv_n:
        if canv_el[i] == el:
            return i
        i = i + 1
    if canv_n >= CANV_MAX:
        return -1
    te: uint64 = cast[uint64](dom_ns[el])
    te = _hx_tag_end_p(src_ptr, src_len, te)
    aw: int32 = _attr_int(cast[uint64](dom_ns[el]), te, \
                          cast[Ptr[uint8]]("width"), 300)
    ah: int32 = _attr_int(cast[uint64](dom_ns[el]), te, \
                          cast[Ptr[uint8]]("height"), 150)
    if aw < 1:
        aw = 300
    if ah < 1:
        ah = 150
    if aw > 1000:
        aw = 1000
    if ah > 1000:
        ah = 1000
    slot: int32 = htmlimg_add_blank(cast[Ptr[uint8]]("canvas"), 6, aw, ah)
    if slot < 0:
        return -1
    cidx: int32 = htmlcanvas_new(slot, aw, ah)
    if cidx < 0:
        return -1
    cv_sstk_n[cidx] = 0
    ctx: int32 = _canvas_make_ctx()
    k: int32 = canv_n
    canv_ci[k] = cidx
    canv_slot[k] = slot
    canv_w[k] = aw
    canv_h[k] = ah
    canv_anchor[k] = dom_anchor[el]
    canv_idoff[k] = dom_id_off[el]
    canv_idlen[k] = dom_id_len[el]
    canv_ctxobj[k] = ctx
    canv_el[k] = el
    canv_n = k + 1
    return k


# Map a 2D-context JS object back to its lib/htmlcanvas index, or -1.
def _canvas_ci_of_ctx(ctx: int32) -> int32:
    i: int32 = 0
    while i < canv_n:
        if canv_ctxobj[i] == ctx:
            return canv_ci[i]
        i = i + 1
    return -1


# LAYOUT-side lookup: find the canvas registry entry for a <canvas> tag in body
# [ne,te) opened at source '<' offset `anchor`, matching by element id first
# (survives a JS source rewrite) then by anchor. Returns the index, or -1.
def _canvas_layout_find(anchor: int32, ne: uint64, te: uint64) -> int32:
    if _hx_find_attr(ne, te, cast[Ptr[uint8]]("id")) != 0 and \
       g_attr_end > g_attr_start:
        ln: int32 = cast[int32](g_attr_end - g_attr_start)
        i: int32 = 0
        while i < canv_n:
            if canv_idlen[i] == ln:
                mtch: int32 = 1
                k: int32 = 0
                while k < ln:
                    if src_ptr[g_attr_start + cast[uint64](k)] != \
                       dom_idbuf[canv_idoff[i] + k]:
                        mtch = 0
                        k = ln
                    k = k + 1
                if mtch != 0:
                    return i
            i = i + 1
    j: int32 = 0
    while j < canv_n:
        if canv_anchor[j] == anchor:
            return j
        j = j + 1
    return -1


# LAYOUT-side <canvas> handler: reserve the pixel box that blits the drawn (or
# blank, if the script never drew) backing buffer, then skip fallback content.
# `ltp1` is the tag-name start (source '<' = ltp1-1).
def _handle_canvas(ltp1: uint64, np: uint64, nlen: uint64, ne: uint64,
                   te: uint64):
    _word_flush()
    anchor: int32 = cast[int32](ltp1) - 1
    ci_reg: int32 = _canvas_layout_find(anchor, ne, te)
    if ci_reg < 0:
        # A <canvas> the script never got a context for: reserve a blank box.
        aw: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("width"), 300)
        ah: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("height"), 150)
        if aw < 1:
            aw = 300
        if ah < 1:
            ah = 150
        if aw > 1000:
            aw = 1000
        if ah > 1000:
            ah = 1000
        if canv_n < CANV_MAX:
            slot0: int32 = htmlimg_add_blank(cast[Ptr[uint8]]("canvas"), 6,
                                             aw, ah)
            if slot0 >= 0:
                cidx0: int32 = htmlcanvas_new(slot0, aw, ah)
                if cidx0 >= 0:
                    k0: int32 = canv_n
                    canv_ci[k0] = cidx0
                    canv_slot[k0] = slot0
                    canv_w[k0] = aw
                    canv_h[k0] = ah
                    canv_anchor[k0] = anchor
                    canv_idoff[k0] = 0
                    canv_idlen[k0] = 0
                    canv_ctxobj[k0] = -1
                    canv_el[k0] = -1
                    canv_n = k0 + 1
                    ci_reg = k0
    if ci_reg < 0:
        _enter_skip(np, nlen)
        return
    slot: int32 = canv_slot[ci_reg]
    bw2: int32 = canv_w[ci_reg]
    bh2: int32 = canv_h[ci_reg]
    if bw2 > bw:
        if bw2 > 0:
            bh2 = bh2 * bw / bw2
        bw2 = bw
    if bh2 < 1:
        bh2 = 1
    # bracketed alt fallback "[canvas]" for the text-only paths.
    img_alt_buf[0] = 91                                # '['
    img_alt_buf[1] = 99                                # 'c'
    img_alt_buf[2] = 97                                # 'a'
    img_alt_buf[3] = 110                               # 'n'
    img_alt_buf[4] = 118                               # 'v'
    img_alt_buf[5] = 97                                # 'a'
    img_alt_buf[6] = 115                               # 's'
    img_alt_buf[7] = 93                                # ']'
    img_alt_len = 8
    _emit_img_seg(slot, bw2, bh2)
    _enter_skip(np, nlen)


# ---------------------------------------------------------------------------
# innerHTML SETTER — parse a fragment string into REAL created-node children.
# Assigning `el.innerHTML = "<b>hi</b> world"` must expose the fragment as real
# DOM nodes so a SUBSEQUENT `el.childNodes` / tree walk in the SAME script sees
# the new subtree (jsengine has no accessor properties, so we hook member_set).
# We build cre_* element/text node objects, mirroring appendChild's node shape,
# and replace the target's .children/.childNodes arrays. RENDER already reflects
# an innerHTML assignment via the raw-override path in the readback pass, so we
# deliberately do NOT add ap/cc render edges here (that would double-emit).
# querySelector still scans source text (a pre-existing limit shared with
# appendChild's created nodes) and is unaffected.
# ---------------------------------------------------------------------------

# A fragment element that never has children in HTML (no end tag). Kept short —
# the common voids that appear inside real innerHTML strings.
def _frag_is_void(tp: Ptr[uint8], tl: int32) -> int32:
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("br"), 2) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("img"), 3) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("hr"), 2) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("input"), 5) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("meta"), 4) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("link"), 4) != 0:
        return 1
    return 0


# Is byte run sp[a..b) entirely ASCII whitespace?
def _frag_ws_only(sp: Ptr[uint8], a: int32, b: int32) -> int32:
    i: int32 = a
    while i < b:
        c: uint8 = sp[i]
        if c != 32 and c != 9 and c != 10 and c != 13:
            return 0
        i = i + 1
    return 1


# Allocate a created ELEMENT node with (lowercased) tag bytes tp[0..tl); returns
# its cre id, or -1 if the pool is full. Mirrors NID_CREATE's object shape so
# the emitter and DOM-walk APIs treat it exactly like a createElement node.
def _cre_make_element(tp: Ptr[uint8], tl: int32) -> int32:
    if cre_n >= CRE_MAX:
        return -1
    cid: int32 = cre_n
    cre_tag_off[cid] = dom_idbuf_len
    k: int32 = 0
    while k < tl and dom_idbuf_len < DOM_ID_CAP:
        dom_idbuf[dom_idbuf_len] = _hx_lower(tp[k])
        dom_idbuf_len = dom_idbuf_len + 1
        k = k + 1
    cre_tag_len[cid] = tl
    cre_is_text[cid] = 0
    cre_gone[cid] = 0
    co: int32 = js_new_object_v()
    js_set_prop(co, cast[Ptr[uint8]]("textContent"), 11, js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(co, cast[Ptr[uint8]]("id"), 2, js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(co, cast[Ptr[uint8]]("className"), 9, js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(co, cast[Ptr[uint8]]("tagName"), 7, \
                _tagname_upper(&dom_idbuf[cre_tag_off[cid]], tl))
    js_set_prop(co, cast[Ptr[uint8]]("nodeType"), 8, js_number(cast[float64](1)))
    js_set_prop(co, cast[Ptr[uint8]]("nodeName"), 8, \
                _tagname_upper(&dom_idbuf[cre_tag_off[cid]], tl))
    js_set_prop(co, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_prop(co, cast[Ptr[uint8]]("style"), 5, _new_style_obj())
    _attach_el_methods(co)
    cre_obj[cid] = co
    cre_n = cid + 1
    return cid


# Allocate a created TEXT node carrying string value `sval`. Returns its node
# object (js value), ready to push into a childNodes array.
def _cre_make_text(sval: int32) -> int32:
    if cre_n >= CRE_MAX:
        return -1
    tcid: int32 = cre_n
    cre_tag_off[tcid] = dom_idbuf_len
    cre_tag_len[tcid] = 0
    cre_is_text[tcid] = 1
    cre_gone[tcid] = 0
    tco: int32 = js_new_object_v()
    js_set_prop(tco, cast[Ptr[uint8]]("nodeType"), 8, js_number(cast[float64](3)))
    js_set_prop(tco, cast[Ptr[uint8]]("nodeName"), 8, \
                js_new_string(cast[Ptr[uint8]]("#text"), 5))
    # data / nodeValue / textContent / length are ACCESSORS on
    # CharacterData.prototype over this one backing field; setting them as own
    # data properties here would shadow the accessors and let the four drift.
    js_set_prop(tco, cast[Ptr[uint8]]("__cd"), 4, sval)
    _node_identity(tco, g_proto_text)
    cre_obj[tcid] = tco
    cre_n = tcid + 1
    return tco


# A created Comment (kind 2) or ProcessingInstruction (kind 3). Both are real
# members of the created-node pool, which is what lets them be APPENDED: a
# comment used to be a bare JS object with no cre_* row, so appendChild could
# not find it, parentNode stayed null, childNodes stayed empty, and every
# ChildNode test that uses a Comment as its context object was unreachable.
def _cre_make_chardata(sval: int32, kind: int32, targetv: int32) -> int32:
    if cre_n >= CRE_MAX:
        return js_null()
    ccid: int32 = cre_n
    cre_tag_off[ccid] = dom_idbuf_len
    cre_tag_len[ccid] = 0
    cre_is_text[ccid] = kind
    cre_gone[ccid] = 0
    co2: int32 = js_new_object_v()
    if kind == 2:
        js_set_prop(co2, cast[Ptr[uint8]]("nodeType"), 8, js_number(8.0))
        js_set_prop(co2, cast[Ptr[uint8]]("nodeName"), 8, \
                    js_new_string(cast[Ptr[uint8]]("#comment"), 8))
        _node_identity(co2, g_proto_comm)
    else:
        js_set_prop(co2, cast[Ptr[uint8]]("nodeType"), 8, js_number(7.0))
        js_set_prop(co2, cast[Ptr[uint8]]("nodeName"), 8, targetv)
        js_set_prop(co2, cast[Ptr[uint8]]("target"), 6, targetv)
        _node_identity(co2, g_proto_pi)
    js_set_prop(co2, cast[Ptr[uint8]]("__cd"), 4, sval)
    js_set_prop(co2, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    cre_obj[ccid] = co2
    cre_n = ccid + 1
    return co2


# Parse the attributes region sp[a..b) of a fragment start tag onto node obj
# `co`: class -> className, id -> id, everything else name->value verbatim.
def _frag_set_attrs(co: int32, sp: Ptr[uint8], a: int32, b: int32):
    i: int32 = a
    while i < b:
        while i < b and _frag_ws_only(sp, i, i + 1) != 0:
            i = i + 1
        if i >= b or sp[i] == 47:                        # '/' (self-close)
            return
        ns: int32 = i
        while i < b and _is_name_ch(sp[i]) != 0:
            i = i + 1
        ne: int32 = i
        if ne == ns:
            i = i + 1
            continue
        while i < b and _frag_ws_only(sp, i, i + 1) != 0:
            i = i + 1
        vs: int32 = ns
        vlen: int32 = 0
        if i < b and sp[i] == 61:                        # '='
            i = i + 1
            while i < b and _frag_ws_only(sp, i, i + 1) != 0:
                i = i + 1
            if i < b and (sp[i] == 34 or sp[i] == 39):   # quoted
                q: uint8 = sp[i]
                i = i + 1
                vs = i
                while i < b and sp[i] != q:
                    i = i + 1
                vlen = i - vs
                if i < b:
                    i = i + 1
            else:
                vs = i
                while i < b and _frag_ws_only(sp, i, i + 1) == 0:
                    i = i + 1
                vlen = i - vs
        av: int32 = js_new_string(&sp[vs], cast[uint64](vlen))
        if _bytes_eq(&sp[ns], ne - ns, cast[Ptr[uint8]]("class"), 5) != 0:
            js_set_prop(co, cast[Ptr[uint8]]("className"), 9, av)
        elif _bytes_eq(&sp[ns], ne - ns, cast[Ptr[uint8]]("id"), 2) != 0:
            js_set_prop(co, cast[Ptr[uint8]]("id"), 2, av)
        elif _bytes_eq(&sp[ns], ne - ns, cast[Ptr[uint8]]("checked"), 7) != 0:
            js_set_prop(co, cast[Ptr[uint8]]("checked"), 7, js_bool(1))
        elif _bytes_eq(&sp[ns], ne - ns, cast[Ptr[uint8]]("disabled"), 8) != 0:
            js_set_prop(co, cast[Ptr[uint8]]("disabled"), 8, js_bool(1))
        elif _bytes_eq(&sp[ns], ne - ns, cast[Ptr[uint8]]("selected"), 8) != 0:
            js_set_prop(co, cast[Ptr[uint8]]("selected"), 8, js_bool(1))
        else:
            js_set_prop(co, &sp[ns], cast[uint64](ne - ns), av)


# Close the top open element on the fragment stack: finalize its textContent
# (the shared linear cursor spans its descendants too) and its child arrays.
# Wire next/previousElementSibling (+ nextSibling/previousSibling aliases) across
# the ELEMENT children of a live .children array, skipping text nodes. Also set
# the parent's first/lastElementChild. Gives fragment/innerHTML children the
# sibling traversal + delegation surface real code walks. `parentv` is the JS
# object owning these children (for first/last) or js_null() to skip that.
def _wire_sibling_links(arr: int32, parentv: int32):
    if js_is_array(arr) == 0:
        return
    n: int32 = js_array_len(arr)
    prev_el: int32 = js_null()
    firsto: int32 = js_null()
    lasto: int32 = js_null()
    i: int32 = 0
    while i < n:
        ev: int32 = js_array_get(arr, i)
        ecid: int32 = _find_cre_by_obj(ev)
        is_el: int32 = 1
        if ecid >= 0 and cre_is_text[ecid] != 0:
            is_el = 0
        if is_el != 0:
            js_set_prop(ev, cast[Ptr[uint8]]("previousElementSibling"), 22, prev_el)
            js_set_prop(ev, cast[Ptr[uint8]]("previousSibling"), 15, prev_el)
            js_set_prop(ev, cast[Ptr[uint8]]("nextElementSibling"), 18, js_null())
            js_set_prop(ev, cast[Ptr[uint8]]("nextSibling"), 11, js_null())
            if prev_el != js_null():
                js_set_prop(prev_el, cast[Ptr[uint8]]("nextElementSibling"), 18, ev)
                js_set_prop(prev_el, cast[Ptr[uint8]]("nextSibling"), 11, ev)
            prev_el = ev
            if firsto == js_null():
                firsto = ev
            lasto = ev
        i = i + 1
    if parentv != js_null():
        js_set_prop(parentv, cast[Ptr[uint8]]("firstElementChild"), 17, firsto)
        js_set_prop(parentv, cast[Ptr[uint8]]("lastElementChild"), 16, lasto)
        # element-only child model: firstChild/lastChild alias the element ones.
        js_set_prop(parentv, cast[Ptr[uint8]]("firstChild"), 10, firsto)
        js_set_prop(parentv, cast[Ptr[uint8]]("lastChild"), 9, lasto)


def _frag_close_top(depth: int32):
    cid: int32 = frag_st_cid[depth]
    if cid < 0:
        return
    co: int32 = cre_obj[cid]
    ts: int32 = frag_st_txt[depth]
    js_set_prop(co, cast[Ptr[uint8]]("textContent"), 11, \
                js_new_string(&frag_txt[ts], cast[uint64](frag_txt_w - ts)))
    arr: int32 = frag_st_arr[depth]
    js_set_prop(co, cast[Ptr[uint8]]("children"), 8, arr)
    js_set_prop(co, cast[Ptr[uint8]]("childNodes"), 10, arr)
    _wire_sibling_links(arr, co)


# Parse HTML fragment sp[0..sl) into created nodes; append the TOP-LEVEL child
# objects to js array `root`. The caller reads root's length for first/last.
def _parse_fragment(sp: Ptr[uint8], sl: int32, root: int32):
    frag_txt_w = 0
    depth: int32 = 0
    frag_st_cid[0] = -1
    frag_st_arr[0] = root
    frag_st_txt[0] = 0
    i: int32 = 0
    while i < sl:
        if sp[i] == 60:                                  # '<'
            if i + 1 < sl and sp[i + 1] == 47:           # '</' close
                j: int32 = i + 2
                while j < sl and sp[j] != 62:
                    j = j + 1
                if depth > 0:
                    _frag_close_top(depth)
                    depth = depth - 1
                if j < sl:
                    j = j + 1
                i = j
                continue
            # start tag: <name attrs...> or <name .../>
            j2: int32 = i + 1
            ns: int32 = j2
            while j2 < sl and _is_name_ch(sp[j2]) != 0:
                j2 = j2 + 1
            nlen: int32 = j2 - ns
            # scan to the matching '>' (quote-aware: a '>' inside a quoted
            # attribute value does not end the tag, e.g. title="a>b").
            te: int32 = cast[int32](_hx_tag_end_p(sp, cast[uint64](sl), \
                                                  cast[uint64](j2)))
            selfclose: int32 = 0
            if te > ns and sp[te - 1] == 47:             # '<x .../>'
                selfclose = 1
            if nlen <= 0:
                i = te + 1
                continue
            cid: int32 = _cre_make_element(&sp[ns], nlen)
            if cid < 0:
                i = te + 1
                continue
            co: int32 = cre_obj[cid]
            attr_end: int32 = te
            if selfclose != 0:
                attr_end = te - 1
            _frag_set_attrs(co, sp, j2, attr_end)
            js_array_push(frag_st_arr[depth], co)
            # link to the enclosing fragment element (depth 0 = the innerHTML host,
            # patched by the caller since _parse_fragment doesn't know it).
            fp: int32 = js_null()
            if depth > 0 and frag_st_cid[depth] >= 0:
                fp = cre_obj[frag_st_cid[depth]]
            js_set_prop(co, cast[Ptr[uint8]]("parentNode"), 10, fp)
            js_set_prop(co, cast[Ptr[uint8]]("parentElement"), 13, fp)
            if _frag_is_void(&sp[ns], nlen) == 0 and selfclose == 0:
                if depth + 1 < FRAG_STACK_MAX:
                    depth = depth + 1
                    frag_st_cid[depth] = cid
                    frag_st_arr[depth] = js_new_array_v()
                    frag_st_txt[depth] = frag_txt_w
            else:
                # void/self-closed: empty child arrays for API symmetry
                em: int32 = js_new_array_v()
                js_set_prop(co, cast[Ptr[uint8]]("children"), 8, em)
                js_set_prop(co, cast[Ptr[uint8]]("childNodes"), 10, em)
            i = te + 1
            continue
        # text run up to the next '<'
        ts: int32 = i
        while i < sl and sp[i] != 60:
            i = i + 1
        if _frag_ws_only(sp, ts, i) == 0:
            # copy bytes into the shared textContent buffer (for ancestors)
            k: int32 = ts
            tstart: int32 = frag_txt_w
            while k < i and frag_txt_w < FRAG_TXT_CAP:
                frag_txt[frag_txt_w] = sp[k]
                frag_txt_w = frag_txt_w + 1
                k = k + 1
            tv: int32 = js_new_string(&frag_txt[tstart], cast[uint64](frag_txt_w - tstart))
            tco: int32 = _cre_make_text(tv)
            js_array_push(frag_st_arr[depth], tco)
    # close any elements left open by malformed markup
    while depth > 0:
        _frag_close_top(depth)
        depth = depth - 1


# Recursively mark a created subtree detached: the node itself and every cc_*
# (created->created) edge under it. Used by the innerHTML= setter so a wholesale
# replace does not leave stale created descendants live in the emitter/overlay.
def _cre_detach_subtree(cid: int32):
    if cid < 0 or cid >= cre_n or cre_gone[cid] != 0:
        return
    cre_gone[cid] = 1
    b: int32 = 0
    while b < cc_n:
        if cc_removed[b] == 0 and cc_owner[b] == cid:
            cc_removed[b] = 1
            _cre_detach_subtree(cc_child[b])
        b = b + 1


# Detach EVERY dynamically-created child of DOM node `thisv` from the RENDER
# tree, so an `innerHTML=` assignment fully replaces prior appendChild()/
# createElement() children (finding #3). The JS .children/.childNodes arrays are
# rebuilt by the caller, but the render walks the ap_*/cc_* created-node edges
# (_build_rewrite / _emit_created) and the selector overlay walks them too
# (_cx_walk) — without unlinking those edges the OLD created children re-emit
# ON TOP of the new fragment (the "7 lines for 4 tasks" doubling). A source
# element parents its created children via ap_* edges; a created node via cc_*.
def _innerhtml_detach_children(thisv: int32):
    el: int32 = _find_el_by_obj(thisv)
    if el >= 0:
        a: int32 = 0
        while a < ap_n:
            if ap_removed[a] == 0 and ap_parent[a] == el:
                ap_removed[a] = 1
                _cre_detach_subtree(ap_child[a])
            a = a + 1
        return
    pcid: int32 = _find_cre_by_obj(thisv)
    if pcid >= 0:
        c: int32 = 0
        while c < cc_n:
            if cc_removed[c] == 0 and cc_owner[c] == pcid:
                cc_removed[c] = 1
                _cre_detach_subtree(cc_child[c])
            c = c + 1


# member_set hook (registered via js_set_member_hook): fires after every
# `obj.prop = val`. We act only on `el.innerHTML = <string>` for a registered
# source element or created node, parsing the fragment into real child nodes.
def _js_member_set_hook(dummy: int32) -> int32:
    kv: int32 = js_mset_key()
    kp: Ptr[uint8] = js_str_ptr(kv)
    kn: int32 = _cstr_len(kp)
    # `location.href = "..."` re-parses the whole URL into location's components;
    # `location.hash = "#x"` updates the fragment (the assignment already stored
    # .hash) and rebuilds href, then fires a `hashchange` window event.
    if g_js_location >= 0 and js_mset_this() == g_js_location:
        if _bytes_eq(kp, kn, cast[Ptr[uint8]]("href"), 4) != 0:
            hv: int32 = js_mset_val()
            hvp: Ptr[uint8] = js_str_ptr(hv)
            hvn: int32 = _cstr_len(hvp)
            if _is_undef_str(hvp, hvn) == 0:
                _url_parse_into(g_js_location, hvp, hvn)
            return 0
        if _bytes_eq(kp, kn, cast[Ptr[uint8]]("hash"), 4) != 0:
            _loc_rebuild_href()
            _fire_win_event(cast[Ptr[uint8]]("hashchange"), 10, \
                            cast[Ptr[uint8]]("onhashchange"), 12, js_undefined(), 0)
            return 0
    # `document.adoptedStyleSheets = [sheet, ...]` — activate each constructible
    # sheet in the list so its replaceSync'd rules join the cascade. The array is
    # already stored on the object (so reads work); we only flip the model's
    # active flag. Any sheet id we don't recognise is ignored.
    if _bytes_eq(kp, kn, cast[Ptr[uint8]]("adoptedStyleSheets"), 18) != 0:
        avv: int32 = js_mset_val()
        if js_is_array(avv) != 0:
            an: int32 = js_array_len(avv)
            ai: int32 = 0
            while ai < an:
                asheet: int32 = js_array_get(avv, ai)
                asid: int32 = _sheet_id_of(asheet)
                if asid >= 0:
                    _cssom_set_active(asid, 1)
                ai = ai + 1
        return 0
    # `el.style.cssText = "color:red;display:none"` — `this` is the style object;
    # parse the string into its routed camelCase props so the cascade sees it.
    if _bytes_eq(kp, kn, cast[Ptr[uint8]]("cssText"), 7) != 0:
        csttv: int32 = js_mset_this()
        cvv: int32 = js_mset_val()
        cvp: Ptr[uint8] = js_str_ptr(cvv)
        cvn: int32 = _cstr_len(cvp)
        if _is_undef_str(cvp, cvn) == 0:
            _style_apply_csstext(csttv, cvp, cvn)
        return 0
    # characterData: assigning textContent / nodeValue / data on a
    # MutationObserver-observed node queues a characterData record. Guarded by
    # a live registry so script-free pages and internal node-building pay
    # nothing (and produce no spurious records).
    if mreg_n != 0:
        if _bytes_eq(kp, kn, cast[Ptr[uint8]]("textContent"), 11) != 0 or \
           _bytes_eq(kp, kn, cast[Ptr[uint8]]("nodeValue"), 9) != 0 or \
           _bytes_eq(kp, kn, cast[Ptr[uint8]]("data"), 4) != 0:
            _mo_record_chardata(js_mset_this())
    if _bytes_eq(kp, kn, cast[Ptr[uint8]]("innerHTML"), 9) == 0:
        return 0
    thisv: int32 = js_mset_this()
    if _find_el_by_obj(thisv) < 0 and _find_cre_by_obj(thisv) < 0:
        return 0                                          # not a DOM node yet
    valv: int32 = js_mset_val()
    # js_str_bytes: a pointer into the non-moving string pool. js_str_ptr's
    # 64 KiB scratch ring is recycled by _apply_inner_html's own js_str_ptr
    # calls and would be overwritten mid-parse.
    vp: Ptr[uint8] = js_str_bytes(valv)
    vn: int32 = js_str_bytelen(valv)
    if _is_undef_str(vp, vn) != 0:
        return 0
    _apply_inner_html(thisv, vp, vn)
    return 0


# Replace DOM node `thisv`'s inner content with the fragment parsed from
# vp[0..vn): detach prior created children, parse the fragment into real created
# child nodes, and refresh .children/.childNodes/.textContent/first-last child.
# The `.innerHTML` property itself is set by the caller (the member-set hook has
# it already assigned; insertAdjacentHTML assigns the concatenation) so the
# readback renders it via the raw-override path. Shared by innerHTML= and
# insertAdjacentHTML.
# Append p[0..n) into iah_buf at offset w; returns the new offset (bounded).
def _iah_append(w: int32, p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    while i < n and w < IAH_CAP:
        iah_buf[w] = p[i]
        w = w + 1
        i = i + 1
    return w


def _apply_inner_html(thisv: int32, vp: Ptr[uint8], vn: int32):
    # Detach prior createElement()/appendChild() children FIRST — clearing (or
    # replacing) innerHTML must remove the old created subtree from the render
    # tree, not just the JS .children array, or a re-render doubles content.
    _innerhtml_detach_children(thisv)
    root: int32 = js_new_array_v()
    _parse_fragment(vp, vn, root)
    js_set_prop(thisv, cast[Ptr[uint8]]("children"), 8, root)
    js_set_prop(thisv, cast[Ptr[uint8]]("childNodes"), 10, root)
    # top-level fragment children parent to the innerHTML host; wire their
    # sibling links (and refresh host first/lastElementChild below).
    rti: int32 = 0
    rtn: int32 = js_array_len(root)
    while rti < rtn:
        rtc: int32 = js_array_get(root, rti)
        js_set_prop(rtc, cast[Ptr[uint8]]("parentNode"), 10, thisv)
        js_set_prop(rtc, cast[Ptr[uint8]]("parentElement"), 13, thisv)
        rti = rti + 1
    _wire_sibling_links(root, js_null())
    # keep .textContent consistent with the new subtree (innerHTML raw-override
    # still wins in render, so this only affects a subsequent JS read).
    js_set_prop(thisv, cast[Ptr[uint8]]("textContent"), 11, \
                js_new_string(&frag_txt[0], cast[uint64](frag_txt_w)))
    fc: int32 = js_null()
    lc: int32 = js_null()
    if js_array_len(root) > 0:
        fc = js_array_get(root, 0)
        lc = js_array_get(root, js_array_len(root) - 1)
    js_set_prop(thisv, cast[Ptr[uint8]]("firstChild"), 10, fc)
    js_set_prop(thisv, cast[Ptr[uint8]]("firstElementChild"), 17, fc)
    js_set_prop(thisv, cast[Ptr[uint8]]("lastChild"), 9, lc)
    js_set_prop(thisv, cast[Ptr[uint8]]("lastElementChild"), 16, lc)


# The host-object dispatcher jsengine calls for native ids >= js_host_base().
# Does source element `el`'s start tag match single/rightmost-compound selector
# selp[0..seln)? A descendant selector degrades to its rightmost compound (the
# documented round-1 approximation, shared with querySelector).
# Does a CREATED element (by cre id) match selector-list selp[0..seln)? Splits
# the comma list, and for each sub-selector matches the RIGHTMOST compound
# against the node's JS props (tag/class/id/[attr]) — a descendant/child
# combinator degrades to its rightmost compound, the same round-1 approximation
# _el_matches_sel uses for source nodes. Basis for matches()/closest() on
# created nodes (which have no source tree index).
def _creobj_matches_any(cid: int32, selp: Ptr[uint8], seln: int32) -> int32:
    if cid < 0 or seln <= 0:
        return 0
    _sel_split(selp, seln)
    k: int32 = 0
    while k < g_sellist_n:
        so: int32 = g_sellist_off[k]
        sl: int32 = g_sellist_len[k]
        # rightmost compound: scan back to the last combinator/space
        rs: int32 = so
        j: int32 = so + sl - 1
        while j >= so:
            cbj: uint8 = selp[j]
            if cbj == 32 or cbj == 62 or cbj == 43 or cbj == 126:
                rs = j + 1
                j = -1
            else:
                j = j - 1
        if _cid_sel_match(cid, &selp[rs], (so + sl) - rs) != 0:
            return 1
        k = k + 1
    return 0


def _el_matches_sel(el: int32, selp: Ptr[uint8], seln: int32) -> int32:
    if el < 0 or seln <= 0:
        return 0
    t: int32 = _tx_by_anchor(dom_anchor[el])
    _sel_split(selp, seln)
    k: int32 = 0
    while k < g_sellist_n:
        _sel_parse(&selp[g_sellist_off[k]], g_sellist_len[k])
        if g_nc != 0:
            if t >= 0:
                if _match_chain(t, g_nc - 1) != 0:         # full combinator/pseudo chain
                    return 1
            else:
                # No tree index (matched before layout): fall back to a single
                # rightmost-compound base match (tag/class/id/[attr]).
                rc: int32 = g_nc - 1
                rbl: int32 = 0
                while rbl < g_comp_len[rc] and g_selbuf[g_comp_off[rc] + rbl] != 58:
                    rbl = rbl + 1
                ts: uint64 = cast[uint64](dom_ns[el])
                ne: uint64 = ts + cast[uint64](dom_nl[el])
                je: uint64 = cast[uint64](dom_cstart[el]) - 1
                if g_nc == 1 and rbl > 0 and \
                   _sel_match_at(ts, je, ne, &g_selbuf[g_comp_off[rc]], rbl) != 0:
                    return 1
        k = k + 1
    return 0


# Does tx-tree node `t` (used while climbing ancestors for closest()) match ANY
# sub-selector of the list selp[0..seln), full combinator/pseudo chain included?
def _tx_matches_sel(t: int32, selp: Ptr[uint8], seln: int32) -> int32:
    if seln <= 0:
        return 0
    _sel_split(selp, seln)
    k: int32 = 0
    while k < g_sellist_n:
        _sel_parse(&selp[g_sellist_off[k]], g_sellist_len[k])
        if g_nc != 0 and _match_chain(t, g_nc - 1) != 0:
            return 1
        k = k + 1
    return 0


# Is byte `c` a legal HTML attribute-name character (letters/digits/-/_/:/.)?
def _is_attr_name_ch(c: uint8) -> int32:
    lc: uint8 = _hx_lower(c)
    if (lc >= 97 and lc <= 122) or (c >= 48 and c <= 57) or \
       c == 45 or c == 95 or c == 58 or c == 46:
        return 1
    return 0


# Walk source element `el`'s start-tag attribute list. For each attribute name
# token, if `arr` >= 0 push it as a lower-cased JS string; always count it.
# Returns the number of attributes. Quote-aware (skips over `="..."` values).
def _scan_attr_names(el: int32, arr: int32) -> int32:
    if el < 0:
        return 0
    bs: uint64 = cast[uint64](dom_ns[el]) + cast[uint64](dom_nl[el])
    be: uint64 = cast[uint64](dom_cstart[el]) - 1          # the start tag's '>'
    n: int32 = 0
    i: uint64 = bs
    while i < be:
        c: uint8 = src_ptr[i]
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 47:  # ws or '/'
            i = i + 1
            continue
        if _is_attr_name_ch(c) == 0:
            i = i + 1
            continue
        ns: uint64 = i
        while i < be and _is_attr_name_ch(src_ptr[i]) != 0:
            i = i + 1
        # emit the name (lower-cased) [ns, i)
        if arr >= 0:
            an: Array[64, uint8]
            w: int32 = 0
            p: uint64 = ns
            while p < i and w < 63:
                an[w] = _hx_lower(src_ptr[p])
                w = w + 1
                p = p + 1
            js_array_push(arr, js_new_string(&an[0], cast[uint64](w)))
        n = n + 1
        # skip an optional ="value" / =value so its bytes aren't mis-scanned
        while i < be and (src_ptr[i] == 32 or src_ptr[i] == 9):
            i = i + 1
        if i < be and src_ptr[i] == 61:                    # '='
            i = i + 1
            while i < be and (src_ptr[i] == 32 or src_ptr[i] == 9):
                i = i + 1
            if i < be and (src_ptr[i] == 34 or src_ptr[i] == 39):
                q: uint8 = src_ptr[i]
                i = i + 1
                while i < be and src_ptr[i] != q:
                    i = i + 1
                if i < be:
                    i = i + 1
            else:
                while i < be and src_ptr[i] != 32 and src_ptr[i] != 9:
                    i = i + 1
    return n


def _collect_attr_names(el: int32, arr: int32):
    _scan_attr_names(el, arr)


def _count_attrs(el: int32) -> int32:
    return _scan_attr_names(el, -1)


# ---- classList owner resolution (source OR created element) -----------------
# _find_el_by_clsobj only knows SOURCE elements. A created element's token list
# is registered in clsown_* instead, so the whole DOMTokenList family works on
# document.createElement(...) nodes too.
def _clsown_add(clsv: int32, objv: int32):
    if clsown_n >= CLSOWN_MAX:
        return
    clsown_list[clsown_n] = clsv
    clsown_obj[clsown_n] = objv
    clsown_n = clsown_n + 1


def _cls_owner_obj(clsv: int32) -> int32:
    e: int32 = _find_el_by_clsobj(clsv)
    if e >= 0:
        return dom_obj[e]
    i: int32 = 0
    while i < clsown_n:
        if clsown_list[i] == clsv:
            return clsown_obj[i]
        i = i + 1
    return 0


# _cls_read / _cls_write keyed on the element OBJECT rather than its dom_* row.
def _cls_read_o(objv: int32) -> Ptr[uint8]:
    clv: int32 = js_get_prop(objv, cast[Ptr[uint8]]("className"), 9)
    p: Ptr[uint8] = js_str_ptr(clv)
    n: int32 = _cstr_len(p)
    if n > 1023:
        n = 1023
    if _is_undef_str(p, n) != 0:
        n = 0
    i: int32 = 0
    while i < n:
        g_cls_cur[i] = p[i]
        i = i + 1
    g_cls_cur[n] = 0
    g_cls_len = n
    return &g_cls_cur[0]


def _cls_write_o(objv: int32, s: Ptr[uint8], sn: int32):
    js_set_prop(objv, cast[Ptr[uint8]]("className"), 9, \
                js_new_string(s, cast[uint64](sn)))


# ---- namespaced / created-element attribute store ---------------------------
def _nsa_push(p: Ptr[uint8], n: int32) -> int32:
    off: int32 = nsa_buf_len
    i: int32 = 0
    while i < n and nsa_buf_len < 65536:
        nsa_buf[nsa_buf_len] = p[i]
        nsa_buf_len = nsa_buf_len + 1
        i = i + 1
    return off


def _nsa_seg_eq(off: int32, ln: int32, p: Ptr[uint8], n: int32) -> int32:
    if ln != n:
        return 0
    i: int32 = 0
    while i < n:
        if nsa_buf[off + i] != p[i]:
            return 0
        i = i + 1
    return 1


# Match on (element, namespace, localName). `nsn` < 0 means the null namespace.
def _nsa_find(objv: int32, nsp: Ptr[uint8], nsn: int32, lp: Ptr[uint8], \
              ln: int32) -> int32:
    i: int32 = 0
    while i < nsa_n:
        if nsa_obj[i] == objv and _nsa_seg_eq(nsa_lnoff[i], nsa_lnlen[i], lp, ln) != 0:
            if nsn < 0:
                if nsa_nslen[i] < 0:
                    return i
            elif nsa_nslen[i] >= 0 and \
                 _nsa_seg_eq(nsa_nsoff[i], nsa_nslen[i], nsp, nsn) != 0:
                return i
        i = i + 1
    return -1


def _nsa_set(objv: int32, nsp: Ptr[uint8], nsn: int32, pfp: Ptr[uint8], \
             pfn: int32, lp: Ptr[uint8], ln: int32, vp: Ptr[uint8], vn: int32):
    old: int32 = _nsa_find(objv, nsp, nsn, lp, ln)
    if old >= 0:
        nsa_vloff[old] = _nsa_push(vp, vn)
        nsa_vllen[old] = vn
        return
    if nsa_n >= NSA_MAX or nsa_buf_len + nsn + pfn + ln + vn + 8 >= 65536:
        return
    k: int32 = nsa_n
    nsa_obj[k] = objv
    nsa_nslen[k] = nsn
    if nsn > 0:
        nsa_nsoff[k] = _nsa_push(nsp, nsn)
    nsa_pflen[k] = pfn
    if pfn > 0:
        nsa_pfoff[k] = _nsa_push(pfp, pfn)
    nsa_lnoff[k] = _nsa_push(lp, ln)
    nsa_lnlen[k] = ln
    nsa_vloff[k] = _nsa_push(vp, vn)
    nsa_vllen[k] = vn
    nsa_n = k + 1


# Append this element's stored attributes to its NamedNodeMap.
def _nsa_collect(objv: int32, m: int32):
    i: int32 = 0
    while i < nsa_n:
        if nsa_obj[i] == objv:
            qw: int32 = 0
            if nsa_pflen[i] > 0:
                k: int32 = 0
                while k < nsa_pflen[i] and qw < 250:
                    nnm_name[qw] = nsa_buf[nsa_pfoff[i] + k]
                    qw = qw + 1
                    k = k + 1
                nnm_name[qw] = 58                          # ':'
                qw = qw + 1
            j: int32 = 0
            while j < nsa_lnlen[i] and qw < 251:
                nnm_name[qw] = nsa_buf[nsa_lnoff[i] + j]
                qw = qw + 1
                j = j + 1
            nnm_name[qw] = 0
            av: int32 = _new_attr_obj(&nnm_name[0], qw, \
                        js_new_string(&nsa_buf[nsa_vloff[i]], \
                                      cast[uint64](nsa_vllen[i])), objv)
            if nsa_nslen[i] > 0:
                js_set_prop(av, cast[Ptr[uint8]]("namespaceURI"), 12, \
                            js_new_string(&nsa_buf[nsa_nsoff[i]], \
                                          cast[uint64](nsa_nslen[i])))
            i = i + 1
            js_array_push(m, av)
        else:
            i = i + 1


# Split a qualified name into prefix / localName inside nsq_buf-independent
# scratch. Returns the index of the ':' or -1.
def _qname_colon(qp: Ptr[uint8], qn: int32) -> int32:
    i: int32 = 0
    while i < qn:
        if qp[i] == 58:
            return i
        i = i + 1
    return -1


# ---- namespace-aware attribute + tag-name API -------------------------------
# Modelled on the OBJECT-keyed nsa_* store so a created element and a source
# element behave the same. setAttributeNS also mirrors the value into the plain
# attribute path, because the qualified name IS the key getAttribute() uses.
nsa_lp:  Array[128, uint8]           # localName scratch
nsa_pp:  Array[128, uint8]           # prefix scratch
nsa_vv:  Array[4096, uint8]          # value scratch


def _ns_dispatch(rel: int32) -> int32:
    thisv: int32 = js_this()
    nsn: int32 = -1
    if js_arg_count() >= 1 and js_type_of(js_arg(0)) != TAG_NULL and \
       js_type_of(js_arg(0)) != TAG_UNDEF:
        nsn = _arg_bytes(0, &nsuri_buf[0], 256)
        if nsn == 0:
            nsn = -1
    if rel == NID_GETBYTAGNS:
        garr: int32 = js_new_array_v()
        gln: int32 = 0
        if js_arg_count() >= 2:
            gln = _arg_bytes(1, &nsa_lp[0], 128)
        gall: int32 = js_new_array_v()
        _set_query_scope()
        _dom_collect_selector(cast[Ptr[uint8]]("*"), 1, g_qlo, g_qhi, gall)
        _cre_collect(cast[Ptr[uint8]]("*"), 1, gall)
        gi: int32 = 0
        while gi < js_array_len(gall):
            gel: int32 = js_array_get(gall, gi)
            if _ns_el_matches(gel, nsn, &nsa_lp[0], gln) != 0:
                js_array_push(garr, gel)
            gi = gi + 1
        return garr
    # the remaining four take (namespace, name-ish) — split per method below.
    if rel == NID_SETATTRNS:
        if js_arg_count() < 3:
            return js_undefined()
        qn: int32 = _arg_bytes(1, &nsq_buf[0], 128)
        qc: int32 = _validate_qname(&nsq_buf[0], qn, &nsuri_buf[0], nsn)
        if qc != 0:
            return _throw_qname(qc)
        col: int32 = _qname_colon(&nsq_buf[0], qn)
        pfn: int32 = -1
        lo: int32 = 0
        if col >= 0:
            pfn = col
            lo = col + 1
        k: int32 = 0
        while k < pfn and k < 128:
            nsa_pp[k] = nsq_buf[k]
            k = k + 1
        j: int32 = 0
        while lo + j < qn and j < 128:
            nsa_lp[j] = nsq_buf[lo + j]
            j = j + 1
        vn: int32 = _arg_bytes(2, &nsa_vv[0], 4096)
        _nsa_set(thisv, &nsuri_buf[0], nsn, &nsa_pp[0], pfn, &nsa_lp[0], j, \
                 &nsa_vv[0], vn)
        # getAttribute(qualifiedName) must see it too.
        sel: int32 = _find_el_by_obj(thisv)
        if sel >= 0:
            _sattr_set(sel, &nsq_buf[0], qn, &nsa_vv[0], vn)
        else:
            nsq_buf[qn] = 0
            js_set_prop(thisv, &nsq_buf[0], cast[uint64](qn), js_arg(2))
        g_attr_gen = g_attr_gen + 1
        return js_undefined()
    ln2: int32 = 0
    if js_arg_count() >= 2:
        ln2 = _arg_bytes(1, &nsa_lp[0], 128)
    idx: int32 = _nsa_find(thisv, &nsuri_buf[0], nsn, &nsa_lp[0], ln2)
    if rel == NID_HASATTRNS:
        if idx >= 0:
            return js_bool(1)
        # An attribute that came from the source start tag has no nsa_* row;
        # in an HTML document it is in the null namespace.
        if nsn < 0:
            nsa_lp[ln2] = 0
            return js_bool(_el_has_attribute(thisv, &nsa_lp[0], ln2))
        return js_bool(0)
    if rel == NID_GETATTRNS:
        if idx >= 0:
            return js_new_string(&nsa_buf[nsa_vloff[idx]], \
                                 cast[uint64](nsa_vllen[idx]))
        if nsn < 0:
            nsa_lp[ln2] = 0
            return _el_get_attribute(thisv, &nsa_lp[0], ln2)
        return js_null()
    # NID_REMATTRNS
    if idx >= 0:
        nsa_obj[idx] = -1
        g_attr_gen = g_attr_gen + 1
    return js_undefined()


# Does element `elv` match getElementsByTagNameNS(ns, local)? "*" matches all.
def _ns_el_matches(elv: int32, nsn: int32, lp: Ptr[uint8], ln: int32) -> int32:
    if js_type_of(elv) != TAG_OBJ:
        return 0
    nsv: int32 = js_get_prop(elv, cast[Ptr[uint8]]("namespaceURI"), 12)
    if nsn == 1 and nsuri_buf[0] == 42:                    # namespace "*"
        pass
    elif nsn < 0:
        if js_type_of(nsv) == TAG_STR and js_str_bytelen(nsv) > 0:
            return 0
    else:
        if js_type_of(nsv) != TAG_STR:
            return 0
        if _bytes_eq(js_str_bytes(nsv), js_str_bytelen(nsv), \
                     &nsuri_buf[0], nsn) == 0:
            return 0
    if ln == 1 and lp[0] == 42:                            # localName "*"
        return 1
    lv: int32 = js_get_prop(elv, cast[Ptr[uint8]]("localName"), 9)
    if js_type_of(lv) != TAG_STR:
        return 0
    return _bytes_eq(js_str_bytes(lv), js_str_bytelen(lv), lp, ln)


# element.hasAttribute(name), as a plain function (see _el_get_attribute).
def _el_has_attribute(thisv: int32, np: Ptr[uint8], n: int32) -> int32:
    v: int32 = _el_get_attribute(thisv, np, n)
    if js_type_of(v) == TAG_NULL or js_type_of(v) == TAG_UNDEF:
        return 0
    return 1


# Does created element `elv` answer to getElementsByTagName(`np`[0..nn))?
def _gbt_name_matches(elv: int32, np: Ptr[uint8], nn: int32) -> int32:
    if js_type_of(elv) != TAG_OBJ:
        # Past the DOM_MAX ceiling the collector emits undefined placeholders
        # so the collection LENGTH still matches the document (see
        # tests/fixtures/hambrowse_ceilings.html). Pass them through untouched.
        return 1
    if nn == 1 and np[0] == 42:                            # "*"
        return 1
    # The QUALIFIED name (prefix:localName), not tagName — tagName is the
    # upper-cased form for HTML-namespace elements and would match "abc"
    # against a node whose real qualified name is "Abc".
    qv: int32 = js_get_prop(elv, cast[Ptr[uint8]]("localName"), 9)
    if js_type_of(qv) != TAG_STR:
        return 1
    qw: int32 = 0
    pfv: int32 = js_get_prop(elv, cast[Ptr[uint8]]("prefix"), 6)
    if js_type_of(pfv) == TAG_STR:
        pfp: Ptr[uint8] = js_str_bytes(pfv)
        pfn: int32 = js_str_bytelen(pfv)
        while qw < pfn and qw < 254:
            gbt_qn[qw] = pfp[qw]
            qw = qw + 1
        gbt_qn[qw] = 58                                    # ':'
        qw = qw + 1
    lp: Ptr[uint8] = js_str_bytes(qv)
    ln: int32 = js_str_bytelen(qv)
    li: int32 = 0
    while li < ln and qw < 255:
        gbt_qn[qw] = lp[li]
        qw = qw + 1
        li = li + 1
    nsv: int32 = js_get_prop(elv, cast[Ptr[uint8]]("namespaceURI"), 12)
    ishtml: int32 = 0
    if js_type_of(nsv) == TAG_STR and \
       _bytes_eq(js_str_bytes(nsv), js_str_bytelen(nsv), \
                 cast[Ptr[uint8]]("http://www.w3.org/1999/xhtml"), 28) != 0:
        ishtml = 1
    if ishtml == 0:
        # Non-HTML namespace: the qualified name must equal the argument
        # EXACTLY (case-sensitively).
        return _bytes_eq(&gbt_qn[0], qw, np, nn)
    # HTML namespace in an HTML document: the qualified name must equal the
    # LOWERCASED argument. An <Abc> in the HTML namespace therefore does NOT
    # answer to getElementsByTagName("Abc").
    if qw != nn:
        return 0
    i: int32 = 0
    while i < nn:
        if gbt_qn[i] != _hx_lower(np[i]):
            return 0
        i = i + 1
    return 1


# element.getAttribute(name) as a plain function of (element object, name) so
# the NamedNodeMap builder below can reuse the EXACT same resolution order the
# JS-visible method uses (override store -> source start tag -> reflected
# property) rather than growing a second, divergent copy of it.
# HTML's "ASCII whitespace" — TAB, LF, FF, CR, SPACE — and deliberately NOT the
# Unicode space characters. WPT's
# getElementsByClassName-whitespace-class-names.html asserts that NO-BREAK
# SPACE, OGHAM SPACE MARK, EN/EM QUAD, IDEOGRAPHIC SPACE and friends are
# ordinary class-NAME characters, so `class="&#x00A0;"` is one class whose name
# is a non-breaking space, not an empty class list.
def _is_ascii_ws(c: uint8) -> int32:
    if c == 32 or c == 9 or c == 10 or c == 12 or c == 13:
        return 1
    return 0


# Is `tp[0..tn)` one of the ASCII-whitespace-separated tokens of `cp[0..cn)`?
# Byte-exact: getElementsByClassName is case-sensitive in standards mode.
def _cls_has_token(cp: Ptr[uint8], cn: int32, tp: Ptr[uint8], tn: int32) -> int32:
    i: int32 = 0
    while i < cn:
        while i < cn and _is_ascii_ws(cp[i]) != 0:
            i = i + 1
        s: int32 = i
        while i < cn and _is_ascii_ws(cp[i]) == 0:
            i = i + 1
        if i > s and i - s == tn and _bytes_eq(&cp[s], tn, tp, tn) != 0:
            return 1
    return 0


# Does this element carry EVERY class in the argument's token list? An argument
# with no tokens at all matches nothing (DOM: "if classes is the empty set,
# return an empty HTMLCollection").
def _gbc_matches(elv: int32, tp: Ptr[uint8], tn: int32) -> int32:
    cv: int32 = _el_get_attribute(elv, cast[Ptr[uint8]]("class"), 5)
    if js_type_of(cv) != TAG_STR:
        return 0
    cp: Ptr[uint8] = js_str_bytes(cv)
    cn: int32 = js_str_bytelen(cv)
    seen: int32 = 0
    i: int32 = 0
    while i < tn:
        while i < tn and _is_ascii_ws(tp[i]) != 0:
            i = i + 1
        s: int32 = i
        while i < tn and _is_ascii_ws(tp[i]) == 0:
            i = i + 1
        if i > s:
            seen = 1
            if _cls_has_token(cp, cn, &tp[s], i - s) == 0:
                return 0
    return seen


def _el_get_attribute(thisv: int32, nmp: Ptr[uint8], an: int32) -> int32:
    # 'style' mirrors the .style store (serialized), so getAttribute and
    # .style stay consistent for both source and created nodes.
    if _bytes_eq(nmp, an, cast[Ptr[uint8]]("style"), 5) != 0:
        gsto: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("style"), 5)
        return _style_serialize(gsto)
    el2: int32 = _find_el_by_obj(thisv)
    if el2 >= 0:
        # a setAttribute()/removeAttribute() override outranks the
        # source start tag (chromium: getAttribute reports the CURRENT
        # content attribute, not the parsed one).
        so: int32 = _sattr_find(el2, nmp, an)
        if so >= 0:
            if sattr_vlen[so] < 0:
                return js_null()
            return js_new_string(&sattr_buf[sattr_voff[so]], \
                                 cast[uint64](sattr_vlen[so]))
        te2: uint64 = cast[uint64](dom_cstart[el2]) - 1
        if _hx_find_attr(cast[uint64](dom_ns[el2]), te2, nmp) != 0:
            # ENTITY-DECODED, like every other attribute read: chromium
            # answers "?a=1&b=2" for href="?a=1&amp;b=2", not the raw
            # source text.
            vlen: int32 = _attr_decode_scratch()
            return js_new_string(&g_attrdec[0], cast[uint64](vlen))
        # Not in the source tag: a prior setAttribute() stored the value as
        # a property on the element's JS object — honour that round-trip
        # (e.g. data-*/aria-* attributes added at runtime).
        if _bytes_eq(nmp, an, cast[Ptr[uint8]]("class"), 5) != 0:
            gcv: int32 = js_get_prop(dom_obj[el2], \
                                     cast[Ptr[uint8]]("className"), 9)
            gcp: Ptr[uint8] = js_str_ptr(gcv)
            if _is_undef_str(gcp, _cstr_len(gcp)) == 0:
                return gcv
            return js_null()
        gpv: int32 = js_get_prop(dom_obj[el2], nmp, cast[uint64](an))
        gpp: Ptr[uint8] = js_str_ptr(gpv)
        if _is_undef_str(gpp, _cstr_len(gpp)) == 0:
            # `src`/`href`/`alt`/`title` are reflected onto every element
            # object and DEFAULT to "" (IDL String semantics, so
            # `img.src.substring(...)` never throws). But getAttribute
            # reports the CONTENT attribute, which is genuinely absent
            # here — the source tag was already checked above — so it must
            # still answer null, not "".
            if _cstr_len(gpp) == 0 and _is_reflected_idl_attr(nmp, an) != 0:
                return js_null()
            return gpv
        return js_null()
    # created node: the object-keyed attribute store is authoritative (it is
    # where setAttribute() lower-cases the name), then the stashed property.
    gni: int32 = 0
    while gni < an and gni < 128:
        nsa_lp[gni] = _hx_lower(nmp[gni])
        gni = gni + 1
    gns: int32 = _nsa_find(thisv, cast[Ptr[uint8]](""), -1, &nsa_lp[0], gni)
    if gns >= 0:
        return js_new_string(&nsa_buf[nsa_vloff[gns]], \
                             cast[uint64](nsa_vllen[gns]))
    gcid: int32 = _find_cre_by_obj(thisv)
    if gcid >= 0:
        if _bytes_eq(nmp, an, cast[Ptr[uint8]]("class"), 5) != 0:
            return js_get_prop(cre_obj[gcid], \
                               cast[Ptr[uint8]]("className"), 9)
        return js_get_prop(cre_obj[gcid], nmp, cast[uint64](an))
    return js_null()


# ---- Constraint Validation helpers ---------------------------------
# A minimal, WHATWG-shaped e-mail check (a deliberate willful violation like the
# HTML spec's own): exactly one '@' with a non-empty local part and a non-empty,
# whitespace-free domain part. Rejects "abc" (no '@'); accepts "a@b" / "a@b.com".
def _is_valid_email(p: Ptr[uint8], n: int32) -> int32:
    at: int32 = -1
    i: int32 = 0
    while i < n:
        c: uint8 = p[i]
        if c == 32 or c == 9:
            return 0
        if c == 64:                                        # '@'
            if at >= 0:
                return 0                                    # two '@' -> invalid
            at = i
        i = i + 1
    if at <= 0 or at >= n - 1:
        return 0                                            # need a char on both sides
    return 1


# A url is accepted when it carries a "scheme://rest" shape (something before
# "://" and something after). Enough to reject a bare "abc".
def _is_valid_url(p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    while i + 2 < n:
        if p[i] == 58 and p[i + 1] == 47 and p[i + 2] == 47:   # "://"
            if i > 0 and i + 3 < n:
                return 1
            return 0
        i = i + 1
    return 0


# A floating-point literal per type=number: optional sign, digits, optional
# fractional part; the WHOLE string must be consumed. Rejects "abc".
def _is_number(p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    if i < n and (p[i] == 43 or p[i] == 45):               # '+' / '-'
        i = i + 1
    digits: int32 = 0
    while i < n and p[i] >= 48 and p[i] <= 57:
        i = i + 1
        digits = digits + 1
    if i < n and p[i] == 46:                               # '.'
        i = i + 1
        while i < n and p[i] >= 48 and p[i] <= 57:
            i = i + 1
            digits = digits + 1
    if digits == 0 or i != n:
        return 0
    return 1


# Signed integer part of a numeric literal (fraction ignored) — used for
# min/max range comparison.
def _num_int(p: Ptr[uint8], n: int32) -> int64:
    i: int32 = 0
    sign: int64 = 1
    if i < n and p[i] == 45:
        sign = -1
        i = i + 1
    elif i < n and p[i] == 43:
        i = i + 1
    v: int64 = 0
    while i < n and p[i] >= 48 and p[i] <= 57:
        v = v * 10 + cast[int64](p[i] - 48)
        i = i + 1
    return sign * v


# Read a signed-int attribute (min/max/maxlength) from tag body [ts,te). Sets
# present[0]=1 when the attribute exists, else 0.
def _attr_int64(ts: uint64, te: uint64, name: Ptr[uint8], present: Ptr[int32]) -> int64:
    present[0] = 0
    if _hx_find_attr(ts, te, name) == 0:
        return 0
    present[0] = 1
    return _num_int(&src_ptr[g_attr_start], cast[int32](g_attr_end - g_attr_start))


# Write the freshly-computed ValidityState booleans + validationMessage back onto
# the control's live JS object, so `el.validity.valueMissing` etc. read true.
def _write_validity(el: int32, obj: int32, vm: int32, vt: int32, vl: int32, \
                    vu: int32, vov: int32, vb: int32, vc: int32, valid: int32):
    vo: int32 = js_get_prop(obj, cast[Ptr[uint8]]("validity"), 8)
    js_set_prop(vo, cast[Ptr[uint8]]("valueMissing"), 12, js_bool(vm))
    js_set_prop(vo, cast[Ptr[uint8]]("typeMismatch"), 12, js_bool(vt))
    js_set_prop(vo, cast[Ptr[uint8]]("patternMismatch"), 15, js_bool(0))
    js_set_prop(vo, cast[Ptr[uint8]]("tooLong"), 7, js_bool(vl))
    js_set_prop(vo, cast[Ptr[uint8]]("tooShort"), 8, js_bool(0))
    js_set_prop(vo, cast[Ptr[uint8]]("rangeUnderflow"), 14, js_bool(vu))
    js_set_prop(vo, cast[Ptr[uint8]]("rangeOverflow"), 13, js_bool(vov))
    js_set_prop(vo, cast[Ptr[uint8]]("stepMismatch"), 12, js_bool(0))
    js_set_prop(vo, cast[Ptr[uint8]]("badInput"), 8, js_bool(vb))
    js_set_prop(vo, cast[Ptr[uint8]]("customError"), 11, js_bool(vc))
    js_set_prop(vo, cast[Ptr[uint8]]("valid"), 5, js_bool(valid))
    if vc != 0:
        js_set_prop(obj, cast[Ptr[uint8]]("validationMessage"), 17, \
            js_new_string(&dom_customval_buf[dom_customval_off[el]], \
                          dom_customval_len[el]))
    elif valid == 0:
        js_set_prop(obj, cast[Ptr[uint8]]("validationMessage"), 17, \
            js_new_string(cast[Ptr[uint8]]("Please fill in this field."), 26))
    else:
        js_set_prop(obj, cast[Ptr[uint8]]("validationMessage"), 17, \
            js_new_string(cast[Ptr[uint8]](""), 0))


# Constraint-Validation for one control. Computes valueMissing (required+empty),
# typeMismatch (email/url), badInput (type=number non-numeric), tooLong
# (maxlength), rangeUnderflow/Overflow (number min/max), and customError
# (setCustomValidity). Refreshes the control's .validity object + .validationMessage
# and returns 1 when valid, 0 when it blocks submission. Reads the live JS `.value`.
def _dom_control_valid(el: int32) -> int32:
    obj: int32 = dom_obj[el]
    ts: uint64 = cast[uint64](dom_ns[el])
    te: uint64 = cast[uint64](dom_cstart[el]) - 1
    vv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("value"), 5)
    vp: Ptr[uint8] = js_str_ptr(vv)
    vn: int32 = _cstr_len(vp)
    if _is_undef_str(vp, vn) != 0:
        vn = 0
    tyv: int32 = js_get_prop(obj, cast[Ptr[uint8]]("type"), 4)
    typ: Ptr[uint8] = js_str_ptr(tyv)
    tyn: int32 = _cstr_len(typ)
    is_num: int32 = _bytes_eq(typ, tyn, cast[Ptr[uint8]]("number"), 6)
    v_missing: int32 = 0
    if hx_has_bool_attr(ts, te, cast[Ptr[uint8]]("required")) != 0 and vn == 0:
        v_missing = 1
    v_type: int32 = 0
    if vn > 0:
        if _bytes_eq(typ, tyn, cast[Ptr[uint8]]("email"), 5) != 0 and \
           _is_valid_email(vp, vn) == 0:
            v_type = 1
        elif _bytes_eq(typ, tyn, cast[Ptr[uint8]]("url"), 3) != 0 and \
             _is_valid_url(vp, vn) == 0:
            v_type = 1
    v_badinput: int32 = 0
    if vn > 0 and is_num != 0 and _is_number(vp, vn) == 0:
        v_badinput = 1
    v_toolong: int32 = 0
    mlp: int32 = 0
    ml: int64 = _attr_int64(ts, te, cast[Ptr[uint8]]("maxlength"), &mlp)
    if mlp != 0 and cast[int64](vn) > ml:
        v_toolong = 1
    v_under: int32 = 0
    v_over: int32 = 0
    if vn > 0 and is_num != 0 and v_badinput == 0:
        val: int64 = _num_int(vp, vn)
        minp: int32 = 0
        mn: int64 = _attr_int64(ts, te, cast[Ptr[uint8]]("min"), &minp)
        if minp != 0 and val < mn:
            v_under = 1
        maxp: int32 = 0
        mx: int64 = _attr_int64(ts, te, cast[Ptr[uint8]]("max"), &maxp)
        if maxp != 0 and val > mx:
            v_over = 1
    v_custom: int32 = 0
    if dom_customval_len[el] > 0:
        v_custom = 1
    valid: int32 = 1
    if v_missing != 0 or v_type != 0 or v_badinput != 0 or v_toolong != 0 or \
       v_under != 0 or v_over != 0 or v_custom != 0:
        valid = 0
    _write_validity(el, obj, v_missing, v_type, v_toolong, v_under, v_over, \
                    v_badinput, v_custom, valid)
    return valid


# Validate every control in form `formel`'s .elements list, refreshing each
# control's .validity object. Returns 1 when ALL are valid, 0 otherwise. Does not
# short-circuit, so a whole-form check leaves every control's state up to date.
def _form_check_all(formel: int32) -> int32:
    els: int32 = js_get_prop(dom_obj[formel], cast[Ptr[uint8]]("elements"), 8)
    if js_is_array(els) == 0:
        return 1
    ok: int32 = 1
    ei: int32 = 0
    eln: int32 = js_array_len(els)
    while ei < eln:
        cel: int32 = _find_el_by_obj(js_array_get(els, ei))
        if cel >= 0 and _dom_control_valid(cel) == 0:
            ok = 0
        ei = ei + 1
    return ok


# ---- History API + Location (window.history / window.location) --------------
# Set object `o`'s string property `name` to the byte slice p[s..e).
def _loc_set_slice(o: int32, name: Ptr[uint8], nlen: uint64, p: Ptr[uint8], s: int32, e: int32):
    m: int32 = 0
    i: int32 = s
    while i < e and m < 2047:
        url_scratch[m] = p[i]
        m = m + 1
        i = i + 1
    js_set_prop(o, name, nlen, js_new_string(&url_scratch[0], cast[uint64](m)))


def _loc_set_empty(o: int32, name: Ptr[uint8], nlen: uint64):
    js_set_prop(o, name, nlen, js_new_string(cast[Ptr[uint8]](""), cast[uint64](0)))


# Parse URL bytes p[0..n) into location object `loc`'s WHATWG-URL components:
# href / protocol / host / hostname / port / pathname / search / hash / origin.
# Hierarchical (scheme://authority/path) and opaque (scheme:opaque) URLs are both
# handled; a relative reference (no scheme) fills pathname/search/hash only.
def _url_parse_into(loc: int32, p: Ptr[uint8], n: int32):
    if loc < 0:
        return
    js_set_prop(loc, cast[Ptr[uint8]]("href"), cast[uint64](4), \
                js_new_string(p, cast[uint64](n)))
    # scheme: bytes up to the first ':' (must precede any '/', '?' or '#').
    ci: int32 = 0
    while ci < n and p[ci] != 58 and p[ci] != 47 and p[ci] != 63 and p[ci] != 35:
        ci = ci + 1
    has_scheme: int32 = 0
    scheme_end: int32 = 0
    hier: int32 = 0
    rest_start: int32 = 0
    if ci < n and p[ci] == 58:
        has_scheme = 1
        scheme_end = ci
        if ci + 2 < n and p[ci + 1] == 47 and p[ci + 2] == 47:
            hier = 1
            rest_start = ci + 3
        else:
            rest_start = ci + 1
    # protocol = scheme + ':'  (empty for a relative reference).
    if has_scheme != 0:
        pm: int32 = 0
        pi: int32 = 0
        while pi < scheme_end and pm < 2047:
            url_scratch[pm] = p[pi]
            pm = pm + 1
            pi = pi + 1
        url_scratch[pm] = 58
        pm = pm + 1
        js_set_prop(loc, cast[Ptr[uint8]]("protocol"), cast[uint64](8), \
                    js_new_string(&url_scratch[0], cast[uint64](pm)))
    else:
        _loc_set_empty(loc, cast[Ptr[uint8]]("protocol"), cast[uint64](8))
    # authority (hierarchical only): [userinfo@]host[:port]
    host_real: int32 = rest_start
    host_end: int32 = rest_start
    if hier != 0:
        he: int32 = rest_start
        while he < n and p[he] != 47 and p[he] != 63 and p[he] != 35:
            he = he + 1
        host_end = he
        rest_start = he
        # strip userinfo before an '@'
        ak: int32 = host_real
        while ak < host_end:
            if p[ak] == 64:
                host_real = ak + 1
            ak = ak + 1
        _loc_set_slice(loc, cast[Ptr[uint8]]("host"), cast[uint64](4), p, host_real, host_end)
        # hostname / port split on the LAST ':'
        colon: int32 = -1
        ck: int32 = host_real
        while ck < host_end:
            if p[ck] == 58:
                colon = ck
            ck = ck + 1
        if colon >= 0:
            _loc_set_slice(loc, cast[Ptr[uint8]]("hostname"), cast[uint64](8), p, host_real, colon)
            _loc_set_slice(loc, cast[Ptr[uint8]]("port"), cast[uint64](4), p, colon + 1, host_end)
        else:
            _loc_set_slice(loc, cast[Ptr[uint8]]("hostname"), cast[uint64](8), p, host_real, host_end)
            _loc_set_empty(loc, cast[Ptr[uint8]]("port"), cast[uint64](4))
        # origin = protocol + "//" + host
        om: int32 = 0
        oi: int32 = 0
        while oi < scheme_end and om < 598:
            origin_scratch[om] = p[oi]
            om = om + 1
            oi = oi + 1
        origin_scratch[om] = 58
        om = om + 1
        origin_scratch[om] = 47
        om = om + 1
        origin_scratch[om] = 47
        om = om + 1
        oi = host_real
        while oi < host_end and om < 599:
            origin_scratch[om] = p[oi]
            om = om + 1
            oi = oi + 1
        js_set_prop(loc, cast[Ptr[uint8]]("origin"), cast[uint64](6), \
                    js_new_string(&origin_scratch[0], cast[uint64](om)))
    else:
        _loc_set_empty(loc, cast[Ptr[uint8]]("host"), cast[uint64](4))
        _loc_set_empty(loc, cast[Ptr[uint8]]("hostname"), cast[uint64](8))
        _loc_set_empty(loc, cast[Ptr[uint8]]("port"), cast[uint64](4))
        js_set_prop(loc, cast[Ptr[uint8]]("origin"), cast[uint64](6), \
                    js_new_string(cast[Ptr[uint8]]("null"), cast[uint64](4)))
    # split remainder into pathname / search / hash
    hpos: int32 = -1
    hi: int32 = rest_start
    while hi < n:
        if p[hi] == 35:
            hpos = hi
            hi = n
        else:
            hi = hi + 1
    qlim: int32 = n
    if hpos >= 0:
        qlim = hpos
    qpos: int32 = -1
    qi: int32 = rest_start
    while qi < qlim:
        if p[qi] == 63:
            qpos = qi
            qi = qlim
        else:
            qi = qi + 1
    path_end: int32 = n
    if qpos >= 0:
        path_end = qpos
    elif hpos >= 0:
        path_end = hpos
    if hier != 0 and path_end == rest_start:
        js_set_prop(loc, cast[Ptr[uint8]]("pathname"), cast[uint64](8), \
                    js_new_string(cast[Ptr[uint8]]("/"), cast[uint64](1)))
    else:
        _loc_set_slice(loc, cast[Ptr[uint8]]("pathname"), cast[uint64](8), p, rest_start, path_end)
    if qpos >= 0:
        se: int32 = n
        if hpos >= 0:
            se = hpos
        _loc_set_slice(loc, cast[Ptr[uint8]]("search"), cast[uint64](6), p, qpos, se)
    else:
        _loc_set_empty(loc, cast[Ptr[uint8]]("search"), cast[uint64](6))
    if hpos >= 0:
        _loc_set_slice(loc, cast[Ptr[uint8]]("hash"), cast[uint64](4), p, hpos, n)
    else:
        _loc_set_empty(loc, cast[Ptr[uint8]]("hash"), cast[uint64](4))


# Rebuild location.href from its parts after a `location.hash = ...` write, so
# href stays consistent (origin + pathname + search + hash). Skips a "null"
# origin (opaque/relative) — those keep their prior href.
def _loc_append_prop(name: Ptr[uint8], nlen: uint64, m: int32) -> int32:
    v: int32 = js_get_prop(g_js_location, name, nlen)
    vp: Ptr[uint8] = js_str_ptr(v)
    i: int32 = 0
    while vp[i] != 0 and m < 2047:
        url_scratch2[m] = vp[i]
        m = m + 1
        i = i + 1
    return m


def _loc_rebuild_href():
    if g_js_location < 0:
        return
    ov: int32 = js_get_prop(g_js_location, cast[Ptr[uint8]]("origin"), cast[uint64](6))
    op: Ptr[uint8] = js_str_ptr(ov)
    m: int32 = 0
    if _bytes_eq(op, _cstr_len(op), cast[Ptr[uint8]]("null"), 4) == 0:
        m = _loc_append_prop(cast[Ptr[uint8]]("origin"), cast[uint64](6), m)
    m = _loc_append_prop(cast[Ptr[uint8]]("pathname"), cast[uint64](8), m)
    m = _loc_append_prop(cast[Ptr[uint8]]("search"), cast[uint64](6), m)
    m = _loc_append_prop(cast[Ptr[uint8]]("hash"), cast[uint64](4), m)
    js_set_prop(g_js_location, cast[Ptr[uint8]]("href"), cast[uint64](4), \
                js_new_string(&url_scratch2[0], cast[uint64](m)))


# Dispatch a non-bubbling window event (popstate / hashchange): build the event
# object, fire every window-registered addEventListener(type) (they record under
# the DOC_EL sentinel with GEN_KIND), then the window.on<type> handler property.
# When has_state != 0 the event carries event.state (popstate).
def _fire_win_event(typp: Ptr[uint8], typn: int32, onname: Ptr[uint8], onlen: int32, \
                    stateval: int32, has_state: int32):
    ev: int32 = js_new_object_v()
    js_set_prop(ev, cast[Ptr[uint8]]("type"), cast[uint64](4), \
                js_new_string(typp, cast[uint64](typn)))
    js_set_prop(ev, cast[Ptr[uint8]]("target"), cast[uint64](6), js_win)
    js_set_prop(ev, cast[Ptr[uint8]]("currentTarget"), cast[uint64](13), js_win)
    js_set_prop(ev, cast[Ptr[uint8]]("bubbles"), cast[uint64](7), js_bool(0))
    js_set_prop(ev, cast[Ptr[uint8]]("cancelable"), cast[uint64](10), js_bool(0))
    if has_state != 0:
        js_set_prop(ev, cast[Ptr[uint8]]("state"), cast[uint64](5), stateval)
    js_global_set(cast[Ptr[uint8]]("event"), cast[uint64](5), ev)
    li: int32 = 0
    while li < evl_n:
        if evl_dead[li] == 0 and evl_el[li] == DOC_EL and evl_kind[li] == GEN_KIND and \
           _evl_type_eq(li, typp, typn) != 0:
            lfn: int32 = evl_fn[li]
            if js_is_callable(lfn) != 0:
                g_argv1[0] = ev
                js_call_fn(lfn, js_win, &g_argv1[0], 1)
                if evl_once[li] != 0:
                    evl_dead[li] = 1
        li = li + 1
    ofn: int32 = js_get_prop(js_win, onname, cast[uint64](onlen))
    if js_is_callable(ofn) != 0:
        g_argv1[0] = ev
        js_call_fn(ofn, js_win, &g_argv1[0], 1)


# Mirror the session-history model onto the JS `history` object.
def _hist_sync():
    if g_js_history < 0:
        return
    js_set_prop(g_js_history, cast[Ptr[uint8]]("length"), cast[uint64](6), \
                js_number(cast[float64](jshist_len)))
    js_set_prop(g_js_history, cast[Ptr[uint8]]("state"), cast[uint64](5), jshist_state[jshist_idx])


# Record entry `idx`'s URL bytes into the append-only ring (best-effort; drops on
# overflow, which cannot happen within a single headless page's script budget).
def _hist_store_url(idx: int32, p: Ptr[uint8], n: int32):
    if n <= 0 or jshist_urlbuf_w + n > JSHIST_URLBUF_CAP:
        jshist_url_off[idx] = -1
        jshist_url_len[idx] = 0
        return
    jshist_url_off[idx] = jshist_urlbuf_w
    i: int32 = 0
    while i < n:
        jshist_urlbuf[jshist_urlbuf_w] = p[i]
        jshist_urlbuf_w = jshist_urlbuf_w + 1
        i = i + 1
    jshist_url_len[idx] = n


# Restore location.href/components from entry `idx`'s stored URL (if any).
def _hist_restore_url(idx: int32):
    if jshist_url_off[idx] >= 0 and jshist_url_len[idx] > 0:
        _url_parse_into(g_js_location, &jshist_urlbuf[jshist_url_off[idx]], jshist_url_len[idx])


# history.pushState(state,title,url) — advance the index, truncate the forward
# tail, store state + optional URL; replaceState overwrites the current entry.
def _hist_push(replace: int32) -> int32:
    stv: int32 = js_null()
    if js_arg_count() >= 1:
        stv = js_arg(0)
    if replace == 0:
        jshist_idx = jshist_idx + 1
        if jshist_idx >= JSHIST_MAX:
            jshist_idx = JSHIST_MAX - 1
        jshist_len = jshist_idx + 1
    jshist_state[jshist_idx] = stv
    jshist_url_off[jshist_idx] = -1
    jshist_url_len[jshist_idx] = 0
    if js_arg_count() >= 3 and js_type_of(js_arg(2)) == 4:      # 4 == string tag
        un: int32 = _arg_bytes(2, &url_scratch2[0], 2048)
        if un > 0:
            _hist_store_url(jshist_idx, &url_scratch2[0], un)
            _url_parse_into(g_js_location, &url_scratch2[0], un)
    _hist_sync()
    return js_undefined()


# Wire the `history` global + augment the `location` global (created by the JS
# engine's install_builtins) with methods, then reset the session-history model
# to a single current entry. Called at the end of _js_build_document, after the
# window/location/document globals exist.
def _wire_history_location():
    loc: int32 = js_global_get(cast[Ptr[uint8]]("location"), cast[uint64](8))
    if js_type_of(loc) == 5:                                   # 5 == object tag
        g_js_location = loc
        js_set_prop(loc, cast[Ptr[uint8]]("assign"), cast[uint64](6), \
                    js_new_native_fn(js_hbase + NID_LOC_ASSIGN))
        js_set_prop(loc, cast[Ptr[uint8]]("replace"), cast[uint64](7), \
                    js_new_native_fn(js_hbase + NID_LOC_ASSIGN))
        js_set_prop(loc, cast[Ptr[uint8]]("reload"), cast[uint64](6), \
                    js_new_native_fn(js_hbase + NID_LOC_RELOAD))
        js_set_prop(loc, cast[Ptr[uint8]]("toString"), cast[uint64](8), \
                    js_new_native_fn(js_hbase + NID_LOC_TOSTRING))
    h: int32 = js_new_object_v()
    g_js_history = h
    js_set_prop(h, cast[Ptr[uint8]]("pushState"), cast[uint64](9), \
                js_new_native_fn(js_hbase + NID_HIST_PUSH))
    js_set_prop(h, cast[Ptr[uint8]]("replaceState"), cast[uint64](12), \
                js_new_native_fn(js_hbase + NID_HIST_REPLACE))
    js_set_prop(h, cast[Ptr[uint8]]("back"), cast[uint64](4), \
                js_new_native_fn(js_hbase + NID_HIST_BACK))
    js_set_prop(h, cast[Ptr[uint8]]("forward"), cast[uint64](7), \
                js_new_native_fn(js_hbase + NID_HIST_FORWARD))
    js_set_prop(h, cast[Ptr[uint8]]("go"), cast[uint64](2), \
                js_new_native_fn(js_hbase + NID_HIST_GO))
    js_set_prop(h, cast[Ptr[uint8]]("scrollRestoration"), cast[uint64](17), \
                js_new_string(cast[Ptr[uint8]]("auto"), cast[uint64](4)))
    jshist_len = 1
    jshist_idx = 0
    jshist_urlbuf_w = 0
    jshist_state[0] = js_null()
    jshist_url_off[0] = -1
    jshist_url_len[0] = 0
    _hist_sync()
    js_global_set(cast[Ptr[uint8]]("history"), cast[uint64](7), h)
    js_global_set(cast[Ptr[uint8]]("__setLocation"), cast[uint64](13), \
                  js_new_native_fn(js_hbase + NID_SET_LOCATION))


# ====================================================================
# document.cookie — an ACCESSOR pair over a document-lifetime cookie jar.
#
# Reading serialises every live cookie as "n1=v1; n2=v2" (the empty string when
# the jar is empty — per the IDL it is a DOMString and is NEVER undefined, which
# is the part MediaWiki's `document.cookie.match(...)` startup depends on).
# Writing takes ONE Set-Cookie-shaped string: the first `;`-delimited segment is
# the name=value pair and the rest are attributes.
#
# Attribute handling matches what a same-document jar can observe: domain / path
# / secure / samesite are accepted and ignored (there is one document and one
# origin), while an EXPIRY IN THE PAST deletes the cookie, since that is the
# universal delete idiom. "In the past" is recognised as `max-age` <= 0 or an
# `expires` whose 4-digit year is before 2001 — i.e. the epoch dates every
# deletion snippet uses ("Thu, 01 Jan 1970 00:00:00 GMT"). A real future/past
# comparison against the wall clock is deliberately not attempted.
# ====================================================================
def _ck_is_space(c: uint8) -> int32:
    if c == 32 or c == 9 or c == 10 or c == 13:
        return 1
    return 0


def _ck_lower(c: uint8) -> uint8:
    if c >= 65 and c <= 90:
        return cast[uint8](cast[int32](c) + 32)
    return c


# Find the live jar row whose name is ck_in[no..no+nl), or -1.
def _ck_find(no: int32, nl: int32) -> int32:
    i: int32 = 0
    while i < ck_n:
        if ck_dead[i] == 0 and ck_name_len[i] == nl:
            k: int32 = 0
            same: int32 = 1
            while k < nl:
                if ck_buf[ck_name_off[i] + k] != ck_in[no + k]:
                    same = 0
                    break
                k = k + 1
            if same != 0:
                return i
        i = i + 1
    return -1


# Copy ck_in[off..off+len) into ck_buf; returns the offset, or -1 when full.
def _ck_intern(off: int32, ln: int32) -> int32:
    if ck_buf_len + ln > CK_BUF_CAP:
        return -1
    o: int32 = ck_buf_len
    k: int32 = 0
    while k < ln:
        ck_buf[ck_buf_len] = ck_in[off + k]
        ck_buf_len = ck_buf_len + 1
        k = k + 1
    return o


# Does the attribute segment ck_in[s..e) mark this cookie for deletion?
# (`max-age` <= 0, or an `expires` year before 2001.)
def _ck_attr_expires_past(s: int32, e: int32) -> int32:
    # split at the first '='
    eq: int32 = s
    while eq < e and ck_in[eq] != 61:
        eq = eq + 1
    ns: int32 = s
    ne: int32 = eq
    while ns < ne and _ck_is_space(ck_in[ns]) != 0:
        ns = ns + 1
    while ne > ns and _ck_is_space(ck_in[ne - 1]) != 0:
        ne = ne - 1
    vs: int32 = eq
    if vs < e:
        vs = vs + 1
    while vs < e and _ck_is_space(ck_in[vs]) != 0:
        vs = vs + 1
    nl: int32 = ne - ns
    if nl == 7:
        # "max-age"
        ml: Ptr[uint8] = cast[Ptr[uint8]]("max-age")
        k: int32 = 0
        ok: int32 = 1
        while k < 7:
            if _ck_lower(ck_in[ns + k]) != ml[k]:
                ok = 0
                break
            k = k + 1
        if ok != 0:
            if vs < e and ck_in[vs] == 45:            # leading '-' => negative
                return 1
            n: int32 = 0
            p: int32 = vs
            while p < e and ck_in[p] >= 48 and ck_in[p] <= 57:
                n = n * 10 + (cast[int32](ck_in[p]) - 48)
                p = p + 1
            if n <= 0:
                return 1
            return 0
    if nl == 7:
        el: Ptr[uint8] = cast[Ptr[uint8]]("expires")
        k2: int32 = 0
        ok2: int32 = 1
        while k2 < 7:
            if _ck_lower(ck_in[ns + k2]) != el[k2]:
                ok2 = 0
                break
            k2 = k2 + 1
        if ok2 != 0:
            # first 4-digit run in the date is the year ("01 Jan 1970"); a
            # 2-digit legacy year ("01-Jan-70") counts as 1970-something too.
            p2: int32 = vs
            while p2 < e:
                if ck_in[p2] >= 48 and ck_in[p2] <= 57:
                    d0: int32 = p2
                    y: int32 = 0
                    while p2 < e and ck_in[p2] >= 48 and ck_in[p2] <= 57:
                        y = y * 10 + (cast[int32](ck_in[p2]) - 48)
                        p2 = p2 + 1
                    if p2 - d0 == 4:
                        if y < 2001:
                            return 1
                        return 0
                else:
                    p2 = p2 + 1
            return 0
    return 0


# `document.cookie = "..."` — parse and apply one write.
def _cookie_write() -> int32:
    if js_arg_count() < 1:
        return js_undefined()
    n: int32 = _arg_bytes(0, &ck_in[0], CK_BUF_CAP)
    # segment 0 is name=value; the rest are attributes
    seg0: int32 = 0
    while seg0 < n and ck_in[seg0] != 59:
        seg0 = seg0 + 1
    eq: int32 = 0
    while eq < seg0 and ck_in[eq] != 61:
        eq = eq + 1
    no: int32 = 0
    ne: int32 = eq
    vo: int32 = eq
    ve: int32 = seg0
    if eq >= seg0:
        # no '=' at all: browsers store it as a nameless cookie whose VALUE is
        # the whole segment.
        no = 0
        ne = 0
        vo = 0
        ve = seg0
    else:
        vo = eq + 1
    while no < ne and _ck_is_space(ck_in[no]) != 0:
        no = no + 1
    while ne > no and _ck_is_space(ck_in[ne - 1]) != 0:
        ne = ne - 1
    while vo < ve and _ck_is_space(ck_in[vo]) != 0:
        vo = vo + 1
    while ve > vo and _ck_is_space(ck_in[ve - 1]) != 0:
        ve = ve - 1
    # scan the attributes for an expiry in the past
    del_it: int32 = 0
    ap: int32 = seg0
    while ap < n:
        ap = ap + 1                                   # step over the ';'
        as2: int32 = ap
        while ap < n and ck_in[ap] != 59:
            ap = ap + 1
        if _ck_attr_expires_past(as2, ap) != 0:
            del_it = 1
    nl: int32 = ne - no
    vl: int32 = ve - vo
    row: int32 = _ck_find(no, nl)
    if del_it != 0:
        if row >= 0:
            ck_dead[row] = cast[uint8](1)
        return js_undefined()
    vofs: int32 = _ck_intern(vo, vl)
    if vofs < 0:
        return js_undefined()                         # jar buffer full: drop
    if row >= 0:
        # Overwriting moves the cookie to the END of the serialisation, which is
        # what Chromium does (VERIFIED against `chromium --headless` over http:
        # a=1, b=hello, a=2 serialises as "b=hello; a=2", not "a=2; b=hello").
        no2: int32 = ck_name_off[row]
        nl2: int32 = ck_name_len[row]
        j: int32 = row
        while j + 1 < ck_n:
            ck_name_off[j] = ck_name_off[j + 1]
            ck_name_len[j] = ck_name_len[j + 1]
            ck_val_off[j] = ck_val_off[j + 1]
            ck_val_len[j] = ck_val_len[j + 1]
            ck_dead[j] = ck_dead[j + 1]
            j = j + 1
        ck_name_off[ck_n - 1] = no2
        ck_name_len[ck_n - 1] = nl2
        ck_val_off[ck_n - 1] = vofs
        ck_val_len[ck_n - 1] = vl
        ck_dead[ck_n - 1] = cast[uint8](0)
        return js_undefined()
    if ck_n >= CK_MAX:
        return js_undefined()
    nofs: int32 = _ck_intern(no, nl)
    if nofs < 0:
        return js_undefined()
    ck_name_off[ck_n] = nofs
    ck_name_len[ck_n] = nl
    ck_val_off[ck_n] = vofs
    ck_val_len[ck_n] = vl
    ck_dead[ck_n] = cast[uint8](0)
    ck_n = ck_n + 1
    return js_undefined()


# `document.cookie` — serialise the live jar.
def _cookie_read() -> int32:
    out: int32 = 0
    i: int32 = 0
    while i < ck_n:
        if ck_dead[i] == 0:
            if out > 0 and out + 2 < CK_BUF_CAP:
                ck_out[out] = 59                      # ';'
                ck_out[out + 1] = 32                  # ' '
                out = out + 2
            k: int32 = 0
            if ck_name_len[i] > 0:
                while k < ck_name_len[i] and out < CK_BUF_CAP - 1:
                    ck_out[out] = ck_buf[ck_name_off[i] + k]
                    out = out + 1
                    k = k + 1
                if out < CK_BUF_CAP - 1:
                    ck_out[out] = 61                  # '='
                    out = out + 1
            k = 0
            while k < ck_val_len[i] and out < CK_BUF_CAP - 1:
                ck_out[out] = ck_buf[ck_val_off[i] + k]
                out = out + 1
                k = k + 1
        i = i + 1
    ck_out[out] = 0
    return js_new_string(&ck_out[0], cast[uint64](out))


# window.matchMedia(query) — build a MediaQueryList. `.matches` is the LIVE
# evaluation of the query against the viewport (he_media_match, the same subset
# the @media cascade uses); `.media` echoes the (serialized) query. Listener
# registration (addListener/removeListener/addEventListener/removeEventListener/
# dispatchEvent) accepts args and is a best-effort no-op: the headless engine
# does one layout, so a `change` never fires. `onchange` starts null.
def _match_media() -> int32:
    qn: int32 = 0
    if js_arg_count() >= 1:
        qn = _arg_bytes(0, &mq_scratch[0], 512)
    m: int32 = 0
    if qn > 0:
        m = he_media_match(&mq_scratch[0], cast[uint64](qn))
    mql: int32 = js_new_object_v()
    js_set_prop(mql, cast[Ptr[uint8]]("matches"), 7, js_bool(m))
    js_set_prop(mql, cast[Ptr[uint8]]("media"), 5, \
                js_new_string(&mq_scratch[0], cast[uint64](qn)))
    js_set_prop(mql, cast[Ptr[uint8]]("onchange"), 8, js_null())
    js_set_prop(mql, cast[Ptr[uint8]]("addListener"), 11, \
                js_new_native_fn(js_hbase + NID_MQL_NOOP))
    js_set_prop(mql, cast[Ptr[uint8]]("removeListener"), 14, \
                js_new_native_fn(js_hbase + NID_MQL_NOOP))
    js_set_prop(mql, cast[Ptr[uint8]]("addEventListener"), 16, \
                js_new_native_fn(js_hbase + NID_MQL_NOOP))
    js_set_prop(mql, cast[Ptr[uint8]]("removeEventListener"), 19, \
                js_new_native_fn(js_hbase + NID_MQL_NOOP))
    js_set_prop(mql, cast[Ptr[uint8]]("dispatchEvent"), 13, \
                js_new_native_fn(js_hbase + NID_MQL_NOOP))
    return mql


# ====================================================================
# Framework-mount primitives (§5 of docs/hambrowse_real_web_review_2026-07-25.md)
# ====================================================================
# Is `v` a DocumentFragment? Fragments are NOT created-node-pool members (they
# never render), so they are recognised by nodeType 11 alone.
def _is_fragment(v: int32) -> int32:
    if js_type_of(v) != TAG_OBJ:
        return 0
    if _find_cre_by_obj(v) >= 0:
        return 0
    ntv: int32 = js_get_prop(v, cast[Ptr[uint8]]("nodeType"), 8)
    if js_type_of(ntv) != 3:                              # 3 == number tag
        return 0
    if cast[int32](js_to_number(ntv)) != 11:
        return 0
    return 1


# Empty a fragment's child list after its children have been moved out.
def _frag_clear(fragv: int32):
    empty: int32 = js_new_array_v()
    js_set_prop(fragv, cast[Ptr[uint8]]("children"), 8, empty)
    js_set_prop(fragv, cast[Ptr[uint8]]("childNodes"), 10, empty)
    js_set_prop(fragv, cast[Ptr[uint8]]("firstChild"), 10, js_null())
    js_set_prop(fragv, cast[Ptr[uint8]]("lastChild"), 9, js_null())


# Extend `parentv`'s live .textContent with an appended TEXT node's data.
# Element children are deliberately excluded: they render through the
# created-node emitter, and a textContent override on their parent would make
# the readback flatten the whole subtree to escaped text.
def _append_sync_text(parentv: int32, childv: int32):
    cid2: int32 = _find_cre_by_obj(childv)
    # cre_is_text is a KIND now (1 text, 2 comment, 3 processing instruction).
    # Only a real Text child contributes to the parent's textContent: a comment
    # or a PI must not, or `<div><!--x--></div>`.textContent reads back "x".
    if cid2 < 0 or cre_is_text[cid2] != 1:
        return
    tsbuf: Array[8192, uint8]
    tw: int32 = 0
    exv: int32 = js_get_prop(parentv, cast[Ptr[uint8]]("textContent"), 11)
    exp2: Ptr[uint8] = js_str_ptr(exv)
    exn: int32 = _cstr_len(exp2)
    if _is_undef_str(exp2, exn) != 0:
        exn = 0
    i: int32 = 0
    while i < exn and tw < 8191:
        tsbuf[tw] = exp2[i]
        tw = tw + 1
        i = i + 1
    nvp: Ptr[uint8] = js_str_ptr(js_get_prop(childv, \
                                cast[Ptr[uint8]]("textContent"), 11))
    nvn: int32 = _cstr_len(nvp)
    if _is_undef_str(nvp, nvn) == 0:
        j: int32 = 0
        while j < nvn and tw < 8191:
            tsbuf[tw] = nvp[j]
            tw = tw + 1
            j = j + 1
    js_set_prop(parentv, cast[Ptr[uint8]]("textContent"), 11, \
                js_new_string(&tsbuf[0], cast[uint64](tw)))


# parent.appendChild(child) with explicit values — shared by the NID_APPEND
# dispatch and the DocumentFragment flush (which replays each child through it).
def _append_child_v(parentv: int32, childv: int32):
    _detach_from_parent_v(childv)
    ch: int32 = _find_cre_by_obj(childv)
    if ch >= 0:
        cre_gone[ch] = 0                                  # (re)attach
        par: int32 = _find_el_by_obj(parentv)
        if par >= 0:
            _ap_add(par, ch, -1)
            # keep the parent's live JS .children/.childNodes in sync so a
            # subsequent read sees the appended node, and give the child a
            # parentNode back-link (round 2 real-tree mutation).
            pch: int32 = js_get_prop(dom_obj[par], cast[Ptr[uint8]]("children"), 8)
            if js_is_array(pch) != 0:
                js_array_push(pch, childv)
                _wire_sibling_links(pch, dom_obj[par])
            _dom_nodes_push(dom_obj[par], childv)
            js_set_prop(childv, cast[Ptr[uint8]]("parentNode"), 10, dom_obj[par])
            js_set_prop(childv, cast[Ptr[uint8]]("parentElement"), 13, dom_obj[par])
        else:
            pcid: int32 = _find_cre_by_obj(parentv)
            if pcid >= 0:
                _cc_add(pcid, ch, -1)
                # keep the CREATED parent's live JS .children/.childNodes in sync
                # too (nesting: ul.appendChild(li) before ul is mounted) so
                # ul.children.length reflects the append.
                ccpch: int32 = js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8)
                if js_is_array(ccpch) != 0:
                    js_array_push(ccpch, childv)
                    _wire_sibling_links(ccpch, parentv)
                _dom_nodes_push(parentv, childv)
                js_set_prop(childv, cast[Ptr[uint8]]("parentNode"), 10, parentv)
                js_set_prop(childv, cast[Ptr[uint8]]("parentElement"), 13, parentv)
    _mo_record_childlist(parentv, childv, -1)
    # A TEXT child extends the parent's live textContent. Without this an
    # `appendChild(document.createTextNode("x"))` left `.textContent` at "" —
    # which is exactly how React writes every string child, so a rendered React
    # tree read back empty.
    _append_sync_text(parentv, childv)


# Build the `port1`/`port2` pair of a MessageChannel. Each port carries a hidden
# `__peer` link; postMessage looks up the PEER's current `onmessage` and defers
# it on the shared task queue, which is precisely the semantics React 18's
# scheduler wants (a macrotask hop that runs after the current microtask drain).
def _make_message_channel() -> int32:
    chan: int32 = js_new_object_v()
    p1: int32 = js_new_object_v()
    p2: int32 = js_new_object_v()
    _wire_message_port(p1, p2)
    _wire_message_port(p2, p1)
    js_set_prop(chan, cast[Ptr[uint8]]("port1"), 5, p1)
    js_set_prop(chan, cast[Ptr[uint8]]("port2"), 5, p2)
    return chan


def _wire_message_port(port: int32, peer: int32):
    js_set_prop(port, cast[Ptr[uint8]]("__peer"), 6, peer)
    js_set_prop(port, cast[Ptr[uint8]]("onmessage"), 9, js_null())
    js_set_prop(port, cast[Ptr[uint8]]("postMessage"), 11, \
                js_new_native_fn(js_hbase + NID_MSGPORT_POST))
    js_set_prop(port, cast[Ptr[uint8]]("start"), 5, \
                js_new_native_fn(js_hbase + NID_MSGPORT_NOOP))
    js_set_prop(port, cast[Ptr[uint8]]("close"), 5, \
                js_new_native_fn(js_hbase + NID_MSGPORT_NOOP))


# The framework-mount native methods (createComment / createDocumentFragment /
# the CSSStyleDeclaration trio / MessageChannel). createElementNS is handled in
# the main dispatcher because it shares createElement's node-building body.
def _mount_dispatch(rel: int32) -> int32:
    if rel == NID_CREATECOMMENT:
        # A comment node: nodeType 8, never rendered (it is not a created-node
        # pool member, so no emitter path can reach it) but a real object that
        # can be appended and read back. React marks Suspense/portal boundaries
        # with these.
        cval: int32 = js_new_string(&dom_txtbuf[0], 0)
        if js_arg_count() >= 1:
            cval = js_arg(0)
        return _cre_make_chardata(cval, 2, js_undefined())
    if rel == NID_CREATEPI:
        # document.createProcessingInstruction(target, data). The target must be
        # an XML Name and the data must not contain "?>" — WPT
        # Document-createProcessingInstruction.js is 11 rows of exactly that,
        # and it wants an InvalidCharacterError, not a TypeError.
        pitv: int32 = js_new_string(cast[Ptr[uint8]](""), 0)
        pidv: int32 = js_new_string(cast[Ptr[uint8]](""), 0)
        if js_arg_count() >= 1:
            pitn: int32 = _js_str_to_cbuf(js_arg(0), &pi_tbuf[0], 255)
            pitv = js_new_string(&pi_tbuf[0], cast[uint64](pitn))
            if _validate_pi_target(&pi_tbuf[0], pitn) == 0:
                return _throw_domexc(cast[Ptr[uint8]]("InvalidCharacterError"), \
                                     21, \
                                     cast[Ptr[uint8]]("invalid PI target"), 17)
        else:
            return _throw_domexc(cast[Ptr[uint8]]("InvalidCharacterError"), 21, \
                                 cast[Ptr[uint8]]("invalid PI target"), 17)
        if js_arg_count() >= 2:
            pidv = js_arg(1)
            pidp: Ptr[uint8] = js_str_bytes(pidv)
            pidn: int32 = js_str_bytelen(pidv)
            pk2: int32 = 0
            while pk2 + 1 < pidn:
                if pidp[pk2] == 63 and pidp[pk2 + 1] == 62:        # "?>"
                    return _throw_domexc( \
                        cast[Ptr[uint8]]("InvalidCharacterError"), 21, \
                        cast[Ptr[uint8]]("PI data contains ?>"), 19)
                pk2 = pk2 + 1
        return _cre_make_chardata(pidv, 3, pitv)
    if rel == NID_CREATEFRAG:
        frag: int32 = js_new_object_v()
        js_set_prop(frag, cast[Ptr[uint8]]("nodeType"), 8, js_number(11.0))
        js_set_prop(frag, cast[Ptr[uint8]]("nodeName"), 8, \
                    js_new_string(cast[Ptr[uint8]]("#document-fragment"), 18))
        js_set_prop(frag, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
        fkids: int32 = js_new_array_v()
        js_set_prop(frag, cast[Ptr[uint8]]("children"), 8, fkids)
        js_set_prop(frag, cast[Ptr[uint8]]("childNodes"), 10, fkids)
        js_set_prop(frag, cast[Ptr[uint8]]("firstChild"), 10, js_null())
        js_set_prop(frag, cast[Ptr[uint8]]("lastChild"), 9, js_null())
        js_set_prop(frag, cast[Ptr[uint8]]("appendChild"), 11, \
                    js_new_native_fn(js_hbase + NID_APPEND))
        js_set_prop(frag, cast[Ptr[uint8]]("append"), 6, \
                    js_new_native_fn(js_hbase + NID_APPEND_M))
        js_set_prop(frag, cast[Ptr[uint8]]("querySelector"), 13, \
                    js_new_native_fn(js_hbase + NID_QUERY))
        js_set_prop(frag, cast[Ptr[uint8]]("querySelectorAll"), 16, \
                    js_new_native_fn(js_hbase + NID_QUERYALL))
        _node_identity(frag, g_proto_frag)
        return frag
    if rel == NID_STYLE_SETPROP:
        # style.setProperty(name, value[, priority]). The style object stores
        # camelCase members (that is what the cascade readback reads), so the CSS
        # name is normalised first; `--custom` names pass through verbatim.
        if js_arg_count() < 2:
            return js_undefined()
        spn: int32 = _arg_bytes(0, &dom_idtmp[0], 256)
        spcam: Array[256, uint8]
        spl: int32 = _css_prop_camel(&dom_idtmp[0], spn, &spcam[0], 256)
        spv: int32 = js_arg(1)
        if js_type_of(spv) != 4:                          # 4 == string tag
            spv = js_new_string(js_str_ptr(spv), \
                                cast[uint64](_cstr_len(js_str_ptr(spv))))
        js_set_prop(js_this(), &spcam[0], cast[uint64](spl), spv)
        return js_undefined()
    if rel == NID_STYLE_GETPROP:
        if js_arg_count() < 1:
            return js_new_string(&dom_txtbuf[0], 0)
        gpn: int32 = _arg_bytes(0, &dom_idtmp[0], 256)
        gpcam: Array[256, uint8]
        gpl: int32 = _css_prop_camel(&dom_idtmp[0], gpn, &gpcam[0], 256)
        gv: int32 = js_get_prop(js_this(), &gpcam[0], cast[uint64](gpl))
        gvp: Ptr[uint8] = js_str_ptr(gv)
        if _is_undef_str(gvp, _cstr_len(gvp)) != 0:
            return js_new_string(&dom_txtbuf[0], 0)       # "" for an unset property
        return gv
    if rel == NID_STYLE_REMPROP:
        if js_arg_count() < 1:
            return js_new_string(&dom_txtbuf[0], 0)
        rpn: int32 = _arg_bytes(0, &dom_idtmp[0], 256)
        rpcam: Array[256, uint8]
        rpl: int32 = _css_prop_camel(&dom_idtmp[0], rpn, &rpcam[0], 256)
        old: int32 = js_get_prop(js_this(), &rpcam[0], cast[uint64](rpl))
        js_set_prop(js_this(), &rpcam[0], cast[uint64](rpl), \
                    js_new_string(&dom_txtbuf[0], 0))
        oldp: Ptr[uint8] = js_str_ptr(old)
        if _is_undef_str(oldp, _cstr_len(oldp)) != 0:
            return js_new_string(&dom_txtbuf[0], 0)
        return old
    if rel == NID_MSGCHANNEL:
        return _make_message_channel()
    if rel == NID_MSGPORT_POST:
        peer: int32 = js_get_prop(js_this(), cast[Ptr[uint8]]("__peer"), 6)
        if js_type_of(peer) == TAG_OBJ:
            handler: int32 = js_get_prop(peer, cast[Ptr[uint8]]("onmessage"), 9)
            if js_is_callable(handler) != 0:
                timer_schedule_fn(handler, 0.0)
        return js_undefined()
    if rel == NID_MSGPORT_NOOP:
        return js_undefined()
    # NID_NODE_CTOR — the DOM interface objects (Node, Element, …) exist to be
    # branched on (`typeof Element`), read from (`Node.ELEMENT_NODE`) and tested
    # against (`x instanceof Node`); calling one is a TypeError in a browser and
    # a no-op here.
    return js_undefined()


# LAZY el.textContent / el.innerHTML (round 9).
#
# These are accessor properties on HTMLElement.prototype, so they fire ONLY for
# an element that has no own property of that name — i.e. one script has never
# touched. That is the whole point: a page with 4576 elements no longer pays to
# materialise 4576 text snapshots plus 4576 raw-markup snapshots (which is what
# exhausted the shared 64 KiB dom_txtbuf and returned "" for
# document.body.textContent), it pays only for the elements it actually reads.
#
# The getter MEMOISES by installing an own data property through js_set_own,
# which bypasses the accessor walk. From then on the element behaves exactly as
# it did before this change: plain data property, normal member-set hook.
#
# An object that is not a registered SOURCE element returns undefined, which is
# what a missing own property returned before — created nodes already carry
# their own textContent, and the rewrite path branches on `undefined` meaning
# "never set".
# The element's current innerHTML. Until the page's first source-tree mutation
# the answer is provably the raw source slice, which is far cheaper than
# re-serialising the subtree.
def _inner_html_of(idx: int32) -> int32:
    if g_dom_mutated == 0:
        cs: int32 = dom_cstart[idx]
        hn: int32 = dom_cend[idx] - cs
        if hn < 0:
            hn = 0
        return js_new_string(&src_ptr[cast[uint64](cs)], cast[uint64](hn))
    return _serialize_inner_of(idx)


def _inner_accessor(rel: int32) -> int32:
    thisv: int32 = js_this()
    idx: int32 = _find_el_by_obj(thisv)
    if rel == NID_TC_GET:
        if idx < 0:
            return js_undefined()
        n: int32 = _text_into_tw(cast[uint64](dom_cstart[idx]), \
                                 cast[uint64](dom_cend[idx]))
        v: int32 = js_new_string(&tw_buf[0], cast[uint64](n))
        js_set_own(thisv, cast[Ptr[uint8]]("textContent"), 11, v)
        return v
    if rel == NID_IH_GET:
        if idx < 0:
            ccid: int32 = _find_cre_by_obj(thisv)
            if ccid < 0:
                return js_undefined()
            return _serialize_inner_cre(ccid)
        # NOT memoised any more. The memo installed an own data property that
        # shadowed this accessor for the rest of the page's life, so the FIRST
        # read froze innerHTML at its parse-time value — which is half of why
        # every later mutation was invisible. A browser recomputes on every
        # read; so do we. Until the page's first mutation the answer is
        # provably the source slice, so that stays the cheap path.
        # Generation-keyed memo: still recomputed after every DOM mutation (a
        # browser recomputes on every read), but a mutation-free run of reads
        # of the SAME element reuses one string instead of re-serialising the
        # subtree each time. Without this, testharness printing a 700-element
        # array exhausted the 8 MiB string pool mid-file.
        ic: int32 = 0
        while ic < ihc_n:
            if ihc_el[ic] == thisv:
                if ihc_gen[ic] == g_dom_gen:
                    return ihc_val[ic]
                iv2: int32 = _inner_html_of(idx)
                ihc_val[ic] = iv2
                ihc_gen[ic] = g_dom_gen
                return iv2
            ic = ic + 1
        iv: int32 = _inner_html_of(idx)
        islot: int32 = ihc_n
        if ihc_n < IHC_MAX:
            ihc_n = ihc_n + 1
        else:
            islot = ihc_next
            ihc_next = ihc_next + 1
            if ihc_next >= IHC_MAX:
                ihc_next = 0
        ihc_el[islot] = thisv
        ihc_val[islot] = iv
        ihc_gen[islot] = g_dom_gen
        return iv
    # ---- setters: install the own data property, then run the same side
    # effects member_set's hook would have run (an accessor set returns before
    # the hook fires, so the work has to happen here).
    val: int32 = js_undefined()
    if js_arg_count() > 0:
        val = js_arg(0)
    if rel == NID_TC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("textContent"), 11, val)
        if mreg_n != 0:
            _mo_record_chardata(thisv)
        return js_undefined()
    js_set_own(thisv, cast[Ptr[uint8]]("innerHTML"), 9, val)
    if g_ih_setter_busy != 0:
        return js_undefined()
    if idx < 0 and _find_cre_by_obj(thisv) < 0:
        return js_undefined()                             # not a DOM node yet
    # js_str_bytes, NOT js_str_ptr: the latter renders into an 8-slot 64 KiB
    # scratch RING, and _apply_inner_html calls js_str_ptr many times while
    # parsing, so the ring wraps and the markup we are parsing is overwritten
    # underneath us (observed: <ul><li>one</li><li>two</li></ul> parsed as
    # "r i>one"). The string pool is non-moving, so a pointer into it survives.
    vp: Ptr[uint8] = js_str_bytes(val)
    vn: int32 = js_str_bytelen(val)
    if _is_undef_str(vp, vn) != 0:
        return js_undefined()
    g_ih_setter_busy = 1
    _apply_inner_html(thisv, vp, vn)
    g_ih_setter_busy = 0
    return js_undefined()


# LAZY el.style / el.classList / el.dataset (round 9).
#
# Allocating all three for EVERY registered element made a 4576-element page pay
# for ~14000 JS objects it never looks at; Chrome creates them on first access.
# Same memoising-accessor shape as textContent above: build once, install as an
# own data property, and every later read/write is a plain property operation.
# An object that is not a registered source element returns undefined, exactly
# as a missing own property did (created elements carry their own style object).
def _lazy_el_accessor(rel: int32) -> int32:
    thisv: int32 = js_this()
    idx: int32 = _find_el_by_obj(thisv)
    if rel == NID_STYLE_ACC:
        if idx < 0:
            return js_undefined()
        sv: int32 = _new_style_obj()
        js_set_own(thisv, cast[Ptr[uint8]]("style"), 5, sv)
        return sv
    if rel == NID_CLS_ACC:
        if idx < 0:
            # A CREATED element (createElement/createElementNS) has no dom_* row
            # but still has a classList — chromium gives one to every Element in
            # every namespace (dom/lists/DOMTokenList-coverage-for-attributes).
            if _find_cre_by_obj(thisv) < 0:
                return js_undefined()
            ccv: int32 = _new_classlist_obj()
            js_set_own(thisv, cast[Ptr[uint8]]("classList"), 9, ccv)
            _clsown_add(ccv, thisv)
            return ccv
        cv: int32 = _new_classlist_obj()
        js_set_own(thisv, cast[Ptr[uint8]]("classList"), 9, cv)
        dom_clsobj[idx] = cv                              # maps the token list back
        return cv
    if rel == NID_KIDS_ACC or rel == NID_NODES_ACC:
        # Wire the tree NOW. _dom_wire_tree installs children/childNodes (and
        # parent/sibling/first/last) as own data properties, which shadow this
        # accessor from here on — so the work happens once, for the elements a
        # page actually traverses from.
        if idx < 0 or tx_built == 0:
            return js_undefined()
        _dom_wire_tree(idx)
        # _dom_wire_tree is a NO-OP for an element that is not in the tree
        # index — e.g. anything inside a <noscript>, which is RAWTEXT when
        # scripting is on and so has no tx entry. Reading the property back
        # with js_get_prop would then walk the prototype chain, re-enter THIS
        # accessor, and recurse until the stack died (measured: SIGSEGV on
        # tests/fixtures/hambrowse_noscriptdom.html). Ask for the OWN property
        # only, and answer undefined when the wiring installed nothing.
        if rel == NID_KIDS_ACC:
            if js_has_own(thisv, cast[Ptr[uint8]]("children"), 8) == 0:
                return js_undefined()
            return js_get_prop(thisv, cast[Ptr[uint8]]("children"), 8)
        kn: int32 = _dom_node_kids(idx)
        if js_type_of(kn) != TAG_OBJ:
            return js_undefined()
        return kn
    # NODE-level traversal, off the same lazy child-NODE list. firstChild is a
    # Text where the markup puts text first, which is what a browser reports and
    # what testharness.js's get_title() reads (title.firstChild.data).
    if rel == NID_FCH_ACC or rel == NID_LCH_ACC:
        if idx < 0 or tx_built == 0:
            return js_undefined()
        _dom_wire_tree(idx)
        kids: int32 = _dom_node_kids(idx)
        if js_type_of(kids) != TAG_OBJ:
            return js_undefined()
        kl: int32 = js_array_len(kids)
        if kl == 0:
            return js_null()
        if rel == NID_FCH_ACC:
            return js_array_get(kids, 0)
        return js_array_get(kids, kl - 1)
    if rel == NID_PSIB_ACC or rel == NID_NSIB_ACC:
        if idx < 0 or tx_built == 0:
            return js_undefined()
        _dom_wire_tree(idx)
        pv: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("parentNode"), 10)
        if js_type_of(pv) != TAG_OBJ:
            return js_null()
        pidx: int32 = _find_el_by_obj(pv)
        if pidx < 0:
            return js_null()
        sib: int32 = _dom_node_kids(pidx)
        if js_type_of(sib) != TAG_OBJ:
            return js_null()
        sn: int32 = js_array_len(sib)
        m: int32 = 0
        while m < sn:
            if js_array_get(sib, m) == thisv:
                if rel == NID_PSIB_ACC:
                    if m > 0:
                        return js_array_get(sib, m - 1)
                    return js_null()
                if m + 1 < sn:
                    return js_array_get(sib, m + 1)
                return js_null()
            m = m + 1
        return js_null()
    if rel == NID_DS_ACC:
        if idx < 0:
            return js_undefined()
        # data-* live in the START TAG body: [name-end, '>').
        dv: int32 = _build_dataset_obj(cast[uint64](dom_ns[idx] + dom_nl[idx]), \
                                       cast[uint64](dom_cstart[idx] - 1))
        js_set_own(thisv, cast[Ptr[uint8]]("dataset"), 7, dv)
        return dv
    # Setters. An accessor with NO setter silently DROPS the write, so each one
    # installs the assigned value as an own data property — byte-for-byte the
    # behaviour these had as plain data properties.
    wv: int32 = js_undefined()
    if js_arg_count() > 0:
        wv = js_arg(0)
    if rel == NID_KIDS_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("children"), 8, wv)
        return js_undefined()
    if rel == NID_NODES_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("childNodes"), 10, wv)
        return js_undefined()
    if rel == NID_FCH_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("firstChild"), 10, wv)
        return js_undefined()
    if rel == NID_LCH_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("lastChild"), 9, wv)
        return js_undefined()
    if rel == NID_PSIB_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("previousSibling"), 15, wv)
        return js_undefined()
    if rel == NID_NSIB_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("nextSibling"), 11, wv)
        return js_undefined()
    if rel == NID_STYLE_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("style"), 5, wv)
    elif rel == NID_CLS_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("classList"), 9, wv)
        if idx >= 0:
            dom_clsobj[idx] = wv
    else:
        js_set_own(thisv, cast[Ptr[uint8]]("dataset"), 7, wv)
    return js_undefined()


# OFF-INTERFACE FEATURE DETECTION (round 9). One shared accessor pair per
# method on HTMLElement.prototype: return the native function when `this`'s tag
# actually declares it, undefined otherwise. Keeping them on the prototype (one
# copy) rather than splitting into per-tag prototypes preserves the per-element
# object saving; the tag test reads the element's own `tagName` string, which
# both registered and created elements carry.
def _feat_tag_class(thisv: int32) -> int32:
    # 0 = other, 1 = form, 2 = listed control (input/select/textarea/button/
    # fieldset/output), 3 = canvas.
    tn: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("tagName"), 7)
    if js_type_of(tn) != TAG_STR:
        return 0
    tp: Ptr[uint8] = js_str_ptr(tn)
    tl: int32 = _cstr_len(tp)
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("FORM"), 4) != 0:
        return 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("CANVAS"), 6) != 0:
        return 3
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("INPUT"), 5) != 0:
        return 2
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("SELECT"), 6) != 0:
        return 2
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("TEXTAREA"), 8) != 0:
        return 2
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("BUTTON"), 6) != 0:
        return 2
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("FIELDSET"), 8) != 0:
        return 2
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("OUTPUT"), 6) != 0:
        return 2
    return 0


def _feat_accessor(rel: int32) -> int32:
    thisv: int32 = js_this()
    # Setters first: assigning over a method must work exactly as it does on a
    # plain data property (polyfills do `if (!el.m) el.m = ...`).
    if rel >= NID_F_GETCTX_S:
        wv: int32 = js_undefined()
        if js_arg_count() > 0:
            wv = js_arg(0)
        if rel == NID_F_GETCTX_S:
            js_set_own(thisv, cast[Ptr[uint8]]("getContext"), 10, wv)
        elif rel == NID_F_CV_S:
            js_set_own(thisv, cast[Ptr[uint8]]("checkValidity"), 13, wv)
        elif rel == NID_F_RV_S:
            js_set_own(thisv, cast[Ptr[uint8]]("reportValidity"), 14, wv)
        elif rel == NID_F_SCV_S:
            js_set_own(thisv, cast[Ptr[uint8]]("setCustomValidity"), 17, wv)
        else:
            js_set_own(thisv, cast[Ptr[uint8]]("submit"), 6, wv)
        return js_undefined()
    kls: int32 = _feat_tag_class(thisv)
    if rel == NID_F_GETCTX:
        if kls != 3:
            return js_undefined()
        return js_new_native_fn(js_hbase + NID_GETCTX)
    if rel == NID_F_SUBMIT:
        if kls != 1:
            return js_undefined()
        return js_new_native_fn(js_hbase + NID_SUBMIT)
    if rel == NID_F_SCV:
        if kls != 2:                                      # form is EXCLUDED here
            return js_undefined()
        return js_new_native_fn(js_hbase + NID_SETCUSTOMVAL)
    if kls != 1 and kls != 2:
        return js_undefined()
    if rel == NID_F_CV:
        return js_new_native_fn(js_hbase + NID_CHECKVALID)
    return js_new_native_fn(js_hbase + NID_REPORTVALID)


# Does native id `rel` mutate the DOM in a way innerHTML must reflect? Used to
# latch g_dom_mutated, which is what lets an UNMUTATED page keep the cheap
# source-slice innerHTML path (and so stay byte-identical to before this
# change) while a mutated one re-serialises. Deliberately over-inclusive:
# a false positive costs one re-serialisation, a false negative is a stale read.
def _nid_mutates(rel: int32) -> int32:
    if rel == NID_APPEND or rel == NID_APPEND_M or rel == NID_INSBEF or \
       rel == NID_REMCHILD or rel == NID_REPLCHILD or rel == NID_REMOVE:
        return 1
    if rel == NID_SETATTR or rel == NID_REMATTR or rel == NID_TOGGLEATTR:
        g_attr_gen = g_attr_gen + 1                # invalidate el.attributes
        return 1
    if rel == NID_CLSADD or rel == NID_CLSREM or rel == NID_CLSTOG or \
       rel == NID_CLSREPL:
        return 1
    if rel == NID_TC_SET or rel == NID_IH_SET or rel == NID_INSADJ:
        return 1
    if rel == NID_STYLE_SETPROP or rel == NID_STYLE_REMPROP:
        return 1
    return 0


# Is `v` a node that is part of the SOURCE tree — itself a registered source
# element, or a created node whose parent chain reaches one?
def _in_source_tree(v: int32) -> int32:
    cur: int32 = v
    d: int32 = 0
    while d < 64 and js_type_of(cur) == TAG_OBJ:
        if _find_el_by_obj(cur) >= 0:
            return 1
        cur = js_get_prop(cur, cast[Ptr[uint8]]("parentNode"), 10)
        d = d + 1
    return 0


# Does this mutating call touch the source tree at all? A page that builds a
# DETACHED subtree (createElement + setAttribute + appendChild, before mounting)
# cannot change any source element's innerHTML, so it must not latch
# g_dom_mutated — which would put every innerHTML read for the rest of the
# page's life on the re-serialising path. Mounting the subtree goes through a
# call whose receiver or argument IS in the source tree, and that latches.
def _mutation_touches_source() -> int32:
    if js_this() == js_doc or js_this() == js_win:
        return 1
    if _in_source_tree(js_this()) != 0:
        return 1
    n: int32 = js_arg_count()
    if n > 4:
        n = 4
    i: int32 = 0
    while i < n:
        if js_type_of(js_arg(i)) == TAG_OBJ and _in_source_tree(js_arg(i)) != 0:
            return 1
        i = i + 1
    return 0


# ---- Node.prototype generics ------------------------------------------------
# hasChildNodes / normalize / isEqualNode / isSameNode / compareDocumentPosition
# / getRootNode / lookupNamespaceURI / lookupPrefix / isDefaultNamespace.
#
# All of these are written against the JS-VISIBLE node shape (nodeType,
# parentNode, childNodes, attributes, namespaceURI, prefix, localName, data)
# rather than the source-element index, so ONE implementation serves source
# elements, createElement nodes, text, comments, fragments and the document.
#
# Every expected value below was MEASURED against `chromium --headless`
# (scratch fixture c1.html) before it was written, not read off the spec:
#   div.compareDocumentPosition(div.firstChild)  -> 20  (CONTAINED_BY|FOLLOWING)
#   div.firstChild.compareDocumentPosition(div)  -> 10  (CONTAINS|PRECEDING)
#   disconnected                                 -> 37  (DISCONNECTED|FOLLOWING|
#                                                        IMPLEMENTATION_SPECIFIC)
#   createElementNS('fooNamespace','prefix:elem').lookupNamespaceURI('xml')
#                                                -> the XML namespace
#   textNode.lookupNamespaceURI(null)            -> the XHTML namespace
#   document.createDocumentFragment().lookupNamespaceURI(null) -> null

ndg_pfx: Array[256, uint8]           # lookup* prefix / namespace argument
ndg_pfxn: int32 = 0
ndg_attrname: Array[256, uint8]      # "xmlns:<prefix>" probe


def _nd_type(v: int32) -> int32:
    if js_type_of(v) != TAG_OBJ:
        return 0
    nt: int32 = js_get_prop(v, cast[Ptr[uint8]]("nodeType"), 8)
    if js_type_of(nt) != TAG_NUM:
        return 0
    return cast[int32](js_to_number(nt))


# A node's live child list, or 0 when it has none the JS layer can see.
def _nd_kids(v: int32) -> int32:
    if js_type_of(v) != TAG_OBJ:
        return 0
    k: int32 = js_get_prop(v, cast[Ptr[uint8]]("childNodes"), 10)
    if js_is_array(k) == 0:
        return 0
    return k


def _nd_parent(v: int32) -> int32:
    if js_type_of(v) != TAG_OBJ:
        return js_null()
    return js_get_prop(v, cast[Ptr[uint8]]("parentNode"), 10)


# The nearest ELEMENT ancestor, used by the namespace lookups (a text node
# resolves its namespace through its parent element, measured in chromium).
def _nd_parent_el(v: int32) -> int32:
    p: int32 = _nd_parent(v)
    d: int32 = 0
    while d < 256 and js_type_of(p) == TAG_OBJ:
        if _nd_type(p) == 1:
            return p
        p = _nd_parent(p)
        d = d + 1
    return js_null()


# String value of `v`, or 0 bytes when it is not a string.
def _nd_str_eq(v: int32, p: Ptr[uint8], n: int32) -> int32:
    if js_type_of(v) != TAG_STR:
        return 0
    return _bytes_eq(js_str_bytes(v), js_str_bytelen(v), p, n)


def _nd_str_empty(v: int32) -> int32:
    if js_type_of(v) != TAG_STR:
        return 1
    if js_str_bytelen(v) == 0:
        return 1
    return 0


# Read argument 0 as the prefix / namespace operand into ndg_pfx. Returns 1 when
# the argument was null or undefined (which the algorithms treat exactly the
# same as the empty string, per the spec's "if prefix is the empty string, set
# it to null" step) and 0 otherwise.
def _nd_read_arg0() -> int32:
    ndg_pfxn = 0
    if js_arg_count() < 1:
        return 1
    a: int32 = js_arg(0)
    if js_type_of(a) == TAG_NULL or js_type_of(a) == TAG_UNDEF:
        return 1
    ndg_pfxn = _js_str_to_cbuf(a, &ndg_pfx[0], 255)
    if ndg_pfxn == 0:
        return 1
    return 0


# "locate a namespace": the namespace URI in scope for `prefix` at `node`.
# Returns a JS string, or js_null().
def _nd_lookup_ns(node: int32, isnull: int32, depth: int32) -> int32:
    if depth > 64 or js_type_of(node) != TAG_OBJ:
        return js_null()
    kind: int32 = _nd_type(node)
    if kind == 9:                                          # Document
        de: int32 = js_get_prop(node, cast[Ptr[uint8]]("documentElement"), 15)
        if js_type_of(de) != TAG_OBJ:
            return js_null()
        return _nd_lookup_ns(de, isnull, depth + 1)
    if kind == 10 or kind == 11:                           # DocumentType/Fragment
        return js_null()
    if kind == 2:                                          # Attr
        oe: int32 = js_get_prop(node, cast[Ptr[uint8]]("ownerElement"), 12)
        if js_type_of(oe) != TAG_OBJ:
            return js_null()
        return _nd_lookup_ns(oe, isnull, depth + 1)
    if kind != 1:                                          # Text/Comment/PI/...
        pe: int32 = _nd_parent_el(node)
        if js_type_of(pe) != TAG_OBJ:
            return js_null()
        return _nd_lookup_ns(pe, isnull, depth + 1)
    # Element. The `xml` and `xmlns` prefixes are implicitly declared on every
    # element and on nothing else: MEASURED in chromium, a DocumentFragment and
    # a documentElement-less Document both answer null for both prefixes, while
    # any element answers the XML / XMLNS namespace regardless of its own.
    if isnull == 0:
        if _bytes_eq(&ndg_pfx[0], ndg_pfxn, cast[Ptr[uint8]]("xml"), 3) != 0:
            return js_new_string( \
                cast[Ptr[uint8]]("http://www.w3.org/XML/1998/namespace"), 36)
        if _bytes_eq(&ndg_pfx[0], ndg_pfxn, cast[Ptr[uint8]]("xmlns"), 5) != 0:
            return js_new_string( \
                cast[Ptr[uint8]]("http://www.w3.org/2000/xmlns/"), 29)
    # its own namespace first, then its xmlns declarations.
    nsv: int32 = js_get_prop(node, cast[Ptr[uint8]]("namespaceURI"), 12)
    pfv: int32 = js_get_prop(node, cast[Ptr[uint8]]("prefix"), 6)
    if _nd_str_empty(nsv) == 0:
        if isnull != 0:
            if _nd_str_empty(pfv) != 0:
                return nsv
        elif _nd_str_eq(pfv, &ndg_pfx[0], ndg_pfxn) != 0:
            return nsv
    at: int32 = js_get_prop(node, cast[Ptr[uint8]]("attributes"), 10)
    if js_is_array(at) != 0:
        # the probe name: "xmlns" for the default namespace, "xmlns:<prefix>"
        # otherwise.
        pn: int32 = 5
        ndg_attrname[0] = 120                              # 'x'
        ndg_attrname[1] = 109                              # 'm'
        ndg_attrname[2] = 108                              # 'l'
        ndg_attrname[3] = 110                              # 'n'
        ndg_attrname[4] = 115                              # 's'
        if isnull == 0:
            ndg_attrname[5] = 58                           # ':'
            pn = 6
            j: int32 = 0
            while j < ndg_pfxn and pn < 255:
                ndg_attrname[pn] = ndg_pfx[j]
                pn = pn + 1
                j = j + 1
        i: int32 = 0
        an: int32 = js_array_len(at)
        while i < an:
            av: int32 = js_array_get(at, i)
            anm: int32 = js_get_prop(av, cast[Ptr[uint8]]("name"), 4)
            if _nd_str_eq(anm, &ndg_attrname[0], pn) != 0:
                val: int32 = js_get_prop(av, cast[Ptr[uint8]]("value"), 5)
                if _nd_str_empty(val) != 0:
                    return js_null()
                return val
            i = i + 1
    up: int32 = _nd_parent_el(node)
    if js_type_of(up) != TAG_OBJ:
        return js_null()
    return _nd_lookup_ns(up, isnull, depth + 1)


# "locate a prefix": the prefix bound to the namespace now in ndg_pfx at `node`.
def _nd_lookup_prefix(node: int32, depth: int32) -> int32:
    if depth > 64 or js_type_of(node) != TAG_OBJ:
        return js_null()
    kind: int32 = _nd_type(node)
    if kind == 9:
        de: int32 = js_get_prop(node, cast[Ptr[uint8]]("documentElement"), 15)
        if js_type_of(de) != TAG_OBJ:
            return js_null()
        return _nd_lookup_prefix(de, depth + 1)
    if kind == 10 or kind == 11:
        return js_null()
    if kind == 2:
        oe: int32 = js_get_prop(node, cast[Ptr[uint8]]("ownerElement"), 12)
        if js_type_of(oe) != TAG_OBJ:
            return js_null()
        return _nd_lookup_prefix(oe, depth + 1)
    if kind != 1:
        pe: int32 = _nd_parent_el(node)
        if js_type_of(pe) != TAG_OBJ:
            return js_null()
        return _nd_lookup_prefix(pe, depth + 1)
    nsv: int32 = js_get_prop(node, cast[Ptr[uint8]]("namespaceURI"), 12)
    pfv: int32 = js_get_prop(node, cast[Ptr[uint8]]("prefix"), 6)
    if _nd_str_eq(nsv, &ndg_pfx[0], ndg_pfxn) != 0 and _nd_str_empty(pfv) == 0:
        return pfv
    at: int32 = js_get_prop(node, cast[Ptr[uint8]]("attributes"), 10)
    if js_is_array(at) != 0:
        i: int32 = 0
        an: int32 = js_array_len(at)
        while i < an:
            av: int32 = js_array_get(at, i)
            anm: int32 = js_get_prop(av, cast[Ptr[uint8]]("name"), 4)
            if js_type_of(anm) == TAG_STR and js_str_bytelen(anm) > 6:
                ap: Ptr[uint8] = js_str_bytes(anm)
                if _bytes_eq(ap, 6, cast[Ptr[uint8]]("xmlns:"), 6) != 0:
                    val: int32 = js_get_prop(av, cast[Ptr[uint8]]("value"), 5)
                    if _nd_str_eq(val, &ndg_pfx[0], ndg_pfxn) != 0:
                        return js_new_string(&ap[6], \
                                             cast[uint64](js_str_bytelen(anm) - 6))
            i = i + 1
    up: int32 = _nd_parent_el(node)
    if js_type_of(up) != TAG_OBJ:
        return js_null()
    return _nd_lookup_prefix(up, depth + 1)


# The node's data/value for equality: `data` on CharacterData, `value` on Attr.
def _nd_data_eq(a: int32, b: int32, nm: Ptr[uint8], nn: uint64) -> int32:
    av: int32 = js_get_prop(a, nm, nn)
    bv: int32 = js_get_prop(b, nm, nn)
    if js_type_of(av) != js_type_of(bv):
        return 0
    if js_type_of(av) != TAG_STR:
        return 1
    return _bytes_eq(js_str_bytes(av), js_str_bytelen(av), \
                     js_str_bytes(bv), js_str_bytelen(bv))


def _nd_is_equal(a: int32, b: int32, depth: int32) -> int32:
    if a == b:
        return 1
    if js_type_of(a) != TAG_OBJ or js_type_of(b) != TAG_OBJ:
        return 0
    if depth > 64:
        return 0
    ka: int32 = _nd_type(a)
    if ka != _nd_type(b):
        return 0
    if ka == 10:                                           # DocumentType
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("name"), 4) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("publicId"), 8) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("systemId"), 8) == 0:
            return 0
    elif ka == 1:                                          # Element
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("namespaceURI"), 12) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("prefix"), 6) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("localName"), 9) == 0:
            return 0
        aa: int32 = js_get_prop(a, cast[Ptr[uint8]]("attributes"), 10)
        ba: int32 = js_get_prop(b, cast[Ptr[uint8]]("attributes"), 10)
        an: int32 = 0
        bn: int32 = 0
        if js_is_array(aa) != 0:
            an = js_array_len(aa)
        if js_is_array(ba) != 0:
            bn = js_array_len(ba)
        if an != bn:
            return 0
        i: int32 = 0
        while i < an:
            avv: int32 = js_array_get(aa, i)
            anm: int32 = js_get_prop(avv, cast[Ptr[uint8]]("name"), 4)
            hit: int32 = 0
            j: int32 = 0
            while j < bn:
                bvv: int32 = js_array_get(ba, j)
                bnm: int32 = js_get_prop(bvv, cast[Ptr[uint8]]("name"), 4)
                if js_type_of(anm) == TAG_STR and js_type_of(bnm) == TAG_STR and \
                   _bytes_eq(js_str_bytes(anm), js_str_bytelen(anm), \
                             js_str_bytes(bnm), js_str_bytelen(bnm)) != 0:
                    if _nd_data_eq(avv, bvv, cast[Ptr[uint8]]("value"), 5) != 0:
                        hit = 1
                j = j + 1
            if hit == 0:
                return 0
            i = i + 1
    elif ka == 2:                                          # Attr
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("namespaceURI"), 12) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("localName"), 9) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("value"), 5) == 0:
            return 0
        return 1
    elif ka == 7:                                          # ProcessingInstruction
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("target"), 6) == 0:
            return 0
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("data"), 4) == 0:
            return 0
    elif ka == 3 or ka == 4 or ka == 8:                    # Text/CDATA/Comment
        if _nd_data_eq(a, b, cast[Ptr[uint8]]("data"), 4) == 0:
            return 0
    ak2: int32 = _nd_kids(a)
    bk2: int32 = _nd_kids(b)
    al: int32 = 0
    bl: int32 = 0
    if ak2 != 0:
        al = js_array_len(ak2)
    if bk2 != 0:
        bl = js_array_len(bk2)
    if al != bl:
        return 0
    k: int32 = 0
    while k < al:
        if _nd_is_equal(js_array_get(ak2, k), js_array_get(bk2, k), depth + 1) == 0:
            return 0
        k = k + 1
    return 1


# Is `anc` an inclusive ancestor of `n`?
def _nd_is_ancestor(anc: int32, n: int32) -> int32:
    cur: int32 = n
    d: int32 = 0
    while d < 256 and js_type_of(cur) == TAG_OBJ:
        if cur == anc:
            return 1
        cur = _nd_parent(cur)
        d = d + 1
    return 0


def _nd_root(n: int32) -> int32:
    cur: int32 = n
    d: int32 = 0
    while d < 256:
        p: int32 = _nd_parent(cur)
        if js_type_of(p) != TAG_OBJ:
            return cur
        cur = p
        d = d + 1
    return cur


# Index of `child` inside `parent`'s child list, or -1.
def _nd_child_index(parent: int32, child: int32) -> int32:
    ks: int32 = _nd_kids(parent)
    if ks == 0:
        return -1
    i: int32 = 0
    n: int32 = js_array_len(ks)
    while i < n:
        if js_array_get(ks, i) == child:
            return i
        i = i + 1
    return -1


# node.compareDocumentPosition(other). Chromium-measured values above.
def _nd_compare_pos(a: int32, b: int32) -> int32:
    if a == b:
        return 0
    if js_type_of(b) != TAG_OBJ:
        return 0
    if _nd_root(a) != _nd_root(b):
        # DISCONNECTED | IMPLEMENTATION_SPECIFIC | a consistent direction. The
        # direction must be STABLE and OPPOSITE for the reversed call (WPT
        # asserts exactly that), so it is derived from the handle order.
        if a < b:
            return 37                                      # 1|4|32
        return 35                                          # 1|2|32
    if _nd_is_ancestor(a, b) != 0:
        return 20                                          # CONTAINED_BY|FOLLOWING
    if _nd_is_ancestor(b, a) != 0:
        return 10                                          # CONTAINS|PRECEDING
    # Neither contains the other: walk both ancestor chains to their first
    # divergence and compare sibling index there.
    ca: int32 = a
    da: int32 = 0
    while da < 256:
        pa: int32 = _nd_parent(ca)
        if js_type_of(pa) != TAG_OBJ:
            break
        cb: int32 = b
        db: int32 = 0
        while db < 256:
            pb: int32 = _nd_parent(cb)
            if js_type_of(pb) != TAG_OBJ:
                break
            if pa == pb:
                ia: int32 = _nd_child_index(pa, ca)
                ib: int32 = _nd_child_index(pa, cb)
                if ia >= 0 and ib >= 0:
                    if ia < ib:
                        return 4                           # FOLLOWING
                    return 2                               # PRECEDING
                break
            cb = pb
            db = db + 1
        ca = pa
        da = da + 1
    if a < b:
        return 4
    return 2


ndg_cat: Array[16384, uint8]         # normalize() text-merge scratch


# Concatenate two JS strings through a BSS scratch buffer (no stack buffers —
# the native user stack is one 4 KiB page).
def _nd_concat(a: int32, b: int32) -> int32:
    w: int32 = 0
    if js_type_of(a) == TAG_STR:
        ap: Ptr[uint8] = js_str_bytes(a)
        an: int32 = js_str_bytelen(a)
        i: int32 = 0
        while i < an and w < 16383:
            ndg_cat[w] = ap[i]
            w = w + 1
            i = i + 1
    if js_type_of(b) == TAG_STR:
        bp: Ptr[uint8] = js_str_bytes(b)
        bn: int32 = js_str_bytelen(b)
        j: int32 = 0
        while j < bn and w < 16383:
            ndg_cat[w] = bp[j]
            w = w + 1
            j = j + 1
    return js_new_string(&ndg_cat[0], cast[uint64](w))


# node.normalize(): drop empty Text children and merge adjacent ones, then
# recurse. Operates on the live JS child list, so it serves created subtrees
# (which is what every WPT normalize test builds).
def _nd_normalize(n: int32, depth: int32):
    if depth > 64 or js_type_of(n) != TAG_OBJ:
        return
    ks: int32 = _nd_kids(n)
    if ks == 0:
        return
    ln: int32 = js_array_len(ks)
    nw: int32 = js_new_array_v()
    prev: int32 = 0
    i: int32 = 0
    while i < ln:
        c: int32 = js_array_get(ks, i)
        if _nd_type(c) == 3:
            dv: int32 = js_get_prop(c, cast[Ptr[uint8]]("data"), 4)
            if _nd_str_empty(dv) != 0:
                i = i + 1
                continue
            if prev != 0:
                pv: int32 = js_get_prop(prev, cast[Ptr[uint8]]("data"), 4)
                merged: int32 = _nd_concat(pv, dv)
                js_set_prop(prev, cast[Ptr[uint8]]("data"), 4, merged)
                js_set_prop(prev, cast[Ptr[uint8]]("nodeValue"), 9, merged)
                js_set_prop(prev, cast[Ptr[uint8]]("textContent"), 11, merged)
                js_set_prop(prev, cast[Ptr[uint8]]("length"), 6, \
                            js_number(cast[float64](js_str_bytelen(merged))))
                js_set_prop(c, cast[Ptr[uint8]]("parentNode"), 10, js_null())
                i = i + 1
                continue
            prev = c
        else:
            prev = 0
            _nd_normalize(c, depth + 1)
        js_array_push(nw, c)
        i = i + 1
    js_set_own(n, cast[Ptr[uint8]]("childNodes"), 10, nw)


# ---- "ensure pre-insertion validity" (DOM 4.2.1) ----------------------------
# ONE algorithm shared by appendChild / insertBefore / replaceChild and the
# whole ChildNode / ParentNode mutation family. Measured worth: 44 WPT subtests
# were failing with a bare `assert_throws_dom: function ... did not throw`, and
# a further 29 with "threw object TypeError ... that is not a DOMException" —
# the tests are checking these rejections, not the happy path.
#
# Returns 1 when it has THROWN (the caller must return immediately), 0 when the
# insertion is valid.
def _pre_insert_invalid(parentv: int32, nodev: int32, childv: int32) -> int32:
    pk: int32 = _nd_type(parentv)
    # 1. parent must be a Document, DocumentFragment or Element.
    if pk != 9 and pk != 11 and pk != 1:
        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                      cast[Ptr[uint8]]("parent cannot have children"), 27)
        return 1
    # 2. node must not be an inclusive ancestor of parent.
    if js_type_of(nodev) == TAG_OBJ and _nd_is_ancestor(nodev, parentv) != 0:
        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                      cast[Ptr[uint8]]("node is an ancestor of parent"), 29)
        return 1
    # 3. a non-null reference child must actually be a child of parent.
    if js_type_of(childv) == TAG_OBJ:
        if _nd_child_index(parentv, childv) < 0:
            _throw_domexc(cast[Ptr[uint8]]("NotFoundError"), 13, \
                          cast[Ptr[uint8]]("reference node is not a child"), 29)
            return 1
    nk: int32 = _nd_type(nodev)
    # 4. node must be a DocumentFragment, DocumentType, Element, CharacterData
    #    or ProcessingInstruction. Anything else (a plain object, a Document)
    #    is a HierarchyRequestError, NOT a TypeError.
    if nk != 11 and nk != 10 and nk != 1 and nk != 3 and nk != 4 and \
       nk != 7 and nk != 8:
        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                      cast[Ptr[uint8]]("node is not insertable"), 22)
        return 1
    # 5. Text may not be a child of a Document; a doctype may only be.
    if nk == 3 and pk == 9:
        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                      cast[Ptr[uint8]]("text cannot be a child of a document"), 36)
        return 1
    if nk == 10 and pk != 9:
        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                      cast[Ptr[uint8]]("doctype must be a child of a document"), 37)
        return 1
    # 6. Document parents accept at most one element child, and a fragment may
    #    not carry more than one element into one.
    if pk == 9:
        if nk == 11:
            fk: int32 = _nd_kids(nodev)
            nel: int32 = 0
            if fk != 0:
                fi: int32 = 0
                fn: int32 = js_array_len(fk)
                while fi < fn:
                    if _nd_type(js_array_get(fk, fi)) == 1:
                        nel = nel + 1
                    elif _nd_type(js_array_get(fk, fi)) == 3:
                        _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                                      cast[Ptr[uint8]]("text in fragment"), 16)
                        return 1
                    fi = fi + 1
            if nel > 1:
                _throw_domexc(cast[Ptr[uint8]]("HierarchyRequestError"), 21, \
                              cast[Ptr[uint8]]("fragment has multiple elements"), 30)
                return 1
    return 0


# Mark every parent->child edge pointing at created node `cid` as unlinked.
def _unlink_cre_edges(cid: int32):
    b: int32 = 0
    while b < cc_n:
        if cc_child[b] == cid:
            cc_removed[b] = 1
        b = b + 1
    a: int32 = 0
    while a < ap_n:
        if ap_child[a] == cid:
            ap_removed[a] = 1
        a = a + 1


# Spec step "if node's parent is non-null, remove node" — an insertion MOVES a
# node rather than duplicating it. Without this the WPT ChildNode/ParentNode
# files, which deliberately re-append ONE child object into a series of fresh
# parents, saw it accumulate in every parent at once
# ("text<!--test--><!--test-->").
#
# Deliberately does NOT set cre_gone: the caller is about to re-insert, and a
# node that is only ever unlinked here must stay renderable at its new home.
def _detach_from_parent_v(childv: int32):
    if js_type_of(childv) != TAG_OBJ:
        return
    par: int32 = js_get_prop(childv, cast[Ptr[uint8]]("parentNode"), 10)
    cid: int32 = _find_cre_by_obj(childv)
    if cid >= 0:
        _unlink_cre_edges(cid)
    if js_type_of(par) == TAG_OBJ:
        _dom_children_drop(par, childv)
        _wire_sibling_links(js_get_prop(par, cast[Ptr[uint8]]("children"), 8), par)
    js_set_prop(childv, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    js_set_prop(childv, cast[Ptr[uint8]]("parentElement"), 13, js_null())


# parent.insertBefore(newv, refv) with EXPLICIT values (refv == js_null()
# appends). Factored out of the NID_INSBEF handler so the ChildNode /
# ParentNode mutation methods (before / after / replaceWith / prepend /
# replaceChildren) can reuse the one insertion path instead of growing a second
# copy of the source-element vs created-node bookkeeping.
def _insert_before_v(parentv: int32, newv: int32, refv: int32):
    _detach_from_parent_v(newv)
    nch: int32 = _find_cre_by_obj(newv)
    if nch >= 0:
        cre_gone[nch] = 0
        rch: int32 = -1
        if js_type_of(refv) == TAG_OBJ:
            rch = _find_cre_by_obj(refv)
        par2: int32 = _find_el_by_obj(parentv)
        if par2 >= 0:
            at: int32 = -1
            if rch >= 0:
                at = _ap_find(par2, rch)
            _ap_add(par2, nch, at)
            js_set_prop(newv, cast[Ptr[uint8]]("parentNode"), 10, dom_obj[par2])
            js_set_prop(newv, cast[Ptr[uint8]]("parentElement"), 13, dom_obj[par2])
            _dom_children_insert(parentv, newv, refv)
        else:
            pcid2: int32 = _find_cre_by_obj(parentv)
            if pcid2 >= 0:
                at2: int32 = -1
                if rch >= 0:
                    at2 = _cc_find(pcid2, rch)
                _cc_add(pcid2, nch, at2)
                js_set_prop(newv, cast[Ptr[uint8]]("parentNode"), 10, parentv)
                js_set_prop(newv, cast[Ptr[uint8]]("parentElement"), 13, parentv)
                _dom_children_insert(parentv, newv, refv)
    _wire_sibling_links(js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8), \
                        parentv)
    _mo_record_childlist(parentv, newv, -1)


# Detach `childv` from `parentv`, mirroring the NID_REMCHILD handler.
def _remove_child_v(parentv: int32, childv: int32):
    rc: int32 = _find_cre_by_obj(childv)
    rcs: int32 = -1
    if rc < 0:
        rcs = _find_el_by_obj(childv)
    if rc >= 0 or rcs >= 0:
        if rc >= 0:
            cre_gone[rc] = 1
        else:
            dom_detached[rcs] = 1
        js_set_prop(childv, cast[Ptr[uint8]]("parentNode"), 10, js_null())
        js_set_prop(childv, cast[Ptr[uint8]]("parentElement"), 13, js_null())
        _dom_children_drop(parentv, childv)
        _wire_sibling_links(js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8), \
                            parentv)
        _mo_record_childlist(parentv, -1, childv)


# ChildNode / ParentNode take (Node or DOMString)... — a bare string argument
# becomes a Text node. Returns the node object for `v`.
def _nd_as_node(v: int32) -> int32:
    if js_type_of(v) == TAG_OBJ and _nd_type(v) != 0:
        return v
    sv: int32 = v
    if js_type_of(v) != TAG_STR:
        sv = js_new_string(js_str_ptr(v), cast[uint64](_cstr_len(js_str_ptr(v))))
    return _cre_make_text(sv)


# ---- ChildNode.before/after/replaceWith + ParentNode.prepend/replaceChildren --
# Written entirely in terms of _insert_before_v / _remove_child_v, so they share
# the insertion bookkeeping with insertBefore rather than reimplementing it.
# A DocumentFragment argument contributes its CHILDREN, not itself (spec).
def _nd_insert_nodes(parentv: int32, refv: int32, from_arg: int32):
    # The spec converts the whole argument list into ONE DocumentFragment and
    # pre-inserts that, so a single invalid member rejects the entire call and
    # nothing is inserted. Validate first, mutate second.
    i: int32 = from_arg
    n: int32 = js_arg_count()
    while i < n:
        a0: int32 = js_arg(i)
        if js_type_of(a0) == TAG_OBJ and _nd_type(a0) != 0:
            if _pre_insert_invalid(parentv, a0, js_null()) != 0:
                return
        i = i + 1
    i = from_arg
    while i < n:
        a: int32 = js_arg(i)
        if _is_fragment(a) != 0:
            fk: int32 = js_get_prop(a, cast[Ptr[uint8]]("children"), 8)
            if js_is_array(fk) != 0:
                j: int32 = 0
                fn: int32 = js_array_len(fk)
                while j < fn:
                    _insert_before_v(parentv, js_array_get(fk, j), refv)
                    j = j + 1
            _frag_clear(a)
        else:
            _insert_before_v(parentv, _nd_as_node(a), refv)
        i = i + 1


# Is `v` one of the current call's arguments?
def _nd_arg_is(v: int32) -> int32:
    i: int32 = 0
    n: int32 = js_arg_count()
    while i < n:
        if js_arg(i) == v:
            return 1
        i = i + 1
    return 0


# ---- CharacterData -----------------------------------------------------------
# One backing field (__cd) behind data / nodeValue / textContent / length, plus
# the five mutation methods and splitText. Offsets and counts are UTF-16 code
# units, which is both what the DOM specifies and what our String.prototype
# already models (js_str_u16_len / js_str_sub_u16 expose the interpreter's own
# view, so the two can never disagree — "\u8cc7\u6599".length is 2 in both).
def _cd_get(node: int32) -> int32:
    v: int32 = js_get_prop(node, cast[Ptr[uint8]]("__cd"), 4)
    if js_type_of(v) != TAG_STR:
        return js_new_string(cast[Ptr[uint8]](""), 0)
    return v


# Store new data and fire a MutationObserver characterData record.
def _cd_set(node: int32, v: int32):
    js_set_own(node, cast[Ptr[uint8]]("__cd"), 4, v)
    if mreg_n != 0:
        _mo_record_chardata(node)


# Coerce an argument the way a DOMString parameter does: null becomes "null",
# undefined becomes "undefined", 0 becomes "0" — MEASURED in chromium
# (CharacterData-data.html asserts all three).
def _cd_arg_str(i: int32) -> int32:
    if js_arg_count() <= i:
        return js_new_string(cast[Ptr[uint8]](""), 0)
    a: int32 = js_arg(i)
    if js_type_of(a) == TAG_STR:
        return a
    if js_type_of(a) == TAG_NULL:
        return js_new_string(cast[Ptr[uint8]]("null"), 4)
    return js_new_string(js_str_bytes(a), cast[uint64](js_str_bytelen(a)))


# Splice: data[0,off) + ins + data[off+count, len).
def _cd_splice(node: int32, off: int32, count: int32, ins: int32) -> int32:
    cur: int32 = _cd_get(node)
    n: int32 = js_str_u16_len(cur)
    if off > n or off < 0:
        _throw_domexc(cast[Ptr[uint8]]("IndexSizeError"), 14, \
                      cast[Ptr[uint8]]("offset is out of bounds"), 23)
        return 1
    if count < 0 or off + count > n:
        count = n - off
    head: int32 = js_str_sub_u16(cur, 0, off)
    tail: int32 = js_str_sub_u16(cur, off + count, n)
    _cd_set(node, _nd_concat(_nd_concat(head, ins), tail))
    return 0


def _chardata_dispatch(rel: int32) -> int32:
    thisv: int32 = js_this()
    if rel == NID_CD_DATA_GET:
        return _cd_get(thisv)
    if rel == NID_CD_DATA_SET:
        _cd_set(thisv, _cd_arg_str(0))
        return js_undefined()
    if rel == NID_CD_LEN_GET:
        return js_number(cast[float64](js_str_u16_len(_cd_get(thisv))))
    if rel == NID_CD_LEN_SET:
        return js_undefined()                              # readonly
    # Every remaining method takes at least one numeric offset. An arity that is
    # too short is a TypeError, not an IndexSizeError (the WPT files check the
    # distinction explicitly).
    need: int32 = 2
    if rel == NID_CD_APPENDD or rel == NID_TEXT_SPLIT:
        need = 1
    if rel == NID_CD_REPLACED:
        need = 3
    if js_arg_count() < need:
        js_throw_type_error(cast[Ptr[uint8]]("not enough arguments"))
        return js_undefined()
    if rel == NID_CD_APPENDD:
        cur: int32 = _cd_get(thisv)
        _cd_set(thisv, _nd_concat(cur, _cd_arg_str(0)))
        return js_undefined()
    off: int32 = cast[int32](js_to_number(js_arg(0)))
    if rel == NID_TEXT_SPLIT:
        # text.splitText(offset): this keeps [0,offset), a NEW Text node with
        # the remainder is inserted as this node's next sibling and returned.
        cur2: int32 = _cd_get(thisv)
        n2: int32 = js_str_u16_len(cur2)
        if off < 0 or off > n2:
            return _throw_domexc(cast[Ptr[uint8]]("IndexSizeError"), 14, \
                                 cast[Ptr[uint8]]("offset is out of bounds"), 23)
        rest: int32 = js_str_sub_u16(cur2, off, n2)
        _cd_set(thisv, js_str_sub_u16(cur2, 0, off))
        newt: int32 = _cre_make_text(rest)
        par2: int32 = _nd_parent(thisv)
        if js_type_of(par2) == TAG_OBJ:
            kids: int32 = _nd_kids(par2)
            ix: int32 = _nd_child_index(par2, thisv)
            ref: int32 = js_null()
            if kids != 0 and ix >= 0 and ix + 1 < js_array_len(kids):
                ref = js_array_get(kids, ix + 1)
            _insert_before_v(par2, newt, ref)
        return newt
    if rel == NID_CD_SUBSTR:
        cur3: int32 = _cd_get(thisv)
        n3: int32 = js_str_u16_len(cur3)
        cnt: int32 = cast[int32](js_to_number(js_arg(1)))
        if off < 0 or off > n3:
            return _throw_domexc(cast[Ptr[uint8]]("IndexSizeError"), 14, \
                                 cast[Ptr[uint8]]("offset is out of bounds"), 23)
        if cnt < 0 or off + cnt > n3:
            cnt = n3 - off
        return js_str_sub_u16(cur3, off, off + cnt)
    if rel == NID_CD_INSERTD:
        _cd_splice(thisv, off, 0, _cd_arg_str(1))
        return js_undefined()
    if rel == NID_CD_DELETED:
        _cd_splice(thisv, off, cast[int32](js_to_number(js_arg(1))), \
                   js_new_string(cast[Ptr[uint8]](""), 0))
        return js_undefined()
    # NID_CD_REPLACED
    _cd_splice(thisv, off, cast[int32](js_to_number(js_arg(1))), _cd_arg_str(2))
    return js_undefined()


# ---- Range + TreeWalker + NodeIterator ---------------------------------------
# Boundary points and traversal state live as OWN PROPERTIES on the JS object
# (startContainer/startOffset/endContainer/endOffset, root/whatToShow/filter/
# currentNode), read back through js_this(). No parallel arrays: a Range is not
# a scarce resource here and the object IS the state, so nothing can go stale.
#
# The two DERIVED attributes are accessors, not snapshots: `collapsed` and
# `commonAncestorContainer` must track the boundary points as they move, and
# 26 of the 54 range files register ZERO subtests today because createRange()
# throws during setup and takes the whole file with it.

# The "length" of a node for boundary-point purposes: character length for
# CharacterData, child count for anything else.
def _rng_node_len(n: int32) -> int32:
    k: int32 = _nd_type(n)
    if k == 3 or k == 4 or k == 7 or k == 8:
        return js_str_u16_len(_cd_get(n))
    ks: int32 = _nd_kids(n)
    if ks == 0:
        return 0
    return js_array_len(ks)


# Compare boundary points (na, oa) and (nb, ob) in document order:
# -1 before, 0 equal, 1 after.
def _rng_cmp_bp(na: int32, oa: int32, nb: int32, ob: int32) -> int32:
    if na == nb:
        if oa < ob:
            return -1
        if oa > ob:
            return 1
        return 0
    # If one container contains the other, compare the offset against the index
    # of the containing chain's child.
    if _nd_is_ancestor(na, nb) != 0:
        c: int32 = nb
        d: int32 = 0
        while d < 256 and js_type_of(c) == TAG_OBJ:
            p: int32 = _nd_parent(c)
            if p == na:
                ci: int32 = _nd_child_index(na, c)
                if ci < oa:
                    return 1
                return -1
            c = p
            d = d + 1
    if _nd_is_ancestor(nb, na) != 0:
        c2: int32 = na
        d2: int32 = 0
        while d2 < 256 and js_type_of(c2) == TAG_OBJ:
            p2: int32 = _nd_parent(c2)
            if p2 == nb:
                ci2: int32 = _nd_child_index(nb, c2)
                if ci2 < ob:
                    return -1
                return 1
            c2 = p2
            d2 = d2 + 1
    dp: int32 = _nd_compare_pos(na, nb)
    if (dp & 4) != 0:                                      # nb FOLLOWS na
        return -1
    if (dp & 2) != 0:
        return 1
    return 0


def _rng_get(r: int32, nm: Ptr[uint8], n: uint64) -> int32:
    return js_get_prop(r, nm, n)


def _rng_off(r: int32, nm: Ptr[uint8], n: uint64) -> int32:
    return cast[int32](js_to_number(js_get_prop(r, nm, n)))


def _rng_set_start(r: int32, node: int32, off: int32):
    js_set_own(r, cast[Ptr[uint8]]("startContainer"), 14, node)
    js_set_own(r, cast[Ptr[uint8]]("startOffset"), 11, js_number(cast[float64](off)))
    ec: int32 = _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12)
    eo: int32 = _rng_off(r, cast[Ptr[uint8]]("endOffset"), 9)
    if js_type_of(ec) != TAG_OBJ or _nd_root(ec) != _nd_root(node) or \
       _rng_cmp_bp(node, off, ec, eo) > 0:
        js_set_own(r, cast[Ptr[uint8]]("endContainer"), 12, node)
        js_set_own(r, cast[Ptr[uint8]]("endOffset"), 9, \
                   js_number(cast[float64](off)))


def _rng_set_end(r: int32, node: int32, off: int32):
    js_set_own(r, cast[Ptr[uint8]]("endContainer"), 12, node)
    js_set_own(r, cast[Ptr[uint8]]("endOffset"), 9, js_number(cast[float64](off)))
    sc: int32 = _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14)
    so: int32 = _rng_off(r, cast[Ptr[uint8]]("startOffset"), 11)
    if js_type_of(sc) != TAG_OBJ or _nd_root(sc) != _nd_root(node) or \
       _rng_cmp_bp(sc, so, node, off) > 0:
        js_set_own(r, cast[Ptr[uint8]]("startContainer"), 14, node)
        js_set_own(r, cast[Ptr[uint8]]("startOffset"), 11, \
                   js_number(cast[float64](off)))


# A fresh Range, collapsed at (document, 0) as the spec requires.
def _rng_new() -> int32:
    r: int32 = js_new_object_v()
    if g_proto_range != 0:
        js_set_proto_v(r, g_proto_range)
    js_set_own(r, cast[Ptr[uint8]]("startContainer"), 14, js_doc)
    js_set_own(r, cast[Ptr[uint8]]("startOffset"), 11, js_number(0.0))
    js_set_own(r, cast[Ptr[uint8]]("endContainer"), 12, js_doc)
    js_set_own(r, cast[Ptr[uint8]]("endOffset"), 9, js_number(0.0))
    return r


# Accumulate the text a range covers into rw_buf (range.toString()).
def _rng_stringify(r: int32) -> int32:
    sc: int32 = _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14)
    so: int32 = _rng_off(r, cast[Ptr[uint8]]("startOffset"), 11)
    ec: int32 = _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12)
    eo: int32 = _rng_off(r, cast[Ptr[uint8]]("endOffset"), 9)
    if js_type_of(sc) != TAG_OBJ:
        return js_new_string(cast[Ptr[uint8]](""), 0)
    if sc == ec and _nd_type(sc) == 3:
        return js_str_sub_u16(_cd_get(sc), so, eo)
    out: int32 = js_new_string(cast[Ptr[uint8]](""), 0)
    cur: int32 = sc
    if _nd_type(sc) == 3:
        out = js_str_sub_u16(_cd_get(sc), so, js_str_u16_len(_cd_get(sc)))
    steps: int32 = 0
    while steps < 4096:
        cur = _rng_next_in_order(cur)
        if js_type_of(cur) != TAG_OBJ:
            return out
        if cur == ec:
            if _nd_type(ec) == 3:
                out = _nd_concat(out, js_str_sub_u16(_cd_get(ec), 0, eo))
            return out
        if _nd_type(cur) == 3:
            out = _nd_concat(out, _cd_get(cur))
        steps = steps + 1
    return out


# The next node in document order (pre-order), or js_null() at the end.
def _rng_next_in_order(n: int32) -> int32:
    ks: int32 = _nd_kids(n)
    if ks != 0 and js_array_len(ks) > 0:
        return js_array_get(ks, 0)
    cur: int32 = n
    d: int32 = 0
    while d < 256 and js_type_of(cur) == TAG_OBJ:
        p: int32 = _nd_parent(cur)
        if js_type_of(p) != TAG_OBJ:
            return js_null()
        pk2: int32 = _nd_kids(p)
        ix: int32 = _nd_child_index(p, cur)
        if pk2 != 0 and ix >= 0 and ix + 1 < js_array_len(pk2):
            return js_array_get(pk2, ix + 1)
        cur = p
        d = d + 1
    return js_null()


# ---- traversal ---------------------------------------------------------------
# whatToShow is a bitmask over (1 << (nodeType - 1)); NodeFilter.SHOW_ALL is
# 0xFFFFFFFF. The filter is a function OR an object with an acceptNode method,
# and both forms appear in the WPT files.
def _tv_show_ok(w: int32, node: int32) -> int32:
    k: int32 = _nd_type(node)
    if k <= 0 or k > 32:
        return 0
    if (w & (1 << (k - 1))) != 0:
        return 1
    return 0


# 1 = FILTER_ACCEPT, 2 = FILTER_REJECT, 3 = FILTER_SKIP.
def _tv_filter(tv: int32, node: int32) -> int32:
    w: int32 = cast[int32](js_to_number(js_get_prop(tv, \
                           cast[Ptr[uint8]]("whatToShow"), 10)))
    if _tv_show_ok(w, node) == 0:
        return 3                                           # SKIP, never REJECT
    f: int32 = js_get_prop(tv, cast[Ptr[uint8]]("filter"), 6)
    if js_type_of(f) != TAG_OBJ:
        return 1
    fn: int32 = f
    if js_is_callable(f) == 0:
        fn = js_get_prop(f, cast[Ptr[uint8]]("acceptNode"), 10)
        if js_is_callable(fn) == 0:
            return 1
    g_argv1[0] = node
    rv: int32 = js_call_fn(fn, f, &g_argv1[0], 1)
    r: int32 = cast[int32](js_to_number(rv))
    if r == 2:
        return 2
    if r == 3:
        return 3
    return 1


def _tv_root(tv: int32) -> int32:
    return js_get_prop(tv, cast[Ptr[uint8]]("root"), 4)


def _tv_first_child(n: int32) -> int32:
    ks: int32 = _nd_kids(n)
    if ks == 0 or js_array_len(ks) == 0:
        return js_null()
    return js_array_get(ks, 0)


def _tv_last_child(n: int32) -> int32:
    ks: int32 = _nd_kids(n)
    if ks == 0 or js_array_len(ks) == 0:
        return js_null()
    return js_array_get(ks, js_array_len(ks) - 1)


def _tv_sibling(n: int32, dir: int32) -> int32:
    p: int32 = _nd_parent(n)
    if js_type_of(p) != TAG_OBJ:
        return js_null()
    ks: int32 = _nd_kids(p)
    ix: int32 = _nd_child_index(p, n)
    if ks == 0 or ix < 0:
        return js_null()
    j: int32 = ix + dir
    if j < 0 or j >= js_array_len(ks):
        return js_null()
    return js_array_get(ks, j)


# TreeWalker child traversal (spec "traverse children"): descend, skipping
# SKIP nodes into their own children and stepping over REJECTed subtrees.
def _tw_traverse_children(tv: int32, first: int32) -> int32:
    cur: int32 = js_get_prop(tv, cast[Ptr[uint8]]("currentNode"), 11)
    n: int32 = _tv_first_child(cur)
    if first == 0:
        n = _tv_last_child(cur)
    steps: int32 = 0
    while steps < 4096 and js_type_of(n) == TAG_OBJ:
        steps = steps + 1
        f: int32 = _tv_filter(tv, n)
        if f == 1:
            js_set_own(tv, cast[Ptr[uint8]]("currentNode"), 11, n)
            return n
        if f == 3:
            c: int32 = _tv_first_child(n)
            if first == 0:
                c = _tv_last_child(n)
            if js_type_of(c) == TAG_OBJ:
                n = c
                continue
        # step sideways, climbing while there is no sibling
        d: int32 = 0
        while d < 256:
            sib: int32 = _tv_sibling(n, 1)
            if first == 0:
                sib = _tv_sibling(n, -1)
            if js_type_of(sib) == TAG_OBJ:
                n = sib
                d = 256
            else:
                pn: int32 = _nd_parent(n)
                if js_type_of(pn) != TAG_OBJ or pn == _tv_root(tv) or pn == cur:
                    return js_null()
                n = pn
                d = d + 1
    return js_null()


def _tw_traverse_siblings(tv: int32, dir: int32) -> int32:
    cur: int32 = js_get_prop(tv, cast[Ptr[uint8]]("currentNode"), 11)
    n: int32 = cur
    if n == _tv_root(tv):
        return js_null()
    steps: int32 = 0
    while steps < 4096:
        steps = steps + 1
        sib: int32 = _tv_sibling(n, dir)
        while js_type_of(sib) == TAG_OBJ:
            f: int32 = _tv_filter(tv, sib)
            if f == 1:
                js_set_own(tv, cast[Ptr[uint8]]("currentNode"), 11, sib)
                return sib
            n = sib
            inner: int32 = _tv_first_child(sib)
            if dir < 0:
                inner = _tv_last_child(sib)
            if f == 2 or js_type_of(inner) != TAG_OBJ:
                sib = _tv_sibling(sib, dir)
            else:
                sib = inner
        n = _nd_parent(n)
        if js_type_of(n) != TAG_OBJ or n == _tv_root(tv):
            return js_null()
        if _tv_filter(tv, n) == 1:
            return js_null()
    return js_null()


def _rng_dispatch(rel: int32) -> int32:
    thisv: int32 = js_this()
    if rel == NID_CREATERANGE or rel == NID_RNG_CTOR:
        return _rng_new()
    if rel == NID_STATICRANGE_CTOR:
        sr: int32 = js_new_object_v()
        if js_arg_count() >= 1 and js_type_of(js_arg(0)) == TAG_OBJ:
            init: int32 = js_arg(0)
            js_set_prop(sr, cast[Ptr[uint8]]("startContainer"), 14, \
                        js_get_prop(init, cast[Ptr[uint8]]("startContainer"), 14))
            js_set_prop(sr, cast[Ptr[uint8]]("startOffset"), 11, \
                        js_get_prop(init, cast[Ptr[uint8]]("startOffset"), 11))
            js_set_prop(sr, cast[Ptr[uint8]]("endContainer"), 12, \
                        js_get_prop(init, cast[Ptr[uint8]]("endContainer"), 12))
            js_set_prop(sr, cast[Ptr[uint8]]("endOffset"), 9, \
                        js_get_prop(init, cast[Ptr[uint8]]("endOffset"), 9))
        return sr
    if rel == NID_CREATETW or rel == NID_CREATENI:
        tv: int32 = js_new_object_v()
        rootv: int32 = js_null()
        if js_arg_count() >= 1:
            rootv = js_arg(0)
        showv: int32 = -1
        if js_arg_count() >= 2:
            showv = cast[int32](js_to_number(js_arg(1)))
        filtv: int32 = js_null()
        if js_arg_count() >= 3:
            filtv = js_arg(2)
        js_set_prop(tv, cast[Ptr[uint8]]("root"), 4, rootv)
        js_set_prop(tv, cast[Ptr[uint8]]("whatToShow"), 10, \
                    js_number(cast[float64](showv)))
        js_set_prop(tv, cast[Ptr[uint8]]("filter"), 6, filtv)
        if rel == NID_CREATETW:
            js_set_prop(tv, cast[Ptr[uint8]]("currentNode"), 11, rootv)
            if g_proto_tw != 0:
                js_set_proto_v(tv, g_proto_tw)
        else:
            js_set_prop(tv, cast[Ptr[uint8]]("referenceNode"), 13, rootv)
            js_set_prop(tv, cast[Ptr[uint8]]("pointerBeforeReferenceNode"), 26, \
                        js_bool(1))
            if g_proto_ni != 0:
                js_set_proto_v(tv, g_proto_ni)
        return tv
    # ---- Range instance methods ----
    if rel >= NID_RNG_SETSTART and rel <= NID_RNG_CAC:
        return _rng_method(rel, thisv)
    # ---- TreeWalker ----
    if rel == NID_TW_PARENT:
        cur: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("currentNode"), 11)
        n: int32 = _nd_parent(cur)
        d: int32 = 0
        while d < 256 and js_type_of(n) == TAG_OBJ:
            if _tv_filter(thisv, n) == 1:
                js_set_own(thisv, cast[Ptr[uint8]]("currentNode"), 11, n)
                return n
            if n == _tv_root(thisv):
                return js_null()
            n = _nd_parent(n)
            d = d + 1
        return js_null()
    if rel == NID_TW_FIRSTCHILD:
        return _tw_traverse_children(thisv, 1)
    if rel == NID_TW_LASTCHILD:
        return _tw_traverse_children(thisv, 0)
    if rel == NID_TW_NEXTSIB:
        return _tw_traverse_siblings(thisv, 1)
    if rel == NID_TW_PREVSIB:
        return _tw_traverse_siblings(thisv, -1)
    if rel == NID_TW_NEXTNODE:
        cur2: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("currentNode"), 11)
        s2: int32 = 0
        while s2 < 4096 and js_type_of(cur2) == TAG_OBJ:
            s2 = s2 + 1
            nx: int32 = _tv_next_within(cur2, _tv_root(thisv))
            if js_type_of(nx) != TAG_OBJ:
                return js_null()
            cur2 = nx
            if _tv_filter(thisv, cur2) == 1:
                js_set_own(thisv, cast[Ptr[uint8]]("currentNode"), 11, cur2)
                return cur2
        return js_null()
    if rel == NID_TW_PREVNODE:
        cur3: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("currentNode"), 11)
        s3: int32 = 0
        while s3 < 4096 and js_type_of(cur3) == TAG_OBJ:
            s3 = s3 + 1
            pv: int32 = _tv_prev_within(cur3, _tv_root(thisv))
            if js_type_of(pv) != TAG_OBJ:
                return js_null()
            cur3 = pv
            if _tv_filter(thisv, cur3) == 1:
                js_set_own(thisv, cast[Ptr[uint8]]("currentNode"), 11, cur3)
                return cur3
        return js_null()
    if rel == NID_NI_DETACH:
        return js_undefined()
    # ---- NodeIterator next/previous ----
    fwd: int32 = 0
    if rel == NID_NI_NEXTNODE:
        fwd = 1
    ref: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("referenceNode"), 13)
    before: int32 = js_to_bool(js_get_prop(thisv, \
                    cast[Ptr[uint8]]("pointerBeforeReferenceNode"), 26))
    s4: int32 = 0
    while s4 < 8192 and js_type_of(ref) == TAG_OBJ:
        s4 = s4 + 1
        if fwd != 0:
            if before != 0:
                before = 0
            else:
                ref = _tv_next_within(ref, _tv_root(thisv))
                if js_type_of(ref) != TAG_OBJ:
                    return js_null()
        else:
            if before == 0:
                before = 1
            else:
                ref = _tv_prev_within(ref, _tv_root(thisv))
                if js_type_of(ref) != TAG_OBJ:
                    return js_null()
        if _tv_filter(thisv, ref) == 1:
            js_set_own(thisv, cast[Ptr[uint8]]("referenceNode"), 13, ref)
            js_set_own(thisv, cast[Ptr[uint8]]("pointerBeforeReferenceNode"), 26, \
                       js_bool(before))
            return ref
    return js_null()


# Pre-order successor of `n` that stays inside `root`.
def _tv_next_within(n: int32, root: int32) -> int32:
    c: int32 = _tv_first_child(n)
    if js_type_of(c) == TAG_OBJ:
        return c
    cur: int32 = n
    d: int32 = 0
    while d < 256 and js_type_of(cur) == TAG_OBJ:
        if cur == root:
            return js_null()
        sib: int32 = _tv_sibling(cur, 1)
        if js_type_of(sib) == TAG_OBJ:
            return sib
        cur = _nd_parent(cur)
        d = d + 1
    return js_null()


# Pre-order predecessor of `n` that stays inside `root`.
def _tv_prev_within(n: int32, root: int32) -> int32:
    if n == root:
        return js_null()
    sib: int32 = _tv_sibling(n, -1)
    if js_type_of(sib) != TAG_OBJ:
        p: int32 = _nd_parent(n)
        if js_type_of(p) != TAG_OBJ:
            return js_null()
        return p
    d: int32 = 0
    while d < 256:
        last: int32 = _tv_last_child(sib)
        if js_type_of(last) != TAG_OBJ:
            return sib
        sib = last
        d = d + 1
    return sib


def _rng_method(rel: int32, r: int32) -> int32:
    a0: int32 = js_null()
    if js_arg_count() >= 1:
        a0 = js_arg(0)
    if rel == NID_RNG_COLLAPSED:
        sc: int32 = _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14)
        ec: int32 = _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12)
        if sc == ec and _rng_off(r, cast[Ptr[uint8]]("startOffset"), 11) == \
           _rng_off(r, cast[Ptr[uint8]]("endOffset"), 9):
            return js_bool(1)
        return js_bool(0)
    if rel == NID_RNG_RO_SET:
        return js_undefined()
    if rel == NID_RNG_CAC:
        sc2: int32 = _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14)
        ec2: int32 = _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12)
        cur: int32 = sc2
        d: int32 = 0
        while d < 256 and js_type_of(cur) == TAG_OBJ:
            if _nd_is_ancestor(cur, ec2) != 0:
                return cur
            cur = _nd_parent(cur)
            d = d + 1
        return sc2
    if rel == NID_RNG_DETACH:
        return js_undefined()
    if rel == NID_RNG_TOSTRING:
        return _rng_stringify(r)
    if rel == NID_RNG_CLONERANGE:
        c2: int32 = _rng_new()
        js_set_own(c2, cast[Ptr[uint8]]("startContainer"), 14, \
                   _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14))
        js_set_own(c2, cast[Ptr[uint8]]("startOffset"), 11, \
                   _rng_get(r, cast[Ptr[uint8]]("startOffset"), 11))
        js_set_own(c2, cast[Ptr[uint8]]("endContainer"), 12, \
                   _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12))
        js_set_own(c2, cast[Ptr[uint8]]("endOffset"), 9, \
                   _rng_get(r, cast[Ptr[uint8]]("endOffset"), 9))
        return c2
    if rel == NID_RNG_COLLAPSE:
        tostart: int32 = 0
        if js_arg_count() >= 1 and js_to_bool(a0) != 0:
            tostart = 1
        if tostart != 0:
            js_set_own(r, cast[Ptr[uint8]]("endContainer"), 12, \
                       _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14))
            js_set_own(r, cast[Ptr[uint8]]("endOffset"), 9, \
                       _rng_get(r, cast[Ptr[uint8]]("startOffset"), 11))
        else:
            js_set_own(r, cast[Ptr[uint8]]("startContainer"), 14, \
                       _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12))
            js_set_own(r, cast[Ptr[uint8]]("startOffset"), 11, \
                       _rng_get(r, cast[Ptr[uint8]]("endOffset"), 9))
        return js_undefined()
    if js_type_of(a0) != TAG_OBJ:
        return js_undefined()
    if rel == NID_RNG_SETSTART or rel == NID_RNG_SETEND:
        off: int32 = 0
        if js_arg_count() >= 2:
            off = cast[int32](js_to_number(js_arg(1)))
        if off < 0 or off > _rng_node_len(a0):
            return _throw_domexc(cast[Ptr[uint8]]("IndexSizeError"), 14, \
                                 cast[Ptr[uint8]]("offset is out of bounds"), 23)
        if rel == NID_RNG_SETSTART:
            _rng_set_start(r, a0, off)
        else:
            _rng_set_end(r, a0, off)
        return js_undefined()
    if rel == NID_RNG_SELNODECONT:
        _rng_set_start(r, a0, 0)
        _rng_set_end(r, a0, _rng_node_len(a0))
        return js_undefined()
    par: int32 = _nd_parent(a0)
    if js_type_of(par) != TAG_OBJ:
        if rel == NID_RNG_INTERSECTS or rel == NID_RNG_ISPOINTIN:
            return js_bool(0)
        if rel == NID_RNG_COMPAREPOINT:
            return js_number(0.0)
        if rel == NID_RNG_SELNODE or rel == NID_RNG_SETSTARTBEF or \
           rel == NID_RNG_SETSTARTAFT or rel == NID_RNG_SETENDBEF or \
           rel == NID_RNG_SETENDAFT:
            return _throw_domexc(cast[Ptr[uint8]]("InvalidNodeTypeError"), 20, \
                                 cast[Ptr[uint8]]("node has no parent"), 18)
    ix: int32 = _nd_child_index(par, a0)
    if rel == NID_RNG_SELNODE:
        _rng_set_start(r, par, ix)
        _rng_set_end(r, par, ix + 1)
        return js_undefined()
    if rel == NID_RNG_SETSTARTBEF:
        _rng_set_start(r, par, ix)
        return js_undefined()
    if rel == NID_RNG_SETSTARTAFT:
        _rng_set_start(r, par, ix + 1)
        return js_undefined()
    if rel == NID_RNG_SETENDBEF:
        _rng_set_end(r, par, ix)
        return js_undefined()
    if rel == NID_RNG_SETENDAFT:
        _rng_set_end(r, par, ix + 1)
        return js_undefined()
    sc3: int32 = _rng_get(r, cast[Ptr[uint8]]("startContainer"), 14)
    so3: int32 = _rng_off(r, cast[Ptr[uint8]]("startOffset"), 11)
    ec3: int32 = _rng_get(r, cast[Ptr[uint8]]("endContainer"), 12)
    eo3: int32 = _rng_off(r, cast[Ptr[uint8]]("endOffset"), 9)
    if rel == NID_RNG_INTERSECTS:
        if _rng_cmp_bp(par, ix, ec3, eo3) < 0 and \
           _rng_cmp_bp(par, ix + 1, sc3, so3) > 0:
            return js_bool(1)
        return js_bool(0)
    if rel == NID_RNG_COMPAREPOINT or rel == NID_RNG_ISPOINTIN:
        poff: int32 = 0
        if js_arg_count() >= 2:
            poff = cast[int32](js_to_number(js_arg(1)))
        cs: int32 = _rng_cmp_bp(a0, poff, sc3, so3)
        ce: int32 = _rng_cmp_bp(a0, poff, ec3, eo3)
        if rel == NID_RNG_ISPOINTIN:
            if cs >= 0 and ce <= 0:
                return js_bool(1)
            return js_bool(0)
        if cs < 0:
            return js_number(-1.0)
        if ce > 0:
            return js_number(1.0)
        return js_number(0.0)
    if rel == NID_RNG_COMPAREBP:
        how: int32 = 0
        if js_arg_count() >= 1:
            how = cast[int32](js_to_number(js_arg(0)))
        other: int32 = js_null()
        if js_arg_count() >= 2:
            other = js_arg(1)
        if js_type_of(other) != TAG_OBJ:
            return js_number(0.0)
        na: int32 = sc3
        oa: int32 = so3
        nb: int32 = _rng_get(other, cast[Ptr[uint8]]("startContainer"), 14)
        ob: int32 = _rng_off(other, cast[Ptr[uint8]]("startOffset"), 11)
        if how == 1 or how == 3:                           # START_TO_END/END_TO_END
            na = ec3
            oa = eo3
        if how == 1 or how == 2:                           # START_TO_END/END_TO_START
            nb = _rng_get(other, cast[Ptr[uint8]]("endContainer"), 12)
            ob = _rng_off(other, cast[Ptr[uint8]]("endOffset"), 9)
        return js_number(cast[float64](_rng_cmp_bp(na, oa, nb, ob)))
    if rel == NID_RNG_INSERTNODE:
        _insert_before_v(sc3, a0, _rng_child_at(sc3, so3))
        return js_undefined()
    # NID_RNG_DELETECONT
    if sc3 == ec3 and _nd_type(sc3) == 3:
        _cd_splice(sc3, so3, eo3 - so3, js_new_string(cast[Ptr[uint8]](""), 0))
        return js_undefined()
    return js_undefined()


def _rng_child_at(n: int32, i: int32) -> int32:
    ks: int32 = _nd_kids(n)
    if ks == 0 or i < 0 or i >= js_array_len(ks):
        return js_null()
    return js_array_get(ks, i)


def _child_parent_dispatch(rel: int32) -> int32:
    thisv: int32 = js_this()
    if rel == NID_PN_PREPEND or rel == NID_PN_REPLKIDS:
        if rel == NID_PN_REPLKIDS:
            # replaceChildren: drop every existing child first, then append.
            ks: int32 = _nd_kids(thisv)
            if ks != 0:
                snap: int32 = js_new_array_v()
                i2: int32 = 0
                kn: int32 = js_array_len(ks)
                while i2 < kn:
                    js_array_push(snap, js_array_get(ks, i2))
                    i2 = i2 + 1
                i2 = 0
                while i2 < kn:
                    _remove_child_v(thisv, js_array_get(snap, i2))
                    i2 = i2 + 1
            _nd_insert_nodes(thisv, js_null(), 0)
            return js_undefined()
        first: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("firstChild"), 10)
        if js_type_of(first) != TAG_OBJ:
            first = js_null()
        _nd_insert_nodes(thisv, first, 0)
        return js_undefined()
    # ChildNode: all three need a parent; with none they are a spec no-op.
    par: int32 = _nd_parent(thisv)
    if js_type_of(par) != TAG_OBJ:
        return js_undefined()
    # The "viable sibling" step. before/after/replaceWith do NOT insert next to
    # `this`: they insert next to the first sibling that is NOT itself one of
    # the arguments, computed BEFORE the arguments are unlinked. Skipping it
    # reversed the result whenever a page passed existing siblings back in
    # (`child.after(x, y)` where x is already child.nextSibling produced
    # "<y><z><x>" instead of leaving the tree alone).
    kids: int32 = _nd_kids(par)
    idx: int32 = _nd_child_index(par, thisv)
    vs: int32 = js_null()
    if kids != 0 and idx >= 0:
        kn2: int32 = js_array_len(kids)
        if rel == NID_CN_AFTER:
            k2: int32 = idx + 1
            while k2 < kn2:
                if _nd_arg_is(js_array_get(kids, k2)) == 0:
                    vs = js_array_get(kids, k2)
                    k2 = kn2
                else:
                    k2 = k2 + 1
        else:
            k3: int32 = idx - 1
            while k3 >= 0:
                if _nd_arg_is(js_array_get(kids, k3)) == 0:
                    vs = js_array_get(kids, k3)
                    k3 = -1
                else:
                    k3 = k3 - 1
    # Unlink every node argument now (the spec turns them into one fragment,
    # which removes them), so the reference below is resolved against the tree
    # as it will actually be at insertion time.
    ai: int32 = 0
    an2: int32 = js_arg_count()
    while ai < an2:
        if js_type_of(js_arg(ai)) == TAG_OBJ and _nd_type(js_arg(ai)) != 0:
            _detach_from_parent_v(js_arg(ai))
        ai = ai + 1
    if rel == NID_CN_REPLWITH:
        _remove_child_v(par, thisv)
    ref: int32 = js_null()
    if rel == NID_CN_AFTER:
        ref = vs
    elif js_type_of(vs) != TAG_OBJ:
        # no viable previous sibling: insert at the front
        kids2: int32 = _nd_kids(par)
        if kids2 != 0 and js_array_len(kids2) > 0:
            ref = js_array_get(kids2, 0)
    else:
        kids3: int32 = _nd_kids(par)
        vi: int32 = _nd_child_index(par, vs)
        if kids3 != 0 and vi >= 0 and vi + 1 < js_array_len(kids3):
            ref = js_array_get(kids3, vi + 1)
    _nd_insert_nodes(par, ref, 0)
    return js_undefined()


def _node_generic_dispatch(rel: int32) -> int32:
    thisv: int32 = js_this()
    if rel == NID_HASKIDS:
        ks: int32 = _nd_kids(thisv)
        if ks == 0:
            return js_bool(0)
        if js_array_len(ks) > 0:
            return js_bool(1)
        return js_bool(0)
    if rel == NID_ISSAME:
        if js_arg_count() < 1:
            return js_bool(0)
        if thisv == js_arg(0):
            return js_bool(1)
        return js_bool(0)
    if rel == NID_GETROOTNODE:
        return _nd_root(thisv)
    if rel == NID_NORMALIZE:
        _nd_normalize(thisv, 0)
        return js_undefined()
    if rel == NID_ISEQUAL:
        if js_arg_count() < 1:
            return js_bool(0)
        return js_bool(_nd_is_equal(thisv, js_arg(0), 0))
    if rel == NID_CMPDOCPOS:
        if js_arg_count() < 1:
            return js_number(0.0)
        return js_number(cast[float64](_nd_compare_pos(thisv, js_arg(0))))
    if rel == NID_LOOKUPNSURI:
        isn: int32 = _nd_read_arg0()
        return _nd_lookup_ns(thisv, isn, 0)
    if rel == NID_LOOKUPPREFIX:
        if _nd_read_arg0() != 0:
            return js_null()
        return _nd_lookup_prefix(thisv, 0)
    # NID_ISDEFAULTNS: isDefaultNamespace(ns) is lookupNamespaceURI(null) == ns,
    # with "" folded to null on both sides.
    wantnull: int32 = _nd_read_arg0()
    got: int32 = _nd_lookup_ns(thisv, 1, 0)
    if wantnull != 0:
        if _nd_str_empty(got) != 0:
            return js_bool(1)
        return js_bool(0)
    if _nd_str_eq(got, &ndg_pfx[0], ndg_pfxn) != 0:
        return js_bool(1)
    return js_bool(0)


def _js_host_dispatch(id: int32) -> int32:
    rel: int32 = id - js_hbase
    if rel >= NID_HASKIDS and rel <= NID_ISDEFAULTNS:
        return _node_generic_dispatch(rel)
    if (rel >= NID_CN_BEFORE and rel <= NID_PN_PREPEND) or rel == NID_PN_REPLKIDS:
        if _mutation_touches_source() != 0:
            g_dom_mutated = 1
            g_dom_gen = g_dom_gen + 1
        return _child_parent_dispatch(rel)
    if _nid_mutates(rel) != 0 and _mutation_touches_source() != 0:
        g_dom_mutated = 1
        g_dom_gen = g_dom_gen + 1
    if rel >= NID_MO_CTOR and rel <= NID_OBS_DELIVER:
        return _obs_dispatch(rel)
    if rel >= NID_CREATERANGE and rel <= NID_NI_DETACH:
        return _rng_dispatch(rel)
    if rel >= NID_CD_DATA_GET and rel <= NID_TEXT_SPLIT:
        return _chardata_dispatch(rel)
    if rel == NID_TEXT_CTOR or rel == NID_COMMENT_CTOR:
        cdv: int32 = js_new_string(cast[Ptr[uint8]](""), 0)
        if js_arg_count() >= 1:
            cdv = _cd_arg_str(0)
        if rel == NID_TEXT_CTOR:
            return _cre_make_text(cdv)
        return _cre_make_chardata(cdv, 2, js_undefined())
    if rel == NID_CREATEPI:
        return _mount_dispatch(rel)
    if rel >= NID_CREATECOMMENT and rel <= NID_NODE_CTOR and rel != NID_CREATE_NS:
        return _mount_dispatch(rel)
    if rel == NID_COOKIE_GET:
        return _cookie_read()
    if rel == NID_COOKIE_SET:
        return _cookie_write()
    if rel >= NID_TC_GET and rel <= NID_IH_SET:
        return _inner_accessor(rel)
    if rel >= NID_STYLE_ACC and rel <= NID_DS_ACC_SET:
        return _lazy_el_accessor(rel)
    if rel >= NID_KIDS_ACC and rel <= NID_NODES_ACC_SET:
        return _lazy_el_accessor(rel)
    if rel >= NID_FCH_ACC and rel <= NID_NSIB_ACC_SET:
        return _lazy_el_accessor(rel)
    if rel >= NID_F_GETCTX and rel <= NID_F_SUBMIT_S:
        return _feat_accessor(rel)
    if rel >= NID_IMPL_HASFEAT and rel <= NID_IMPL_CREDOCT:
        return _impl_dispatch(rel)
    if rel >= NID_SETATTRNS and rel <= NID_GETBYTAGNS:
        return _ns_dispatch(rel)
    if rel >= NID_ATTRS_ACC and rel <= NID_PREFIX_SET:
        return _nsattr_accessor(rel)
    if rel == NID_NNM_GETNAMED:
        gnn: int32 = 0
        if js_arg_count() >= 1:
            gnn = _js_str_to_cbuf(js_arg(0), &nnm_name[0], 80)
        gnm: int32 = js_this()
        gni: int32 = 0
        while gni < js_array_len(gnm):
            gav: int32 = js_array_get(gnm, gni)
            gnv: int32 = js_get_prop(gav, cast[Ptr[uint8]]("name"), 4)
            if _bytes_eq(js_str_bytes(gnv), js_str_bytelen(gnv), \
                         &nnm_name[0], gnn) != 0:
                return gav
            gni = gni + 1
        return js_null()
    if rel == NID_NNM_ITEM:
        inm: int32 = js_this()
        ii: int32 = 0
        if js_arg_count() >= 1:
            ii = cast[int32](js_to_number(js_arg(0)))
        if ii < 0 or ii >= js_array_len(inm):
            return js_null()
        return js_array_get(inm, ii)
    if rel == NID_MATCHMEDIA:
        return _match_media()
    if rel == NID_MQL_NOOP:
        return js_bool(0)                    # dispatchEvent -> false; add/remove -> falsy
    if rel == NID_CSSSHEET_CTOR:
        # new CSSStyleSheet([{...}]) — a constructible sheet, inactive until it
        # is placed in document.adoptedStyleSheets. The options arg is ignored.
        nsid: int32 = _cssom_new_sheet(0, 0)
        if nsid < 0:
            return js_new_object_v()
        return _new_sheet_obj(nsid)
    if rel == NID_SS_INSERTRULE:
        ssv: int32 = js_this()
        isid: int32 = _sheet_id_of(ssv)
        if isid < 0 or js_arg_count() < 1:
            return js_number(cast[float64](0))
        irn: int32 = _arg_bytes(0, &cssom_argbuf[0], 65536)
        icr: int32 = js_get_prop(ssv, cast[Ptr[uint8]]("cssRules"), 8)
        iclen: int32 = js_array_len(icr)
        iidx: int32 = iclen
        if js_arg_count() >= 2:
            iidx = cast[int32](js_to_number(js_arg(1)))
        if iidx < 0:
            iidx = 0
        if iidx > iclen:
            iidx = iclen
        impos: int32 = iidx - cssom_sheet_srccount[isid]
        if impos < 0:
            impos = 0
        _cssom_insert_rule(isid, impos, &cssom_argbuf[0], irn)
        # keep cssRules length honest (append the rule object; exact mid-array
        # position is not modeled — the cascade reads the model, not this array)
        js_array_push(icr, _cssom_ruleobj(&cssom_argbuf[0], irn))
        return js_number(cast[float64](iidx))
    if rel == NID_SS_DELETERULE:
        dsv: int32 = js_this()
        dsid: int32 = _sheet_id_of(dsv)
        if dsid < 0 or js_arg_count() < 1:
            return js_undefined()
        didx: int32 = cast[int32](js_to_number(js_arg(0)))
        dsrc: int32 = cssom_sheet_srccount[dsid]
        if didx >= dsrc:
            _cssom_delete_rule(dsid, didx - dsrc)
        dcr: int32 = js_get_prop(dsv, cast[Ptr[uint8]]("cssRules"), 8)
        ncr: int32 = _cssrules_without(dcr, didx)
        js_set_prop(dsv, cast[Ptr[uint8]]("cssRules"), 8, ncr)
        js_set_prop(dsv, cast[Ptr[uint8]]("rules"), 5, ncr)
        return js_undefined()
    if rel == NID_SS_REPLACESYNC or rel == NID_SS_REPLACE:
        rsv: int32 = js_this()
        rsid: int32 = _sheet_id_of(rsv)
        if rsid < 0:
            if rel == NID_SS_REPLACE:
                return promise_resolve_static(rsv)
            return js_undefined()
        rrn: int32 = 0
        if js_arg_count() >= 1:
            rrn = _arg_bytes(0, &cssom_argbuf[0], 65536)
        _cssom_clear_sheet(rsid)                       # replace() discards prior rules
        newcr: int32 = js_new_array_v()
        _sheet_split_load(rsid, newcr, 1, &cssom_argbuf[0], rrn)
        js_set_prop(rsv, cast[Ptr[uint8]]("cssRules"), 8, newcr)
        js_set_prop(rsv, cast[Ptr[uint8]]("rules"), 5, newcr)
        if rel == NID_SS_REPLACE:
            return promise_resolve_static(rsv)        # Promise<CSSStyleSheet>
        return js_undefined()
    if rel == NID_FONTS_LOAD:
        # CSS Font Loading: headless has every font synchronously available, so
        # load() resolves immediately with an (empty) FontFace list.
        return promise_resolve_static(js_new_array_v())
    if rel == NID_FONTS_CHECK:
        return js_bool(1)                     # the requested font is "available"
    if rel == NID_FONTS_NOOP:
        return js_undefined()                 # add/delete/clear/forEach
    if rel == NID_HIST_PUSH:
        return _hist_push(0)
    if rel == NID_HIST_REPLACE:
        return _hist_push(1)
    if rel == NID_HIST_BACK:
        if jshist_idx > 0:
            jshist_idx = jshist_idx - 1
            _hist_restore_url(jshist_idx)
            _hist_sync()
            _fire_win_event(cast[Ptr[uint8]]("popstate"), 8, \
                            cast[Ptr[uint8]]("onpopstate"), 10, jshist_state[jshist_idx], 1)
        return js_undefined()
    if rel == NID_HIST_FORWARD:
        if jshist_idx < jshist_len - 1:
            jshist_idx = jshist_idx + 1
            _hist_restore_url(jshist_idx)
            _hist_sync()
            _fire_win_event(cast[Ptr[uint8]]("popstate"), 8, \
                            cast[Ptr[uint8]]("onpopstate"), 10, jshist_state[jshist_idx], 1)
        return js_undefined()
    if rel == NID_HIST_GO:
        delta: int32 = 0
        if js_arg_count() >= 1:
            delta = cast[int32](js_to_number(js_arg(0)))
        ni: int32 = jshist_idx + delta
        if ni < 0:
            ni = 0
        if ni >= jshist_len:
            ni = jshist_len - 1
        if ni != jshist_idx:
            jshist_idx = ni
            _hist_restore_url(jshist_idx)
