        # ctx.drawImage(img, dx, dy[, dw, dh]). Resolve the source to a decoded
        # lib/htmlimg slot: a <canvas> element (its backing buffer is a slot), an
        # <img> element (its src= attribute -> decoded slot), or an Image()/any
        # object carrying a resolvable .src string. Then blit scaled to the dest
        # rect (natural size when dw/dh omitted), src-over honouring globalAlpha.
        dici: int32 = _canvas_ci_of_ctx(js_this())
        if dici >= 0 and js_arg_count() >= 3:
            disrc: int32 = js_arg(0)
            dislot: int32 = -1
            disw: int32 = 0
            dish: int32 = 0
            disel: int32 = _find_el_by_obj(disrc)
            if disel >= 0 and _dom_tag_is(disel, cast[Ptr[uint8]]("canvas")) != 0:
                disreg: int32 = _canvas_get_for_el(disel)
                if disreg >= 0:
                    dislot = canv_slot[disreg]
                    disw = canv_w[disreg]
                    dish = canv_h[disreg]
            elif disel >= 0 and _dom_tag_is(disel, cast[Ptr[uint8]]("img")) != 0:
                dite: uint64 = cast[uint64](dom_ns[disel])
                dite = _hx_tag_end_p(src_ptr, src_len, dite)
                if _hx_find_attr(cast[uint64](dom_ns[disel]), dite,
                                 cast[Ptr[uint8]]("src")) != 0 and \
                   g_attr_end > g_attr_start:
                    dislot = htmlimg_find(&src_ptr[g_attr_start],
                                          g_attr_end - g_attr_start)
            if dislot < 0:
                disv: int32 = js_get_prop(disrc, cast[Ptr[uint8]]("src"), 3)
                disp: Ptr[uint8] = js_str_ptr(disv)
                disn: int32 = _cstr_len(disp)
                if disn > 0 and _is_undef_str(disp, disn) == 0:
                    dislot = htmlimg_find(disp, cast[uint64](disn))
            if dislot >= 0:
                if disw <= 0:
                    disw = htmlimg_w(dislot)
                if dish <= 0:
                    dish = htmlimg_h(dislot)
                didx: int32 = _cvn(1)
                didy: int32 = _cvn(2)
                didw: int32 = disw
                didh: int32 = dish
                if js_arg_count() >= 5:
                    didw = _cvn(3)
                    didh = _cvn(4)
                htmlcanvas_draw_image(dici, dislot, disw, dish, didx, didy,
                                      didw, didh, _canvas_alpha(js_this()))
