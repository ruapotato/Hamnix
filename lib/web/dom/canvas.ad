        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("ol"), 2) != 0:
            return 35
    elif c0 == 112:                                # 'p'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("progress"), 8) != 0:
