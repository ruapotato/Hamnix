            _canvas_read_font(js_this())
            mw: int32 = htmlcanvas_measure_text(g_cv_px, g_cv_bold,
                                                &cv_txt[0], mn)
            mo: int32 = js_new_object_v()
            js_set_prop(mo, cast[Ptr[uint8]]("width"), 5,
                        js_number(cast[float64](mw)))
            return mo
        return js_null()
    if rel == NID_CV_SAVE:
        svci: int32 = _canvas_ci_of_ctx(js_this())
        if svci >= 0:
            htmlcanvas_save(svci)
            d: int32 = cv_sstk_n[svci]
            if d < CV_SSTK_MAX:
                o: int32 = svci * CV_SSTK_MAX + d
                cv_sstk_fill[o] = js_get_prop(js_this(),
                                              cast[Ptr[uint8]]("fillStyle"), 9)
                cv_sstk_strk[o] = js_get_prop(js_this(),
                                              cast[Ptr[uint8]]("strokeStyle"), 11)
                cv_sstk_lw[o] = js_get_prop(js_this(),
                                            cast[Ptr[uint8]]("lineWidth"), 9)
                cv_sstk_font[o] = js_get_prop(js_this(),
                                              cast[Ptr[uint8]]("font"), 4)
                cv_sstk_alpha[o] = js_get_prop(js_this(),
                                               cast[Ptr[uint8]]("globalAlpha"), 11)
                cv_sstk_n[svci] = d + 1
        return js_undefined()
    if rel == NID_CV_RESTORE:
        rsci: int32 = _canvas_ci_of_ctx(js_this())
        if rsci >= 0:
            htmlcanvas_restore(rsci)
            d2: int32 = cv_sstk_n[rsci]
            if d2 > 0:
                d2 = d2 - 1
                o2: int32 = rsci * CV_SSTK_MAX + d2
                js_set_prop(js_this(), cast[Ptr[uint8]]("fillStyle"), 9,
                            cv_sstk_fill[o2])
                js_set_prop(js_this(), cast[Ptr[uint8]]("strokeStyle"), 11,
                            cv_sstk_strk[o2])
                js_set_prop(js_this(), cast[Ptr[uint8]]("lineWidth"), 9,
                            cv_sstk_lw[o2])
                js_set_prop(js_this(), cast[Ptr[uint8]]("font"), 4,
                            cv_sstk_font[o2])
                js_set_prop(js_this(), cast[Ptr[uint8]]("globalAlpha"), 11,
                            cv_sstk_alpha[o2])
                cv_sstk_n[rsci] = d2
        return js_undefined()
    if rel == NID_CV_TRANSLATE:
        tlci: int32 = _canvas_ci_of_ctx(js_this())
        if tlci >= 0 and js_arg_count() >= 2:
            htmlcanvas_translate(tlci, _cvf(0), _cvf(1))
        return js_undefined()
    if rel == NID_CV_SCALE:
        scci: int32 = _canvas_ci_of_ctx(js_this())
        if scci >= 0 and js_arg_count() >= 2:
            htmlcanvas_scale(scci, _cvf(0), _cvf(1))
        return js_undefined()
    if rel == NID_CV_ROTATE:
        rtci: int32 = _canvas_ci_of_ctx(js_this())
        if rtci >= 0 and js_arg_count() >= 1:
            htmlcanvas_rotate(rtci, _cvf(0))
        return js_undefined()
    if rel == NID_CV_TRANSFORM:
        tfci: int32 = _canvas_ci_of_ctx(js_this())
        if tfci >= 0 and js_arg_count() >= 6:
            htmlcanvas_transform(tfci, _cvf(0), _cvf(1), _cvf(2), _cvf(3),
                                 _cvf(4), _cvf(5))
        return js_undefined()
    if rel == NID_CV_SETTRANSFORM:
        smci: int32 = _canvas_ci_of_ctx(js_this())
        if smci >= 0 and js_arg_count() >= 6:
            htmlcanvas_set_transform(smci, _cvf(0), _cvf(1), _cvf(2), _cvf(3),
                                     _cvf(4), _cvf(5))
        return js_undefined()
    if rel == NID_CV_RESETTRANSFORM:
        rmci: int32 = _canvas_ci_of_ctx(js_this())
        if rmci >= 0:
            htmlcanvas_reset_transform(rmci)
        return js_undefined()
    if rel == NID_CV_LINGRAD or rel == NID_CV_RADGRAD:
        ggci: int32 = _canvas_ci_of_ctx(js_this())
        if ggci < 0:
            return js_null()
        gnew: int32 = -1
        if rel == NID_CV_LINGRAD:
            if js_arg_count() < 4:
                return js_null()
            gnew = htmlcanvas_grad_new(0, _cvf(0), _cvf(1), cast[float64](0),
                                       _cvf(2), _cvf(3), cast[float64](0))
        else:
            if js_arg_count() < 6:
                return js_null()
            gnew = htmlcanvas_grad_new(1, _cvf(0), _cvf(1), _cvf(2),
                                       _cvf(3), _cvf(4), _cvf(5))
        if gnew < 0:
            return js_null()
        go: int32 = js_new_object_v()
        js_set_prop(go, cast[Ptr[uint8]]("__cvgrad"), 8,
                    js_number(cast[float64](gnew)))
        js_set_prop(go, cast[Ptr[uint8]]("addColorStop"), 12,
                    js_new_native_fn(js_hbase + NID_CV_ADDSTOP))
        return go
    if rel == NID_CV_ADDSTOP:
        gsv: int32 = js_get_prop(js_this(), cast[Ptr[uint8]]("__cvgrad"), 8)
        if js_type_of(gsv) == 3 and js_arg_count() >= 2:
            gsi: int32 = cast[int32](js_to_number(gsv))
            cbytes: int32 = _arg_bytes(1, &cv_txt[0], 512)
            grgb: int32 = _canvas_color(&cv_txt[0], cbytes)
            htmlcanvas_grad_addstop(gsi, _cvf(0), grgb)
        return js_undefined()
    if rel == NID_CV_GETIMGDATA:
        gici: int32 = _canvas_ci_of_ctx(js_this())
        if gici < 0 or js_arg_count() < 4:
            return js_null()
        gix: int32 = _cvn(0)
        giy: int32 = _cvn(1)
        giw: int32 = _cvn(2)
        gih: int32 = _cvn(3)
        if giw < 0:
            giw = 0
        if gih < 0:
            gih = 0
        gidat: int32 = js_new_array_v()
        gyy: int32 = 0
        while gyy < gih:
            gxx: int32 = 0
            while gxx < giw:
                gpk: int32 = htmlcanvas_read_rgba(gici, gix + gxx, giy + gyy)
                js_array_push(gidat, js_number(cast[float64]((gpk >> 24) & 255)))
                js_array_push(gidat, js_number(cast[float64]((gpk >> 16) & 255)))
                js_array_push(gidat, js_number(cast[float64]((gpk >> 8) & 255)))
                js_array_push(gidat, js_number(cast[float64](gpk & 255)))
                gxx = gxx + 1
            gyy = gyy + 1
        gido: int32 = js_new_object_v()
        js_set_prop(gido, cast[Ptr[uint8]]("width"), 5,
                    js_number(cast[float64](giw)))
        js_set_prop(gido, cast[Ptr[uint8]]("height"), 6,
                    js_number(cast[float64](gih)))
        js_set_prop(gido, cast[Ptr[uint8]]("data"), 4, gidat)
        return gido
    if rel == NID_CV_CREATEIMGDATA:
        cici: int32 = _canvas_ci_of_ctx(js_this())
        if cici < 0 or js_arg_count() < 1:
            return js_null()
        ciw: int32 = 0
        cih: int32 = 0
        if js_arg_count() >= 2:
            ciw = _cvn(0)
            cih = _cvn(1)
        else:
            a0: int32 = js_arg(0)
            ciw = cast[int32](js_to_number(js_get_prop(a0,
                              cast[Ptr[uint8]]("width"), 5)))
            cih = cast[int32](js_to_number(js_get_prop(a0,
                              cast[Ptr[uint8]]("height"), 6)))
        if ciw < 0:
            ciw = 0
        if cih < 0:
            cih = 0
        cidat: int32 = js_new_array_v()
        ctot: int32 = ciw * cih * 4
        ck: int32 = 0
        while ck < ctot:
            js_array_push(cidat, js_number(cast[float64](0)))
            ck = ck + 1
        cido: int32 = js_new_object_v()
        js_set_prop(cido, cast[Ptr[uint8]]("width"), 5,
                    js_number(cast[float64](ciw)))
        js_set_prop(cido, cast[Ptr[uint8]]("height"), 6,
                    js_number(cast[float64](cih)))
        js_set_prop(cido, cast[Ptr[uint8]]("data"), 4, cidat)
        return cido
    if rel == NID_CV_PUTIMGDATA:
        pici: int32 = _canvas_ci_of_ctx(js_this())
        if pici >= 0 and js_arg_count() >= 3:
            pidat: int32 = js_arg(0)
            piw: int32 = cast[int32](js_to_number(js_get_prop(pidat,
                             cast[Ptr[uint8]]("width"), 5)))
            pih: int32 = cast[int32](js_to_number(js_get_prop(pidat,
                             cast[Ptr[uint8]]("height"), 6)))
            parr: int32 = js_get_prop(pidat, cast[Ptr[uint8]]("data"), 4)
            pdx: int32 = _cvn(1)
            pdy: int32 = _cvn(2)
            if js_is_array(parr) != 0 and piw > 0 and pih > 0:
                pyy: int32 = 0
                while pyy < pih:
                    pxx: int32 = 0
                    while pxx < piw:
                        pbase: int32 = (pyy * piw + pxx) * 4
                        pr: int32 = cast[int32](js_to_number(
                                    js_array_get(parr, pbase)))
                        pg: int32 = cast[int32](js_to_number(
                                    js_array_get(parr, pbase + 1)))
                        pb: int32 = cast[int32](js_to_number(
                                    js_array_get(parr, pbase + 2)))
                        pa: int32 = cast[int32](js_to_number(
                                    js_array_get(parr, pbase + 3)))
                        htmlcanvas_write_rgba(pici, pdx + pxx, pdy + pyy,
                                              pr, pg, pb, pa)
                        pxx = pxx + 1
                    pyy = pyy + 1
        return js_undefined()
    return js_undefined()


# copy the page <title> text into dom_title_buf; returns its length.
def _scan_title() -> int32:
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           _tagname_is(i + 1, cast[Ptr[uint8]]("title")) != 0:
            j: uint64 = i + 1
            j = _hx_tag_end_p(src_ptr, src_len, j)
            if j < src_len:
                j = j + 1
            n: int32 = 0
            while j < src_len and n < 255:
                if src_ptr[j] == 60:                      # '<' -> </title>
                    break
                if src_ptr[j] == 38:                      # '&' -> decode entity
                    consumed: uint64 = _entity(j)
                    if consumed > 0:
                        k: int32 = 0
                        while k < g_ent_len and n < 255:
                            dom_title_buf[n] = g_ent_buf[k]
                            n = n + 1
                            k = k + 1
                        j = j + consumed
                        continue
                dom_title_buf[n] = src_ptr[j]
                n = n + 1
                j = j + 1
            return n
        i = i + 1
    return 0


# Resolve the FIRST start tag named `name` in the source, register it as a live
# DOM element (dedup via anchor lookup — same object getElementById returns), and
# store it as `doc.prop`. If the page has no such tag the property is left unset
# (source-anchored parser: html/head/body are not synthesized when absent).
# Install one DOM interface object: a global constructor `name` whose
# `.prototype` chains to `parent_proto` (0 = leave it on Object.prototype).
# Returns the prototype value so callers can chain the next interface onto it.
# ====================================================================
# Element.attributes / localName / prefix, DOMImplementation, and the
# namespace-aware attribute API (round 10 — WPT conformance).
#
# `attributes` was the highest-leverage of these and NOT for the reason it
# looks: testharness.js's format_value() prints an element by walking
# `val.attributes.length`, so a missing `attributes` turned 188 real WPT
# failure messages into "cannot read property 'length' of null or undefined"
# and hid what was actually wrong. Measured 2026-07-29 against the vendored
# subset; see docs/browser_wpt_conformance.md.
# ====================================================================
nnm_name: Array[80, uint8]           # NUL-terminated attribute-name scratch
nsq_buf:  Array[128, uint8]          # qualified-name scratch for the *NS methods
nsuri_buf: Array[256, uint8]         # namespace-URI scratch for the *NS methods
gbt_qn:   Array[256, uint8]          # qualified-name scratch for getElementsByTagName
impl_title: Array[1024, uint8]       # createHTMLDocument(title) scratch


# Copy a JS string value into `dst` (capacity `cap`) and NUL-terminate it.
# Returns the byte length written. The attribute helpers below all take
# NUL-terminated names because _hx_find_attr scans a C string.
def _js_str_to_cbuf(v: int32, dst: Ptr[uint8], cap: int32) -> int32:
    p: Ptr[uint8] = js_str_bytes(v)
    n: int32 = js_str_bytelen(v)
    if n > cap - 1:
        n = cap - 1
    i: int32 = 0
    while i < n:
        dst[i] = p[i]
        i = i + 1
    dst[n] = 0
    return n


# One Attr node. Enough of the interface for format_value, for
# `attributes[i].name/.value`, and for getNamedItem round-trips.
def _new_attr_obj(np: Ptr[uint8], nn: int32, valv: int32, ownerv: int32) -> int32:
    a: int32 = js_new_object_v()
    if g_proto_attr != 0:
        js_set_proto_v(a, g_proto_attr)
    nv: int32 = js_new_string(np, cast[uint64](nn))
    # The local name is the part after a ':' in a qualified name; HTML-parsed
    # attributes have no prefix, so name == localName for almost everything.
    lstart: int32 = 0
    ci: int32 = 0
    while ci < nn:
        if np[ci] == 58:                                   # ':'
            lstart = ci + 1
        ci = ci + 1
    lv: int32 = nv
    pv: int32 = js_null()
    if lstart > 0:
        lv = js_new_string(&np[lstart], cast[uint64](nn - lstart))
        pv = js_new_string(np, cast[uint64](lstart - 1))
    js_set_prop(a, cast[Ptr[uint8]]("name"), 4, nv)
    js_set_prop(a, cast[Ptr[uint8]]("nodeName"), 8, nv)
    js_set_prop(a, cast[Ptr[uint8]]("localName"), 9, lv)
    js_set_prop(a, cast[Ptr[uint8]]("prefix"), 6, pv)
    js_set_prop(a, cast[Ptr[uint8]]("value"), 5, valv)
    js_set_prop(a, cast[Ptr[uint8]]("nodeValue"), 9, valv)
    js_set_prop(a, cast[Ptr[uint8]]("textContent"), 11, valv)
    js_set_prop(a, cast[Ptr[uint8]]("nodeType"), 8, js_number(2.0))
    js_set_prop(a, cast[Ptr[uint8]]("namespaceURI"), 12, js_null())
    js_set_prop(a, cast[Ptr[uint8]]("specified"), 9, js_bool(1))
    js_set_prop(a, cast[Ptr[uint8]]("ownerElement"), 12, ownerv)
    return a


# Build the element's NamedNodeMap. It is an ARRAY so `length` and `[i]` are
# the engine's own fast paths (a browser's NamedNodeMap is indexed the same
# way); getNamedItem/item are attached on top.
def _build_attrs_map(thisv: int32) -> int32:
    m: int32 = js_new_array_v()
    el: int32 = _find_el_by_obj(thisv)
    if el >= 0:
        names: int32 = js_new_array_v()
        _collect_attr_names(el, names)
        n: int32 = js_array_len(names)
        i: int32 = 0
        while i < n:
            nl: int32 = _js_str_to_cbuf(js_array_get(names, i), &nnm_name[0], 80)
            vv: int32 = _el_get_attribute(thisv, &nnm_name[0], nl)
            # removeAttribute() after parse leaves the source tag intact; the
            # override store answers null, and a null-valued attribute is GONE.
            if js_type_of(vv) != TAG_NULL:
                js_array_push(m, _new_attr_obj(&nnm_name[0], nl, vv, thisv))
            i = i + 1
        # attributes added at runtime by setAttribute() live only in the
        # override store; append the ones the start tag never declared.
        s: int32 = 0
        while s < sattr_n:
            if sattr_el[s] == el and sattr_vlen[s] >= 0:
                sl: int32 = sattr_nlen[s]
                if sl > 79:
                    sl = 79
                k: int32 = 0
                while k < sl:
                    nnm_name[k] = sattr_buf[sattr_noff[s] + k]
                    k = k + 1
                nnm_name[sl] = 0
                if _hx_find_attr(cast[uint64](dom_ns[el]), \
                                 cast[uint64](dom_cstart[el]) - 1, \
                                 &nnm_name[0]) == 0:
                    js_array_push(m, _new_attr_obj(&nnm_name[0], sl, \
                                  js_new_string(&sattr_buf[sattr_voff[s]], \
                                                cast[uint64](sattr_vlen[s])), \
                                  thisv))
            s = s + 1
    _nsa_collect(thisv, m)
    js_set_prop(m, cast[Ptr[uint8]]("getNamedItem"), 12, \
                js_new_native_fn(js_hbase + NID_NNM_GETNAMED))
    js_set_prop(m, cast[Ptr[uint8]]("item"), 4, \
                js_new_native_fn(js_hbase + NID_NNM_ITEM))
    return m


# el.localName — the lowercase tag name for an HTML element. Derived from
# tagName so it works for source AND created elements without a second string
# per element.
def _el_local_name(thisv: int32) -> int32:
    tv: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("tagName"), 7)
    if js_type_of(tv) != TAG_STR:
        return js_undefined()
    tp: Ptr[uint8] = js_str_bytes(tv)
    tl: int32 = js_str_bytelen(tv)
    if tl > 127:
        tl = 127
    i: int32 = 0
    lstart: int32 = 0
    while i < tl:
        nsq_buf[i] = _hx_lower(tp[i])
        if tp[i] == 58:                                    # ':' — drop the prefix
            lstart = i + 1
        i = i + 1
    return js_new_string(&nsq_buf[lstart], cast[uint64](tl - lstart))


def _el_prefix(thisv: int32) -> int32:
    tv: int32 = js_get_prop(thisv, cast[Ptr[uint8]]("tagName"), 7)
    if js_type_of(tv) != TAG_STR:
        return js_null()
    tp: Ptr[uint8] = js_str_bytes(tv)
    tl: int32 = js_str_bytelen(tv)
    i: int32 = 0
    while i < tl:
        if tp[i] == 58:
            k: int32 = 0
            while k < i and k < 127:
                nsq_buf[k] = _hx_lower(tp[k])
                k = k + 1
            return js_new_string(&nsq_buf[0], cast[uint64](k))
        i = i + 1
    return js_null()


# The lazy accessor pair behind el.attributes / el.localName / el.prefix.
def _nsattr_accessor(rel: int32) -> int32:
    thisv: int32 = js_this()
    if rel == NID_ATTRS_ACC:
        # Memoised in a side table (NOT as an own property, which would shadow
        # this accessor for good) and invalidated by g_attr_gen, so the map
        # stays live across setAttribute()/removeAttribute() but a read loop
        # over attributes[i] does not rebuild it on every iteration.
        ai: int32 = 0
        while ai < attrc_n:
            if attrc_el[ai] == thisv:
                if attrc_gen[ai] == g_attr_gen:
                    return attrc_map[ai]
                mv2: int32 = _build_attrs_map(thisv)
                attrc_map[ai] = mv2
                attrc_gen[ai] = g_attr_gen
                return mv2
            ai = ai + 1
        mv: int32 = _build_attrs_map(thisv)
        slot: int32 = attrc_n
        if attrc_n < ATTRC_MAX:
            attrc_n = attrc_n + 1
        else:
            # Never stop caching: a page with more elements than the table
            # holds would otherwise rebuild a NamedNodeMap on EVERY property
            # read, which is what exhausted the string pool.
            slot = attrc_next
            attrc_next = attrc_next + 1
            if attrc_next >= ATTRC_MAX:
                attrc_next = 0
        attrc_el[slot] = thisv
        attrc_map[slot] = mv
        attrc_gen[slot] = g_attr_gen
        return mv
    if rel == NID_LOCALNAME_ACC:
        return _el_local_name(thisv)
    if rel == NID_PREFIX_ACC:
        return _el_prefix(thisv)
    wv: int32 = js_undefined()
    if js_arg_count() > 0:
        wv = js_arg(0)
    if rel == NID_ATTRS_ACC_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("attributes"), 10, wv)
    elif rel == NID_LOCALNAME_SET:
        js_set_own(thisv, cast[Ptr[uint8]]("localName"), 9, wv)
    else:
        js_set_own(thisv, cast[Ptr[uint8]]("prefix"), 6, wv)
    return js_undefined()


# DOMImplementation. hasFeature is spec'd to answer true for EVERY argument
# list — the spec keeps it only so legacy feature detection stays truthy
# (https://dom.spec.whatwg.org/#dom-domimplementation-hasfeature), which is
# exactly what DOMImplementation-hasFeature.html's 136 subtests assert.
def _new_doctype_obj(np: Ptr[uint8], nn: int32, pubv: int32, sysv: int32) -> int32:
    d: int32 = js_new_object_v()
    if g_proto_doctype != 0:
        js_set_proto_v(d, g_proto_doctype)
    nv: int32 = js_new_string(np, cast[uint64](nn))
    js_set_prop(d, cast[Ptr[uint8]]("name"), 4, nv)
    js_set_prop(d, cast[Ptr[uint8]]("nodeName"), 8, nv)
    js_set_prop(d, cast[Ptr[uint8]]("nodeType"), 8, js_number(10.0))
    js_set_prop(d, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("publicId"), 8, pubv)
    js_set_prop(d, cast[Ptr[uint8]]("systemId"), 8, sysv)
    js_set_prop(d, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("childNodes"), 10, js_new_array_v())
    return d


# A bare element node for a synthetic (createHTMLDocument) tree. These are NOT
# registered in the source-element table — the synthetic document has no source
# — so they carry their own childNodes/children arrays and identity props.
def _new_bare_el(tag: Ptr[uint8], tl: int32, proto: int32) -> int32:
    e: int32 = js_new_object_v()
    lo: Array[32, uint8]
    up: Array[32, uint8]
    i: int32 = 0
    while i < tl and i < 31:
        lo[i] = _hx_lower(tag[i])
        uc: uint8 = tag[i]
        if uc >= 97 and uc <= 122:
            uc = uc - 32
        up[i] = uc
        i = i + 1
    if proto != 0:
        js_set_proto_v(e, proto)
    else:
        _attach_el_methods(e)
    js_set_prop(e, cast[Ptr[uint8]]("tagName"), 7, \
                js_new_string(&up[0], cast[uint64](i)))
    js_set_prop(e, cast[Ptr[uint8]]("nodeName"), 8, \
                js_new_string(&up[0], cast[uint64](i)))
    js_set_prop(e, cast[Ptr[uint8]]("localName"), 9, \
                js_new_string(&lo[0], cast[uint64](i)))
    js_set_prop(e, cast[Ptr[uint8]]("nodeType"), 8, js_number(1.0))
    js_set_prop(e, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_prop(e, cast[Ptr[uint8]]("prefix"), 6, js_null())
    js_set_prop(e, cast[Ptr[uint8]]("namespaceURI"), 12, \
                js_new_string(cast[Ptr[uint8]]("http://www.w3.org/1999/xhtml"), 28))
    kids: int32 = js_new_array_v()
    js_set_own(e, cast[Ptr[uint8]]("children"), 8, js_new_array_v())
    js_set_own(e, cast[Ptr[uint8]]("childNodes"), 10, kids)
    js_set_prop(e, cast[Ptr[uint8]]("firstChild"), 10, js_null())
    js_set_prop(e, cast[Ptr[uint8]]("lastChild"), 9, js_null())
    js_set_prop(e, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    return e


def _bare_append(parent: int32, child: int32):
    kids: int32 = js_get_prop(parent, cast[Ptr[uint8]]("childNodes"), 10)
    js_array_push(kids, child)
    js_set_prop(parent, cast[Ptr[uint8]]("lastChild"), 9, child)
    if js_array_len(kids) == 1:
        js_set_prop(parent, cast[Ptr[uint8]]("firstChild"), 10, child)
    js_set_prop(child, cast[Ptr[uint8]]("parentNode"), 10, parent)
    ct: int32 = js_get_prop(child, cast[Ptr[uint8]]("nodeType"), 8)
    if cast[int32](js_to_number(ct)) == 1:
        js_array_push(js_get_prop(parent, cast[Ptr[uint8]]("children"), 8), child)


# implementation.createHTMLDocument([title]) — a DETACHED document: doctype +
# <html><head>[<title>]</head><body></body></html>. It is not laid out and it
# is not the rendered document; it exists so the ~120 WPT subtests that build a
# scratch document to move nodes between can run at all.
def _new_html_document(has_title: int32, titlev: int32) -> int32:
    d: int32 = js_new_object_v()
    if g_proto_doc != 0:
        js_set_proto_v(d, g_proto_doc)
    _node_constants(d)
    js_set_prop(d, cast[Ptr[uint8]]("nodeType"), 8, js_number(9.0))
    js_set_prop(d, cast[Ptr[uint8]]("nodeName"), 8, \
                js_new_string(cast[Ptr[uint8]]("#document"), 9))
    js_set_prop(d, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("ownerDocument"), 13, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    dt: int32 = _new_doctype_obj(cast[Ptr[uint8]]("html"), 4, \
                                 js_new_string(cast[Ptr[uint8]](""), 0), \
                                 js_new_string(cast[Ptr[uint8]](""), 0))
    js_set_prop(dt, cast[Ptr[uint8]]("parentNode"), 10, d)
    js_set_prop(d, cast[Ptr[uint8]]("doctype"), 7, dt)
    htmlel: int32 = _new_bare_el(cast[Ptr[uint8]]("html"), 4, g_proto_html)
    headel: int32 = _new_bare_el(cast[Ptr[uint8]]("head"), 4, g_proto_head)
    bodyel: int32 = _new_bare_el(cast[Ptr[uint8]]("body"), 4, g_proto_body)
    if has_title != 0:
        titleel: int32 = _new_bare_el(cast[Ptr[uint8]]("title"), 5, g_proto_title)
        tnode: int32 = js_new_object_v()
        if g_proto_text != 0:
            js_set_proto_v(tnode, g_proto_text)
        js_set_prop(tnode, cast[Ptr[uint8]]("nodeType"), 8, js_number(3.0))
        js_set_prop(tnode, cast[Ptr[uint8]]("nodeName"), 8, \
                    js_new_string(cast[Ptr[uint8]]("#text"), 5))
        js_set_prop(tnode, cast[Ptr[uint8]]("__cd"), 4, titlev)
        js_set_prop(tnode, cast[Ptr[uint8]]("textContent"), 11, titlev)
        _bare_append(titleel, tnode)
        _bare_append(headel, titleel)
    _bare_append(htmlel, headel)
    _bare_append(htmlel, bodyel)
    dkids: int32 = js_new_array_v()
    js_array_push(dkids, dt)
    js_array_push(dkids, htmlel)
    js_set_own(d, cast[Ptr[uint8]]("childNodes"), 10, dkids)
    dech: int32 = js_new_array_v()
    js_array_push(dech, htmlel)
    js_set_own(d, cast[Ptr[uint8]]("children"), 8, dech)
    js_set_prop(htmlel, cast[Ptr[uint8]]("parentNode"), 10, d)
    js_set_prop(d, cast[Ptr[uint8]]("documentElement"), 15, htmlel)
    js_set_prop(d, cast[Ptr[uint8]]("head"), 4, headel)
    js_set_prop(d, cast[Ptr[uint8]]("body"), 4, bodyel)
    js_set_prop(d, cast[Ptr[uint8]]("firstChild"), 10, dt)
    js_set_prop(d, cast[Ptr[uint8]]("lastChild"), 9, htmlel)
    js_set_prop(d, cast[Ptr[uint8]]("URL"), 3, \
                js_new_string(cast[Ptr[uint8]]("about:blank"), 11))
    js_set_prop(d, cast[Ptr[uint8]]("documentURI"), 11, \
                js_new_string(cast[Ptr[uint8]]("about:blank"), 11))
    js_set_prop(d, cast[Ptr[uint8]]("compatMode"), 10, \
                js_new_string(cast[Ptr[uint8]]("CSS1Compat"), 10))
    js_set_prop(d, cast[Ptr[uint8]]("characterSet"), 12, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("charset"), 7, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("inputEncoding"), 13, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("contentType"), 11, \
                js_new_string(cast[Ptr[uint8]]("text/html"), 9))
    js_set_prop(d, cast[Ptr[uint8]]("location"), 8, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("defaultView"), 11, js_null())
    if has_title != 0:
        js_set_prop(d, cast[Ptr[uint8]]("title"), 5, titlev)
    else:
        js_set_prop(d, cast[Ptr[uint8]]("title"), 5, \
                    js_new_string(cast[Ptr[uint8]](""), 0))
    # The node factories a scratch document is used for. They mint nodes in the
    # main heap (there is one node pool) — which is what every consumer here
    # actually needs: a node it can append into this document's tree.
    js_set_prop(d, cast[Ptr[uint8]]("createElement"), 13, \
                js_new_native_fn(js_hbase + NID_CREATE))
    js_set_prop(d, cast[Ptr[uint8]]("createElementNS"), 15, \
                js_new_native_fn(js_hbase + NID_CREATE_NS))
    js_set_prop(d, cast[Ptr[uint8]]("createTextNode"), 14, \
                js_new_native_fn(js_hbase + NID_CTEXT))
    js_set_prop(d, cast[Ptr[uint8]]("createComment"), 13, \
                js_new_native_fn(js_hbase + NID_CREATECOMMENT))
    js_set_prop(d, cast[Ptr[uint8]]("createRange"), 11, \
                js_new_native_fn(js_hbase + NID_CREATERANGE))
    js_set_prop(d, cast[Ptr[uint8]]("createTreeWalker"), 16, \
                js_new_native_fn(js_hbase + NID_CREATETW))
    js_set_prop(d, cast[Ptr[uint8]]("createNodeIterator"), 18, \
                js_new_native_fn(js_hbase + NID_CREATENI))
    js_set_prop(d, cast[Ptr[uint8]]("createProcessingInstruction"), 27, \
                js_new_native_fn(js_hbase + NID_CREATEPI))
    js_set_prop(d, cast[Ptr[uint8]]("createDocumentFragment"), 22, \
                js_new_native_fn(js_hbase + NID_CREATEFRAG))
    js_set_prop(d, cast[Ptr[uint8]]("createAttribute"), 15, \
                js_new_native_fn(js_hbase + NID_CREATEATTR))
    js_set_prop(d, cast[Ptr[uint8]]("createAttributeNS"), 17, \
                js_new_native_fn(js_hbase + NID_CREATEATTRNS))
    js_set_prop(d, cast[Ptr[uint8]]("implementation"), 14, _new_impl_obj(d))
    return d


def _new_impl_obj(docv: int32) -> int32:
    impl: int32 = js_new_object_v()
    if g_proto_impl != 0:
        js_set_proto_v(impl, g_proto_impl)
    js_set_prop(impl, cast[Ptr[uint8]]("hasFeature"), 10, \
                js_new_native_fn(js_hbase + NID_IMPL_HASFEAT))
    js_set_prop(impl, cast[Ptr[uint8]]("createHTMLDocument"), 18, \
                js_new_native_fn(js_hbase + NID_IMPL_CREHTMLD))
    js_set_prop(impl, cast[Ptr[uint8]]("createDocument"), 14, \
                js_new_native_fn(js_hbase + NID_IMPL_CREDOC))
    js_set_prop(impl, cast[Ptr[uint8]]("createDocumentType"), 18, \
                js_new_native_fn(js_hbase + NID_IMPL_CREDOCT))
    if implown_n < IMPLOWN_MAX:
        implown_impl[implown_n] = impl
        implown_doc[implown_n] = docv
        implown_n = implown_n + 1
    return impl


# The Document a DOMImplementation belongs to (js_doc if we cannot tell).
def _impl_doc_of(implv: int32) -> int32:
    i: int32 = 0
    while i < implown_n:
        if implown_impl[i] == implv:
            return implown_doc[i]
        i = i + 1
    return js_doc


# ---- XML qualified-name validation ------------------------------------------
# The rules below are the ones the vendored WPT table actually encodes
# (tests/wpt/tests/dom/nodes/Document-createElementNS.js — ~130 rows read
# row-by-row on 2026-07-29), NOT a from-memory reading of the XML Name
# production, which disagrees with browsers on several of them (e.g. "f<oo" is
# accepted and "foo>" is not).
#
#   * the first byte must be an ASCII letter, '_' or non-ASCII (>= 0x80)
#   * no byte anywhere may be a space or '>'
#   * with a ':' the name splits at the FIRST colon; the LOCAL part must be
#     non-empty and every one of its bytes must be a strict NameChar
#     (letter/digit/'.'/'-'/'_'/':'/non-ASCII). The PREFIX part is not
#     character-checked ("0:a" is accepted).
def _xml_name_start(c: uint8) -> int32:
    if c >= 128:
        return 1
    if c >= 97 and c <= 122:
        return 1
    if c >= 65 and c <= 90:
        return 1
    if c == 95:                                            # '_'
        return 1
    return 0


def _xml_name_char(c: uint8) -> int32:
    if _xml_name_start(c) != 0:
        return 1
    if c >= 48 and c <= 57:                                # 0-9
        return 1
    if c == 45 or c == 46 or c == 58:                      # '-' '.' ':'
        return 1
    return 0


# 0 = ok, 1 = InvalidCharacterError, 2 = NamespaceError.
# `nsn` < 0 means the namespace argument was null/undefined.
def _validate_qname(qp: Ptr[uint8], qn: int32, nsp: Ptr[uint8], nsn: int32) -> int32:
    if qn <= 0:
        return 1
    colon: int32 = -1
    i: int32 = 0
    while i < qn:
        c: uint8 = qp[i]
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 62:   # ws or '>'
            return 1
        if c == 58 and colon < 0:
            colon = i
        i = i + 1
    if colon < 0:
        if _xml_name_start(qp[0]) == 0:
            return 1
    else:
        # With a prefix it is the LOCAL part that is character-checked; the
        # prefix is not ("0:a" is accepted, "a:0" is not).
        if colon == 0:
            return 1                                       # empty prefix
        if colon + 1 >= qn:
            return 1                                       # empty local part
        k: int32 = colon + 1
        if _xml_name_start(qp[k]) == 0 and qp[k] != 58:
            return 1
        while k < qn:
            if _xml_name_char(qp[k]) == 0:
                return 1
            k = k + 1
    # --- namespace rules (DOM "validate and extract") ---
    has_ns: int32 = 0
    if nsn > 0:
        has_ns = 1
    if colon > 0 and has_ns == 0:
        return 2                                           # prefix, no namespace
    xmlns_ns: int32 = 0
    if has_ns != 0 and _bytes_eq(nsp, nsn, \
                     cast[Ptr[uint8]]("http://www.w3.org/2000/xmlns/"), 29) != 0:
        xmlns_ns = 1
    xml_ns: int32 = 0
    if has_ns != 0 and _bytes_eq(nsp, nsn, \
                     cast[Ptr[uint8]]("http://www.w3.org/XML/1998/namespace"), 36) != 0:
        xml_ns = 1
    is_xmlns_q: int32 = _bytes_eq(qp, qn, cast[Ptr[uint8]]("xmlns"), 5)
    pfx_xml: int32 = 0
    pfx_xmlns: int32 = 0
    if colon > 0:
        pfx_xml = _bytes_eq(qp, colon, cast[Ptr[uint8]]("xml"), 3)
        pfx_xmlns = _bytes_eq(qp, colon, cast[Ptr[uint8]]("xmlns"), 5)
    if pfx_xml != 0 and xml_ns == 0:
        return 2
    if (pfx_xmlns != 0 or is_xmlns_q != 0) and xmlns_ns == 0:
        return 2
    if xmlns_ns != 0 and pfx_xmlns == 0 and is_xmlns_q == 0:
        return 2
    return 0


pi_tbuf: Array[256, uint8]           # createProcessingInstruction target


# Is p[0..n) a legal XML Name (the ProcessingInstruction target production)?
def _validate_pi_target(p: Ptr[uint8], n: int32) -> int32:
    if n <= 0:
        return 0
    if _xml_name_start(p[0]) == 0:
        return 0
    i: int32 = 1
    while i < n:
        if _xml_name_char(p[i]) == 0:
            return 0
        i = i + 1
    return 1


def _throw_qname(code: int32) -> int32:
    if code == 2:
        return _throw_domexc(cast[Ptr[uint8]]("NamespaceError"), 14, \
                             cast[Ptr[uint8]]("invalid qualified name"), 22)
    return _throw_domexc(cast[Ptr[uint8]]("InvalidCharacterError"), 21, \
                         cast[Ptr[uint8]]("invalid qualified name"), 22)


# A namespaced element for a synthetic XML document: tagName is the qualified
# name EXACTLY as given (XML documents do not upper/lower-case), split into
# prefix + localName.
def _new_xml_el(qp: Ptr[uint8], qn: int32, nsv: int32, docv: int32) -> int32:
    e: int32 = js_new_object_v()
    if g_proto_elem != 0:
        js_set_proto_v(e, g_proto_elem)
    else:
        _attach_el_methods(e)
    qv: int32 = js_new_string(qp, cast[uint64](qn))
    colon: int32 = -1
    i: int32 = 0
    while i < qn:
        if qp[i] == 58:
            colon = i
            i = qn
        else:
            i = i + 1
    lv: int32 = qv
    pv: int32 = js_null()
    if colon >= 0:
        lv = js_new_string(&qp[colon + 1], cast[uint64](qn - colon - 1))
        pv = js_new_string(qp, cast[uint64](colon))
    js_set_own(e, cast[Ptr[uint8]]("tagName"), 7, qv)
    js_set_own(e, cast[Ptr[uint8]]("nodeName"), 8, qv)
    js_set_own(e, cast[Ptr[uint8]]("localName"), 9, lv)
    js_set_own(e, cast[Ptr[uint8]]("prefix"), 6, pv)
    js_set_own(e, cast[Ptr[uint8]]("nodeType"), 8, js_number(1.0))
    js_set_own(e, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_own(e, cast[Ptr[uint8]]("namespaceURI"), 12, nsv)
    js_set_own(e, cast[Ptr[uint8]]("ownerDocument"), 13, docv)
    js_set_own(e, cast[Ptr[uint8]]("children"), 8, js_new_array_v())
    js_set_own(e, cast[Ptr[uint8]]("childNodes"), 10, js_new_array_v())
    js_set_own(e, cast[Ptr[uint8]]("firstChild"), 10, js_null())
    js_set_own(e, cast[Ptr[uint8]]("lastChild"), 9, js_null())
    js_set_own(e, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    return e


def _impl_dispatch(rel: int32) -> int32:
    if rel == NID_IMPL_HASFEAT:
        return js_bool(1)
    if rel == NID_IMPL_CREDOCT:
        dtn: int32 = 0
        if js_arg_count() >= 1:
            dtn = _arg_bytes(0, &nsq_buf[0], 128)
        # NO name validation: the "validate" step was removed from
        # createDocumentType in modern DOM, and WPT asserts that
        # createDocumentType("1foo"|"@foo"|"edi:{", ...) all succeed.
        pubv: int32 = js_new_string(cast[Ptr[uint8]](""), 0)
        sysv: int32 = pubv
        if js_arg_count() >= 2:
            pubv = js_arg(1)
        if js_arg_count() >= 3:
            sysv = js_arg(2)
        dt0: int32 = _new_doctype_obj(&nsq_buf[0], dtn, pubv, sysv)
        js_set_prop(dt0, cast[Ptr[uint8]]("ownerDocument"), 13, \
                    _impl_doc_of(js_this()))
        return dt0
    if rel == NID_IMPL_CREHTMLD:
        # `title` is an OPTIONAL DOMString: omitted (or explicitly undefined)
        # means the synthetic <head> gets no <title> child at all, while
        # createHTMLDocument(null) really does title the document "null".
        if js_arg_count() < 1 or js_type_of(js_arg(0)) == TAG_UNDEF:
            return _new_html_document(0, js_undefined())
        tn2: int32 = _arg_bytes(0, &impl_title[0], 1024)
        return _new_html_document(1, js_new_string(&impl_title[0], \
                                                   cast[uint64](tn2)))
    # ---- createDocument(namespace, qualifiedName, doctype) -> XMLDocument ----
    nsn: int32 = -1
    if js_arg_count() >= 1 and js_type_of(js_arg(0)) != TAG_NULL and \
       js_type_of(js_arg(0)) != TAG_UNDEF:
        nsn = _arg_bytes(0, &nsuri_buf[0], 256)
        if nsn == 0:
            nsn = -1                                       # "" == no namespace
    # `namespace` is DOMString? (nullable: undefined -> null) but
    # `qualifiedName` is a plain DOMString, so an explicit `undefined` really
    # does become the seven-character name "undefined" and DOES get a root
    # element. Only null (or a missing argument) omits it.
    qn: int32 = 0
    if js_arg_count() >= 2 and js_type_of(js_arg(1)) != TAG_NULL:
        qn = _arg_bytes(1, &nsq_buf[0], 128)
    if qn > 0:
        qc: int32 = _validate_qname(&nsq_buf[0], qn, &nsuri_buf[0], nsn)
        if qc != 0:
            return _throw_qname(qc)
    nsv: int32 = js_null()
    if nsn > 0:
        nsv = js_new_string(&nsuri_buf[0], cast[uint64](nsn))
    d: int32 = js_new_object_v()
    xmlctor: int32 = js_global_get(cast[Ptr[uint8]]("XMLDocument"), 11)
    if js_type_of(xmlctor) == TAG_OBJ:
        js_set_proto_v(d, js_fn_prototype(xmlctor))
    elif g_proto_doc != 0:
        js_set_proto_v(d, g_proto_doc)
    _node_constants(d)
    js_set_prop(d, cast[Ptr[uint8]]("nodeType"), 8, js_number(9.0))
    js_set_prop(d, cast[Ptr[uint8]]("nodeName"), 8, \
                js_new_string(cast[Ptr[uint8]]("#document"), 9))
    js_set_prop(d, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("ownerDocument"), 13, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("parentNode"), 10, js_null())
    # contentType is derived from the ROOT NAMESPACE, not the document kind.
    ctp: Ptr[uint8] = cast[Ptr[uint8]]("application/xml")
    ctn: int32 = 15
    if nsn > 0:
        if _bytes_eq(&nsuri_buf[0], nsn, \
                     cast[Ptr[uint8]]("http://www.w3.org/1999/xhtml"), 28) != 0:
            ctp = cast[Ptr[uint8]]("application/xhtml+xml")
            ctn = 21
        elif _bytes_eq(&nsuri_buf[0], nsn, \
                       cast[Ptr[uint8]]("http://www.w3.org/2000/svg"), 26) != 0:
            ctp = cast[Ptr[uint8]]("image/svg+xml")
            ctn = 13
    js_set_prop(d, cast[Ptr[uint8]]("contentType"), 11, \
                js_new_string(ctp, cast[uint64](ctn)))
    kids: int32 = js_new_array_v()
    dtv: int32 = js_null()
    if js_arg_count() >= 3 and js_type_of(js_arg(2)) == TAG_OBJ:
        dtv = js_arg(2)
        js_set_prop(dtv, cast[Ptr[uint8]]("ownerDocument"), 13, d)
        js_set_prop(dtv, cast[Ptr[uint8]]("parentNode"), 10, d)
        js_array_push(kids, dtv)
    js_set_prop(d, cast[Ptr[uint8]]("doctype"), 7, dtv)
    root: int32 = js_null()
    if qn > 0:
        root = _new_xml_el(&nsq_buf[0], qn, nsv, d)
        js_set_prop(root, cast[Ptr[uint8]]("parentNode"), 10, d)
        js_array_push(kids, root)
    js_set_own(d, cast[Ptr[uint8]]("childNodes"), 10, kids)
    dech: int32 = js_new_array_v()
    if qn > 0:
        js_array_push(dech, root)
    js_set_own(d, cast[Ptr[uint8]]("children"), 8, dech)
    js_set_prop(d, cast[Ptr[uint8]]("documentElement"), 15, root)
    js_set_prop(d, cast[Ptr[uint8]]("firstChild"), 10, js_array_get(kids, 0))
    js_set_prop(d, cast[Ptr[uint8]]("lastChild"), 9, \
                js_array_get(kids, js_array_len(kids) - 1))
    js_set_prop(d, cast[Ptr[uint8]]("location"), 8, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("defaultView"), 11, js_null())
    js_set_prop(d, cast[Ptr[uint8]]("compatMode"), 10, \
                js_new_string(cast[Ptr[uint8]]("CSS1Compat"), 10))
    js_set_prop(d, cast[Ptr[uint8]]("characterSet"), 12, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("charset"), 7, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("inputEncoding"), 13, \
                js_new_string(cast[Ptr[uint8]]("UTF-8"), 5))
    js_set_prop(d, cast[Ptr[uint8]]("URL"), 3, \
                js_new_string(cast[Ptr[uint8]]("about:blank"), 11))
    js_set_prop(d, cast[Ptr[uint8]]("documentURI"), 11, \
                js_new_string(cast[Ptr[uint8]]("about:blank"), 11))
    # An XML document's createElement does NOT ASCII-lowercase the tag name.
    js_set_prop(d, cast[Ptr[uint8]]("createElement"), 13, \
                js_new_native_fn(js_hbase + NID_CREATE_XML))
    js_set_prop(d, cast[Ptr[uint8]]("createElementNS"), 15, \
                js_new_native_fn(js_hbase + NID_CREATE_NS))
    js_set_prop(d, cast[Ptr[uint8]]("createTextNode"), 14, \
                js_new_native_fn(js_hbase + NID_CTEXT))
    js_set_prop(d, cast[Ptr[uint8]]("createComment"), 13, \
                js_new_native_fn(js_hbase + NID_CREATECOMMENT))
    js_set_prop(d, cast[Ptr[uint8]]("createRange"), 11, \
                js_new_native_fn(js_hbase + NID_CREATERANGE))
    js_set_prop(d, cast[Ptr[uint8]]("createTreeWalker"), 16, \
                js_new_native_fn(js_hbase + NID_CREATETW))
    js_set_prop(d, cast[Ptr[uint8]]("createNodeIterator"), 18, \
                js_new_native_fn(js_hbase + NID_CREATENI))
    js_set_prop(d, cast[Ptr[uint8]]("createProcessingInstruction"), 27, \
                js_new_native_fn(js_hbase + NID_CREATEPI))
    js_set_prop(d, cast[Ptr[uint8]]("createDocumentFragment"), 22, \
                js_new_native_fn(js_hbase + NID_CREATEFRAG))
    # An XML document's createAttribute is case-PRESERVING (only an HTML
    # document lowercases), exactly as its createElement already is -- hence its
    # own native rather than the shared NID_CREATEATTR.
    js_set_prop(d, cast[Ptr[uint8]]("createAttribute"), 15, \
                js_new_native_fn(js_hbase + NID_CREATEATTR_XML))
    js_set_prop(d, cast[Ptr[uint8]]("createAttributeNS"), 17, \
                js_new_native_fn(js_hbase + NID_CREATEATTRNS))
    js_set_prop(d, cast[Ptr[uint8]]("implementation"), 14, _new_impl_obj(d))
    return d


