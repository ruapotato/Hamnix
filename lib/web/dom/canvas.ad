# Interface index for a LOWERCASE tag name, or -1 for the plain HTMLElement.
# Dispatched on the first byte first so a page with thousands of elements does
# not walk the whole table for each one.
def _tag_iface(tp: Ptr[uint8], tl: int32) -> int32:
    if tl <= 0:
        return -1
    c0: uint8 = tp[0]
    if c0 == 97:                                # 'a'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("audio"), 5) != 0:
            return 2
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("area"), 4) != 0:
            return 1
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("a"), 1) != 0:
            return 0
    elif c0 == 98:                                # 'b'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("blockquote"), 10) != 0:
            return 44
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("button"), 6) != 0:
            return 6
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("base"), 4) != 0:
            return 4
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("body"), 4) != 0:
            return 5
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("br"), 2) != 0:
            return 3
    elif c0 == 99:                                # 'c'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("colgroup"), 8) != 0:
            return 52
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("caption"), 7) != 0:
            return 50
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("canvas"), 6) != 0:
            return 7
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("col"), 3) != 0:
            return 52
    elif c0 == 100:                                # 'd'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("datalist"), 8) != 0:
            return 10
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("dialog"), 6) != 0:
            return 11
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("data"), 4) != 0:
            return 9
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("dir"), 3) != 0:
            return 12
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("div"), 3) != 0:
            return 13
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("del"), 3) != 0:
            return 34
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("dl"), 2) != 0:
            return 8
    elif c0 == 101:                                # 'e'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("embed"), 5) != 0:
            return 14
    elif c0 == 102:                                # 'f'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("fieldset"), 8) != 0:
            return 15
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("frameset"), 8) != 0:
            return 19
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("frame"), 5) != 0:
            return 18
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("font"), 4) != 0:
            return 16
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("form"), 4) != 0:
            return 17
    elif c0 == 104:                                # 'h'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("head"), 4) != 0:
            return 21
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("html"), 4) != 0:
            return 23
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h1"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h2"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h3"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h4"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h5"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("h6"), 2) != 0:
            return 22
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("hr"), 2) != 0:
            return 20
    elif c0 == 105:                                # 'i'
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("iframe"), 6) != 0:
            return 24
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("input"), 5) != 0:
            return 26
        if _bytes_eq(tp, tl, cast[Ptr[uint8]]("img"), 3) != 0:
