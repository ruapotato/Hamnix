                # author margin-bottom REPLACES it. Latch the real px so the emitted
                # gap row draws at Chrome's exact pitch (16px) instead of a full
                # ~19px body row — the general prose paragraph-rhythm lever (every
                # article/blog is mostly <p>-to-<p> gaps).
                pmb: int32 = 16
                if g_p_mb >= 0:
                    pmb = g_p_mb
                    pgap = (g_p_mb + LINE_H / 2) / LINE_H
