            # `rows` attribute; else the UA default of 2 rows. <textarea> is non-void
            # so its cascade already ran — read m_ht/d_ht directly through the helper.
            ta_rows: int32 = _control_height_rows()
            if ta_rows == 0:
                ta_rows = _attr_int(ne, te, cast[Ptr[uint8]]("rows"), 2)
            if ta_rows < 1:
                ta_rows = 1
            # WIDTH (cols): a CSS `width` wins; else the HTML `cols` attribute; else
