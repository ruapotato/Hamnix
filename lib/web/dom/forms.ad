                # flex <li> that carries an explicit `width` (the date `<d>`) is a
                # blockified flex item, so its width is reserved as a fixed column
                # (see g_flexli_active in the generic dispatch). el_sp is this
                # <li>'s depth; a direct child is at el_sp + 1.
                g_flexli_active = 1
                g_flexli_depth = el_sp
            if nomark != 0:
                pen_x = indent_x
                _pending_indjump = 1
                row_dirty = 1
                g_li_pending = 1                     # reserved line, no content yet
                need_space = 0
                return
            # ARM the marker (deferred): _seg_ensure emits it into the gutter of
            # the item's FIRST content segment — so a block child (`<li><a
