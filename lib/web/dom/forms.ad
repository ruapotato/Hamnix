            # inset (g_tbl_padx; CELL_PADX by default, 0 for cellpadding="0" so a
            # tight table's text starts flush at the column edge like Chrome).
            padx_side = g_tbl_padx
        indent_x = col_x[cc] + padx_side
        pen_x = col_x[cc] + padx_side
        cell_right = col_x[endc] - padx_side
        cell_active = 1
        cell_is_th = is_th
        # Latch this cell's border box UNCONDITIONALLY (col_x[cc] left edge to
        # col_x[endc] right edge, top row = the current row): _cell_close needs
