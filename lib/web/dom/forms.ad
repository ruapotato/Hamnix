    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h1")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h2")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h3")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h4")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h5")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h6")) != 0:
        _word_flush()
        lvl: int32 = cast[int32](src_ptr[np + 1] - 48)
        if is_close == 0:
            _soft_newline()
            g_heading = lvl
            # Resolve the cascade (m_*) + inline (d_*) FIRST so an author
            # margin-top is in view before we emit the heading's top gap.
