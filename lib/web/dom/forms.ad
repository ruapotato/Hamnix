        # renderer shears the (single) monospace bitmap face. Not a true italic
        # typeface — the slant is synthesised from the upright glyphs.
        _word_flush()
        if is_close == 0:
            g_italic_n = g_italic_n + 1
        else:
            if g_italic_n > 0:
                g_italic_n = g_italic_n - 1
        _style_break()
        return
    # ---- UA-default inline styling for the common low-frequency tags ----
    # <kbd>/<samp>/<var>: monospace face (like <code>) so keystrokes, program
    # output and variables stand out from body text. Author CSS (colour/bg) can
    # still override via _open_style pushed on top.
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("kbd")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("samp")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("var")) != 0:
        _word_flush()
        if is_close == 0:
            g_mono_n = g_mono_n + 1
            _open_style(ne, te)
        else:
            _close_style()
            if g_mono_n > 0:
                g_mono_n = g_mono_n - 1
        _style_break()
        return
    # <mark>: yellow highlight background. Pushed BELOW the author cascade so
    # `mark { background: … }` still wins (lowest specificity UA default).
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("mark")) != 0:
        _word_flush()
        if is_close == 0:
            _bg_push(MARK_BG)
            _open_style(ne, te)
        else:
            _close_style()
            _bg_pop()
        _style_break()
        return
    # <small>: ~0.8x the current effective font size. Pushed UNDER the author
    # cascade so an explicit font-size on <small> still overrides.
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("small")) != 0:
        _word_flush()
        if is_close == 0:
            base_px: int32 = g_font_px
            if base_px <= 0:
                base_px = EM_PX
            sm: int32 = base_px * 13 / 16
            if sm < 8:
                sm = 8
            _fontpx_push(sm)
            _open_style(ne, te)
        else:
            _close_style()
            _fontpx_pop()
        _style_break()
        return
    # <sub>/<sup>: smaller font + a raised/lowered baseline (seg_yoff). The font
    # push sits under the author cascade so an explicit font-size still wins; the
    # vertical shift is a UA-only effect (no CSS vertical-align support).
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("sub")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("sup")) != 0:
        is_sup: int32 = _hx_name_eq(np, nlen, cast[Ptr[uint8]]("sup"))
        _word_flush()
        if is_close == 0:
            if is_sup != 0:
                sup_depth = sup_depth + 1
            else:
                sub_depth = sub_depth + 1
            g_yoff = sub_depth * SUB_DROP - sup_depth * SUP_RISE
            base_px2: int32 = g_font_px
            if base_px2 <= 0:
                base_px2 = EM_PX
            ss: int32 = base_px2 * 10 / 13
            if ss < 8:
                ss = 8
            _fontpx_push(ss)
            _open_style(ne, te)
        else:
            _close_style()
            _fontpx_pop()
            if is_sup != 0:
                if sup_depth > 0:
                    sup_depth = sup_depth - 1
            else:
                if sub_depth > 0:
