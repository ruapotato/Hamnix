            if ta_wpx >= 0:
                ta_cols = ta_wpx / CELL_W - 2
                if ta_cols < 2:
                    ta_cols = 2
            else:
                ta_cols = _attr_int(ne, te, cast[Ptr[uint8]]("cols"), FORM_TEXT_COLS)
