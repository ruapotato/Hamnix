            # (Chrome's h1..h6 carry a ~0.67-1.33em top margin), suppressed at the
            # very top of the document (no leading blank). An AUTHOR margin-top
            # REPLACES that UA default (it is the SAME property — the author cascade
            # wins — NOT an addition on top of it); a margin-top:0 therefore removes
            # the gap entirely. The resolved single margin then COLLAPSES with a
            # preceding block's bottom margin (Chrome collapses adjacent vertical
            # margins to the max): emit via _emit_vgap, not a raw _bump_row, so a
            # `</p><h2>` boundary yields ONE gap, not two stacked. Applies to h1..h6
            # (previously only h1-h3 got any UA gap, gluing h4-h6 to the prior block).
            if cur_row > 0:
                htop: int32 = -1
                if m_mt >= 0:
                    htop = m_mt
                if d_mt >= 0:
                    htop = d_mt
                pre_h: int32 = cast[int32](cur_row)
                if htop < 0:
                    _emit_vgap(1)                        # UA default (~1 line)
                    # If this UA heading top margin (~0.8-1.3em, i.e. a full body
                    # row) COLLAPSED onto a preceding paragraph's sub-row gap row
                    # (tagged 16px above), the taller heading margin wins the
                    # collapse — restore that gap row to the full body height so a
                    # `</p><h2>` section boundary is not pinched to the paragraph's
                    # 16px pitch (Chrome renders it at the heading's ~20px).
                    if cast[int32](cur_row) == pre_h and pre_h >= 1 \
                            and row_mgap[pre_h - 1] > 0:
                        row_mgap[pre_h - 1] = 0
