# lib/web/dom/forms.ad — part of the modular web engine (extracted from htmlengine.ad).
# form controls — monospace-grid rendering + state for input/textarea/button/select/radio/checkbox.
#
# Behavior-preserving split (single-compilation-unit; byte-identical).

from lib.htmlengine import _alnum_at, _attr_int, _attr_width_val, _bg_pop, _bg_push, _blk_indent_pop, _blk_indent_push, _block_box_close, _block_box_open, _bump_row, _emit_vgap, _capture_href, _cascade_match_current, _cell_close, _close_seg, _close_style, _collect_css, _color_pop, _color_push, _compute_cols, _content_right, _deco_pop, _deco_push, _el_pop, _el_pop_lit, _el_push, _enter_skip, _flex_container_close, _flex_container_open, _flex_item_close, _flex_item_col, _float_box_close, _float_box_open, _fontpx_pop, _fontpx_push, _gencontent_close, _gencontent_open, _generic_block_wanted, g_li_pending, g_cell_pending, _grid_find_colmajor, _grid_find_dense, _grid_occupy_rect, _grid_rect_free, _grid_row_h_rows, _grid_row_top_rows, _grid_wrap_row, _handle_img, _handle_inline_svg, _img_cascade, _hx_find_attr, _hx_lower, _hx_name_eq, _inlb_close, _inlb_open, _inlb_tag, _is_display_none, _is_visually_hidden, _left_margin, _li_close_lvl, _mark_button_seg, _mark_button_seg_geo, _mark_button_seg_full, _mark_check_seg, _mark_field_seg, _mark_field_seg_geo, _mark_select_seg, _measure_table, _newline, _open_style, _own_color, _para_break, _parse_inline_wa, _pending_indjump, _pending_marker, _pending_marker_num, _pending_marker_shape, _pending_marker_x, _recompute_indent, _recompute_style, _seg_putc, _seg_putc_dec, _soft_newline, _style_break, _table_natural_width, _table_pop, _table_push, _table_region_end, _tag_align_attr, _tbl_apply_cellpad, _tagname_is, _word_flush, _word_push, _hx_tag_end_p

# ====================================================================
# FORM CONTROLS — monospace-grid rendering of <input>/<textarea>/<button>/
# <select>. The controls are drawn from the (possibly JS-rewritten) source
# attributes so a value/checked change re-renders through the normal rewrite
# path. See the DOM section for the value/checked get-set + event wiring.
# ====================================================================
fbuf: Array[512, uint8]                  # scratch for one attribute value

# 1 while an explicit `body { margin }` (overriding the UA 8px CONTENT_X default)
# has a base-indent adjustment pushed on the blk-indent stack, so the matching
# </body> pops it exactly once. See the <body> handler in _handle_tag.
g_body_ml_pushed: int32 = 0
# 1 while a `body{margin-right}` override has widened g_page_right_max, so </body>
# restores the UA content-right exactly once.
g_body_mr_widened: int32 = 0


# Is the whitespace/boundary-delimited word `name` present in tag body [ts,te)?
# (Handles bare boolean attributes like `checked` / `selected` that carry no
# `=value`, which _hx_find_attr — which requires an '=' — would miss.)
def _has_word(ts: uint64, te: uint64, name: Ptr[uint8]) -> int32:
    nl: uint64 = 0
    while name[nl] != 0:
        nl = nl + 1
    i: uint64 = ts
    while i + nl <= te:
        prev_alpha: int32 = 0
        if i > ts:
            pc: uint8 = _hx_lower(src_ptr[i - 1])
            if (pc >= 97 and pc <= 122) or (pc >= 48 and pc <= 57) or pc == 45:
                prev_alpha = 1
        if prev_alpha == 0 and _srcword_is(i, name) != 0 and \
           _alnum_at(i + nl) == 0:
            return 1
        i = i + 1
    return 0


# Presence test for a boolean HTML attribute NAME (e.g. the global `hidden`
# attribute) in a tag body [ne,te). Unlike _has_word, this respects quotes so a
# CLASS/ID VALUE that merely contains the word (`class="hidden-print"`,
# `aria-hidden="true"`) never counts — only a bare top-level attribute token
# whose name is exactly `name` and which is terminated by whitespace / `=` /
# `/` / `>` matches. Returns 1 if present (any value, per the HTML boolean-attr
# rule where even `hidden="false"` still hides), 0 otherwise.
# Icon-font ligature container? Material Design ships icons as `<i class=
# "material-icons">arrow_drop_down</i>` where the webfont turns the LIGATURE
# keyword into a glyph. hambrowse has no such font, so it painted the raw
# keyword ("arrow_drop_down", "open_in_new", "navigate_next" …) as literal prose
# — clutter on any Material site (go.dev's nav). Chrome shows the glyph, never
# the word; with no font the closest match is to paint nothing. Detects a class
# TOKEN prefixed `material-icons` / `material-symbols` (covers the -outlined /
# -round / -sharp variants). Returns 1 to suppress the text, 0 otherwise.
def _is_icon_font_el(ne: uint64, te: uint64) -> int32:
    if _hx_find_attr(ne, te, cast[Ptr[uint8]]("class")) == 0:
        return 0
    p: uint64 = g_attr_start
    e: uint64 = g_attr_end
    while p < e:
        c: uint8 = src_ptr[p]
        if c == 32 or c == 9 or c == 10 or c == 13:  # whitespace between tokens
            p = p + 1
        else:
            if _srcword_is(p, cast[Ptr[uint8]]("material-icons")) != 0 or \
               _srcword_is(p, cast[Ptr[uint8]]("material-symbols")) != 0:
                return 1
            while p < e and src_ptr[p] != 32 and src_ptr[p] != 9 and \
                  src_ptr[p] != 10 and src_ptr[p] != 13:
                p = p + 1
    return 0


def _has_bool_attr(ne: uint64, te: uint64, name: Ptr[uint8]) -> int32:
    nl: uint64 = 0
    while name[nl] != 0:
        nl = nl + 1
    i: uint64 = ne
    inq: uint8 = 0
    while i < te:
        c: uint8 = src_ptr[i]
        if inq != 0:                                 # inside a quoted value
            if c == inq:
                inq = 0
            i = i + 1
        elif c == 34 or c == 39:                     # '"' or "'"
            inq = c
            i = i + 1
        else:
            prev_ws: int32 = 0
            if i == ne:
                prev_ws = 1
            else:
                pc: uint8 = src_ptr[i - 1]
                if pc == 32 or pc == 9 or pc == 10 or pc == 13:
                    prev_ws = 1
            if prev_ws != 0 and _srcword_is(i, name) != 0:
                j: uint64 = i + nl
                if j >= te:
                    return 1
                nc: uint8 = src_ptr[j]
                if nc == 32 or nc == 9 or nc == 10 or nc == 13 or \
                   nc == 62 or nc == 47 or nc == 61:  # ws / '>' / '/' / '='
                    return 1
            i = i + 1
    return 0


# APP-SHELL side-region detector. Returns 1 when the element being opened is a
# COMPLEMENTARY sidebar — an <aside> element or role="complementary". Such a
# region, when it precedes <main> in document order, is floated to a left gutter
# (see the block-open path) so the article body flows up beside it, not below it.
#
# NOTE: a pre-<main> `<nav>` (or role=navigation/search) is deliberately NOT
# treated as a floatable sidebar. On real sites that element is far more often
# the site MASTHEAD or PRIMARY navigation — a full-width horizontal top bar
# (MDN's reference mega-menu <nav>, BBC's section+region <nav>) — than a narrow
# side column. Its author CSS lays it across the top; absent that CSS it holds a
# giant expanded menu. Squeezing that into a 240px gutter overlapped the article
# on every real doc/news site tested, while providing no benefit where it did
# stack correctly (Wikipedia renders the same whether its <nav>s float or not).
# `<aside>`, by contrast, semantically means complementary side content, so it is
# a reliable float target. Used only under the g_doc_has_main gate.
def _is_landmark_side(np: uint64, nlen: uint64, ne: uint64, te: uint64) -> int32:
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("aside")) != 0:
        return 1
    if _hx_find_attr(ne, te, cast[Ptr[uint8]]("role")) != 0:
        p: uint64 = g_attr_start
        if _srcword_is(p, cast[Ptr[uint8]]("complementary")) != 0:
            return 1
    return 0


# CSS-checkbox-hack dropdown popup detector. The near-universal JS-free dropdown
# idiom is: an <input type=checkbox> toggle + <label>, followed by a popup panel
# whose class carries a `*dropdown-content` token; the panel is `display:none`
# until the checkbox is `:checked`, via a `:checked ~ .dropdown-content` rule
# that commonly lives in an EXTERNAL stylesheet the engine never fetches. Absent
# that rule the panel renders EXPANDED, dumping its whole menu into the page
# (Wikipedia's Vector skin: the 163-language list, the main-menu / page-tools /
# appearance menus — all `.vector-dropdown-content`). Since a dropdown popup is
# collapsed by default, treat such a panel as display:none. Matches a class
# TOKEN ending in `dropdown-content` (covers vector-dropdown-content, the bare
# `dropdown-content` of countless CSS-only navbars, framework `*__dropdown-
# content`, etc.). A visible panel is essentially never named this, so the
# false-positive risk is negligible. Returns 1 to suppress, 0 otherwise.
def _is_dropdown_popup(ne: uint64, te: uint64) -> int32:
    if _hx_find_attr(ne, te, cast[Ptr[uint8]]("class")) == 0:
        return 0
    p: uint64 = g_attr_start
    e: uint64 = g_attr_end
    while p < e:
        c: uint8 = src_ptr[p]
        if c == 32 or c == 9 or c == 10 or c == 13:  # whitespace between tokens
            p = p + 1
        else:
            ts: uint64 = p                            # token start
            while p < e and src_ptr[p] != 32 and src_ptr[p] != 9 and \
                  src_ptr[p] != 10 and src_ptr[p] != 13:
                p = p + 1
            # Does this token END with "dropdown-content"? Check the tail.
            tl: uint64 = p - ts                       # token length
            if tl >= 16:
                if _srcword_is(p - 16, cast[Ptr[uint8]]("dropdown-content")) != 0:
                    return 1
    return 0


# Copy attribute `name`'s value from tag body [ne,te) into fbuf (NUL-term).
# Returns its length, or -1 if the attribute is absent.
def _attr_to_fbuf(ne: uint64, te: uint64, name: Ptr[uint8]) -> int32:
    if _hx_find_attr(ne, te, name) == 0:
        return -1
    n: int32 = 0
    p: uint64 = g_attr_start
    while p < g_attr_end and n < 511:
        if src_ptr[p] == 38:                         # '&' — decode entity
            consumed: uint64 = _entity(p)
            if consumed > 0:
                k: int32 = 0
                while k < g_ent_len and n < 511:
                    fbuf[n] = g_ent_buf[k]
                    n = n + 1
                    k = k + 1
                p = p + consumed
                continue
        fbuf[n] = src_ptr[p]
        n = n + 1
        p = p + 1
    fbuf[n] = 0
    return n


# Push a NUL-terminated C string into the inline word accumulator.
def _wpush_cstr(s: Ptr[uint8]):
    i: int32 = 0
    while s[i] != 0:
        _word_push(s[i])
        i = i + 1


# Push a src span [a,b) into the word accumulator.
def _wpush_range(a: uint64, b: uint64):
    i: uint64 = a
    while i < b:
        _word_push(src_ptr[i])
        i = i + 1


# input type is `lit` (case-insensitive); missing type defaults to "text".
def _input_type_is(ne: uint64, te: uint64, lit: Ptr[uint8]) -> int32:
    n: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("type"))
    if n < 0:
        return _bytes_eq(cast[Ptr[uint8]]("text"), 4, lit, _cstr_len(lit))
    # lower-case the buffered type
    k: int32 = 0
    while k < n:
        fbuf[k] = _hx_lower(fbuf[k])
        k = k + 1
    return _bytes_eq(&fbuf[0], n, lit, _cstr_len(lit))


# Emit a textual control token as one wrapping word: <pre-flushed> [box].
# Default paint surfaces for form controls when the author gave no CSS
# background — a light field grey and a slightly darker button grey. Purely
# visual (seg_bg); the bracketed text representation is unchanged.
FORM_FIELD_BG: int32 = 0xf1f3f4
FORM_BTN_BG:   int32 = 0xe0e3e7

# UA default field WIDTH in average-character cells. A text-like <input> with no
# `size` attribute and no CSS `width` renders at the HTML `size` default of 20 —
# Chrome/Firefox reserve ~20 avg-char widths (~150-170px), NOT a content-hugging
# box. This is what makes an EMPTY / short search field a wide, clickable target
# rather than a tiny box the user can't hit. A <textarea> with no `cols`/`width`
# shares the same 20-column default (per the UA stylesheet). Fields carrying a
# `size`/`cols` attr or CSS `width` override this (see _control_width_cells).
FORM_TEXT_COLS: int32 = 20

# Resolve a form control's cascaded CSS `width` to a MONOSPACE CELL count for the
# field run, or -1 when no width is set. `width` cascades on a void <input> via a
# transient _img_cascade match (same pattern accent-color uses); inline style=""
# (d_wd) overrides the stylesheet winner (m_wd). Both are already px-resolved
# (percentages against the content box) by the cascade. The field run is bracketed
# ([value___]) so its total width is (cells)*CELL_W; the caller pads the underscore
# run so the run spans `width`. Returns the number of INNER cells (target minus the
# two bracket cells), floored at 2, or -1 when width is unset (keep the >=8 default).
def _control_width_cells(np: uint64, nlen: uint64, ne: uint64, te: uint64) -> int32:
    _img_cascade(np, nlen, ne, te)
    wpx: int32 = -1
    if m_wd >= 0:
        wpx = m_wd
    if d_wd >= 0:
        wpx = d_wd
    if wpx < 0:
        # No CSS `width`: honour the HTML `size` attribute (average character
        # count). Chrome/Firefox size a text field to `size` avg-char widths; the
        # bracket run is padded to `size` cells so the pixel renderer's field box
        # spans that reserved width. -1 (no size) keeps the >=8-cell default.
        sz: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("size"), -1)
        if sz > 0:
            return sz
        return -1
    tc: int32 = wpx / CELL_W - 2                       # minus the two '[' ']' cells
    if tc < 2:
        tc = 2
    return tc


# Resolve a void control's cascaded CSS `height` to whole text ROWS, mirroring
# _control_width_cells. Consumes the transient _img_cascade winner already
# established by the caller (do NOT re-run it here, so the shared nth-child
# restore happens once). Returns the row count (>=1) or 0 when no height is set
# (keep the default single-row control — byte-identical to the pre-height path).
def _control_height_rows() -> int32:
    hpx: int32 = -1
    if m_ht >= 0:
        hpx = m_ht
    if d_ht >= 0:                                       # inline style="" overrides
        hpx = d_ht
    if hpx < 0:
        return 0
    rows: int32 = (hpx + LINE_H / 2) / LINE_H           # nearest whole row
    if rows < 1:
        rows = 1
    return rows


# Resolve a void control's cascaded CSS `appearance` (1 = none, suppress the
# default UA chrome). Consumes the transient _img_cascade winner already set by
# the caller. Returns 0 (default chrome) unless appearance:none is in effect.
def _control_appear() -> int32:
    ap: int32 = m_appear
    if d_appear != 0:                                  # inline style="" overrides
        ap = d_appear
    return ap


def _emit_input(np: uint64, nlen: uint64, ne: uint64, te: uint64):
    if _input_type_is(ne, te, cast[Ptr[uint8]]("hidden")) != 0:
        return                                        # hidden: renders nothing
    _word_flush()
    if _input_type_is(ne, te, cast[Ptr[uint8]]("checkbox")) != 0:
        # state: 0 unchecked / 1 checked / 2 indeterminate. `:indeterminate` has
        # no HTML content attribute (it is a JS property), so as an honest static
        # trigger we honour an `indeterminate` boolean attribute on the control.
        chk: int32 = 0
        if _has_word(ne, te, cast[Ptr[uint8]]("checked")) != 0:
            chk = 1
        if _has_word(ne, te, cast[Ptr[uint8]]("indeterminate")) != 0:
            chk = 2
        # resolve the control's CSS accent-color (stylesheet + inline style="")
        # via a transient cascade match — <input> is void, so it is not otherwise
        # pushed/cascaded. Restores the parent nth-child counters (see _img_cascade).
        _img_cascade(np, nlen, ne, te)
        cacc: int32 = m_accent
        if d_accent >= 0:                              # inline style="" overrides
            cacc = d_accent
        _word_push(91)                                # '[' (kept for text/gate view)
        if chk == 1:
            _word_push(120)                           # 'x'
        elif chk == 2:
            _word_push(45)                            # '-' (indeterminate)
        else:
            _word_push(32)
        _word_push(93)                                # ']'
        _word_flush()
        _mark_check_seg(3, chk, cacc)                  # pixel renderer draws a box
        return
    if _input_type_is(ne, te, cast[Ptr[uint8]]("radio")) != 0:
        rchk: int32 = 0
        if _has_word(ne, te, cast[Ptr[uint8]]("checked")) != 0:
            rchk = 1
        _img_cascade(np, nlen, ne, te)
        racc: int32 = m_accent
        if d_accent >= 0:                              # inline style="" overrides
            racc = d_accent
        _word_push(40)                                # '(' (kept for text/gate view)
        if rchk != 0:
            _word_push(42)                            # '*'
        else:
            _word_push(32)
        _word_push(41)                                # ')'
        _word_flush()
        _mark_check_seg(4, rchk, racc)                 # pixel renderer draws a circle
        return
    is_btn: int32 = 0
    if _input_type_is(ne, te, cast[Ptr[uint8]]("submit")) != 0 or \
       _input_type_is(ne, te, cast[Ptr[uint8]]("button")) != 0 or \
       _input_type_is(ne, te, cast[Ptr[uint8]]("reset")) != 0:
        is_btn = 1
    if is_btn != 0:
        # push-button: [ label ] on a shaded button face, so it reads as a real
        # button rather than bracketed ASCII. seg_bg only affects the painted
        # pixels; the bracket text is preserved for the text/gate view. The seg
        # is isolated + committed as a kind-2 button seg (like <button>) so the
        # PIXEL renderer draws a bordered, centred push-button box — NOT the raw
        # '[ label ]' glyphs (which mangled google's Search/Lucky buttons).
        save_bg_b: int32 = g_bg
        save_rgb_b: int32 = g_rgb
        # An icon submit/button carries its affordance via an aria-label rather
        # than a `value`; painting a placeholder "Button" label there is wrong
        # (google's hidden Send control). Render nothing when valueless + labelled.
        if _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("value")) <= 0 and \
           _hx_find_attr(ne, te, cast[Ptr[uint8]]("aria-label")) != 0:
            return
        _close_seg()                                  # isolate the button seg
        # Cascade-match the (void) <input> so its OWN author CSS — background,
        # border colour/radius, text colour, height, appearance — resolves. The
        # button branch previously read STALE cascade winners (never matched the
        # input), so a styled submit button (google's `.T14B5e input[type=submit]`
        # with `#f8f9fa` face + 8px radius + `#3c4043` label) fell back to the UA
        # button-grey chrome. Restores parent nth-child counters (see _img_cascade).
        _img_cascade(np, nlen, ne, te)
        btn_appear: int32 = _control_appear()
        btn_rows: int32 = _control_height_rows()
        # resolved author colours (inline style="" overrides the sheet winner).
        a_bg: int32 = m_bg
        if d_bg >= 0:
            a_bg = d_bg
        a_bordc: int32 = m_bordc
        # radius: -1 keeps the UA default 3px rounding. m_bordr==0 means "unset OR
        # square"; only a POSITIVE author radius overrides (so an unstyled button
        # keeps its default corners rather than being forced square).
        a_rad: int32 = -1
        if m_bordr > 0:
            a_rad = m_bordr
        if d_bordr > 0:
            a_rad = d_bordr
        a_col: int32 = m_col
        if d_color >= 0:
            a_col = d_color
        # button label text colour (google's `#3c4043`); seg_rgb tracks g_rgb.
        if a_col >= 0:
            g_rgb = a_col
        # background: author fill wins; else the UA button-grey face (default
        # chrome only — appearance:none suppresses any default surface).
        if btn_appear == 0:
            if a_bg >= 0:
                g_bg = a_bg
            elif g_bg < 0:
                g_bg = FORM_BTN_BG
        else:
            if a_bg >= 0:
                g_bg = a_bg
        _word_push(91)
        _word_push(32)
        blen: int32 = 0
        vn: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("value"))
        if vn > 0:
            _wpush_cstr(&fbuf[0])
            blen = vn
        else:
            _wpush_cstr(cast[Ptr[uint8]]("Button"))
            blen = 6
        _word_push(32)
        _word_push(93)
        _word_flush()
        # content = the space-padded label (" Go "), so the push-button box draws
        # it centred exactly like a <button> [ label ] box. Author border colour +
        # radius ride along so a styled button paints its real chrome.
        _mark_button_seg_full(blen + 2, btn_appear, btn_rows, a_bordc, a_rad)
        g_bg = save_bg_b
        g_rgb = save_rgb_b
        return
    # file picker: a button-faced [ Choose File ] control (spec: opens a file
    # dialog; we surface the affordance so the field reads as a real upload).
    if _input_type_is(ne, te, cast[Ptr[uint8]]("file")) != 0:
        save_bg_file: int32 = g_bg
        if g_bg < 0:
            g_bg = FORM_BTN_BG
        _word_push(91)                                # '['
        _word_push(32)
        _wpush_cstr(cast[Ptr[uint8]]("Choose File"))
        _word_push(32)
        _word_push(93)                                # ']'
        _word_flush()
        g_bg = save_bg_file
        return
    # range slider: the PIXEL renderer draws a real track+thumb bar filled to the
    # value fraction and tinted by the cascaded accent-color (checkbox/radio share
    # this accent). The '[--O--]' glyphs stay for the text/gate view; the painter
    # (seg_field kind 5) skips them and draws the widget. min/max/value default to
    # 0/100/midpoint per the HTML spec, giving a 50%-filled default slider.
    if _input_type_is(ne, te, cast[Ptr[uint8]]("range")) != 0:
        # resolve accent-color via a transient cascade (input is void) — same
        # pattern the checkbox/radio branches use; restores parent nth-child.
        _img_cascade(np, nlen, ne, te)
        racc: int32 = m_accent
        if d_accent >= 0:                              # inline style="" overrides
            racc = d_accent
        rmin: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("min"), 0)
        rmax: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("max"), 100)
        if rmax <= rmin:
            rmax = rmin + 100
        rval: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("value"), \
                                rmin + (rmax - rmin) / 2)
        rpct: int32 = (rval - rmin) * 100 / (rmax - rmin)
        if rpct < 0:
            rpct = 0
        if rpct > 100:
            rpct = 100
        _wpush_cstr(cast[Ptr[uint8]]("[--O--]"))
        _word_flush()
        _mark_check_seg(5, rpct, racc)                 # pixel renderer draws a slider
        return
    # color picker: a [#rrggbb] swatch token from the value (default #000000).
    if _input_type_is(ne, te, cast[Ptr[uint8]]("color")) != 0:
        save_bg_col: int32 = g_bg
        if g_bg < 0:
            g_bg = FORM_FIELD_BG
        _word_push(91)                                # '['
        cvn: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("value"))
        if cvn > 0:
            _wpush_cstr(&fbuf[0])
        else:
            _wpush_cstr(cast[Ptr[uint8]]("#000000"))
        _word_push(93)                                # ']'
        _word_flush()
        g_bg = save_bg_col
        return
    # password: mask every value character with '*' (spec: the value is never
    # shown as plaintext). Placeholder-less; pads to >=8 like a text field.
    if _input_type_is(ne, te, cast[Ptr[uint8]]("password")) != 0:
        save_bg_pw: int32 = g_bg
        _close_seg()                                  # isolate the field seg
        pw_cells: int32 = _control_width_cells(np, nlen, ne, te)
        pw_appear: int32 = _control_appear()
        pw_rows: int32 = _control_height_rows()
        if g_bg < 0 and pw_appear == 0:
            g_bg = FORM_FIELD_BG
        _word_push(91)                                # '['
        pwlen: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("value"))
        pw_content: int32 = 0
        pwi: int32 = 0
        while pwi < pwlen:
            _word_push(42)                            # '*'
            pwi = pwi + 1
        if pwlen > 0:
            pw_content = pwlen
        if pwlen < 0:
            pwlen = 0
        pw_pad: int32 = FORM_TEXT_COLS                # UA default field width (size=20)
        if pw_cells >= 0:                             # CSS `width` sets the field width
            pw_pad = pw_cells
        while pwlen < pw_pad:
            _word_push(95)                            # '_'
            pwlen = pwlen + 1
        _word_push(93)                                # ']'
        _word_flush()
        # commit as a field segment so the pixel renderer draws a real, masked
        # field box (the '*' run) rather than the bracket/underscore glyphs.
        _mark_field_seg_geo(pw_content, pw_appear, pw_rows)
        g_bg = save_bg_pw
        return
    # text-like field: [value padded to >=8 with '_'] on a shaded field box, so
    # it reads as a real input field, not raw ASCII. The bracket/underscore
    # glyphs stay (for the text view + gates); seg_bg paints the field surface.
    save_bg_f: int32 = g_bg
    _close_seg()                                      # isolate the field seg
    # Resolve the control's CSS width/appearance/height up front (one transient
    # cascade). `appearance:none` suppresses the default field surface so author
    # CSS styles the control; `height` sets its row span. Gated: a field WITHOUT
    # these declarations sees cells=-1/appear=0/rows=0 and is byte-identical.
    txt_cells: int32 = _control_width_cells(np, nlen, ne, te)
    txt_appear: int32 = _control_appear()
    txt_rows: int32 = _control_height_rows()
    if g_bg < 0 and txt_appear == 0:
        g_bg = FORM_FIELD_BG
    _word_push(91)                                    # '['
    vlen: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("value"))
    ilen: int32 = 0
    content_n: int32 = 0
    if vlen > 0:
        _wpush_cstr(&fbuf[0])
        ilen = vlen
        content_n = vlen
    else:
        pn: int32 = _attr_to_fbuf(ne, te, cast[Ptr[uint8]]("placeholder"))
        if pn > 0:
            _wpush_cstr(&fbuf[0])
            ilen = pn
            content_n = pn
    txt_pad: int32 = FORM_TEXT_COLS                   # UA default field width (size=20)
    if txt_cells >= 0:                                # CSS `width`/`size` sets the field width
        txt_pad = txt_cells
    while ilen < txt_pad:
        _word_push(95)                                # '_'
        ilen = ilen + 1
    _word_push(93)                                    # ']'
    _word_flush()
    # commit as a field segment so the pixel renderer draws a real bordered,
    # filled field box (value + caret) instead of the bracket/underscore glyphs.
    _mark_field_seg_geo(content_n, txt_appear, txt_rows)
    g_bg = save_bg_f


# Find the selected <option>'s visible text inside a <select> whose body
# starts at `body0`; copies it to fbuf (NUL-term) and returns its length.
# Picks the option carrying `selected`, else the first option.
def _select_text(body0: uint64) -> int32:
    i: uint64 = body0
    first_s: int32 = -1
    first_e: int32 = -1
    while i < src_len:
        if src_ptr[i] == 60:                          # '<'
            if i + 1 < src_len and src_ptr[i + 1] == 47 and \
               _tagname_is(i + 2, cast[Ptr[uint8]]("select")) != 0:
                break
            if _tagname_is(i + 1, cast[Ptr[uint8]]("option")) != 0:
                je: uint64 = i + 1
                je = _hx_tag_end_p(src_ptr, src_len, je)
                ne: uint64 = i + 1
                while ne < je and _alnum_at(ne) != 0:
                    ne = ne + 1
                cs: uint64 = je + 1
                ce: uint64 = cs
                while ce < src_len and src_ptr[ce] != 60:
                    ce = ce + 1
                if first_s < 0:
                    first_s = cast[int32](cs)
                    first_e = cast[int32](ce)
                if _has_word(ne, je, cast[Ptr[uint8]]("selected")) != 0:
                    n: int32 = 0
                    p: uint64 = cs
                    while p < ce and n < 511:
                        fbuf[n] = src_ptr[p]
                        n = n + 1
                        p = p + 1
                    fbuf[n] = 0
                    return n
        i = i + 1
    if first_s >= 0:
        n2: int32 = 0
        p2: uint64 = cast[uint64](first_s)
        while p2 < cast[uint64](first_e) and n2 < 511:
            fbuf[n2] = src_ptr[p2]
            n2 = n2 + 1
            p2 = p2 + 1
        fbuf[n2] = 0
        return n2
    fbuf[0] = 0
    return 0


# Index (0-based) of a <select>'s selected option, scanning from body0.
# The option carrying `selected`, else 0 (the first).
def _select_index(body0: uint64) -> int32:
    i: uint64 = body0
    idx: int32 = -1
    sel: int32 = -1
    while i < src_len:
        if src_ptr[i] == 60:                          # '<'
            if i + 1 < src_len and src_ptr[i + 1] == 47 and \
               _tagname_is(i + 2, cast[Ptr[uint8]]("select")) != 0:
                break
            if _tagname_is(i + 1, cast[Ptr[uint8]]("option")) != 0:
                idx = idx + 1
                je: uint64 = i + 1
                je = _hx_tag_end_p(src_ptr, src_len, je)
                if _has_word(i + 1, je, cast[Ptr[uint8]]("selected")) != 0 and \
                   sel < 0:
                    sel = idx
        i = i + 1
    if sel >= 0:
        return sel
    return 0


# Visible text of the option at 0-based index `want` inside a <select> whose
# body starts at body0 -> fbuf (NUL-term); returns its length, or -1 if the
# index is out of range. Mirror of _select_text but keyed on position, so a JS
# `select.selectedIndex = N` write can resolve to the option it now selects.
def _select_optext_at(body0: uint64, want: int32) -> int32:
    i: uint64 = body0
    idx: int32 = -1
    while i < src_len:
        if src_ptr[i] == 60:                          # '<'
            if i + 1 < src_len and src_ptr[i + 1] == 47 and \
               _tagname_is(i + 2, cast[Ptr[uint8]]("select")) != 0:
                break
            if _tagname_is(i + 1, cast[Ptr[uint8]]("option")) != 0:
                idx = idx + 1
                je: uint64 = i + 1
                je = _hx_tag_end_p(src_ptr, src_len, je)
                cs: uint64 = je + 1
                ce: uint64 = cs
                while ce < src_len and src_ptr[ce] != 60:
                    ce = ce + 1
                if idx == want:
                    n: int32 = 0
                    p: uint64 = cs
                    while p < ce and n < 511:
                        fbuf[n] = src_ptr[p]
                        n = n + 1
                        p = p + 1
                    fbuf[n] = 0
                    return n
        i = i + 1
    return -1


# Close the generic block box on the top of the stack (the shared close path for
# <p>/<div>/<section>/… and any display:block element). Pops the flex-container /
# float / positioned bookkeeping the matching open pushed, closes the style
# scope, and emits the in-flow paragraph gap. Factored out of the block branch so
# a SYNTHESISED implied </p> can run the exact same, proven close sequence. The
# caller handles any element-specific close side effects (e.g. an <a> link reset)
# and the trailing _style_break().
def _hx_block_close(paragap: int32):
    cidx: int32 = box_sp - 1
    was_item: int32 = 0
    was_cont: int32 = 0
    was_pos: int32 = 0
    posrun: int32 = -1
    abs_ret2: int32 = 0
    pushed: int32 = 0
    was_nowrap: int32 = 0
    if cidx >= 0:
        was_item = box_flexitem_stack[cidx]
        was_nowrap = box_flexnowrap_stack[cidx]
        was_cont = box_flexcont_stack[cidx]
        was_pos  = box_pos_stack[cidx]
        posrun   = box_posrun_stack[cidx]
        abs_ret2 = box_pretrow_stack[cidx]
        pushed   = box_pushedctx_stack[cidx]
    if was_cont != 0:
        _flex_container_close()                  # drop to tallest column
    fs: int32 = _float_box_close()
    _close_style()
    if posrun >= 0:
        # finalise the box's last text segment so the run spans it.
        _word_flush()
        _close_seg()
        pos_seg1[posrun] = cast[int32](n_segs)
        pos_bf1[posrun]  = n_bfills
        pos_bx1[posrun]  = n_bboxes
    if pushed != 0:
        _posctx_pop()
    if was_pos == 2:
        cur_row = cast[uint64](abs_ret2)         # out of flow: rewind
        pen_x = indent_x
        row_dirty = 0
        need_space = 0
        if abs_flow_depth > 0:                    # leave the out-of-flow subtree
            abs_flow_depth = abs_flow_depth - 1
    elif was_item != 0:
        _flex_item_close()                       # rewind for next column
        if g_flex_item_depth > 0:
            g_flex_item_depth = g_flex_item_depth - 1
        # Drop the nowrap guard ONLY if THIS item armed it (content-sized pill),
        # so a shrunk `flex:1` card (which never armed it) leaves the depth alone.
        if was_nowrap != 0 and g_flex_nowrap_depth > 0:
            g_flex_nowrap_depth = g_flex_nowrap_depth - 1
    elif fs == 0:                                # in-flow box: end the line
        # A paragraph-like block (<p>/<figure>) contributes a UA vertical margin,
        # emulated as one blank row (_para_break). A STRUCTURAL container
        # (<div>/<section>/<article>/<header>/<footer>/<main>/<nav>/<aside>/…) has
        # NO default margin per CSS, so it must NOT inject a phantom blank row —
        # its only vertical spacing comes from an explicit CSS margin (already
        # applied by _block_box_open/_close via ftop/botg). Emitting the phantom
        # row for every container (and once MORE for every nesting level) is what
        # inflated inter-block whitespace far beyond the CSS margins on real pages.
        if paragap != 0:
            _para_break()
        else:
            _soft_newline()


# Does a start tag named src[np..np+nlen) implicitly close an open <p>? Per the
# WHATWG "a start tag whose tag name is one of [block containers]" rule: opening
# any of these while a <p> is open (with its </p> omitted) closes the <p> first.
def _hx_closes_p(np: uint64, nlen: uint64) -> int32:
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("p")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("div")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("ul")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("ol")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("dl")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("dd")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("dt")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("li")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("table")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("blockquote")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("pre")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("hr")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("form")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("fieldset")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("address")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figure")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figcaption")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("details")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("menu")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("section")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("article")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("aside")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("header")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("footer")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("main")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("nav")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h1")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h2")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h3")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h4")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h5")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("h6")) != 0:
        return 1
    return 0


# Synthesise an implied </p> when a block-level start tag opens while a <p> is
# still open (real pages routinely omit </p>). Runs the same close sequence as a
# real </p>: flush pending text, close the block box + style scope + paragraph
# gap, and pop the <p> off the element stack so descendant selectors stop
# matching under it. A no-op when no <p> is open (byte-identical for well-formed
# pages whose </p> is present — p_open is already cleared by the explicit close).
def _hx_implicit_close_p():
    if p_open == 0:
        return
    p_open = 0
    _word_flush()
    _hx_block_close(1)                           # <p>: keep the paragraph gap
    _el_pop_lit(cast[Ptr[uint8]]("p"), 1)
    _style_break()


# Implied end tag for a definition list: close the currently-open <dt> (drop its
# bold) or <dd> (drop its indent level) so a sibling <dt>/<dd> — or the enclosing
# </dl> — implicitly closes the previous item (real markup routinely omits the
# </dt>/</dd>). A no-op when no item is open, so a well-formed <dl> whose items
# carry explicit end tags is byte-identical (dl_item is 0 by then).
def _hx_dl_close_item():
    if dl_item == 1:
        if g_bold_n > 0:
            g_bold_n = g_bold_n - 1
        _recompute_style()          # drop the <dt> bold from the effective style
    elif dl_item == 2:
        if dd_depth > 0:
            dd_depth = dd_depth - 1
        _recompute_indent()
    dl_item = 0


# When gathering an element's inner text as a control label (the <button> label
# scan), a nested <style>/<script> must have its ENTIRE rawtext body skipped —
# its CSS/JS is never label text. `open_at` points at the tag-name start (just
# past '<') of a candidate open tag; `limit` bounds the scan. Returns the index
# just past the matching </style>/</script> close tag when open_at names a
# style/script element, or `open_at` unchanged otherwise. Real pages (google's
# search button ships `<button ...><style>.Tg7LZd{…}</style>…`) triggered the
# raw CSS leaking as the button's visible label before this.
def _skip_raw_child(open_at: uint64, limit: uint64) -> uint64:
    is_script: int32 = 0
    if _tagname_is(open_at, cast[Ptr[uint8]]("script")) != 0:
        is_script = 1
    elif _tagname_is(open_at, cast[Ptr[uint8]]("style")) == 0:
        return open_at
    q: uint64 = open_at
    while q < limit:
        if src_ptr[q] == 60 and q + 1 < limit and src_ptr[q + 1] == 47:
            hit: int32 = 0
            if is_script != 0:
                hit = _tagname_is(q + 2, cast[Ptr[uint8]]("script"))
            else:
                hit = _tagname_is(q + 2, cast[Ptr[uint8]]("style"))
            if hit != 0:
                break
        q = q + 1
    q = _hx_tag_end_p(src_ptr, limit, q)           # past the close tag's '>'
    if q < limit:
        q = q + 1
    return q


# Does the <button> body [bcs,bce) carry any VISIBLE (non-whitespace) text
# outside nested markup? Mirrors the label-extraction walk below: skip
# <style>/<script> rawtext children and toggle in_tag on '<'/'>'. Used to tell
# an icon-only / aria-labelled button (no text, e.g. google's "Add files and
# tools" +-icon) from one that genuinely wants a "Button" placeholder label.
def _btn_body_has_text(bcs: uint64, bce: uint64) -> int32:
    bp: uint64 = bcs
    in_tag: int32 = 0
    while bp < bce:
        bc: uint8 = src_ptr[bp]
        if bc == 60:                                  # '<'
            if bp + 1 < bce and src_ptr[bp + 1] != 47:
                nq: uint64 = _skip_raw_child(bp + 1, bce)
                if nq != bp + 1:
                    bp = nq
                    continue
            in_tag = 1
        elif bc == 62:                                # '>'
            in_tag = 0
        elif in_tag == 0:
            if bc != 10 and bc != 13 and bc != 9 and bc != 32:
                return 1                              # a real glyph (or entity)
        bp = bp + 1
    return 0


# Does the <button> body [bcs,bce) contain an <svg>/<img> icon child? An
# icon-only button (no text label) is a graphical control — render nothing
# rather than a stray "Button" placeholder.
def _btn_body_has_icon(bcs: uint64, bce: uint64) -> int32:
    bp: uint64 = bcs
    while bp < bce:
        if src_ptr[bp] == 60:                         # '<'
            if _tagname_is(bp + 1, cast[Ptr[uint8]]("svg")) != 0 or \
               _tagname_is(bp + 1, cast[Ptr[uint8]]("img")) != 0:
                return 1
        bp = bp + 1
    return 0


# Scan a <button>'s body from `bs` (its '>' + 1) to the matching </button> for
# an <svg>/<img> ICON child. Used to keep an icon-bearing control chip (google's
# "AI Mode" button) on the compact [label] button path even when it is a flex
# item — the block-CTA path leaks the icon markup as flow and grows the box tall.
def _button_has_icon_from(bs: uint64) -> int32:
    p: uint64 = bs
    while p < src_len:
        if src_ptr[p] == 60:                          # '<'
            if p + 1 < src_len and src_ptr[p + 1] == 47 and \
               _tagname_is(p + 2, cast[Ptr[uint8]]("button")) != 0:
                return 0                              # reached </button>
            if _tagname_is(p + 1, cast[Ptr[uint8]]("svg")) != 0 or \
               _tagname_is(p + 1, cast[Ptr[uint8]]("img")) != 0:
                return 1
        p = p + 1
    return 0


def _handle_tag(ts: uint64, te: uint64):
    if ts >= te:
        return
    # comment / doctype / processing — ignore.
    if src_ptr[ts] == 33 or src_ptr[ts] == 63:       # '!' or '?'
        return
    is_close: int32 = 0
    np: uint64 = ts
    if src_ptr[np] == 47:                            # '/'
        is_close = 1
        np = np + 1
    # tag name end (letters/digits)
    ne: uint64 = np
    while ne < te:
        c: uint8 = src_ptr[ne]
        if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or \
           (c >= 48 and c <= 57):
            ne = ne + 1
        else:
            break
    nlen: uint64 = ne - np
    if nlen == 0:
        return

    # CSSOM layout-read tap: remember WHICH element is about to lay out, keyed
    # the way the DOM keys a node (`dom_anchor` = the source offset of its '<',
    # i.e. ts - 1). `_block_box_open` consumes this to stamp the box it opens
    # with its element identity so getBoundingClientRect/offsetWidth/
    # getComputedStyle can read the element's REAL laid-out box back. A CLOSE
    # tag clears it so a stray box never picks up the closing tag's offset.
    if is_close == 0:
        g_open_src = cast[int32](ts) - 1
    else:
        g_open_src = -1

    # MASTHEAD tracking for the app-shell landmark float: keep a `<header>`
    # nesting depth so a chrome <nav> INSIDE the page header (the site top bar /
    # masthead) is recognised and NOT floated into a narrow side gutter (see the
    # float gate below). A `<header>` start bumps the depth; its close drops it.
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("header")) != 0:
        if is_close == 0:
            g_header_depth = g_header_depth + 1
        elif g_header_depth > 0:
            g_header_depth = g_header_depth - 1

    # Implied end tag (WHATWG "generate implied end tags"): a block-level start
    # tag opening while a <p> is still open (its </p> omitted, as real pages do
    # constantly) first synthesises the </p>. Runs BEFORE the element stack is
    # touched so the popped <p> and the freshly-opened block nest as siblings.
    if is_close == 0 and _hx_closes_p(np, nlen) != 0:
        _hx_implicit_close_p()

    # script/style/head/title: drop their content from the render flow.
    # NOTE: <style> is still consumed for the render (its rules were already
    # harvested by _collect_css() before layout). <script> execution now happens
    # BEFORE layout in _run_scripts() (see the "JAVASCRIPT + minimal DOM"
    # section): every script body is js_eval'd against a shared context + a
    # `document` DOM binding, and any DOM the scripts mutate is baked into a
    # rewritten source that this layout pass then consumes. Here we simply drop
    # the <script> text from the RENDER flow so page text is not polluted by
    # code (its behaviour already ran).
    if is_close == 0:
        if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("script")) != 0 or \
           _hx_name_eq(np, nlen, cast[Ptr[uint8]]("style")) != 0 or \
           _hx_name_eq(np, nlen, cast[Ptr[uint8]]("head")) != 0 or \
           _hx_name_eq(np, nlen, cast[Ptr[uint8]]("title")) != 0:
            _word_flush()
            _enter_skip(np, nlen)
            return
        # <noscript>: fallback content shown ONLY when scripting is disabled.
        # hambrowse is a scripting-capable browser (lib/jsengine.ad is always
        # wired and <script>/inline handlers run in _run_scripts), so per the
        # HTML standard its children must NOT render — exactly like a real
        # browser with JS enabled. This is what suppresses the ubiquitous
        # "Please enable JavaScript" block real sites (Google) ship inside
        # <noscript>; before this, that text leaked into the render flow and
        # also skewed the layout with a stray paragraph/stylesheet.
        if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("noscript")) != 0:
            _word_flush()
            _enter_skip(np, nlen)
            return
        # <canvas>: reserve its pixel box (blitting the script-drawn buffer) and
        # SKIP any fallback content. Handled here, before the element stack is
        # touched, so it opens no unbalanced scope (like script/style above).
        if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("canvas")) != 0:
            _handle_canvas(ts, np, nlen, ne, te)
            return
        # inline <svg>: rasterise the whole <svg>...</svg> subtree through the
        # shared lib/svg rasterizer and emit a replaced image box, then SKIP the
        # shape children so they don't leak into the text flow. Handled here,
        # before the element stack, so it opens no unbalanced scope.
        if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("svg")) != 0:
            if _handle_inline_svg(ts, te) != 0:
                _enter_skip(np, nlen)
            return

    # ---- element stack (for descendant selectors) + display:none ----
    # Void elements never open a scope; everything else is tracked so the CSS
    # cascade can match .class / #id / descendant selectors against ancestors.
    is_void: int32 = 0
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("br")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("hr")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("img")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("input")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("meta")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("link")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("area")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("col")) != 0:
        is_void = 1
    g_eff_disp = 0
    g_flex_dir = 0
    g_flex_just = 0
    g_flex_align = 0
    g_flex_acontent = 0
    g_flex_gap = -1
    g_flex_rowgap = -1
    g_flex_wrap = 0
    g_flex_grid = 0
    g_flex_dense = 0
    g_flex_colflow = 0
    g_grid_n = 0
    g_grid_rn = 0
    g_grid_gar = 0
    g_grid_cspan = 1
    g_grid_cstart = 0
    g_grid_rspan = 1
    g_grid_rstart = 0
    g_gareas_n = 0
    g_gareas_cols = 0
    g_grid_areaname = -1
    g_treat_as_block = 0
    g_inlb = 0
    if is_close == 0:
        if is_void == 0:
            _el_push(np, nlen, ne, te)
            _cascade_match_current()
            if _is_display_none(ne, te) != 0:      # also runs _parse_inline_wa
                _el_pop(np, nlen)
                _word_flush()
                _enter_skip(np, nlen)
                return
            # Global HTML `hidden` attribute: the UA stylesheet maps `[hidden]`
            # to display:none, so its subtree must not render (go.dev's "Press
            # Enter to activate/deactivate dropdown" a11y prose ships as
            # `<div class="screen-reader-only" ... hidden>`). Presence hides
            # regardless of value, per the boolean-attribute rule.
            if _has_bool_attr(ne, te, cast[Ptr[uint8]]("hidden")) != 0:
                _el_pop(np, nlen)
                _word_flush()
                _enter_skip(np, nlen)
                return
            # CSS-checkbox-hack dropdown popup (`*dropdown-content` panel): a
            # menu that is display:none until its toggle checkbox is :checked,
            # via a rule that usually lives in an unfetched external stylesheet.
            # Collapsed by default, so skip its subtree instead of dumping the
            # whole expanded menu (Vector's 163-language list / nav menus).
            if _is_dropdown_popup(ne, te) != 0:
                _el_pop(np, nlen)
                _word_flush()
                _enter_skip(np, nlen)
                return
            # Icon-font ligature container (Material Icons/Symbols): the keyword
            # is a glyph in the webfont, not readable text — suppress so it does
            # not paint as literal prose ("arrow_drop_down", "open_in_new" …).
            if _is_icon_font_el(ne, te) != 0:
                _el_pop(np, nlen)
                _word_flush()
                _enter_skip(np, nlen)
                return
            # Screen-reader-only / visually-hidden idiom (1x1 absolute clip box):
            # Chrome paints nothing, so skip the subtree like display:none rather
            # than laying the a11y prose out as visible text.
            if _is_visually_hidden() != 0:
                _el_pop(np, nlen)
                _word_flush()
                _enter_skip(np, nlen)
                return
            g_eff_disp = m_disp
            if d_disp != 0:
                g_eff_disp = d_disp
            g_flex_dir = m_flexdir
            if d_flexdir != 0:
                g_flex_dir = d_flexdir
            g_flex_just = m_justify
            if d_justify != 0:
                g_flex_just = d_justify
            g_flex_align = m_aitems
            if d_aitems != 0:
                g_flex_align = d_aitems
            g_flex_acontent = m_acontent
            if d_acontent != 0:
                g_flex_acontent = d_acontent
            g_flex_gap = m_flexgap
            if d_flexgap >= 0:
                g_flex_gap = d_flexgap
            g_flex_rowgap = m_rowgap
            if d_rowgap >= 0:
                g_flex_rowgap = d_rowgap
            g_flex_wrap = m_flexwrap
            if d_flexwrap != 0:
                g_flex_wrap = d_flexwrap
            # display:grid arms the grid track model; resolve grid-template-columns
            # (and grid-template-rows) from the cascade winner (m_gtc[]/m_gtr[])
            # then override with the inline style (d_gtc[]/d_gtr[]) into the carried
            # g_grid_enc/g_grid_n (columns) and g_grid_renc/g_grid_rn (rows).
            if g_eff_disp == 6:
                g_flex_grid = 1
                # grid-auto-flow winner (m_gaflow; inline d_gaflow overrides). bit0
                # = column axis, bit1 = dense packing; 0 = row-major sparse (default).
                gaf: int32 = m_gaflow
                if d_gaflow != 0:
                    gaf = d_gaflow
                if gaf != 0:
                    if (gaf & 1) != 0:
                        g_flex_colflow = 1
                    if (gaf & 2) != 0:
                        g_flex_dense = 1
                gi: int32 = 0
                if m_gtcn > 0:
                    while gi < m_gtcn and gi < GRID_MAXTRACK:
                        g_grid_enc[gi] = m_gtc[gi]
                        gi = gi + 1
                    g_grid_n = m_gtcn
                if d_gtcn > 0:
                    gi = 0
                    while gi < d_gtcn and gi < GRID_MAXTRACK:
                        g_grid_enc[gi] = d_gtc[gi]
                        gi = gi + 1
                    g_grid_n = d_gtcn
                gj: int32 = 0
                if m_gtrn > 0:
                    while gj < m_gtrn and gj < GRID_MAXTRACK:
                        g_grid_renc[gj] = m_gtr[gj]
                        gj = gj + 1
                    g_grid_rn = m_gtrn
                if d_gtrn > 0:
                    gj = 0
                    while gj < d_gtrn and gj < GRID_MAXTRACK:
                        g_grid_renc[gj] = d_gtr[gj]
                        gj = gj + 1
                    g_grid_rn = d_gtrn
                # grid-auto-rows: resolve the winner (m_gar; inline d_gar overrides)
                # to a FIXED px height for implicit rows. Only the px form (enc >= 0)
                # carries a height; fr/auto auto-rows (enc < 0) stay content-sized.
                if m_garn != 0 and m_gar >= 0:
                    g_grid_gar = m_gar
                if d_garn != 0:
                    if d_gar >= 0:
                        g_grid_gar = d_gar
                    else:
                        g_grid_gar = 0
                # grid-template-areas: capture the container's named-area map
                # (cascade winner, then inline override) into the carried globals.
                if m_gan > 0:
                    g_gareas_n = m_gan
                    g_gareas_cols = m_gacols
                    gak: int32 = 0
                    while gak < m_gan and gak < GRID_MAXAREA:
                        g_gareas_name[gak] = m_ga_name[gak]
                        g_gareas_r0[gak]   = m_ga_r0[gak]
                        g_gareas_c0[gak]   = m_ga_c0[gak]
                        g_gareas_rsp[gak]  = m_ga_rsp[gak]
                        g_gareas_csp[gak]  = m_ga_csp[gak]
                        gak = gak + 1
                if d_gan > 0:
                    g_gareas_n = d_gan
                    g_gareas_cols = d_gacols
                    gak2: int32 = 0
                    while gak2 < d_gan and gak2 < GRID_MAXAREA:
                        g_gareas_name[gak2] = d_ga_name[gak2]
                        g_gareas_r0[gak2]   = d_ga_r0[gak2]
                        g_gareas_c0[gak2]   = d_ga_c0[gak2]
                        g_gareas_rsp[gak2]  = d_ga_rsp[gak2]
                        g_gareas_csp[gak2]  = d_ga_csp[gak2]
                        gak2 = gak2 + 1
                # If grid-template-columns was absent but the areas template
                # implies a column count, synthesise that many equal 1fr tracks so
                # named-area placement has real track x-positions to land on.
                if g_grid_n == 0 and g_gareas_cols > 0:
                    gnc: int32 = g_gareas_cols
                    if gnc > GRID_MAXTRACK:
                        gnc = GRID_MAXTRACK
                    gci2: int32 = 0
                    while gci2 < gnc:
                        g_grid_enc[gci2] = -1              # 1fr
                        gci2 = gci2 + 1
                    g_grid_n = gnc
                # Likewise synthesise content-sized rows from the area row count
                # when grid-template-rows is absent, so multi-row areas can span.
                if g_grid_rn == 0 and g_gareas_n > 0:
                    grmax: int32 = 0
                    gar: int32 = 0
                    while gar < g_gareas_n:
                        re2: int32 = g_gareas_r0[gar] + g_gareas_rsp[gar]
                        if re2 > grmax:
                            grmax = re2
                        gar = gar + 1
                    if grmax > GRID_MAXTRACK:
                        grmax = GRID_MAXTRACK
                    grr: int32 = 0
                    while grr < grmax:
                        g_grid_renc[grr] = -1             # content-sized row
                        grr = grr + 1
                    g_grid_rn = grmax
            # grid-column line placement is a per-ITEM property (carried on the
            # child, not the container): resolve span/start from the cascade winner
            # then the inline style into g_grid_cspan/g_grid_cstart, read by the
            # grid item-open path. Default span 1 / auto start when unset.
            if m_gcspan != 0:
                g_grid_cspan = m_gcspan
            if m_gcstart != 0:
                g_grid_cstart = m_gcstart
            if d_gcspan != 0:
                g_grid_cspan = d_gcspan
            if d_gcstart != 0:
                g_grid_cstart = d_gcstart
            # grid-row (the ROW analogue): same cascade-then-inline resolution into
            # g_grid_rspan/g_grid_rstart, read by the 2-D auto-placement path.
            if m_grspan != 0:
                g_grid_rspan = m_grspan
            if m_grstart != 0:
                g_grid_rstart = m_grstart
            if d_grspan != 0:
                g_grid_rspan = d_grspan
            if d_grstart != 0:
                g_grid_rstart = d_grstart
            # grid-area: NAME (per-ITEM). Carry the interned name (cascade winner,
            # then inline override); resolved against the container frame's area
            # map at grid item placement.
            if m_gareaname >= 0:
                g_grid_areaname = m_gareaname
            if d_gareaname >= 0:
                g_grid_areaname = d_gareaname
            g_treat_as_block = _generic_block_wanted(np, nlen)
            # A flex-item <button> carrying an <svg>/<img> ICON (google's "AI
            # Mode" chip) is a compact control, NOT a text CTA: keep it on the
            # compact [ label ] button branch (which skips the icon markup and
            # draws one centred chip) instead of the block-CTA path, where the
            # icon spans leak as flow text and the box balloons to several rows.
            if g_treat_as_block != 0 and \
               _hx_name_eq(np, nlen, cast[Ptr[uint8]]("button")) != 0 and \
               _button_has_icon_from(te + 1) != 0:
                g_treat_as_block = 0
            # display:inline-block on an inline-level tag flows as an inline box
            # (chip/badge/pill) INSTEAD of blockifying into its own full-width row.
            # EXCEPTION: a DIRECT child of an active flex container is a flex ITEM,
            # whose `display` is BLOCKIFIED per CSS Flexbox §4 (inline-block ->
            # block-level flex column). Keep it on the block / flex-column path so a
            # `flex-grow:1` spacer with `display:inline-block` (google's `.AorTac`
            # between the top-left About/Store links and the right-aligned app-grid
            # cluster) still consumes the row's free space instead of shrinking to
            # its content and dropping the cluster into normal flow below the logo.
            if g_eff_disp == 4 and _inlb_tag(np, nlen) != 0 and \
               _flex_item_col(el_sp) < 0:
                g_inlb = 1
                g_treat_as_block = 0
            # CSS 9.7: `position:absolute`/`fixed` BLOCKIFIES the element and takes
            # it OUT OF FLOW. An inline element (a `<span>` badge) must therefore
            # route through the generic-block path so the fpos==2 handler registers
            # + anchors it — instead of staying inline and painting its label at the
            # static top-LEFT position (the "top-left badge" bug) where it also
            # consumes inline advance that pushes the following heading (the clip).
            # Overrides display:inline / inline-block; relative (fpos!=2) is untouched.
            epos_bk: int32 = m_pos
            if d_pos != 0:
                epos_bk = d_pos
            if epos_bk == 2:
                g_treat_as_block = 1
                g_inlb = 0
            # FLEX-ITEM explicit width (danluu date column): an inline-default
            # DIRECT child of a `li{display:flex}` carrying an explicit CSS
            # `width` is a flex item — CSS blockifies it, so its width IS honoured
            # (a plain inline box would ignore width and let the date abut the
            # title). Route it through the inline-block path, which reserves the
            # width as a fixed column. Only when it would otherwise stay inline
            # (not already block / inline-block / positioned).
            if g_flexli_active != 0 and el_sp == g_flexli_depth + 1 and \
               g_treat_as_block == 0 and g_inlb == 0 and \
               (m_wd >= 0 or d_wd >= 0):
                g_inlb = 1
            if g_treat_as_block != 0 and gblk_sp < GBLK_MAX:
                gblk_stack[gblk_sp] = el_sp
                gblk_sp = gblk_sp + 1
            # CSS ::before/::after generated content (W3C round 4): emit ::before
            # now (inline, at the head of the element's content) and resolve the
            # ::after string while the element's attributes are still in view, to
            # be emitted by _gencontent_close() at the matching close tag. A no-op
            # when the page has no ::before/::after rules (gc_present == 0).
            _gencontent_open(np, nlen, ne, te)
    else:
        if is_void == 0:
            # A close tag has no style="" to re-read; recognise the matching
            # generic-block / inline-block close by el-stack depth (pushed at
            # open) so it takes the SAME close path as its open.
            if inlb_sp > 0 and inlb_eldepth[inlb_sp - 1] == el_sp:
                g_inlb = 1
            elif gblk_sp > 0 and gblk_stack[gblk_sp - 1] == el_sp:
                g_treat_as_block = 1
                gblk_sp = gblk_sp - 1
            _gencontent_close()          # CSS ::after generated content (round 4)
            _el_pop(np, nlen)

    # <body>/<html>: a page-level background (gap #3) fills the WHOLE viewport,
    # not just element boxes, so the pixel renderer clears the canvas to it. The
    # body's text COLOUR is also pushed so it inherits to descendants (a dark
    # theme needs both bg AND colour). No box/paragraph break is emitted.
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("body")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("html")) != 0:
        _word_flush()
        is_body_el: int32 = _hx_name_eq(np, nlen, cast[Ptr[uint8]]("body"))
        if is_close == 0:
            bcol: int32 = m_col
            ibc: int32 = _tag_color(ne, te)
            if ibc >= 0:
                bcol = ibc
            bbg: int32 = m_bg
            ibb: int32 = _tag_bgcolor(ne, te)
            if ibb >= 0:
                bbg = ibb
            if bbg >= 0:
                g_page_bg = bbg
            _color_push(bcol)
            # Honour an explicit `body { margin }` that overrides the UA 8px body
            # margin (CONTENT_X): shift the base content column so a common
            # `body{margin:0}` renders the page flush left (matching Firefox/
            # Chrome) instead of inset by the built-in default. Only fires when the
            # author set a margin-left that differs from the UA default.
            if is_body_el != 0 and m_ml >= 0 and m_ml != CONTENT_X:
                _blk_indent_push(m_ml - CONTENT_X)
                g_body_ml_pushed = 1
                pen_x = indent_x
            # …and its RIGHT margin: widen the page content-box right edge so a
            # full-bleed body spans to the window edge (nav bars, wide prose that
            # would otherwise wrap one word early). Only when narrower than the UA
            # default and the page drives its own layout is left unchanged.
            if is_body_el != 0 and m_mr >= 0 and m_mr < CONTENT_X:
                g_page_right_max = bw - m_mr
                blk_right_cur = g_page_right_max
                g_body_mr_widened = 1
        else:
            _color_pop()
            if is_body_el != 0 and g_body_ml_pushed != 0:
                _blk_indent_pop()
                g_body_ml_pushed = 0
                pen_x = indent_x
            if is_body_el != 0 and g_body_mr_widened != 0:
                g_page_right_max = _content_right()
                blk_right_cur = _content_right()
                g_body_mr_widened = 0
        _style_break()
        return

    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("br")) != 0:
        _word_flush()
        _newline()
        return
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("hr")) != 0:
        # A horizontal rule owns its own otherwise-empty visual row.
        _word_flush()
        _soft_newline()
        if cur_row < MAX_ROWS:
            row_rule[cur_row] = 2                     # 2 = <hr> full-width rule
        _bump_row()
        pen_x = indent_x
        row_dirty = 0
        need_space = 0
        return
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("blockquote")) != 0:
        _word_flush()
        if is_close == 0:
            _soft_newline()
            bq_depth = bq_depth + 1
            _recompute_indent()
            # Latch this level's accent-bar geometry: top row = the first quoted
            # row, bar x = the gutter between the outer margin and the indented
            # text (indent_x already includes this level's BQ_INDENT).
            if bq_depth <= BQ_STACK_CAP:
                bq_srow_st[bq_depth - 1]  = cast[int32](cur_row)
                bq_barlx_st[bq_depth - 1] = indent_x - BQ_INDENT + 2
            # UA default: quoted text renders in a muted grey (author style can
            # still override — _open_style pushes on top of this default).
            _color_push(0x5a5a5a)
            _open_style(ne, te)
        else:
            _word_flush()
            # Paint the left accent bar down this quote's full row span.
            if bq_depth >= 1 and bq_depth <= BQ_STACK_CAP and n_bfills < BFILL_MAX:
                bsrow: int32 = bq_srow_st[bq_depth - 1]
                bbot: int32 = cast[int32](cur_row)
                if row_dirty != 0:
                    bbot = bbot + 1
                if bbot > bsrow:
                    blx: int32 = bq_barlx_st[bq_depth - 1]
                    bfill_lx[n_bfills]  = blx
                    bfill_rx[n_bfills]  = blx + BQ_BAR_W
                    bfill_top[n_bfills] = bsrow
                    bfill_bot[n_bfills] = bbot
                    bfill_rgb[n_bfills] = BQ_BAR_RGB
                    bfill_z[n_bfills]   = 0
                    bfill_rad[n_bfills] = 0
                    bfill_filter[n_bfills] = 0
                    bfill_bord[n_bfills] = -1
                    n_bfills = n_bfills + 1
            if bq_depth > 0:
                bq_depth = bq_depth - 1
            _recompute_indent()
            _close_style()
            _color_pop()
            _para_break()
        pen_x = indent_x
        _style_break()
        return
    if g_inlb != 0:
        # display:inline-block chip/badge/pill: an inline-level box in the line
        # grid (flows + wraps), not a full-width block row.
        if is_close == 0:
            _inlb_open(ne, te, np, nlen)
        else:
            _inlb_close(np, nlen)
        return
    if (_hx_name_eq(np, nlen, cast[Ptr[uint8]]("span")) != 0 or \
        _hx_name_eq(np, nlen, cast[Ptr[uint8]]("font")) != 0) and \
       g_treat_as_block == 0:
        # Inline colour-bearing element: no layout effect, only colour(s). A
        # `display:block`/flex span (or a span that is a flex item) instead
        # falls through to the block-box branch below (g_treat_as_block set).
        _word_flush()
        if is_close == 0:
            _open_style(ne, te)
            # Inline horizontal margins (spaced nav tabs / margined links): apply
            # margin-left here; stash margin-right for the matching close. Threaded
            # into the pixel flow via g_pending_lmarg so the gap survives reflow.
            sml: int32 = 0
            if m_ml >= 0:
                sml = m_ml
            if d_ml >= 0:
                sml = d_ml
            smr: int32 = 0
            if m_mr >= 0:
                smr = m_mr
            if d_mr >= 0:
                smr = d_mr
            if sml > 0:
                g_pending_lmarg = g_pending_lmarg + sml
                pen_x = pen_x + sml
            if inls_sp < INLS_MAX:
                inls_mr[inls_sp] = smr
                inls_sp = inls_sp + 1
        else:
            _close_style()
            if inls_sp > 0:
                inls_sp = inls_sp - 1
                smr2: int32 = inls_mr[inls_sp]
                if smr2 > 0:
                    g_pending_lmarg = g_pending_lmarg + smr2
                    pen_x = pen_x + smr2
        _style_break()
        return
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("p")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("div")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figure")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figcaption")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("address")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("aside")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("section")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("article")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("header")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("footer")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("main")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("nav")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("center")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("fieldset")) != 0 or \
       g_treat_as_block != 0:
        _word_flush()
        if is_close == 0:
            _soft_newline()
            _open_style(ne, te)              # runs cascade (m_*) + inline (d_*)
            # merge the box model: inline wins over the stylesheet per axis.
            fleft: int32 = 0
            if m_ml >= 0:
                fleft = m_ml
            if d_ml >= 0:
                fleft = d_ml
            frins: int32 = 0
            if m_mr >= 0:
                frins = m_mr
            if d_mr >= 0:
                frins = d_mr
            fwd: int32 = -1
            if m_wd >= 0:
                fwd = m_wd
            if d_wd >= 0:
                fwd = d_wd
            ftop: int32 = 0
            if m_mt >= 0:
                ftop = m_mt
            if d_mt >= 0:
                ftop = d_mt
            fbot: int32 = 0
            if m_mb >= 0:
                fbot = m_mb
            if d_mb >= 0:
                fbot = d_mb
            fbord: int32 = 0
            if m_bd >= 0:
                fbord = m_bd
            if d_bd >= 0:
                fbord = d_bd
            # <fieldset> carries a UA-default border (browsers stroke a groove
            # frame around the grouped controls). Draw one unless a stylesheet
            # explicitly set border:none (m_bd/d_bd == 0).
            if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("fieldset")) != 0 and \
               m_bd != 0 and d_bd != 0:
                fbord = 1
                # UA-default vertical padding (browsers inset the grouped controls
                # from the frame by ~0.35em block-start/end). Now that a bordered box
                # no longer reserves a whole top-rule row for its 1px rule (the border
                # is stroked AT the content-box top), a fieldset with NO author padding
                # would let its first line hug/cross the top border. Reserve a real
                # per-edge pady (baked into the first/last content row via bbox_padv)
                # so the frame keeps Chrome's breathing room around the group. Only
                # when the author set none (m_pady/d_pady <= 0); an authored padding
                # wins unchanged.
                if m_pady <= 0 and d_pady <= 0:
                    m_pady = 14
            # effective element background (inline wins over the sheet): fed to
            # the box open so its close paints the WHOLE box rectangle. The inline
            # value comes from _tag_bgcolor (NOT d_bg — that scratch holds the
            # last-parsed stylesheet rule's bg and would leak onto every box).
            fbg: int32 = m_bg
            ibg: int32 = _tag_bgcolor(ne, te)
            if ibg >= 0:
                fbg = ibg
            # <button> reaching the generic-block path is a flex-item CTA: give it
            # the UA push-button face — a button-grey fill + a 1px border — unless
            # the author styled them, and PUSH the button-grey as the effective
            # background so the LABEL run also paints on the face. The label's
            # seg-bg is drawn in the TEXT pass (above every block background), so
            # the button reads as a filled push-button even when it sits inside a
            # coloured nav bar whose own fill would otherwise paint over the block
            # box's background. (Click/submit dispatch is the DOM/event layer's job.)
            if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("button")) != 0:
                if fbg < 0:
                    fbg = FORM_BTN_BG
                if m_bd < 0 and d_bd < 0:
                    fbord = 1
                _bg_push(fbg)
            # CSS centred block: `width/max-width` + auto side margins. Compute
            # the left offset that centres the box in its parent's content width
            # and fold it into fleft (the canonical `main { max-width:Npx;
            # margin:0 auto }` article column — the most common modern layout).
            fcenter: int32 = m_center
            if d_center != 0:
                fcenter = 1
            if fcenter != 0 and fwd >= 0:
                pr_c: int32 = blk_right_cur
                if pr_c <= 0:
                    pr_c = _content_right()
                extra_c: int32 = (pr_c - indent_x) - fwd
                if extra_c > 0:
                    fleft = extra_c / 2
                    frins = extra_c / 2
            ffloat: int32 = 0
            if m_float != 0:
                ffloat = m_float
            if d_float != 0:
                ffloat = d_float
            fdisp: int32 = m_disp
            if d_disp != 0:
                fdisp = d_disp
            # CSS position: mode + the four edge offsets (inline over sheet).
            fpos: int32 = m_pos
            if d_pos != 0:
                fpos = d_pos
            # position sub-kind (1 fixed / 2 sticky) travels with the winning
            # `position` value so the layout resolver can pin fixed to the
            # viewport / apply sticky's scroll-threshold pin.
            fposfx: int32 = m_posfx
            if d_pos != 0:
                fposfx = d_posfx
            # APP-SHELL LANDMARK FLOAT: on a semantic page (g_doc_has_main), a
            # chrome side-region (<nav>/<aside>, role=navigation/complementary/
            # search) that PRECEDES <main> is normally placed beside the article
            # column by grid/flex/absolute CSS — which often lives in an external
            # stylesheet the engine never fetched. Without it the region stacks in
            # document order ABOVE <main>, burying the article. Float it into a
            # fixed-width LEFT gutter so <main> flows up beside it. Only when the
            # element is not already floated / positioned / a flex context, and is
            # not itself <main>. Gated on g_doc_has_main so pages with no <main>
            # landmark render byte-identically.
            # NOT inside the page <header> masthead (g_header_depth == 0): a nav
            # in the header is a full-width top bar, not a side sidebar — floating
            # its (CSS-less, expanded) mega-menu into a 240px gutter overlaps the
            # article (MDN, BBC). Only a standalone side-region is floated.
            if ffloat == 0 and g_doc_has_main != 0 and g_seen_main == 0 and \
               g_header_depth == 0 and \
               fpos == 0 and fdisp != 2 and fdisp != 6 and \
               _hx_name_eq(np, nlen, cast[Ptr[uint8]]("main")) == 0 and \
               _is_landmark_side(np, nlen, ne, te) != 0:
                ffloat = 1                            # float:left
                if fwd < 0 or fwd > SIDEBAR_W:
                    fwd = SIDEBAR_W
            # Latch that the main landmark has opened (<main> element or a
            # role="main" container): side-regions AFTER it are ordinary in-flow
            # blocks (already positioned after the chrome), never floated.
            if g_seen_main == 0:
                is_main_lm: int32 = 0
                if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("main")) != 0:
                    is_main_lm = 1
                elif _hx_find_attr(ne, te, cast[Ptr[uint8]]("role")) != 0 and \
                     _srcword_is(g_attr_start, cast[Ptr[uint8]]("main")) != 0:
                    is_main_lm = 1
                if is_main_lm != 0:
                    g_seen_main = 1
            ptopv: int32 = m_top
            if d_top >= 0:
                ptopv = d_top
            pleftv: int32 = m_left
            if d_left >= 0:
                pleftv = d_left
            prightv: int32 = m_right
            if d_right >= 0:
                prightv = d_right
            pbotv: int32 = m_bottom
            if d_bottom >= 0:
                pbotv = d_bottom
            # z-index (inline over sheet); ZIDX_UNSET/auto stacks at 0.
            pzv: int32 = m_zidx
            if d_zidx != ZIDX_UNSET:
                pzv = d_zidx
            if pzv == ZIDX_UNSET:
                pzv = 0
            # Containing block for an `absolute` child = nearest positioned
            # ancestor's top-left/right, or the page content box.
            cbx: int32 = CONTENT_X
            cbr: int32 = _content_right()
            cbrow: int32 = 0
            # `fixed` ignores positioned ancestors: its containing block is the
            # VIEWPORT (page content box, top row 0). Only `absolute` resolves
            # against the nearest positioned ancestor.
            if posctx_sp > 0 and fposfx != 1:
                cbx   = posctx_x[posctx_sp - 1]
                cbr   = posctx_rt[posctx_sp - 1]
                cbrow = posctx_row[posctx_sp - 1]
            ps_before: int32 = cast[int32](n_segs)
            if fpos == 2:
                # ABSOLUTE: out of flow. Lay the box out on a fresh line, register
                # its run, then (on close) rewind cur_row so siblings reclaim the
                # space and _apply_positioned relocates the segments.
                abs_ret: int32 = cast[int32](cur_row)
                _soft_newline()
                row_dirty = 0
                # OUT OF FLOW: mark this box's whole subtree so its segments paint
                # at their own absolute x and never flow into (push) a sibling that
                # shares their static row. Balanced in _hx_block_close (was_pos==2).
                abs_flow_depth = abs_flow_depth + 1
                runa: int32 = _register_pos(ps_before, 2, fposfx, cbx, cbr, cbrow, \
                                            pleftv, ptopv, prightv, pbotv, pzv)
                # No explicit width -> the abs box shrink-to-fits its content
                # (CSS 10.3.7). Flag it so _apply_positioned narrows the box's own
                # background fill to its content width before right/bottom anchoring.
                if runa >= 0 and fwd < 0:
                    pos_wauto[runa] = 1
                _block_box_open(fleft, frins, fwd, 0, 0, fbord, fbg)
                aidx: int32 = box_sp - 1
                if aidx >= 0:
                    box_pos_stack[aidx]     = 2
                    box_posrun_stack[aidx]  = runa
                    box_pretrow_stack[aidx] = abs_ret
                    box_pushedctx_stack[aidx] = 1
                apadr: int32 = 0
                if aidx >= 0:
                    apadr = box_padx_stack[aidx] / 2
                _posctx_push(indent_x, blk_right_cur, cast[int32](cur_row), apadr)
                if fdisp == 2 or fdisp == 6:
                    if _flex_container_open(te + 1, el_sp) != 0:
                        idxa: int32 = box_sp - 1
                        if idxa >= 0:
                            box_flexcont_stack[idxa] = 1
            else:
                # A direct-child block of an active flex container becomes a
                # COLUMN: pinned to its column x, equal share of the row width,
                # tops aligned (cur_row rewound to the container top). This takes
                # priority over a float on the same element.
                fcol: int32 = _flex_item_col(el_sp)
                is_item: int32 = 0
                if fcol >= 0:
                    top: int32 = flex_sp - 1
                    coloff: int32 = fcol * flex_gap[top]
                    ccw: int32 = flex_colw[top]
                    if flex_grid[top] != 0:
                        # grid-area: NAME resolution — if this item names an area the
                        # container declared, resolve it to an EXPLICIT rectangle
                        # (0-based start row/col + spans) and drive the normal
                        # explicit-placement path below (which occupies the map and
                        # positions the item at the row's track origin).
                        if g_grid_areaname >= 0:
                            gax: int32 = 0
                            while gax < flex_gan[top]:
                                if flex_ga_name[top * GRID_MAXAREA + gax] == \
                                   g_grid_areaname:
                                    g_grid_cstart = \
                                        flex_ga_c0[top * GRID_MAXAREA + gax] + 1
                                    g_grid_rstart = \
                                        flex_ga_r0[top * GRID_MAXAREA + gax] + 1
                                    g_grid_cspan = \
                                        flex_ga_csp[top * GRID_MAXAREA + gax]
                                    g_grid_rspan = \
                                        flex_ga_rsp[top * GRID_MAXAREA + gax]
                                    break
                                gax = gax + 1
                        # GRID placement: place this item at the auto-flow cursor
                        # (flex_gcur = next free track) OR at its explicit
                        # grid-column start line; it OCCUPIES `span` tracks (its box
                        # width covers them + the internal column-gaps). When the
                        # auto-flow span won't fit the remaining tracks the item
                        # wraps to a new grid ROW (advancing flex_growidx, applying
                        # any grid-template-rows fixed height for that row).
                        nt2: int32 = flex_ntrack[top]
                        gbase: int32 = top * FLEX_MAX
                        sp0: int32 = g_grid_cspan
                        if sp0 < 1:
                            sp0 = 1
                        if sp0 > nt2:
                            sp0 = nt2
                        # grid-row span: how many ROWS the item's rectangle covers.
                        rs0: int32 = g_grid_rspan
                        if rs0 < 1:
                            rs0 = 1
                        if rs0 > GRID_MAXROW:
                            rs0 = GRID_MAXROW
                        # explicit 1-based grid-row start -> 0-based (-1 == auto).
                        erow: int32 = -1
                        if g_grid_rstart >= 1:
                            erow = g_grid_rstart - 1
                        cur: int32 = flex_gcur[top]
                        gcol: int32 = cur
                        # grid-auto-flow: dense / column. ONLY for a fully AUTO-placed
                        # item (no explicit grid-column AND no explicit grid-row):
                        # explicit placement is unaffected. Column flow needs a known
                        # grid-template-rows count (else it degrades to row flow).
                        auto_place: int32 = 0
                        if g_grid_cstart < 1 and erow < 0:
                            auto_place = 1
                        handled: int32 = 0
                        if auto_place != 0 and flex_colflow[top] != 0 and \
                           flex_gridrn[top] > 0:
                            pk: int32 = _grid_find_colmajor(top, nt2, \
                                                            flex_gridrn[top], sp0, rs0)
                            grc: int32 = pk / GRID_MAXTRACK
                            gcol = pk % GRID_MAXTRACK
                            _grid_occupy_rect(top, grc, gcol, sp0, rs0)
                            cur_row = cast[uint64](flex_top_row[top] + \
                                                   _grid_row_top_rows(top, grc))
                            handled = 1
                        elif auto_place != 0 and flex_dense[top] != 0:
                            pk2: int32 = _grid_find_dense(top, nt2, sp0, rs0)
                            grd: int32 = pk2 / GRID_MAXTRACK
                            gcol = pk2 % GRID_MAXTRACK
                            _grid_occupy_rect(top, grd, gcol, sp0, rs0)
                            cur_row = cast[uint64](flex_top_row[top] + \
                                                   _grid_row_top_rows(top, grd))
                            handled = 1
                        if handled != 0:
                            pass
                        elif erow >= 0 or rs0 > 1:
                            # ---- 2-D placement: an explicit grid-row and/or a row
                            # SPAN. Reserve the item's whole (rows x cols) rectangle
                            # in the occupancy map so auto-flow siblings route around
                            # it, and position it at the row's fixed-track origin.
                            # Explicit placement does NOT advance the auto cursor.
                            grow: int32 = flex_growidx[top]
                            if erow >= 0:
                                grow = erow
                            if grow < 0:
                                grow = 0
                            if g_grid_cstart >= 1:
                                gcol = g_grid_cstart - 1
                                if gcol < 0:
                                    gcol = 0
                                if gcol + sp0 > nt2:
                                    gcol = nt2 - sp0
                                if gcol < 0:
                                    gcol = 0
                            else:
                                # first column in `grow` whose rectangle is free.
                                gcol = 0
                                while gcol + sp0 <= nt2 and \
                                      _grid_rect_free(top, grow, gcol, sp0, rs0) == 0:
                                    gcol = gcol + 1
                                if gcol + sp0 > nt2:
                                    gcol = 0
                            _grid_occupy_rect(top, grow, gcol, sp0, rs0)
                            cur_row = cast[uint64](flex_top_row[top] + \
                                                   _grid_row_top_rows(top, grow))
                        else:
                            # ---- 1-D column auto-flow / explicit column. Now
                            # consults the occupancy map, so it flows around any
                            # cells a spanning sibling reserved (a no-op — hence
                            # byte-identical — when nothing was reserved ahead).
                            if g_grid_cstart >= 1:
                                # explicit start line (1-based); clamp into the row.
                                gcol = g_grid_cstart - 1
                                if gcol < 0:
                                    gcol = 0
                                if gcol + sp0 > nt2:
                                    gcol = nt2 - sp0
                                if gcol < 0:
                                    gcol = 0
                            else:
                                # walk cells row-major: wrap on overflow, skip any
                                # cell a span already filled.
                                while (cur + sp0 > nt2) or \
                                      _grid_rect_free(top, flex_growidx[top], \
                                                      cur, sp0, 1) == 0:
                                    if cur + sp0 > nt2:
                                        _grid_wrap_row(top)      # next grid ROW
                                        cur = 0
                                    else:
                                        cur = cur + 1            # skip filled cell
                                gcol = cur
                            _grid_occupy_rect(top, flex_growidx[top], gcol, sp0, 1)
                            cur_row = cast[uint64](flex_line_top[top])
                            flex_gcur[top] = gcol + sp0
                        et: int32 = gcol + sp0 - 1
                        if et >= nt2:
                            et = nt2 - 1
                        coloff = flex_child_x[gbase + gcol]
                        ccw = flex_child_x[gbase + et] + flex_child_w[gbase + et] \
                              - coloff
                    elif flex_wrap_on[top] != 0 and flex_wrap_reloc[top] != 0:
                        # DEFERRED RELOCATE: order / width:100% wrap frame. Emit this
                        # item on its OWN provisional vertical band (stacked below the
                        # previous one) at its PRE-PLANNED target x (flex_it_tx); the
                        # container close shifts it up/down to its real visual line.
                        cwR: int32 = flex_meas_w[fcol]
                        if flex_wpct100[fcol] != 0:
                            cwR = flex_avail[top]             # width:100% -> full line
                        elif fwd >= 0:
                            cwR = fwd
                        if cwR > flex_avail[top]:             # clamp over-measure
                            cwR = flex_avail[top]
                        if cwR < CELL_W:
                            cwR = CELL_W
                        if flex_next[top] > 0:
                            # fresh band below the previous item (row-gap = 0 default)
                            flex_line_top[top] = flex_line_bot[top] + flex_rowgap[top]
                            flex_line_bot[top] = flex_line_top[top]
                        coloff = flex_it_tx[top * FLEX_MAX + fcol]
                        ccw = cwR
                        cur_row = cast[uint64](flex_line_top[top])
                    elif flex_wrap_on[top] != 0:
                        # ONLINE wrap: this item's box width is its resolved CSS
                        # `width` (cards) or its pre-measured natural content width
                        # (nav pills). Start a new line when it no longer fits.
                        cw: int32 = flex_meas_w[fcol]
                        # `cw` is the CONTENT width handed to _block_box_open (which
                        # draws the padding OUTWARD); `cwbox` is the BORDER-box width
                        # the line cursor must step by. _flex_measure_children +
                        # _flex_grow_scan already folded padding/border into the
                        # measured widths, but an item with an explicit CSS `width`
                        # replaced that with the bare content width and then stepped
                        # the cursor by it — so a padded card row overlapped by
                        # exactly its padding (`.card{width:240px;padding:20px}` in a
                        # wrapping row advanced 260px per card while painting each
                        # 288px wide). Chrome steps 300px there (280 border-box + the
                        # 20px gap). Re-add the item's own horizontal padding+border
                        # for the cursor only; box-sizing:border-box has already been
                        # resolved out of m_wd, so this is the used border-box size.
                        cwbox: int32 = cw
                        if fwd >= 0:
                            cw = fwd
                            cwbox = fwd
                            fpbx: int32 = 0
                            if m_padx > 0:
                                fpbx = fpbx + m_padx
                            if d_padx > 0:
                                fpbx = d_padx
                            if m_bordw > 0:
                                fpbx = fpbx + 2 * m_bordw
                            cwbox = cwbox + fpbx
                        if cw < CELL_W:
                            cw = CELL_W
                        if cwbox < cw:
                            cwbox = cw
                        if flex_cur_x[top] > 0 and \
                           flex_cur_x[top] + cwbox > flex_avail[top]:
                            # New flex line: drop below the previous line's bottom
                            # plus the container's row-gap (0 when unset).
                            flex_line_top[top] = flex_line_bot[top] + flex_rowgap[top]
                            flex_line_bot[top] = flex_line_top[top]
                            flex_cur_x[top] = 0
                        coloff = flex_cur_x[top]
                        ccw = cw
                        flex_cur_x[top] = flex_cur_x[top] + cwbox + flex_rawgap[top]
                        cur_row = cast[uint64](flex_line_top[top])
                    elif flex_natural[top] != 0:
                        coloff = flex_child_x[top * FLEX_MAX + fcol]
                        ccw = flex_child_w[top * FLEX_MAX + fcol]
                        cur_row = cast[uint64](flex_top_row[top])
                    elif flex_iscol[top] != 0:
                        # flex-direction:column — item STACKS below the previous
                        # sibling (do NOT rewind cur_row; _flex_item_close left it at
                        # the previous item's bottom). Cross size = full container
                        # width (align-items:stretch default) unless the item sets an
                        # explicit CSS width. coloff stays at the container left.
                        coloff = 0
                        ccw = flex_colw[top]
                        if fwd >= 0:
                            ccw = fwd
                        if ccw < CELL_W:
                            ccw = CELL_W
                    else:
                        cur_row = cast[uint64](flex_top_row[top])
                    pen_x = indent_x
                    row_dirty = 0
                    need_space = 0
                    # A flex item is pinned to the container's cross-start (cur_row
                    # was rewound to flex_top_row), but its OWN padding-top (folded
                    # into ftop by the cascade's _box_add_t, alongside any margin-top)
                    # must still inset its content DOWNWARD from that edge — Chrome
                    # insets a `.main{padding:20px..}` column 20px below the container
                    # top. Passing ftop (was 0) restores that top inset; it stays 0,
                    # hence byte-identical, for a flex item with no top margin/padding.
                    # ROUND-11: flag this as a flex/grid item so the box-open KEEPS the
                    # folded padding-top as a quantised vgap (this inset) rather than
                    # stripping it for the borderless-padding bake (plain blocks only).
                    g_open_is_flexitem = 1
                    _block_box_open(coloff, 0, ccw, ftop, fbot, fbord, fbg)
                    is_item = 1
                    # PIXEL-flow: a flex item is placed at an ABSOLUTE column x
                    # (coloff), not inline from the previous item's edge. The
                    # proportional pixel reflow (lib/htmlpage) otherwise glues the
                    # items together ("HomeDocsAbout") because it flows text
                    # contiguously. Tag this item's FIRST text segment with the
                    # snap-forward `indjump` flag so the reflow pen jumps to the
                    # column x (seg_x) — justifying nav links to the right past a
                    # grown `flex:1` spacer and honouring inter-item margins/gaps.
                    # Text-harness output is unaffected (indjump is pixel-only).
                    _pending_indjump = 1
                    g_flex_item_depth = g_flex_item_depth + 1
                    # Arm the flex nowrap guard ONLY for a CONTENT-SIZED natural-path
                    # item: its resolved track (ccw) is at least its measured
                    # max-content (flex_meas_w) so text fits on one line and must not
                    # split between words under the proportional measure hook (nav
                    # pills). A `flex:1` card shrunk BELOW its content (ccw < natural)
                    # is left unarmed, so its body text wraps to the card width.
                    pushed_nowrap: int32 = 0
                    if flex_natural[top] != 0 and ccw >= flex_meas_w[fcol]:
                        g_flex_nowrap_depth = g_flex_nowrap_depth + 1
                        pushed_nowrap = 1
                    idx0: int32 = box_sp - 1
                    if idx0 >= 0:
                        box_flexitem_stack[idx0] = 1
                        box_flexnowrap_stack[idx0] = pushed_nowrap
                    # Cross-axis fixup bookkeeping: remember where this item's emitted
                    # segs/fills/borders begin and which line row it sits on, so the
                    # container close can shift them (align-items >= center) AND so a
                    # grid/wrap ROW bottom can be measured from the item's real border-
                    # box bottom rather than the overshooting cur_row (see
                    # _flex_item_close). Recorded for every flex/grid item — the extra
                    # four stores are cheap and harmless when the fixup never runs.
                    fidx0: int32 = top * FLEX_MAX + fcol
                    flex_it_seg0[fidx0] = cast[int32](n_segs)
                    flex_it_bf0[fidx0]  = n_bfills
                    flex_it_bx0[fidx0]  = n_bboxes
                    flex_it_ltop[fidx0] = cast[int32](cur_row)
                if is_item == 0:
                    floated: int32 = 0
                    if ffloat != 0:
                        floated = _float_box_open(ffloat, fwd, ftop, fbot, fbord, fbg)
                    if floated == 0:
                        _block_box_open(fleft, frins, fwd, ftop, fbot, fbord, fbg)
                # This block itself declares display:flex/grid -> arm a flex row /
                # grid over its direct block children (its box is already open).
                if fdisp == 2 or fdisp == 6:
                    if _flex_container_open(te + 1, el_sp) != 0:
                        idx1: int32 = box_sp - 1
                        if idx1 >= 0:
                            box_flexcont_stack[idx1] = 1
                # A blockified <a> that reached this generic-block path keeps
                # its href + link colour so the anchor is still clickable/blue.
                # This covers BOTH a flex-item <a> column (navbar link) AND a
                # non-flex `display:block` link (a stacked docs sidebar): the
                # dedicated <a> handler is bypassed, so re-add the link scope
                # here for either. A flex-item <li> column simply drops its
                # bullet (the li handler is bypassed) — the list-style:none shape.
                if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("a")) != 0:
                    g_link = _capture_href(ne, te)
                    g_link_rgb = _own_color(ne, te)
                    # POINTER HIT: remember that this open block box IS an
                    # anchor, so its close registers the whole padded box as a
                    # clickable rect (Chrome's hit area for a blockified <a>) —
                    # not just the glyph run the text-segment scan covers.
                    aidx: int32 = box_sp - 1
                    if aidx >= 0:
                        box_link_stack[aidx] = g_link
                # RELATIVE: stays in flow; register its run + a positioning
                # context so absolute descendants resolve against it.
                if fpos == 1:
                    runr: int32 = _register_pos(ps_before, 1, fposfx, cbx, cbr, cbrow, \
                                                pleftv, ptopv, prightv, pbotv, pzv)
                    ridx: int32 = box_sp - 1
                    if ridx >= 0:
                        box_pos_stack[ridx]     = 1
                        box_posrun_stack[ridx]  = runr
                        box_pushedctx_stack[ridx] = 1
                        _posctx_push(indent_x, blk_right_cur, \
                                     box_srow_stack[ridx], \
                                     box_padx_stack[ridx] / 2)
            # A <p> is now open — remember it so a following block start tag with
            # an omitted </p> synthesises the close (_hx_implicit_close_p).
            if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("p")) != 0:
                p_open = 1
            # Latch a <p>/<figure> author margin-bottom so its close honours the real
            # px instead of a flat UA row (see g_p_mb).
            if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("p")) != 0 or \
               _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figure")) != 0:
                g_p_mb = -1
                if m_mb >= 0:
                    g_p_mb = m_mb
                if d_mb >= 0:
                    g_p_mb = d_mb
        else:
            # Paragraph-like blocks (<p>/<figure>) emit a UA vertical-margin gap;
            # structural containers (<div>/<section>/<article>/<header>/<footer>/
            # <main>/<nav>/<aside>/<figcaption>/<address>/<fieldset> and any
            # display:block-ified inline) do NOT — their spacing comes only from
            # explicit CSS margins, so bare containers stack flush (no phantom row).
            pgap: int32 = 0
            if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("p")) != 0 or \
               _hx_name_eq(np, nlen, cast[Ptr[uint8]]("figure")) != 0:
                # Honour the paragraph's OWN author margin-bottom (latched at open):
                # an explicit small/zero margin quantises to no UA row (card body text
                # sits flush against the badge, matching Chrome), while an unstyled
                # paragraph keeps its default 1-row breathing space.
