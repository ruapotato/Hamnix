    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("select")) != 0:
        _word_flush()
        if is_close == 0:
            save_bg_sel: int32 = g_bg
            _close_seg()                               # isolate the control seg
            if g_bg < 0:
                g_bg = FORM_FIELD_BG
            _word_push(91)                             # '['
            _word_push(32)
            sn: int32 = _select_text(te + 1)
            sel_content: int32 = 0
            if sn > 0:
                _wpush_cstr(&fbuf[0])
                sel_content = sn
            _word_push(32)
            _word_push(118)                           # 'v' (text/gate view only)
            _word_push(93)                            # ']'
            _word_flush()
            # commit as a select field segment so the pixel renderer draws a real
            # bordered drop-down box (option text + ▼) instead of the bracket ASCII.
            _mark_select_seg(sel_content)
            g_bg = save_bg_sel
            _el_pop(np, nlen)                          # balance the pushed scope
            _enter_skip(np, nlen)
        return
    # <progress value max>: draw a REAL determinate progress bar — a rounded track
    # with the value fraction filled in the cascaded accent-color (seg_field kind
    # 6). The '[####----]' glyphs are kept for the text/gate view; the painter
    # skips them. The element is non-void so its cascade already ran (m_accent /
    # inline d_accent are current). The fallback body (`70%`) is SKIPPED so it does
    # not double-render. value/max default to 0/100 (0% empty bar).
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("progress")) != 0:
        _word_flush()
        if is_close == 0:
            pacc: int32 = m_accent
            if d_accent >= 0:                          # inline style="" overrides
                pacc = d_accent
            pmax: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("max"), 100)
            if pmax <= 0:
                pmax = 100
            pval: int32 = _attr_int(ne, te, cast[Ptr[uint8]]("value"), 0)
            ppct: int32 = pval * 100 / pmax
            if ppct < 0:
                ppct = 0
            if ppct > 100:
                ppct = 100
            _word_push(91)                             # '['
            pfi: int32 = 0
            while pfi < 8:
                if pfi * 100 / 8 < ppct:
                    _word_push(35)                     # '#' filled cell
                else:
                    _word_push(45)                     # '-' empty cell
                pfi = pfi + 1
            _word_push(93)                             # ']'
            _word_flush()
            _mark_check_seg(6, ppct, pacc)             # pixel renderer draws the bar
            _el_pop(np, nlen)                          # balance the pushed scope
            _enter_skip(np, nlen)
        return
    # <option>/<label>/<form>/<fieldset>/<legend>: no direct box — options are
    # consumed by <select>; label/form/fieldset are transparent containers whose
    # inner text flows normally (handled by the unknown-tag fallthrough).
    # Unknown tag: ignore it, keep surrounding text.
    return


