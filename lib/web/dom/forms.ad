    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("pre")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("code")) != 0:
        is_pre: int32 = _hx_name_eq(np, nlen, cast[Ptr[uint8]]("pre"))
        _word_flush()
        if is_pre != 0:
            if is_close == 0:
                _soft_newline()
                pre_mode = 1
                _bg_push(CODE_BG)              # light code-block background
            else:
                _bg_pop()
                pre_mode = 0
                _para_break()
