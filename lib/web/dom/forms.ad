            # style stack balanced. Then open THIS item's own class/inline cascade
            # (colour, text-decoration:line-through, font-weight, …) so it applies
            # to the item's run — matching how <p>/<blockquote> route through
            # _open_style. Only when this is a real list level so the flag write
            # and the balancing close/open stay in bounds.
            lvl0: int32 = list_depth - 1
