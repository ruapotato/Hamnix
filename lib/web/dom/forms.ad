            btn_appear: int32 = _control_appear()
            btn_rows: int32 = _control_height_rows()
            bcs: uint64 = te + 1
            bce: uint64 = bcs
            while bce < src_len:
                if src_ptr[bce] == 60 and bce + 1 < src_len and \
                   src_ptr[bce + 1] == 47 and \
                   _tagname_is(bce + 2, cast[Ptr[uint8]]("button")) != 0:
                    break
