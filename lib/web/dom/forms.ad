        else:
            _close_style()
            _deco_pop()
        _style_break()
        return
    # <s>/<del>/<strike>: strike-through (line through the run's x-height).
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("s")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("del")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("strike")) != 0:
        _word_flush()
        if is_close == 0:
            g_strike_n = g_strike_n + 1
            _open_style(ne, te)
        else:
            _close_style()
            if g_strike_n > 0:
                g_strike_n = g_strike_n - 1
        _style_break()
        return
