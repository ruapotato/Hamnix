    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("dt")) != 0:
        _word_flush()
        if is_close == 0:
            _hx_dl_close_item()      # implicit close of a previous <dt>/<dd>
            _soft_newline()
            g_bold_n = g_bold_n + 1
            dl_item = 1
        else:
            if g_bold_n > 0:
                g_bold_n = g_bold_n - 1
            _soft_newline()
            dl_item = 0
        pen_x = indent_x
        _style_break()
        return
    # <dd>: definition — on its own line, indented ~40px (browser default).
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("dd")) != 0:
        _word_flush()
        if is_close == 0:
