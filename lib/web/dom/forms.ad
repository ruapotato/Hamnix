                    if d_mt >= 0:
                        li_mtop = d_mt
                    li_mbot: int32 = 0
                    if m_mb >= 0:
                        li_mbot = m_mb
                    if d_mb >= 0:
                        li_mbot = d_mb
                    li_gap: int32 = li_mtop
                    if li_mbot > li_gap:
