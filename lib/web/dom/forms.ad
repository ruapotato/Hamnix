            # open) as real px instead of a flat 1-row para break. An authored small
            # margin (h3{margin:0 0 6px 0}) quantises to 0 rows — the heading glues to
            # the next block at Chrome's pitch rather than stranding a whole LINE_H row
            # (the over-tall card h3->p gap). No author margin keeps the UA 1-row gap.
            hmb: int32 = g_head_mb
            g_head_mb = -1
