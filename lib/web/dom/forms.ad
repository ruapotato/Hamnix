    # text-decoration:none still strips it.
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("u")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("ins")) != 0:
        _word_flush()
        if is_close == 0:
            _deco_push(1)                    # 1 = underline
