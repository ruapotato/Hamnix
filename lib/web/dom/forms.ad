        cell_bx_lx    = col_x[cc]
        cell_bx_rx    = col_x[endc]
        cell_bx_srow  = cast[int32](cur_row)
        cell_border   = 0
        cell_bg       = -1
        cell_bd_rgb   = CELL_BD_RGB
