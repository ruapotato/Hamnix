    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("b")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("strong")) != 0:
        _word_flush()
        if is_close == 0:
            g_bold_n = g_bold_n + 1
        else:
            if g_bold_n > 0:
                g_bold_n = g_bold_n - 1
        _style_break()
        return
    if _hx_name_eq(np, nlen, cast[Ptr[uint8]]("i")) != 0 or \
       _hx_name_eq(np, nlen, cast[Ptr[uint8]]("em")) != 0:
