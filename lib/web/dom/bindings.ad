# History API (window.history) + Location — self-contained browser globals real
# SPAs/routers depend on. pushState/replaceState mutate the session history +
# current-entry state; back/forward/go walk the index and fire a `popstate`
# event carrying event.state. __setLocation is a host test hook that parses a
# URL into location's components (the headless engine has no live navigation).
NID_HIST_PUSH:    int32 = 62         # history.pushState(state, title[, url])
NID_HIST_REPLACE: int32 = 63         # history.replaceState(state, title[, url])
NID_HIST_BACK:    int32 = 64         # history.back()
NID_HIST_FORWARD: int32 = 65         # history.forward()
NID_HIST_GO:      int32 = 66         # history.go(delta)
NID_SET_LOCATION: int32 = 67         # __setLocation(url) — parse a URL into location
NID_LOC_ASSIGN:   int32 = 68         # location.assign(url) / location.replace(url)
NID_LOC_TOSTRING: int32 = 69         # location.toString() / valueOf -> href
NID_LOC_RELOAD:   int32 = 70         # location.reload() (headless no-op)
NID_CV_DRAWIMAGE: int32 = 71         # ctx.drawImage(img, dx, dy[, dw, dh])
NID_CV_RECT:      int32 = 72         # ctx.rect(x, y, w, h)
