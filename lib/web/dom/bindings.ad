NID_CV_LINGRAD:    int32 = 81        # ctx.createLinearGradient(x0,y0,x1,y1)
NID_CV_RADGRAD:    int32 = 82        # ctx.createRadialGradient(x0,y0,r0,x1,y1,r1)
NID_CV_ADDSTOP:    int32 = 83        # gradient.addColorStop(offset, color)
NID_CV_GETIMGDATA: int32 = 84        # ctx.getImageData(x,y,w,h)
NID_CV_PUTIMGDATA: int32 = 85        # ctx.putImageData(imgData, dx, dy)
NID_CV_CREATEIMGDATA: int32 = 86     # ctx.createImageData(w,h) | (imagedata)
# --- Observer APIs (MutationObserver / IntersectionObserver / ResizeObserver) ---
# The three observer surfaces modern frameworks depend on. Callbacks are
# delivered as MICROTASKS via the shared JS microtask queue (queueMicrotask),
# so a MutationObserver batch fires once AFTER the mutating script (matching the
# spec's microtask-checkpoint delivery). IntersectionObserver/ResizeObserver
# deliver ONCE after the (single, headless) layout — there is no live scroll /
# resize loop in the headless single-layout render model (see observers section
# in canvas.ad + docs/browser_w3c_conformance.md).
NID_MO_CTOR:      int32 = 87         # new MutationObserver(callback)
NID_MO_OBSERVE:   int32 = 88         # mutationObserver.observe(target, options)
NID_MO_DISCONNECT: int32 = 89        # mutationObserver.disconnect()
NID_MO_TAKEREC:   int32 = 90         # mutationObserver.takeRecords()
NID_IO_CTOR:      int32 = 91         # new IntersectionObserver(callback[, options])
NID_IO_OBSERVE:   int32 = 92         # intersectionObserver.observe(el)
NID_IO_UNOBSERVE: int32 = 93         # intersectionObserver.unobserve(el)
NID_IO_DISCONNECT: int32 = 94        # intersectionObserver.disconnect()
NID_RO_CTOR:      int32 = 95         # new ResizeObserver(callback)
NID_RO_OBSERVE:   int32 = 96         # resizeObserver.observe(el)
NID_RO_UNOBSERVE: int32 = 97         # resizeObserver.unobserve(el)
NID_RO_DISCONNECT: int32 = 98        # resizeObserver.disconnect()
NID_OBS_DELIVER:  int32 = 99         # microtask body: flush queued observer callbacks
# window.matchMedia(query) — returns a MediaQueryList whose `.matches` is the
# LIVE evaluation of the query against the viewport (same evaluator as @media).
# In the headless single-render model the query never re-fires, so the listener
# registration methods (add/removeListener, add/removeEventListener, dispatchEvent)
# accept their args and are best-effort no-ops (documented static-render scope).
NID_MATCHMEDIA:   int32 = 100        # window.matchMedia(query) -> MediaQueryList
NID_MQL_NOOP:     int32 = 101        # MediaQueryList listener methods (no-op)
# --- CSSOM runtime stylesheet mutation (browser campaign: JS-driven reveal) ---
# The APIs real pages use to inject/change style rules at runtime, wired into the
# same rule table the cascade reads so a mutation re-cascades on the next layout.
NID_SS_INSERTRULE: int32 = 102       # sheet.insertRule(ruleText[, index]) -> index
NID_SS_DELETERULE: int32 = 103       # sheet.deleteRule(index)
NID_SS_REPLACESYNC: int32 = 104      # sheet.replaceSync(cssText)  (constructible)
NID_SS_REPLACE:    int32 = 105       # sheet.replace(cssText) -> Promise<sheet>
NID_CSSSHEET_CTOR: int32 = 106       # new CSSStyleSheet([{...}]) -> constructible sheet
# --- CSS Font Loading API (document.fonts : FontFaceSet) ---------------------
# Real pages call document.fonts.load()/ready/check() during init (e.g. google's
# emoji-font probe). Headless has all fonts synchronously "available", so load()
# and ready resolve immediately and check() is always true.
NID_FONTS_LOAD:   int32 = 107        # document.fonts.load(font[, text]) -> Promise<FontFace[]>
NID_FONTS_CHECK:  int32 = 108        # document.fonts.check(font[, text]) -> true
NID_FONTS_NOOP:   int32 = 109        # add/delete/clear/forEach -> undefined (no-op)
# --- Framework-mount primitives (real React 18 / Vue / Angular mount path) ----
# The set `ReactDOM.createRoot()` + the first commit demand and that the engine
# did not have: node factories for the non-element node types, the namespaced
# element factory, the CSSOM setProperty/getPropertyValue/removeProperty trio
# React uses for custom properties and `display:none !important`, and the
# MessageChannel React 18's scheduler picks as its macrotask primitive.
NID_CREATECOMMENT: int32 = 112       # document.createComment(data) -> Comment (nodeType 8)
NID_CREATEFRAG:   int32 = 113        # document.createDocumentFragment() -> nodeType 11
NID_CREATE_NS:    int32 = 114        # document.createElementNS(ns, tag)
NID_STYLE_SETPROP: int32 = 115       # style.setProperty(name, value[, priority])
NID_STYLE_GETPROP: int32 = 116       # style.getPropertyValue(name)
NID_STYLE_REMPROP: int32 = 117       # style.removeProperty(name)
NID_MSGCHANNEL:   int32 = 118        # new MessageChannel() -> {port1, port2}
NID_MSGPORT_POST: int32 = 119        # port.postMessage(data) -> deliver to the peer
NID_MSGPORT_NOOP: int32 = 120        # port.start() / port.close() -> undefined
NID_NODE_CTOR:    int32 = 121        # Node/Element/... — interface objects (never called)
# --- document.cookie ---------------------------------------------------------
# An IDL attribute that CANNOT be a data property: every read re-serialises the
# jar and every write PARSES a Set-Cookie-shaped string. It was missing
# entirely, so `document.cookie` read `undefined` — and MediaWiki's startup does
#     document.cookie.match(/.../)
# which threw "cannot read property 'match' of null or undefined" on BOTH
# en.wikipedia.org and wiki.archlinux.org. Per the IDL it is a DOMString: the
# empty string when the jar is empty, NEVER undefined.
NID_COOKIE_GET:   int32 = 122        # get document.cookie -> "n1=v1; n2=v2"
NID_COOKIE_SET:   int32 = 123        # set document.cookie = "n=v; attrs"
# --- lazy textContent / innerHTML (round 9) ----------------------------------
# Snapshotting both for every element into one shared 64 KiB arena is what made
# document.body.textContent come back "" on every real page (archlinux: "" vs
# chromium's 6797 chars; react_spa: 0 vs 144092). Sizing the arena for a real
# page is hopeless — the sum over all elements is O(page x depth), ~10 MB for
# one Wikipedia article — so these became LAZY accessors on
# HTMLElement.prototype, computed from the element's source span on first
# access and memoised as an own data property from then on.
NID_TC_GET:       int32 = 124        # get el.textContent (from [cstart,cend))
NID_TC_SET:       int32 = 125        # set el.textContent
NID_IH_GET:       int32 = 126        # get el.innerHTML (raw source span)
NID_IH_SET:       int32 = 127        # set el.innerHTML (parses the fragment)
# Re-entrancy guard: the innerHTML setter runs _apply_inner_html, which itself
# assigns properties on the same node.
g_ih_setter_busy: int32 = 0
# --- lazy style / classList / dataset (round 9) -------------------------------
# Every registered element used to eagerly allocate a CSSStyleDeclaration, a
# DOMTokenList and a dataset object — 3 of the ~5.8 JS objects per element, on
# top of the element itself and its children array. Chrome allocates roughly
# ONE: style/classList/dataset are created on FIRST ACCESS and most elements are
# never touched. Same mechanism as textContent: an accessor pair on
# HTMLElement.prototype that memoises an own data property, so once an element
# IS touched it behaves exactly as before. This is the biggest single relief for
# the property pool (MAX_PROP), which wikipedia alone was consuming 85-90% of.
NID_STYLE_ACC:    int32 = 128        # get el.style      (lazy CSSStyleDeclaration)
NID_STYLE_ACC_SET: int32 = 129       # set el.style
NID_CLS_ACC:      int32 = 130        # get el.classList  (lazy DOMTokenList)
NID_CLS_ACC_SET:  int32 = 131        # set el.classList
NID_DS_ACC:       int32 = 132        # get el.dataset    (lazy, parsed from data-*)
NID_DS_ACC_SET:   int32 = 133        # set el.dataset
# --- LAZY el.children / el.childNodes (2026-07-28) ---------------------------
# _dom_wire_tree installs children/childNodes as own data properties at
# REGISTRATION time — but it returns immediately while tx_built == 0, and
# _js_build_document (which registers document.documentElement/head/body) runs
# BEFORE _dom_build_tree_index. So the three roots every traversal starts from
# were the only elements on the page whose .children was `undefined`; chromium
# answers an HTMLCollection.
#
# Building the tree index FIRST fixes it and is a 600x DISASTER: wiring <body>
# registers every one of its children, each of which re-scans the whole tx
# table, so tests/fixtures/hambrowse_ceilings.html (10 000 flat <i> under
# <body>) went from 0.98 s to 9 m 51 s. MEASURED, not estimated.
#
# So the wiring stays lazy, in the shape style/classList/dataset already use:
# an accessor pair on HTMLElement.prototype that wires the element on FIRST
# ACCESS and memoises through js_set_own, which then shadows the accessor. A
# page that never asks for a root's children pays nothing, and ceilings stays
# at 0.98 s.
NID_KIDS_ACC:     int32 = 144        # get el.children   (wire the tree on demand)
NID_KIDS_ACC_SET: int32 = 145        # set el.children
NID_NODES_ACC:    int32 = 146        # get el.childNodes (wire the tree on demand)
NID_NODES_ACC_SET: int32 = 147       # set el.childNodes
NID_DOMEXC_CTOR:  int32 = 148        # new DOMException(message, name)
NID_CREATEEVENT:  int32 = 149        # document.createEvent(interface) -> uninitialised event
NID_INITEVENT:    int32 = 150        # event.initEvent(type, bubbles, cancelable)
NID_INITCUSTOMEV: int32 = 151        # event.initCustomEvent(type, bubbles, cancelable, detail)
NID_RETVAL_GET:   int32 = 152        # get event.returnValue  (legacy; == !canceled flag)
NID_RETVAL_SET:   int32 = 153        # set event.returnValue  (false cancels a cancelable event)
NID_CANCELBUB_GET: int32 = 154       # get event.cancelBubble (== stop-propagation flag)
NID_CANCELBUB_SET: int32 = 155       # set event.cancelBubble (true sets stop-propagation)
# --- DOMImplementation (round 10) --------------------------------------------
# document.implementation did not exist at all, which is the single largest
# measured hole in the WPT score: DOMImplementation-hasFeature.html alone is 136
# subtests, and ~120 more across dom/nodes/ build their fixtures with
# createHTMLDocument(). hasFeature is spec'd to return TRUE unconditionally
# (https://dom.spec.whatwg.org/#dom-domimplementation-hasfeature) — it is a
# "useless" method the spec keeps only so old feature detection stays truthy.
NID_IMPL_HASFEAT:  int32 = 156       # document.implementation.hasFeature(...) -> true
NID_IMPL_CREHTMLD: int32 = 157       # implementation.createHTMLDocument([title])
NID_IMPL_CREDOC:   int32 = 158       # implementation.createDocument(ns, qname[, doctype])
NID_IMPL_CREDOCT:  int32 = 159       # implementation.createDocumentType(q, pub, sys)
# --- Element.attributes / localName / prefix ---------------------------------
# `attributes` is not just an API gap: testharness.js's format_value() reads
# `val.attributes.length` for EVERY element it prints into a failure message,
# so its absence REPLACED 188 real assertion messages with "cannot read property
# 'length' of null or undefined" (measured 2026-07-29). Lazy accessors, same
# shape as style/classList: a NamedNodeMap is only built when asked for.
NID_ATTRS_ACC:     int32 = 160       # get el.attributes -> NamedNodeMap
NID_ATTRS_ACC_SET: int32 = 161       # set el.attributes
NID_LOCALNAME_ACC: int32 = 162       # get el.localName
NID_LOCALNAME_SET: int32 = 163       # set el.localName
NID_PREFIX_ACC:    int32 = 164       # get el.prefix
NID_PREFIX_SET:    int32 = 165       # set el.prefix
NID_NNM_GETNAMED:  int32 = 166       # attributes.getNamedItem(name)
NID_NNM_ITEM:      int32 = 167       # attributes.item(i)
# --- Namespace-aware attribute API -------------------------------------------
# Modelled the way an HTML document actually behaves: an attribute's QUALIFIED
# name is its key, so setAttributeNS(ns, "x:y", v) stores "x:y" and
# getAttributeNS(ns, "y") finds it. Full per-attribute namespace records are a
# later round; this covers the shape pages and WPT exercise most.
NID_SETATTRNS:     int32 = 168       # element.setAttributeNS(ns, qname, value)
NID_GETATTRNS:     int32 = 169       # element.getAttributeNS(ns, localName)
NID_HASATTRNS:     int32 = 170       # element.hasAttributeNS(ns, localName)
NID_REMATTRNS:     int32 = 171       # element.removeAttributeNS(ns, localName)
NID_GETBYTAGNS:    int32 = 172       # (document|element).getElementsByTagNameNS(ns, local)
# --- ChildNode / ParentNode mutation API -------------------------------------
NID_CN_BEFORE:     int32 = 173       # node.before(...nodes)
NID_CN_AFTER:      int32 = 174       # node.after(...nodes)
NID_CN_REPLWITH:   int32 = 175       # node.replaceWith(...nodes)
NID_PN_PREPEND:    int32 = 176       # parent.prepend(...nodes)
NID_PN_REPLKIDS:   int32 = 187       # parent.replaceChildren(...nodes)
NID_CREATEPI:      int32 = 188       # document.createProcessingInstruction(t,d)
# --- CharacterData (Text / Comment / ProcessingInstruction) ------------------
# data / nodeValue / textContent / length are ONE piece of state, exposed as
# accessors on CharacterData.prototype (an own data property would shadow them
# and let the four drift apart). Offsets are UTF-16 code units, as the DOM
# specifies and as js_str_u16_len / js_str_sub_u16 model them.
NID_CD_DATA_GET:   int32 = 189       # characterData.data / nodeValue / textContent
NID_CD_DATA_SET:   int32 = 190
NID_CD_LEN_GET:    int32 = 191       # characterData.length
NID_CD_LEN_SET:    int32 = 192
NID_CD_SUBSTR:     int32 = 193       # substringData(offset, count)
NID_CD_APPENDD:    int32 = 194       # appendData(data)
NID_CD_INSERTD:    int32 = 195       # insertData(offset, data)
NID_CD_DELETED:    int32 = 196       # deleteData(offset, count)
NID_CD_REPLACED:   int32 = 197       # replaceData(offset, count, data)
NID_TEXT_SPLIT:    int32 = 198       # text.splitText(offset)
NID_TEXT_CTOR:     int32 = 199       # new Text(data)
NID_COMMENT_CTOR:  int32 = 200       # new Comment(data)
# --- Range + Traversal -------------------------------------------------------
# A contiguous block [201..230]; _js_host_dispatch delegates the whole span to
# _rng_dispatch (canvas.ad). Boundary points live as own properties on the JS
# object (startContainer/startOffset/endContainer/endOffset, and
# root/whatToShow/filter/currentNode on the traversal objects), read back via
# js_this() inside each method -- no parallel arrays. The DERIVED attributes
# (collapsed, commonAncestorContainer) are accessors, because they must track
# the boundary points rather than be snapshots.
NID_CREATERANGE:      int32 = 201     # document.createRange() -> Range
NID_RNG_CTOR:         int32 = 202     # new Range()
NID_RNG_SETSTART:     int32 = 203     # range.setStart(node, offset)
NID_RNG_SETEND:       int32 = 204     # range.setEnd(node, offset)
NID_RNG_SETSTARTBEF:  int32 = 205     # range.setStartBefore(node)
NID_RNG_SETSTARTAFT:  int32 = 206     # range.setStartAfter(node)
NID_RNG_SETENDBEF:    int32 = 207     # range.setEndBefore(node)
NID_RNG_SETENDAFT:    int32 = 208     # range.setEndAfter(node)
NID_RNG_SELNODE:      int32 = 209     # range.selectNode(node)
NID_RNG_SELNODECONT:  int32 = 210     # range.selectNodeContents(node)
NID_RNG_COLLAPSE:     int32 = 211     # range.collapse(toStart)
NID_RNG_CLONERANGE:   int32 = 212     # range.cloneRange()
NID_RNG_COMPAREBP:    int32 = 213     # range.compareBoundaryPoints(how, other)
NID_RNG_COMPAREPOINT: int32 = 214     # range.comparePoint(node, offset)
NID_RNG_ISPOINTIN:    int32 = 215     # range.isPointInRange(node, offset)
NID_RNG_INTERSECTS:   int32 = 216     # range.intersectsNode(node)
NID_RNG_INSERTNODE:   int32 = 217     # range.insertNode(node)
NID_RNG_DELETECONT:   int32 = 218     # range.deleteContents()
NID_RNG_DETACH:       int32 = 219     # range.detach() (no-op per modern spec)
NID_RNG_TOSTRING:     int32 = 220     # range.toString()
NID_RNG_COLLAPSED:    int32 = 221     # range.collapsed getter
NID_RNG_CAC:          int32 = 222     # range.commonAncestorContainer getter
NID_RNG_RO_SET:       int32 = 223     # shared no-op setter for the two above
NID_STATICRANGE_CTOR: int32 = 224     # new StaticRange(init)
# TreeWalker / NodeIterator
NID_CREATETW:         int32 = 225     # document.createTreeWalker(root, show, f)
NID_CREATENI:         int32 = 226     # document.createNodeIterator(root, show, f)
NID_TW_PARENT:        int32 = 227     # walker.parentNode()
NID_TW_FIRSTCHILD:    int32 = 228     # walker.firstChild()
NID_TW_LASTCHILD:     int32 = 229     # walker.lastChild()
NID_TW_NEXTSIB:       int32 = 230     # walker.nextSibling()
NID_TW_PREVSIB:       int32 = 231     # walker.previousSibling()
NID_TW_NEXTNODE:      int32 = 232     # walker.nextNode()
NID_TW_PREVNODE:      int32 = 233     # walker.previousNode()
NID_NI_NEXTNODE:      int32 = 234     # iterator.nextNode()
NID_NI_PREVNODE:      int32 = 235     # iterator.previousNode()
NID_NI_DETACH:        int32 = 236     # iterator.detach() (no-op per modern spec)
# --- LAZY node-level traversal (2026-07-30) ----------------------------------
# firstChild / lastChild / previousSibling / nextSibling are NODE-level: with
# source text nodes in the tree they no longer equal their *Element* twins, and
# answering them means materialising the parent's child-NODE list. That list
# costs a JS object and a string per text run, so it must be built for the
# elements a script actually traverses from and no others — the same accessor
# shape NID_KIDS_ACC already uses, and for the same measured reason: wiring it
# eagerly at registration exhausted the string pool outright on
# tests/fixtures/hambrowse_ceilings.html (9000 flat <i> under <body>).
NID_FCH_ACC:      int32 = 237        # get el.firstChild
NID_FCH_ACC_SET:  int32 = 238        # set el.firstChild
NID_LCH_ACC:      int32 = 239        # get el.lastChild
NID_LCH_ACC_SET:  int32 = 240        # set el.lastChild
NID_PSIB_ACC:     int32 = 241        # get el.previousSibling
NID_PSIB_ACC_SET: int32 = 242        # set el.previousSibling
NID_NSIB_ACC:     int32 = 243        # get el.nextSibling
NID_NSIB_ACC_SET: int32 = 244        # set el.nextSibling
# HTML "named access on the Window object": an id in the document is a global.
# Answered only after ordinary scope lookup misses (see g_named_lookup_nid).
NID_NAMED_GLOBAL: int32 = 245        # resolve a bare identifier as an element id
# --- Attr as a real node (2026-07-30) ----------------------------------------
# element.attributes already hands back Attr nodes; the FACTORY and the
# node-valued getters were missing, and WPT counts them: 49 subtests on
# "createAttribute is not a function" and 33 on "getAttributeNode is not a
# function", across Document-createAttribute / attributes / Range-attribute-nodes.
NID_CREATEATTR:   int32 = 246        # document.createAttribute(localName)
NID_CREATEATTRNS: int32 = 247        # document.createAttributeNS(ns, qualifiedName)
NID_GETATTRNODE:  int32 = 248        # element.getAttributeNode(name)
NID_GETATTRNODENS: int32 = 249       # element.getAttributeNodeNS(ns, localName)
# --- constructable event subclasses (round 11) -------------------------------
# UIEvent / FocusEvent / CompositionEvent / WheelEvent were previously wired to
# NID_EVENT_CTOR, which minted a PLAIN Event: `new UIEvent(...) instanceof
# UIEvent` was false and none of the interface's dictionary members existed.
# Each now has its own native so _make_event knows which interface's dictionary
# to read (dom/events/Event-subclasses-constructors.html).
NID_UIEVENT:      int32 = 250        # new UIEvent(type, {view, detail})
NID_FOCUSEVENT:   int32 = 251        # new FocusEvent(type, {relatedTarget, ...})
NID_COMPEVENT:    int32 = 252        # new CompositionEvent(type, {data, ...})
NID_WHEELEVENT:   int32 = 253        # new WheelEvent(type, {deltaX, ...})
NID_CREATEATTR_XML: int32 = 254      # xmlDoc.createAttribute(name) — case-PRESERVING
# --- AbortController / AbortSignal -------------------------------------------
NID_ABORTCTRL:    int32 = 255        # new AbortController()
NID_ABORT:        int32 = 256        # controller.abort([reason])
NID_ABORT_THROW:  int32 = 257        # signal.throwIfAborted()
# --- HTMLStyleElement.sheet / HTMLLinkElement.sheet --------------------------
# `<style>` elements PRESENT IN THE SOURCE get an own `sheet` data property
# stamped by _build_stylesheets. Elements a SCRIPT made
# (document.createElement('style'), or a <template>'s content cloned into the
# document) never went through that walk, so `style.sheet` was undefined and
# every one of the ~10 css/css-cascade files — all of which set up with
# `createElement('style'); style.textContent = …; main.append(style)` — died on
# line 1 of every subtest with "cannot read property 'rules' of null".
#
# This is an ACCESSOR on HTMLElement.prototype, deliberately, and not another
# stamp at another creation site: the parsed-vs-created split has now produced
# the same class of bug three times (textContent, cloneNode, and this), and an
# accessor that derives the answer from the element's CURRENT state cannot go
# stale or miss a creation path. It returns null for any tag that is not
# <style>, which is what chromium does, so `if (el.sheet)` still discriminates.
NID_SHEET_ACC:    int32 = 258        # get el.sheet
NID_SHEET_ACC_S:  int32 = 259        # set el.sheet (polyfill escape hatch)
# --- document.currentScript --------------------------------------------------
# An ACCESSOR, not a stamped value, and the reason is a measured one.
# Registering the executing <script> eagerly cost 8,189 element registrations
# on a 9,000-element page: _dom_register_el wires the new node's parent, and
# wiring <body> materialises its ENTIRE child list. That blew through DOM_MAX
# before the page's own first getElementById ran, and `#e0` — the FIRST element
# in the document — came back undefined. currentScript is read by a small
# minority of scripts; no page should pay a full-tree registration for a
# property it never touches. Resolved from a saved source offset on read.
NID_CURSCRIPT_ACC: int32 = 260       # get document.currentScript
NID_CURSCRIPT_SET: int32 = 261       # set document.currentScript (inert)
# element.insertAdjacentElement(position, element) / insertAdjacentText(pos, s).
# The HTML-string sibling of these, insertAdjacentHTML, has been here since
# round 4 (NID_INSADJ); the two NODE forms were simply absent, so
# dom/nodes/insert-adjacent.html scored 1 of 14 with 13 "is not a function".
NID_INSADJ_EL:     int32 = 262       # element.insertAdjacentElement(pos, el)
NID_INSADJ_TXT:    int32 = 263       # element.insertAdjacentText(pos, data)
# document.createCDATASection(data) and `new Document()`.
#
# WHY THESE TWO TOGETHER. tests/wpt/tests/dom/common.js -- the shared setup for
# every dom/ranges/ and dom/traversal/ file -- does:
#     const xmlDocument = new Document();
#     paras[5].appendChild(xmlDocument.createCDATASection("1234"));
# `Document` was a bare NID_NODE_CTOR interface stub, so `new Document()`
# produced an EMPTY object with Document.prototype and no factories on it, and
# the very next line threw "createCDATASection is not a function" at file
# scope. That threw before a single test() was registered, so THIRTY files
# reported zero subtests -- not zero passes, zero results. Two missing members,
# thirty whole files.
NID_CREATECDATA:   int32 = 264       # document.createCDATASection(data)
NID_DOCUMENT_CTOR: int32 = 265       # new Document() -> XML document
NID_CREATE_XML:    int32 = 177       # xmlDoc.createElement(tag) — case-PRESERVING
# --- Node.prototype generics (round 10) --------------------------------------
# Live on Node.prototype (see _attach_node_natives), so EVERY node type carries
# them, not just elements.
NID_HASKIDS:       int32 = 178       # node.hasChildNodes()
NID_NORMALIZE:     int32 = 179       # node.normalize()
NID_ISEQUAL:       int32 = 180       # node.isEqualNode(other)
NID_ISSAME:        int32 = 181       # node.isSameNode(other)
NID_CMPDOCPOS:     int32 = 182       # node.compareDocumentPosition(other)
NID_GETROOTNODE:   int32 = 183       # node.getRootNode()
NID_LOOKUPNSURI:   int32 = 184       # node.lookupNamespaceURI(prefix)
NID_LOOKUPPREFIX:  int32 = 185       # node.lookupPrefix(ns)
NID_ISDEFAULTNS:   int32 = 186       # node.isDefaultNamespace(ns)
#      (187 is NID_PN_REPLKIDS, declared with the rest of the ParentNode set)
# --- OFF-INTERFACE FEATURE DETECTION (round 9) -------------------------------
# getContext / checkValidity / reportValidity / setCustomValidity / submit were
# attached to HTMLElement.prototype and therefore resolved TRUTHY on every
# element, including <div>. Real pages feature-detect with exactly these
# (`if (el.getContext)`, `if (el.checkValidity)`) and silently took the wrong
# branch. VERIFIED against chromium --headless on f/input/select/textarea/
# button/fieldset/output/canvas/div/img/a:
#   checkValidity, reportValidity -> form input select textarea button fieldset output
#   setCustomValidity             -> the same MINUS form
#   submit                        -> form only
#   getContext                    -> canvas only
# They stay ONE copy on the prototype (no per-tag prototypes, no extra objects
# per element) by becoming accessors that return the native fn for a matching
# tag and undefined otherwise. Each has a setter so a polyfill can still assign
# over it, as it can in a browser.
NID_F_GETCTX:     int32 = 134
NID_F_CV:         int32 = 135
NID_F_RV:         int32 = 136
NID_F_SCV:        int32 = 137
NID_F_SUBMIT:     int32 = 138
NID_F_GETCTX_S:   int32 = 139
NID_F_CV_S:       int32 = 140
NID_F_RV_S:       int32 = 141
NID_F_SCV_S:      int32 = 142
NID_F_SUBMIT_S:   int32 = 143

# The cookie jar. Document-lifetime only (there is no persistent cookie store on
# the host/native render path); name/value bytes are bump-allocated into ck_buf,
# so re-writing the same cookie many times churns the buffer and eventually
# stops taking new writes rather than corrupting anything.
CK_MAX:      int32 = 64
CK_BUF_CAP:  int32 = 8192
ck_name_off: Array[64, int32]
ck_name_len: Array[64, int32]
ck_val_off:  Array[64, int32]
ck_val_len:  Array[64, int32]
ck_dead:     Array[64, uint8]        # 1 = deleted (max-age<=0 / expires in the past)
ck_buf:      Array[8192, uint8]
ck_buf_len:  int32 = 0
ck_n:        int32 = 0
ck_in:       Array[8192, uint8]      # setter argument scratch
ck_out:      Array[8192, uint8]      # getter serialisation scratch

# ---- DOM interface objects (Node, Element, HTMLElement, …) ------------------
# Real frameworks feature-detect and branch on these THREE ways: `typeof Element`,
# `Node.ELEMENT_NODE`, and `x instanceof Node`. The first two are just globals;
# the third needs the instance's [[Prototype]] to reach the constructor's
# `.prototype`, so every node object the engine mints is linked into this chain:
#
#   element  -> HTMLElement.prototype -> Element.prototype -> Node.prototype
#   text     -> Text.prototype        -> CharacterData.prototype -> Node.prototype
#   comment  -> Comment.prototype     -> CharacterData.prototype -> Node.prototype
#   fragment -> DocumentFragment.prototype -> Node.prototype
#   document -> Document.prototype    -> Node.prototype
#
# The prototypes stay EMPTY (the methods remain own properties on each node, as
# before) so this is purely an identity/branding change: nothing moves, nothing
# is enumerated differently (v_new_object's note: for-in walks own props only).
g_proto_style: int32 = 0             # CSSStyleDeclaration.prototype (el.style links here)
g_proto_clslist: int32 = 0           # DOMTokenList.prototype (el.classList links here)
g_proto_node:  int32 = 0             # Node.prototype
g_proto_elem:  int32 = 0             # HTMLElement.prototype (elements link here)
g_proto_text:  int32 = 0             # Text.prototype
g_proto_comm:  int32 = 0             # Comment.prototype
g_proto_frag:  int32 = 0             # DocumentFragment.prototype
g_proto_doc:   int32 = 0             # Document.prototype
g_proto_doctype: int32 = 0           # DocumentType.prototype
g_proto_impl:  int32 = 0             # DOMImplementation.prototype
g_proto_attr:  int32 = 0             # Attr.prototype
g_proto_pi:    int32 = 0             # ProcessingInstruction.prototype
g_proto_cdata: int32 = 0             # CDATASection.prototype (extends Text)
g_proto_range: int32 = 0             # Range.prototype (createRange() links here)
g_proto_tw:    int32 = 0             # TreeWalker.prototype
g_proto_ni:    int32 = 0             # NodeIterator.prototype
g_nodefilter:  int32 = 0             # the global NodeFilter constants object
g_proto_nnm:   int32 = 0             # NamedNodeMap.prototype
g_proto_evtgt: int32 = 0             # EventTarget.prototype (root of Node)
g_proto_nodelist: int32 = 0          # NodeList.prototype (chains Array.prototype)
g_proto_htmlcoll: int32 = 0          # HTMLCollection.prototype (ditto)
g_proto_abortsig: int32 = 0          # AbortSignal.prototype
g_proto_abortctl: int32 = 0          # AbortController.prototype
g_proto_html:  int32 = 0             # HTMLHtmlElement.prototype
g_proto_head:  int32 = 0             # HTMLHeadElement.prototype
g_proto_body:  int32 = 0             # HTMLBodyElement.prototype
g_proto_title: int32 = 0             # HTMLTitleElement.prototype
g_proto_domexc: int32 = 0            # DOMException.prototype
g_domexc_ctor: int32 = 0             # the DOMException constructor VALUE. Kept so a
                                     # thrown exception can carry `constructor`:
                                     # testharness's assert_throws_dom ends by
                                     # checking `e.constructor === self.DOMException`
                                     # to prove the error came from this global.
# Per-interface Event prototype objects, indexed by createEvent/_make_event
# `flavor` (0 Event, 1 CustomEvent, 2 MouseEvent, 3 KeyboardEvent, 4 UIEvent,
# 5.. the legacy-createEvent-only interfaces). document.createEvent must brand
# each created event with EXACTLY window[iface].prototype, so we stash the same
# object handle here that we handed the global constructor.
g_ev_proto: Array[16, int32]

# Event.timeStamp cursor. This engine has no wall clock (see date.ad: Date.now()
# is a monotonic counter, deliberately, so renders stay byte-identical), but
# timeStamp must still ADVANCE: WPT's Event-timestamp-safe-resolution spins
# `do { e2 = new MouseEvent(...) } while (e2.timeStamp - e1.timeStamp == 0)`,
# which never terminates against a constant. One tick per constructed event, in
# units of 5 microseconds — the coarsest resolution the same test will accept
# (it asserts the estimated resolution is >= 5us, i.e. NOT better than that).
g_ev_ts_tick: int32 = 0

# getElementsByClassName's argument, copied out of the JS string scratch before
# the element walk (which calls back into the JS API and would clobber it).
gbc_arg: Array[1024, uint8]

# Node.textContent accumulator (see _node_text_content). One buffer, refilled
# per read; 64 KiB is the same ceiling the innerHTML serialiser works to.
TC_CAP: int32 = 65535
tc_buf: Array[65536, uint8]
tc_n: int32 = 0

# close-tag scan results
g_close_lt:  uint64 = 0
g_close_end: uint64 = 0
# element-scan results: anchor '<', content span, tag-name span
g_el_lt: uint64 = 0
g_el_cs: uint64 = 0
g_el_ce: uint64 = 0
g_el_ns: uint64 = 0
g_el_nl: uint64 = 0


def _dom_reset():
    dom_n = 0
    dom_warn_max = 0
    dom_warn_txt = 0
    dom_warn_evl = 0
    dom_warn_tx = 0
    dom_idbuf_len = 0
    dom_txt_len = 0
    dom_ov_len = 0
    dom_n_overrides = 0
    dom_title_len = 0
    dom_title_present = 0
    js_con_len = 0
    js_had_error = 0
    js_ctx_live = 0
    ap_n = 0
    cre_n = 0
    cc_n = 0
    stx_n = 0
    dom_warn_stx = 0
    rw_len = 0
    g_ser_mode = 0
    g_dom_mutated = 0
    sattr_n = 0
    sattr_buf_len = 0
    clsown_n = 0
    dsown_n = 0
    implown_n = 0
    attrc_n = 0
    attrc_next = 0
    g_attr_gen = 1
    ihc_n = 0
    ihc_next = 0
    g_dom_gen = 1
    nsa_n = 0
    dom_warn_cre = 0
    nsa_buf_len = 0
    ddi: int32 = 0
    while ddi < DOM_MAX:
        dom_detached[ddi] = 0
        ddi = ddi + 1
    dom_nav_len = 0
    dom_nav_present = 0
    dom_nav_method = 0
    dom_body_len = 0
    dom_customval_top = 0
    dcvi: int32 = 0
    while dcvi < 64:
        dom_customval_len[dcvi] = 0
        dcvi = dcvi + 1
    g_prevent_default = 0
    g_stop_prop = 0
    g_stop_immediate = 0
    g_cur_passive = 0
    g_cur_event = -1
    evl_n = 0
    evt_tybuf_len = 0
    canv_n = 0
    tx_n = 0
    tx_built = 0
    ck_n = 0
    ck_buf_len = 0
    # the DOM interface objects are per-JS-context (js_init wipes the heap), so
    # drop the cached prototype handles; _js_build_document re-mints them.
    g_proto_node = 0
    g_proto_elem = 0
    g_proto_style = 0
    g_proto_clslist = 0
    g_proto_text = 0
    g_proto_comm = 0
    g_proto_frag = 0
    g_proto_doc = 0
    g_proto_doctype = 0
    g_proto_impl = 0
    g_proto_attr = 0
    g_proto_pi = 0
    g_proto_cdata = 0
    g_proto_range = 0
    g_proto_tw = 0
    g_proto_ni = 0
    g_nodefilter = 0
    g_proto_nnm = 0
    g_proto_evtgt = 0
    g_proto_nodelist = 0
    g_proto_htmlcoll = 0
    g_proto_abortsig = 0
    g_proto_abortctl = 0
    g_ev_ts_tick = 0
    g_proto_html = 0
    g_proto_head = 0
    g_proto_body = 0
    g_proto_title = 0
    g_proto_domexc = 0
    g_domexc_ctor = 0
    gepi: int32 = 0
    while gepi < 16:
        g_ev_proto[gepi] = 0
        gepi = gepi + 1
    _cssom_reset()
    htmlcanvas_reset()


def _cstr_len(p: Ptr[uint8]) -> int32:
    n: int32 = 0
    while p[n] != 0:
        n = n + 1
    return n


def _bytes_eq(a: Ptr[uint8], an: int32, b: Ptr[uint8], bn: int32) -> int32:
    if an != bn:
        return 0
    i: int32 = 0
    while i < an:
        if a[i] != b[i]:
            return 0
        i = i + 1
    return 1


# compare a src span [a,b) to a byte string idp[0..idn), case-insensitive.
def _idbytes_eq(a: uint64, b: uint64, idp: Ptr[uint8], idn: int32) -> int32:
    if cast[int32](b - a) != idn:
        return 0
    i: int32 = 0
    while i < idn:
        if _hx_lower(src_ptr[a + cast[uint64](i)]) != _hx_lower(idp[i]):
            return 0
        i = i + 1
    return 1


# Is the tag-name span [ts, ts+nl) a RAW-TEXT element name? The HTML tokenizer's
# "script data" / "RAWTEXT" states: everything until the matching close tag is
# character data, with NO markup and NO nesting.
def _rawtext_name(ts: uint64, nl: uint64) -> int32:
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("script")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("style")) != 0:
        return 1
    return 0


# THE scanner for "where does a raw-text element's body end". Raw text has no
# element nesting and no tags at all, so the body ends at the FIRST literal
# </name — a plain byte scan, never a markup walk. Publishes g_close_lt (the
# '<' of the close tag) and g_close_end (just past its '>') on the same
# contract as _find_close, and returns 1 on a hit. On a MISS the body genuinely
# runs to EOF (there is no close tag anywhere), so both globals are set to
# src_len rather than to `frm` — which is also exactly the resume point
# _rawtext_skip has always returned for an unterminated body.
def _rawtext_close(ts: uint64, nl: uint64, frm: uint64) -> int32:
    i: uint64 = frm
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and src_ptr[i + 1] == 47:
            if _srcname_eq(i + 2, ts, nl) != 0:           # matched </script>|</style>
                g_close_lt = i
                j: uint64 = i + 2
                j = _hx_tag_end_p(src_ptr, src_len, j)
                if j < src_len:
                    j = j + 1
                g_close_end = j
                return 1
        i = i + 1
    g_close_lt = src_len
    g_close_end = src_len
    return 0


# does the tag name at src[at] equal the src name span [ns, ns+nl), bounded?
def _srcname_eq(at: uint64, ns: uint64, nl: uint64) -> int32:
    k: uint64 = 0
    while k < nl:
        if at + k >= src_len:
            return 0
        if _hx_lower(src_ptr[at + k]) != _hx_lower(src_ptr[ns + k]):
            return 0
        k = k + 1
    if _alnum_at(at + nl) != 0:
        return 0
    return 1


# Find the matching close tag </name> for an element opened with tag name
# span [ns, ns+nl), scanning from `from`. Sets g_close_lt (the '<' of the
# close tag) and g_close_end (index just past its '>'). Returns 1 if a close
# tag was found; on miss both are set to `from` (empty content, no close).
#
# RAW TEXT AND COMMENTS ARE SKIPPED (round 9). This used to scan the source
# byte-by-byte, so any `<body`, `</body>` or `<html` appearing inside a
# <script> string literal, a CSS rule or an HTML comment was counted as real
# markup. MEASURED consequence on live snapshots: books.toscrape.com has 5
# occurrences of "<html" and google.com 3 of "<body", so `depth` never returned
# to 0, no close tag was found, and <body>/<html> got an EMPTY content span —
# document.body.textContent and .innerHTML were "" on those pages no matter how
# the DOM stored them. archlinux.org, with exactly one of each, worked.
def _find_close(ns: uint64, nl: uint64, frm: uint64) -> int32:
    # RAW TEXT FIRST. The scan below is a MARKUP scan, and the body of a
    # <script>/<style> is not markup — so running it over one is not merely
    # wasteful, it is WRONG: `for (i = 0; i < 3; i++)` reaches the `<` at line
    # 1730 below (not '</', not '<!', not '<?'), _hx_tag_end_p treats it as a
    # start tag and skips to the next '>' — which is the '>' of the element's
    # OWN </script>. The close tag is consumed as part of a phantom tag, the
    # scan never sees it, and the element gets an EMPTY content span. The
    # readers then compute "just past the close tag" (_tx_elem_end) as the
    # script's content START, so the whole JS source came back as a sibling
    # TEXT NODE of the <script> in the parent's childNodes.
    #
    # There were TWO writers for "where does a raw-text body end": this one and
    # _rawtext_skip, which has always been raw-text-correct — and only the
    # WRONG one fed tx_ce, which is what every tree reader walks. Both now go
    # through _rawtext_close, which is the single scanner.
    if _rawtext_name(ns, nl) != 0:
        return _rawtext_close(ns, nl, frm)
    depth: int32 = 0
    i: uint64 = frm
    while i < src_len:
        if src_ptr[i] == 60:                              # '<'
            if i + 1 < src_len and src_ptr[i + 1] == 47:  # '</'
                if _srcname_eq(i + 2, ns, nl) != 0:
                    if depth == 0:
                        g_close_lt = i
                        j: uint64 = i
                        j = _hx_tag_end_p(src_ptr, src_len, j)
                        if j < src_len:
                            j = j + 1
                        g_close_end = j
                        return 1
                    depth = depth - 1
            elif i + 3 < src_len and src_ptr[i + 1] == 33 and \
                 src_ptr[i + 2] == 45 and src_ptr[i + 3] == 45:   # '<!--'
                i = i + 4
                while i + 2 < src_len:
                    if src_ptr[i] == 45 and src_ptr[i + 1] == 45 and \
                       src_ptr[i + 2] == 62:              # '-->'
                        i = i + 2
                        break
                    i = i + 1
            elif src_ptr[i + 1] != 33 and src_ptr[i + 1] != 63:
                ts: uint64 = i + 1
                je: uint64 = ts
                je = _hx_tag_end_p(src_ptr, src_len, je)
                ne: uint64 = ts
                while ne < je and _alnum_at(ne) != 0:
                    ne = ne + 1
                if _srcname_eq(i + 1, ns, nl) != 0:
                    depth = depth + 1
                rt: uint64 = _rawtext_skip(ts, ne, je)
                if rt != 0:                               # <script>/<style> body
                    i = rt
                    continue
                i = je
        i = i + 1
    g_close_lt = frm
    g_close_end = frm
    return 0


# Extract the text content of src span [cs,ce) (tags stripped) into out[oo..].
# Returns the number of bytes written.
#
# CHARACTER REFERENCES ARE DECODED (round 9). This used to copy source bytes
# verbatim while the LAYOUT path decoded through _entity(), so the DOM text view
# and the rendered text disagreed: `a&nbsp;b &amp; c &#x27;d&#x27;` came back to
# script as those 47 literal bytes where chromium hands back `a b & c 'd'`. Real
# pages compare, slice and regex-match textContent, so the raw form silently
# fails their branches. We reuse the SAME decoder the renderer uses (no second
# entity table): _entity(i) returns the source bytes consumed and leaves the
# UTF-8 expansion in g_ent_buf[0..g_ent_len).
#
# <script>/<style> bodies are RAW TEXT (HTML tokenizer "script data" state):
# their character data is NOT entity-decoded, so a JS string literal containing
# "&amp;" or a CSS `content:"\&"` must survive byte-for-byte. chromium's
# body.textContent includes those bodies undecoded, so we copy them verbatim.
#
# THREE SINKS, ONE WALK (g_tw_mode). The textContent of an element is needed in
# three shapes and they MUST agree, so there is exactly one walker:
#   0  copy into dom_txtbuf[oo..]         (the geometry-matching prefix)
#   1  copy into tw_buf[0..]              (materialise a JS string on demand)
#   2  compare against g_tw_cmp_p[0..n)   (the readback's "was this mutated?"
#                                          oracle — streams, allocates nothing)
# Mode 2 is why the readback no longer needs a stored baseline at all: it can
# re-derive the element's original text straight from the source span.
# Skip a <template> body. `frm` points just past the template start tag's '>',
# `ce` bounds the search. Returns the offset just past the matching </template>.
#
# <template> children are parsed into a SEPARATE inert fragment ("template
# contents"), so they are NOT part of the document tree: an ancestor's
# textContent must not include them (chromium on `<div>A<template><p>HIDDEN
# </p></template>B</div>` returns "AB", we returned "AHIDDENB"). Templates
# nest, so this counts depth. A <script>/<style> body inside the template is
# RAW TEXT and is stepped over wholesale, so a "</template>" appearing inside a
# JS string literal cannot end the skip early — the same trap that used to
# break _find_close on books.toscrape ("<html" x5) and google ("<body" x3).
def _tpl_skip(frm: uint64, ce: uint64) -> uint64:
    return _inert_tag_skip(frm, ce, cast[Ptr[uint8]]("template"), 8)


# Skip the whole (nesting-aware) subtree of an INERT element whose start tag has
# already been consumed: scan from `frm` to the matching close tag of
# nm[0..nmlen), counting nested opens of the same name and stepping over
# <script>/<style> rawtext bodies (a "</template>" inside a JS string is not a
# close tag). Returns the offset just past the matching close, or `ce` if the
# element is never closed.
def _inert_tag_skip(frm: uint64, ce: uint64, nm: Ptr[uint8], nmlen: uint64) -> uint64:
    depth: int32 = 1
    i: uint64 = frm
    while i < ce:
        if src_ptr[i] != 60:                              # '<'
            i = i + 1
            continue
        if i + 1 < ce and src_ptr[i + 1] == 47:           # '</'
            if _hx_name_eq(i + 2, nmlen, nm) != 0:
                depth = depth - 1
                i = _hx_tag_end_p(src_ptr, ce, i + 2)
                if i < ce:
                    i = i + 1
                if depth == 0:
                    return i
                continue
            i = i + 1
            continue
        ts: uint64 = i + 1
        je: uint64 = _hx_tag_end_p(src_ptr, ce, ts)
        ne: uint64 = ts
        while ne < je and _alnum_at(ne) != 0:
            ne = ne + 1
        if _hx_name_eq(ts, ne - ts, nm) != 0:
            if je == ts or src_ptr[je - 1] != 47:         # not self-closing
                depth = depth + 1
        rt: uint64 = _rawtext_skip(ts, ne, je)            # <script>/<style> body
        if rt != 0:
            i = rt
            continue
        i = je
        if i < ce:
            i = i + 1
    return ce                                             # unterminated


def _extract_text(cs: uint64, ce: uint64, oo: int32) -> int32:
    n: int32 = 0
    # This is the DOM TEXT VIEW, not layout: decode entities faithfully, so
    # `&nbsp;` comes back as U+00A0 the way chromium hands it to script (pages
    # split(' ') / regex on it). Restored before returning so the renderer's
    # own _entity() calls keep folding it to a plain space for line-breaking.
    prev_mode: int32 = ent_dom_mode
    ent_dom_mode = 1
    i: uint64 = cs
    while i < ce:
        c: uint8 = src_ptr[i]
        if c == 60:                                       # '<' — skip a tag
            ts: uint64 = i + 1
            je: uint64 = ts
            je = _hx_tag_end_p(src_ptr, ce, je)
            ne: uint64 = ts
            while ne < je and _alnum_at(ne) != 0:
                ne = ne + 1
            israw: int32 = 0
            if _hx_name_eq(ts, ne - ts, cast[Ptr[uint8]]("script")) != 0:
                israw = 1
            elif _hx_name_eq(ts, ne - ts, cast[Ptr[uint8]]("style")) != 0:
                israw = 1
            istpl: int32 = 0
            if _hx_name_eq(ts, ne - ts, cast[Ptr[uint8]]("template")) != 0:
                istpl = 1
            if je > ts and src_ptr[je - 1] == 47:         # '<script/>' self-close
                israw = 0
                istpl = 0
            i = je
            if i < ce:
                i = i + 1
            if istpl != 0:                                # inert fragment: no text
                i = _tpl_skip(i, ce)
                continue
            if israw != 0:
                while i < ce:
                    if src_ptr[i] == 60 and i + 1 < ce and src_ptr[i + 1] == 47:
                        break
                    n = _tw_put(oo, n, src_ptr[i])
                    i = i + 1
            continue
        if c == 38:                                       # '&' — character ref
            cons: uint64 = _entity(i)
            if cons > 0:
                k: int32 = 0
                while k < g_ent_len:
                    n = _tw_put(oo, n, g_ent_buf[k])
                    k = k + 1
                i = i + cons
                continue
        n = _tw_put(oo, n, c)
        i = i + 1
    ent_dom_mode = prev_mode
    return n


# Materialise the FULL textContent of src span [cs,ce) into tw_buf and return
# its length (clipped to TW_CAP). Used by the lazy textContent getter, which is
# why it does not touch dom_txtbuf: that buffer is a per-page shared arena and a
# single <body> would swallow it whole.
def _text_into_tw(cs: uint64, ce: uint64) -> int32:
    g_tw_mode = 1
    g_tw_w = 0
    ign: int32 = _extract_text(cs, ce, 0)
    g_tw_mode = 0
    if g_tw_w > TW_CAP:
        g_tw_w = TW_CAP
    return g_tw_w


# Does p[0..n) equal the textContent of src span [cs,ce)? Streams the SAME walk
# with no buffer, so it is exact at any size — the readback's mutation oracle.
def _text_span_eq(p: Ptr[uint8], n: int32, cs: uint64, ce: uint64) -> int32:
    g_tw_mode = 2
    g_tw_cmp_p = p
    g_tw_cmp_n = n
    g_tw_w = 0
    g_tw_ok = 1
    ign: int32 = _extract_text(cs, ce, 0)
    g_tw_mode = 0
    if g_tw_ok == 0:
        return 0
    if g_tw_w != n:
        return 0
    return 1


# Does p[0..n) equal the RAW markup of src span [cs,ce)? (innerHTML oracle.)
def _html_span_eq(p: Ptr[uint8], n: int32, cs: uint64, ce: uint64) -> int32:
    if cast[uint64](n) != ce - cs:
        return 0
    i: int32 = 0
    while i < n:
        if p[i] != src_ptr[cs + cast[uint64](i)]:
            return 0
        i = i + 1
    return 1


# Copy the RAW markup of src span [cs,ce) into out[oo..] (innerHTML).
def _extract_html(cs: uint64, ce: uint64, oo: int32) -> int32:
    n: int32 = 0
    i: uint64 = cs
    while i < ce:
        if oo + n < DOM_TXT_CAP:
            dom_txtbuf[oo + n] = src_ptr[i]
            n = n + 1
        i = i + 1
    return n


# Scan a start tag at src[i]=='<'. Sets g_el_lt/cs/ce/ns/nl for the element
# and returns 1; caller has already checked src[i]=='<' + not close/comment.
def _scan_start_tag(i: uint64) -> int32:
    ts: uint64 = i + 1
    je: uint64 = ts
    je = _hx_tag_end_p(src_ptr, src_len, je)
    ne: uint64 = ts
    while ne < je and _alnum_at(ne) != 0:
        ne = ne + 1
    _find_close(ts, ne - ts, je + 1)
    g_el_lt = i
    g_el_ns = ts
    g_el_nl = ne - ts
    g_el_cs = je + 1
    g_el_ce = g_close_lt
    return 1


# Raw-text (CDATA) elements: the bodies of <script> and <style> are NOT HTML.
# Their text (JS string literals like innerHTML = '<p class="para">', CSS rules)
# must never be scanned for elements / ids / classes, or phantom nodes appear
# (round-5 .para count of 4 instead of 2). Given a start tag whose name span is
# [ts,ne) and whose '>' is at `je`, if it opens a script/style element return
# the source offset just PAST its matching close tag ('>'+1) so the source-text
# scanners resume AFTER the raw body. Returns 0 when the tag is not raw-text
# (0 is never a valid resume point: any tag at ts>=1 resumes past its own '>').
# Raw text has no element nesting — the body ends at the FIRST literal </name>.
def _rawtext_skip(ts: uint64, ne: uint64, je: uint64) -> uint64:
    nl: uint64 = ne - ts
    if _rawtext_name(ts, nl) == 0:
        return 0
    if je > ts and src_ptr[je - 1] == 47:                 # '<script .../>' self-close
        return 0
    ign: int32 = _rawtext_close(ts, nl, je + 1)
    return g_close_end                                    # miss => src_len (EOF)


# Resume offset for a subtree the ELEMENT scanners must not look inside, or 0
# when the tag at [ts,ne)/je opens no such subtree. Two cases, one helper so
# every element-registration walk treats them alike:
#   * <script>/<style> — RAW TEXT: their bodies are not markup at all, so a
#     `innerHTML = '<p class="para">'` in a string literal must mint no node.
#   * <template>       — its children are parsed into a SEPARATE inert fragment
#     ("template contents"), so they are not in the document tree: chromium's
#     querySelectorAll / getElementById do NOT see them (only .content does).
#     We were registering them, so `qsa("p")` counted 2 where chromium says 1
#     and getElementById found a node chromium returns null for — script that
#     branches on `if (el)` then took the wrong path.
def _inert_skip(ts: uint64, ne: uint64, je: uint64) -> uint64:
    rt: uint64 = _rawtext_skip(ts, ne, je)
    if rt != 0:
        return rt
    if _hx_name_eq(ts, ne - ts, cast[Ptr[uint8]]("template")) != 0:
        if je > ts and src_ptr[je - 1] == 47:             # <template/> self-close
            return 0
        return _tpl_skip(je + 1, src_len)
    # <noscript> with SCRIPTING ENABLED — which hambrowse always is — is parsed
    # as RAWTEXT: its content is character data, not elements, so nothing inside
    # it enters the document tree. The RENDERER already knew this (see the
    # noscript branch of _handle_tag in lib/web/dom/forms.ad, which is what stops
    # the ubiquitous "Please enable JavaScript" block from painting), but the DOM
    # TREE INDEXER did not, so the elements inside a <noscript> still got
    # records and script counted them.
    #
    # MEASURED against chromium --dump-dom, document.getElementsByTagName("*"):
    #   google_search  before 20 vs chromium 16 — the excess is EXACTLY that
    #                  page's one <noscript>: A+1 DIV+1 META+1 STYLE+1
    #   wikipedia_plan9 before 4576 vs 4575 — its one <noscript> holds one <img>
    if _hx_name_eq(ts, ne - ts, cast[Ptr[uint8]]("noscript")) != 0:
        if je > ts and src_ptr[je - 1] == 47:             # <noscript/> self-close
            return 0
        return _inert_tag_skip(je + 1, src_len, cast[Ptr[uint8]]("noscript"), 8)
    return 0


# Locate the FIRST element whose id attribute equals idp[0..idn). Sets the
# g_el_* element globals and returns 1 on a hit.
def _dom_find_by_id(idp: Ptr[uint8], idn: int32) -> int32:
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60 and i + 1 < src_len and \
           src_ptr[i + 1] != 47 and src_ptr[i + 1] != 33 and \
           src_ptr[i + 1] != 63:
            ts: uint64 = i + 1
            je: uint64 = ts
            je = _hx_tag_end_p(src_ptr, src_len, je)
            ne: uint64 = ts
            while ne < je and _alnum_at(ne) != 0:
                ne = ne + 1
            # The ELEMENT ITSELF is matched BEFORE its subtree is skipped.
            # <template>/<script>/<style>/<noscript> hold inert CONTENT, but
            # the element carrying the inert content is an ordinary node in the
            # document tree — chromium's getElementById does find
            # `<template id=x>`. Skipping first made every such element
            # unreachable by id AND by HTML "named access on the Window
            # object", which is how WPT addresses its <template> fixtures:
            # css/css-cascade/scope-nesting.html died with
            # "test_nest_scope_end is not defined" on line 1 of every subtest.
            # _dom_collect_selector (domtree.ad) already had this order; this
            # scanner was the odd one out.
            if _hx_find_attr(ts, je, cast[Ptr[uint8]]("id")) != 0:
                if _idbytes_eq(g_attr_start, g_attr_end, idp, idn) != 0:
                    return _scan_start_tag(i)
            rt: uint64 = _inert_skip(ts, ne, je)          # skip inert subtrees
            if rt != 0:
                i = rt
                continue
            i = je
        i = i + 1
    return 0


# Does class-attr span [a,b) contain the whitespace-delimited token tok[0..tn)?
def _cls_has_token(a: uint64, b: uint64, tok: Ptr[uint8], tn: int32) -> int32:
    i: uint64 = a
    while i < b:
        while i < b and (src_ptr[i] == 32 or src_ptr[i] == 9):
            i = i + 1
        s: uint64 = i
        while i < b and src_ptr[i] != 32 and src_ptr[i] != 9:
            i = i + 1
        if _idbytes_eq(s, i, tok, tn) != 0:
            return 1
    return 0


# Is `c` a CSS identifier byte (letter / digit / '-' / '_')?
def _sel_isname(c: uint8) -> int32:
    if c >= 97 and c <= 122:
        return 1
    if c >= 65 and c <= 90:
        return 1
    if c >= 48 and c <= 57:
        return 1
    if c == 45 or c == 95:
        return 1
    return 0


g_selattr: Array[1024, uint8]           # scratch: an attribute name from a selector


# Case-insensitive attribute-value operator match. Attribute value bytes are
# vp[0..vn); the selector's compare value is mp[0..mn). `op` selects the CSS
# attribute-selector operator:
#   0 '='  exact          1 '^=' prefix       2 '$=' suffix
#   3 '*=' substring       4 '~=' whitespace-separated word
#   5 '|=' equal OR value that begins with `m` immediately followed by '-'
# Values compare case-insensitively (matching the existing '=' behaviour, which
# used _idbytes_eq). A ^/$/*/~ selector with an empty compare value never
# matches (per the HTML/Selectors spec).
def _attr_op_match(vp: Ptr[uint8], vn: int32, mp: Ptr[uint8], mn: int32, \
                   op: int32) -> int32:
    if op == 0:                                           # '=' exact
        if vn != mn:
            return 0
        i: int32 = 0
        while i < vn:
            if _hx_lower(vp[i]) != _hx_lower(mp[i]):
                return 0
            i = i + 1
        return 1
    if mn == 0:
        return 0
    if op == 1:                                           # '^=' prefix
        if mn > vn:
            return 0
        i1: int32 = 0
        while i1 < mn:
            if _hx_lower(vp[i1]) != _hx_lower(mp[i1]):
                return 0
            i1 = i1 + 1
        return 1
    if op == 2:                                           # '$=' suffix
        if mn > vn:
            return 0
        i2: int32 = 0
        while i2 < mn:
            if _hx_lower(vp[vn - mn + i2]) != _hx_lower(mp[i2]):
                return 0
            i2 = i2 + 1
        return 1
    if op == 3:                                           # '*=' substring
        if mn > vn:
            return 0
        s3: int32 = 0
        while s3 <= vn - mn:
            j3: int32 = 0
            while j3 < mn and _hx_lower(vp[s3 + j3]) == _hx_lower(mp[j3]):
                j3 = j3 + 1
            if j3 == mn:
                return 1
            s3 = s3 + 1
        return 0
    if op == 4:                                           # '~=' whitespace word
        i4: int32 = 0
        while i4 < vn:
            while i4 < vn and (vp[i4] == 32 or vp[i4] == 9):
                i4 = i4 + 1
            st4: int32 = i4
            while i4 < vn and vp[i4] != 32 and vp[i4] != 9:
                i4 = i4 + 1
            if i4 - st4 == mn:
                k4: int32 = 0
                while k4 < mn and _hx_lower(vp[st4 + k4]) == _hx_lower(mp[k4]):
                    k4 = k4 + 1
                if k4 == mn:
                    return 1
        return 0
    if op == 5:                                           # '|=' dash-match
        if vn < mn:
            return 0
        if vn > mn and vp[mn] != 45:                       # must be exact or 'm-'
            return 0
        i5: int32 = 0
        while i5 < mn:
            if _hx_lower(vp[i5]) != _hx_lower(mp[i5]):
                return 0
            i5 = i5 + 1
        return 1
    return 0


# Is `c` an attribute-selector operator byte (^ $ * ~ |) or '=' or ']'?  Used to
# terminate the attribute NAME scan inside a '[...]' compound.
def _sel_attr_name_end(c: uint8) -> int32:
    if c == 93 or c == 61 or c == 94 or c == 36 or c == 42 or c == 126 or c == 124:
        return 1
    return 0


# LIVE-CLASS SEAM (round: classList/className mutations feed selector matching).
# =============================================================================
# `_sel_match_at` matches against the ORIGINAL source class attribute via
# `_hx_find_attr`. That is frozen at parse time, so a class added/removed by
# script AFTER parse (classList.add/remove/toggle, `el.className = ...`,
# `setAttribute('class', ...)`) was INVISIBLE to querySelectorAll /
# getElementsByClassName / matches() / closest(): a page that toggles a class
# and re-queries (active tab, filter, show/hide — the single most common
# interactive DOM pattern) read the stale, source-frozen class set. Measured
# against chromium --headless: after `items[0].classList.add('active')`,
# `document.querySelectorAll('.active').length` came back 1 in hambrowse vs 2 in
# chromium, because the matcher never saw the added class.
#
# The live className lives on the JS heap (the element's "className" prop), which
# this low-level source-scanning module has no access to (bindings.ad sits BELOW
# the JS/DOM layer, and domtree.ad's anchor lookup is imported AFTER it). So the
# DOM layer registers a resolver here — same raw-address-cast-to-Fn seam the
# module resolver / fetch transport already use — mapping a source '<' offset to
# the element's LIVE className bytes, or NULL when the element is not a
# registered/live node (in which case the frozen source attribute is authoritative,
# e.g. during the post-script render relayout over the class-rewritten source).
# Signature: fn(anchor: int32, out_len: Ptr[int32]) -> Ptr[uint8]
live_cls_addr: uint64 = 0
live_cls_set:  int32 = 0


def _set_live_cls_resolver(fn: Fn[int32, Ptr[int32], Ptr[uint8]]):
    live_cls_addr = cast[uint64](fn)
    live_cls_set = 1


# Does whitespace-delimited class string p[0..plen) contain token tok[0..tn)?
# (Buffer form of _cls_has_token, which reads the shared source buffer.)
def _cls_has_token_buf(p: Ptr[uint8], plen: int32, tok: Ptr[uint8], \
                       tn: int32) -> int32:
    if tn == 0:
        return 0
    i: int32 = 0
    while i < plen:
        while i < plen and (p[i] == 32 or p[i] == 9):
            i = i + 1
        s: int32 = i
        while i < plen and p[i] != 32 and p[i] != 9:
            i = i + 1
        if _idbytes_eq_buf(&p[s], i - s, tok, tn) != 0:
            return 1
    return 0


# Case-sensitive exact byte compare of two buffers (class tokens are ASCII-cased
# the same way _cls_has_token compares them: byte-exact).
def _idbytes_eq_buf(a: Ptr[uint8], an: int32, b: Ptr[uint8], bn: int32) -> int32:
    if an != bn:
        return 0
    i: int32 = 0
    while i < an:
        if a[i] != b[i]:
            return 0
        i = i + 1
    return 1


# The live class bytes for the element anchored at source '<' offset `ts-1`, or
# NULL (with g_live_cls_len 0) when there is no live node. Filled by the resolver.
g_live_cls_len: int32 = 0


def _live_class_of(ts: uint64) -> Ptr[uint8]:
    if live_cls_set == 0:
        g_live_cls_len = 0
        return cast[Ptr[uint8]](0)
    rfn: Fn[int32, Ptr[int32], Ptr[uint8]] = \
        cast[Fn[int32, Ptr[int32], Ptr[uint8]]](live_cls_addr)
    ln: int32 = 0
    p: Ptr[uint8] = cast[Ptr[uint8]](rfn(cast[int32](ts) - 1, &ln))
    g_live_cls_len = ln
    return p


# Does the start tag whose name span is [ts,ne) and whose body ends at the '>'
# `je` match the SINGLE compound selector sel[0..seln)? Supports an optional
# leading tag name (or '*'), then any run of `.class`, `#id`, and `[attr]` /
# `[attr="v"]` components (all must hold). A descendant combinator (space) is
# handled by the callers, which pass only the rightmost compound here.
def _sel_match_at(ts: uint64, je: uint64, ne: uint64, sel: Ptr[uint8], \
                  seln: int32) -> int32:
    if seln == 0:
        return 0
    i: int32 = 0
    if sel[0] == 42:                                      # '*' — any tag
        i = 1
    else:
        while i < seln and _sel_isname(sel[i]) != 0:
            i = i + 1
        if i > 0:
            if _idbytes_eq(ts, ne, sel, i) == 0:
                return 0
    while i < seln:
        c: uint8 = sel[i]
        if c == 46:                                       # '.class'
            i = i + 1
            s0: int32 = i
            while i < seln and _sel_isname(sel[i]) != 0:
                i = i + 1
            # LIVE class first: if this source element is a registered/live DOM
            # node, its className may have been mutated by script after parse
            # (classList / className= / setAttribute) — match the LIVE class set,
            # not the frozen source attribute. NULL => no live node => the source
            # attribute is authoritative (unregistered node, or the post-script
            # render relayout over the already-rewritten source).
            lcp: Ptr[uint8] = _live_class_of(ts)
            if cast[uint64](lcp) != 0:
                if _cls_has_token_buf(lcp, g_live_cls_len, &sel[s0], i - s0) == 0:
                    return 0
            else:
                if _hx_find_attr(ts, je, cast[Ptr[uint8]]("class")) == 0:
                    return 0
                if _cls_has_token(g_attr_start, g_attr_end, &sel[s0], i - s0) == 0:
                    return 0
        elif c == 35:                                     # '#id'
            i = i + 1
            s1: int32 = i
            while i < seln and _sel_isname(sel[i]) != 0:
                i = i + 1
            if _hx_find_attr(ts, je, cast[Ptr[uint8]]("id")) == 0:
                return 0
            if _idbytes_eq(g_attr_start, g_attr_end, &sel[s1], i - s1) == 0:
                return 0
        elif c == 91:                                     # '[attr]' / '[attr OP v]'
            i = i + 1
            ns0: int32 = i
            while i < seln and _sel_attr_name_end(sel[i]) == 0:
                i = i + 1
            nn: int32 = i - ns0
            k: int32 = 0
            while k < nn and k < 63:
                g_selattr[k] = sel[ns0 + k]
                k = k + 1
            g_selattr[k] = 0
            op: int32 = 0                                  # 0 '=' 1 ^= 2 $= 3 *= 4 ~= 5 |=
            if i < seln and sel[i] == 94:
                op = 1
                i = i + 1
            elif i < seln and sel[i] == 36:
                op = 2
                i = i + 1
            elif i < seln and sel[i] == 42:
                op = 3
                i = i + 1
            elif i < seln and sel[i] == 126:
                op = 4
                i = i + 1
            elif i < seln and sel[i] == 124:
                op = 5
                i = i + 1
            hasval: int32 = 0
            vs0: int32 = 0
            vn: int32 = 0
            if i < seln and sel[i] == 61:                 # '='
                i = i + 1
                q: uint8 = 0
                if i < seln and (sel[i] == 34 or sel[i] == 39):
                    q = sel[i]
                    i = i + 1
                vs0 = i
                while i < seln and sel[i] != 93 and (q == 0 or sel[i] != q):
                    i = i + 1
                vn = i - vs0
                if q != 0 and i < seln and sel[i] == q:
                    i = i + 1
                hasval = 1
            if i < seln and sel[i] == 93:                 # ']'
                i = i + 1
            if _hx_find_attr(ts, je, &g_selattr[0]) == 0:
                return 0
            if hasval != 0:
                if _attr_op_match(&src_ptr[g_attr_start], \
                                  cast[int32](g_attr_end - g_attr_start), \
                                  &sel[vs0], vn, op) == 0:
                    return 0
        else:
            break                                         # e.g. a stray space
    return 1


# The rightmost compound of a (possibly descendant) selector: sets g_sel_off so
# callers use sel[g_sel_off .. seln). `A B C` degrades to matching `C` (the
# ancestor constraint is dropped — a documented round-1 approximation).
g_sel_off: int32 = 0


def _sel_rightmost(sel: Ptr[uint8], seln: int32):
    g_sel_off = 0
    j: int32 = 0
    while j < seln:
        if sel[j] == 32:                                  # ' '
            g_sel_off = j + 1
        j = j + 1




# ====================================================================
# DOCUMENT URL (base for IDL URL-attribute reflection)
# ====================================================================
# `a.href` / `img.src` are IDL URL-reflecting attributes: the spec — and every
# real browser — returns the attribute value RESOLVED against the document's
# base URL, while `getAttribute('href')` returns the raw string. We reflected
# the RAW string on both, so a page that reads `a.href` and re-navigates got a
# RELATIVE url. Measured with chromium --headless on a file:// fixture:
#
#     <a href="?a=1">     chromium a.href = file:///.../href1.html?a=1
#                         hambrowse a.href = ?a=1
#     <img src="pic.png"> chromium img.src = file:///.../pic.png
#                         hambrowse img.src = pic.png
#     getAttribute('href') = "?a=1" in BOTH (that one was already right)
#
# The RESOLVER is not new: lib/web/js/builtins/url.ad already implements WHATWG
# relative-URL resolution for `new URL(ref, base)` (_url_resolve -> url_buf_a).
# This only supplies the document base URL it had no way to know, so the two
# spellings of the same operation cannot drift apart.
#
# The base URL is the document URL, overridden by <base href> if the document
# has one (itself resolved against the document URL — the HTML spec's
# "document base URL"). A front-end supplies the document URL through
# he_set_document_url(); when it supplies NONE (doc_url_len == 0) resolution is
# skipped entirely and the raw attribute is reflected exactly as before, so any
# front-end that has not been taught its own URL is byte-identical to before.
DOC_URL_CAP:  int32 = 2048
doc_url:      Array[2048, uint8]     # the document's own URL ("" = unknown)
doc_url_len:  int32 = 0
base_url:     Array[2048, uint8]     # document base URL (<base href> applied)
base_url_len: int32 = 0
url_bscratch: Array[2048, uint8]     # scratch: the decoded <base href> value


# Set the document URL (and, until _apply_base_href runs, the base URL). Safe to
# call with n <= 0 to clear it back to "no URL known".
def he_set_document_url(p: Ptr[uint8], n: int32):
    doc_url_len = 0
    while doc_url_len < n and doc_url_len < DOC_URL_CAP:
        doc_url[doc_url_len] = p[doc_url_len]
        doc_url_len = doc_url_len + 1
    base_url_len = 0
    while base_url_len < doc_url_len:
        base_url[base_url_len] = doc_url[base_url_len]
        base_url_len = base_url_len + 1


def he_doc_url_ptr() -> Ptr[uint8]:
    return &doc_url[0]


def he_doc_url_len() -> int32:
    return doc_url_len


def he_base_url_ptr() -> Ptr[uint8]:
    return &base_url[0]


def he_base_url_len() -> int32:
    return base_url_len
