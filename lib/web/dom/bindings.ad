NID_CV_TRANSLATE:  int32 = 75        # ctx.translate(tx, ty)
NID_CV_SCALE:      int32 = 76        # ctx.scale(sx, sy)
NID_CV_ROTATE:     int32 = 77        # ctx.rotate(angle)
NID_CV_TRANSFORM:  int32 = 78        # ctx.transform(a,b,c,d,e,f)
