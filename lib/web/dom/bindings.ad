# lib/web/dom/bindings.ad — part of the modular web engine (extracted from htmlengine.ad).
# JavaScript-DOM binding glue — the document/element host object surface dispatched from lib/web/js.
#
# Behavior-preserving split (single-compilation-unit; byte-identical).

from lib.htmlengine import _alnum_at, _handle_tag, _hx_find_attr, _hx_lower, _hx_name_eq, _hx_tag_end_p, ent_dom_mode
from lib.htmlengine import _cssom_reset

# ====================================================================
# JAVASCRIPT + minimal DOM.
#
# At layout time we run every <script> body through lib/jsengine.ad (js_eval),
# sharing ONE JS context across a page's scripts so later scripts see earlier
# globals. A minimal DOM is exposed to those scripts through jsengine's
# host-object seam (js_set_host_dispatch + the value constructors) — NO edits
# to the engine. `document.getElementById(id)` returns a plain JS object whose
# `textContent`, `style.color`, and `style.display` are ordinary data
# properties; the script mutates them with normal assignment. After all scripts
# finish we READ those properties back and, for every element the script
# actually changed, record an override. If any override exists we rebuild a
# copy of the source HTML with the overrides baked in (replaced text, an inline
# colour wrapper, or a hidden element dropped) and lay THAT out — so the visual
# result reflects the JS. Pages with no <script> skip all of this and lay out
# the original source byte-for-byte (zero behavioural change, zero jsengine
# touch — which also sidesteps the native float-division #DE, task #51).
# ====================================================================
# DOM_MAX caps how many source elements can ever be materialised as JS objects.
# At 64 it was FAR below what a real page touches: google.com's homepage has 440
# elements, and once the registry filled, _dom_register_el() returned
# `undefined` — so `document.getElementsByTagName("img")` reported length 7 while
# EVERY entry was undefined, and the page's own `for(...) a[i].getAttribute(...)`
# loop threw "cannot read property 'getAttribute' of null". Two of google's
# scripts died on exactly that.
#
# SIZED ON MEASUREMENT, and here is the measurement, plainly. Live snapshots,
# element counts from `document.getElementsByTagName("*").length`, ours and
# chromium's agreeing to within 4: wikipedia (Plan 9 article) 4576, hn 811,
# books.toscrape 542, archlinux 375, google.com 299. At 4096, wikipedia handed
# script 480 UNDEFINED elements. 8192 clears the largest page anyone here has
# measured by ~1.8x. It is NOT "sized for the web": the three snapshots that
# could not be measured at all (nytimes, stackoverflow, bbc — 2.9-4.5 MB, no
# output in 600 s) are exactly the ones likely to exceed it. What HAS changed is
# that crossing it is no longer silent — see the js_out_note at the cap check —
# so the next page that needs more will say so instead of throwing inside the
# page's own code. Cost is int-per-element: ~50 arrays x 32 KB.
DOM_MAX:     int32  = 8192
DOM_ID_CAP:  int32  = 131072
# Shared buffer for each registered element's GEOMETRY TEXT PREFIX (DOM_TXT_EL
# bytes each — see _tw_put). It used to hold every element's full textContent
# AND full raw innerHTML, which is why 64 KB was hopeless (the sum over all
# elements is O(page x depth)) and why document.body.textContent came back "".
# Those are lazy accessors now and do not touch this buffer at all, so 64 KB is
# a genuine fit rather than a safety valve. 1 MiB / DOM_TXT_EL covers 512
# elements at full prefix length and far more in practice (most elements hold a
# few dozen bytes of text); overflow now costs only geometry precision on the
# tail of a huge page, never a DOM read.
DOM_TXT_CAP: int32  = 1048576
DOM_OV_CAP:  int32  = 65536

dom_idbuf:   Array[131072, uint8]      # concatenated element ids (case-sensitive)
dom_idbuf_len: int32 = 0
dom_id_off:  Array[8192, int32]
dom_id_len:  Array[8192, int32]
dom_obj:     Array[8192, int32]        # JS object value-handle per element
dom_clsobj:  Array[8192, int32]        # the element's classList object handle (-1 none)
dom_anchor:  Array[8192, int32]        # source offset of the element's '<' (-1 = none)
dom_cstart:  Array[8192, int32]        # inner-content span in the source
dom_cend:    Array[8192, int32]
dom_ns:      Array[8192, int32]        # tag-name span in the source
dom_nl:      Array[8192, int32]
dom_orig_off: Array[8192, int32]       # original textContent (in dom_txtbuf)
dom_orig_len: Array[8192, int32]
dom_origcls_off: Array[8192, int32]    # original class attribute value
dom_origcls_len: Array[8192, int32]
dom_txtbuf:  Array[1048576, uint8]
dom_txt_len: int32 = 0
dom_n:       int32 = 0

# ---- ceiling diagnostics (round 9) ---------------------------------
# Every per-page ceiling below used to be crossed in SILENCE, which is worse
# than crossing it: the page kept running with `undefined` elements and missing
# listeners, and the only symptom was the page's own TypeError somewhere else.
# Each flag latches so a 4000-element overflow prints ONE line, not 4000, and
# is cleared by _dom_reset so a second page re-reports.
dom_warn_max:  int32 = 0               # DOM_MAX  — element objects
dom_warn_txt:  int32 = 0               # DOM_TXT_CAP — baseline text/html buffer
dom_warn_evl:  int32 = 0               # EVL_MAX  — addEventListener registry
dom_warn_tx:   int32 = 0               # TX_MAX   — integer tree index
dom_warn_ov:   int32 = 0               # DOM_OV_CAP — JS override text arena

# ---- textContent walker sink (round 9) -----------------------------
# See _extract_text. tw_buf is the ONE place a full element textContent is
# materialised; it is reused per call, so it costs 1 MiB of BSS total rather
# than 1 MiB per element. DOM_TXT_CAP stays small BECAUSE of this: dom_txtbuf is
# now only the geometry-matching PREFIX (DOM_TXT_EL bytes per element), not a
# baseline the readback depends on.
TW_CAP:      int32 = 1048576
tw_buf:      Array[1048576, uint8]
g_tw_mode:   int32 = 0                 # 0 dom_txtbuf | 1 tw_buf | 2 compare
g_tw_w:      int32 = 0                 # bytes produced (all modes)
g_tw_ok:     int32 = 1                 # mode 2: still matching?
g_tw_cmp_n:  int32 = 0
g_tw_cmp_p:  Ptr[uint8] = 0

# Per-element cap on the dom_txtbuf geometry prefix. Without it, <html> and
# <body> each snapshot the WHOLE document and the shared arena is gone before
# the third element registers — which is precisely how every later element ended
# up with a zero-length text baseline and no usable geometry.
DOM_TXT_EL:  int32 = 2048


# One byte into the walker's current sink. Returns the updated count.
def _tw_put(oo: int32, n: int32, c: uint8) -> int32:
    if g_tw_mode == 2:
        if g_tw_w < g_tw_cmp_n:
            if g_tw_cmp_p[g_tw_w] != c:
                g_tw_ok = 0
        else:
            g_tw_ok = 0
        g_tw_w = g_tw_w + 1
        return n + 1
    if g_tw_mode == 1:
        if g_tw_w < TW_CAP:
            tw_buf[g_tw_w] = c
            g_tw_w = g_tw_w + 1
        else:
            g_tw_w = TW_CAP + 1                       # mark overflow
        return n + 1
    if n < DOM_TXT_EL and oo + n < DOM_TXT_CAP:
        dom_txtbuf[oo + n] = c
        return n + 1
    return n

# ---- DOM tree index (task #324, browser round 2) -------------------
# The DOM was flat/source-anchored (round 1): each element carried its source
# span but no parent/child links, so tree-walking (`el.parentNode.children[0]
# .nextElementSibling`) and true selector combinators (`a > b`, `a + b`)
# could not work. This is a compact INTEGER tree overlay computed ONCE per
# page from the source spans every element already records: element B is a
# child of A iff B's '<' sits inside A's content span [cstart,cend) and A is
# the innermost such container. A single left-to-right pass with a span stack
# recovers the whole nesting. It is ints-only (no JS objects), so it can index
# far more elements (TX_MAX) than the JS-object cap (DOM_MAX); JS element
# objects are still registered lazily and their traversal properties are wired
# from this index (see _dom_wire_tree). tx_parent[i] = -1 for a root.
# TX_MAX: ints only, so it is deliberately kept at 2x DOM_MAX — the tree index
# must never be the binding constraint, because an element missing from it is
# invisible to traversal and selectors, not merely un-scriptable.
TX_MAX:     int32 = 16384
tx_anchor:  Array[16384, int32]        # source offset of the element's '<'
tx_cs:      Array[16384, int32]        # inner-content start (just past '>')
tx_ce:      Array[16384, int32]        # inner-content end (the matching '</')
tx_ns:      Array[16384, int32]        # tag-name span start
tx_nl:      Array[16384, int32]        # tag-name span length
tx_parent:  Array[16384, int32]        # parent tx index, or -1 for a root
tx_stack:   Array[16384, int32]        # scratch: open-element stack while building
tx_n:       int32 = 0
tx_built:   int32 = 0

# event handlers (parallel to 0..dom_n)
dom_onclick_fn:  Array[8192, int32]    # stored JS function value, or -1
dom_onclick_src: Array[8192, int32]    # inline onclick="..." source off, or -1
dom_onclick_srclen: Array[8192, int32]
dom_oninput_fn:  Array[8192, int32]    # oninput handler fn value, or -1
dom_oninput_src: Array[8192, int32]
dom_oninput_srclen: Array[8192, int32]
dom_onchange_fn: Array[8192, int32]    # onchange handler fn value, or -1
dom_onchange_src: Array[8192, int32]
dom_onchange_srclen: Array[8192, int32]
dom_onsubmit_fn: Array[8192, int32]    # onsubmit handler fn value, or -1 (forms)
dom_onsubmit_src: Array[8192, int32]
dom_onsubmit_srclen: Array[8192, int32]

# addEventListener registry — MULTIPLE listeners per (element,kind), fired in
# registration order (round 8). The el.on<evt> property + inline on<evt>=""
# handler stay in the dom_on*_fn/src slots (a single "attribute handler") and
# fire AFTER these, so `addEventListener('click',a); addEventListener('click',b);
# el.onclick=c` fires a, b, c. Independent slots => onclick + addEventListener
# both fire (real pages rely on this).
# EVL_MAX was 256 and silent. MEASURED: a page making 400 addEventListener
# calls got 256 listeners; chromium fired all 400, and the 144 dropped ones were
# indistinguishable from handlers the page never registered. 1024 is 2.5x the
# only over-cap case anyone has measured — above 400 it is a GUESS, but a guess
# that now reports when it is wrong (see the js_out_note at the cap check).
# Cost: 8 int arrays x 4 KB.
EVL_MAX:  int32 = 1024
evl_el:   Array[1024, int32]          # dom element index the listener is on
evl_kind: Array[1024, int32]          # 0 click 1 input 2 change 3 submit; GEN_KIND = string-typed
evl_fn:   Array[1024, int32]          # JS function value
evl_dead: Array[1024, int32]          # 1 = removed via removeEventListener
evl_once: Array[1024, int32]          # 1 = {once:true}: auto-remove after first fire
evl_capture: Array[1024, int32]       # 1 = {capture:true} (stored; bubble-only model)
evl_passive: Array[1024, int32]       # 1 = passive: preventDefault() from this listener is a no-op
evl_n:    int32 = 0
# Passive flag of the listener CURRENTLY executing (set around each js_call_fn in
# the fire loops). event.preventDefault() consults it: a passive listener cannot
# cancel the event. Reset to 0 between listeners and outside any dispatch.
g_cur_passive: int32 = 0

# Arbitrary event-type support (browser round 2). The 4 integer kinds above are
# the ones with an attribute-handler slot (onclick/oninput/onchange/onsubmit)
# and a legacy render side effect. ANY other type string (keydown, mouseover,
# focus, a CustomEvent name, …) is stored verbatim: the listener's evl_kind is
# the sentinel GEN_KIND and evt_tybuf[evl_type_off..+len) holds the type string.
# addEventListener/removeEventListener/dispatchEvent all resolve string types
# through this table, and dispatch bubbles them up the source tree exactly like
# the 4 known kinds — so `el.addEventListener('keydown', fn)` +
# `el.dispatchEvent(new Event('keydown'))` (or a plain {type:'keydown'}) fires.
GEN_KIND:  int32 = 100               # evl_kind sentinel: a string-typed listener
# evl_el sentinel for a DOCUMENT-level listener (document.addEventListener). The
# document object is not a registered DOM element, so document listeners record
# evl_el = DOC_EL and fire against js_doc as `this`. Used for DOMContentLoaded /
# load (fired once after all page <script>s run) and any other document type a
# page dispatches. See _fire_document / _run_scripts.
DOC_EL:    int32 = -2
evl_type_off: Array[1024, int32]      # type-string offset into evt_tybuf (GEN_KIND only)
evl_type_len: Array[1024, int32]
EVT_TYBUF_CAP: int32 = 4096
evt_tybuf: Array[4096, uint8]        # interned event-type strings for GEN_KIND listeners
evt_tybuf_len: int32 = 0

g_stop_prop: int32 = 0               # set by event.stopPropagation() in a handler
g_stop_immediate: int32 = 0          # set by event.stopImmediatePropagation()
g_cur_event: int32 = -1              # the JS event object of the in-flight dispatch

# eventPhase values — DOM spec Event.NONE/CAPTURING_PHASE/AT_TARGET/BUBBLING_PHASE
# (round 9: real three-phase propagation). A dispatch walks the propagation path
# (target..root) through the CAPTURE phase (root->target's parent, firing only
# capture:true listeners), the TARGET phase (fires every listener on the target
# regardless of capture flag, in registration order), then — if the event
# bubbles — the BUBBLE phase (target's parent->root, firing only capture:false
# listeners). event.eventPhase reflects the current phase per hop.
EPHASE_NONE:    int32 = 0
EPHASE_CAPTURE: int32 = 1
EPHASE_TARGET:  int32 = 2
EPHASE_BUBBLE:  int32 = 3

# Propagation path scratch: the chain of registered DOM element indices from the
# dispatch target (disp_path[0]) up to the document root (disp_path[disp_n-1]),
# built once per dispatch from the tx tree. Capture walks it high->low, bubble
# low->high, so both phases share one materialized path (order-stable).
DISP_PATH_MAX: int32 = 128
disp_path: Array[128, int32]
disp_n:    int32 = 0

# ---- <canvas> registry ---------------------------------------------
# Maps each source <canvas> to a lib/htmlcanvas index + its lib/htmlimg backing
# slot. Populated on the FIRST getContext('2d') during the script phase, and
# looked up again during layout (by element id, else by source anchor) so the
# <canvas> box blits the drawn pixels. Identity survives a JS-driven source
# rewrite because ids are preserved (anchor is a best-effort no-rewrite path).
CANV_MAX:    int32 = 8
canv_ci:     Array[8, int32]         # lib/htmlcanvas index
canv_slot:   Array[8, int32]         # lib/htmlimg backing slot
canv_w:      Array[8, int32]
canv_h:      Array[8, int32]
canv_anchor: Array[8, int32]         # source '<' offset at registration
canv_idoff:  Array[8, int32]         # id string in dom_idbuf (canv_idlen bytes)
canv_idlen:  Array[8, int32]
canv_ctxobj: Array[8, int32]         # cached 2D-context JS object handle
canv_el:     Array[8, int32]         # owning dom element index
canv_n:      int32 = 0

# ctx.save()/restore() style stack (the CTM is stacked in lib/htmlcanvas). Keyed
# by htmlcanvas index ci (0..7), 32 deep; stores the JS value handles of the five
# style properties so restore() rebinds them (incl. a gradient fillStyle object).
CV_SSTK_MAX:   int32 = 32
cv_sstk_fill:  Array[256, int32]     # [ci*32 + depth]
cv_sstk_strk:  Array[256, int32]
cv_sstk_lw:    Array[256, int32]
cv_sstk_font:  Array[256, int32]
cv_sstk_alpha: Array[256, int32]
cv_sstk_n:     Array[8, int32]

# form-control metadata (parallel to 0..dom_n). dom_kind: 0 generic, 1 input,
# 2 textarea, 3 select, 4 button, 5 form.
dom_kind:      Array[8192, int32]
dom_origval_off: Array[8192, int32]    # original value (input/textarea/select)
dom_origval_len: Array[8192, int32]
dom_origchecked: Array[8192, int32]    # original checked state (0/1), else -1

# resolved form overrides (parallel to 0..dom_n). off/len/flag == -1 = unset.
dom_ov_val_off:  Array[8192, int32]    # replacement value string
dom_ov_val_len:  Array[8192, int32]
dom_ov_checked:  Array[8192, int32]    # 1 checked, 0 unchecked, -1 unchanged

# form submission serialization result ("?a=1&b=2"), + last-navigated URL.
dom_nav_buf:  Array[2048, uint8]
dom_nav_len:  int32 = 0
dom_nav_present: int32 = 0
# form submission METHOD + request BODY. For method=GET the named controls are
# GET-serialized into dom_nav_buf as "action?a=1&b=2" and dom_nav_method stays 0.
# For method=POST dom_nav_buf carries the bare action target (no query) and the
# application/x-www-form-urlencoded body "a=1&b=2" lands in dom_body_buf with
# dom_nav_method = 1 (the front-end issues an HTTP POST with this body).
dom_nav_method: int32 = 0            # 0 GET / 1 POST
dom_body_buf: Array[2048, uint8]
dom_body_len: int32 = 0
# setCustomValidity() message store (parallel to 0..dom_n). len == 0 means no
# custom error; a non-empty message forces the control invalid (customError).
dom_customval_off: Array[8192, int32]
dom_customval_len: Array[8192, int32]
dom_customval_buf: Array[2048, uint8]
dom_customval_top: int32 = 0
g_prevent_default: int32 = 0         # set by event.preventDefault() in a handler
g_nmtmp: Array[128, uint8]           # scratch for a field name during serialize
g_radioname: Array[128, uint8]       # scratch for a radio group name during exclusivity
g_radioname_len: int32 = 0

# appended created children: flat (source-element-idx, created-node-id)
# records — the TOP-LEVEL mount points where a script-built subtree attaches
# under an existing source element. ap_removed marks an edge unlinked
# (removeChild / node.remove()).
APPEND_MAX:  int32 = 2048
ap_parent:   Array[2048, int32]
ap_child:    Array[2048, int32]
ap_removed:  Array[2048, int32]
ap_n:        int32 = 0

# createElement / createTextNode nodes (not in source): a tag + a JS object we
# read back. cre_is_text marks a text node (no tag; textContent only).
# cre_gone marks a node detached from the tree (node.remove()/removeChild),
# so the emitter skips it wherever it is referenced.
# 256 -> 8192 (2026-07-29). 256 created nodes is not a page budget, it is a
# few seconds of any framework render, and the overflow behaviour was a SILENT
# `return null` from document.createElement — so the page died on
# `.appendChild of null` with no clue why. Measured: dom/nodes/case.html builds
# ~3,000 elements and lost 179 subtests to this. DOM_MAX (source elements) is
# already 8192; match it, and say so out loud when it is reached.
CRE_MAX:     int32 = 8192
cre_obj:     Array[8192, int32]
cre_tag_off: Array[8192, int32]      # tag name in dom_idbuf
cre_tag_len: Array[8192, int32]
cre_is_text: Array[8192, int32]      # 1 = text node (emit escaped text only)
cre_gone:    Array[8192, int32]      # 1 = detached (skip when emitting)
cre_n:       int32 = 0
dom_warn_cre: int32 = 0              # 1 = the CRE_MAX ceiling note has been emitted

# ---- SOURCE TEXT NODES (2026-07-30) ----------------------------------------
# childNodes on a parsed element used to contain ELEMENTS ONLY: the tx tree
# indexes elements, so the text sitting between them was not a node at all.
# `title.firstChild.data` — testharness.js's own get_title() — returned null,
# `div.childNodes.length` was the ELEMENT count, and every traversal API
# (Range, TreeWalker, NodeIterator) was walking a tree missing most of its
# nodes.
#
# THE DESIGN, and what it rejects.
#
#   REJECTED — first-class slots in the tx tree (tx_kind[], text entries
#   emitted by _dom_build_tree_index). tx is not a DOM, it is the SELECTOR
#   index: _tx_prev_sibling / _tx_child_index / _tx_of_type_index /
#   _match_chain are all O(tx_n) LINEAR scans run per candidate element. Text
#   nodes outnumber elements roughly 1:1 on real markup and far more on
#   whitespace-formatted markup, so this doubles-to-quintuples tx_n and makes
#   selector matching quadratically slower on exactly the path that produces
#   the render. It also needs a `kind == 1` filter added to ~15 call sites, and
#   MISSING ONE silently breaks :nth-child on every page. Storage is the
#   smaller objection: 8 int32 arrays would have to grow past TX_MAX = 16384.
#
#   REJECTED — a full node array built at parse time. Same ceiling problem,
#   and it pays for every page whether or not a script ever asks. WPT pages
#   carry 210 KB of innerHTML; most of them never touch childNodes.
#
#   CHOSEN — derive text nodes LAZILY from the source, memoized by source
#   offset. The information is already there and needs no storage: an
#   element's child ELEMENTS partition its content span, and every gap between
#   them IS a text node. _node_children_of_tx walks that partition when
#   childNodes is actually asked for (it is already a lazy accessor,
#   NID_NODES_ACC). tx is untouched, so the selector engine and the render are
#   unchanged BY CONSTRUCTION rather than by inspection.
#
#   IDENTITY is the one thing laziness costs, and stx_start is the answer:
#   a source text node is uniquely named by the offset it starts at, so
#   `el.childNodes[0] === el.childNodes[0]` holds across independent walks the
#   same way _dom_lookup_anchor makes it hold for elements.
#
# These are deliberately NOT cre_ nodes. The created-node pool is what the
# innerHTML serialiser and the cx_ selector overlay walk; putting source text
# in it would make the emitter double-print text that is already in the source.
# _find_cre_by_obj returns -1 for an stx object, so both stay blind to them.
#
# NOT COVERED: comment nodes. _strip_comments physically deletes comments from
# the buffer before the parser sees it, so there is nothing left to derive them
# from. Recovering them needs a side table recorded during the strip; that is a
# separate change and is called out in the report rather than half-done here.
STX_MAX:    int32 = 8192
stx_start:  Array[8192, int32]       # source offset the text run starts at (the key)
stx_end:    Array[8192, int32]       # source offset just past it
stx_obj:    Array[8192, int32]       # the JS Text object
stx_n:      int32 = 0
dom_warn_stx: int32 = 0

# created-node -> created-node child edges (nesting): a script can build a
# whole subtree (table > tr > td) before mounting its root. Ordered by
# insertion; cc_removed marks an unlinked edge.
CC_MAX:      int32 = 16384
cc_owner:    Array[16384, int32]     # parent created-node id
cc_child:    Array[16384, int32]     # child created-node id
cc_removed:  Array[16384, int32]
cc_n:        int32 = 0

# innerHTML-setter fragment parser scratch (see _parse_fragment). A bounded
# open-element stack + a linear text buffer used to accrue each open element's
# textContent (a shared linear write cursor means an ancestor's [start..close)
# span naturally includes its descendants' text, matching DOM textContent).
FRAG_STACK_MAX: int32 = 64
frag_st_cid:  Array[1024, int32]       # open element's cre id (-1 = the root target)
frag_st_arr:  Array[1024, int32]       # its live childNodes/children JS array
frag_st_txt:  Array[1024, int32]       # frag_txt offset where its text began
FRAG_TXT_CAP: int32 = 16384
frag_txt:     Array[16384, uint8]
frag_txt_w:   int32 = 0

# insertAdjacentHTML concatenation scratch: the existing innerHTML combined with
# the inserted fragment (afterbegin => html+cur, beforeend => cur+html).
IAH_CAP:  int32 = 16384
iah_buf:  Array[16384, uint8]
iah_html: Array[16384, uint8]        # the inserted-html arg, copied out of the shared js_str_ptr scratch

# resolved overrides (parallel to 0..dom_n). off/len == -1 means "not set".
dom_ov_inner_off: Array[8192, int32]   # replacement inner (text OR html)
dom_ov_inner_len: Array[8192, int32]
dom_ov_inner_html: Array[8192, int32]  # 1 = emit raw (innerHTML), 0 = escape (textContent)
dom_ov_col_off:  Array[8192, int32]    # colour (raw CSS value)
dom_ov_col_len:  Array[8192, int32]
dom_ov_bg_off:   Array[8192, int32]    # background-color
dom_ov_bg_len:   Array[8192, int32]
dom_ov_wt_off:   Array[8192, int32]    # font-weight
dom_ov_wt_len:   Array[8192, int32]
dom_ov_al_off:   Array[8192, int32]    # text-align
dom_ov_al_len:   Array[8192, int32]
dom_ov_wd_off:   Array[8192, int32]    # width (CSS length string, e.g. "100px")
dom_ov_wd_len:   Array[8192, int32]
dom_ov_cls_off:  Array[8192, int32]    # className
dom_ov_cls_len:  Array[8192, int32]
dom_ov_hide:     Array[8192, int32]    # 1 = display:none (drop the element)
# The REVEAL half of `el.style.display`. dom_ov_hide alone made the readback
# one-directional: a script could HIDE an element, but a script REVEALING one
# that a stylesheet rule had hidden (`#modal{display:none}` +
# `modal.style.display='block'` — the show/hide primitive behind every modal,
# dropdown, accordion and tab strip on the web) produced no override at all, so
# the rewrite re-emitted the bare tag, the cascade re-applied the stylesheet's
# display:none on the fresh parse, and the element never appeared. Recording the
# non-none value and emitting it as an INLINE declaration (which outranks any
# stylesheet rule) is what makes the reveal stick.
dom_ov_disp_off: Array[8192, int32]    # display (non-none CSS value, e.g. "block")
dom_ov_disp_len: Array[8192, int32]
# DETACHED source elements. removeChild()/replaceChild() used to handle CREATED
# children only, so `parent.removeChild(sourceEl)` was a silent no-op: the node
# stayed on screen AND stayed in the parent's innerHTML. This is the real
# "removed from the tree" bit, kept SEPARATE from dom_ov_hide because
# `el.style.display='none'` hides an element that is still IN the tree — a
# browser still serialises it into innerHTML. Persistent across _dom_readback
# (which recomputes dom_ov_hide from scratch every call).
dom_detached:    Array[8192, int32]    # 1 = removeChild()'d out of the tree
dom_ovbuf:   Array[65536, uint8]
dom_ov_len:  int32 = 0
dom_n_overrides: int32 = 0           # count of elements with ANY override

dom_title_buf: Array[256, uint8]
dom_title_len: int32 = 0
dom_title_present: int32 = 0

js_con_buf:  Array[1048576, uint8]   # captured console.log output (1 MiB; was 8 KiB and truncated large pages)
js_con_len:  int32 = 0
js_had_error: int32 = 0
js_ctx_live: int32 = 0               # a persistent JS context exists this render
he_click_links: int32 = 0           # native: wrap handler elements in #__evt_N links

# Event-target index space. A source-anchored element is addressed by its dom_
# index (0..dom_n). A node that SCRIPT created (createElement/appendChild,
# innerHTML, a framework's reconciler output) has no source anchor and lives in
# the parallel cre_ registry, so it is addressed as CRE_IDX_BASE + cre id. Both
# he_dom_click_index() and the synthetic "#__evt_N" pointer-link wrap use this
# one space, which is what lets a user click reach a JS-created element.
CRE_IDX_BASE: int32 = 1000000

# ---- live DOM SERIALISATION (innerHTML re-serialisation) --------------------
# `el.innerHTML` used to be a slice of the ORIGINAL source, so every script
# mutation was invisible to it (measured against chromium: appendChild,
# textContent= and removeChild all read back the untouched markup). It is now
# produced by the same _rewrite_range emitter that bakes mutations into the
# rendered page — run over the element's own content span, in SERIALISATION
# mode. The two modes differ in exactly three ways, so one emitter serves both:
#   * ser mode never emits the native "#__evt_N" click-link wrappers (they are
#     a hit-testing device, not page markup);
#   * ser mode elides a node only when it is DETACHED (dom_detached), not when
#     it is merely display:none — a browser still serialises a hidden element;
#   * ser mode emits the JS-set `display` in the merged inline style, so a
#     hidden element round-trips as <div style="display:none">.
g_ser_mode: int32 = 0                 # 1 = emitting innerHTML, not the render

# ---- setAttribute overrides on SOURCE-anchored elements ---------------------
# getAttribute() reads the START TAG out of the source, which is right for an
# untouched element and WRONG the moment script writes one: measured against
# chromium, after `a.setAttribute('href','b.html')` chromium's getAttribute
# answers "b.html" while ours still answered the source's "a.html". The JS
# property could not be used as the store because href/src/alt/title are
# REFLECTED onto every element at registration (and href/src are absolutised),
# so "the object has an own `href`" says nothing about whether script wrote it.
# This is that missing bit: an explicit per-(element,name) override list, which
# getAttribute/hasAttribute consult before the source tag. A negative vlen is a
# removeAttribute() tombstone.
SATTR_MAX:     int32 = 512
SATTR_BUF_CAP: int32 = 16384
sattr_el:      Array[512, int32]
sattr_noff:    Array[512, int32]
sattr_nlen:    Array[512, int32]
sattr_voff:    Array[512, int32]
sattr_vlen:    Array[512, int32]      # -1 = attribute REMOVED
sattr_buf:     Array[16384, uint8]
sattr_buf_len: int32 = 0
sattr_n:       int32 = 0

# classList owner map for CREATED (document.createElement/NS) elements. Source
# elements map back through dom_clsobj[]; created ones have no dom_* row, so
# their token list used to resolve to "no element" and every add/remove/toggle
# SILENTLY DID NOTHING (measured: createElement('div').classList.add('x') left
# className empty). This table is the missing back-pointer.
# DOMImplementation -> owning Document. createDocumentType() must stamp the
# new doctype's ownerDocument with the document its implementation came from
# (DOMImplementation-createDocumentType.html asserts exactly that, 79 subtests).
# el.attributes MEMO. testharness.js's format_value() does
#     for (var i = 0; i < val.attributes.length; i++)
# so a NamedNodeMap rebuilt on every read is O(n^2) allocations per printed
# element — measured: dom/nodes/case.html exhausted the 8 MiB string pool and
# the run died at subtest 23 of 285. The map is cached per element and
# invalidated by a generation counter that every attribute mutation bumps, so
# it stays live without re-allocating on each property read.
# Same story for el.innerHTML, which format_value() also reads for every
# element it prints: with a mutated DOM each read re-SERIALISES the subtree, so
# printing the same <html> element 200 times built 200 copies of the document.
# Keyed on a DOM-mutation generation so a read after any mutation recomputes.
# Namespaced / created-element attribute store, keyed on the element OBJECT
# handle so it serves both source and created nodes. The pre-existing stores do
# not: sattr_* is keyed on a dom_* row (source only) and a created element's
# setAttribute() just wrote a JS property, which cannot be enumerated as an
# attribute list (the object also carries tagName/nodeType/...). Every entry
# records namespace + prefix + localName + value, which is what
# element.attributes[i].prefix/.localName/.namespaceURI need.
NSA_MAX:     int32 = 2048
nsa_obj:     Array[2048, int32]      # owning element object handle (-1 = removed)
nsa_nsoff:   Array[2048, int32]
nsa_nslen:   Array[2048, int32]      # -1 = null namespace
nsa_pfoff:   Array[2048, int32]
nsa_pflen:   Array[2048, int32]      # -1 = null prefix
nsa_lnoff:   Array[2048, int32]
nsa_lnlen:   Array[2048, int32]
nsa_vloff:   Array[2048, int32]
nsa_vllen:   Array[2048, int32]
nsa_buf:     Array[65536, uint8]
nsa_buf_len: int32 = 0
nsa_n:       int32 = 0

IHC_MAX:     int32 = 512
ihc_el:      Array[512, int32]
ihc_val:     Array[512, int32]
ihc_gen:     Array[512, int32]
ihc_n:       int32 = 0
ihc_next:    int32 = 0               # round-robin victim once the table is full
g_dom_gen:   int32 = 1

ATTRC_MAX:   int32 = 512
attrc_el:    Array[512, int32]
attrc_map:   Array[512, int32]
attrc_gen:   Array[512, int32]
attrc_n:     int32 = 0
attrc_next:  int32 = 0               # round-robin victim once the table is full
g_attr_gen:  int32 = 1

IMPLOWN_MAX: int32 = 64
implown_impl: Array[64, int32]
implown_doc:  Array[64, int32]
implown_n:    int32 = 0

CLSOWN_MAX:  int32 = 1024
clsown_list: Array[1024, int32]      # the DOMTokenList object handle
clsown_obj:  Array[1024, int32]      # the element object that owns it
clsown_n:    int32 = 0

# dataset owner map: the el.dataset object handle -> the element object that
# owns it. `el.dataset.foo = 'x'` is a plain member-set on that object, which
# stored the value there and NOWHERE ELSE — the data-foo CONTENT attribute was
# never written, so getAttribute('data-foo') and el.attributes still answered
# the parse-time value (or nothing at all for a name the source tag never
# declared). The back-pointer is what lets the member-set hook mirror the write
# into the one attribute store the readers walk.
DSOWN_MAX:   int32 = 1024
dsown_list:  Array[1024, int32]      # the dataset object handle
dsown_obj:   Array[1024, int32]      # the element object that owns it
dsown_n:     int32 = 0
# Mutation counter. Zero means no structural/attribute mutation has run yet, so
# innerHTML is provably the source slice and takes the old (cheap, byte-exact)
# path. Bumped by every DOM-mutating native entry point.
g_dom_mutated: int32 = 0

# rewritten source (only built when overrides exist)
RW_CAP:  uint64 = 4194304
rw_buf:  Array[4194304, uint8]
rw_len:  uint64 = 0

# Comment-stripped source. Real pages routinely hide markup inside HTML
# comments — a <script> demo wrapped in <!-- -->, a legacy `<!-- <script>…
# //--> ` guard, or an IE conditional `<!--[if IE]>…<![endif]-->`. The tag
# tokenizers below only scan for the next '>', so a '>' or a whole <script>
# sitting INSIDE a comment used to leak: the comment body rendered as page
# text and (worse) a commented-out <script> was detected + executed. We strip
# `<!-- … -->` spans ONCE up front and repoint src at the stripped copy, so
# every downstream scanner (CSS harvest, script run, DOM build, layout,
# rewrite) sees comment-free source. `<!DOCTYPE …>` is NOT a comment (it does
# not open with `<!--`) and is left intact for _handle_tag to ignore.
CS_CAP:  uint64 = 4194304
cs_buf:  Array[4194304, uint8]
cs_done: int32 = 0


# Does a <script> or <style> START TAG open at src_ptr[i] (which is '<')?
def _cs_raw_open(i: uint64) -> int32:
    if _cs_word_at(i + 1, cast[Ptr[uint8]]("script"), 6) != 0:
        return 1
    if _cs_word_at(i + 1, cast[Ptr[uint8]]("style"), 5) != 0:
        return 1
    return 0


# Case-insensitive tag-name match at src_ptr[i..], followed by a tag-name
# terminator (whitespace, '>' or '/').
def _cs_word_at(i: uint64, w: Ptr[uint8], n: int32) -> int32:
    k: int32 = 0
    while k < n:
        if i + cast[uint64](k) >= src_len:
            return 0
        c: uint8 = src_ptr[i + cast[uint64](k)]
        if c >= 65 and c <= 90:
            c = c + 32
        if c != w[k]:
            return 0
        k = k + 1
    if i + cast[uint64](n) >= src_len:
        return 0
    t: uint8 = src_ptr[i + cast[uint64](n)]
    if t == 32 or t == 9 or t == 10 or t == 13 or t == 62 or t == 47:
        return 1
    return 0


# End offset (exclusive) of the raw-text element opening at src_ptr[i],
# INCLUDING its close tag. An unterminated one runs to end of source.
def _cs_raw_close(i: uint64) -> uint64:
    nm: Ptr[uint8] = cast[Ptr[uint8]]("script")
    nl: int32 = 6
    if _cs_word_at(i + 1, cast[Ptr[uint8]]("style"), 5) != 0:
        nm = cast[Ptr[uint8]]("style")
        nl = 5
    j: uint64 = i + 1
    while j < src_len:
        if src_ptr[j] == 60 and j + 1 < src_len and src_ptr[j + 1] == 47 and \
           _cs_word_at(j + 2, nm, nl) != 0:
            k2: uint64 = j + 2 + cast[uint64](nl)
            while k2 < src_len and src_ptr[k2] != 62:
                k2 = k2 + 1
            if k2 < src_len:
                return k2 + 1
            return src_len
        j = j + 1
    return src_len


def _strip_comments():
    # Idempotent: safe to call again on an already-stripped buffer.
    if src_len == 0:
        return
    w: uint64 = 0
    i: uint64 = 0
    while i < src_len and w < CS_CAP - 1:
        # <script> and <style> bodies are RAW TEXT: "<!--" inside them opens
        # nothing. Stripping them anyway silently destroyed any JS string
        # containing the sequence — MEASURED on dom/nodes/ChildNode-before.html,
        # whose `test_before(document.createComment('test'), 'Comment',
        # '<!--test-->')` had its third argument rewritten to "" before the
        # parser ever saw it, so 15 subtests were comparing against the wrong
        # expectation. Copy the whole element through untouched.
        if src_ptr[i] == 60 and _cs_raw_open(i) != 0:
            e: uint64 = _cs_raw_close(i)
            while i < e and w < CS_CAP - 1:
                cs_buf[w] = src_ptr[i]
                w = w + 1
                i = i + 1
            continue
        # A comment opens with the exact 4-byte lead-in "<!--".
        if src_ptr[i] == 60 and i + 3 < src_len and \
           src_ptr[i + 1] == 33 and src_ptr[i + 2] == 45 and \
           src_ptr[i + 3] == 45:                            # '<' '!' '-' '-'
            j: uint64 = i + 4
            # Skip to the closing "-->" (first occurrence wins, per HTML: a
            # conditional `<!--[if IE]>…<![endif]-->` is one comment). An
            # unterminated comment swallows the rest of the document.
            while j + 2 < src_len:
                if src_ptr[j] == 45 and src_ptr[j + 1] == 45 and \
                   src_ptr[j + 2] == 62:                     # '-' '-' '>'
                    j = j + 3
                    break
                j = j + 1
            if j + 2 >= src_len:
                j = src_len                                  # unterminated
            i = j
            continue
        cs_buf[w] = src_ptr[i]
        w = w + 1
        i = i + 1
    cs_buf[w] = 0
    src_ptr = &cs_buf[0]
    src_len = w
    cs_done = 1
    _insert_implied_tags()


# ====================================================================
# IMPLIED ELEMENTS — <html>, <head>, <body>, <tbody>
# ====================================================================
#
# THE PROBLEM. This DOM is anchored to byte spans in the source: an element IS
# a pair of offsets. An element the HTML5 tree construction algorithm INSERTS —
# one with no start tag anywhere in the file — therefore had no way to exist,
# and the element census came up short by exactly those nodes. Measured with
# scripts/probe_realweb_dom.sh (document.getElementsByTagName("*").length),
# ours vs chromium --headless --dump-dom:
#
#     cern_project   51 vs 53   — the file opens with <HEADER>, so <html> and
#                                 <head> are both implied
#     hackernews    805 vs 809  — four <table>s with no <tbody>
#
# THE DESIGN DECISION. The alternative was to give tx_/dom_ nodes an OPTIONAL
# SYNTHESISED span (a negative tx_ns meaning "name lives in a side table"),
# which touches every consumer of a name span, every registration path
# (_dom_register_el reads the START TAG out of the source to build the JS
# object) and every enumerator — and _dom_collect_selector, the thing that
# actually answers getElementsByTagName, does not walk the tree index at all:
# it re-scans the SOURCE for '<'. Under that architecture a span-less node is
# invisible no matter how the tree index is extended.
#
# So instead of teaching the DOM to represent nodes the source does not
# contain, this pass makes the SOURCE contain them: a normalisation pass that
# inserts the implied start/end tags into the (already comment-stripped)
# buffer before anything indexes it. Every downstream consumer — tree index,
# selectors, traversal, innerHTML, layout — then sees ordinary source-anchored
# elements with real spans, and needs no change whatsoever.
#
# RENDER NEUTRALITY. Byte-compared over the full 270-page corpus (layout dump
# AND rendered PPM), before vs after: zero movers. <html>/<head>/<body>/<tbody>
# carry no UA box of their own in this engine, so inserting them moves nothing.
#
# SCOPE (deliberately the four elements above, in the shapes real pages hit):
#   * <html>  — inserted around the document (after any <!DOCTYPE>) when absent.
#   * <head>  — inserted when absent, closing before the first element that is
#               not head-only (title/meta/link/style/script/base/noscript),
#               which is where the spec's "in head" insertion mode ends.
#   * <body>  — inserted when absent, opening after </head> and closing before
#               a trailing </html>.
#   * <tbody> — wraps each maximal run of <tr> that is not already inside a
#               thead/tbody/tfoot, per open <table> (a nesting stack keeps a
#               nested table's rows with the nested table).
# NOT modelled: <colgroup>, <option>-implied <select> repair, foster parenting.
IM_CAP:  uint64 = 4194304
im_buf:  Array[4194304, uint8]
IM_TBL_MAX: int32 = 64
im_tb_rg:   Array[64, int32]          # per open <table>: inside a row group?
im_tb_open: Array[64, int32]          # per open <table>: did WE open a <tbody>?


def _im_put(w: uint64, c: uint8) -> uint64:
    if w < IM_CAP - 1:
        im_buf[w] = c
        return w + 1
    return w


def _im_puts(w: uint64, s: Ptr[uint8]) -> uint64:
    i: int32 = 0
    x: uint64 = w
    while s[i] != 0:
        x = _im_put(x, s[i])
        i = i + 1
    return x


# Is the tag name at src[ts,ne) one the spec keeps in <head>? Used only to find
# where an IMPLIED </head> goes; the close-tag form counts too (</title> must
# not end the head).
def _im_head_only(ts: uint64, ne: uint64) -> int32:
    nl: uint64 = ne - ts
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("title")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("meta")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("link")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("style")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("script")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("base")) != 0:
        return 1
    if _hx_name_eq(ts, nl, cast[Ptr[uint8]]("noscript")) != 0:
        return 1
    return 0


def _im_name_is(ts: uint64, ne: uint64, s: Ptr[uint8]) -> int32:
    return _hx_name_eq(ts, ne - ts, s)


def _insert_implied_tags():
    if src_len == 0:
        return
    # ---- pass 1: what does the document already declare, and where would the
    # implied </head> and </body> land?
    has_html: int32 = 0
    has_head: int32 = 0
    has_body: int32 = 0
    has_table: int32 = 0
    dstart: uint64 = 0                                    # just past <!DOCTYPE>
    hcut: uint64 = src_len                                # implied </head> here
    headend: uint64 = 0                                   # past an EXPLICIT </head>
    lasthtmlclose: uint64 = src_len                       # a trailing </html>
    i: uint64 = 0
    while i < src_len:
        if src_ptr[i] == 60:
            if i + 8 < src_len and src_ptr[i + 1] == 33:  # <!DOCTYPE ...>
                j: uint64 = _hx_tag_end_p(src_ptr, src_len, i + 1)
                if dstart == 0:
                    dstart = j + 1
                i = j
                i = i + 1
                continue
            cl: int32 = 0
            ts: uint64 = i + 1
            if ts < src_len and src_ptr[ts] == 47:
                cl = 1
                ts = ts + 1
            je: uint64 = ts
            je = _hx_tag_end_p(src_ptr, src_len, je)
            ne: uint64 = ts
            while ne < je and _alnum_at(ne) != 0:
                ne = ne + 1
            if ne > ts:
                if _im_name_is(ts, ne, cast[Ptr[uint8]]("html")) != 0:
                    if cl == 0:
                        has_html = 1
                    else:
                        lasthtmlclose = i
                elif _im_name_is(ts, ne, cast[Ptr[uint8]]("head")) != 0:
                    if cl == 0:
                        has_head = 1
                    else:
                        headend = je + 1
                elif _im_name_is(ts, ne, cast[Ptr[uint8]]("body")) != 0:
                    if cl == 0:
                        has_body = 1
                elif _im_name_is(ts, ne, cast[Ptr[uint8]]("table")) != 0:
                    has_table = 1
                if hcut == src_len and cl == 0 and \
                   _im_name_is(ts, ne, cast[Ptr[uint8]]("html")) == 0 and \
                   _im_head_only(ts, ne) == 0:
                    hcut = i
            if cl == 0 and ne > ts:
                rt: uint64 = _inert_skip(ts, ne, je)
                if rt != 0:
                    i = rt
                    continue
            i = je
        i = i + 1
    if has_html != 0 and has_head != 0 and has_body != 0 and has_table == 0:
        return                                            # nothing to imply
    if hcut < dstart:
        hcut = dstart
    # where <body> opens: right after the head (implied or explicit)
    bopen: uint64 = hcut
    if has_head != 0:
        bopen = headend
        if bopen < dstart:
            bopen = dstart
    bclose: uint64 = lasthtmlclose
    if has_html == 0:
        bclose = src_len
    # ---- pass 2: stream the source out with the implied tags spliced in
    w: uint64 = 0
    sp: int32 = 0
    k: uint64 = 0
    while k < src_len:
        if k == dstart:
            if has_html == 0:
                w = _im_puts(w, cast[Ptr[uint8]]("<html>"))
            if has_head == 0:
                w = _im_puts(w, cast[Ptr[uint8]]("<head>"))
        if has_head == 0 and k == hcut:
            w = _im_puts(w, cast[Ptr[uint8]]("</head>"))
        if has_body == 0 and k == bopen:
            w = _im_puts(w, cast[Ptr[uint8]]("<body>"))
        if has_body == 0 and k == bclose:
            w = _im_puts(w, cast[Ptr[uint8]]("</body>"))
        if src_ptr[k] == 60:
            cl2: int32 = 0
            ts2: uint64 = k + 1
            if ts2 < src_len and src_ptr[ts2] == 47:
                cl2 = 1
                ts2 = ts2 + 1
            je2: uint64 = ts2
            je2 = _hx_tag_end_p(src_ptr, src_len, je2)
            ne2: uint64 = ts2
            while ne2 < je2 and _alnum_at(ne2) != 0:
                ne2 = ne2 + 1
            if ne2 > ts2:
                if _im_name_is(ts2, ne2, cast[Ptr[uint8]]("table")) != 0:
                    if cl2 == 0:
                        if sp < IM_TBL_MAX:
                            im_tb_rg[sp] = 0
                            im_tb_open[sp] = 0
                            sp = sp + 1
                    elif sp > 0:
                        if im_tb_open[sp - 1] != 0:
                            w = _im_puts(w, cast[Ptr[uint8]]("</tbody>"))
                        sp = sp - 1
                elif sp > 0:
                    grp: int32 = 0
                    if _im_name_is(ts2, ne2, cast[Ptr[uint8]]("tbody")) != 0:
                        grp = 1
                    elif _im_name_is(ts2, ne2, cast[Ptr[uint8]]("thead")) != 0:
                        grp = 1
                    elif _im_name_is(ts2, ne2, cast[Ptr[uint8]]("tfoot")) != 0:
                        grp = 1
                    if grp != 0:
                        if cl2 == 0:
                            if im_tb_open[sp - 1] != 0:
                                w = _im_puts(w, cast[Ptr[uint8]]("</tbody>"))
                                im_tb_open[sp - 1] = 0
                            im_tb_rg[sp - 1] = 1
                        else:
                            im_tb_rg[sp - 1] = 0
                    elif cl2 == 0 and \
                         _im_name_is(ts2, ne2, cast[Ptr[uint8]]("tr")) != 0:
                        if im_tb_rg[sp - 1] == 0 and im_tb_open[sp - 1] == 0:
                            w = _im_puts(w, cast[Ptr[uint8]]("<tbody>"))
                            im_tb_open[sp - 1] = 1
                # an inert body (script/style/noscript/template) is copied
                # verbatim: a '<' inside a JS string is not a tag.
                if cl2 == 0:
                    rt2: uint64 = _inert_skip(ts2, ne2, je2)
                    if rt2 != 0:
                        while k < rt2 and k < src_len:
                            w = _im_put(w, src_ptr[k])
                            k = k + 1
                        continue
        w = _im_put(w, src_ptr[k])
        k = k + 1
    # Tail flush for splice points that landed AT end-of-source. The pass-2 loop
    # runs `while k < src_len`, so any implied tag whose insertion offset equals
    # src_len (e.g. a document whose only content is head-only — bare text and/or
    # a <script>, with no element that forces the head closed) is never emitted
    # inside the loop. Without this, we produced `<head>...</body></html>` with a
    # </body> but NO <body> open tag, so document.body came back undefined even
    # though document.head/documentElement resolved. Emit </head> then <body> in
    # spec order, ahead of the </body>/</html> flush below.
    if has_head == 0 and hcut >= src_len:
        w = _im_puts(w, cast[Ptr[uint8]]("</head>"))
    if has_body == 0 and bopen >= src_len:
        w = _im_puts(w, cast[Ptr[uint8]]("<body>"))
    if has_body == 0 and bclose >= src_len:
        w = _im_puts(w, cast[Ptr[uint8]]("</body>"))
    if has_html == 0:
        w = _im_puts(w, cast[Ptr[uint8]]("</html>"))
    im_buf[w] = 0
    src_ptr = &im_buf[0]
    src_len = w


