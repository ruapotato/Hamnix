# lib/web/dom/query.ad — part of the modular web engine (extracted from htmlengine.ad).
# created-node selector traversal — querySelector/All + getElementBy* over created + source nodes.
#
# Behavior-preserving split (single-compilation-unit; byte-identical).

from lib.htmlengine import _attr_decode_at
from lib.htmlengine import base_url, base_url_len
from lib.jsengine import _url_resolve, url_buf_a
from lib.htmlengine import _ebox_find, _attr_op_match, _build_dataset, _bytes_eq, _content_right, _cstr_len, _dom_lookup_anchor, _extract_html, _extract_text, _find_cre_by_obj, _has_word, _hx_find_attr, _hx_lower, _idbytes_eq, _input_type_is, _is_undef_str, _left_margin, _match_chain, _nth_match, _palette_rgb, _parse_nth, _sel_attr_name_end, _sel_isname, _sel_parse, _sel_split, _select_index, _select_text, _tx_by_anchor, _tx_next_sibling, _tx_prev_sibling, _upper, css_color_rgb

# ====================================================================
# Created-node selector traversal (round 5).
# ====================================================================
# querySelector/All, getElementById/ByClassName/ByTagName scan the SOURCE
# text (above). Elements built at runtime via createElement+appendChild or an
# innerHTML= setter live in the cre_*/ap_*/cc_* model and JS childNodes arrays,
# invisible to that scan. We build a lightweight tree overlay (cx_*) of the
# MOUNTED created nodes each query, then run the same selector grammar over it,
# crossing up into the source tree at a created root so `.src .created` chains
# resolve. Results are appended after the source matches; a created node is
# never in the source text so the two result sets never overlap.
CX_MAX:    int32 = 256
cx_cid:    Array[256, int32]         # cre id at this cx slot
cx_parent: Array[256, int32]         # parent cx slot (-1 = root, source-mounted)
cx_src:    Array[256, int32]         # source el index if root, else -1
cx_eidx:   Array[256, int32]         # 1-based ELEMENT-child index (:nth-child)
cx_n:      int32 = 0
cx_slot:   Array[256, int32]         # cre id -> cx slot (dedup / visited), -1 none


# Register created node `cid` as a fresh cx slot under `parent_slot` (source el
# `src_el` when a root), element index `eidx`. Returns the slot, or -1 if the
# node is gone / already visited / the pool is full.
def _cx_reg(cid: int32, parent_slot: int32, src_el: int32, eidx: int32) -> int32:
    if cid < 0 or cid >= cre_n or cre_gone[cid] != 0:
        return -1
    if cx_slot[cid] >= 0:
        return -1
    if cx_n >= CX_MAX:
        return -1
    s: int32 = cx_n
    cx_cid[s] = cid
    cx_parent[s] = parent_slot
    cx_src[s] = src_el
    cx_eidx[s] = eidx
    cx_slot[cid] = s
    cx_n = s + 1
    return s


# Enumerate the created children of a parent (source el `pel` OR created id
# `pcid`, the other -1) in DOM order — its JS childNodes array first (covers
# innerHTML + source appendChild), then any ap/cc edge child not already seen
# (covers created->created appendChild, which does not touch the JS array) —
# registering each and recursing. Dedup by cre id keeps a node single.
def _cx_walk(parent_slot: int32, pel: int32, pcid: int32):
    pobj: int32 = 0
    if pel >= 0:
        pobj = dom_obj[pel]
    else:
        pobj = cre_obj[pcid]
    ec: int32 = 0
    arr: int32 = js_get_prop(pobj, cast[Ptr[uint8]]("childNodes"), 10)
    if js_is_array(arr) != 0:
        ln: int32 = js_array_len(arr)
        m: int32 = 0
        while m < ln:
            ccid: int32 = _find_cre_by_obj(js_array_get(arr, m))
            if ccid >= 0 and cre_gone[ccid] == 0 and cx_slot[ccid] < 0:
                ei: int32 = 0
                if cre_is_text[ccid] == 0:
                    ec = ec + 1
                    ei = ec
                cs: int32 = _cx_reg(ccid, parent_slot, pel, ei)
                if cs >= 0:
                    _cx_walk(cs, -1, ccid)
            m = m + 1
    if pel >= 0:
        a: int32 = 0
        while a < ap_n:
            if ap_removed[a] == 0 and ap_parent[a] == pel and ap_child[a] >= 0 \
               and cre_gone[ap_child[a]] == 0 and cx_slot[ap_child[a]] < 0:
                ei2: int32 = 0
                if cre_is_text[ap_child[a]] == 0:
                    ec = ec + 1
                    ei2 = ec
                cs2: int32 = _cx_reg(ap_child[a], parent_slot, pel, ei2)
                if cs2 >= 0:
                    _cx_walk(cs2, -1, ap_child[a])
            a = a + 1
    else:
        b: int32 = 0
        while b < cc_n:
            if cc_removed[b] == 0 and cc_owner[b] == pcid and cc_child[b] >= 0 \
               and cre_gone[cc_child[b]] == 0 and cx_slot[cc_child[b]] < 0:
                ei3: int32 = 0
                if cre_is_text[cc_child[b]] == 0:
                    ec = ec + 1
                    ei3 = ec
                cs3: int32 = _cx_reg(cc_child[b], parent_slot, -1, ei3)
                if cs3 >= 0:
                    _cx_walk(cs3, -1, cc_child[b])
            b = b + 1


# Rebuild the created-node overlay: every mounted created subtree, rooted at
# each registered source element.
def _cx_build():
    cx_n = 0
    z: int32 = 0
    while z < cre_n:
        cx_slot[z] = -1
        z = z + 1
    pel: int32 = 0
    while pel < dom_n:
        _cx_walk(-1, pel, -1)
        pel = pel + 1


# case-insensitive byte compare (class/id/tag/attr tokens across the JS heap).
def _ci_eq(a: Ptr[uint8], an: int32, b: Ptr[uint8], bn: int32) -> int32:
    if an != bn:
        return 0
    i: int32 = 0
    while i < an:
        if _hx_lower(a[i]) != _hx_lower(b[i]):
            return 0
        i = i + 1
    return 1


# Does whitespace-separated class string clsp[0..clsn) contain token tok[0..tn)?
def _cstr_cls_has(clsp: Ptr[uint8], clsn: int32, tok: Ptr[uint8], tn: int32) -> int32:
    i: int32 = 0
    while i < clsn:
        while i < clsn and (clsp[i] == 32 or clsp[i] == 9):
            i = i + 1
        s: int32 = i
        while i < clsn and clsp[i] != 32 and clsp[i] != 9:
            i = i + 1
        if _ci_eq(&clsp[s], i - s, tok, tn) != 0:
            return 1
    return 0


# Two cx slots share a parent (roots also require the same source parent el, so
# created roots under distinct source elements are not treated as siblings).
def _cx_same_parent(a: int32, b: int32) -> int32:
    if cx_parent[a] != cx_parent[b]:
        return 0
    if cx_parent[a] < 0 and cx_src[a] != cx_src[b]:
        return 0
    return 1


# Previous / next ELEMENT sibling cx slot of `slot`, or -1.
def _cx_prev_sib(slot: int32) -> int32:
    r: int32 = -1
    j: int32 = 0
    while j < slot:
        if cre_is_text[cx_cid[j]] == 0 and _cx_same_parent(j, slot) != 0:
            r = j
        j = j + 1
    return r


def _cx_next_sib(slot: int32) -> int32:
    j: int32 = slot + 1
    while j < cx_n:
        if cre_is_text[cx_cid[j]] == 0 and _cx_same_parent(j, slot) != 0:
            return j
        j = j + 1
    return -1


# Same element TYPE (case-insensitive tag name) for two created cx slots.
def _cx_type_eq(a: int32, b: int32) -> int32:
    ca: int32 = cx_cid[a]
    cb: int32 = cx_cid[b]
    return _ci_eq(&dom_idbuf[cre_tag_off[ca]], cre_tag_len[ca], \
                  &dom_idbuf[cre_tag_off[cb]], cre_tag_len[cb])


# 1-based element-child index of created slot counted from the END.
def _cx_child_index_from_end(slot: int32) -> int32:
    n: int32 = 0
    j: int32 = slot
    while j < cx_n:
        if cre_is_text[cx_cid[j]] == 0 and _cx_same_parent(j, slot) != 0:
            n = n + 1
        j = j + 1
    return n


# 1-based same-type index of created slot, from document start / from the end.
def _cx_of_type_index(slot: int32) -> int32:
    n: int32 = 0
    j: int32 = 0
    while j <= slot:
        if cre_is_text[cx_cid[j]] == 0 and _cx_same_parent(j, slot) != 0 \
           and _cx_type_eq(j, slot) != 0:
            n = n + 1
        j = j + 1
    return n


def _cx_of_type_index_from_end(slot: int32) -> int32:
    n: int32 = 0
    j: int32 = slot
    while j < cx_n:
        if cre_is_text[cx_cid[j]] == 0 and _cx_same_parent(j, slot) != 0 \
           and _cx_type_eq(j, slot) != 0:
            n = n + 1
        j = j + 1
    return n


# :empty over a created node — no child cx slots (element or text) at all.
def _cx_is_empty(slot: int32) -> int32:
    j: int32 = 0
    while j < cx_n:
        if cx_parent[j] == slot:
            return 0
        j = j + 1
    return 1


# Match the single compound-selector base sel[0..seln) (tag/'*', .class, #id,
# [attr]/[attr=v]) against created element at cx `slot`. Attributes/id/class are
# read from the node's live JS props (className for `class`).
def _cre_sel_match(slot: int32, sel: Ptr[uint8], seln: int32) -> int32:
    return _cid_sel_match(cx_cid[slot], sel, seln)


# cid-based version of _cre_sel_match: match the single compound base
# sel[0..seln) against a CREATED element by its cre id (tag from cre_tag_*,
# class/id/attrs from the node's live JS props). Usable for a node with no cx
# slot (e.g. a createElement'd element that was never appended) — the basis for
# element.matches()/closest() on created nodes.
def _cid_sel_match(cid: int32, sel: Ptr[uint8], seln: int32) -> int32:
    if seln == 0 or cid < 0:
        return 0
    i: int32 = 0
    if sel[0] == 42:                                      # '*'
        i = 1
    else:
        while i < seln and _sel_isname(sel[i]) != 0:
            i = i + 1
        if i > 0:
            if _ci_eq(&dom_idbuf[cre_tag_off[cid]], cre_tag_len[cid], sel, i) == 0:
                return 0
    while i < seln:
        c: uint8 = sel[i]
        if c == 46:                                       # '.class'
            i = i + 1
            s0: int32 = i
            while i < seln and _sel_isname(sel[i]) != 0:
                i = i + 1
            clsv: int32 = js_get_prop(cre_obj[cid], cast[Ptr[uint8]]("className"), 9)
            clsp: Ptr[uint8] = js_str_ptr(clsv)
            clsn: int32 = _cstr_len(clsp)
            if _is_undef_str(clsp, clsn) != 0:
                clsn = 0
            if _cstr_cls_has(clsp, clsn, &sel[s0], i - s0) == 0:
                return 0
        elif c == 35:                                     # '#id'
            i = i + 1
            s1: int32 = i
            while i < seln and _sel_isname(sel[i]) != 0:
                i = i + 1
            idv: int32 = js_get_prop(cre_obj[cid], cast[Ptr[uint8]]("id"), 2)
            idp: Ptr[uint8] = js_str_ptr(idv)
            idn: int32 = _cstr_len(idp)
            if _is_undef_str(idp, idn) != 0:
                idn = 0
            if _ci_eq(idp, idn, &sel[s1], i - s1) == 0:
                return 0
        elif c == 91:                                     # '[attr]' / '[attr OP v]'
            i = i + 1
            ns0: int32 = i
            while i < seln and _sel_attr_name_end(sel[i]) == 0:
                i = i + 1
            nn: int32 = i - ns0
            k: int32 = 0
            while k < nn and k < 63:
                g_selattr[k] = sel[ns0 + k]
                k = k + 1
            g_selattr[k] = 0
            op: int32 = 0                                  # 0 '=' 1 ^= 2 $= 3 *= 4 ~= 5 |=
            if i < seln and sel[i] == 94:
                op = 1
                i = i + 1
            elif i < seln and sel[i] == 36:
                op = 2
                i = i + 1
            elif i < seln and sel[i] == 42:
                op = 3
                i = i + 1
            elif i < seln and sel[i] == 126:
                op = 4
                i = i + 1
            elif i < seln and sel[i] == 124:
                op = 5
                i = i + 1
            hasval: int32 = 0
            vs0: int32 = 0
            vn: int32 = 0
            if i < seln and sel[i] == 61:                 # '='
                i = i + 1
                q: uint8 = 0
                if i < seln and (sel[i] == 34 or sel[i] == 39):
                    q = sel[i]
                    i = i + 1
                vs0 = i
                while i < seln and sel[i] != 93 and (q == 0 or sel[i] != q):
                    i = i + 1
                vn = i - vs0
                if q != 0 and i < seln and sel[i] == q:
                    i = i + 1
                hasval = 1
            if i < seln and sel[i] == 93:                 # ']'
                i = i + 1
            av: int32 = js_get_prop(cre_obj[cid], &g_selattr[0], cast[uint64](nn))
            ap: Ptr[uint8] = js_str_ptr(av)
            an: int32 = _cstr_len(ap)
            if an == 0 or _is_undef_str(ap, an) != 0:
                return 0
            if hasval != 0:
                if _attr_op_match(ap, an, &sel[vs0], vn, op) == 0:
                    return 0
        else:
            break
    return 1


# Does compound `c` (base + structural pseudos) match created cx slot `slot`?
def _cre_compound_matches(slot: int32, c: int32) -> int32:
    if cre_is_text[cx_cid[slot]] != 0:
        return 0
    off: int32 = g_comp_off[c]
    ln: int32 = g_comp_len[c]
    bl: int32 = 0
    while bl < ln and g_selbuf[off + bl] != 58:
        bl = bl + 1
    if bl > 0:
        if _cre_sel_match(slot, &g_selbuf[off], bl) == 0:
            return 0
    p: int32 = off + bl
    while p < off + ln and g_selbuf[p] == 58:             # ':'
        p = p + 1
        ps: int32 = p
        while p < off + ln and _sel_isname(g_selbuf[p]) != 0:
            p = p + 1
        pl: int32 = p - ps
        if _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("first-child"), 11) != 0:
            if _cx_prev_sib(slot) >= 0:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("last-child"), 10) != 0:
            if _cx_next_sib(slot) >= 0:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("only-child"), 10) != 0:
            if _cx_prev_sib(slot) >= 0 or _cx_next_sib(slot) >= 0:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("empty"), 5) != 0:
            if _cx_is_empty(slot) == 0:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("first-of-type"), 13) != 0:
            if _cx_of_type_index(slot) != 1:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("last-of-type"), 12) != 0:
            if _cx_of_type_index_from_end(slot) != 1:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("only-of-type"), 12) != 0:
            if _cx_of_type_index(slot) != 1 or _cx_of_type_index_from_end(slot) != 1:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-child"), 9) != 0 or \
             _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-last-child"), 14) != 0 or \
             _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-of-type"), 11) != 0 or \
             _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-last-of-type"), 16) != 0:
            kind: int32 = 0
            if _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-last-child"), 14) != 0:
                kind = 1
            elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-of-type"), 11) != 0:
                kind = 2
            elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("nth-last-of-type"), 16) != 0:
                kind = 3
            if p < off + ln and g_selbuf[p] == 40:        # '('
                p = p + 1
                ncs: int32 = p
                while p < off + ln and g_selbuf[p] != 41:
                    p = p + 1
                _parse_nth(ncs, p)
                if p < off + ln and g_selbuf[p] == 41:
                    p = p + 1
                idx: int32 = cx_eidx[slot]
                if kind == 1:
                    idx = _cx_child_index_from_end(slot)
                elif kind == 2:
                    idx = _cx_of_type_index(slot)
                elif kind == 3:
                    idx = _cx_of_type_index_from_end(slot)
                if _nth_match(idx, g_nth_a, g_nth_b) == 0:
                    return 0
            else:
                return 0
        elif _bytes_eq(&g_selbuf[ps], pl, cast[Ptr[uint8]]("not"), 3) != 0:
            if p < off + ln and g_selbuf[p] == 40:        # '('
                p = p + 1
                nots: int32 = p
                while p < off + ln and g_selbuf[p] != 41:
                    p = p + 1
                note: int32 = p
                if p < off + ln and g_selbuf[p] == 41:
                    p = p + 1
                while nots < note and g_selbuf[nots] == 32:
                    nots = nots + 1
                while note > nots and g_selbuf[note - 1] == 32:
                    note = note - 1
                if note > nots and \
                   _cre_sel_match(slot, &g_selbuf[nots], note - nots) != 0:
                    return 0
            else:
                return 0
        else:
            return 0
    return 1


# Source element `src_el` OR one of its source ancestors satisfies compound `c`
# with its own left chain — the ancestor half of a chain that started in a
# created subtree and crossed up into the source tree at a created root.
def _src_ancestor_match(src_el: int32, c: int32) -> int32:
    t: int32 = _tx_by_anchor(dom_anchor[src_el])
    while t >= 0:
        if _match_chain(t, c) != 0:
            return 1
        t = tx_parent[t]
    return 0


# Match created cx `slot` against compound `c` AND its left combinator chain,
# crossing into the source tree once a created root's source parent is reached.
def _cre_match_chain(slot: int32, c: int32) -> int32:
    if _cre_compound_matches(slot, c) == 0:
        return 0
    if c == 0:
        return 1
    cb: uint8 = g_comb[c]
    if cb == 62:                                          # '>' child
        par: int32 = cx_parent[slot]
        if par >= 0:
            return _cre_match_chain(par, c - 1)
        if cx_src[slot] >= 0:
            return _match_chain(_tx_by_anchor(dom_anchor[cx_src[slot]]), c - 1)
        return 0
    if cb == 32:                                          # ' ' descendant
        a: int32 = cx_parent[slot]
        while a >= 0:
            if _cre_match_chain(a, c - 1) != 0:
                return 1
            a = cx_parent[a]
        if cx_src[slot] >= 0:
            return _src_ancestor_match(cx_src[slot], c - 1)
        return 0
    if cb == 43:                                          # '+' adjacent sibling
        pv: int32 = _cx_prev_sib(slot)
        if pv < 0:
            return 0
        return _cre_match_chain(pv, c - 1)
    if cb == 126:                                         # '~' general sibling
        sv: int32 = _cx_prev_sib(slot)
        while sv >= 0:
            if _cre_match_chain(sv, c - 1) != 0:
                return 1
            sv = _cx_prev_sib(sv)
        return 0
    return 0


# Is cx `slot` within the active query scope (g_cre_scope_*)?
def _cx_in_scope(slot: int32) -> int32:
    if g_cre_scope_doc != 0:
        return 1
    if g_cre_scope_el >= 0:
        s: int32 = slot                                   # root's source el == scope el?
        while cx_parent[s] >= 0:
            s = cx_parent[s]
        if cx_src[s] == g_cre_scope_el:
            return 1
        return 0
    if g_cre_scope_cid >= 0:
        u: int32 = cx_parent[slot]                        # strict descendant of scope cid
        while u >= 0:
            if cx_cid[u] == g_cre_scope_cid:
                return 1
            u = cx_parent[u]
        return 0
    return 0


# Does in-scope created cx `slot` match ANY sub-selector of list sel[0..seln)?
# (_sel_split must already have populated g_sellist_*.) Re-parses each sub-
# selector into g_* — the created matcher, like the source one, reads g_*.
def _cre_hit_any(slot: int32, sel: Ptr[uint8]) -> int32:
    k: int32 = 0
    while k < g_sellist_n:
        _sel_parse(&sel[g_sellist_off[k]], g_sellist_len[k])
        if g_nc != 0 and _cre_match_chain(slot, g_nc - 1) != 0:
            return 1
        k = k + 1
    return 0


# Push every in-scope created node matching selector-list sel[0..seln) onto `arr`
# (document/registration order; each node at most once).
def _cre_collect(sel: Ptr[uint8], seln: int32, arr: int32):
    _sel_split(sel, seln)
    if g_sellist_n == 0:
        return
    _cx_build()
    s: int32 = 0
    while s < cx_n:
        if cre_is_text[cx_cid[s]] == 0 and _cx_in_scope(s) != 0 \
           and _cre_hit_any(s, sel) != 0:
            js_array_push(arr, cre_obj[cx_cid[s]])
        s = s + 1


# First in-scope created node matching selector-list sel[0..seln); its JS obj,
# else -1.
def _cre_find_first(sel: Ptr[uint8], seln: int32) -> int32:
    _sel_split(sel, seln)
    if g_sellist_n == 0:
        return -1
    _cx_build()
    s: int32 = 0
    while s < cx_n:
        if cre_is_text[cx_cid[s]] == 0 and _cx_in_scope(s) != 0 \
           and _cre_hit_any(s, sel) != 0:
            return cre_obj[cx_cid[s]]
        s = s + 1
    return -1


# First created element whose id prop == idp[0..idn); its JS obj, else -1.
def _cre_find_by_id(idp: Ptr[uint8], idn: int32) -> int32:
    _cx_build()
    s: int32 = 0
    while s < cx_n:
        cid: int32 = cx_cid[s]
        if cre_is_text[cid] == 0:
            idv: int32 = js_get_prop(cre_obj[cid], cast[Ptr[uint8]]("id"), 2)
            ip: Ptr[uint8] = js_str_ptr(idv)
            inn: int32 = _cstr_len(ip)
            if _is_undef_str(ip, inn) == 0 and _bytes_eq(ip, inn, idp, idn) != 0:
                return cre_obj[cid]
        s = s + 1
    return -1


# Build a fresh JS style object with the mutable props we honour, all "".
def _new_style_obj() -> int32:
    st: int32 = js_new_object_v()
    js_set_prop(st, cast[Ptr[uint8]]("color"), 5, js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("backgroundColor"), 15, \
                js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("fontWeight"), 10, \
                js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("textAlign"), 9, \
                js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("display"), 7, \
                js_new_string(&dom_txtbuf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("width"), 5, \
                js_new_string(&dom_txtbuf[0], 0))
    # CSSStyleDeclaration methods. React 18 goes through setProperty for BOTH
    # custom properties (`--x`, which cannot be set as a camelCase member) and
    # its `display:none !important` hide path (`typeof f.setProperty ===
    # "function" ? f.setProperty("display","none","important") : ...`), so the
    # absence of these threw inside the very first commit.
    if g_proto_style != 0:
        js_set_proto_v(st, g_proto_style)
    else:
        _attach_style_natives(st)
    return st


# The stateless CSSStyleDeclaration methods — one shared copy on
# CSSStyleDeclaration.prototype, not three fresh function objects per element.
def _attach_style_natives(st: int32):
    js_set_prop(st, cast[Ptr[uint8]]("setProperty"), 11, \
                js_new_native_fn(js_hbase + NID_STYLE_SETPROP))
    js_set_prop(st, cast[Ptr[uint8]]("getPropertyValue"), 16, \
                js_new_native_fn(js_hbase + NID_STYLE_GETPROP))
    js_set_prop(st, cast[Ptr[uint8]]("removeProperty"), 14, \
                js_new_native_fn(js_hbase + NID_STYLE_REMPROP))


# CSS property name -> the camelCase member the style object stores it under
# ("background-color" -> "backgroundColor"). A custom property ("--x") and any
# already-camelCase name pass through unchanged, so setProperty and plain member
# assignment land on the SAME slot and the cascade readback sees both.
# Writes into `out` (cap bytes); returns the byte count.
def _css_prop_camel(p: Ptr[uint8], n: int32, out: Ptr[uint8], cap: int32) -> int32:
    if n >= 2 and p[0] == 45 and p[1] == 45:              # "--custom-prop"
        i0: int32 = 0
        while i0 < n and i0 < cap:
            out[i0] = p[i0]
            i0 = i0 + 1
        return i0
    w: int32 = 0
    i: int32 = 0
    up: int32 = 0
    while i < n and w < cap:
        c: uint8 = p[i]
        if c == 45:                                       # '-' -> uppercase next
            up = 1
        else:
            if up != 0:
                out[w] = _upper(c)
                up = 0
            else:
                out[w] = _hx_lower(c)
            w = w + 1
        i = i + 1
    return w


# ---- inline-style string <-> style-object routing -------------------------
# The routed properties: JS camelCase name + its length, and the CSS (kebab)
# name written into style="" / read from cssText. `background` is accepted as an
# input alias for backgroundColor. Only these participate in the cascade today;
# any other declaration is preserved on the JS object but not baked into layout.
STYLE_VAL_CAP: int32 = 256
g_stv_buf: Array[256, uint8]
g_stser:   Array[1024, uint8]
g_csst_in: Array[1024, uint8]     # stable copy of the css string being parsed


# Clear the routed camelCase props on a style object (cssText / setAttribute
# fully replace the inline style, so a re-parse starts from empty).
def _style_clear(st: int32):
    js_set_prop(st, cast[Ptr[uint8]]("color"), 5, js_new_string(&g_stv_buf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("backgroundColor"), 15, \
                js_new_string(&g_stv_buf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("fontWeight"), 10, \
                js_new_string(&g_stv_buf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("textAlign"), 9, js_new_string(&g_stv_buf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("display"), 7, js_new_string(&g_stv_buf[0], 0))
    js_set_prop(st, cast[Ptr[uint8]]("width"), 5, js_new_string(&g_stv_buf[0], 0))


# Parse a CSS declaration string p[0..n) ("color:red; display:none") into the
# style object's camelCase properties. Implements cssText / setAttribute('style')
# semantics (a full replace of the routed inline props).
def _style_apply_csstext(st: int32, pin: Ptr[uint8], nin: int32):
    # Copy the input into a stable buffer first: the parse below calls
    # js_new_string, which can move the JS string heap and dangle `pin`.
    n: int32 = nin
    if n > 1023:
        n = 1023
    ci: int32 = 0
    while ci < n:
        g_csst_in[ci] = pin[ci]
        ci = ci + 1
    p: Ptr[uint8] = &g_csst_in[0]
    _style_clear(st)
    i: int32 = 0
    while i < n:
        while i < n and (p[i] == 32 or p[i] == 9 or p[i] == 10 or \
                         p[i] == 13 or p[i] == 59):        # ws / ';'
            i = i + 1
        ps: int32 = i
        while i < n and p[i] != 58 and p[i] != 59:         # ':' or ';'
            i = i + 1
        pe: int32 = i
        while pe > ps and (p[pe - 1] == 32 or p[pe - 1] == 9):
            pe = pe - 1
        if i >= n or p[i] != 58:                           # no value -> skip
            while i < n and p[i] != 59:
                i = i + 1
            continue
        i = i + 1                                          # past ':'
        while i < n and (p[i] == 32 or p[i] == 9):
            i = i + 1
        vs: int32 = i
        while i < n and p[i] != 59:
            i = i + 1
        ve: int32 = i
        while ve > vs and (ve > 0 and (p[ve - 1] == 32 or p[ve - 1] == 9)):
            ve = ve - 1
        vl: int32 = ve - vs
        if vl > STYLE_VAL_CAP - 1:
            vl = STYLE_VAL_CAP - 1
        if vl < 0:
            vl = 0
        k: int32 = 0
        while k < vl:
            g_stv_buf[k] = p[vs + k]
            k = k + 1
        vstr: int32 = js_new_string(&g_stv_buf[0], cast[uint64](vl))
        pl: int32 = pe - ps
        if _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("color"), 5) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("color"), 5, vstr)
        elif _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("background-color"), 16) != 0 \
             or _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("background"), 10) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("backgroundColor"), 15, vstr)
        elif _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("font-weight"), 11) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("fontWeight"), 10, vstr)
        elif _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("text-align"), 10) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("textAlign"), 9, vstr)
        elif _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("display"), 7) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("display"), 7, vstr)
        elif _bytes_eq(&p[ps], pl, cast[Ptr[uint8]]("width"), 5) != 0:
            js_set_prop(st, cast[Ptr[uint8]]("width"), 5, vstr)


# Append "kebab:value;" to g_stser if the style object's camelCase prop is set.
def _stser_prop(st: int32, camel: Ptr[uint8], cl: uint64, kebab: Ptr[uint8], \
                kl: int32, w: int32) -> int32:
    v: int32 = js_get_prop(st, camel, cl)
    p: Ptr[uint8] = js_str_ptr(v)
    n: int32 = _cstr_len(p)
    if n == 0 or _is_undef_str(p, n) != 0:
        return w
    i: int32 = 0
    while i < kl and w < 1023:
        g_stser[w] = kebab[i]
        w = w + 1
        i = i + 1
    if w < 1023:
        g_stser[w] = 58                                    # ':'
        w = w + 1
    j: int32 = 0
    while j < n and w < 1023:
        g_stser[w] = p[j]
        w = w + 1
        j = j + 1
    if w < 1023:
        g_stser[w] = 59                                    # ';'
        w = w + 1
    return w


# Serialize a style object's routed props back into a CSS string (getAttribute
# ('style') / a consistent read of the inline-style store). '' when none set.
def _style_serialize(st: int32) -> int32:
    w: int32 = 0
    w = _stser_prop(st, cast[Ptr[uint8]]("color"), 5, \
                    cast[Ptr[uint8]]("color"), 5, w)
    w = _stser_prop(st, cast[Ptr[uint8]]("backgroundColor"), 15, \
                    cast[Ptr[uint8]]("background-color"), 16, w)
    w = _stser_prop(st, cast[Ptr[uint8]]("fontWeight"), 10, \
                    cast[Ptr[uint8]]("font-weight"), 11, w)
    w = _stser_prop(st, cast[Ptr[uint8]]("textAlign"), 9, \
                    cast[Ptr[uint8]]("text-align"), 10, w)
    w = _stser_prop(st, cast[Ptr[uint8]]("display"), 7, \
                    cast[Ptr[uint8]]("display"), 7, w)
    w = _stser_prop(st, cast[Ptr[uint8]]("width"), 5, \
                    cast[Ptr[uint8]]("width"), 5, w)
    return js_new_string(&g_stser[0], cast[uint64](w))


# classList: a live token-list view of an element's class attribute. Each
# element gets its own classList object carrying add/remove/toggle/contains
# native methods; a parallel dom_clsobj[] maps that object back to the element
# so the dispatcher can mutate the element's className string, which the normal
# read-back path then bakes into the rewritten source (re-applying the CSS
# cascade). Real interactive pages toggle a class far more often than they
# assign a whole className string.
def _find_el_by_clsobj(objv: int32) -> int32:
    e: int32 = 0
    while e < dom_n:
        if dom_clsobj[e] == objv:
            return e
        e = e + 1
    return -1


def _new_classlist_obj() -> int32:
    cl: int32 = js_new_object_v()
    if g_proto_clslist != 0:
        js_set_proto_v(cl, g_proto_clslist)
        return cl
    _attach_clslist_natives(cl)
    return cl


# The stateless DOMTokenList methods — one shared copy on DOMTokenList.prototype.
def _attach_clslist_natives(cl: int32):
    js_set_prop(cl, cast[Ptr[uint8]]("add"), 3, \
                js_new_native_fn(js_hbase + NID_CLSADD))
    js_set_prop(cl, cast[Ptr[uint8]]("remove"), 6, \
                js_new_native_fn(js_hbase + NID_CLSREM))
    js_set_prop(cl, cast[Ptr[uint8]]("toggle"), 6, \
                js_new_native_fn(js_hbase + NID_CLSTOG))
    js_set_prop(cl, cast[Ptr[uint8]]("contains"), 8, \
                js_new_native_fn(js_hbase + NID_CLSHAS))
    js_set_prop(cl, cast[Ptr[uint8]]("replace"), 7, \
                js_new_native_fn(js_hbase + NID_CLSREPL))
    js_set_prop(cl, cast[Ptr[uint8]]("item"), 4, \
                js_new_native_fn(js_hbase + NID_CLSITEM))


# scratch for classList string rebuilds
g_cls_scr: Array[1024, uint8]


# Does whitespace-delimited class string s[0..sn) contain the exact token
# tok[0..tn)?
def _clstr_has(s: Ptr[uint8], sn: int32, tok: Ptr[uint8], tn: int32) -> int32:
    if tn == 0:
        return 0
    i: int32 = 0
    while i < sn:
        while i < sn and (s[i] == 32 or s[i] == 9):
            i = i + 1
        st: int32 = i
        while i < sn and s[i] != 32 and s[i] != 9:
            i = i + 1
        if i - st == tn and _bytes_eq(&s[st], tn, tok, tn) != 0:
            return 1
    return 0


# Read element `el`'s current className into a NUL-terminated C-string,
# returning its length via g_cls_len. Reuses the element's JS "className" prop
# so successive classList ops compose.
g_cls_len: int32 = 0
g_cls_cur: Array[1024, uint8]


def _cls_read(el: int32) -> Ptr[uint8]:
    clv: int32 = js_get_prop(dom_obj[el], cast[Ptr[uint8]]("className"), 9)
    p: Ptr[uint8] = js_str_ptr(clv)
    n: int32 = _cstr_len(p)
    if n > 1023:
        n = 1023
    if _is_undef_str(p, n) != 0:
        n = 0
    i: int32 = 0
    while i < n:
        g_cls_cur[i] = p[i]
        i = i + 1
    g_cls_cur[n] = 0
    g_cls_len = n
    return &g_cls_cur[0]


# Write s[0..sn) back as element `el`'s className.
def _cls_write(el: int32, s: Ptr[uint8], sn: int32):
    js_set_prop(dom_obj[el], cast[Ptr[uint8]]("className"), 9, \
                js_new_string(s, cast[uint64](sn)))


# Copy class string cur[0..cn) into g_cls_scr, DROPPING every occurrence of
# token tok[0..tn); returns the new length. Tokens are re-joined by one space.
def _cls_build_without(cur: Ptr[uint8], cn: int32, tok: Ptr[uint8], \
                       tn: int32) -> int32:
    w: int32 = 0
    i: int32 = 0
    while i < cn:
        while i < cn and (cur[i] == 32 or cur[i] == 9):
            i = i + 1
        st: int32 = i
        while i < cn and cur[i] != 32 and cur[i] != 9:
            i = i + 1
        tl: int32 = i - st
        if tl == 0:
            continue
        if tl == tn and _bytes_eq(&cur[st], tl, tok, tn) != 0:
            continue                                          # drop it
        if w > 0 and w < 1023:
            g_cls_scr[w] = 32
            w = w + 1
        k: int32 = 0
        while k < tl and w < 1023:
            g_cls_scr[w] = cur[st + k]
            w = w + 1
            k = k + 1
    return w


# Append token tok[0..tn) to class string cur[0..cn) in g_cls_scr; returns len.
def _cls_build_with(cur: Ptr[uint8], cn: int32, tok: Ptr[uint8], \
                    tn: int32) -> int32:
    w: int32 = 0
    while w < cn and w < 1023:
        g_cls_scr[w] = cur[w]
        w = w + 1
    if w > 0 and w < 1023:
        g_cls_scr[w] = 32
        w = w + 1
    k: int32 = 0
    while k < tn and w < 1023:
        g_cls_scr[w] = tok[k]
        w = w + 1
        k = k + 1
    return w


# Node-identity plumbing shared by EVERY node object the engine mints (source
# elements, createElement/createElementNS, cloneNode, innerHTML fragments, text
# and comment nodes, fragments). `ownerDocument` is the single most-demanded
# property in a framework mount path: React's listenToAllSupportedEvents reads
# `container.ownerDocument[marker]` before it renders anything, and its host
# config creates every child through `(9===n.nodeType?n:n.ownerDocument)
# .createElement(...)` — with it undefined, createRoot() threw on the first line.
# `proto` links the node into the DOM class chain so `x instanceof Node` works
# (0 = leave the default Object.prototype link, e.g. before the interfaces are
# built).
def _node_identity(o: int32, proto: int32):
    if js_doc != 0:
        js_set_prop(o, cast[Ptr[uint8]]("ownerDocument"), 13, js_doc)
    if proto != 0:
        js_set_proto_v(o, proto)


# Install the STATELESS element methods on HTMLElement.prototype, ONCE.
#
# They used to be stamped as own properties of every element object, and each
# `js_new_native_fn` allocates a JS object: MEASURED at ~46 objects per
# registered element, of which 32 were these methods. With MAX_OBJ = 40000 and
# DOM_MAX = 1024 that meant a SINGLE `document.getElementsByTagName("*")` on any
# page with ~870+ elements registered enough elements to exhaust the object pool
# outright — "object pool exhausted", JSERR, and every remaining script on the
# page dead. en.wikipedia.org (4018 elements) and wiki.archlinux.org (2151) both
# died exactly there.
#
# Hoisting them to the prototype is also what a real browser does: in Chromium
# `a.appendChild === b.appendChild` is TRUE (both resolve to the one
# Node.prototype.appendChild), and `Object.keys(el)` does NOT list methods.
# Own-property lookups still find them through the obj_proto chain, and an
# element that needs to SHADOW one (createElementNS' namespaceURI) still can.
# Does the source tag name span [ns, ns+nl) declare a reflected `src` / `href` /
# `alt` IDL attribute? (Chromium-verified sets; see the call site.)
def _tag_has_src(ns: uint64, nl: uint64) -> int32:
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("img")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("input")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("script")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("iframe")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("embed")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("source")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("track")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("video")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("audio")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("frame")) != 0:
        return 1
    return 0


def _tag_has_href(ns: uint64, nl: uint64) -> int32:
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("a")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("area")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("link")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("base")) != 0:
        return 1
    return 0


def _tag_has_alt(ns: uint64, nl: uint64) -> int32:
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("img")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("input")) != 0:
        return 1
    if _hx_name_eq(ns, nl, cast[Ptr[uint8]]("area")) != 0:
        return 1
    return 0


def _attach_proto_methods(p: int32):
    # Element.namespaceURI. Every element the HTML parser produces is in the
    # XHTML namespace; createElementNS overwrites this per element afterwards.
    # React's host-context stack reads `node.namespaceURI` to decide whether to
    # create children with createElement or createElementNS.
    js_set_prop(p, cast[Ptr[uint8]]("namespaceURI"), 12, \
                js_new_string(cast[Ptr[uint8]]("http://www.w3.org/1999/xhtml"), 28))
    _attach_el_natives(p)


# Attach the element-level native methods to a DOM element object.
def _attach_el_methods(o: int32):
    _node_identity(o, g_proto_elem)
    # The stateless methods live on HTMLElement.prototype (see
    # _attach_proto_methods) — inherited, not copied. Only elements created
    # BEFORE the interfaces exist (g_proto_elem == 0) need their own copy.
    if g_proto_elem == 0:
        _attach_el_natives(o)
    _attach_validity(o)


# Elements BARRED FROM CONSTRAINT VALIDATION have no ValidityState at all.
# VERIFIED against `chromium --headless`: on div / span / a / form,
# `validity`, `willValidate` and `validationMessage` are ALL undefined — only
# input / textarea / select / button carry them (a <form> keeps checkValidity()
# but has no `validity`). We used to stamp the trio onto EVERY element: 14
# property slots each (the ValidityState object, its 11 booleans,
# validationMessage, willValidate). That is both wrong and, at
# MAX_PROP = 150000, most of the reason a 4018-element page
# (en.wikipedia.org/wiki/Web_browser) exhausted the property pool outright.
def _attach_validity(o: int32):
    tn: int32 = js_get_prop(o, cast[Ptr[uint8]]("tagName"), 7)
    if js_type_of(tn) != TAG_STR:
        return
    tp: Ptr[uint8] = js_str_ptr(tn)
    tl: int32 = _cstr_len(tp)
    ctl: int32 = 0
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("INPUT"), 5) != 0:
        ctl = 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("TEXTAREA"), 8) != 0:
        ctl = 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("SELECT"), 6) != 0:
        ctl = 1
    if _bytes_eq(tp, tl, cast[Ptr[uint8]]("BUTTON"), 6) != 0:
        ctl = 1
    if ctl == 0:
        return
    # ValidityState is per-element MUTABLE state (its booleans are refreshed on
    # every checkValidity/reportValidity/submit), so it cannot be shared.
    vsto: int32 = js_new_object_v()
    js_set_prop(vsto, cast[Ptr[uint8]]("valueMissing"), 12, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("typeMismatch"), 12, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("patternMismatch"), 15, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("tooLong"), 7, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("tooShort"), 8, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("rangeUnderflow"), 14, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("rangeOverflow"), 13, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("stepMismatch"), 12, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("badInput"), 8, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("customError"), 11, js_bool(0))
    js_set_prop(vsto, cast[Ptr[uint8]]("valid"), 5, js_bool(1))
    js_set_prop(o, cast[Ptr[uint8]]("validity"), 8, vsto)
    js_set_prop(o, cast[Ptr[uint8]]("validationMessage"), 17, \
                js_new_string(cast[Ptr[uint8]](""), 0))
    js_set_prop(o, cast[Ptr[uint8]]("willValidate"), 12, js_bool(1))


# The stateless half: every element method whose behaviour depends only on the
# receiver (`this`), so ONE function object can serve every element.
def _attach_el_natives(o: int32):
    js_set_prop(o, cast[Ptr[uint8]]("addEventListener"), 16, \
                js_new_native_fn(js_hbase + NID_ADDEVT))
    js_set_prop(o, cast[Ptr[uint8]]("appendChild"), 11, \
                js_new_native_fn(js_hbase + NID_APPEND))
    js_set_prop(o, cast[Ptr[uint8]]("getAttribute"), 12, \
                js_new_native_fn(js_hbase + NID_GETATTR))
    js_set_prop(o, cast[Ptr[uint8]]("setAttribute"), 12, \
                js_new_native_fn(js_hbase + NID_SETATTR))
    js_set_prop(o, cast[Ptr[uint8]]("insertBefore"), 12, \
                js_new_native_fn(js_hbase + NID_INSBEF))
    js_set_prop(o, cast[Ptr[uint8]]("removeChild"), 11, \
                js_new_native_fn(js_hbase + NID_REMCHILD))
    js_set_prop(o, cast[Ptr[uint8]]("replaceChild"), 12, \
                js_new_native_fn(js_hbase + NID_REPLCHILD))
    js_set_prop(o, cast[Ptr[uint8]]("remove"), 6, \
                js_new_native_fn(js_hbase + NID_REMOVE))
    js_set_prop(o, cast[Ptr[uint8]]("click"), 5, \
                js_new_native_fn(js_hbase + NID_CLICK))
    js_set_prop(o, cast[Ptr[uint8]]("append"), 6, \
                js_new_native_fn(js_hbase + NID_APPEND_M))
    # canvas.getContext — an ACCESSOR, because attaching it universally was NOT
    # harmless: `if (el.getContext)` is a real feature-detection idiom and it was
    # truthy on every element. See NID_F_GETCTX.
    js_define_accessor(o, cast[Ptr[uint8]]("getContext"), 10, \
                       js_new_native_fn(js_hbase + NID_F_GETCTX), \
                       js_new_native_fn(js_hbase + NID_F_GETCTX_S))
    # element-scoped queries + the rest of the element API surface real pages
    # call. querySelector*/getElementsBy* scope to this element's subtree.
    js_set_prop(o, cast[Ptr[uint8]]("querySelector"), 13, \
                js_new_native_fn(js_hbase + NID_QUERY))
    js_set_prop(o, cast[Ptr[uint8]]("querySelectorAll"), 16, \
                js_new_native_fn(js_hbase + NID_QUERYALL))
    js_set_prop(o, cast[Ptr[uint8]]("getElementsByClassName"), 22, \
                js_new_native_fn(js_hbase + NID_GETBYCLASS))
    js_set_prop(o, cast[Ptr[uint8]]("getElementsByTagName"), 20, \
                js_new_native_fn(js_hbase + NID_GETBYTAG))
    js_set_prop(o, cast[Ptr[uint8]]("hasAttribute"), 12, \
                js_new_native_fn(js_hbase + NID_HASATTR))
    js_set_prop(o, cast[Ptr[uint8]]("removeAttribute"), 15, \
                js_new_native_fn(js_hbase + NID_REMATTR))
    js_set_prop(o, cast[Ptr[uint8]]("removeEventListener"), 19, \
                js_new_native_fn(js_hbase + NID_REMEVT))
    js_set_prop(o, cast[Ptr[uint8]]("dispatchEvent"), 13, \
                js_new_native_fn(js_hbase + NID_DISPATCH))
    js_set_prop(o, cast[Ptr[uint8]]("cloneNode"), 9, \
                js_new_native_fn(js_hbase + NID_CLONE))
    js_set_prop(o, cast[Ptr[uint8]]("matches"), 7, \
                js_new_native_fn(js_hbase + NID_MATCHES))
    js_set_prop(o, cast[Ptr[uint8]]("closest"), 7, \
                js_new_native_fn(js_hbase + NID_CLOSEST))
    js_set_prop(o, cast[Ptr[uint8]]("insertAdjacentHTML"), 18, \
                js_new_native_fn(js_hbase + NID_INSADJ))
    js_set_prop(o, cast[Ptr[uint8]]("contains"), 8, \
                js_new_native_fn(js_hbase + NID_CONTAINS))
    js_set_prop(o, cast[Ptr[uint8]]("getAttributeNames"), 17, \
                js_new_native_fn(js_hbase + NID_GETATTRNAMES))
    js_set_prop(o, cast[Ptr[uint8]]("hasAttributes"), 13, \
                js_new_native_fn(js_hbase + NID_HASATTRS))
    # Constraint Validation: checkValidity() on any control (and forms — the
    # dispatcher resolves a form to a whole-form check below). reportValidity()
    # behaves like checkValidity() (there is no interactive error UI to surface
    # on the host/native paths). setCustomValidity(msg) marks the control invalid
    # with a custom error until cleared with an empty string.
    # Accessors, not data properties: off-interface these must read `undefined`
    # (chromium-verified per tag — see NID_F_CV).
    js_define_accessor(o, cast[Ptr[uint8]]("checkValidity"), 13, \
                       js_new_native_fn(js_hbase + NID_F_CV), \
                       js_new_native_fn(js_hbase + NID_F_CV_S))
    js_define_accessor(o, cast[Ptr[uint8]]("reportValidity"), 14, \
                       js_new_native_fn(js_hbase + NID_F_RV), \
                       js_new_native_fn(js_hbase + NID_F_RV_S))
    js_define_accessor(o, cast[Ptr[uint8]]("setCustomValidity"), 17, \
                       js_new_native_fn(js_hbase + NID_F_SCV), \
                       js_new_native_fn(js_hbase + NID_F_SCV_S))
    # form.submit() — meaningful on a <form> (or a control inside one; the
    # dispatcher resolves the enclosing form). Attached universally like
    # getContext; harmless on a non-form (the dispatcher no-ops there).
    js_define_accessor(o, cast[Ptr[uint8]]("submit"), 6, \
                       js_new_native_fn(js_hbase + NID_F_SUBMIT), \
                       js_new_native_fn(js_hbase + NID_F_SUBMIT_S))
    # Layout geometry: getBoundingClientRect() reads the element's laid-out box
    # live from the segment table (see _el_bbox). offset*/client* are set as
    # data properties from the same box (see _set_el_geom_props / _refresh_all_geom).
    js_set_prop(o, cast[Ptr[uint8]]("getBoundingClientRect"), 21, \
                js_new_native_fn(js_hbase + NID_GETRECT))
    # getClientRects() — the per-fragment border-box list. We model one fragment
    # (the bounding box), so it returns a one-entry DOMRectList (array).
    js_set_prop(o, cast[Ptr[uint8]]("getClientRects"), 14, \
                js_new_native_fn(js_hbase + NID_GETCLIENTRECTS))


# Rebuild a parent object's live JS .children/.childNodes array with `childv`
# removed (identity match on the value handle). Keeps a readback after
# removeChild/replaceChild consistent with the mutated tree.
def _dom_children_drop(parentv: int32, childv: int32):
    old: int32 = js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8)
    if js_is_array(old) == 0:
        return
    nw: int32 = js_new_array_v()
    i: int32 = 0
    ln: int32 = js_array_len(old)
    while i < ln:
        ev: int32 = js_array_get(old, i)
        if ev != childv:
            js_array_push(nw, ev)
        i = i + 1
    js_set_prop(parentv, cast[Ptr[uint8]]("children"), 8, nw)
    js_set_prop(parentv, cast[Ptr[uint8]]("childNodes"), 10, nw)


# Rebuild a parent object's live .children/.childNodes replacing the first
# occurrence of `oldv` with `newv` (in place). If `oldv` is absent, `newv` is
# appended so the array still reflects the mount.
def _dom_children_replace(parentv: int32, oldv: int32, newv: int32):
    old: int32 = js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8)
    if js_is_array(old) == 0:
        return
    nw: int32 = js_new_array_v()
    did: int32 = 0
    i: int32 = 0
    ln: int32 = js_array_len(old)
    while i < ln:
        ev: int32 = js_array_get(old, i)
        if ev == oldv and did == 0:
            js_array_push(nw, newv)
            did = 1
        else:
            js_array_push(nw, ev)
        i = i + 1
    if did == 0:
        js_array_push(nw, newv)
    js_set_prop(parentv, cast[Ptr[uint8]]("children"), 8, nw)
    js_set_prop(parentv, cast[Ptr[uint8]]("childNodes"), 10, nw)


# Rebuild a parent object's live .children/.childNodes inserting `newv` just
# before the first occurrence of `refv`. `refv` == js_null() (or absent) appends.
def _dom_children_insert(parentv: int32, newv: int32, refv: int32):
    old: int32 = js_get_prop(parentv, cast[Ptr[uint8]]("children"), 8)
    if js_is_array(old) == 0:
        return
    nw: int32 = js_new_array_v()
    did: int32 = 0
    i: int32 = 0
    ln: int32 = js_array_len(old)
    while i < ln:
        ev: int32 = js_array_get(old, i)
        if ev == refv and did == 0 and refv != js_null():
            js_array_push(nw, newv)
            did = 1
        js_array_push(nw, ev)
        i = i + 1
    if did == 0:
        js_array_push(nw, newv)
    js_set_prop(parentv, cast[Ptr[uint8]]("children"), 8, nw)
    js_set_prop(parentv, cast[Ptr[uint8]]("childNodes"), 10, nw)


# Capture an inline event-handler attribute (onclick=/oninput=/...) source into
# dom_txtbuf. Sets g_ih_off (dom_txtbuf offset, -1 if absent) and g_ih_len.
g_ih_off: int32 = 0
g_ih_len: int32 = 0


def _idbuf_push_cstr(s: Ptr[uint8]):
    i: int32 = 0
    while s[i] != 0 and dom_idbuf_len < DOM_ID_CAP:
        dom_idbuf[dom_idbuf_len] = s[i]
        dom_idbuf_len = dom_idbuf_len + 1
        i = i + 1


def _capture_inline(te: uint64, name: Ptr[uint8]):
    g_ih_off = -1
    g_ih_len = 0
    if _hx_find_attr(g_el_ns, te, name) != 0:
        os: int32 = dom_txt_len
        osl: int32 = _attr_decode_at(&dom_txtbuf[0], dom_txt_len, DOM_TXT_CAP)
        dom_txt_len = dom_txt_len + osl
        g_ih_off = os
        g_ih_len = osl


# Classify the current g_el_* element by tag name into a dom_kind code.
def _kind_of(ns: uint64, nl: int32) -> int32:
    if _idbytes_eq(ns, ns + cast[uint64](nl), cast[Ptr[uint8]]("input"), 5) != 0:
        return 1
    if _idbytes_eq(ns, ns + cast[uint64](nl), cast[Ptr[uint8]]("textarea"), 8) != 0:
        return 2
    if _idbytes_eq(ns, ns + cast[uint64](nl), cast[Ptr[uint8]]("select"), 6) != 0:
        return 3
    if _idbytes_eq(ns, ns + cast[uint64](nl), cast[Ptr[uint8]]("button"), 6) != 0:
        return 4
    if _idbytes_eq(ns, ns + cast[uint64](nl), cast[Ptr[uint8]]("form"), 4) != 0:
        return 5
    return 0


# Build a JS string of tag-name bytes p[0..n) upper-cased (spec-uppercase
# `.tagName`, e.g. `div` -> `DIV`). The internal lowercase tag names the layout
# engine reads (dom_ns/dom_nl, cre_tag) are untouched — only the JS view is
# normalized.
g_tagup: Array[64, uint8]


def _tagname_upper(p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    while i < n and i < 63:
        g_tagup[i] = _upper(p[i])
        i = i + 1
    return js_new_string(&g_tagup[0], cast[uint64](i))


# Register the source element at tree-index `txi` and return its JS object.
# Sets the g_el_* globals from the tree index, then defers to _dom_register_el
# (which dedups by anchor). Used to materialize a traversal neighbour.
def _dom_register_tx(txi: int32) -> int32:
    if txi < 0 or txi >= tx_n:
        return js_null()
    g_el_lt = cast[uint64](tx_anchor[txi])
    g_el_ns = cast[uint64](tx_ns[txi])
    g_el_nl = cast[uint64](tx_nl[txi])
    g_el_cs = cast[uint64](tx_cs[txi])
    g_el_ce = cast[uint64](tx_ce[txi])
    return _dom_register_el()


# Wire the live traversal properties of the just-registered element `idx` from
# the integer tree index: parentNode/parentElement, previous/nextElementSibling
# (+ firstChild/nextSibling aliases), children/childNodes, first/lastElement-
# Child. Each neighbour is materialized as a real element object via
# _dom_register_tx; the recursion is bounded by the DOM_MAX object cap and
# terminates because _dom_register_el dedups an already-registered anchor.
# childNodes is element-only here (text nodes are not modelled as nodes — a
# documented round-2 approximation), so firstChild==firstElementChild.
def _dom_wire_tree(idx: int32):
    if tx_built == 0:
        return
    t: int32 = _tx_by_anchor(dom_anchor[idx])
    if t < 0:
        return
    o: int32 = dom_obj[idx]
    # parent
    par: int32 = tx_parent[t]
    if par >= 0:
        pv: int32 = _dom_register_tx(par)
        js_set_prop(o, cast[Ptr[uint8]]("parentNode"), 10, pv)
        js_set_prop(o, cast[Ptr[uint8]]("parentElement"), 13, pv)
        # offsetParent — the containing block for positioning. Basic model: the
        # parent element (nearest ancestor); a root element / body reports null.
        js_set_prop(o, cast[Ptr[uint8]]("offsetParent"), 12, pv)
    else:
        js_set_prop(o, cast[Ptr[uint8]]("parentNode"), 10, js_null())
        js_set_prop(o, cast[Ptr[uint8]]("parentElement"), 13, js_null())
        js_set_prop(o, cast[Ptr[uint8]]("offsetParent"), 12, js_null())
    # siblings (same parent, document order == tx order)
    prevs: int32 = _tx_prev_sibling(t)
    nexts: int32 = _tx_next_sibling(t)
    if prevs >= 0:
        pso: int32 = _dom_register_tx(prevs)
        js_set_prop(o, cast[Ptr[uint8]]("previousElementSibling"), 22, pso)
        js_set_prop(o, cast[Ptr[uint8]]("previousSibling"), 15, pso)
    else:
        js_set_prop(o, cast[Ptr[uint8]]("previousElementSibling"), 22, js_null())
        js_set_prop(o, cast[Ptr[uint8]]("previousSibling"), 15, js_null())
    if nexts >= 0:
        nso: int32 = _dom_register_tx(nexts)
        js_set_prop(o, cast[Ptr[uint8]]("nextElementSibling"), 18, nso)
        js_set_prop(o, cast[Ptr[uint8]]("nextSibling"), 11, nso)
    else:
        js_set_prop(o, cast[Ptr[uint8]]("nextElementSibling"), 18, js_null())
        js_set_prop(o, cast[Ptr[uint8]]("nextSibling"), 11, js_null())
    # children
    ch: int32 = js_new_array_v()
    havef: int32 = 0
    firsto: int32 = js_null()
    lasto: int32 = js_null()
    nchild: int32 = 0
    k: int32 = 0
    while k < tx_n:
        if tx_parent[k] == t:
            co: int32 = _dom_register_tx(k)
            js_array_push(ch, co)
            if havef == 0:
                firsto = co
                havef = 1
            lasto = co
            nchild = nchild + 1
        k = k + 1
    js_set_prop(o, cast[Ptr[uint8]]("children"), 8, ch)
    js_set_prop(o, cast[Ptr[uint8]]("childNodes"), 10, ch)
    js_set_prop(o, cast[Ptr[uint8]]("childElementCount"), 17, \
                js_number(cast[float64](nchild)))
    js_set_prop(o, cast[Ptr[uint8]]("firstElementChild"), 17, firsto)
    js_set_prop(o, cast[Ptr[uint8]]("firstChild"), 10, firsto)
    js_set_prop(o, cast[Ptr[uint8]]("lastElementChild"), 16, lasto)
    # childNodes is element-only here (round-2 approximation), so the node-level
    # aliases mirror the element-level ones.
    js_set_prop(o, cast[Ptr[uint8]]("lastChild"), 9, lasto)


# Register (or return the existing record for) the element described by the
# current g_el_* globals. Returns its JS object value-handle.
# Expose a content attribute as a STRING data property on an element object,
# defaulting to "" when the attribute is absent (IDL String reflection). `te` is
# the offset of the start tag's '>' — the same span _hx_find_attr scans.
def _reflect_str_attr(o: int32, te: uint64, name: Ptr[uint8], nlen: uint64):
    ro: int32 = dom_txt_len
    rl: int32 = 0
    if _hx_find_attr(g_el_ns, te, name) != 0:
        rl = _attr_decode_at(&dom_txtbuf[0], dom_txt_len, DOM_TXT_CAP)
        dom_txt_len = dom_txt_len + rl
    js_set_prop(o, name, nlen, js_new_string(&dom_txtbuf[ro], cast[uint64](rl)))


# Expose a URL-VALUED content attribute (href / src) as the IDL property. Unlike
# _reflect_str_attr this reflects the value RESOLVED against the document base
# URL, which is what every browser returns and what a page that re-navigates
# through `a.href` depends on. `getAttribute('href')` keeps returning the raw
# string (it reads the source span directly and never comes through here) —
# measured in chromium, which likewise returns "?a=1" from getAttribute and
# "file:///…/page.html?a=1" from .href.
#
# When the front-end never supplied a document URL (base_url_len == 0) the
# resolver copies the reference through unchanged, so this is byte-identical to
# _reflect_str_attr and no existing render moves.
def _reflect_url_attr(o: int32, te: uint64, name: Ptr[uint8], nlen: uint64):
    ro: int32 = dom_txt_len
    rl: int32 = 0
    present: int32 = 0
    if _hx_find_attr(g_el_ns, te, name) != 0:
        present = 1
        rl = _attr_decode_at(&dom_txtbuf[0], dom_txt_len, DOM_TXT_CAP)
        dom_txt_len = dom_txt_len + rl
    if present != 0 and base_url_len > 0:
        # HTML "parse a URL" strips leading/trailing ASCII whitespace from the
        # attribute first. Measured: chromium resolves href=" sp.html " to
        # .../sp.html, and an EMPTY href="" to the document URL itself (an
        # element with NO href attribute still reflects "", which is why the
        # PRESENCE of the attribute — not its length — is what gates this).
        sa: int32 = ro
        sb: int32 = ro + rl
        while sa < sb and dom_txtbuf[sa] <= 32:
            sa = sa + 1
        while sb > sa and dom_txtbuf[sb - 1] <= 32:
            sb = sb - 1
        if sb <= sa:
            # RFC 3986 5.3: an EMPTY reference resolves to the base URL with its
            # fragment removed. (lib/web/js/builtins/url.ad's _url_resolve takes
            # the relative-path merge branch here and yields the base DIRECTORY,
            # so the empty case is resolved directly. chromium: href="" reads
            # back as the page's own URL.)
            fe: int32 = 0
            while fe < base_url_len and base_url[fe] != 35:
                fe = fe + 1
            js_set_prop(o, name, nlen, js_new_string(&base_url[0], cast[uint64](fe)))
            return
        n2: int32 = _url_resolve(&dom_txtbuf[sa], sb - sa, &base_url[0], base_url_len)
        js_set_prop(o, name, nlen, js_new_string(&url_buf_a[0], cast[uint64](n2)))
        return
    js_set_prop(o, name, nlen, js_new_string(&dom_txtbuf[ro], cast[uint64](rl)))


def _dom_register_el() -> int32:
    anchor: int32 = cast[int32](g_el_lt)
    ex: int32 = _dom_lookup_anchor(anchor)
    if ex >= 0:
        return dom_obj[ex]
    if dom_n >= DOM_MAX:
        # SAY SO. Returning a bare `undefined` here is what made a too-small
        # DOM_MAX look like a bug in the PAGE: getElementsByTagName reported the
        # right length while entries past the cap were undefined, and the page's
        # own `a[i].getAttribute(...)` loop threw. One latched line names the
        # real cause and gives the number to size the cap against.
        if dom_warn_max == 0:
            dom_warn_max = 1
            js_out_note(cast[Ptr[uint8]]("[engine] CEILING DOM_MAX reached: further elements are undefined to script. DOM_MAX="), DOM_MAX)
        return js_undefined()
    idx: int32 = dom_n
    dom_anchor[idx] = anchor
    dom_cstart[idx] = cast[int32](g_el_cs)
    dom_cend[idx] = cast[int32](g_el_ce)
    dom_ns[idx] = cast[int32](g_el_ns)
    dom_nl[idx] = cast[int32](g_el_nl)
    te: uint64 = g_el_cs - 1                              # the '>' of the start tag
    # GEOMETRY PREFIX ONLY (round 9). This used to snapshot the element's FULL
    # textContent *and* its full raw innerHTML into the shared 64 KiB dom_txtbuf
    # — for EVERY element, so <html> and <body> alone (each holding the whole
    # document twice over) exhausted it before the page's third element
    # registered. Everything after that got a zero-length baseline, which is why
    # document.body.textContent came back "" on real pages, and why raising the
    # buffer was a trap: the readback trusted the full baseline, compared it
    # against a js_str_ptr() readback truncated at 64 KiB, concluded <body> had
    # been rewritten, and re-emitted google.com as escaped text (29 -> 0 segs).
    #
    # Now: textContent/innerHTML are LAZY accessors on HTMLElement.prototype
    # (NID_TC_GET / NID_IH_GET) computed from [cstart,cend) on first access, and
    # the readback re-derives the original by STREAMING the same walk
    # (_text_span_eq), so no stored baseline is needed at all. dom_txtbuf keeps
    # only a DOM_TXT_EL-byte prefix per element, which is all _el_bbox's
    # segment matcher ever reads.
    ot: int32 = dom_txt_len
    otl: int32 = _extract_text(g_el_cs, g_el_ce, ot)
    dom_txt_len = ot + otl
    dom_orig_off[idx] = ot
    dom_orig_len[idx] = otl
    if dom_txt_len >= DOM_TXT_CAP - 1:
        if dom_warn_txt == 0:
            dom_warn_txt = 1
            js_out_note(cast[Ptr[uint8]]("[engine] CEILING DOM_TXT_CAP reached: element geometry prefixes truncated from here on (text/DOM reads are unaffected). DOM_TXT_CAP="), DOM_TXT_CAP)
    # id attribute
    ido: int32 = dom_idbuf_len
    idl: int32 = 0
    if _hx_find_attr(g_el_ns, te, cast[Ptr[uint8]]("id")) != 0:
        idl = _attr_decode_at(&dom_idbuf[0], dom_idbuf_len, DOM_ID_CAP)
        dom_idbuf_len = dom_idbuf_len + idl
    dom_id_off[idx] = ido
    dom_id_len[idx] = idl
    # class attribute (original)
    oc: int32 = dom_txt_len
    ocl: int32 = 0
    if _hx_find_attr(g_el_ns, te, cast[Ptr[uint8]]("class")) != 0:
        ocl = _attr_decode_at(&dom_txtbuf[0], dom_txt_len, DOM_TXT_CAP)
        dom_txt_len = dom_txt_len + ocl
    dom_origcls_off[idx] = oc
    dom_origcls_len[idx] = ocl
    # inline event-handler attributes (source stored; run on the event)
    dom_onclick_fn[idx] = -1
    _capture_inline(te, cast[Ptr[uint8]]("onclick"))
    dom_onclick_src[idx] = g_ih_off
    dom_onclick_srclen[idx] = g_ih_len
    dom_oninput_fn[idx] = -1
    _capture_inline(te, cast[Ptr[uint8]]("oninput"))
    dom_oninput_src[idx] = g_ih_off
    dom_oninput_srclen[idx] = g_ih_len
    dom_onchange_fn[idx] = -1
    _capture_inline(te, cast[Ptr[uint8]]("onchange"))
    dom_onchange_src[idx] = g_ih_off
    dom_onchange_srclen[idx] = g_ih_len
    dom_onsubmit_fn[idx] = -1
    _capture_inline(te, cast[Ptr[uint8]]("onsubmit"))
    dom_onsubmit_src[idx] = g_ih_off
    dom_onsubmit_srclen[idx] = g_ih_len
    # form-control metadata: kind, original value, original checked state.
    kind: int32 = _kind_of(g_el_ns, cast[int32](g_el_nl))
    dom_kind[idx] = kind
    dom_origchecked[idx] = -1
    ovo: int32 = dom_txt_len
    ovl: int32 = 0
    if kind == 2:                                        # textarea: value = text
        k: int32 = 0
        while k < otl and dom_txt_len < DOM_TXT_CAP:
            dom_txtbuf[dom_txt_len] = dom_txtbuf[ot + k]
            dom_txt_len = dom_txt_len + 1
            ovl = ovl + 1
            k = k + 1
    elif kind == 3:                                      # select: selected option
        sl: int32 = _select_text(g_el_cs)
        sk: int32 = 0
        while sk < sl and dom_txt_len < DOM_TXT_CAP:
            dom_txtbuf[dom_txt_len] = fbuf[sk]
            dom_txt_len = dom_txt_len + 1
            ovl = ovl + 1
            sk = sk + 1
    elif kind == 1:                                      # input: value attribute
        if _hx_find_attr(g_el_ns, te, cast[Ptr[uint8]]("value")) != 0:
            ovl = _attr_decode_at(&dom_txtbuf[0], dom_txt_len, DOM_TXT_CAP)
            dom_txt_len = dom_txt_len + ovl
        if _input_type_is(g_el_ns, te, cast[Ptr[uint8]]("checkbox")) != 0 or \
           _input_type_is(g_el_ns, te, cast[Ptr[uint8]]("radio")) != 0:
            if _has_word(g_el_ns, te, cast[Ptr[uint8]]("checked")) != 0:
                dom_origchecked[idx] = 1
            else:
                dom_origchecked[idx] = 0
    dom_origval_off[idx] = ovo
    dom_origval_len[idx] = ovl
    # the JS object
    o: int32 = js_new_object_v()
    # NO eager textContent / innerHTML own properties: both are lazy accessors
    # inherited from HTMLElement.prototype and materialise on first access (own
    # props win over prototype accessors in member_get AND member_set, so the
    # memoised value takes over from then on).
    js_set_prop(o, cast[Ptr[uint8]]("id"), 2, \
                js_new_string(&dom_idbuf[ido], cast[uint64](idl)))
    js_set_prop(o, cast[Ptr[uint8]]("className"), 9, \
                js_new_string(&dom_txtbuf[oc], cast[uint64](ocl)))
    js_set_prop(o, cast[Ptr[uint8]]("tagName"), 7, \
                _tagname_upper(&src_ptr[g_el_ns], cast[int32](g_el_nl)))
    # node-identity properties (frameworks branch on node.nodeType === 1).
    # nodeName == tagName for elements; nodeValue is null (only text nodes carry
    # a value). ELEMENT_NODE = 1.
    js_set_prop(o, cast[Ptr[uint8]]("nodeType"), 8, js_number(cast[float64](1)))
    js_set_prop(o, cast[Ptr[uint8]]("nodeName"), 8, \
                _tagname_upper(&src_ptr[g_el_ns], cast[int32](g_el_nl)))
    js_set_prop(o, cast[Ptr[uint8]]("nodeValue"), 9, js_null())
    # REFLECTED STRING IDL ATTRIBUTES. `img.src`, `a.href`, `script.src`,
    # `el.title`/`img.alt` are declared as (USV)String in the IDL, so per spec
    # they are ALWAYS a string — the empty string when the content attribute is
    # absent, never undefined.
    #
    # They were not exposed at all, so `el.src` read `undefined` on every
    # element. Google's homepage does
    #     for (var a = document.getElementsByTagName("img"), ...)
    #         d.src.substring(0,5) !== "data:" && ...
    # which threw "cannot read property 'substring' of null or undefined" and
    # killed the script. Reflecting the raw attribute value (rather than the
    # spec's absolutised URL — the engine has no base URL on the host path) is
    # what `getAttribute` already returns, and the "" default is the part real
    # pages actually depend on.
    # ...but only on the interfaces that DECLARE them. Reflecting src/href/alt
    # onto every element made `el.src` a string on a <div>, where chromium says
    # undefined — and pages branch on exactly that. Verified per tag against
    # chromium --headless: src on img/input (and the other media hosts), href on
    # a/area/link/base, alt on img/input/area. `title` IS a global HTMLElement
    # attribute and DOES read "" on a <div> (measured), so it stays universal.
    if _tag_has_src(g_el_ns, g_el_nl) != 0:
        _reflect_url_attr(o, te, cast[Ptr[uint8]]("src"), 3)
    if _tag_has_href(g_el_ns, g_el_nl) != 0:
        _reflect_url_attr(o, te, cast[Ptr[uint8]]("href"), 4)
    if _tag_has_alt(g_el_ns, g_el_nl) != 0:
        _reflect_str_attr(o, te, cast[Ptr[uint8]]("alt"), 3)
    _reflect_str_attr(o, te, cast[Ptr[uint8]]("title"), 5)
    # form-control DOM properties: value / checked / type / name (+ selectedIndex).
    if kind == 1 or kind == 2 or kind == 3 or kind == 4:
        js_set_prop(o, cast[Ptr[uint8]]("value"), 5, \
                    js_new_string(&dom_txtbuf[ovo], cast[uint64](ovl)))
        # name attribute
        nmo: int32 = dom_idbuf_len
        nml: int32 = 0
        if _hx_find_attr(g_el_ns, te, cast[Ptr[uint8]]("name")) != 0:
            nml = _attr_decode_at(&dom_idbuf[0], dom_idbuf_len, DOM_ID_CAP)
            dom_idbuf_len = dom_idbuf_len + nml
        js_set_prop(o, cast[Ptr[uint8]]("name"), 4, \
                    js_new_string(&dom_idbuf[nmo], cast[uint64](nml)))
        # type (input: attr or "text"; else the tag name)
        tyo: int32 = dom_idbuf_len
        tyl: int32 = 0
        if kind == 1:
            if _hx_find_attr(g_el_ns, te, cast[Ptr[uint8]]("type")) != 0:
                pt: uint64 = g_attr_start
                while pt < g_attr_end and dom_idbuf_len < DOM_ID_CAP:
                    dom_idbuf[dom_idbuf_len] = _hx_lower(src_ptr[pt])
                    dom_idbuf_len = dom_idbuf_len + 1
                    tyl = tyl + 1
                    pt = pt + 1
            else:
                _idbuf_push_cstr(cast[Ptr[uint8]]("text"))
                tyl = 4
        js_set_prop(o, cast[Ptr[uint8]]("type"), 4, \
                    js_new_string(&dom_idbuf[tyo], cast[uint64](tyl)))
        if dom_origchecked[idx] >= 0:
            js_set_prop(o, cast[Ptr[uint8]]("checked"), 7, \
                        js_bool(dom_origchecked[idx]))
        if kind == 3:
            js_set_prop(o, cast[Ptr[uint8]]("selectedIndex"), 13, \
                        js_number(cast[float64](_select_index(g_el_cs))))
    _attach_el_methods(o)
    # style / classList / dataset are LAZY accessors on HTMLElement.prototype
    # (NID_STYLE_ACC / NID_CLS_ACC / NID_DS_ACC): 3 of the ~5.8 JS objects this
    # used to allocate per element, for a surface most elements never expose.
    dom_clsobj[idx] = -1
    dom_obj[idx] = o
    dom_n = idx + 1
    # Wire live traversal links. This recurses into _dom_register_el for each
    # neighbour, which CLOBBERS the g_el_* scan globals; save + restore them so
    # callers that read g_el_lt (e.g. _lookup_or_register, _radio_enforce_group)
    # right after this returns still see THIS element.
    s_lt: uint64 = g_el_lt
    s_ns: uint64 = g_el_ns
    s_nl: uint64 = g_el_nl
    s_cs: uint64 = g_el_cs
    s_ce: uint64 = g_el_ce
    _dom_wire_tree(idx)
    g_el_lt = s_lt
    g_el_ns = s_ns
    g_el_nl = s_nl
    g_el_cs = s_cs
    g_el_ce = s_ce
    # Seed the geometry data properties from the current layout (best-effort —
    # they are refreshed for all elements after the pre-layout pass, and
    # getBoundingClientRect() always recomputes live).
    _set_el_geom_props(o, idx)
    return o


# ====================================================================
# LAYOUT GEOMETRY — getBoundingClientRect() / offset*/client* / offsetParent /
# getComputedStyle(). These expose the coordinates the layout engine (lib/web/
# layout) already computed as the standard DOM geometry surface. An element's
# box is the bounding rectangle of the rendered SEGMENTS whose text reconstructs
# the element's text content, read in document order from the seg_* table:
# seg_x is a segment's pixel-x, seg_line its grid ROW (px-y = row*LINE_H), and a
# run is seg_len chars wide at CELL_W px/char. NO layout is re-implemented —
# geometry is read back after a layout pass (a pre-layout runs before a page's
# <script>s so scripts observe box metrics; see _run_scripts). Limitation: a
# text-less element (pure box / image-only) yields an empty rect (found = 0),
# and a segment merged across inline siblings over-approximates the box width.
# ====================================================================
g_geom_x: int32 = 0
g_geom_y: int32 = 0
g_geom_w: int32 = 0
g_geom_h: int32 = 0
g_geom_s0: int32 = -1                 # first segment of the matched run (colour source)
g_geom_found: int32 = 0


# ASCII whitespace? (space, tab, LF, CR)
def _geom_is_ws(c: uint8) -> int32:
    if c == 32 or c == 9 or c == 10 or c == 13:
        return 1
    return 0


# Whitespace-insensitive forward match: does the run of segment texts starting
# at segment `si0` (document order) reconstruct the element text E =
# dom_txtbuf[toff .. toff+tlen)? Only NON-space characters are compared, in
# order. Returns the LAST segment index consumed once ALL of E is matched, else
# -1 (mismatch or E not fully covered from si0).
def _geom_match_fwd(si0: int32, toff: int32, tlen: int32) -> int32:
    ei: int32 = toff
    eend: int32 = toff + tlen
    while ei < eend and _geom_is_ws(dom_txtbuf[ei]) != 0:
        ei = ei + 1
    if ei >= eend:
        return -1                                     # empty / whitespace-only text
    si: int32 = si0
    last: int32 = -1
    while si < cast[int32](n_segs) and ei < eend:
        so: int32 = seg_off[si]
        sl: int32 = seg_len[si]
        ci: int32 = 0
        consumed: int32 = 0
        while ci < sl and ei < eend:
            sc: uint8 = seg_text_buf[cast[uint64](so + ci)]
            if _geom_is_ws(sc) != 0:
                ci = ci + 1
                continue
            while ei < eend and _geom_is_ws(dom_txtbuf[ei]) != 0:
                ei = ei + 1
            if ei >= eend:
                break
            if dom_txtbuf[ei] != sc:
                return -1                             # not this element's run
            ei = ei + 1
            ci = ci + 1
            consumed = 1
        if consumed != 0:
            last = si
        si = si + 1
    if ei >= eend:
        return last
    return -1


# The ebox registry slot recorded by the layout engine for element `el`, or -1
# when this element never opened a block box (an inline / text-only element, or
# a node created at runtime that has not been laid out).
def _el_ebox(el: int32) -> int32:
    if el < 0 or el >= dom_n:
        return -1
    return _ebox_find(dom_anchor[el])


# Fill g_geom_* from the element's REAL laid-out CSS BORDER box, recorded by the
# layout engine in the ebox registry. Returns 1 on success, 0 when this element
# has no recorded box (the caller then falls back to the text-ink estimate).
#
# The registry stores the CONTENT column [cx, cr) and the content row span
# [top, bot); the cascade's resolved padding is a per-axis SUM (the engine has no
# per-side padding), so it is split evenly, and the border adds `bord` px per
# side. An explicitly sized box reports its exact CSS height rather than the
# row-quantised span, so `height:80px` reads back as 80 and not a rounded 96.
def _el_bbox_from_ebox(el: int32) -> int32:
    ei: int32 = _el_ebox(el)
    if ei < 0:
        return 0
    cx: int32 = ebox_cx[ei]
    cr: int32 = ebox_cr[ei]
    if cr < cx:
        cr = cx
    padx: int32 = ebox_padx[ei]
    pady: int32 = ebox_pady[ei]
    bord: int32 = ebox_bord[ei]
    padl: int32 = padx / 2
    # BORDER-box height in true CSS px, stamped by the close (an explicit CSS
    # height, or the row span corrected by the children's quantisation debt).
    # Fall back to the raw row span if this box somehow never closed.
    bh: int32 = ebox_bbh[ei]
    if bh < 0:
        bh = (ebox_bot[ei] - ebox_top[ei]) * LINE_H + pady + 2 * bord
    if bh < 0:
        bh = 0
    # Undo the engine-vs-CSS skew this element's ancestors introduced (a bordered
    # ancestor's CELL_W inset; a padded ancestor's baked top padding + border) so
    # the reported box is in TRUE document coordinates, not grid coordinates.
    bx: int32 = cx - padl - ebox_bins[ei] - ebox_skx[ei]
    if bx < 0:
        bx = 0
    g_geom_x = bx
    g_geom_y = ebox_top[ei] * LINE_H + ebox_sky[ei]
    g_geom_w = (cr - cx) + padx + 2 * bord
    g_geom_h = bh
    g_geom_found = 1
    return 1


# Compute element `el`'s laid-out box into g_geom_* (pixels). Sets g_geom_found
# = 1 on success, 0 when the element has neither a recorded CSS box nor
# matchable rendered text.
#
# TWO SOURCES, best first:
#   1. the ebox registry — the element's REAL border box as the layout engine
#      laid it out (block-level elements). This is what a browser reports.
#   2. the rendered TEXT SEGMENTS — a bounding box over the runs that reconstruct
#      the element's text. Used for inline elements (which open no block box) and
#      as the fallback. It measures text INK, so it under-reports a sized box.
# The segment scan runs FIRST regardless because it also resolves g_geom_s0, the
# segment getComputedStyle reads the used colour/weight from; the ebox box then
# OVERRIDES the geometry when the element has one.
def _el_bbox(el: int32):
    g_geom_found = 0
    g_geom_x = 0
    g_geom_y = 0
    g_geom_w = 0
    g_geom_h = 0
    g_geom_s0 = -1
    if el < 0 or el >= dom_n:
        return
    if n_segs == 0:
        _el_bbox_from_ebox(el)
        return
    toff: int32 = dom_orig_off[el]
    tlen: int32 = dom_orig_len[el]
    s0: int32 = -1
    s1: int32 = -1
    si: int32 = 0
    while si < cast[int32](n_segs):
        r: int32 = _geom_match_fwd(si, toff, tlen)
        if r >= 0:
            s0 = si
            s1 = r
            si = cast[int32](n_segs)                  # break
        else:
            si = si + 1
    if s0 < 0:
        _el_bbox_from_ebox(el)                        # no text: box-only element
        return
    minx: int32 = seg_x[s0]
    maxr: int32 = seg_x[s0] + seg_len[s0] * CELL_W
    minrow: int32 = seg_line[s0]
    maxrow: int32 = seg_line[s0]
    k: int32 = s0
    while k <= s1:
        lx: int32 = seg_x[k]
        rx: int32 = seg_x[k] + seg_len[k] * CELL_W
        if lx < minx:
            minx = lx
        if rx > maxr:
            maxr = rx
        if seg_line[k] < minrow:
            minrow = seg_line[k]
        if seg_line[k] > maxrow:
            maxrow = seg_line[k]
        k = k + 1
    g_geom_x = minx
    g_geom_y = minrow * LINE_H
    g_geom_w = maxr - minx
    g_geom_h = (maxrow - minrow + 1) * LINE_H
    g_geom_s0 = s0
    g_geom_found = 1
    # Prefer the element's REAL border box when the layout engine recorded one —
    # the segment bbox above only measured its text ink. g_geom_s0 is kept so the
    # colour/weight read-back still comes from the element's own segment.
    _el_bbox_from_ebox(el)


# Current viewport scroll offset (CSS px). getBoundingClientRect()/getClientRects()
# return VIEWPORT-relative coordinates, so the page scroll is subtracted from the
# document-coordinate box the layout engine produced. The viewport's scrolling
# element is document.documentElement (falling back to document.body, and the
# window.scrollX/scrollY / pageXOffset-pageYOffset mirrors) — all read LIVE so a
# script's `document.documentElement.scrollTop = N` (or window.scrollTo) is
# honoured on the next rect query. The largest non-zero of the candidates wins so
# a script may set the offset on whichever surface it prefers.
def _page_scroll(prop: Ptr[uint8], pn: uint64, wa: Ptr[uint8], wan: uint64, \
                 wb: Ptr[uint8], wbn: uint64) -> int32:
    v: float64 = cast[float64](0)
    doc: int32 = js_global_get(cast[Ptr[uint8]]("document"), 8)
    de: int32 = js_get_prop(doc, cast[Ptr[uint8]]("documentElement"), 15)
    dv: float64 = js_to_number(js_get_prop(de, prop, pn))
    if dv > v:                                            # NaN (undefined) compares false
        v = dv
    bd: int32 = js_get_prop(doc, cast[Ptr[uint8]]("body"), 4)
    bv: float64 = js_to_number(js_get_prop(bd, prop, pn))
    if bv > v:
        v = bv
    wav: float64 = js_to_number(js_global_get(wa, wan))
    if wav > v:
        v = wav
    wbv: float64 = js_to_number(js_global_get(wb, wbn))
    if wbv > v:
        v = wbv
    return cast[int32](v)


def _page_scroll_x() -> int32:
    return _page_scroll(cast[Ptr[uint8]]("scrollLeft"), 10, \
                        cast[Ptr[uint8]]("scrollX"), 7, \
                        cast[Ptr[uint8]]("pageXOffset"), 11)


def _page_scroll_y() -> int32:
    return _page_scroll(cast[Ptr[uint8]]("scrollTop"), 9, \
                        cast[Ptr[uint8]]("scrollY"), 7, \
                        cast[Ptr[uint8]]("pageYOffset"), 11)


# Build a DOMRect-like object from the current g_geom_* values, translated to
# VIEWPORT coordinates (document box minus the current page scroll offset).
def _new_rect_obj() -> int32:
    r: int32 = js_new_object_v()
    x: float64 = cast[float64](g_geom_x - _page_scroll_x())
    y: float64 = cast[float64](g_geom_y - _page_scroll_y())
    w: float64 = cast[float64](g_geom_w)
    h: float64 = cast[float64](g_geom_h)
    js_set_prop(r, cast[Ptr[uint8]]("x"), 1, js_number(x))
    js_set_prop(r, cast[Ptr[uint8]]("y"), 1, js_number(y))
    js_set_prop(r, cast[Ptr[uint8]]("left"), 4, js_number(x))
    js_set_prop(r, cast[Ptr[uint8]]("top"), 3, js_number(y))
    js_set_prop(r, cast[Ptr[uint8]]("width"), 5, js_number(w))
    js_set_prop(r, cast[Ptr[uint8]]("height"), 6, js_number(h))
    js_set_prop(r, cast[Ptr[uint8]]("right"), 5, js_number(x + w))
    js_set_prop(r, cast[Ptr[uint8]]("bottom"), 6, js_number(y + h))
    return r


# Build the getClientRects() DOMRectList from the current g_geom_* values. We
# model an element as a single fragment, so the list holds exactly the bounding
# border box (viewport-relative, via _new_rect_obj) when the element has a box,
# and is EMPTY when it has none (found == 0) — matching the spec's "returns an
# empty list for elements with no associated CSS box". The list is a JS array so
# `.length`, `[0]` and iteration all work.
def _new_client_rects() -> int32:
    lst: int32 = js_new_array_v()
    if g_geom_found != 0:
        js_array_push(lst, _new_rect_obj())
    return lst


# Set the live geometry PROPERTIES on an element object from its current box:
# offsetWidth/Height/Left/Top, clientWidth/Height, scrollWidth/Height. Read back
# after a layout pass, these mirror what getBoundingClientRect() returns (no
# scrollbars / borders are modelled, so client == offset == scroll here).
def _set_el_geom_props(o: int32, el: int32):
    _el_bbox(el)
    w: float64 = cast[float64](g_geom_w)
    h: float64 = cast[float64](g_geom_h)
    js_set_prop(o, cast[Ptr[uint8]]("offsetWidth"), 11, js_number(w))
    js_set_prop(o, cast[Ptr[uint8]]("offsetHeight"), 12, js_number(h))
    js_set_prop(o, cast[Ptr[uint8]]("offsetLeft"), 10, js_number(cast[float64](g_geom_x)))
    js_set_prop(o, cast[Ptr[uint8]]("offsetTop"), 9, js_number(cast[float64](g_geom_y)))
    js_set_prop(o, cast[Ptr[uint8]]("clientWidth"), 11, js_number(w))
    js_set_prop(o, cast[Ptr[uint8]]("clientHeight"), 12, js_number(h))
    js_set_prop(o, cast[Ptr[uint8]]("scrollWidth"), 11, js_number(w))
    js_set_prop(o, cast[Ptr[uint8]]("scrollHeight"), 12, js_number(h))
    # scrollTop / scrollLeft: static scroll offset (0 initially). Writable data
    # properties so a script can read them and set el.scrollTop = N; interactive
    # scroll-following is deferred. Set once here (pre-script geom refresh) so a
    # script's own assignment survives.
    js_set_prop(o, cast[Ptr[uint8]]("scrollTop"), 9, js_number(cast[float64](0)))
    js_set_prop(o, cast[Ptr[uint8]]("scrollLeft"), 10, js_number(cast[float64](0)))


# Write the decimal digits of a non-negative int into buf, return the length.
def _geom_uint_str(n: int32, buf: Ptr[uint8]) -> int32:
    if n <= 0:
        buf[0] = 48                                   # '0'
        return 1
    tmp: Array[16, uint8]
    t: int32 = 0
    v: int32 = n
    while v > 0 and t < 16:
        tmp[t] = cast[uint8](48 + v % 10)
        v = v / 10
        t = t + 1
    i: int32 = 0
    while i < t:
        buf[i] = tmp[t - 1 - i]
        i = i + 1
    return t


g_geom_strbuf: Array[64, uint8]


# A CSS pixel length string "Npx" (e.g. 120 -> "120px") as a JS string value.
def _px_string(n: int32) -> int32:
    l: int32 = _geom_uint_str(n, &g_geom_strbuf[0])
    g_geom_strbuf[l] = 112                             # 'p'
    g_geom_strbuf[l + 1] = 120                         # 'x'
    return js_new_string(&g_geom_strbuf[0], cast[uint64](l + 2))


# "rgb(r, g, b)" from a 0xRRGGBB value as a JS string value.
def _rgb_string(rgb: int32) -> int32:
    w: int32 = 0
    g_geom_strbuf[w] = 114                             # 'r'
    g_geom_strbuf[w + 1] = 103                         # 'g'
    g_geom_strbuf[w + 2] = 98                          # 'b'
    g_geom_strbuf[w + 3] = 40                          # '('
    w = 4
    w = w + _geom_uint_str((rgb >> 16) & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 44                              # ','
    g_geom_strbuf[w + 1] = 32                          # ' '
    w = w + 2
    w = w + _geom_uint_str((rgb >> 8) & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 44
    g_geom_strbuf[w + 1] = 32
    w = w + 2
    w = w + _geom_uint_str(rgb & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 41                              # ')'
    w = w + 1
    return js_new_string(&g_geom_strbuf[0], cast[uint64](w))


# Does element `el`'s tag name equal the literal `lit`?
def _el_tag_is(el: int32, lit: Ptr[uint8]) -> int32:
    ln: int32 = _cstr_len(lit)
    if dom_nl[el] != ln:
        return 0
    return _idbytes_eq(cast[uint64](dom_ns[el]), cast[uint64](dom_ns[el] + dom_nl[el]), \
                       lit, ln)


# Default CSS `display` for element `el` by tag (UA stylesheet approximation):
# block-level container tags -> "block"; list items -> "list-item"; a handful of
# common table/none tags; everything else -> "inline". A script-set inline
# style.display (read by the caller) overrides this.
def _el_default_display(el: int32) -> int32:
    if el < 0 or el >= dom_n:
        return 0                                       # caller uses "block"
    if _el_tag_is(el, cast[Ptr[uint8]]("li")) != 0:
        return 2                                       # list-item
    if _el_tag_is(el, cast[Ptr[uint8]]("span")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("a")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("b")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("i")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("em")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("strong")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("code")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("small")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("label")) != 0 or \
       _el_tag_is(el, cast[Ptr[uint8]]("img")) != 0:
        return 1                                       # inline
    return 3                                           # block (div/p/h*/section/...)


# ====================================================================
# RESOLVED-VALUE HELPERS (getComputedStyle / CSSOM).
# getComputedStyle must report RESOLVED values (CSSOM "resolved value"):
# colours as rgb()/rgba(), lengths as used `px` (percentages resolved against
# the used width of the containing block). These helpers pull the used box
# geometry from the laid-out segment box (_el_bbox, over box.ad's seg_* tables)
# and resolve script-set inline declarations (el.style.<prop>) — the value a
# framework reads back straight after mutating the inline style — into that
# CSSOM form. Sentinel for "not a length I can resolve to px" (auto / keyword /
# multi-value / percent handled separately).
# ====================================================================
CS_LEN_NONE: int32 = -2000000000
g_cs_vbuf: Array[256, uint8]        # scratch: a copy of one inline-style value
g_cs_gpv:  int32 = -1               # cached getPropertyValue function value


# "rgba(r, g, b, a)" from 0xRRGGBB + an 0..255 alpha, as a JS string value. The
# alpha is emitted as a CSS number (0, 1, or 0.NN) per the serialization rules.
def _rgba_string(rgb: int32, a255: int32) -> int32:
    w: int32 = 0
    g_geom_strbuf[w] = 114                             # 'r'
    g_geom_strbuf[w + 1] = 103                         # 'g'
    g_geom_strbuf[w + 2] = 98                          # 'b'
    g_geom_strbuf[w + 3] = 97                          # 'a'
    g_geom_strbuf[w + 4] = 40                          # '('
    w = 5
    w = w + _geom_uint_str((rgb >> 16) & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 44
    g_geom_strbuf[w + 1] = 32
    w = w + 2
    w = w + _geom_uint_str((rgb >> 8) & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 44
    g_geom_strbuf[w + 1] = 32
    w = w + 2
    w = w + _geom_uint_str(rgb & 255, &g_geom_strbuf[w])
    g_geom_strbuf[w] = 44
    g_geom_strbuf[w + 1] = 32
    w = w + 2
    if a255 >= 255:
        g_geom_strbuf[w] = 49                          # '1'
        w = w + 1
    elif a255 <= 0:
        g_geom_strbuf[w] = 48                          # '0'
        w = w + 1
    else:
        hund: int32 = a255 * 100 / 255
        g_geom_strbuf[w] = 48                          # '0'
        g_geom_strbuf[w + 1] = 46                       # '.'
        g_geom_strbuf[w + 2] = cast[uint8](48 + hund / 10)
        g_geom_strbuf[w + 3] = cast[uint8](48 + hund % 10)
        w = w + 4
    g_geom_strbuf[w] = 41                              # ')'
    w = w + 1
    return js_new_string(&g_geom_strbuf[0], cast[uint64](w))


# A resolved colour string: opaque -> rgb(), translucent -> rgba().
def _cs_color_string(rgb: int32, a255: int32) -> int32:
    if a255 >= 255:
        return _rgb_string(rgb)
    return _rgba_string(rgb, a255)


# Set a resolved property under BOTH the camelCase name (…​.fontSize) and the
# CSS kebab name (…["font-size"] / getPropertyValue('font-size')).
def _cs_set2(cs: int32, camel: Ptr[uint8], cl: uint64, css: Ptr[uint8], \
             csl: uint64, val: int32):
    js_set_prop(cs, camel, cl, val)
    js_set_prop(cs, css, csl, val)


# Copy el.style.<camel> into g_cs_vbuf; returns its length (0 if unset / the JS
# "undefined" placeholder). The copy is taken immediately because js_new_string
# below can move the string heap.
def _cs_inline_len(el: int32, camel: Ptr[uint8], caml: uint64) -> int32:
    if el < 0 or el >= dom_n:
        return 0
    stv: int32 = js_get_prop(dom_obj[el], cast[Ptr[uint8]]("style"), 5)
    iv: int32 = js_get_prop(stv, camel, caml)
    ip: Ptr[uint8] = js_str_ptr(iv)
    inn: int32 = _cstr_len(ip)
    if inn <= 0 or _is_undef_str(ip, inn) != 0:
        return 0
    if inn > 255:
        inn = 255
    i: int32 = 0
    while i < inn:
        g_cs_vbuf[i] = ip[i]
        i = i + 1
    return inn


# The integer part of a leading CSS number in p[0..n) (fraction truncated), or
# CS_LEN_NONE if there is no number. Handles a leading +/-.
def _cs_num_int(p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    neg: int32 = 0
    if i < n and (p[i] == 43 or p[i] == 45):
        if p[i] == 45:
            neg = 1
        i = i + 1
    v: int32 = 0
    got: int32 = 0
    while i < n and p[i] >= 48 and p[i] <= 57:
        v = v * 10 + (cast[int32](p[i]) - 48)
        got = 1
        i = i + 1
    if got == 0:
        return CS_LEN_NONE
    if neg != 0:
        return 0 - v
    return v


# Case-insensitive compare of a unit token up[0..ul) (trailing spaces ignored)
# against a lowercase literal.
def _cs_unit_is(up: Ptr[uint8], ul: int32, lit: Ptr[uint8]) -> int32:
    while ul > 0 and (up[ul - 1] == 32 or up[ul - 1] == 9):
        ul = ul - 1
    i: int32 = 0
    while lit[i] != 0:
        if i >= ul:
            return 0
        if _hx_lower(up[i]) != lit[i]:
            return 0
        i = i + 1
    if i != ul:
        return 0
    return 1


# Index just past the numeric prefix (sign + digits + one dot) of p[0..n).
def _cs_unit_at(p: Ptr[uint8], n: int32) -> int32:
    i: int32 = 0
    if i < n and (p[i] == 43 or p[i] == 45):
        i = i + 1
    while i < n and ((p[i] >= 48 and p[i] <= 57) or p[i] == 46):
        i = i + 1
    return i


# Resolve a CSS length p[0..n) to used px for absolute units (px/em/rem; a bare
# 0 counts as 0px). em/rem resolve against `embase`. Returns CS_LEN_NONE for a
# percentage / auto / keyword / multi-value (caller handles those).
def _cs_len_px(p: Ptr[uint8], n: int32, embase: int32) -> int32:
    val: int32 = _cs_num_int(p, n)
    if val == CS_LEN_NONE:
        return CS_LEN_NONE
    ui: int32 = _cs_unit_at(p, n)
    ul: int32 = n - ui
    up: Ptr[uint8] = &p[ui]
    if ul <= 0:
        if val == 0:
            return 0
        return CS_LEN_NONE
    if _cs_unit_is(up, ul, cast[Ptr[uint8]]("px")) != 0:
        return val
    if _cs_unit_is(up, ul, cast[Ptr[uint8]]("em")) != 0:
        return val * embase
    if _cs_unit_is(up, ul, cast[Ptr[uint8]]("rem")) != 0:
        return val * 16
    return CS_LEN_NONE


# Percentage value (integer) of p[0..n) e.g. "50%" -> 50, or CS_LEN_NONE.
def _cs_pct_int(p: Ptr[uint8], n: int32) -> int32:
    val: int32 = _cs_num_int(p, n)
    if val == CS_LEN_NONE:
        return CS_LEN_NONE
    ui: int32 = _cs_unit_at(p, n)
    if ui < n and p[ui] == 37:                            # '%'
        return val
    return CS_LEN_NONE


# DOM element index of `el`'s parent element, or -1 (root / unmounted).
def _el_parent_idx(el: int32) -> int32:
    if el < 0 or el >= dom_n:
        return -1
    t: int32 = _tx_by_anchor(dom_anchor[el])
    if t < 0:
        return -1
    par: int32 = tx_parent[t]
    if par < 0:
        return -1
    return _dom_lookup_anchor(tx_anchor[par])


# Used content width (px) of `el`'s box, for resolving a child's percentage
# width. An explicit inline px/em width wins; a percentage width recurses into
# the parent's used width; otherwise the laid-out box width, falling back up the
# ancestor chain and finally to the viewport content width. `depth` bounds the
# recursion. NOTE: reuses the g_geom_* / g_cs_vbuf scratch — callers that need
# the target element's own box must snapshot it before calling.
def _cs_used_width(el: int32, depth: int32) -> int32:
    vw: int32 = _content_right() - _left_margin()
    if depth <= 0 or el < 0 or el >= dom_n:
        return vw
    wn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("width"), 5)
    if wn > 0:
        px: int32 = _cs_len_px(&g_cs_vbuf[0], wn, 16)
        if px != CS_LEN_NONE and px >= 0:
            return px
        pct: int32 = _cs_pct_int(&g_cs_vbuf[0], wn)
        if pct != CS_LEN_NONE:
            pw: int32 = _cs_used_width(_el_parent_idx(el), depth - 1)
            return pw * pct / 100
    _el_bbox(el)
    if g_geom_found != 0:
        return g_geom_w
    par2: int32 = _el_parent_idx(el)
    if par2 >= 0:
        return _cs_used_width(par2, depth - 1)
    return vw


# Lazily compile (once) the getPropertyValue implementation as a JS function and
# cache its value. It reads this[<css-prop-name>] off the computed-style object,
# returning '' for an unset / unknown property (CSSOM getPropertyValue). Reusing
# the engine's own eval (as the inline-event-handler compiler does) is re-entrant
# -safe: the outer script is already parsed to an AST, so re-tokenizing here does
# not disturb it.
def _cs_gpv_fn() -> int32:
    if g_cs_gpv >= 0:
        return g_cs_gpv
    s: Ptr[uint8] = cast[Ptr[uint8]]("var __hb_gpv__=function(p){var k=''+p;var v=this[k];if(v===undefined||v===null){return '';}return v;};")
    js_eval(s, cast[uint64](_cstr_len(s)))
    g_cs_gpv = js_global_get(cast[Ptr[uint8]]("__hb_gpv__"), 10)
    return g_cs_gpv


# Set a keyword/passthrough property: the script-set inline value if present,
# else the UA default. (position / visibility / text-align / z-index / font-
# family: computed keywords the engine tracks but does not fully use in layout.)
def _cs_keyword(cs: int32, el: int32, camel: Ptr[uint8], cl: uint64, \
                css: Ptr[uint8], csl: uint64, deflt: Ptr[uint8], defl: uint64):
    n: int32 = _cs_inline_len(el, camel, cl)
    if n > 0:
        _cs_set2(cs, camel, cl, css, csl, js_new_string(&g_cs_vbuf[0], cast[uint64](n)))
    else:
        _cs_set2(cs, camel, cl, css, csl, js_new_string(deflt, defl))


# Set a length property resolved to used px (margin / padding). A single length
# resolves to px; a keyword / multi-value string passes through; unset -> default.
def _cs_length(cs: int32, el: int32, camel: Ptr[uint8], cl: uint64, \
               css: Ptr[uint8], csl: uint64, deflt: Ptr[uint8], defl: uint64):
    n: int32 = _cs_inline_len(el, camel, cl)
    if n > 0:
        px: int32 = _cs_len_px(&g_cs_vbuf[0], n, 16)
        if px != CS_LEN_NONE:
            _cs_set2(cs, camel, cl, css, csl, _px_string(px))
        else:
            _cs_set2(cs, camel, cl, css, csl, js_new_string(&g_cs_vbuf[0], cast[uint64](n)))
    else:
        _cs_set2(cs, camel, cl, css, csl, js_new_string(deflt, defl))


# Set a colour property resolved to rgb()/rgba(). Priority: a script-set inline
# colour (resolved), else the laid-out text colour `segrgb` (>=0), else the UA
# default (transparent for background, black otherwise).
def _cs_color(cs: int32, el: int32, camel: Ptr[uint8], cl: uint64, \
              css: Ptr[uint8], csl: uint64, segrgb: int32, transparent_def: int32):
    n: int32 = _cs_inline_len(el, camel, cl)
    if n > 0:
        rgb: int32 = css_color_rgb(&g_cs_vbuf[0], n)
        if rgb >= 0:
            _cs_set2(cs, camel, cl, css, csl, _cs_color_string(rgb, g_gcs_alpha))
        else:
            _cs_set2(cs, camel, cl, css, csl, js_new_string(&g_cs_vbuf[0], cast[uint64](n)))
        return
    if segrgb >= 0:
        _cs_set2(cs, camel, cl, css, csl, _cs_color_string(segrgb, 255))
        return
    if transparent_def != 0:
        _cs_set2(cs, camel, cl, css, csl, js_new_string(cast[Ptr[uint8]]("rgba(0, 0, 0, 0)"), 16))
    else:
        _cs_set2(cs, camel, cl, css, csl, js_new_string(cast[Ptr[uint8]]("rgb(0, 0, 0)"), 12))


# Set font-weight resolved to a numeric weight (normal->400, bold->700), passing
# an explicit numeric through. `segbold` (the laid-out weight) is the fallback.
def _cs_fontweight(cs: int32, el: int32, segbold: int32):
    n: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("fontWeight"), 10)
    val: int32 = 0
    if n > 0:
        if _cs_unit_is(&g_cs_vbuf[0], n, cast[Ptr[uint8]]("bold")) != 0 or \
           _cs_unit_is(&g_cs_vbuf[0], n, cast[Ptr[uint8]]("bolder")) != 0:
            val = js_new_string(cast[Ptr[uint8]]("700"), 3)
        elif _cs_unit_is(&g_cs_vbuf[0], n, cast[Ptr[uint8]]("normal")) != 0:
            val = js_new_string(cast[Ptr[uint8]]("400"), 3)
        elif _cs_unit_is(&g_cs_vbuf[0], n, cast[Ptr[uint8]]("lighter")) != 0:
            val = js_new_string(cast[Ptr[uint8]]("300"), 3)
        else:
            val = js_new_string(&g_cs_vbuf[0], cast[uint64](n))
    elif segbold != 0:
        val = js_new_string(cast[Ptr[uint8]]("700"), 3)
    else:
        val = js_new_string(cast[Ptr[uint8]]("400"), 3)
    _cs_set2(cs, cast[Ptr[uint8]]("fontWeight"), 10, cast[Ptr[uint8]]("font-weight"), 11, val)


# ---- CASCADED box values for getComputedStyle ---------------------------
# getComputedStyle used to consult ONLY the element's script-set INLINE style
# (`el.style.*`); a value that came from a <style> rule was invisible, so
# `#a{padding:10px;display:flex}` read back as `0px`/`block`. These helpers read
# the values the CASCADE actually resolved for the element, as recorded by the
# layout engine when it laid the element's box out — the same numbers that were
# painted, so the read-back cannot disagree with the render. Each returns -1
# ("no recorded box": an inline element, or a node created after layout) so the
# caller can fall back to its previous behavior.

# The CONTENT-box width px the engine laid out (CSSOM `width` is the content box
# under the default `box-sizing: content-box`).
def _cs_ebox_cw(el: int32) -> int32:
    ei: int32 = _el_ebox(el)
    if ei < 0:
        return -1
    w: int32 = ebox_cr[ei] - ebox_cx[ei]
    if w < 0:
        w = 0
    return w


# The CONTENT-box height px: the cascade's explicit height when it set one, else
# the laid-out row span minus the vertical padding those rows absorbed.
def _cs_ebox_ch(el: int32) -> int32:
    ei: int32 = _el_ebox(el)
    if ei < 0:
        return -1
    h: int32 = ebox_ehpx[ei]
    if h >= 0:
        return h
    h = ebox_bbh[ei]
    if h < 0:
        return -1
    h = h - ebox_pady[ei] - 2 * ebox_bord[ei]
    if h < 0:
        h = 0
    return h


# The cascade's resolved padding px PER SIDE (the engine tracks a per-axis sum,
# so this is the symmetric half), or -1 when no box was recorded.
def _cs_ebox_pad(el: int32) -> int32:
    ei: int32 = _el_ebox(el)
    if ei < 0:
        return -1
    return ebox_padx[ei] / 2


# The cascade's resolved `display` keyword as a JS string value, or -1 when the
# element has no recorded box or the cascade set no display.
def _cs_ebox_display(el: int32) -> int32:
    ei: int32 = _el_ebox(el)
    if ei < 0:
        return -1
    d: int32 = ebox_disp[ei]
    if d == 1:
        return js_new_string(cast[Ptr[uint8]]("none"), 4)
    if d == 2:
        return js_new_string(cast[Ptr[uint8]]("flex"), 4)
    if d == 3:
        return js_new_string(cast[Ptr[uint8]]("block"), 5)
    if d == 4:
        return js_new_string(cast[Ptr[uint8]]("inline-block"), 12)
    if d == 5:
        return js_new_string(cast[Ptr[uint8]]("inline"), 6)
    if d == 6:
        return js_new_string(cast[Ptr[uint8]]("grid"), 4)
    return -1


# Build the getComputedStyle() result: an object whose common properties report
# RESOLVED / used values per CSSOM — colours as rgb()/rgba(), lengths as used px
# (percentages resolved), keywords computed. Used geometry comes from the laid-
# out box; colours/keywords from the script-set inline style (a framework's read
# -back) with UA defaults otherwise. See docs/browser_w3c_conformance.md for the
# computed-vs-used scope of each property.
def _new_computed_style(el: int32) -> int32:
    cs: int32 = js_new_object_v()
    # ---- display: inline override, else the tag's UA default ----------------
    dn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("display"), 7)
    if dn > 0:
        js_set_prop(cs, cast[Ptr[uint8]]("display"), 7, \
                    js_new_string(&g_cs_vbuf[0], cast[uint64](dn)))
    elif _cs_ebox_display(el) >= 0:
        # a <style>/`style=` rule the CASCADE resolved (flex/grid/inline-block/…)
        js_set_prop(cs, cast[Ptr[uint8]]("display"), 7, _cs_ebox_display(el))
    else:
        dd: int32 = _el_default_display(el)
        if dd == 1:
            js_set_prop(cs, cast[Ptr[uint8]]("display"), 7, js_new_string(cast[Ptr[uint8]]("inline"), 6))
        elif dd == 2:
            js_set_prop(cs, cast[Ptr[uint8]]("display"), 7, js_new_string(cast[Ptr[uint8]]("list-item"), 9))
        else:
            js_set_prop(cs, cast[Ptr[uint8]]("display"), 7, js_new_string(cast[Ptr[uint8]]("block"), 5))
    # ---- snapshot the element's own laid-out box (used geometry + colour) ----
    _el_bbox(el)
    found: int32 = g_geom_found
    gw: int32 = g_geom_w
    gh: int32 = g_geom_h
    gs0: int32 = g_geom_s0
    segrgb: int32 = -1
    segbold: int32 = 0
    if found != 0 and gs0 >= 0:
        segrgb = seg_rgb[gs0]
        if segrgb < 0:
            segrgb = _palette_rgb(seg_color[gs0])
        segbold = cast[int32](seg_bold[gs0])
    # The element's CASCADED content box (from the layout pass; -1 = none), used
    # so a `width`/`height`/`padding` that came from a STYLESHEET rule — not just
    # an inline `el.style` — reads back at its real used px.
    ecw: int32 = _cs_ebox_cw(el)
    ech: int32 = _cs_ebox_ch(el)
    # ---- width: explicit px/em, resolved percentage, else used box width -----
    wn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("width"), 5)
    if wn > 0:
        wpx: int32 = _cs_len_px(&g_cs_vbuf[0], wn, 16)
        if wpx != CS_LEN_NONE and wpx >= 0:
            js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(wpx))
        else:
            wpct: int32 = _cs_pct_int(&g_cs_vbuf[0], wn)
            if wpct != CS_LEN_NONE:
                pw: int32 = _cs_used_width(_el_parent_idx(el), 32)
                js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(pw * wpct / 100))
            elif ecw >= 0:
                js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(ecw))
            elif found != 0:
                js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(gw))
            else:
                js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, js_new_string(cast[Ptr[uint8]]("auto"), 4))
    elif ecw >= 0:
        # the CONTENT width the engine laid out — CSSOM's used `width` under the
        # default box-sizing, and what Chrome reports for a `width:` from a sheet.
        js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(ecw))
    elif found != 0:
        js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, _px_string(gw))
    else:
        js_set_prop(cs, cast[Ptr[uint8]]("width"), 5, js_new_string(cast[Ptr[uint8]]("auto"), 4))
    # ---- height: explicit px/em, else used box height ------------------------
    hn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("height"), 6)
    if hn > 0:
        hpx: int32 = _cs_len_px(&g_cs_vbuf[0], hn, 16)
        if hpx != CS_LEN_NONE and hpx >= 0:
            js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, _px_string(hpx))
        elif ech >= 0:
            js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, _px_string(ech))
        elif found != 0:
            js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, _px_string(gh))
        else:
            js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, js_new_string(cast[Ptr[uint8]]("auto"), 4))
    elif ech >= 0:
        js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, _px_string(ech))
    elif found != 0:
        js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, _px_string(gh))
    else:
        js_set_prop(cs, cast[Ptr[uint8]]("height"), 6, js_new_string(cast[Ptr[uint8]]("auto"), 4))
    # ---- colours (resolved to rgb()/rgba()) ---------------------------------
    _cs_color(cs, el, cast[Ptr[uint8]]("color"), 5, cast[Ptr[uint8]]("color"), 5, segrgb, 0)
    _cs_color(cs, el, cast[Ptr[uint8]]("backgroundColor"), 15, \
              cast[Ptr[uint8]]("background-color"), 16, -1, 1)
    # ---- font-size: resolved to px (inline px/em/%, else UA 16px) ------------
    fn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("fontSize"), 8)
    if fn > 0:
        fpx: int32 = _cs_len_px(&g_cs_vbuf[0], fn, 16)
        if fpx != CS_LEN_NONE and fpx >= 0:
            _cs_set2(cs, cast[Ptr[uint8]]("fontSize"), 8, cast[Ptr[uint8]]("font-size"), 9, _px_string(fpx))
        else:
            fpc: int32 = _cs_pct_int(&g_cs_vbuf[0], fn)
            if fpc != CS_LEN_NONE:
                _cs_set2(cs, cast[Ptr[uint8]]("fontSize"), 8, cast[Ptr[uint8]]("font-size"), 9, _px_string(16 * fpc / 100))
            else:
                _cs_set2(cs, cast[Ptr[uint8]]("fontSize"), 8, cast[Ptr[uint8]]("font-size"), 9, js_new_string(&g_cs_vbuf[0], cast[uint64](fn)))
    else:
        _cs_set2(cs, cast[Ptr[uint8]]("fontSize"), 8, cast[Ptr[uint8]]("font-size"), 9, js_new_string(cast[Ptr[uint8]]("16px"), 4))
    # ---- font-family / font-weight ------------------------------------------
    _cs_keyword(cs, el, cast[Ptr[uint8]]("fontFamily"), 10, \
                cast[Ptr[uint8]]("font-family"), 11, cast[Ptr[uint8]]("monospace"), 9)
    _cs_fontweight(cs, el, segbold)
    # ---- box-model spacing (resolved to px; 0px default) --------------------
    # `padding` prefers the CASCADE's resolved value (a <style> rule's padding was
    # previously invisible here and always read back "0px").
    pn: int32 = _cs_inline_len(el, cast[Ptr[uint8]]("padding"), 7)
    epad: int32 = _cs_ebox_pad(el)
    if pn <= 0 and epad > 0:
        _cs_set2(cs, cast[Ptr[uint8]]("padding"), 7, cast[Ptr[uint8]]("padding"), 7, \
                 _px_string(epad))
        _cs_set2(cs, cast[Ptr[uint8]]("paddingTop"), 10, cast[Ptr[uint8]]("padding-top"), 11, \
                 _px_string(epad))
        _cs_set2(cs, cast[Ptr[uint8]]("paddingLeft"), 11, cast[Ptr[uint8]]("padding-left"), 12, \
                 _px_string(epad))
        _cs_set2(cs, cast[Ptr[uint8]]("paddingRight"), 12, cast[Ptr[uint8]]("padding-right"), 13, \
                 _px_string(epad))
        _cs_set2(cs, cast[Ptr[uint8]]("paddingBottom"), 13, cast[Ptr[uint8]]("padding-bottom"), 14, \
                 _px_string(epad))
    else:
        _cs_length(cs, el, cast[Ptr[uint8]]("padding"), 7, \
                   cast[Ptr[uint8]]("padding"), 7, cast[Ptr[uint8]]("0px"), 3)
    _cs_length(cs, el, cast[Ptr[uint8]]("margin"), 6, \
               cast[Ptr[uint8]]("margin"), 6, cast[Ptr[uint8]]("0px"), 3)
    # ---- keyword / positioning properties (computed) ------------------------
    _cs_keyword(cs, el, cast[Ptr[uint8]]("position"), 8, \
                cast[Ptr[uint8]]("position"), 8, cast[Ptr[uint8]]("static"), 6)
    _cs_keyword(cs, el, cast[Ptr[uint8]]("textAlign"), 9, \
                cast[Ptr[uint8]]("text-align"), 10, cast[Ptr[uint8]]("start"), 5)
    _cs_keyword(cs, el, cast[Ptr[uint8]]("visibility"), 10, \
                cast[Ptr[uint8]]("visibility"), 10, cast[Ptr[uint8]]("visible"), 7)
    _cs_keyword(cs, el, cast[Ptr[uint8]]("opacity"), 7, \
                cast[Ptr[uint8]]("opacity"), 7, cast[Ptr[uint8]]("1"), 1)
    _cs_keyword(cs, el, cast[Ptr[uint8]]("zIndex"), 6, \
                cast[Ptr[uint8]]("z-index"), 7, cast[Ptr[uint8]]("auto"), 4)
    # ---- getPropertyValue(prop) method (reads this[prop], '' if unset) -------
    gpv: int32 = _cs_gpv_fn()
    if gpv >= 0 and js_is_callable(gpv) != 0:
        js_set_prop(cs, cast[Ptr[uint8]]("getPropertyValue"), 16, gpv)
    return cs


# Copy a JS-argument string into `buf`, capped at cap-1, NUL-terminated.
# Returns its length.
def _arg_bytes(argi: int32, buf: Ptr[uint8], cap: int32) -> int32:
    p: Ptr[uint8] = js_str_ptr(js_arg(argi))
    n: int32 = _cstr_len(p)
    if n > cap - 1:
        n = cap - 1
    i: int32 = 0
    while i < n:
        buf[i] = p[i]
        i = i + 1
    buf[n] = 0
    return n


