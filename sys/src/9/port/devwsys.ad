def devwsys_sysmon_read(off: uint64, buf: Ptr[uint8],
                        count: uint64) -> int64:
    if off > 0:
        return 0
    scratch: Array[128, uint8]
    n: uint64 = _wsys_emit_u64_dec(&scratch[0], 0, wsys_sysmon_show_serial)
    scratch[n] = 32
    n = n + 1
    n = _wsys_emit_u64_dec(&scratch[0], n, cast[uint64](wsys_sysmon_cpu))
    scratch[n] = 32
    n = n + 1
    n = _wsys_emit_u64_dec(&scratch[0], n, cast[uint64](wsys_sysmon_mem))
    scratch[n] = 32
    n = n + 1
    n = _wsys_emit_u64_dec(&scratch[0], n, wsys_sysmon_gen)
    scratch[n] = 10
    n = n + 1
    take: uint64 = count
    if take > n:
        take = n
    j: uint64 = 0
    while j < take:
        buf[j] = scratch[j]
        j = j + 1
