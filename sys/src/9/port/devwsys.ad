# ====================================================================
# /dev/wsys/sysmon: "<show_serial> <cpu> <mem> <gen>\n"
# cpu/mem in 0..100. Published via /dev/wsys/ctl `sysmon <cpu> <mem>`.

wsys_sysmon_cpu: int32 = 0
wsys_sysmon_mem: int32 = 0
wsys_sysmon_gen: uint64 = 0
wsys_sysmon_show_serial: uint64 = 0


def wsys_sysmon_set(cpu_v: int32, mem_v: int32):
    wsys_sysmon_cpu = cpu_v
    wsys_sysmon_mem = mem_v
    wsys_sysmon_gen = wsys_sysmon_gen + 1


def wsys_sysmon_show_bump():
