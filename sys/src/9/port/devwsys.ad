def devwsys_sysmon_show_read(off: uint64, buf: Ptr[uint8],
                             count: uint64) -> int64:
    if off > 0:
        return 0
    scratch: Array[32, uint8]
    n: uint64 = _wsys_emit_u64_dec(&scratch[0], 0, wsys_sysmon_show_serial)
    scratch[n] = 10
    n = n + 1
    take: uint64 = count
    if take > n:
        take = n
    j: uint64 = 0
    while j < take:
        buf[j] = scratch[j]
