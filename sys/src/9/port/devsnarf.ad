# sys/src/9/port/devsnarf.ad
#
# Layer 1 (Plan 9-shape) global clipboard device — /dev/snarf.
#
# Plan 9 precedent: /dev/snarf is the global one-buffer clipboard. A
# writer replaces the buffer wholesale; a reader gets back the most
# recently written content. Offset-addressed reads so `cat /dev/snarf`
# terminates at EOF instead of regenerating forever.
#
# Surface:
#   read   -> snarf_buf[off..snarf_len)        (no trailing newline added)
#   write  -> snarf_buf[0..min(count, MAX)]    (REPLACES, not appends)
#
# Sizing: SNARF_MAX = 65536 (64 KiB). Writes past this are TRUNCATED
# (the kernel reports `count` consumed so userland's write loop
# terminates — the clipped tail is intentionally dropped, matching the
# devhostname/keymap convention for over-long writes).
#
# Persistence: kernel-RAM only. Survives until reboot.
#
# Adder-quirk note: shared-shape helpers carry the `_sn_` prefix to
# dodge the flat-namespace `_emit_str` collision class.

SNARF_MAX: uint64 = 65536          # 64 KiB cap

snarf_buf: Array[65536, uint8]
snarf_len: uint64 = 0

# X11-style PRIMARY selection (task #315). A SECOND, independent clipboard
# buffer served at /dev/snarf.primary. Plan 9 has only the one /dev/snarf;
# the user asked for the X11 two-buffer model side by side:
#   * /dev/snarf          — the CLIPBOARD (Ctrl+C / Ctrl+V), REPLACE-on-write.
#   * /dev/snarf.primary  — the PRIMARY selection, auto-filled by a text box
#                           whenever text is highlighted, pasted on MIDDLE
#                           click. Same file surface (read = buffer, write =
#                           REPLACE) so the exact same reader/writer code in
#                           lib/hamtextbox works against either by path.
# Kept as a distinct backing array with its own length so a Ctrl+C into the
# clipboard never clobbers a live highlight's PRIMARY, and vice versa.
primary_buf: Array[65536, uint8]
primary_len: uint64 = 0


def devsnarf_read(off: uint64, buf: Ptr[uint8],
                  count: uint64) -> int64:
    # Offset-addressed read of the clipboard. Honours `off` so a chunked
    # reader (cat with a small block size) can stream the whole buffer
    # and reach EOF cleanly. Returns 0 (EOF) once off >= snarf_len.
    if off >= snarf_len:
        return 0
    avail: uint64 = snarf_len - off
    take: uint64 = count
    if take > avail:
        take = avail
    i: uint64 = 0
    while i < take:
        buf[i] = snarf_buf[off + i]
        i = i + 1
    return cast[int64](take)


def _sn_store(dst: Ptr[uint8], cur_len: uint64, off: uint64,
              buf: Ptr[uint8], count: uint64) -> uint64:
    # Shared body for both buffers. OFFSET-ADDRESSED, which is what makes a
    # CHUNKED writer work:
    #
    #   off == 0  -> REPLACE (Plan 9 snarf semantics; a 0-byte write CLEARS)
    #   off  > 0  -> write at that offset and extend the length
    #
    # Ignoring `off` was a real, user-visible bug: `echo text > /dev/snarf`
    # goes through the shell's echo, which emits the payload and its trailing
    # newline as SEPARATE write() calls at offsets 0 and len. With a
    # replace-always device the second write clobbered the first, so the
    # clipboard ended up holding exactly "\n" — one byte — and a paste
    # produced nothing visible. Any writer that chunks (a large selection
    # split across write() calls, a pipe copy) hit the same truncation.
    # Returns the new buffer length.
    start: uint64 = off
    if start > SNARF_MAX:
        return cur_len                       # write starts past the cap
    take: uint64 = count
    if start + take > SNARF_MAX:
        take = SNARF_MAX - start             # truncate at the cap
    i: uint64 = 0
    while i < take:
        dst[start + i] = buf[i]
        i = i + 1
    if start == 0:
        return take                          # REPLACE
    if start + take > cur_len:
        return start + take                  # extended
    return cur_len


def devsnarf_write(off: uint64, buf: Ptr[uint8], count: uint64) -> int64:
    # Write the clipboard. A write at offset 0 REPLACES the buffer (so a
    # 0-byte write CLEARS it, matching Plan 9); a write at a non-zero offset
    # lands there and extends the length, so a chunked writer accumulates
    # instead of each chunk clobbering the last. Writes past SNARF_MAX are
    # truncated at the cap; we still report `count` consumed so userland's
    # write loop terminates.
    snarf_len = _sn_store(&snarf_buf[0], snarf_len, off, buf, count)
    return cast[int64](count)


# ---- PRIMARY selection (/dev/snarf.primary) -------------------------------
# Byte-for-byte the same offset-addressed read / REPLACE-on-write surface as
# the clipboard above, over the second (primary_buf) backing array.
def devsnarf_primary_read(off: uint64, buf: Ptr[uint8],
                          count: uint64) -> int64:
    if off >= primary_len:
        return 0
    avail: uint64 = primary_len - off
    take: uint64 = count
    if take > avail:
        take = avail
    i: uint64 = 0
    while i < take:
        buf[i] = primary_buf[off + i]
        i = i + 1
    return cast[int64](take)


def devsnarf_primary_write(off: uint64, buf: Ptr[uint8],
                           count: uint64) -> int64:
    primary_len = _sn_store(&primary_buf[0], primary_len, off, buf, count)
    return cast[int64](count)
