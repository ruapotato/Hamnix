# sys/src/9/port/devmeminfo.ad
#
# Layer 1 (Plan 9-shape) meminfo device — system-introspection cdev,
# sibling to devcpuinfo.ad. One read regenerates a fresh text snapshot
# of the kernel-side memory accounting:
#
#   MemTotal: 262144 kB
#   MemFree:  198432 kB
#   MemUsed:   63712 kB
#   Pages:     65536
#   PagesFree: 49608
#   KmallocLive: 16
#
# Linux-shape kB units for the three Mem* lines so a future Layer-2
# /proc/meminfo translation is a near-direct copy of these bytes.
# Page counts are exposed raw — userland that wants a kB equivalent
# multiplies by 4 (PAGE_SIZE / 1024).
#
# Stateless backend: FD_MEMINFO_MARK fds carry no per-fd slot. Every
# read regenerates the entire blob, then copies up to `count` bytes
# into the caller's buffer. Writes return -1 — read-only.
#
# Source of truth:
#   - mm/memblock.ad      memblock_region_base / _top / _used / _avail
#   - mm/page_alloc.ad    page_alloc_total / page_alloc_free_count
#
# The KmallocLive line is derived from (page_alloc_total -
# page_alloc_free_count) — i.e. the number of in-use page frames. A
# more precise per-slab-cache walk is a follow-up (it needs a new
# accessor in mm/slab.ad, which the parent commit defers).

from mm.memblock import (
    memblock_region_base, memblock_region_top,
    memblock_used, memblock_avail,
)
from mm.page_alloc import (
    page_alloc_total, page_alloc_free_count,
    page_alloc_freed_total, page_alloc_in_use,
    page_alloc_buddy_free_pages,
    region_pool_free_bytes, region_carved_bytes, region_leaked_bytes,
    region_quarantine_bytes, region_recovered_bytes,
    page_alloc_track_enable, page_alloc_track_reset, page_alloc_track_dump,
    page_alloc_census_plant, page_alloc_census_unplant,
    page_alloc_census_orphans, PA_SITE_VMA_ANON,
    page_alloc_track_mode, page_alloc_site_live, page_alloc_site_allocs,
    page_alloc_track_armed_at_boot, page_alloc_track_bytes,
    page_alloc_site_frees, PA_SITE_MAX,
    alloc_pages, free_pages, pa_set_site,
    PA_SITE_TMPFS, PA_SITE_COW_RESOLVE, PA_SITE_UNKNOWN,
)
from kernel.printk.printk import printk0, printk1, printk2, printk3, printk_set_level
from drivers.tty.serial.early_8250 import PRINTK_LEVEL_EMERG
from mm.cow import (
    cow_ledger_enable, cow_ledger_dump, cow_origin_dump, cow_net_dump,
)
from mm.slab import (
    kmalloc_live_objects, kmalloc_live_slabs, kmalloc, kfree, km_set_site,
    KM_SITE_SELFTEST, KM_SITE_VFS, KM_SITE_UNKNOWN,
    km_track_enable, km_track_reset, km_track_dump, km_track_mode,
    km_site_live, km_site_bytes, km_site_allocs, km_site_frees,
    km_track_blocks_used, km_track_blocks_exhausted, KM_SITE_MAX,
)
from mm.vma import (
    vma_nodes_live, vma_hugepages_total, vma_hugepages_live,
    cow_priv_reclaimed_total,
)
from kernel.sched.core import (
    tasks_spawned_total, tasks_reaped_total, tasks_live_count,
    mm_orphan_census, mm_census_plant_mapped, mm_census_unplant_mapped,
    mm_origin_live_dump,
)


# Kernel pages are 4 KiB; one kB column equals (bytes >> 10).
PAGE_SIZE_BYTES: uint64 = 4096
BYTES_PER_KB:    uint64 = 1024


# --- ASCII formatting helpers ----------------------------------------

def _devmeminfo_u64_to_dec(value: uint64, out: Ptr[uint8]) -> uint64:
    # Reverse-fill stack then copy out top-down. Same shape as
    # devtime.ad::_devtime_u64_to_dec. Returns bytes written.
    if value == 0:
        out[0] = 48
        return 1
    digits: Array[24, uint8]
    n: uint64 = 0
    while value != 0:
        digits[n] = cast[uint8](value % 10) + 48
        value = value / 10
        n = n + 1
    written: uint64 = n
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digits[n]
        i = i + 1
    return written


def _mi_emit_str(out: Ptr[uint8], pos: uint64, s: Ptr[uint8]) -> uint64:
    i: uint64 = 0
    while s[i] != 0:
        out[pos + i] = s[i]
        i = i + 1
    return pos + i


def _emit_kb_line(out: Ptr[uint8], pos: uint64,
                  label: Ptr[uint8], bytes_val: uint64) -> uint64:
    pos = _mi_emit_str(out, pos, label)
    pos = pos + _devmeminfo_u64_to_dec(bytes_val / BYTES_PER_KB,
                                       &out[pos])
    pos = _mi_emit_str(out, pos, " kB\n")
    return pos


def _emit_count_line(out: Ptr[uint8], pos: uint64,
                     label: Ptr[uint8], value: uint64) -> uint64:
    pos = _mi_emit_str(out, pos, label)
    pos = pos + _devmeminfo_u64_to_dec(value, &out[pos])
    out[pos] = 10
    pos = pos + 1
    return pos


# --- snapshot builder -------------------------------------------------

def _build_meminfo(out: Ptr[uint8], cap: uint64) -> uint64:
    # Fill out[] with the meminfo text. Returns total bytes written.
    # Worst-case ~350 bytes (twelve labels + 20-digit decimals). Caller
    # supplies a 512-byte scratch in devmeminfo_read.

    # memblock region = the kernel-managed physical RAM window. Its
    # "total" is the original capacity, computed before any bump
    # allocations carved chunks off the top. We approximate by:
    #   total  = used + avail (region_top - region_start has shifted
    #            for the used portion, so this is the most honest
    #            number without a separate "region_initial" accessor)
    used:  uint64 = memblock_used()
    avail: uint64 = memblock_avail()
    total: uint64 = used + avail

    # TRUE free memory = memblock's untouched bump headroom (avail) PLUS the
    # buddy allocator's reclaimable pool. When a task exits, free_pages()
    # returns its user pages / kernel stack / page tables to the BUDDY
    # allocator — never to memblock — so memblock_avail() alone is
    # monotonically non-increasing and MemFree would appear frozen even
    # though the RAM was actually reclaimed. Adding the buddy free pool
    # makes MemFree move up as apps close (fix for the "free RAM only ever
    # goes DOWN" report). Symmetrically, MemUsed drops by the same amount.
    #
    # THIRD supply, added here: the REGION pool. ELF images are too big for
    # the buddy allocator (MAX_ORDER = 4 MiB vs a ~17 MiB native image), so
    # they come from region_alloc, which carves from memblock on a cold miss
    # and recycles through its OWN free list thereafter (mm/page_alloc.ad).
    # A pooled region chunk is reusable free RAM that appears in NEITHER
    # memblock_avail (the bump cursor already passed it) NOR the buddy free
    # pool — so MemFree under-reported by the entire warm region pool, and
    # every app launch looked like it permanently consumed its whole image
    # span even when the very next launch reused the same chunk. That is the
    # bulk of the soak's "MemFree slope" and it was an ACCOUNTING artefact.
    buddy_free_bytes:  uint64 = page_alloc_buddy_free_pages() * PAGE_SIZE_BYTES
    region_free_bytes: uint64 = region_pool_free_bytes()
    reclaimable: uint64 = buddy_free_bytes + region_free_bytes
    free_bytes: uint64 = avail + reclaimable
    used_bytes: uint64 = used
    if used_bytes >= reclaimable:
        used_bytes = used_bytes - reclaimable
    else:
        used_bytes = 0

    pos: uint64 = 0
    pos = _emit_kb_line(out, pos, "MemTotal: ", total)
    pos = _emit_kb_line(out, pos, "MemFree:  ", free_bytes)
    # Linux `free`/`vmstat` read MemAvailable as the "how much can a
    # workload allocate without swapping" figure. We have no
    # reclaimable page-cache / slab layer yet, so the honest value is
    # exactly MemFree — the same thing the Linux kernel reports before
    # any reclaimable accounting is wired. Emitting the label lets
    # procps use it directly instead of falling back to its MemFree
    # heuristic.
    pos = _emit_kb_line(out, pos, "MemAvailable: ", free_bytes)
    # Buffers / Cached — Linux's page-cache split. Hamnix has no
    # writeback buffer cache or unified page cache yet, so both are a
    # truthful 0. `free` sums Buffers+Cached(+SReclaimable) into its
    # "buff/cache" column; with these present the column reads 0
    # rather than being absent (which some procps builds treat as an
    # unparseable meminfo).
    pos = _emit_kb_line(out, pos, "Buffers: ", 0)
    pos = _emit_kb_line(out, pos, "Cached: ", 0)
    # Swap accounting — no swap device is configured, so total/free are
    # both 0. `free` needs SwapTotal/SwapFree to render its Swap row;
    # without them it prints a blank/garbage swap line.
    pos = _emit_kb_line(out, pos, "SwapTotal: ", 0)
    pos = _emit_kb_line(out, pos, "SwapFree: ", 0)
    pos = _emit_kb_line(out, pos, "MemUsed:  ", used_bytes)

    # PagesFree is the WHOLE buddy free pool (total - live), not
    # page_alloc_free_count() — that accessor returns nr_pages_free, which
    # only ever counted the ORDER-0 free list, so every higher-order free
    # run was reported as in-use and (PagesTotal - PagesFree) disagreed with
    # PagesInUse by tens of MiB. With the buddy-pool form the identity
    # PagesTotal - PagesFree == PagesInUse holds exactly, which is what
    # makes either number safe to reason about.
    npages_total: uint64 = page_alloc_total()
    npages_free:  uint64 = page_alloc_buddy_free_pages()
    pos = _emit_count_line(out, pos, "Pages:     ", npages_total)
    pos = _emit_count_line(out, pos, "PagesFree: ", npages_free)

    # KmallocLive: live kmalloc OBJECTS, summed over the seven slab caches
    # (mm/slab.ad::kmalloc_live_objects). This used to be
    # (npages_total - npages_free) — a PAGE count wearing a kmalloc name,
    # and a broken one: page_alloc's nr_pages_free only tracks the order-0
    # free list, so every higher-order free run counted as "in use". A soak
    # reading KmallocLive as a slab-object leak signal was actually watching
    # the buddy pool grow. KmallocSlabs is the backing page count.
    pos = _emit_count_line(out, pos, "KmallocLive: ", kmalloc_live_objects())
    pos = _emit_count_line(out, pos, "KmallocSlabs: ", kmalloc_live_slabs())

    # Leak-accounting fields. These expose cumulative + current-live
    # counters across the page allocator, VMA layer, and task scheduler.
    # A spawn/reap cycle that returns PagesInUse / VmaNodesLive /
    # TasksLive to baseline is leak-free; monotonic growth is a leak.
    pos = _emit_count_line(out, pos, "PagesTotal:     ", npages_total)
    pos = _emit_count_line(out, pos, "PagesFreedTotal:", page_alloc_freed_total())
    pos = _emit_count_line(out, pos, "PagesInUse:     ", page_alloc_in_use())
    pos = _emit_count_line(out, pos, "VmaNodesLive:   ", vma_nodes_live())
    pos = _emit_count_line(out, pos, "TasksSpawned:   ", tasks_spawned_total())
    pos = _emit_count_line(out, pos, "TasksReaped:    ", tasks_reaped_total())
    pos = _emit_count_line(out, pos, "TasksLive:      ", tasks_live_count())

    # Region-allocator accounting (ELF image spans). RegionPoolFree is the
    # reusable pool (already folded into MemFree above); RegionCarved is the
    # cumulative memblock cold-miss draw, which must FLATTEN once the pool is
    # warm; RegionLeaked is the cumulative span region_free_cow_safe refused
    # to pool and must stay at 0.
    pos = _emit_kb_line(out, pos, "RegionPoolFree: ", region_pool_free_bytes())
    pos = _emit_kb_line(out, pos, "RegionCarved:   ", region_carved_bytes())
    pos = _emit_kb_line(out, pos, "RegionLeaked:   ", region_leaked_bytes())
    pos = _emit_kb_line(out, pos, "RegionQuarantine: ", region_quarantine_bytes())
    pos = _emit_kb_line(out, pos, "RegionRecovered: ", region_recovered_bytes())

    # Frames a fork child's execve/reap teardown returned to the buddy
    # allocator because they were its OWN post-fork COW copies
    # (mm/vma.ad::_cow_release_forked_range). Before that reclaim existed
    # every one of these leaked until reboot — ~6 pages per app launch on
    # the desktop. A rising counter here is the fix working, not a leak.
    pos = _emit_count_line(out, pos, "CowPrivReclaimed:", cow_priv_reclaimed_total())

    # §hugepage: 2 MiB MAP_HUGETLB accounting. HugePages_Total is the
    # cumulative count of 2 MiB huge PDEs ever demand-installed; the live
    # count is the number currently mapped (HugePages_Total - freed).
    # Hamnix demand-allocates huge frames from the buddy allocator (no
    # pre-reserved pool), so these counters observe real usage rather than
    # a fixed nr_hugepages reservation; Hugepagesize is the fixed 2 MiB.
    pos = _emit_count_line(out, pos, "HugePages_Total:", vma_hugepages_total())
    pos = _emit_count_line(out, pos, "HugePages_Live: ", vma_hugepages_live())
    pos = _emit_kb_line(out, pos, "Hugepagesize:    ", 0x200000)

    # --- allocation tracking (mm/page_alloc.ad, default-OFF) ----------
    #
    # Emitted ONLY when tracking is armed, so the default blob is
    # byte-for-byte what it was before this feature existed.
    #
    # ABSOLUTELY NO SCAN HERE. This function is re-run ONCE PER 128-BYTE
    # READ CHUNK (see devmeminfo_read_at below), so an O(frames) walk runs
    # ~20 times per `cat /proc/meminfo` and wedges the guest — two soak
    # runs were lost to exactly that mistake. Every value below is an O(1)
    # counter read that the alloc/free paths maintain.
    #
    # One line per site, ALL sites, every render — a fixed line set. The
    # tempting optimisation of "only emit sites with activity" makes the
    # blob's line count change between chunk renders, which tears the
    # output of a chunked reader mid-file.
    #
    # Format:  PgSite<id>: <live> <allocs> <frees>
    #          live   = pages held right now by that site  (histogram)
    #          allocs/frees = cumulative frames, so a per-site slope comes
    #          from two samples with no scan. scripts/leakprobe_slopes.py
    #          splits each into PgSite<id>.live/.allocs/.frees series.
    if page_alloc_track_mode() != 0:
        pos = _emit_count_line(out, pos, "PgTrackMode:    ",
                               page_alloc_track_mode())
        # WHEN was this armed? (leak pass 22.) A reader cannot interpret a
        # site histogram without knowing whether it covers the whole system
        # lifetime or only the window since somebody echoed `track full`.
        # 1 = armed by the boot path (mem_init), so bringup is INSIDE the
        # accounting and site 0 is a real signal rather than a pre-arming
        # population. 0 = armed from userland, the pre-pass-22 shape, where
        # site 0 is just "everything that happened before you looked".
        # Exposed as a FILE field, not a syscall: capabilities are files.
        pos = _emit_count_line(out, pos, "PgTrackBoot:    ",
                               page_alloc_track_armed_at_boot())
        # The memory the tracker itself costs, so arming is auditable on
        # device instead of trusted from a formula in a doc.
        pos = _emit_count_line(out, pos, "PgTrackBytes:   ",
                               page_alloc_track_bytes())
        si: uint64 = 0
        while si < PA_SITE_MAX:
            pos = _mi_emit_str(out, pos, "PgSite")
            pos = pos + _devmeminfo_u64_to_dec(si, &out[pos])
            pos = _mi_emit_str(out, pos, ": ")
            pos = pos + _devmeminfo_u64_to_dec(page_alloc_site_live(si),
                                               &out[pos])
            out[pos] = 32
            pos = pos + 1
            pos = pos + _devmeminfo_u64_to_dec(page_alloc_site_allocs(si),
                                               &out[pos])
            out[pos] = 32
            pos = pos + 1
            pos = pos + _devmeminfo_u64_to_dec(page_alloc_site_frees(si),
                                               &out[pos])
            out[pos] = 10
            pos = pos + 1
            si = si + 1

    # --- kernel-heap tracking (mm/slab.ad kmtrack, default-OFF) --------
    #
    # Same rules, same reasons as the page block above: emitted ONLY when
    # armed (so the default blob is byte-for-byte unchanged), a FIXED line
    # set every render (a varying line count tears a chunked reader
    # mid-file), and every value an O(1) tally — NO SCAN, EVER, here.
    #
    # Format:  KmSite<id>: <live_objs> <live_bytes> <allocs> <frees>
    #
    # This is the half of the picture --track-allocs cannot see: a heap
    # object leaked inside an already-resident slab page moves no page
    # counter at all, so PgSite16 (slab) can read a flat 0.00 while the
    # kernel heap grows without bound. KmBlocks/KmBlocksLost report the
    # tracker's own capacity so an exhausted block pool is visible as a
    # measurement shortfall rather than a false exoneration.
    if km_track_mode() != 0:
        pos = _emit_count_line(out, pos, "KmTrackMode:    ", km_track_mode())
        pos = _emit_count_line(out, pos, "KmBlocks:       ",
                               km_track_blocks_used())
        pos = _emit_count_line(out, pos, "KmBlocksLost:   ",
                               km_track_blocks_exhausted())
        ki: uint64 = 0
        while ki < KM_SITE_MAX:
            pos = _mi_emit_str(out, pos, "KmSite")
            pos = pos + _devmeminfo_u64_to_dec(ki, &out[pos])
            pos = _mi_emit_str(out, pos, ": ")
            pos = pos + _devmeminfo_u64_to_dec(km_site_live(ki), &out[pos])
            out[pos] = 32
            pos = pos + 1
            pos = pos + _devmeminfo_u64_to_dec(km_site_bytes(ki), &out[pos])
            out[pos] = 32
            pos = pos + 1
            pos = pos + _devmeminfo_u64_to_dec(km_site_allocs(ki), &out[pos])
            out[pos] = 32
            pos = pos + 1
            pos = pos + _devmeminfo_u64_to_dec(km_site_frees(ki), &out[pos])
            out[pos] = 10
            pos = pos + 1
            ki = ki + 1

    return pos


# --- public API -------------------------------------------------------

def devmeminfo_read_at(buf: Ptr[uint8], count: uint64, off: uint64) -> int64:
    # OFFSET-AWARE snapshot read.
    #
    # This used to be offset-BLIND — it always returned the first
    # min(count, n) bytes — and namec.ad's dispatcher turned any non-zero
    # offset into EOF (`if off > 0: return 0`). Together those two silently
    # TRUNCATED /proc/meminfo to whatever the reader's FIRST buffer happened
    # to be. /bin/cat reads in 128-byte chunks (user/cat.ad CHUNK), so
    # `cat /proc/meminfo` printed exactly 128 bytes and stopped mid-word:
    #
    #     MemTotal: 873959 kB
    #     ... SwapFree: 0 kB
    #     MemUse                      <- 128 bytes, then EOF
    #
    # Everything past byte 128 — MemUsed, Pages, PagesFree, KmallocLive,
    # PagesTotal, PagesFreedTotal, PagesInUse, VmaNodesLive, TasksSpawned,
    # TasksReaped, TasksLive and the HugePages fields — was UNREACHABLE to
    # any chunked reader. Those are precisely the leak counters this file
    # exists to expose, so every leak-accounting field was invisible to the
    # tools most likely to look at it. /bin/free happened to work only
    # because it reads with a buffer larger than the blob. Found by
    # scripts/test_de_stress_soak.sh, which could not read one of them.
    #
    # The blob stays a stateless snapshot, re-rendered per chunk (like a
    # Linux seq_file without the buffered-record guarantee), so a
    # multi-chunk read can observe counters from two adjacent instants.
    # That is strictly better than reporting a truncated file as complete,
    # and it is exactly what the single-read path already did.
    if count == 0:
        return 0
    # 8 KiB, not 1 KiB: with BOTH trackers armed the blob grows by
    # PA_SITE_MAX PgSite lines (~1.4 KiB) plus KM_SITE_MAX KmSite lines,
    # which carry four columns each (~2.5 KiB) — over 4 KiB together with
    # the base fields, which would have silently TRUNCATED the KmSite tail
    # and made the last sites read as a flat 0 forever (the exact shape of
    # a false exoneration this tooling exists to prevent). The kernel stack
    # is KSTACK_ORDER=4 (64 KiB), so an 8 KiB frame here is comfortable.
    # With both trackers OFF the blob is unchanged, byte for byte.
    scratch: Array[8192, uint8]
    n: uint64 = _build_meminfo(&scratch[0], 8192)
    if off >= n:
        return 0
    remain: uint64 = n - off
    take: uint64 = count
    if take > remain:
        take = remain
    i: uint64 = 0
    while i < take:
        buf[i] = scratch[off + i]
        i = i + 1
    return cast[int64](take)


def devmeminfo_read(buf: Ptr[uint8], count: uint64) -> int64:
    # Back-compat entry point (whole-blob readers): read from offset 0.
    return devmeminfo_read_at(buf, count, 0)


# Line accumulator for the ctl write path — see devmeminfo_write.
_mi_wbuf: Array[64, uint8]
_mi_wpos: uint64 = 0


def _mi_wmatch(buf: Ptr[uint8], count: uint64, want: Ptr[uint8]) -> int32:
    # 1 iff buf[0..count) begins with `want` and the next byte (if any) is
    # a terminator — newline, CR, space or NUL. Written by hand because a
    # ctl write arrives with whatever trailing newline the shell added.
    i: uint64 = 0
    while want[i] != 0:
        if i >= count:
            return 0
        if buf[i] != want[i]:
            return 0
        i = i + 1
    if i >= count:
        return 1
    c: uint64 = cast[uint64](buf[i])
    if c == 10 or c == 13 or c == 32 or c == 0:
        return 1
    return 0


def _mi_tail_num(buf: Ptr[uint8], count: uint64, skip: uint64) -> uint64:
    # Decimal argument after a verb: skip the verb's `skip` bytes and any
    # blanks, then read digits. Returns 0 when there is no number, which is
    # also a legal argument value (origin bucket 0) — a ctl knob does not
    # need to distinguish "absent" from "zero", and bucket 0 is the untagged
    # bucket whose live set is empty by construction anyway.
    i: uint64 = skip
    while i < count and cast[uint64](buf[i]) == 32:
        i = i + 1
    v: uint64 = 0
    while i < count:
        c: uint64 = cast[uint64](buf[i])
        if c < 48 or c > 57:
            return v
        v = v * 10 + (c - 48)
        i = i + 1
    return v


def devmeminfo_write(buf: Ptr[uint8], count: uint64) -> int64:
    # /dev/meminfo is a CTL FILE for the page allocator's allocation
    # tracker (mm/page_alloc.ad) and otherwise read-only.
    #
    # WHY HERE. Plan 9 shape: control is a write to the file you read the
    # state from, not a new syscall and not a build flag. Arming tracking
    # at runtime means ONE kernel binary serves CI, the soak and the debug
    # session — no rebuild/reflash round trip before a leak hunt can start
    # (that round trip, not the instrumentation, was the expensive part of
    # the eleven passes), and a soak can arm tracking AFTER boot settles so
    # boot allocations do not pollute the baseline.
    #
    #   echo track on    > /proc/meminfo   site + order/owner metadata
    #   echo track full  > /proc/meminfo   ... plus per-frame tag words
    #   echo track reset > /proc/meminfo   re-baseline the counters
    #   echo track dump  > /proc/meminfo   EMERG report to the console
    #   echo track off   > /proc/meminfo
    #   echo track ledger> /proc/meminfo   per-CALL-SITE COW reference balance
    #   echo track origin> /proc/meminfo   per-FRAME-ORIGIN balance + born/died
    #   echo track net   > /proc/meminfo   ONE line: added/dropped/live frames
    #   echo track org N > /proc/meminfo   DESCRIBE origin N's live frames
    #
    # A completed line that is not a `track` verb still returns -1, so
    # every pre-existing "meminfo is read-only" expectation holds.
    #
    # THE WRITE ARRIVES ONE WORD AT A TIME. hamsh's `echo track on > file`
    # does NOT hand the ctl file one 9-byte write; it hands it FOUR:
    #   count=5 "track" / count=1 " " / count=2 "on" / count=1 "\n"
    # (verified in the guest — a first cut of this parser matched only a
    # whole-line write and therefore silently did nothing from the shell
    # while passing every in-kernel test). So a ctl file MUST accumulate
    # until the newline, exactly as any real Plan 9 ctl file does. The
    # accumulator is global rather than per-fd: two processes scribbling
    # ctl verbs at the same instant would interleave, which for a debug
    # knob costs a rejected line and no more.
    if count == 0:
        return -1
    i: uint64 = 0
    while i < count:
        c: uint64 = cast[uint64](buf[i])
        if c == 10 or c == 13:
            n: uint64 = _mi_wpos
            _mi_wpos = 0
            if n == 0:
                return cast[int64](count)      # blank line: no-op
            return _mi_ctl_line(&_mi_wbuf[0], n, count)
        if _mi_wpos >= 63:
            _mi_wpos = 0                        # overlong: drop the line
            return -1
        _mi_wbuf[_mi_wpos] = buf[i]
        _mi_wpos = _mi_wpos + 1
        i = i + 1
    # No terminator yet — the bytes are banked, the verb fires on the
    # newline. Report them consumed so the writer keeps going.
    return cast[int64](count)


def _mi_ctl_line(line: Ptr[uint8], n: uint64, count: uint64) -> int64:
    # The COW reference ledger's PER-ARM split is armed by the same verbs as
    # the page tracker: a leak hunt wants both, and a second knob is a second
    # thing a soak script can forget. The two cumulative TOTALS stay
    # unconditional (mm/cow.ad); only the per-call-site attribution is gated.
    if _mi_wmatch(line, n, "track on") != 0:
        if page_alloc_track_enable(1) == 0:
            return -1
        cow_ledger_enable(1)
        return cast[int64](count)
    if _mi_wmatch(line, n, "track full") != 0:
        if page_alloc_track_enable(2) == 0:
            return -1
        cow_ledger_enable(1)
        return cast[int64](count)
    if _mi_wmatch(line, n, "track off") != 0:
        page_alloc_track_enable(0)
        cow_ledger_enable(0)
        return cast[int64](count)
    # Per-arm ledger on its own, without a census walk: this is the cheap
    # per-cycle sample a soak slopes. O(arms), no page-table walk, no frame
    # scan — so unlike `track census` it can be taken every cycle.
    if _mi_wmatch(line, n, "track ledger") != 0:
        cow_ledger_dump()
        return cast[int64](count)
    # ORIGIN-KEYED ledger (leak pass 14): the same references bucketed by the
    # arm that took each FRAME's first reference. Same cost class as
    # `track ledger` — O(arms), no walk, no scan.
    if _mi_wmatch(line, n, "track origin") != 0:
        cow_origin_dump()
        return cast[int64](count)
    # ONE line. Cheap enough to sample after every app LAUNCH, which is how a
    # bursty leak gets a name instead of a slope.
    if _mi_wmatch(line, n, "track net") != 0:
        cow_net_dump()
        return cast[int64](count)
    if _mi_wmatch(line, n, "track reset") != 0:
        page_alloc_track_reset()
        return cast[int64](count)
    if _mi_wmatch(line, n, "track dump") != 0:
        page_alloc_track_dump()
        return cast[int64](count)
    # ORPHAN CENSUS — mark-and-sweep reachability over every live address
    # space (kernel/sched/core.ad::mm_orphan_census). This is the verb that
    # separates "a free path is missing" from "the process genuinely maps
    # more than it did last cycle" — the distinction ten leak passes could
    # not measure, and the reason two attempted fixes freed reachable frames
    # and wedged the desktop. Needs `track full` first (it reports the
    # recorded fault VA of each orphan, which names the leaking SPAN).
    #
    # O(page tables + frames), hence a ctl verb and NEVER a meminfo field.
    if _mi_wmatch(line, n, "track census") != 0:
        mm_orphan_census()
        return cast[int64](count)
    # NAME the live frames of ONE origin arm (leak pass 15):
    #
    #   echo track org 5 > /proc/meminfo
    #
    # `track origin` counts the survivors per arm; this one describes them —
    # owner slot, liveness, pid, comm, refcount, recorded VA, and whether the
    # owner still maps that VA to this frame. The verb exists because a
    # CONSTANT residue (arm 5 has read exactly +10 on three independent runs)
    # cannot be told from a stalled leak by a count alone, and "probably the
    # long-lived system tasks" has been an argument rather than a measurement
    # since pass 13.
    #
    # O(frames) PER SURVIVOR — the same cost class as `track census`, and for
    # the same reason it is a ctl verb and never a meminfo field.
    if _mi_wmatch(line, n, "track org") != 0:
        mm_origin_live_dump(_mi_tail_num(line, n, 9))
        return cast[int64](count)
    # POSITIVE CONTROL for the census. `track plant` allocates one order-0
    # frame at a user-mapped site and maps it NOWHERE; a census run while it
    # is outstanding MUST report it. Without this, "0 orphans" cannot be
    # distinguished from a blind census — the false-exoneration failure the
    # first draft of the walk actually had. `track unplant` returns it.
    if _mi_wmatch(line, n, "track plant") != 0:
        if page_alloc_census_plant() == 0:
            return -1
        return cast[int64](count)
    if _mi_wmatch(line, n, "track unplant") != 0:
        page_alloc_census_unplant()
        return cast[int64](count)
    # NEGATIVE CONTROL. `track mplant` allocates one order-0 frame at a
    # user-mapped site and MAPS it into a long-lived address space; a census
    # run while it is outstanding must NOT report it. Without this, a non-zero
    # orphan count cannot be distinguished from a census that over-reports
    # live frames — the other error direction from `track plant`, and the one
    # every span/owner conclusion drawn from an orphan tally rests on.
    # `track unmplant` zaps the PTE and returns the frame.
    if _mi_wmatch(line, n, "track mplant") != 0:
        if mm_census_plant_mapped() != 0:
            return -1
        return cast[int64](count)
    if _mi_wmatch(line, n, "track unmplant") != 0:
        mm_census_unplant_mapped()
        return cast[int64](count)
    # Kernel-heap (kmalloc/slab) per-site attribution — mm/slab.ad. Armed
    # independently of page tracking: the two answer different questions
    # and a soak usually wants both, but a kmalloc-only hunt should not
    # have to pay for the page tracker's per-frame arrays.
    if _mi_wmatch(line, n, "kmtrack on") != 0:
        if km_track_enable(1) == 0:
            return -1
        return cast[int64](count)
    if _mi_wmatch(line, n, "kmtrack off") != 0:
        km_track_enable(0)
        return cast[int64](count)
    if _mi_wmatch(line, n, "kmtrack reset") != 0:
        km_track_reset()
        return cast[int64](count)
    if _mi_wmatch(line, n, "kmtrack dump") != 0:
        km_track_dump()
        return cast[int64](count)
    return -1


# --- allocation-tracker self-test -------------------------------------
#
# Gated on /etc/trkalloc-test (planted by build_initramfs.py when
# ENABLE_TRACK_ALLOCS_TEST=1, i.e. exclusively by
# scripts/test_track_allocs.sh). Runs in-kernel and touches no shell, so
# it cannot be flaked by hamsh dropping its first serial command.
#
# It drives the WHOLE stack the way a leak hunt does — the ctl-file
# parser, the per-frame stamp/unstamp, the O(1) tallies, and the meminfo
# renderer including its chunked-read path — and it proves the two claims
# that matter most about a default-off debug feature:
#
#   * with tracking OFF the meminfo blob contains no tracker bytes at all,
#   * with tracking OFF an allocation moves NO counter.

def _trk_find(hay: Ptr[uint8], hlen: uint64, needle: Ptr[uint8]) -> int32:
    # 1 iff `needle` occurs in hay[0..hlen).
    i: uint64 = 0
    while i < hlen:
        j: uint64 = 0
        hit: int32 = 1
        while needle[j] != 0:
            if i + j >= hlen or hay[i + j] != needle[j]:
                hit = 0
                j = 0
                while needle[j] != 0:
                    j = j + 1
            else:
                j = j + 1
        if hit == 1:
            return 1
        i = i + 1
    return 0


def track_allocs_selftest() -> int32:
    # 8 KiB, matching devmeminfo_read_at: this selftest arms BOTH trackers,
    # and the combined blob exceeds 4 KiB. A short scratch here would
    # silently truncate the very lines the kmtrack legs assert on.
    scratch: Array[8192, uint8]
    ok: int32 = 1

    # (1) DEFAULT-OFF: no tracker bytes in the blob, at all.
    if page_alloc_track_mode() != 0:
        printk0("[TRKALLOC] FAIL: tracking was already armed at boot\n")
        ok = 0
    n0: uint64 = _build_meminfo(&scratch[0], 8192)
    if _trk_find(&scratch[0], n0, "PgSite") != 0:
        printk0("[TRKALLOC] FAIL: default-off blob contains PgSite lines\n")
        ok = 0

    # (2) DEFAULT-OFF COSTS NOTHING SEMANTICALLY: an allocation while
    #     tracking is off must move no counter once tracking comes on.
    pa_set_site(PA_SITE_TMPFS)
    off_p: uint64 = alloc_pages(2)
    if off_p == 0:
        printk0("[TRKALLOC] FAIL: alloc_pages(2) OOM (off leg)\n")
        return 0
    free_pages(off_p, 2)

    # (3) A garbage ctl write is still rejected: /dev/meminfo stays
    #     read-only for everything that is not a `track` verb.
    if devmeminfo_write("hello\n", 6) != -1:
        printk0("[TRKALLOC] FAIL: a non-ctl write was accepted\n")
        ok = 0

    # (4) Arm via the REAL ctl path — and specifically the way hamsh
    #     actually delivers it. `echo track on > /proc/meminfo` does NOT
    #     produce one 9-byte write; it produces FOUR: "track", " ", "on",
    #     "\n". A parser that only matched a whole-line write passed every
    #     in-kernel test and did nothing at all from the shell, which is
    #     the failure this leg exists to catch.
    devmeminfo_write("track", 5)
    devmeminfo_write(" ", 1)
    devmeminfo_write("on", 2)
    if devmeminfo_write("\n", 1) <= 0:
        printk0("[TRKALLOC] FAIL: word-at-a-time `track on` was rejected\n")
        return 0
    if page_alloc_track_mode() != 1:
        printk1("[TRKALLOC] FAIL: mode is %d after `track on`\n",
                page_alloc_track_mode())
        ok = 0

    n1: uint64 = _build_meminfo(&scratch[0], 8192)
    if _trk_find(&scratch[0], n1, "PgSite11: ") == 0:
        printk0("[TRKALLOC] FAIL: armed blob has no PgSite11 line\n")
        ok = 0
    if n1 <= n0:
        printk2("[TRKALLOC] FAIL: armed blob did not grow (%d -> %d)\n",
                n0, n1)
        ok = 0

    # (5) STAMP: a tagged allocation lands on ITS site and nowhere else.
    live_before: uint64 = page_alloc_site_live(PA_SITE_TMPFS)
    alloc_before: uint64 = page_alloc_site_allocs(PA_SITE_TMPFS)
    cow_before: uint64 = page_alloc_site_allocs(PA_SITE_COW_RESOLVE)
    pa_set_site(PA_SITE_TMPFS)
    p: uint64 = alloc_pages(2)                    # 4 frames
    if p == 0:
        printk0("[TRKALLOC] FAIL: alloc_pages(2) OOM (on leg)\n")
        return 0
    if page_alloc_site_live(PA_SITE_TMPFS) != live_before + 4:
        printk2("[TRKALLOC] FAIL: tmpfs live %d -> %d, wanted +4\n",
                live_before, page_alloc_site_live(PA_SITE_TMPFS))
        ok = 0
    if page_alloc_site_allocs(PA_SITE_TMPFS) != alloc_before + 4:
        printk0("[TRKALLOC] FAIL: tmpfs cumulative allocs did not move by 4\n")
        ok = 0
    if page_alloc_site_allocs(PA_SITE_COW_RESOLVE) != cow_before:
        printk0("[TRKALLOC] FAIL: an unrelated site's counter moved\n")
        ok = 0

    # (6) UNSTAMP: the free returns the pages to that site's histogram and
    #     is itself attributed, so a per-site alloc/free slope is possible.
    free_before: uint64 = page_alloc_site_frees(PA_SITE_TMPFS)
    free_pages(p, 2)
    if page_alloc_site_live(PA_SITE_TMPFS) != live_before:
        printk2("[TRKALLOC] FAIL: tmpfs live did not return (%d vs %d)\n",
                page_alloc_site_live(PA_SITE_TMPFS), live_before)
        ok = 0
    if page_alloc_site_frees(PA_SITE_TMPFS) != free_before + 4:
        printk0("[TRKALLOC] FAIL: tmpfs frees did not move by 4\n")
        ok = 0

    # (7) An UNTAGGED allocation is honestly reported as UNKNOWN rather
    #     than inheriting the previous site's attribution.
    unk_before: uint64 = page_alloc_site_allocs(PA_SITE_UNKNOWN)
    q: uint64 = alloc_pages(0)
    if q != 0:
        if page_alloc_site_allocs(PA_SITE_UNKNOWN) != unk_before + 1:
            printk0("[TRKALLOC] FAIL: untagged alloc was not booked to site 0\n")
            ok = 0
        free_pages(q, 0)

    # (8) The CHUNKED read path — /bin/cat reads 128 bytes at a time and
    #     the blob is re-rendered per chunk. This is the shape that hid
    #     every leak counter behind byte 128 once, and the shape an
    #     O(frames) scan in _build_meminfo would wedge the guest on.
    chunk: Array[128, uint8]
    total: uint64 = 0
    off: uint64 = 0
    guard: uint64 = 0
    while guard < 64:
        got: int64 = devmeminfo_read_at(&chunk[0], 128, off)
        if got <= 0:
            guard = 64
        else:
            total = total + cast[uint64](got)
            off = off + cast[uint64](got)
            guard = guard + 1
    if total < n1:
        printk2("[TRKALLOC] FAIL: chunked read delivered %d of %d bytes\n",
                total, n1)
        ok = 0

    # (9) DISARM, and prove it: with tracking off an allocation moves
    #     nothing. This is the default-off guarantee, measured.
    if devmeminfo_write("track off\n", 10) <= 0:
        printk0("[TRKALLOC] FAIL: `track off` ctl write rejected\n")
        ok = 0
    if page_alloc_track_mode() != 0:
        printk0("[TRKALLOC] FAIL: still armed after `track off`\n")
        ok = 0
    quiet_live: uint64 = page_alloc_site_live(PA_SITE_TMPFS)
    quiet_alloc: uint64 = page_alloc_site_allocs(PA_SITE_TMPFS)
    pa_set_site(PA_SITE_TMPFS)
    r: uint64 = alloc_pages(1)
    if r != 0:
        if page_alloc_site_live(PA_SITE_TMPFS) != quiet_live:
            printk0("[TRKALLOC] FAIL: a counter moved with tracking OFF\n")
            ok = 0
        if page_alloc_site_allocs(PA_SITE_TMPFS) != quiet_alloc:
            printk0("[TRKALLOC] FAIL: cumulative allocs moved with tracking OFF\n")
            ok = 0
        free_pages(r, 1)
    n2: uint64 = _build_meminfo(&scratch[0], 8192)
    if n2 != n0:
        printk2("[TRKALLOC] FAIL: disarmed blob is %d bytes, was %d\n",
                n2, n0)
        ok = 0

    # (10) THE CENSUS'S POSITIVE CONTROL, wired as a boot regression. At boot
    #      there is little or no user address space, so this is a WEAK test of
    #      the page-table walk itself — its job is to prove the plant -> tag ->
    #      sweep -> count chain is connected at all, so that a refactor cannot
    #      silently turn the census blind. The strong version runs in the soak
    #      under 19 live address spaces (test_de_stress_soak.sh plants before
    #      `track census`). A census that cannot see a frame it was just handed
    #      would otherwise report "0 orphans" forever and end a leak hunt with
    #      a confident wrong answer.
    if devmeminfo_write("track full\n", 11) <= 0:
        printk0("[TRKALLOC] FAIL: `track full` ctl write rejected\n")
        ok = 0
    if page_alloc_census_plant() == 0:
        printk0("[TRKALLOC] FAIL: could not plant a control orphan\n")
        ok = 0
    else:
        cens: uint64 = mm_orphan_census()
        if cens == 0:
            printk0("[TRKALLOC] FAIL: census is BLIND — it did not detect a planted UNMAPPED frame\n")
            ok = 0
        if page_alloc_census_orphans(PA_SITE_VMA_ANON) == 0:
            printk0("[TRKALLOC] FAIL: planted orphan not attributed to its site\n")
            ok = 0
        page_alloc_census_unplant()
    page_alloc_track_enable(0)

    # --- KERNEL-HEAP TRACKER (mm/slab.ad kmtrack) ---------------------
    #
    # Same claims as above, for the half of memory the page tracker cannot
    # see. The legs that matter most are (k1) default-off leaves the blob
    # byte-identical, (k5) a freed object DRAINS its site — because a
    # tracker whose live count only ever rises would report every site as
    # leaking and be worse than no tracker at all — and (k6) an object
    # allocated at one site is not attributed to another.
    if km_track_mode() != 0:
        printk0("[TRKALLOC] FAIL: kmtrack was already armed at boot\n")
        ok = 0
    kn0: uint64 = _build_meminfo(&scratch[0], 8192)
    if _trk_find(&scratch[0], kn0, "KmSite") != 0:
        printk0("[TRKALLOC] FAIL: default-off blob contains KmSite lines\n")
        ok = 0

    # (k2) Arm word-at-a-time, exactly as hamsh delivers `echo kmtrack on`.
    devmeminfo_write("kmtrack", 7)
    devmeminfo_write(" ", 1)
    devmeminfo_write("on", 2)
    if devmeminfo_write("\n", 1) <= 0:
        printk0("[TRKALLOC] FAIL: word-at-a-time `kmtrack on` rejected\n")
        return 0
    if km_track_mode() != 1:
        printk1("[TRKALLOC] FAIL: kmtrack mode is %d after `kmtrack on`\n",
                km_track_mode())
        ok = 0
    kn1: uint64 = _build_meminfo(&scratch[0], 8192)
    if _trk_find(&scratch[0], kn1, "KmSite1: ") == 0:
        printk0("[TRKALLOC] FAIL: armed blob has no KmSite1 line\n")
        ok = 0
    if kn1 <= kn0:
        printk2("[TRKALLOC] FAIL: kmtrack blob did not grow (%d -> %d)\n",
                kn0, kn1)
        ok = 0

    # (k3) STAMP: a tagged kmalloc lands on ITS site, in objects AND bytes.
    kl_before: uint64 = km_site_live(KM_SITE_SELFTEST)
    kb_before: uint64 = km_site_bytes(KM_SITE_SELFTEST)
    ka_before: uint64 = km_site_allocs(KM_SITE_SELFTEST)
    kvfs_before: uint64 = km_site_allocs(KM_SITE_VFS)
    km_set_site(KM_SITE_SELFTEST)
    kobj: uint64 = kmalloc(200)                 # -> the 256-byte cache
    if kobj == 0:
        printk0("[TRKALLOC] FAIL: kmalloc(200) returned 0\n")
        return 0
    if km_site_live(KM_SITE_SELFTEST) != kl_before + 1:
        printk2("[TRKALLOC] FAIL: kmtrack live %d -> %d, wanted +1\n",
                kl_before, km_site_live(KM_SITE_SELFTEST))
        ok = 0
    if km_site_bytes(KM_SITE_SELFTEST) != kb_before + 256:
        printk2("[TRKALLOC] FAIL: kmtrack bytes %d -> %d, wanted +256\n",
                kb_before, km_site_bytes(KM_SITE_SELFTEST))
        ok = 0
    if km_site_allocs(KM_SITE_SELFTEST) != ka_before + 1:
        printk0("[TRKALLOC] FAIL: kmtrack cumulative allocs did not move\n")
        ok = 0
    # (k6) ...and NOWHERE else. A tracker that smears one site's objects
    # over another cannot exonerate anything, which is most of its value.
    if km_site_allocs(KM_SITE_VFS) != kvfs_before:
        printk0("[TRKALLOC] FAIL: an unrelated kmtrack site moved\n")
        ok = 0

    # (k4) The pending site is ONE-SHOT: the next, untagged kmalloc must be
    # booked to UNKNOWN, not inherit the previous caller's attribution.
    ku_before: uint64 = km_site_allocs(KM_SITE_UNKNOWN)
    kobj2: uint64 = kmalloc(100)
    if kobj2 == 0:
        printk0("[TRKALLOC] FAIL: kmalloc(100) returned 0\n")
        return 0
    if km_site_allocs(KM_SITE_UNKNOWN) != ku_before + 1:
        printk0("[TRKALLOC] FAIL: untagged kmalloc was not booked to site 0\n")
        ok = 0
    if km_site_allocs(KM_SITE_SELFTEST) != ka_before + 1:
        printk0("[TRKALLOC] FAIL: untagged kmalloc inherited the last site\n")
        ok = 0
    kfree(kobj2)

    # (k5) DRAIN: kfree recovers the ALLOCATING site from the pointer alone
    # and returns both counters. Without this a live histogram only rises.
    kf_before: uint64 = km_site_frees(KM_SITE_SELFTEST)
    kfree(kobj)
    if km_site_live(KM_SITE_SELFTEST) != kl_before:
        printk2("[TRKALLOC] FAIL: kmtrack live did not drain (%d vs %d)\n",
                km_site_live(KM_SITE_SELFTEST), kl_before)
        ok = 0
    if km_site_bytes(KM_SITE_SELFTEST) != kb_before:
        printk2("[TRKALLOC] FAIL: kmtrack bytes did not drain (%d vs %d)\n",
                km_site_bytes(KM_SITE_SELFTEST), kb_before)
        ok = 0
    if km_site_frees(KM_SITE_SELFTEST) != kf_before + 1:
        printk0("[TRKALLOC] FAIL: kmtrack frees did not move by 1\n")
        ok = 0

    # (k7) The LARGE path (> 2048 B) has no slab page — its site rides in
    # the header word. Prove the round trip, since a botched mask there
    # would corrupt the ORDER and free the wrong number of pages.
    kll: uint64 = km_site_live(KM_SITE_SELFTEST)
    klb: uint64 = km_site_bytes(KM_SITE_SELFTEST)
    km_set_site(KM_SITE_SELFTEST)
    kbig: uint64 = kmalloc(9000)                # 3 pages -> order 2, 16 KiB
    if kbig == 0:
        printk0("[TRKALLOC] FAIL: large kmalloc(9000) returned 0\n")
        return 0
    if km_site_live(KM_SITE_SELFTEST) != kll + 1:
        printk0("[TRKALLOC] FAIL: large kmalloc was not attributed\n")
        ok = 0
    if km_site_bytes(KM_SITE_SELFTEST) != klb + 16384:
        printk2("[TRKALLOC] FAIL: large kmalloc bytes %d -> %d, wanted +16384\n",
                klb, km_site_bytes(KM_SITE_SELFTEST))
        ok = 0
    kfree(kbig)
    if km_site_live(KM_SITE_SELFTEST) != kll:
        printk0("[TRKALLOC] FAIL: large kfree did not drain its site\n")
        ok = 0
    if km_site_bytes(KM_SITE_SELFTEST) != klb:
        printk0("[TRKALLOC] FAIL: large kfree did not drain its bytes\n")
        ok = 0

    # (k8) DISARM and prove the default-off guarantee by measurement: no
    # counter moves, and the blob returns to byte-identical.
    if devmeminfo_write("kmtrack off\n", 12) <= 0:
        printk0("[TRKALLOC] FAIL: `kmtrack off` ctl write rejected\n")
        ok = 0
    if km_track_mode() != 0:
        printk0("[TRKALLOC] FAIL: still armed after `kmtrack off`\n")
        ok = 0
    kq_live: uint64 = km_site_live(KM_SITE_SELFTEST)
    kq_alloc: uint64 = km_site_allocs(KM_SITE_SELFTEST)
    km_set_site(KM_SITE_SELFTEST)
    kquiet: uint64 = kmalloc(64)
    if kquiet != 0:
        if km_site_live(KM_SITE_SELFTEST) != kq_live:
            printk0("[TRKALLOC] FAIL: a kmtrack counter moved while OFF\n")
            ok = 0
        if km_site_allocs(KM_SITE_SELFTEST) != kq_alloc:
            printk0("[TRKALLOC] FAIL: kmtrack allocs moved while OFF\n")
            ok = 0
        kfree(kquiet)
    kn2: uint64 = _build_meminfo(&scratch[0], 8192)
    if kn2 != kn0:
        printk2("[TRKALLOC] FAIL: disarmed kmtrack blob is %d bytes, was %d\n",
                kn2, kn0)
        ok = 0

    if ok == 1:
        printk2("[TRKALLOC] PASS blob_off=%d blob_on=%d\n", n0, n1)
        printk2("[TRKALLOC] PASS kmtrack blob_off=%d blob_on=%d\n", kn0, kn1)
        return 1
    printk0("[TRKALLOC] FAIL\n")
    return 0
